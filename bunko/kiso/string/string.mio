yobu "kiso/bytes";
yobu "kiso/utf8";

koukai kata StringBuilder { buffer: bytes.ByteBuffer; }

koukai waza to_bytes(value: string) -> []uint8 {
    kaesu __string_to_bytes(value);
}

koukai waza from_utf8(data: []uint8) -> string? {
    moshi (!utf8.valid(data)) { kaesu mu; }
    kaesu __string_from_utf8(data);
}

koukai waza byte_len(value: string) -> int64 {
    kaesu __string_byte_len(value);
}

koukai waza rune_count(value: string) -> int64 {
    kaku count = utf8.rune_count(to_bytes(value));
    moshi (count != mu) { kaesu count; }
    __math_error("kiso/string.rune_count: string contains invalid UTF-8");
    kaesu 0;
}

koukai waza has_prefix(value: string, prefix: string) -> bool {
    kaesu bytes.has_prefix(to_bytes(value), to_bytes(prefix));
}

koukai waza has_suffix(value: string, suffix: string) -> bool {
    kaesu bytes.has_suffix(to_bytes(value), to_bytes(suffix));
}

koukai waza index(value: string, pattern: string) -> int64 {
    kaku data = to_bytes(value);
    kaku target = to_bytes(pattern);
    moshi (len(target) == 0) { kaesu 0; }
    moshi (len(target) > len(data)) { kaesu -1; }
    kaku offset = 0;
    kaku limit = len(data) - len(target);
    aida (offset <= limit) {
        kaku matched = hai;
        kaku current = 0;
        aida (current < len(target)) {
            moshi (data[offset + current] != target[current]) {
                matched = iie;
                nukeru;
            }
            current = current + 1;
        }
        moshi (matched) { kaesu offset; }
        offset = offset + 1;
    }
    kaesu -1;
}

koukai waza contains(value: string, pattern: string) -> bool {
    kaesu index(value, pattern) >= 0;
}

koukai waza concat(left: string, right: string) -> string {
    kaku builder = builder_with_capacity(byte_len(left) + byte_len(right));
    write_string(builder, left);
    write_string(builder, right);
    kaesu builder_string(builder);
}

koukai waza new_builder() -> StringBuilder {
    kaesu StringBuilder { buffer: bytes.new_buffer() };
}

koukai waza builder_with_capacity(capacity: int64) -> StringBuilder {
    kaesu StringBuilder { buffer: bytes.buffer_with_capacity(capacity) };
}

koukai waza write_string(builder: StringBuilder, value: string) -> unit {
    bytes.write(builder.buffer, to_bytes(value));
}

koukai waza write_rune(builder: StringBuilder, value: rune) -> unit {
    utf8.append_rune(builder.buffer.data, value);
}

koukai waza builder_len(builder: StringBuilder) -> int64 {
    kaesu bytes.buffer_len(builder.buffer);
}

koukai waza builder_capacity(builder: StringBuilder) -> int64 {
    kaesu bytes.buffer_capacity(builder.buffer);
}

koukai waza builder_reset(builder: StringBuilder) -> unit {
    bytes.reset(builder.buffer);
}

koukai waza builder_string(builder: StringBuilder) -> string {
    kaku result = from_utf8(builder.buffer.data);
    moshi (result != mu) { kaesu result; }
    __math_error("kiso/string.builder_string: builder contains invalid UTF-8");
    kaesu "";
}
