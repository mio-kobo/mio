yobu "kiso/array";
yobu "kiso/testing";

waza test_windows_c_target_metadata() -> unit {
    kaku file = empty_file();
    testing.expect(!has_win64_c(file), "ordinary IR remains target neutral");
    array.push(file.functions, Function { id: 0, name: "$win64c|x.dll|f|int64", name_bytes: [], parameter_count: 0, local_count: 0, returns_value: hai, captures: [], instructions: [] });
    testing.expect(has_win64_c(file), "other native targets must reject the Windows C ABI");
}
