// Native tests of the testing package itself. A passing expectation must not be recorded; the failing paths
// (expect(iie), fail, skip) are verified by the runner protocol in scripts/ci/native_platforms.py (mio-test-protocol),
// which must see a failing test fail, a skipped test skip and a passing test pass on every platform.
waza test_passing_expectations_are_silent() -> unit {
    expect(hai, "a true condition passes");
    expect(1 + 1 == 2, "arithmetic passes");
    kaku index = 0;
    aida (index < 1000) { expect(index >= 0, "many passing expectations"); index = index + 1; }
}
