yobu "kiso/aot/macho";
yobu "kiso/array";
yobu "kiso/string";
// Public libSystem ABI bridge. Reuses the established Mach-O writer without
// changing its static executable format. Replace the two empty symbol-table
// commands with LC_LOAD_DYLIB and LC_DYLD_INFO_ONLY of identical total size.
// Each import binds one 8-byte __DATA slot. No C compiler or external linker.
koukai kata LinkedImage {bytes:[]uint8; error:string;}
waza get32(bytes:[]uint8, at:int64) -> int64 { kaesu int64(bytes[at])+int64(bytes[at+1])*256+int64(bytes[at+2])*65536+int64(bytes[at+3])*16777216; }
waza put32(bytes:[]uint8, at:int64, value:int64) -> unit {
    kaku x=value; kaku i=0; aida(i<4){bytes[at+i]=uint8(x-(x/256)*256);x=x/256;i=i+1;}
}
waza uleb(bytes:[]uint8, value:int64) -> unit {
    kaku x=value; aida(x>=128){array.push(bytes,uint8(x-(x/128)*128+128));x=x/128;}array.push(bytes,uint8(x));
}
// Legacy raw fixtures explicitly reserve the initial data slots.
koukai waza executable(spec:macho.ImageSpec, symbols:[]string) -> LinkedImage {
    moshi(len(symbols)==0 || len(symbols)>spec.globals){kaesu LinkedImage {bytes:[],error:"invalid import slots"};}
    kaesu bind_image(macho.executable(spec),symbols,0);
}
// Production placement: append imports AFTER all user and existing private words.
// Source global capacity and indices are unchanged. Additional runtime words are
// also appended and never interpreted as managed roots by source type analysis.
koukai waza executable_appended(spec:macho.ImageSpec, symbols:[]string, runtime_words:int64) -> LinkedImage {
    moshi(len(symbols)==0 || len(symbols)>4096 || runtime_words<0 || runtime_words>1048576){
        kaesu LinkedImage {bytes:[],error:"invalid appended runtime layout"};
    }
    kaesu bind_image(macho.executable_with_runtime_data(spec,len(symbols)+runtime_words),symbols,spec.globals);
}
waza bind_image(base:macho.ImageResult, symbols:[]string, first_word:int64) -> LinkedImage {
    moshi(base.error!=mu){kaesu LinkedImage {bytes:[],error:"Mach-O image failure"};}
    kaku bytes=base.bytes; kaku at=32; kaku index=0; kaku sym=-1; kaku link=-1;
    aida(index<get32(bytes,16)){
        kaku cmd=get32(bytes,at);kaku size=get32(bytes,at+4);
        moshi(cmd==2){sym=at;}
        moshi(cmd==25 && bytes[at+10]==uint8(76)){link=at;}
        at=at+size;index=index+1;
    }
    moshi(sym<0 || link<0 || get32(bytes,sym+24)!=11 || get32(bytes,sym+28)!=80){kaesu LinkedImage {bytes:[],error:"unexpected static commands"};}
    // dylib_command + path incl NUL, padded to 56 bytes.
    index=0;aida(index<104){bytes[sym+index]=uint8(0);index=index+1;}
    put32(bytes,sym,12);put32(bytes,sym+4,56);put32(bytes,sym+8,24);
    put32(bytes,sym+16,65536);put32(bytes,sym+20,65536);
    kaku path=string.to_bytes("/usr/lib/libSystem.B.dylib");index=0;
    aida(index<len(path)){bytes[sym+24+index]=path[index];index=index+1;}
    kaku info=sym+56;put32(bytes,info,2147483682);put32(bytes,info+4,48);
    kaku stream:[]uint8=[];
    array.push(stream,uint8(17));array.push(stream,uint8(81)); // ordinal 1, pointer
    index=0;
    aida(index<len(symbols)){
        kaku name=string.to_bytes(symbols[index]);
        moshi(len(name)<2 || name[0]!=uint8(95)){kaesu LinkedImage {bytes:[],error:"invalid public ABI symbol"};}
        kaku ni=0;array.push(stream,uint8(64));
        aida(ni<len(name)){moshi(name[ni]==uint8(0)){kaesu LinkedImage {bytes:[],error:"embedded NUL symbol"};}array.push(stream,name[ni]);ni=ni+1;}
        array.push(stream,uint8(0));array.push(stream,uint8(114));uleb(stream,(first_word+index)*8); // DATA segment 2
        array.push(stream,uint8(144));index=index+1;
    }
    array.push(stream,uint8(0));
    kaku offset=len(bytes);put32(bytes,info+16,offset);put32(bytes,info+20,len(stream));
    array.append_all(bytes,stream);aida(len(bytes)-(len(bytes)/16)*16!=0){array.push(bytes,uint8(0));}
    put32(bytes,link+32,((len(bytes)-offset+16383)/16384)*16384);put32(bytes,link+48,len(bytes)-offset);
    kaesu LinkedImage {bytes:bytes,error:""};
}
