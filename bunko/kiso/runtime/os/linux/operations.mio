yobu "kiso/runtime/ir";
yobu "kiso/runtime/target";
// Linux x86-64 (System V) OS adapter. There is no dynamic loader and no libc:
// every OS service is a raw system call reached through a tiny in-image stub
// (`mov eax,N; mov r10,rcx; syscall; ret`). Stub addresses fill the import table
// that cpu/amd64 calls through (the same Binding/slot mechanism as os/darwin), so
// the portable runtime-IR functions are lowered identically for the two targets.
// Raw system calls return -errno; this adapter confines Linux errno values.
//
// What is NOT the same as os/darwin. Darwin's platform_wait(condition, mutex, timeout_ns),
// platform_wake_all(condition) and platform_trylock(mutex) are pthread-condition/mutex
// operations: the caller holds the mutex, which is released atomically while waiting. Linux has
// no such layer yet (it would be built on futex words and is not implemented), so these three
// functions are deliberately NOT defined here: portable code that calls them fails validation
// (UNDEFINED_RUNTIME_FUNCTION / NOT_SUPPORTED_RUNTIME_OPERATION) instead of silently passing a
// mutex pointer where a futex value is expected. Only the raw futex wait/wake below exist, under
// their own names (platform_futex_*), and `capabilities().park_wake` is therefore false.
//
// Slot -> system call number. Slot order is part of the image contract.
koukai teisu slot_write = 0;
koukai teisu slot_exit = 1;
koukai teisu slot_mmap = 2;
koukai teisu slot_munmap = 3;
koukai teisu slot_mprotect = 4;
koukai teisu slot_madvise = 5;
koukai teisu slot_clock_gettime = 6;
koukai teisu slot_futex = 7;
koukai teisu slot_clone = 8;
koukai teisu slot_arch_prctl = 9;
koukai teisu slot_gettid = 10;
koukai teisu slot_count = 11;
// Slot 8 (clone, number 56) is not a plain stub: the child resumes on the new stack and runs its entry function (link.mio).
koukai waza syscall_numbers() -> []int64 { kaesu [1, 231, 9, 11, 10, 28, 228, 202, 56, 158, 186]; }
koukai teisu clone_thread_flags = 4001536;   // VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|SETTLS|PARENT_SETTID|CHILD_CLEARTID (0x3D0F00)
koukai teisu arch_set_fs = 4098;             // ARCH_SET_FS 0x1002
koukai teisu arch_get_fs = 4099;             // ARCH_GET_FS 0x1003
koukai teisu thread_guard_bytes = 4096;

koukai teisu clock_monotonic = 1;
koukai teisu futex_wait_private = 128;
koukai teisu futex_wake_private = 129;
koukai teisu page_bytes = 4096;

// Operation numbers. 31 (abort), 101 (clock_gettime(CLOCK_MONOTONIC) into a timespec, 0 on success),
// 102 (exit) and 103 (write(1, buffer, length)) mean the same as in os/darwin. Darwin's 12, 100, 104
// and 105 are pthread condition/mutex calls with no Linux equivalent here, so they are not bound.
// 200..203 are Linux-private virtual-memory calls whose six arguments all come from virtual registers
// (a literal fd = -1 is not encodable in a Binding); 204/205 are the Linux-private futex wait/wake.
koukai waza bindings() -> []ir.Binding {
    kaesu [
        ir.Binding { operation: 31, slot: 1, arguments: [0], result_bits: 64 },
        ir.Binding { operation: 101, slot: 6, arguments: [-2, 0], result_bits: 64 },
        ir.Binding { operation: 102, slot: 1, arguments: [0], result_bits: 64 },
        ir.Binding { operation: 103, slot: 0, arguments: [-2, 0, 1], result_bits: 64 },
        ir.Binding { operation: 200, slot: 2, arguments: [0, 1, 2, 3, 4, 5], result_bits: 64 },
        ir.Binding { operation: 201, slot: 3, arguments: [0, 1], result_bits: 64 },
        ir.Binding { operation: 202, slot: 4, arguments: [0, 1, 2], result_bits: 64 },
        ir.Binding { operation: 203, slot: 5, arguments: [0, 1, 2], result_bits: 64 },
        ir.Binding { operation: 204, slot: 7, arguments: [0, -129, 1, 2], result_bits: 64 },
        ir.Binding { operation: 205, slot: 7, arguments: [0, -130, 1], result_bits: 64 },
        // 206 clone(flags, child_stack, parent_tid*, child_tid*, tls); 207 arch_prctl(code, address); 208 gettid()
        ir.Binding { operation: 206, slot: 8, arguments: [0, 1, 2, 3, 4], result_bits: 64 },
        ir.Binding { operation: 207, slot: 9, arguments: [0, 1], result_bits: 64 },
        ir.Binding { operation: 208, slot: 10, arguments: [], result_bits: 64 }
    ];
}

// What this adapter really provides. OS thread primitives now exist (raw clone with a guarded stack, futex join on the
// kernel-cleared tid word, FS-base TLS: platform_thread_*, platform_tls_*; witnessed natively by check_threads.py), but a thread
// started this way is NOT known to the collector: there is no root registry, no safepoint handshake and no multi-mutator heap
// on this target, so managed code must not run on it. The capability descriptor therefore still claims no threads, no tls, no
// precise roots and no park_wake (that capability means the portable condition/mutex protocol, of which only raw futex wait/wake
// exist). The target keeps failing closed for the concurrent collector and for mutex/condition/park/wake operations; the flags
// change only in the PR that integrates the threads with the collector and passes its safety witnesses (docs/concurrency.md).
koukai waza capabilities() -> target.TargetInfo {
    kaesu target.TargetInfo { os: "linux", arch: "amd64", abi: "sysv", pointer_bits: 64, little_endian: hai,
        page_size_query: hai, atomic64: hai, threads: iie, tls: iie, park_wake: iie,
        monotonic_clock: hai, virtual_memory: hai, precise_roots: iie, stack_alignment: 16,
        concurrent_collector: iie, executable: hai };
}

// platform_now() -> monotonic nanoseconds, 0 on failure: the same contract as os/darwin.
//
// platform_futex_wait(address, expected, timeout_ns) -> 0, 1 or a negative errno:
//   0  woken, or the word no longer matched (EAGAIN) or the call was interrupted (EINTR): the portable
//      contract allows spurious wake-ups, so callers must re-check their predicate;
//   1  the relative timeout elapsed (ETIMEDOUT); a timeout of 0 returns 1 at once when the word still
//      matches (it never waits forever);
//   <0 any other failure, as -errno.
//   Linux compares a 32-bit word: only the low 32 bits (little endian) of the 64-bit word at `address`
//   are compared with the low 32 bits of `expected`; callers must keep the state they wait on in those
//   bits. `address` is a process-private futex word (FUTEX_WAIT_PRIVATE), 4-byte aligned.
// platform_futex_wake(address, count) -> number of waiters woken, or -errno.
// platform_futex_wake_all(address) -> platform_futex_wake(address, INT_MAX).
// platform_reserve(length) -> the mapping address, or -errno; every other memory function returns 0 or
//   -errno. An error is a value in [2^64 - 4095, 2^64 - 1] viewed unsigned, which is never a user address.
koukai waza platform_program() -> []ir.Function {
    kaku wait = ir.function("platform_futex_wait");
    // (address, expected, timeout_ns): build the relative timespec {sec, nsec} in scratch.
    ir.put(wait, ir.scratch_address, 3, 0, 0, 0); ir.put(wait, ir.constant, 4, 0, 0, 1000000000);
    ir.put(wait, ir.divide_unsigned, 5, 2, 4, 0); ir.put(wait, ir.multiply, 6, 5, 4, 0); ir.put(wait, ir.subtract, 6, 2, 6, 0);
    ir.put(wait, ir.store, 0, 3, 5, 0); ir.put(wait, ir.store, 0, 3, 6, 8);
    ir.call(wait, 204, 4, [0, 1, 3]); ir.branch(wait, ir.zero, 4, "return");
    // ETIMEDOUT=110 -> timeout(1). EAGAIN=11 (value changed) and EINTR=4 are
    // legitimate wakeups from the portable point of view -> 0. Other errors are negative errno.
    ir.put(wait, ir.constant, 5, 0, 0, -110); ir.put(wait, ir.equal, 5, 4, 5, 0); ir.branch(wait, ir.zero, 5, "again");
    ir.put(wait, ir.constant, 4, 0, 0, 1); ir.branch(wait, ir.jump, 0, "return");
    ir.branch(wait, ir.label, 0, "again");
    ir.put(wait, ir.constant, 5, 0, 0, -11); ir.put(wait, ir.equal, 5, 4, 5, 0); ir.branch(wait, ir.nonzero, 5, "woken");
    ir.put(wait, ir.constant, 5, 0, 0, -4); ir.put(wait, ir.equal, 5, 4, 5, 0); ir.branch(wait, ir.zero, 5, "return");
    ir.branch(wait, ir.label, 0, "woken"); ir.put(wait, ir.constant, 4, 0, 0, 0);
    ir.branch(wait, ir.label, 0, "return"); ir.put(wait, ir.result, 0, 4, 0, 0);

    kaku clock = ir.function("platform_now");
    ir.put(clock, ir.scratch_address, 1, 0, 0, 0); ir.call(clock, 101, 2, [1]); ir.branch(clock, ir.nonzero, 2, "error");
    ir.put(clock, ir.load, 2, 1, 0, 0); ir.put(clock, ir.load, 3, 1, 0, 8); ir.put(clock, ir.constant, 4, 0, 0, 1000000000);
    ir.put(clock, ir.multiply, 2, 2, 4, 0); ir.put(clock, ir.add, 2, 2, 3, 0); ir.put(clock, ir.result, 0, 2, 0, 0);
    ir.branch(clock, ir.label, 0, "error"); ir.put(clock, ir.constant, 2, 0, 0, 0); ir.put(clock, ir.result, 0, 2, 0, 0);

    kaku wake = ir.function("platform_futex_wake");
    ir.call(wake, 205, 2, [0, 1]); ir.put(wake, ir.result, 0, 2, 0, 0);
    kaku wake_all = ir.function("platform_futex_wake_all");
    ir.put(wake_all, ir.constant, 1, 0, 0, 2147483647); ir.call(wake_all, 205, 2, [0, 1]); ir.put(wake_all, ir.result, 0, 2, 0, 0);

    // Virtual memory. reserve: PROT_NONE private anonymous NORESERVE mapping.
    kaku reserve = ir.function("platform_reserve");
    // virtual registers: 0=length (argument) 1=addr(NULL) 2=PROT_NONE 3=flags 4=fd(-1) 5=offset
    ir.put(reserve, ir.constant, 1, 0, 0, 0); ir.put(reserve, ir.constant, 2, 0, 0, 0); ir.put(reserve, ir.constant, 3, 0, 0, 16418);
    ir.put(reserve, ir.constant, 4, 0, 0, -1); ir.put(reserve, ir.constant, 5, 0, 0, 0);
    ir.call(reserve, 200, 7, [1, 0, 2, 3, 4, 5]); ir.put(reserve, ir.result, 0, 7, 0, 0);
    // commit(addr,len): PROT_READ|PROT_WRITE (3)
    kaku commit = ir.function("platform_commit");
    ir.put(commit, ir.constant, 2, 0, 0, 3); ir.call(commit, 202, 3, [0, 1, 2]); ir.put(commit, ir.result, 0, 3, 0, 0);
    // decommit(addr,len): MADV_DONTNEED (4) drops pages; then PROT_NONE (0)
    kaku decommit = ir.function("platform_decommit");
    ir.put(decommit, ir.constant, 2, 0, 0, 4); ir.call(decommit, 203, 3, [0, 1, 2]); ir.branch(decommit, ir.nonzero, 3, "done");
    ir.put(decommit, ir.constant, 2, 0, 0, 0); ir.call(decommit, 202, 3, [0, 1, 2]);
    ir.branch(decommit, ir.label, 0, "done"); ir.put(decommit, ir.result, 0, 3, 0, 0);
    kaku release = ir.function("platform_release");
    ir.call(release, 201, 2, [0, 1]); ir.put(release, ir.result, 0, 2, 0, 0);
    kaku protect = ir.function("platform_protect");
    ir.call(protect, 202, 3, [0, 1, 2]); ir.put(protect, ir.result, 0, 3, 0, 0);

    // ---- Native threads (raw clone, no libc). These are OS primitives only: the thread is NOT registered with the
    // collector and must not run managed code (capabilities() keeps threads/tls false until that is integrated).
    // platform_thread_stack(size) -> usable stack start or -errno: a PROT_NONE guard page followed by `size` RW bytes.
    kaku thread_stack = ir.function("platform_thread_stack");
    ir.put(thread_stack, ir.constant, 1, 0, 0, thread_guard_bytes); ir.put(thread_stack, ir.add, 2, 0, 1, 0);
    ir.invoke_function(thread_stack, "platform_reserve", 3, [2]);
    ir.put(thread_stack, ir.constant, 4, 0, 0, -4095); ir.put(thread_stack, ir.less_unsigned, 5, 3, 4, 0); ir.branch(thread_stack, ir.zero, 5, "done");
    ir.put(thread_stack, ir.add, 6, 3, 1, 0); ir.invoke_function(thread_stack, "platform_commit", 7, [6, 0]); ir.branch(thread_stack, ir.zero, 7, "ready");
    ir.invoke_function(thread_stack, "platform_release", 8, [3, 2]); ir.put(thread_stack, ir.copy, 3, 7, 0, 0); ir.branch(thread_stack, ir.jump, 0, "done");
    ir.branch(thread_stack, ir.label, 0, "ready"); ir.put(thread_stack, ir.copy, 3, 6, 0, 0);
    ir.branch(thread_stack, ir.label, 0, "done"); ir.put(thread_stack, ir.result, 0, 3, 0, 0);
    // platform_thread_stack_release(usable_start, size) -> 0 or -errno
    kaku thread_stack_release = ir.function("platform_thread_stack_release");
    ir.put(thread_stack_release, ir.constant, 2, 0, 0, thread_guard_bytes); ir.put(thread_stack_release, ir.subtract, 3, 0, 2, 0);
    ir.put(thread_stack_release, ir.add, 4, 1, 2, 0); ir.invoke_function(thread_stack_release, "platform_release", 5, [3, 4]);
    ir.put(thread_stack_release, ir.result, 0, 5, 0, 0);
    // platform_thread_create(entry, argument, stack_start, stack_size, tid_word*, tls) -> thread id or -errno.
    // The child runs entry(argument) on the given stack with the import table installed, then exits the thread. The kernel stores
    // the id in *tid_word before either side runs and clears it (waking futex waiters) when the thread ends: that is the join word.
    kaku thread_create = ir.function("platform_thread_create");
    ir.put(thread_create, ir.add, 6, 2, 3, 0); ir.put(thread_create, ir.constant, 7, 0, 0, 16); ir.put(thread_create, ir.divide_unsigned, 6, 6, 7, 0);
    ir.put(thread_create, ir.multiply, 6, 6, 7, 0); ir.put(thread_create, ir.subtract, 6, 6, 7, 0);
    ir.put(thread_create, ir.store, 0, 6, 0, 0); ir.put(thread_create, ir.store, 0, 6, 1, 8);
    ir.put(thread_create, ir.constant, 8, 0, 0, clone_thread_flags);
    ir.call(thread_create, 206, 9, [8, 6, 4, 4, 5]); ir.put(thread_create, ir.result, 0, 9, 0, 0);
    // platform_thread_join(tid_word*) -> 0 once the thread has ended, or -errno. Waits on the kernel-cleared id word.
    kaku thread_join = ir.function("platform_thread_join");
    ir.put(thread_join, ir.constant, 3, 0, 0, 1000000000);
    ir.branch(thread_join, ir.label, 0, "again"); ir.put(thread_join, ir.acquire_load, 1, 0, 0, 0); ir.branch(thread_join, ir.zero, 1, "done");
    ir.invoke_function(thread_join, "platform_futex_wait", 2, [0, 1, 3]);
    ir.put(thread_join, ir.constant, 4, 0, 0, -4095); ir.put(thread_join, ir.less_unsigned, 5, 2, 4, 0); ir.branch(thread_join, ir.nonzero, 5, "again");
    ir.put(thread_join, ir.result, 0, 2, 0, 0);
    ir.branch(thread_join, ir.label, 0, "done"); ir.put(thread_join, ir.constant, 1, 0, 0, 0); ir.put(thread_join, ir.result, 0, 1, 0, 0);
    kaku thread_id = ir.function("platform_thread_id");
    ir.call(thread_id, 208, 0, []); ir.put(thread_id, ir.result, 0, 0, 0, 0);
    // TLS: the FS base. platform_tls_set(address) -> 0/-errno; platform_tls_get() -> address (0 on failure).
    kaku tls_set = ir.function("platform_tls_set");
    ir.put(tls_set, ir.constant, 1, 0, 0, arch_set_fs); ir.call(tls_set, 207, 2, [1, 0]); ir.put(tls_set, ir.result, 0, 2, 0, 0);
    kaku tls_get = ir.function("platform_tls_get");
    ir.put(tls_get, ir.scratch_address, 1, 0, 0, 0); ir.put(tls_get, ir.constant, 2, 0, 0, arch_get_fs); ir.call(tls_get, 207, 3, [2, 1]);
    ir.branch(tls_get, ir.nonzero, 3, "failed"); ir.put(tls_get, ir.load, 4, 1, 0, 0); ir.put(tls_get, ir.result, 0, 4, 0, 0);
    ir.branch(tls_get, ir.label, 0, "failed"); ir.put(tls_get, ir.constant, 4, 0, 0, 0); ir.put(tls_get, ir.result, 0, 4, 0, 0);
    kaesu [wait, clock, wake, wake_all, reserve, commit, decommit, release, protect, thread_stack, thread_stack_release, thread_create, thread_join, thread_id, tls_set, tls_get];
}
