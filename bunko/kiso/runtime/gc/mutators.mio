// Compiler-facing managed mutator protocol, expressed only in neutral IR.
// A heap operation owns its stopped epoch through initialization/publication;
// the next solved opcode boundary releases it before ordinary execution polls.
waza gc_heap_enter_program() -> ir.Function {
    kaku f=ir.function("gc_heap_enter");tprepare(f);ir.put(f,ir.release_store,0,0,1,thread_shadow);
    tload(f,10,thread_registry);ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.put(f,ir.equal,12,11,0,0);ir.branch(f,ir.nonzero,12,"owned");
    ir.invoke_function(f,"gc_begin",2,[0,1]);ir.put(f,ir.result,0,2,0,0);
    ir.branch(f,ir.label,0,"owned");treturn(f,0);kaesu f;
}
waza gc_mutator_poll_program() -> ir.Function {
    kaku f=ir.function("gc_mutator_poll");tprepare(f);ir.put(f,ir.release_store,0,0,1,thread_shadow);
    tload(f,10,thread_registry);ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.put(f,ir.equal,12,11,0,0);ir.branch(f,ir.zero,12,"poll");
    ir.invoke_function(f,"gc_end",2,[0]);ir.branch(f,ir.nonzero,2,"failed");
    ir.branch(f,ir.label,0,"poll");ir.invoke_function(f,"gc_poll",2,[0,1]);
    ir.branch(f,ir.label,0,"failed");ir.put(f,ir.result,0,2,0,0);kaesu f;
}
waza gc_block_enter_program() -> ir.Function {
    kaku f=ir.function("gc_block_enter");tprepare(f);ir.invoke_function(f,"gc_mutator_poll",2,[0,1]);ir.branch(f,ir.nonzero,2,"fatal");
    tload(f,3,thread_mutex);ir.call(f,ir.mutex_lock,2,[3]);ir.branch(f,ir.nonzero,2,"fatal");
    ir.invoke_function(f,"gc_park_locked",2,[0]);tpublish(f,thread_progress,thread_parked);ir.call(f,ir.mutex_unlock,2,[3]);ir.branch(f,ir.nonzero,2,"fatal");treturn(f,0);
    ir.branch(f,ir.label,0,"fatal");tconstant(f,2,83);ir.call(f,abort_runtime,3,[2]);treturn(f,3);kaesu f;
}
waza gc_block_leave_program() -> ir.Function {
    kaku f=ir.function("gc_block_leave");tprepare(f);tload(f,3,thread_mutex);ir.call(f,ir.mutex_lock,2,[3]);ir.branch(f,ir.nonzero,2,"fatal");
    ir.invoke_function(f,"gc_park_locked",2,[0]);tpublish(f,thread_progress,thread_at_work);ir.call(f,ir.mutex_unlock,2,[3]);ir.branch(f,ir.nonzero,2,"fatal");treturn(f,0);
    ir.branch(f,ir.label,0,"fatal");tconstant(f,2,84);ir.call(f,abort_runtime,3,[2]);treturn(f,3);kaesu f;
}
waza thread_wait_started_program() -> ir.Function {
    kaku f=ir.function("thread_wait_started");tprepare(f);tload(f,2,thread_mutex);ir.call(f,ir.mutex_lock,1,[2]);ir.branch(f,ir.nonzero,1,"failed_lock");
    ir.invoke_function(f,"platform_now",5,[]);tconstant(f,6,60000000000);ir.put(f,ir.add,5,5,6,0);   // 60 s: a started thread registers eventually, even on an overloaded machine
    ir.branch(f,ir.label,0,"retry");ir.put(f,ir.acquire_load,3,0,0,thread_state);tcheck(f,3,thread_running,"ready");tcheck(f,3,thread_exited,"ready");tcheck(f,3,thread_failed,"failed");
    ir.invoke_function(f,"platform_now",6,[]);ir.put(f,ir.less_unsigned,7,6,5,0);ir.branch(f,ir.zero,7,"failed");
    tload(f,3,thread_condition);tconstant(f,4,10000000);ir.invoke_function(f,"platform_wait",6,[3,2,4]);ir.branch(f,ir.zero,6,"retry");tcheck(f,6,1,"retry");
    ir.branch(f,ir.label,0,"failed");tconstant(f,8,2);ir.branch(f,ir.jump,0,"unlock");
    ir.branch(f,ir.label,0,"ready");tload(f,8,thread_error);
    ir.branch(f,ir.label,0,"unlock");ir.call(f,ir.mutex_unlock,1,[2]);ir.branch(f,ir.nonzero,1,"failed_lock");ir.put(f,ir.result,0,8,0,0);
    ir.branch(f,ir.label,0,"failed_lock");treturn(f,2);kaesu f;
}
// High-level join waits for natural user completion before thread_close's
// bounded stop/cleanup protocol. Joining must not cancel ordinary user waits.
waza thread_wait_completion_program() -> ir.Function {
    kaku f=ir.function("thread_wait_completion");tprepare(f);tload(f,2,thread_mutex);ir.call(f,ir.mutex_lock,1,[2]);ir.branch(f,ir.nonzero,1,"failed_lock");
    // No deadline: a join waits for the thread's natural completion however long it runs (a 30 second ceiling here made a join of any thread that
    // ran longer abort the whole process, and a heavily contended thread easily does). A wait that returns an error still fails.
    ir.branch(f,ir.label,0,"retry");ir.put(f,ir.acquire_load,3,0,0,thread_progress);tcheck(f,3,thread_finished,"ready");
    tload(f,3,thread_condition);tconstant(f,4,10000000);ir.invoke_function(f,"platform_wait",6,[3,2,4]);ir.branch(f,ir.zero,6,"retry");tcheck(f,6,1,"retry");
    ir.branch(f,ir.label,0,"failed");tconstant(f,8,2);ir.branch(f,ir.jump,0,"unlock");
    ir.branch(f,ir.label,0,"ready");tload(f,8,thread_error);
    ir.branch(f,ir.label,0,"unlock");ir.call(f,ir.mutex_unlock,1,[2]);ir.branch(f,ir.nonzero,1,"failed_lock");ir.put(f,ir.result,0,8,0,0);
    ir.branch(f,ir.label,0,"failed_lock");treturn(f,2);kaesu f;
}
koukai waza mutator_program() -> []ir.Function {
    kaesu [gc_heap_enter_program(),gc_mutator_poll_program(),gc_block_enter_program(),gc_block_leave_program(),thread_wait_started_program(),thread_wait_completion_program(),memory_snapshot_program()];
}
