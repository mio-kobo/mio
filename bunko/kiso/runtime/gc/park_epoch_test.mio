yobu "kiso/array";
yobu "kiso/runtime/ir";
yobu "kiso/testing";

waza park_test_label(f: ir.Function, name: string) -> int64 {
    kaku i = 0;
    aida (i < len(f.steps)) {
        moshi (f.steps[i].kind == ir.label && f.steps[i].name == name) { kaesu i; }
        i = i + 1;
    }
    kaesu -1;
}

// Execute the emitted park IR under one deterministic schedule: epoch 1 ends and
// epoch 2 starts during the first unlocked spin, without an observed zero owner.
// A kernel wait must acknowledge epoch 2 first: gc_begin cannot accept a parked
// thread's stale acknowledgement. This model supplements real native stress tests.
waza park_test_replaced_epoch() -> bool {
    kaku f = gc_park_locked_program();
    kaku regs = array.make[int64](32, 0);
    kaku memory = array.make[int64](256, 0);
    kaku thread = 64;
    kaku registry = 1024;
    regs[0] = thread;
    memory[thread / 8 + thread_registry / 8] = registry;
    memory[thread / 8 + thread_mutex / 8] = 512;
    memory[thread / 8 + thread_condition / 8] = 600;
    memory[registry / 8 + gc_registry_owner / 8] = 2048;
    memory[registry / 8 + gc_registry_epoch / 8] = 1;
    memory[registry / 8 + gc_registry_heartbeat / 8] = 1;
    kaku unlocks = 0;
    kaku waited = iie;
    kaku pc = 0;
    kaku budget = 50000;
    aida (pc >= 0 && pc < len(f.steps) && budget > 0) {
        kaku s = f.steps[pc];
        kaku next = pc + 1;
        kaku handled = iie;
        moshi (s.kind == ir.label || s.kind == ir.imports) { handled = hai; }
        moshi (s.kind == ir.constant) { regs[s.destination] = s.immediate; handled = hai; }
        moshi (s.kind == ir.copy) { regs[s.destination] = regs[s.left]; handled = hai; }
        moshi (s.kind == ir.load || s.kind == ir.acquire_load) { regs[s.destination] = memory[regs[s.left] / 8 + s.immediate / 8]; handled = hai; }
        moshi (s.kind == ir.store || s.kind == ir.release_store) { memory[regs[s.left] / 8 + s.immediate / 8] = regs[s.right]; handled = hai; }
        moshi (s.kind == ir.add) { regs[s.destination] = regs[s.left] + regs[s.right]; handled = hai; }
        moshi (s.kind == ir.equal || s.kind == ir.less_unsigned) {
            kaku yes = regs[s.left] == regs[s.right];
            moshi (s.kind == ir.less_unsigned) { yes = regs[s.left] < regs[s.right]; }
            regs[s.destination] = 0; moshi (yes) { regs[s.destination] = 1; } handled = hai;
        }
        moshi (s.kind == ir.jump || s.kind == ir.zero || s.kind == ir.nonzero) {
            kaku take = s.kind == ir.jump || (s.kind == ir.zero && regs[s.left] == 0) || (s.kind == ir.nonzero && regs[s.left] != 0);
            moshi (take) { next = park_test_label(f, s.name); }
            handled = hai;
        }
        moshi (s.kind == ir.system) {
            moshi (s.immediate != ir.mutex_lock && s.immediate != ir.mutex_unlock) { kaesu iie; }
            moshi (s.immediate == ir.mutex_unlock) {
                unlocks = unlocks + 1;
                moshi (unlocks == 1) { memory[registry / 8 + gc_registry_epoch / 8] = 2; }
            }
            regs[s.destination] = 0; handled = hai;
        }
        moshi (s.kind == ir.invoke) {
            moshi (s.name == "platform_wait") {
                moshi (memory[thread / 8 + thread_ack_epoch / 8] != memory[registry / 8 + gc_registry_epoch / 8]) { kaesu iie; }
                waited = hai;
                memory[registry / 8 + gc_registry_owner / 8] = 0;
            }
            sore { moshi (s.name != "platform_now") { kaesu iie; } }
            regs[s.destination] = 0; handled = hai;
        }
        moshi (s.kind == ir.result) {
            kaesu waited && regs[s.left] == 0 && memory[thread / 8 + thread_seen_epoch / 8] == 2 && memory[thread / 8 + thread_progress / 8] == thread_at_work;
        }
        moshi (!handled) { kaesu iie; }
        pc = next; budget = budget - 1;
    }
    kaesu iie;
}

waza test_park_acknowledges_an_epoch_replaced_during_unlocked_spin() -> unit {
    testing.expect(park_test_replaced_epoch(), "a parked thread acknowledges the current epoch before its kernel wait");
}
