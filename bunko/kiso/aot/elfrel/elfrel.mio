yobu "kiso/aot/elf";
yobu "kiso/array";
yobu "kiso/convert";
yobu "kiso/string";

// Pure Mio Linux x86-64 ELF64 relocatable object (ET_REL) writer: the input of the system linker when Mio builds a
// shared library. Sections:
//   .text           the machine code, SHF_ALLOC|SHF_EXECINSTR, 16-byte aligned
//   .rela.text      RELA entries (SHT_RELA, sh_link = .symtab, sh_info = .text)
//   .bss            zero-filled data area (SHT_NOBITS, SHF_ALLOC|SHF_WRITE), addressed by the code through rip-relative PC32
//   .note.GNU-stack empty, no SHF_EXECINSTR: the object asks for a non-executable stack
//   .symtab/.strtab/.shstrtab
// Symbols: null, the .text and .bss section symbols (local), then one GLOBAL FUNC symbol per exported entry point and
// one undefined GLOBAL symbol per external dependency. Nothing else is global, so a link exports exactly `exports`.
//
// Relocation types the Mio code generator produces, and the only ones accepted (anything else fails closed):
//   R_X86_64_PC32  (2)  rip-relative reference to the data area: S + A - P, S = .bss, A = offset - 4
//   R_X86_64_PLT32 (4)  `call symbol@PLT` to a declared external C symbol: L + A - P, A = -4
koukai teisu r_x86_64_pc32 = 2;
koukai teisu r_x86_64_plt32 = 4;

koukai kata ObjectExport {
    symbol: string;
    offset: int64;
    size: int64;
}
// A rel32 at `at` in .text. `symbol` empty = the .bss section symbol; otherwise an undefined global symbol.
koukai kata Relocation {
    at: int64;
    kind: int64;
    symbol: string;
    addend: int64;
}
koukai kata ObjectSpec {
    code: []uint8;
    bss_size: int64;
    exports: []ObjectExport;
    // LOCAL FUNC symbols (debugging aid, .symtab only); the linker drops them from the dynamic symbol table.
    locals: []ObjectExport;
    relocations: []Relocation;
}
koukai kata ObjectResult {
    bytes: []uint8;
    error: string;
}

teisu symbol_size = 24;
teisu relocation_size = 24;

// Two's-complement 64-bit little-endian (the addend of a RELA entry is signed).
waza put_signed(out: []uint8, value: int64) -> unit {
    kaku negative = value < 0;
    kaku x = value;
    moshi (negative) { x = -(value + 1); }
    kaku i = 0;
    aida (i < 8) {
        kaku b = x - (x / 256) * 256;
        x = x / 256;
        moshi (negative) { b = 255 - b; }
        array.push(out, uint8(b));
        i = i + 1;
    }
}

waza fail(message: string) -> ObjectResult { kaesu ObjectResult { bytes: [], error: message }; }

// Appends a NUL-terminated name to a string table and returns its offset.
waza add_name(table: []uint8, name: string) -> int64 {
    kaku at = len(table);
    array.append_all(table, string.to_bytes(name));
    array.push(table, uint8(0));
    kaesu at;
}

waza section(out: []uint8, name: int64, kind: int64, flags: int64, offset: int64, size: int64, link: int64, info: int64, alignment: int64, entry_size: int64) -> unit {
    elf.put(out, name, 4);
    elf.put(out, kind, 4);
    elf.put(out, flags, 8);
    elf.put(out, 0, 8);
    elf.put(out, offset, 8);
    elf.put(out, size, 8);
    elf.put(out, link, 4);
    elf.put(out, info, 4);
    elf.put(out, alignment, 8);
    elf.put(out, entry_size, 8);
}

waza symbol(out: []uint8, name: int64, info: int64, section_index: int64, value: int64, size: int64) -> unit {
    elf.put(out, name, 4);
    elf.put(out, info, 1);
    elf.put(out, 0, 1);
    elf.put(out, section_index, 2);
    elf.put(out, value, 8);
    elf.put(out, size, 8);
}

// Index (in the undefined-symbol list) of `name`, appending it when new.
waza external_index(names: []string, name: string) -> int64 {
    kaku at = 0;
    aida (at < len(names)) {
        moshi (names[at] == name) { kaesu at; }
        at = at + 1;
    }
    array.push(names, name);
    kaesu len(names) - 1;
}

koukai waza object(spec: ObjectSpec) -> ObjectResult {
    moshi (len(spec.code) == 0) { kaesu fail("EMPTY_TEXT"); }
    moshi (spec.bss_size < 0 || spec.bss_size > 1073741824) { kaesu fail("INVALID_BSS"); }
    kaku exports = len(spec.exports);
    kaku at = 0;
    aida (at < exports) {
        kaku entry = spec.exports[at];
        moshi (entry.symbol == "" || entry.offset < 0 || entry.size < 0 || entry.offset > len(spec.code) - entry.size) { kaesu fail("INVALID_EXPORT"); }
        kaku other = 0;
        aida (other < at) {
            moshi (spec.exports[other].symbol == entry.symbol) { kaesu fail(string.concat("DUPLICATE_EXPORT ", entry.symbol)); }
            other = other + 1;
        }
        at = at + 1;
    }
    kaku undefined: []string = [];
    at = 0;
    aida (at < len(spec.relocations)) {
        kaku reloc = spec.relocations[at];
        moshi (reloc.kind != r_x86_64_pc32 && reloc.kind != r_x86_64_plt32) { kaesu fail(string.concat("UNSUPPORTED_RELOCATION type ", convert.format_int(reloc.kind))); }
        moshi (reloc.at < 0 || reloc.at > len(spec.code) - 4) { kaesu fail("INVALID_RELOCATION_OFFSET"); }
        moshi (reloc.kind == r_x86_64_plt32 && reloc.symbol == "") { kaesu fail("INVALID_RELOCATION_SYMBOL"); }
        moshi (reloc.kind == r_x86_64_pc32 && reloc.symbol != "") { kaesu fail("INVALID_RELOCATION_SYMBOL"); }
        moshi ((reloc.kind == r_x86_64_plt32 && reloc.addend != -4) ||
               (reloc.kind == r_x86_64_pc32 && (reloc.addend < -4 || reloc.addend > spec.bss_size - 4))) {
            kaesu fail("INVALID_RELOCATION_ADDEND");
        }
        moshi (reloc.symbol != "") {
            kaku defined = iie;
            kaku e = 0;
            aida (e < exports) { moshi (spec.exports[e].symbol == reloc.symbol) { defined = hai; } e = e + 1; }
            moshi (!defined) { external_index(undefined, reloc.symbol); }
        }
        at = at + 1;
    }
    // String tables.
    kaku strtab: []uint8 = [uint8(0)];
    kaku local_names: []int64 = [];
    at = 0;
    aida (at < len(spec.locals)) {
        kaku entry = spec.locals[at];
        moshi (entry.symbol == "" || entry.offset < 0 || entry.size < 0 || entry.offset > len(spec.code) - entry.size) { kaesu fail("INVALID_LOCAL"); }
        array.push(local_names, add_name(strtab, entry.symbol));
        at = at + 1;
    }
    kaku export_names: []int64 = [];
    at = 0;
    aida (at < exports) { array.push(export_names, add_name(strtab, spec.exports[at].symbol)); at = at + 1; }
    kaku undefined_names: []int64 = [];
    at = 0;
    aida (at < len(undefined)) { array.push(undefined_names, add_name(strtab, undefined[at])); at = at + 1; }
    kaku shstrtab: []uint8 = [uint8(0)];
    kaku n_text = add_name(shstrtab, ".text");
    kaku n_rela = add_name(shstrtab, ".rela.text");
    kaku n_bss = add_name(shstrtab, ".bss");
    kaku n_stack = add_name(shstrtab, ".note.GNU-stack");
    kaku n_symtab = add_name(shstrtab, ".symtab");
    kaku n_strtab = add_name(shstrtab, ".strtab");
    kaku n_shstrtab = add_name(shstrtab, ".shstrtab");
    // Symbol table: [0] null, [1] .text, [2] .bss, then the local functions, the exports, the undefined externals.
    kaku symtab: []uint8 = [];
    symbol(symtab, 0, 0, 0, 0, 0);
    symbol(symtab, 0, 3, 1, 0, 0);
    symbol(symtab, 0, 3, 3, 0, 0);
    at = 0;
    aida (at < len(spec.locals)) {
        // st_info = STB_LOCAL << 4 | STT_FUNC
        symbol(symtab, local_names[at], 2, 1, spec.locals[at].offset, spec.locals[at].size);
        at = at + 1;
    }
    at = 0;
    aida (at < exports) {
        // st_info = STB_GLOBAL << 4 | STT_FUNC, st_other = STV_DEFAULT
        symbol(symtab, export_names[at], 18, 1, spec.exports[at].offset, spec.exports[at].size);
        at = at + 1;
    }
    at = 0;
    aida (at < len(undefined)) { symbol(symtab, undefined_names[at], 16, 0, 0, 0); at = at + 1; }
    // Relocations.
    kaku first_global = 3 + len(spec.locals);
    kaku rela: []uint8 = [];
    at = 0;
    aida (at < len(spec.relocations)) {
        kaku reloc = spec.relocations[at];
        kaku index = 2;
        moshi (reloc.symbol != "") {
            kaku found = iie;
            kaku e = 0;
            aida (e < exports) { moshi (spec.exports[e].symbol == reloc.symbol) { index = first_global + e; found = hai; } e = e + 1; }
            moshi (!found) { index = first_global + exports + external_index(undefined, reloc.symbol); }
        }
        elf.put(rela, reloc.at, 8);
        elf.put(rela, index * 4294967296 + reloc.kind, 8);
        put_signed(rela, reloc.addend);
        at = at + 1;
    }
    // Layout.
    kaku text_offset = 64;
    kaku rela_offset = elf.align(text_offset + len(spec.code), 8);
    kaku symtab_offset = elf.align(rela_offset + len(rela), 8);
    kaku strtab_offset = symtab_offset + len(symtab);
    kaku shstrtab_offset = strtab_offset + len(strtab);
    kaku sections_offset = elf.align(shstrtab_offset + len(shstrtab), 8);
    kaku out: []uint8 = array.with_capacity[uint8](sections_offset + 8 * 64);
    array.push(out, uint8(127));
    array.push(out, uint8(69));
    array.push(out, uint8(76));
    array.push(out, uint8(70));
    array.push(out, uint8(2));
    array.push(out, uint8(1));
    array.push(out, uint8(1));
    array.push(out, uint8(0));
    elf.put(out, 0, 8);
    elf.put(out, 1, 2);
    elf.put(out, 62, 2);
    elf.put(out, 1, 4);
    elf.put(out, 0, 8);
    elf.put(out, 0, 8);
    elf.put(out, sections_offset, 8);
    elf.put(out, 0, 4);
    elf.put(out, 64, 2);
    elf.put(out, 0, 2);
    elf.put(out, 0, 2);
    elf.put(out, 64, 2);
    elf.put(out, 8, 2);
    elf.put(out, 7, 2);
    array.append_all(out, spec.code);
    aida (len(out) < rela_offset) { array.push(out, uint8(0)); }
    array.append_all(out, rela);
    aida (len(out) < symtab_offset) { array.push(out, uint8(0)); }
    array.append_all(out, symtab);
    array.append_all(out, strtab);
    array.append_all(out, shstrtab);
    aida (len(out) < sections_offset) { array.push(out, uint8(0)); }
    section(out, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    section(out, n_text, 1, 6, text_offset, len(spec.code), 0, 0, 16, 0);
    section(out, n_rela, 4, 64, rela_offset, len(rela), 5, 1, 8, relocation_size);
    section(out, n_bss, 8, 3, symtab_offset, spec.bss_size, 0, 0, 4096, 0);
    section(out, n_stack, 1, 0, symtab_offset, 0, 0, 0, 1, 0);
    section(out, n_symtab, 2, 0, symtab_offset, len(symtab), 6, first_global, 8, symbol_size);
    section(out, n_strtab, 3, 0, strtab_offset, len(strtab), 0, 0, 1, 0);
    section(out, n_shstrtab, 3, 0, shstrtab_offset, len(shstrtab), 0, 0, 1, 0);
    kaesu ObjectResult { bytes: out, error: "" };
}
