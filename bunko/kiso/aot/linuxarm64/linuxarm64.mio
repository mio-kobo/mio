yobu "kiso/aot/arm64";
yobu "kiso/aot/elf";
yobu "kiso/aot/macho";
yobu "kiso/array";
yobu "kiso/string";

// Linux AArch64 (generic syscall table, AAPCS64 registers) static image builder. First backend slice: it emits the
// smallest genuine native program (write + exit_group). There is no libc, no loader and no fallback to another CPU.
// Syscall numbers are from the Linux generic table used by arm64 (not the x86-64 table): write=64, exit_group=94.
koukai teisu syscall_write = 64;
koukai teisu syscall_exit_group = 94;

koukai kata Program { code: []uint8; error: string; }

waza push_word(out: []uint8, word: uint32) -> unit {
    kaku value = int64(word); kaku i = 0;
    aida (i < 4) { array.push(out, uint8(value - (value / 256) * 256)); value = value / 256; i = i + 1; }
}

// write(1, message, len(message)); exit_group(status). The message bytes follow the code in the same RX segment and are
// addressed PC-relative with ADR, so the image needs no relocation.
koukai waza hello_program(message: string, status: int64) -> Program {
    kaku text = string.to_bytes(message);
    moshi (len(text) == 0 || len(text) > 65535) { kaesu Program { code: [], error: "INVALID_MESSAGE" }; }
    moshi (status < 0 || status > 255) { kaesu Program { code: [], error: "INVALID_STATUS" }; }
    kaku c = arm64.assembler();
    // eight instructions; ADR is instruction 1 (byte 4) and the message starts at byte 32
    kaku failure = arm64.assembler_emit(c, arm64.movz_x(0, 1, 0));
    arm64.assembler_emit(c, arm64.adr(1, 28));
    arm64.assembler_emit(c, arm64.movz_x(2, len(text), 0));
    arm64.assembler_emit(c, arm64.movz_x(8, syscall_write, 0));
    arm64.assembler_emit(c, arm64.svc(0));
    arm64.assembler_emit(c, arm64.movz_x(0, status, 0));
    arm64.assembler_emit(c, arm64.movz_x(8, syscall_exit_group, 0));
    arm64.assembler_emit(c, arm64.svc(0));
    kaku assembled = arm64.assembler_assemble(c);
    moshi (assembled.error != mu) { kaesu Program { code: [], error: "ENCODE" }; }
    kaku code: []uint8 = [];
    kaku i = 0;
    aida (i < len(assembled.words)) { push_word(code, assembled.words[i]); i = i + 1; }
    array.append_all(code, text);
    aida (len(code) - (len(code) / 4) * 4 != 0) { array.push(code, uint8(0)); }
    kaesu Program { code: code, error: "" };
}

// A complete Linux AArch64 ELF64 executable for hello_program.
koukai waza hello_image(message: string, status: int64) -> elf.ImageResult {
    kaku program = hello_program(message, status);
    moshi (program.error != "") { kaesu elf.ImageResult { bytes: [], error: program.error }; }
    kaesu elf.executable_aarch64(elf.ImageSpec { code: program.code, entry_offset: 0, bss_size: 0 });
}

// ---- Image for lowered Mochi programs (kiso/aot/lower, compile_linux_arm64)
//
// The lowered words use the Darwin entry convention main(argc, argv, envp) in x0-x2 and address constants and globals
// through ADRP/ADD patches. This container lays the image out as: [words][pad to 8][constants][pad to 4][_start], and
// reserves globals*8 bytes in the zero-filled data segment (elf.data_base). `_start` converts the Linux initial stack
// (argc, argv[], NULL, envp[]) into x0-x2 and branches to word 0. Addresses are absolute, so ADRP page deltas are
// computed from the real code and data addresses.
teisu maximum_globals = 10244;
teisu maximum_image_size = 67108864;

waza align(value: int64, boundary: int64) -> int64 {
    kaku remainder = value - (value / boundary) * boundary;
    moshi (remainder == 0) { kaesu value; }
    kaesu value + boundary - remainder;
}

waza image_failed(message: string) -> elf.ImageResult { kaesu elf.ImageResult { bytes: [], error: message }; }

koukai waza image(spec: macho.ImageSpec) -> elf.ImageResult { kaesu image_bounded(spec, maximum_globals); }

// A target runtime (the thread layer) may append separately owned words after the program's globals. They live in the zero-filled data segment
// (bss): they cost no file size and may not consume existing global slots.
koukai waza image_with_runtime(spec: macho.ImageSpec, runtime_words: int64) -> elf.ImageResult {
    moshi (spec.globals < 0 || spec.globals > maximum_globals || runtime_words < 0 || runtime_words > 1048576) { kaesu image_failed("TOO_MANY_GLOBALS"); }
    kaesu image_bounded(macho.ImageSpec { words: spec.words, constants: spec.constants, globals: spec.globals + runtime_words, patches: spec.patches }, maximum_globals + 1048576);
}

waza image_bounded(spec: macho.ImageSpec, limit: int64) -> elf.ImageResult {
    moshi (len(spec.words) == 0) { kaesu image_failed("EMPTY_TEXT"); }
    moshi (spec.globals < 0 || spec.globals > limit) { kaesu image_failed("TOO_MANY_GLOBALS"); }
    moshi (len(spec.words) > maximum_image_size / 4 || len(spec.constants) > maximum_image_size) { kaesu image_failed("IMAGE_TOO_LARGE"); }
    kaku code_base = elf.image_base + elf.code_offset;
    kaku const_offset = align(len(spec.words) * 4, 8);
    kaku words = array.clone(spec.words);
    kaku index = 0;
    aida (index < len(spec.patches)) {
        kaku patch = spec.patches[index];
        moshi (patch.at_word < 0 || patch.at_word >= len(words) || patch.target_offset < 0 || patch.target.kind < 0 || patch.target.kind > 2) { kaesu image_failed("INVALID_PATCH"); }
        kaku target = code_base + patch.target_offset;
        moshi (patch.target.kind == 0 && patch.target_offset >= len(spec.words) * 4) { kaesu image_failed("INVALID_PATCH"); }
        moshi (patch.target.kind == 1) {
            moshi (patch.target_offset >= len(spec.constants)) { kaesu image_failed("INVALID_PATCH"); }
            target = code_base + const_offset + patch.target_offset;
        }
        moshi (patch.target.kind == 2) {
            moshi (patch.target_offset >= spec.globals * 8) { kaesu image_failed("INVALID_PATCH"); }
            target = elf.data_base + patch.target_offset;
        }
        kaku encoded = arm64.adrp_offset(patch.register, code_base + patch.at_word * 4, target);
        moshi (encoded.error != mu) { kaesu image_failed("ENCODE"); }
        words[patch.at_word] = encoded.word;
        moshi (patch.add_at_word >= 0) {
            moshi (patch.add_at_word >= len(words) || patch.add_at_word == patch.at_word) { kaesu image_failed("INVALID_PATCH"); }
            kaku addition = arm64.add_imm_x(patch.register, patch.register, target - (target / 4096) * 4096, iie);
            moshi (addition.error != mu) { kaesu image_failed("ENCODE"); }
            words[patch.add_at_word] = addition.word;
        }
        index = index + 1;
    }
    kaku code: []uint8 = array.with_capacity[uint8](len(spec.words) * 4 + len(spec.constants) + 64);
    index = 0;
    aida (index < len(words)) { push_word(code, words[index]); index = index + 1; }
    aida (len(code) < const_offset) { array.push(code, uint8(0)); }
    array.append_all(code, spec.constants);
    aida (len(code) - (len(code) / 4) * 4 != 0) { array.push(code, uint8(0)); }
    kaku start = len(code);
    // _start: x0 = argc, x1 = &argv[0], x2 = &envp[0] = argv + 8 * (argc + 1); then branch to word 0.
    kaku sequence = [arm64.ldr_x(0, 31, 0), arm64.add_imm_x(1, 31, 8, iie), arm64.add_imm_x(3, 0, 1, iie), arm64.lsl_x(3, 3, 3),
        arm64.add_x(2, 1, 3), arm64.b(-(start / 4) - 5)];
    index = 0;
    aida (index < len(sequence)) {
        moshi (sequence[index].error != mu) { kaesu image_failed("ENCODE"); }
        push_word(code, sequence[index].word); index = index + 1;
    }
    kaesu elf.executable_aarch64(elf.ImageSpec { code: code, entry_offset: start, bss_size: spec.globals * 8 });
}
