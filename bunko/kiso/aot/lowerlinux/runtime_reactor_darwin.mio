yobu "kiso/aot/x86_64";
yobu "kiso/convert";
yobu "kiso/string";

// macOS x86-64 reactor (group M): kqueue backend of the mio/sys/socket reactor primitives, emitted instead of the epoll routines when the
// lowering targets Darwin (the label darwin_abi exists). The routines call kqueue (362) and kevent (363) through the same `syscall`
// instruction as the rest of the runtime; the Darwin adapter passes both numbers through unchanged (darwinabi.mio) and converts a failed
// call to the usual negative Linux errno. Same contract as the epoll and AArch64 kqueue backends: level-triggered EVFILT_READ and
// EVFILT_WRITE with the 64-bit token in udata, a wake-up kqueue registered with the poll kqueue and triggered through EVFILT_USER, EINTR
// as zero events. struct kevent: ident 0, filter int16 8, flags uint16 10, fflags uint32 12, data 16, udata 24 (32 bytes).

// rt.reactor_change: rdi = kqueue, rsi = ident, rdx = filter (1 read, 2 write), rcx = flags, r8 = udata -> rax = 0 or -errno.
// Deleting a filter that is not registered (ENOENT) is not an error.
waza emit_kqueue_change(code: x86_64.Assembler) -> unit {
    x86_64.label(code, "rt.reactor_change");
    x86_64.push_r(code, x86_64.rbp);
    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);
    x86_64.sub_ri(code, x86_64.rsp, 64);
    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rcx);
    x86_64.mov_store(code, x86_64.rbp, -48, x86_64.rsi);
    x86_64.mov_ri(code, x86_64.rax, 0);
    x86_64.sub_rr(code, x86_64.rax, x86_64.rdx);
    x86_64.mov_ri(code, x86_64.r9, 65535);
    x86_64.and_rr(code, x86_64.rax, x86_64.r9);
    x86_64.shl_ri(code, x86_64.rcx, 16);
    x86_64.or_rr(code, x86_64.rax, x86_64.rcx);
    x86_64.mov_store(code, x86_64.rbp, -40, x86_64.rax);
    x86_64.mov_ri(code, x86_64.rax, 0);
    x86_64.mov_store(code, x86_64.rbp, -32, x86_64.rax);
    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.r8);
    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -48);
    x86_64.mov_ri(code, x86_64.rdx, 1);
    x86_64.mov_ri(code, x86_64.r10, 0);
    x86_64.mov_ri(code, x86_64.r8, 0);
    x86_64.mov_ri(code, x86_64.r9, 0);
    x86_64.mov_eax_imm(code, 363);
    x86_64.syscall(code);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_ge, "rt.reactor_change.done");
    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -8);
    x86_64.cmp_ri(code, x86_64.rcx, 2);
    x86_64.jcc(code, x86_64.cc_ne, "rt.reactor_change.done");
    x86_64.cmp_ri(code, x86_64.rax, -2);
    x86_64.jcc(code, x86_64.cc_ne, "rt.reactor_change.done");
    x86_64.mov_ri(code, x86_64.rax, 0);
    x86_64.label(code, "rt.reactor_change.done");
    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);
    x86_64.pop_r(code, x86_64.rbp);
    x86_64.ret(code);
}

koukai waza emit_reactor_kqueue(code: x86_64.Assembler) -> unit {
    emit_kqueue_change(code);

    // rt.reactor_open: rdi = kind (0 poll kqueue, 1 wake kqueue; any other kind is invalid) -> token
    x86_64.label(code, "rt.reactor_open");
    x86_64.cmp_ri(code, x86_64.rdi, 0);
    x86_64.jcc(code, x86_64.cc_e, "rt.reactor_open.kqueue");
    x86_64.cmp_ri(code, x86_64.rdi, 1);
    x86_64.jcc(code, x86_64.cc_e, "rt.reactor_open.kqueue");
    x86_64.mov_ri(code, x86_64.rax, -22);
    x86_64.jmp(code, "rt.sock_wrap");
    x86_64.label(code, "rt.reactor_open.kqueue");
    x86_64.mov_eax_imm(code, 362);
    x86_64.syscall(code);
    x86_64.jmp(code, "rt.sock_wrap");

    // rt.reactor_ctl: rdi = reactor token, rsi = target token, rdx = packed (op | interest << 8 | token << 16), rcx = status array -> message.
    // Frame: -8 status, -16 packed, -24 target token, -32 kqueue, -40 target descriptor, -48 op, -56 interest, -64 token.
    x86_64.label(code, "rt.reactor_ctl");
    x86_64.push_r(code, x86_64.rbp);
    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);
    x86_64.sub_ri(code, x86_64.rsp, 80);
    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rcx);
    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rdx);
    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rsi);
    x86_64.call(code, "rt.sock_fd");
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_l, "rt.reactor_ctl.state");
    x86_64.mov_store(code, x86_64.rbp, -32, x86_64.rax);
    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -24);
    x86_64.call(code, "rt.sock_fd");
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_l, "rt.reactor_ctl.state");
    x86_64.mov_store(code, x86_64.rbp, -40, x86_64.rax);
    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -16);
    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);
    x86_64.jcc(code, x86_64.cc_l, "rt.reactor_ctl.invalid");
    x86_64.mov_rr(code, x86_64.rsi, x86_64.rdx);
    x86_64.and_ri(code, x86_64.rsi, 255);
    x86_64.cmp_ri(code, x86_64.rsi, 1);
    x86_64.jcc(code, x86_64.cc_l, "rt.reactor_ctl.invalid");
    x86_64.cmp_ri(code, x86_64.rsi, 3);
    x86_64.jcc(code, x86_64.cc_g, "rt.reactor_ctl.invalid");
    x86_64.mov_store(code, x86_64.rbp, -48, x86_64.rsi);
    x86_64.mov_rr(code, x86_64.rcx, x86_64.rdx);
    x86_64.shr_ri(code, x86_64.rcx, 8);
    x86_64.and_ri(code, x86_64.rcx, 255);
    x86_64.cmp_ri(code, x86_64.rcx, 3);
    x86_64.jcc(code, x86_64.cc_g, "rt.reactor_ctl.invalid");
    x86_64.mov_store(code, x86_64.rbp, -56, x86_64.rcx);
    x86_64.shr_ri(code, x86_64.rdx, 16);
    x86_64.mov_store(code, x86_64.rbp, -64, x86_64.rdx);
    kaku filter = 1;
    aida (filter <= 2) {
        kaku tag = string.concat("rt.reactor_ctl.f", convert.format_int(filter));
        x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -48);
        x86_64.cmp_ri(code, x86_64.rax, 2);
        x86_64.jcc(code, x86_64.cc_e, string.concat(tag, ".delete"));
        x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -56);
        x86_64.and_ri(code, x86_64.rax, filter);
        x86_64.test_rr(code, x86_64.rax, x86_64.rax);
        x86_64.jcc(code, x86_64.cc_ne, string.concat(tag, ".add"));
        x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -48);
        x86_64.cmp_ri(code, x86_64.rax, 3);
        x86_64.jcc(code, x86_64.cc_e, string.concat(tag, ".delete"));
        x86_64.jmp(code, string.concat(tag, ".next"));
        x86_64.label(code, string.concat(tag, ".add"));
        x86_64.mov_ri(code, x86_64.rcx, 5);
        x86_64.jmp(code, string.concat(tag, ".call"));
        x86_64.label(code, string.concat(tag, ".delete"));
        x86_64.mov_ri(code, x86_64.rcx, 2);
        x86_64.label(code, string.concat(tag, ".call"));
        x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -32);
        x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -40);
        x86_64.mov_ri(code, x86_64.rdx, filter);
        x86_64.mov_load(code, x86_64.r8, x86_64.rbp, -64);
        x86_64.call(code, "rt.reactor_change");
        x86_64.test_rr(code, x86_64.rax, x86_64.rax);
        x86_64.jcc(code, x86_64.cc_l, "rt.reactor_ctl.errno");
        x86_64.label(code, string.concat(tag, ".next"));
        filter = filter + 1;
    }
    x86_64.mov_ri(code, x86_64.rsi, 0);
    x86_64.jmp(code, "rt.reactor_ctl.done");
    x86_64.label(code, "rt.reactor_ctl.errno");
    x86_64.neg_r(code, x86_64.rax);
    x86_64.call(code, "rt.sock_classify");
    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);
    x86_64.jmp(code, "rt.reactor_ctl.done");
    x86_64.label(code, "rt.reactor_ctl.invalid");
    x86_64.mov_ri(code, x86_64.rsi, 1);
    x86_64.jmp(code, "rt.reactor_ctl.done");
    x86_64.label(code, "rt.reactor_ctl.state");
    x86_64.neg_r(code, x86_64.rax);
    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);
    x86_64.label(code, "rt.reactor_ctl.done");
    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);
    x86_64.call(code, "rt.sock_status_one");
    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);
    x86_64.pop_r(code, x86_64.rbp);
    x86_64.ret(code);

    // rt.reactor_wait: rdi = reactor token, rsi = event array (16 bytes per event: token, mask), rdx = max (1..64), rcx = timeout ms (-1 waits,
    // 0 polls), r8 = status array -> message. Frame: -8 status, -16 events array, -24 max, -32 timeout, -40 kqueue, -48 count, -64 timespec,
    // kernel buffer (64 * 32 bytes) at rbp-2112 .. rbp-64.
    x86_64.label(code, "rt.reactor_wait");
    x86_64.push_r(code, x86_64.rbp);
    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);
    x86_64.sub_ri(code, x86_64.rsp, 2128);
    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.r8);
    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rsi);
    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rdx);
    x86_64.mov_store(code, x86_64.rbp, -32, x86_64.rcx);
    x86_64.test_rr(code, x86_64.r8, x86_64.r8);
    x86_64.jcc(code, x86_64.cc_e, "rt.trap.nil");
    x86_64.call(code, "rt.sock_fd");
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_l, "rt.reactor_wait.state");
    x86_64.mov_store(code, x86_64.rbp, -40, x86_64.rax);
    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -16);
    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);
    x86_64.jcc(code, x86_64.cc_e, "rt.trap.nil");
    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -24);
    x86_64.cmp_ri(code, x86_64.rdx, 1);
    x86_64.jcc(code, x86_64.cc_l, "rt.reactor_wait.invalid");
    x86_64.cmp_ri(code, x86_64.rdx, 64);
    x86_64.jcc(code, x86_64.cc_g, "rt.reactor_wait.invalid");
    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -32);
    x86_64.cmp_ri(code, x86_64.rcx, -1);
    x86_64.jcc(code, x86_64.cc_l, "rt.reactor_wait.invalid");
    x86_64.mov_ri(code, x86_64.rax, 2147483647);
    x86_64.cmp_rr(code, x86_64.rcx, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_g, "rt.reactor_wait.invalid");
    x86_64.mov_load(code, x86_64.rax, x86_64.rsi, 16);
    x86_64.mov_rr(code, x86_64.rcx, x86_64.rdx);
    x86_64.shl_ri(code, x86_64.rcx, 4);
    x86_64.cmp_rr(code, x86_64.rcx, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_g, "rt.reactor_wait.invalid");
    // timeout: -1 -> NULL timespec; otherwise {ms / 1000, (ms % 1000) * 1000000}
    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -32);
    x86_64.cmp_ri(code, x86_64.rax, 0);
    x86_64.jcc(code, x86_64.cc_l, "rt.reactor_wait.infinite");
    x86_64.mov_ri(code, x86_64.rdx, 0);
    x86_64.mov_ri(code, x86_64.rcx, 1000);
    x86_64.div_r(code, x86_64.rcx);
    x86_64.mov_store(code, x86_64.rbp, -64, x86_64.rax);
    x86_64.mov_ri(code, x86_64.rcx, 1000000);
    x86_64.imul_rr(code, x86_64.rdx, x86_64.rcx);
    x86_64.mov_store(code, x86_64.rbp, -56, x86_64.rdx);
    x86_64.lea(code, x86_64.r9, x86_64.rbp, -64);
    x86_64.jmp(code, "rt.reactor_wait.call");
    x86_64.label(code, "rt.reactor_wait.infinite");
    x86_64.mov_ri(code, x86_64.r9, 0);
    x86_64.label(code, "rt.reactor_wait.call");
    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -40);
    x86_64.mov_ri(code, x86_64.rsi, 0);
    x86_64.mov_ri(code, x86_64.rdx, 0);
    x86_64.lea(code, x86_64.r10, x86_64.rbp, -2112);
    x86_64.mov_load(code, x86_64.r8, x86_64.rbp, -24);
    x86_64.mov_eax_imm(code, 363);
    x86_64.syscall(code);
    x86_64.cmp_ri(code, x86_64.rax, -4);
    x86_64.jcc(code, x86_64.cc_e, "rt.reactor_wait.none");
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_l, "rt.reactor_wait.errno");
    x86_64.mov_store(code, x86_64.rbp, -48, x86_64.rax);
    x86_64.mov_load(code, x86_64.r9, x86_64.rbp, -16);
    x86_64.mov_load(code, x86_64.r9, x86_64.r9, 40);
    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -2112);
    x86_64.mov_ri(code, x86_64.rcx, 0);
    x86_64.label(code, "rt.reactor_wait.copy");
    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -48);
    x86_64.cmp_rr(code, x86_64.rcx, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_ge, "rt.reactor_wait.copied");
    x86_64.mov_load(code, x86_64.rdi, x86_64.rsi, 24);
    x86_64.mov_store(code, x86_64.r9, 0, x86_64.rdi);
    x86_64.mov_load(code, x86_64.rdx, x86_64.rsi, 8);
    x86_64.mov_rr(code, x86_64.r11, x86_64.rdx);
    x86_64.mov_ri(code, x86_64.rax, 65535);
    x86_64.and_rr(code, x86_64.rdx, x86_64.rax);
    x86_64.shr_ri(code, x86_64.r11, 16);
    x86_64.and_rr(code, x86_64.r11, x86_64.rax);
    x86_64.mov_ri(code, x86_64.r8, 0);
    x86_64.cmp_rr(code, x86_64.rdx, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_ne, "rt.reactor_wait.not_read");
    x86_64.add_ri(code, x86_64.r8, 1);
    x86_64.label(code, "rt.reactor_wait.not_read");
    x86_64.mov_ri(code, x86_64.rax, 65534);
    x86_64.cmp_rr(code, x86_64.rdx, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_ne, "rt.reactor_wait.not_write");
    x86_64.add_ri(code, x86_64.r8, 2);
    x86_64.label(code, "rt.reactor_wait.not_write");
    x86_64.mov_rr(code, x86_64.rax, x86_64.r11);
    x86_64.and_ri(code, x86_64.rax, 16384);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.reactor_wait.no_error");
    x86_64.add_ri(code, x86_64.r8, 4);
    x86_64.label(code, "rt.reactor_wait.no_error");
    x86_64.mov_rr(code, x86_64.rax, x86_64.r11);
    x86_64.and_ri(code, x86_64.rax, 32768);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.reactor_wait.no_eof");
    x86_64.add_ri(code, x86_64.r8, 8);
    x86_64.label(code, "rt.reactor_wait.no_eof");
    x86_64.mov_store(code, x86_64.r9, 8, x86_64.r8);
    x86_64.add_ri(code, x86_64.r9, 16);
    x86_64.add_ri(code, x86_64.rsi, 32);
    x86_64.add_ri(code, x86_64.rcx, 1);
    x86_64.jmp(code, "rt.reactor_wait.copy");
    x86_64.label(code, "rt.reactor_wait.copied");
    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -48);
    x86_64.mov_ri(code, x86_64.rdx, 0);
    x86_64.mov_ri(code, x86_64.rcx, 0);
    x86_64.jmp(code, "rt.reactor_wait.status");
    x86_64.label(code, "rt.reactor_wait.none");
    x86_64.mov_ri(code, x86_64.rsi, 0);
    x86_64.mov_ri(code, x86_64.rdx, 0);
    x86_64.mov_ri(code, x86_64.rcx, 0);
    x86_64.jmp(code, "rt.reactor_wait.status");
    x86_64.label(code, "rt.reactor_wait.errno");
    x86_64.neg_r(code, x86_64.rax);
    x86_64.call(code, "rt.sock_classify");
    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);
    x86_64.mov_ri(code, x86_64.rsi, 0);
    x86_64.mov_ri(code, x86_64.rdx, 0);
    x86_64.jmp(code, "rt.reactor_wait.status");
    x86_64.label(code, "rt.reactor_wait.invalid");
    x86_64.mov_ri(code, x86_64.rcx, 1);
    x86_64.mov_ri(code, x86_64.rsi, 0);
    x86_64.mov_ri(code, x86_64.rdx, 0);
    x86_64.jmp(code, "rt.reactor_wait.status");
    x86_64.label(code, "rt.reactor_wait.state");
    x86_64.neg_r(code, x86_64.rax);
    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);
    x86_64.mov_ri(code, x86_64.rsi, 0);
    x86_64.mov_ri(code, x86_64.rdx, 0);
    x86_64.label(code, "rt.reactor_wait.status");
    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);
    x86_64.call(code, "rt.sock_status_io");
    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);
    x86_64.pop_r(code, x86_64.rbp);
    x86_64.ret(code);

    // rt.reactor_signal: rdi = wake kqueue token, rsi = status array -> message. One kevent with two changes: ADD an EVFILT_USER event
    // (EV_ADD | EV_CLEAR) and trigger it (NOTE_TRIGGER); repeating it keeps the event pending (wakes coalesce).
    x86_64.label(code, "rt.reactor_signal");
    x86_64.push_r(code, x86_64.rbp);
    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);
    x86_64.sub_ri(code, x86_64.rsp, 96);
    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rsi);
    x86_64.call(code, "rt.sock_fd");
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_l, "rt.reactor_signal.state");
    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rax);
    x86_64.mov_ri(code, x86_64.rax, 1);
    x86_64.mov_store(code, x86_64.rbp, -88, x86_64.rax);
    x86_64.mov_store(code, x86_64.rbp, -56, x86_64.rax);
    x86_64.mov_ri(code, x86_64.rax, 2228214);
    x86_64.mov_store(code, x86_64.rbp, -80, x86_64.rax);
    x86_64.mov_ri(code, x86_64.rax, 16777216);
    x86_64.shl_ri(code, x86_64.rax, 32);
    x86_64.mov_ri(code, x86_64.rcx, 65526);
