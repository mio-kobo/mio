yobu "kiso/encoding/mochi";
yobu "kiso/testing";

waza plain_program() -> mochi.File { kaesu mochi.File { version: 14, constants: [], global_count: 0, instructions: [], functions: [] }; }

// A program that only declares the thread natives (never calls them): enough to select the multi-mutator runtime.
waza threaded_program() -> mochi.File {
    kaku name = "$mma::mio/thread/runtime::start::a3d1240461811d5cb81abc2a8540289381e974014b9673e90fde86ab68e0b5a0";
    kaku start = mochi.Function { id: 0, name: name, name_bytes: [], parameter_count: 1, local_count: 1, returns_value: hai, captures: [], instructions: [] };
    kaesu mochi.File { version: 14, constants: [], global_count: 0, instructions: [], functions: [start] };
}

waza test_programs_without_thread_natives_keep_the_single_mutator_runtime() -> unit {
    kaku first = compile(plain_program());
    kaku second = compile(plain_program());
    testing.expect(first.error == "" && second.error == "", "plain programs lower");
    testing.expect(len(first.bytes) == len(second.bytes), "plain lowering is deterministic");
    kaku threaded = compile(threaded_program());
    testing.expect(threaded.error == "", "a program that references the thread natives lowers on Linux x86-64");
    testing.expect(len(threaded.bytes) > len(first.bytes), "the multi-mutator runtime (registry, safepoint park, thread start/join) is added only then");
}

waza test_threads_fail_closed_on_macos_x86_64() -> unit {
    kaku macos = compile_darwin_amd64(threaded_program(), 33554432);
    testing.expect(macos.error == "UNSUPPORTED_THREADS_TARGET", "the Darwin lowering rejects OS threads instead of running them single-threaded");
    testing.expect(len(macos.bytes) == 0, "no image is produced");
}

waza test_mutator_record_layout_is_consistent() -> unit {
    testing.expect(rec_self == 0 && rec_next == 8 && rec_state == 16 && rec_rbp == 24 && rec_ret == 32 && rec_entry == 40, "record words");
    testing.expect(rec_tid == 48 && rec_result == 56 && rec_base == 64 && rec_size == 72, "record words (join and stack)");
    testing.expect(mut_lock != 72 && mut_lock != 80 && mut_stop != 72 && mut_stop != 80 && mut_count != 72 && mut_count != 80 && mut_registry != 72 && mut_registry != 80,
        "gc_state()+72 is the saved initial stack pointer and +80 the testing counter: the mutator words must not alias them");
    testing.expect(mut_main_record + 128 <= 4096 - 3600, "the main record fits between the collector state and the free-list bins");
    testing.expect(clone_flags == 4001536, "CLONE_VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|SETTLS|PARENT_SETTID|CHILD_CLEARTID");
}

waza test_handle_table_and_slab_words_do_not_alias_other_state() -> unit {
    testing.expect(mut_table == 120 && mut_slab_next == 128 && mut_slab_end == 136, "table and slab words");
    testing.expect(mut_table != 72 && mut_table != 80 && mut_slab_next != 72 && mut_slab_next != 80, "not the saved stack pointer / testing counter");
    testing.expect(mut_main_record > mut_slab_end, "the main record starts after the last state word");
    testing.expect(thread_slots == 4096 && thread_slots * 16 == 65536, "4096 slots of 16 bytes");
    testing.expect(rec_joinerr == 80 && rec_joinerr + 8 <= 128, "the join status word is inside the 128-byte record");
    testing.expect(rec_pin0 >= rec_cache + 40 && rec_pin1 == rec_pin0 + 8, "blocking roots must not alias any allocation-cache list");
    testing.expect(rec_pin0 > 128 && rec_pin1 + 8 <= 256, "blocking roots leave the stack-pool link free and fit in the reserved thread record area");
    testing.expect(mut_main_record + rec_pin1 + 8 <= 4096 - 3600, "main-thread blocking roots must not overlap the free-list bins");
}
