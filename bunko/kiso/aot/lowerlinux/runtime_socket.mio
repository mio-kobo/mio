waza emit_reactor_epoll(code: x86_64.Assembler) -> unit {
    // ---- reactor (epoll) primitives ----
    // rt.reactor_open: rdi = kind (0 epoll instance, 1 eventfd) -> token (a failed handle carries the error)
    x86_64.label(code, "rt.reactor_open");
    x86_64.cmp_ri(code, x86_64.rdi, 0);
    x86_64.jcc(code, x86_64.cc_e, "rt.reactor_open.epoll");
