    // the destination array must hold 16 * max bytes
    x86_64.mov_load(code, x86_64.rax, x86_64.rsi, 16);
    x86_64.mov_rr(code, x86_64.rcx, x86_64.rdx);
    x86_64.shl_ri(code, x86_64.rcx, 4);
    x86_64.cmp_rr(code, x86_64.rcx, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_g, "rt.reactor_wait.invalid");
    // epoll_wait(epfd, buffer, max, timeout)
    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -40);
    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -816);
    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -24);
    x86_64.mov_load(code, x86_64.r10, x86_64.rbp, -32);
    x86_64.mov_eax_imm(code, 232);
    x86_64.syscall(code);
    x86_64.cmp_ri(code, x86_64.rax, -4);
    x86_64.jcc(code, x86_64.cc_e, "rt.reactor_wait.none");
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_l, "rt.reactor_wait.errno");
    x86_64.mov_store(code, x86_64.rbp, -48, x86_64.rax);
