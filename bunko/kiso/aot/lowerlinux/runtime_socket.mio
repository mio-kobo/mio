    x86_64.jmp(code, "rt.sock_wrap");
    x86_64.label(code, "rt.reactor_open.epoll");
    x86_64.mov_ri(code, x86_64.rdi, 524288);
    x86_64.mov_eax_imm(code, 291);
    x86_64.syscall(code);
    x86_64.jmp(code, "rt.sock_wrap");
    x86_64.label(code, "rt.reactor_open.eventfd");
    x86_64.mov_ri(code, x86_64.rdi, 0);
    x86_64.mov_ri(code, x86_64.rsi, 526336);
    x86_64.mov_eax_imm(code, 290);
    x86_64.syscall(code);
    x86_64.jmp(code, "rt.sock_wrap");

