    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);
    x86_64.label(code, "rt.reactor_ctl.done");
    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);
    x86_64.call(code, "rt.sock_status_one");
    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);
    x86_64.pop_r(code, x86_64.rbp);
    x86_64.ret(code);

    // rt.reactor_wait: rdi = reactor token, rsi = event array (16 bytes per event: token, mask), rdx = max (1..64),
    // rcx = timeout ms (-1 waits, 0 polls), r8 = status array (count) -> message
    x86_64.label(code, "rt.reactor_wait");
