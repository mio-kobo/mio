    x86_64.mov_load(code, x86_64.r9, x86_64.rbp, -16);
    x86_64.mov_load(code, x86_64.r9, x86_64.r9, 40);
    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -816);
