yobu "kiso/aot/elf";
yobu "kiso/array";
yobu "kiso/string";

// Pure Mio macOS x86-64 Mach-O (MH_EXECUTE) writer for the Linux-convention x86-64 lowering (kiso/aot/lowerlinux).
//
// The image keeps the ELF writer's fixed, position-dependent addresses so the lowered code needs no relocation:
//   __PAGEZERO  0x0 .. 0x400000                       (no access)
//   __TEXT      vm 0x400000 (file 0): header, load commands and the code at file offset 0x1000   r-x
//   __DATA      vm 0x10000000, zero-fill (no file bytes)                                          rw-
//   __LINKEDIT  after __DATA (empty)
// Load commands: LC_LOAD_DYLINKER /usr/lib/dyld, LC_BUILD_VERSION (macOS minos 11.0), empty LC_SYMTAB/LC_DYSYMTAB and
// LC_MAIN. The header has no MH_PIE flag: x86-64 macOS runs fixed-address executables. cputype is CPU_TYPE_X86_64
// (0x01000007) and cpusubtype CPU_SUBTYPE_X86_64_ALL (3). dyld enters at LC_MAIN's entryoff with the C calling
// convention main(argc, argv, envp); the caller of this writer is responsible for the first instructions at the entry.
koukai teisu text_base = 4194304;
koukai teisu code_offset = 4096;
koukai teisu data_base = 268435456;
teisu page_size = 4096;
teisu maximum_text_size = 264241152;
teisu maximum_bss_size = 268435456;
teisu header_size = 32;

koukai kata ImageSpec { code: []uint8; entry_offset: int64; bss_size: int64; }
koukai kata ImageResult { bytes: []uint8; error: string; }

waza put(out: []uint8, value: int64, width: int64) -> unit {
    kaku x = value; moshi (x < 0) { x = x + 4294967296; }
    kaku i = 0;
    aida (i < width) { array.push(out, uint8(x - (x / 256) * 256)); x = x / 256; i = i + 1; }
}
// 64-bit values below 2^62 as two halves
waza put64(out: []uint8, value: int64) -> unit { put(out, value - (value / 4294967296) * 4294967296, 4); put(out, value / 4294967296, 4); }
waza name16(out: []uint8, text: string) -> unit {
    kaku bytes = string.to_bytes(text); array.append_all(out, bytes);
    kaku n = len(bytes); aida (n < 16) { array.push(out, uint8(0)); n = n + 1; }
}
waza align(value: int64, boundary: int64) -> int64 {
    kaku r = value - (value / boundary) * boundary;
    moshi (r == 0) { kaesu value; }
    kaesu value + boundary - r;
}
// LC_SEGMENT_64: name, vmaddr, vmsize, fileoff, filesize, maxprot, initprot, nsects (command size 72 + 80 * nsects)
waza segment(out: []uint8, name: string, vmaddr: int64, vmsize: int64, fileoff: int64, filesize: int64, maxprot: int64, initprot: int64, sections: int64) -> unit {
    put(out, 25, 4); put(out, 72 + 80 * sections, 4); name16(out, name); put64(out, vmaddr); put64(out, vmsize); put64(out, fileoff); put64(out, filesize);
    put(out, maxprot, 4); put(out, initprot, 4); put(out, sections, 4); put(out, 0, 4);
}
waza section(out: []uint8, name: string, segment_name: string, addr: int64, size: int64, offset: int64, alignment: int64, flags: int64) -> unit {
    name16(out, name); name16(out, segment_name); put64(out, addr); put64(out, size); put(out, offset, 4); put(out, alignment, 4);
    put(out, 0, 4); put(out, 0, 4); put(out, flags, 4); put(out, 0, 4); put(out, 0, 4); put(out, 0, 4);
}

koukai waza executable(spec: ImageSpec) -> ImageResult {
    moshi (len(spec.code) == 0) { kaesu ImageResult { bytes: [], error: "EMPTY_TEXT" }; }
    moshi (spec.entry_offset < 0 || spec.entry_offset >= len(spec.code)) { kaesu ImageResult { bytes: [], error: "INVALID_ENTRY" }; }
    moshi (spec.bss_size < 0 || spec.bss_size > maximum_bss_size) { kaesu ImageResult { bytes: [], error: "INVALID_BSS" }; }
    kaku text_end = code_offset + len(spec.code);
    moshi (text_end > maximum_text_size) { kaesu ImageResult { bytes: [], error: "IMAGE_TOO_LARGE" }; }
    kaku file_size = align(text_end, page_size);
    kaku has_data = spec.bss_size > 0;
    kaku data_size = align(spec.bss_size, page_size);
    kaku commands = 8;
    moshi (has_data) { commands = commands + 1; }
    // 8 commands without __DATA (PAGEZERO, TEXT, LINKEDIT, DYLINKER, BUILD_VERSION, SYMTAB, DYSYMTAB, MAIN), 9 with it.
    // sizes: PAGEZERO 72, TEXT 72+80, DATA 72+80, LINKEDIT 72, DYLINKER 32, BUILD_VERSION 24, SYMTAB 24, DYSYMTAB 80, MAIN 24
    kaku command_bytes = 72 + 152 + 72 + 32 + 24 + 24 + 80 + 24;
    moshi (has_data) { command_bytes = command_bytes + 152; }
    moshi (header_size + command_bytes > code_offset) { kaesu ImageResult { bytes: [], error: "LOAD_COMMANDS_TOO_LARGE" }; }
    kaku out: []uint8 = array.with_capacity[uint8](file_size);
    // mach_header_64
    put(out, 4277009103, 4); put(out, 16777223, 4); put(out, 3, 4); put(out, 2, 4);
    put(out, commands, 4); put(out, command_bytes, 4); put(out, 133, 4); put(out, 0, 4);
    segment(out, "__PAGEZERO", 0, text_base, 0, 0, 0, 0, 0);
    segment(out, "__TEXT", text_base, file_size, 0, file_size, 5, 5, 1);
    section(out, "__text", "__TEXT", text_base + code_offset, len(spec.code), code_offset, 4, 2147484672);
    kaku linkedit_vm = text_base + file_size;
    moshi (has_data) {
        segment(out, "__DATA", data_base, data_size, 0, 0, 3, 3, 1);
        section(out, "__bss", "__DATA", data_base, spec.bss_size, 0, 3, 1);
        linkedit_vm = data_base + data_size;
    }
    segment(out, "__LINKEDIT", linkedit_vm, page_size, file_size, 0, 1, 1, 0);
    // LC_LOAD_DYLINKER "/usr/lib/dyld"
    put(out, 14, 4); put(out, 32, 4); put(out, 12, 4); array.append_all(out, string.to_bytes("/usr/lib/dyld"));
    kaku pad = 0; aida (pad < 7) { array.push(out, uint8(0)); pad = pad + 1; }
    // LC_BUILD_VERSION: platform macOS (1), minos 11.0, sdk 11.0, no tools
    put(out, 50, 4); put(out, 24, 4); put(out, 1, 4); put(out, 720896, 4); put(out, 720896, 4); put(out, 0, 4);
    // empty LC_SYMTAB and LC_DYSYMTAB
    put(out, 2, 4); put(out, 24, 4); kaku z = 0; aida (z < 16) { array.push(out, uint8(0)); z = z + 1; }
    put(out, 11, 4); put(out, 80, 4); z = 0; aida (z < 72) { array.push(out, uint8(0)); z = z + 1; }
    // LC_MAIN: entryoff (file offset of the entry), stacksize 0
    put(out, 2147483688, 4); put(out, 24, 4); put64(out, code_offset + spec.entry_offset); put64(out, 0);
    aida (len(out) < code_offset) { array.push(out, uint8(0)); }
    array.append_all(out, spec.code);
    aida (len(out) < file_size) { array.push(out, uint8(0)); }
    kaesu ImageResult { bytes: out, error: "" };
}
