yobu "kiso/array";
yobu "kiso/string";

// Pure Mio x86-64 (AMD64, 64-bit mode) encoder for the instruction subset that
// will be used by the Linux runtime-IR lowering. The language has no bit operators, so every
// field is composed with checked integer arithmetic. Registers are numbered as
// in the ISA: rax=0 rcx=1 rdx=2 rbx=3 rsp=4 rbp=5 rsi=6 rdi=7 r8..r15=8..15.
// Mutation is append-only through an Assembler; control flow uses 32-bit
// relative fixups resolved by assemble(). Failures are recorded, never truncated.
koukai kata Label { name: string; offset: int64; }
koukai kata Fixup { at: int64; target: string; }
// `table` holds one open-addressing hash table (label index + 1, 0 = empty) so that label lookup is O(1).
koukai kata Assembler { bytes: []uint8; labels: []Label; fixups: []Fixup; errors: []string; table: [][]int64; }
koukai kata AssembleResult { bytes: []uint8; error: string; }

koukai teisu rax = 0;
koukai teisu rcx = 1;
koukai teisu rdx = 2;
koukai teisu rbx = 3;
koukai teisu rsp = 4;
koukai teisu rbp = 5;
koukai teisu rsi = 6;
koukai teisu rdi = 7;
koukai teisu r8 = 8;
koukai teisu r9 = 9;
koukai teisu r10 = 10;
koukai teisu r11 = 11;
koukai teisu r12 = 12;
koukai teisu r13 = 13;
koukai teisu r14 = 14;
koukai teisu r15 = 15;
// Condition codes (low nibble of Jcc/SETcc opcodes).
koukai teisu cc_b = 2;
koukai teisu cc_ae = 3;
koukai teisu cc_e = 4;
koukai teisu cc_ne = 5;
koukai teisu cc_be = 6;
koukai teisu cc_a = 7;
koukai teisu cc_l = 12;
koukai teisu cc_ge = 13;
koukai teisu cc_le = 14;
koukai teisu cc_g = 15;

koukai waza assembler() -> Assembler {
    kaesu Assembler { bytes: array.with_capacity[uint8](256), labels: array.with_capacity[Label](16), fixups: array.with_capacity[Fixup](16), errors: array.with_capacity[string](1), table: [array.make[int64](256, 0)] };
}

waza fail(a: Assembler, message: string) -> unit { array.push(a.errors, message); }
waza low3(x: int64) -> int64 { kaesu x - (x / 8) * 8; }
waza high(x: int64) -> int64 { moshi (x >= 8) { kaesu 1; } kaesu 0; }
waza valid_register(a: Assembler, r: int64) -> bool {
    moshi (r < 0 || r > 15) { fail(a, "INVALID_REGISTER"); kaesu iie; }
    kaesu hai;
}
koukai waza byte(a: Assembler, value: int64) -> unit {
    moshi (value < 0 || value > 255) { fail(a, "INVALID_BYTE"); kaesu; }
    array.push(a.bytes, uint8(value));
}
waza imm32(a: Assembler, value: int64) -> unit {
    moshi (value < -2147483648 || value > 2147483647) { fail(a, "INVALID_IMMEDIATE"); kaesu; }
    kaku x = value; moshi (x < 0) { x = x + 4294967296; }
    kaku i = 0; aida (i < 4) { byte(a, x - (x / 256) * 256); x = x / 256; i = i + 1; }
}
// Two's-complement 64-bit little-endian; negative values use ~(-(v+1)).
waza imm64(a: Assembler, value: int64) -> unit {
    kaku negative = value < 0; kaku x = value; moshi (negative) { x = -(value + 1); }
    kaku i = 0;
    aida (i < 8) {
        kaku b = x - (x / 256) * 256; x = x / 256;
        moshi (negative) { b = 255 - b; }
        byte(a, b); i = i + 1;
    }
}
// REX.W prefix with R (reg field) and B (rm/base field) extensions.
waza rex(a: Assembler, reg: int64, rm: int64) -> unit { byte(a, 72 + high(reg) * 4 + high(rm)); }
waza modrm(a: Assembler, mode: int64, reg: int64, rm: int64) -> unit { byte(a, mode * 64 + low3(reg) * 8 + low3(rm)); }
// [base + disp32]; rsp/r12 bases require a SIB byte.
waza memory(a: Assembler, reg: int64, base: int64, disp: int64) -> unit {
    modrm(a, 2, reg, base);
    moshi (low3(base) == 4) { byte(a, 36); }
    imm32(a, disp);
}
koukai waza op_rr(a: Assembler, opcode: int64, rm: int64, reg: int64) -> unit {
    moshi (!valid_register(a, rm) || !valid_register(a, reg)) { kaesu; }
    rex(a, reg, rm); byte(a, opcode); modrm(a, 3, reg, rm);
}
koukai waza mov_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 137, dst, src); }
koukai waza add_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 1, dst, src); }
koukai waza sub_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 41, dst, src); }
koukai waza and_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 33, dst, src); }
koukai waza or_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 9, dst, src); }
koukai waza xor_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 49, dst, src); }
koukai waza cmp_rr(a: Assembler, left: int64, right: int64) -> unit { op_rr(a, 57, left, right); }
koukai waza test_rr(a: Assembler, left: int64, right: int64) -> unit { op_rr(a, 133, left, right); }
koukai waza xchg_rr(a: Assembler, left: int64, right: int64) -> unit { op_rr(a, 135, left, right); }
koukai waza imul_rr(a: Assembler, dst: int64, src: int64) -> unit {
    moshi (!valid_register(a, dst) || !valid_register(a, src)) { kaesu; }
    rex(a, dst, src); byte(a, 15); byte(a, 175); modrm(a, 3, dst, src);
}
// Unsigned divide rdx:rax by src (callers zero rdx).
koukai waza div_r(a: Assembler, src: int64) -> unit {
    moshi (!valid_register(a, src)) { kaesu; }
    rex(a, 0, src); byte(a, 247); modrm(a, 3, 6, src);
}
// Signed divide rdx:rax by src (callers run cqo first).
koukai waza idiv_r(a: Assembler, src: int64) -> unit {
    moshi (!valid_register(a, src)) { kaesu; }
    rex(a, 0, src); byte(a, 247); modrm(a, 3, 7, src);
}
// Sign-extend rax into rdx:rax.
koukai waza cqo(a: Assembler) -> unit { byte(a, 72); byte(a, 153); }
koukai waza neg_r(a: Assembler, dst: int64) -> unit {
    moshi (!valid_register(a, dst)) { kaesu; }
    rex(a, 0, dst); byte(a, 247); modrm(a, 3, 3, dst);
}
// mov [base + disp32], low byte of src (a bare REX prefix selects sil/dil/spl/bpl).
koukai waza mov_store8(a: Assembler, base: int64, disp: int64, src: int64) -> unit {
    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }
    byte(a, 64 + high(src) * 4 + high(base)); byte(a, 136); memory(a, src, base, disp);
}
// movzx dst, byte [base + disp32]
koukai waza mov_load8(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {
    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }
    rex(a, dst, base); byte(a, 15); byte(a, 182); memory(a, dst, base, disp);
}
// mov dst32, dword [base + disp32] (zero-extends into dst), mov dword [base + disp32], src32.
koukai waza mov_load32(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {
    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }
    byte(a, 64 + high(dst) * 4 + high(base)); byte(a, 139); memory(a, dst, base, disp);
}
koukai waza mov_store32(a: Assembler, base: int64, disp: int64, src: int64) -> unit {
    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }
    byte(a, 64 + high(src) * 4 + high(base)); byte(a, 137); memory(a, src, base, disp);
}
// movzx dst, word [base + disp32] and mov word [base + disp32], src16.
koukai waza mov_load16(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {
    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }
    byte(a, 64 + high(dst) * 4 + high(base)); byte(a, 15); byte(a, 183); memory(a, dst, base, disp);
}
koukai waza mov_store16(a: Assembler, base: int64, disp: int64, src: int64) -> unit {
    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }
    byte(a, 102); byte(a, 64 + high(src) * 4 + high(base)); byte(a, 137); memory(a, src, base, disp);
}
koukai waza mov_ri(a: Assembler, dst: int64, value: int64) -> unit {
    moshi (!valid_register(a, dst)) { kaesu; }
    rex(a, 0, dst); byte(a, 184 + low3(dst)); imm64(a, value);
}
koukai waza mov_load(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {
    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }
    rex(a, dst, base); byte(a, 139); memory(a, dst, base, disp);
}
koukai waza mov_store(a: Assembler, base: int64, disp: int64, src: int64) -> unit {
    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }
    rex(a, src, base); byte(a, 137); memory(a, src, base, disp);
}
koukai waza lea(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {
    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }
    rex(a, dst, base); byte(a, 141); memory(a, dst, base, disp);
}
koukai waza add_ri(a: Assembler, dst: int64, value: int64) -> unit {
    moshi (!valid_register(a, dst)) { kaesu; }
    rex(a, 0, dst); byte(a, 129); modrm(a, 3, 0, dst); imm32(a, value);
}
koukai waza sub_ri(a: Assembler, dst: int64, value: int64) -> unit {
    moshi (!valid_register(a, dst)) { kaesu; }
    rex(a, 0, dst); byte(a, 129); modrm(a, 3, 5, dst); imm32(a, value);
}
koukai waza and_ri(a: Assembler, dst: int64, value: int64) -> unit {
    moshi (!valid_register(a, dst)) { kaesu; }
    rex(a, 0, dst); byte(a, 129); modrm(a, 3, 4, dst); imm32(a, value);
}
koukai waza cmp_ri(a: Assembler, dst: int64, value: int64) -> unit {
    moshi (!valid_register(a, dst)) { kaesu; }
    rex(a, 0, dst); byte(a, 129); modrm(a, 3, 7, dst); imm32(a, value);
}
waza shift_ri(a: Assembler, dst: int64, extension: int64, count: int64) -> unit {
    moshi (!valid_register(a, dst)) { kaesu; }
    moshi (count < 0 || count > 63) { fail(a, "INVALID_SHIFT"); kaesu; }
    rex(a, 0, dst); byte(a, 193); modrm(a, 3, extension, dst); byte(a, count);
}
koukai waza shl_ri(a: Assembler, dst: int64, count: int64) -> unit { shift_ri(a, dst, 4, count); }
koukai waza shr_ri(a: Assembler, dst: int64, count: int64) -> unit { shift_ri(a, dst, 5, count); }
koukai waza sar_ri(a: Assembler, dst: int64, count: int64) -> unit { shift_ri(a, dst, 7, count); }
// rep movsb: copy rcx bytes from [rsi] to [rdi].
koukai waza rep_movsb(a: Assembler) -> unit { byte(a, 243); byte(a, 164); }
// ---- SSE scalar floating point (xmm0..xmm15) ----------------------------------------------------------
// prefix: 0 none, 102 (66), 242 (F2), 243 (F3); escape 1 = 0F xx, 2 = 0F 3A xx; `wide` adds REX.W.
// `reg` goes in ModRM.reg, `rm` in ModRM.rm (both registers).
waza sse_rr(a: Assembler, prefix: int64, wide: bool, escape: int64, op: int64, reg: int64, rm: int64) -> unit {
    moshi (!valid_register(a, reg) || !valid_register(a, rm)) { kaesu; }
    moshi (prefix != 0) { byte(a, prefix); }
    kaku rex_bits = high(reg) * 4 + high(rm);
    moshi (wide) { rex_bits = rex_bits + 8; }
    moshi (rex_bits != 0) { byte(a, 64 + rex_bits); }
    byte(a, 15);
    moshi (escape == 2) { byte(a, 58); }
    byte(a, op);
    modrm(a, 3, reg, rm);
}
koukai waza movq_xmm_r(a: Assembler, xmm: int64, r: int64) -> unit { sse_rr(a, 102, hai, 1, 110, xmm, r); }
koukai waza movq_r_xmm(a: Assembler, r: int64, xmm: int64) -> unit { sse_rr(a, 102, hai, 1, 126, xmm, r); }
koukai waza movd_xmm_r(a: Assembler, xmm: int64, r: int64) -> unit { sse_rr(a, 102, iie, 1, 110, xmm, r); }
koukai waza movd_r_xmm(a: Assembler, r: int64, xmm: int64) -> unit { sse_rr(a, 102, iie, 1, 126, xmm, r); }
// Arithmetic: double (F2) when `double`, single (F3) otherwise. op: 88 add, 92 sub, 89 mul, 94 div, 81 sqrt.
koukai waza sse_arith(a: Assembler, double: bool, op: int64, dst: int64, src: int64) -> unit {
    kaku prefix = 243;
    moshi (double) { prefix = 242; }
    sse_rr(a, prefix, iie, 1, op, dst, src);
}
koukai waza ucomis(a: Assembler, double: bool, left: int64, right: int64) -> unit {
    kaku prefix = 0;
    moshi (double) { prefix = 102; }
    sse_rr(a, prefix, iie, 1, 46, left, right);
}
koukai waza cvtsi2s(a: Assembler, double: bool, xmm: int64, r: int64) -> unit {
    kaku prefix = 243;
    moshi (double) { prefix = 242; }
    sse_rr(a, prefix, hai, 1, 42, xmm, r);
}
koukai waza cvtts2si(a: Assembler, double: bool, r: int64, xmm: int64) -> unit {
    kaku prefix = 243;
    moshi (double) { prefix = 242; }
    sse_rr(a, prefix, hai, 1, 44, r, xmm);
}
koukai waza cvtsd2ss(a: Assembler, dst: int64, src: int64) -> unit { sse_rr(a, 242, iie, 1, 90, dst, src); }
koukai waza cvtss2sd(a: Assembler, dst: int64, src: int64) -> unit { sse_rr(a, 243, iie, 1, 90, dst, src); }
// roundsd/roundss dst, src, mode (8 nearest-even, 9 floor, 10 ceil, 11 truncate; SSE4.1).
koukai waza rounds(a: Assembler, double: bool, dst: int64, src: int64, mode: int64) -> unit {
    kaku op = 10;
    moshi (double) { op = 11; }
    sse_rr(a, 102, iie, 2, op, dst, src);
    byte(a, mode);
}

koukai waza push_r(a: Assembler, r: int64) -> unit {
    moshi (!valid_register(a, r)) { kaesu; }
    moshi (r >= 8) { byte(a, 65); } byte(a, 80 + low3(r));
}
koukai waza pop_r(a: Assembler, r: int64) -> unit {
    moshi (!valid_register(a, r)) { kaesu; }
    moshi (r >= 8) { byte(a, 65); } byte(a, 88 + low3(r));
}
// SETcc into the low byte of rax, zero-extended (the runtime IR's boolean).
koukai waza setcc_rax(a: Assembler, cc: int64) -> unit {
    moshi (cc < 0 || cc > 15) { fail(a, "INVALID_CONDITION"); kaesu; }
    byte(a, 15); byte(a, 144 + cc); byte(a, 192);
    byte(a, 15); byte(a, 182); byte(a, 192);
}
koukai waza ret(a: Assembler) -> unit { byte(a, 195); }
// mov eax, imm32 (zero-extends into rax).
koukai waza mov_eax_imm(a: Assembler, value: int64) -> unit {
    moshi (value < 0 || value > 2147483647) { fail(a, "INVALID_IMMEDIATE"); kaesu; }
    byte(a, 184); imm32(a, value);
}
// mov eax,eax: zero-extends a 32-bit native result into rax.
koukai waza zero_extend_eax(a: Assembler) -> unit { byte(a, 137); byte(a, 192); }
// The SYSCALL instruction itself (0F 05).
koukai waza syscall_raw(a: Assembler) -> unit { byte(a, 15); byte(a, 5); }
// Darwin (macOS x86-64) mode, chosen by defining the label "darwin_abi" before any code is emitted: a Linux-convention
// system call (number in eax, arguments in rdi rsi rdx r10 r8 r9, result or -errno in rax) becomes `call darwin_syscall`,
// a runtime routine that performs the equivalent Darwin BSD call. Without the label this is the plain SYSCALL instruction,
// so Linux images stay byte-identical.
koukai waza syscall(a: Assembler) -> unit {
    moshi (find_label(a, "darwin_abi") >= 0) { call(a, "darwin_syscall"); kaesu; }
    syscall_raw(a);
}
koukai waza mfence(a: Assembler) -> unit { byte(a, 15); byte(a, 174); byte(a, 240); }
// xchg [base], reg (implicitly locked): sequentially consistent store.
koukai waza xchg_store(a: Assembler, base: int64, reg: int64) -> unit {
    moshi (!valid_register(a, reg) || !valid_register(a, base)) { kaesu; }
    rex(a, reg, base); byte(a, 135); memory(a, reg, base, 0);
}
// SETcc into cl, zero-extended into rcx.
koukai waza setcc_rcx(a: Assembler, cc: int64) -> unit {
    moshi (cc < 0 || cc > 15) { fail(a, "INVALID_CONDITION"); kaesu; }
    byte(a, 15); byte(a, 144 + cc); byte(a, 193);
    byte(a, 15); byte(a, 182); byte(a, 201);
}
// lock xadd [base], reg : reg receives the previous value.
koukai waza lock_xadd(a: Assembler, base: int64, reg: int64) -> unit {
    moshi (!valid_register(a, reg) || !valid_register(a, base)) { kaesu; }
    byte(a, 240); rex(a, reg, base); byte(a, 15); byte(a, 193); memory(a, reg, base, 0);
}
// lock cmpxchg [base], desired : compares with rax, ZF=1 on success, rax=observed.
koukai waza lock_cmpxchg(a: Assembler, base: int64, desired: int64) -> unit {
    moshi (!valid_register(a, desired) || !valid_register(a, base)) { kaesu; }
    byte(a, 240); rex(a, desired, base); byte(a, 15); byte(a, 177); memory(a, desired, base, 0);
}
koukai waza call_r(a: Assembler, r: int64) -> unit {
    moshi (!valid_register(a, r)) { kaesu; }
    moshi (r >= 8) { byte(a, 65); } byte(a, 255); modrm(a, 3, 2, r);
}
koukai waza call_memory(a: Assembler, base: int64, disp: int64) -> unit {
    moshi (!valid_register(a, base)) { kaesu; }
    moshi (base >= 8) { byte(a, 65); } byte(a, 255); memory(a, 2, base, disp);
}

waza label_hash(name: string) -> int64 {
    kaku data = string.to_bytes(name);
    kaku value = 5381;
    kaku at = 0;
    aida (at < len(data)) {
        kaku next = value * 33 + int64(data[at]);
        value = next - (next / 1073741789) * 1073741789;
        at = at + 1;
    }
    kaesu value;
}

waza find_label(a: Assembler, name: string) -> int64 {
    kaku table = a.table[0];
    kaku capacity = len(table);
    kaku hash = label_hash(name);
    kaku slot = hash - (hash / capacity) * capacity;
    aida (table[slot] != 0) {
        kaku entry = a.labels[table[slot] - 1];
        moshi (entry.name == name) { kaesu entry.offset; }
        slot = slot + 1;
        moshi (slot == capacity) { slot = 0; }
    }
    kaesu -1;
}

waza insert_label(table: []int64, labels: []Label, index: int64) -> unit {
    kaku capacity = len(table);
    kaku hash = label_hash(labels[index].name);
    kaku slot = hash - (hash / capacity) * capacity;
    aida (table[slot] != 0) { slot = slot + 1; moshi (slot == capacity) { slot = 0; } }
    table[slot] = index + 1;
}

koukai waza label(a: Assembler, name: string) -> unit {
    moshi (find_label(a, name) >= 0) { fail(a, "DUPLICATE_LABEL"); kaesu; }
    array.push(a.labels, Label { name: name, offset: len(a.bytes) });
    kaku count = len(a.labels);
    moshi (count * 2 > len(a.table[0])) {
        kaku bigger = array.make[int64](len(a.table[0]) * 4, 0);
        kaku index = 0;
        aida (index < count) { insert_label(bigger, a.labels, index); index = index + 1; }
        a.table[0] = bigger;
    }
    sore { insert_label(a.table[0], a.labels, count - 1); }
}
koukai waza label_offset(a: Assembler, name: string) -> int64 { kaesu find_label(a, name); }
waza branch(a: Assembler, target: string) -> unit {
    array.push(a.fixups, Fixup { at: len(a.bytes), target: target });
    imm32(a, 0);
}
koukai waza jmp(a: Assembler, target: string) -> unit { byte(a, 233); branch(a, target); }
koukai waza call(a: Assembler, target: string) -> unit { byte(a, 232); branch(a, target); }
koukai waza jcc(a: Assembler, cc: int64, target: string) -> unit {
    moshi (cc < 0 || cc > 15) { fail(a, "INVALID_CONDITION"); kaesu; }
    byte(a, 15); byte(a, 128 + cc); branch(a, target);
}
// lea dst, [rip + label]
koukai waza lea_label(a: Assembler, dst: int64, target: string) -> unit {
    moshi (!valid_register(a, dst)) { kaesu; }
    rex(a, dst, 0); byte(a, 141); modrm(a, 0, dst, 5); branch(a, target);
}

koukai waza assemble(a: Assembler) -> AssembleResult {
    moshi (len(a.errors) > 0) { kaesu AssembleResult { bytes: [], error: a.errors[0] }; }
    kaku output = array.clone(a.bytes);
    kaku i = 0;
    aida (i < len(a.fixups)) {
        kaku f = a.fixups[i];
        kaku target = find_label(a, f.target);
        moshi (target < 0) { kaesu AssembleResult { bytes: [], error: "UNDEFINED_LABEL" }; }
        kaku delta = target - (f.at + 4);
        moshi (delta < -2147483648 || delta > 2147483647) { kaesu AssembleResult { bytes: [], error: "BRANCH_OUT_OF_RANGE" }; }
        kaku x = delta; moshi (x < 0) { x = x + 4294967296; }
        kaku k = 0;
        aida (k < 4) { output[f.at + k] = uint8(x - (x / 256) * 256); x = x / 256; k = k + 1; }
        i = i + 1;
    }
    kaesu AssembleResult { bytes: output, error: "" };
}
