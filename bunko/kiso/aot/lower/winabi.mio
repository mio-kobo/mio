    wx(c, arm64.ldr_w(9, 31, 168)); wx_cbz(c, 9, "wx_poll_idle"); wx_b(c, "wx_poll_ready");
    wx_label(c, "wx_poll_pipe_failed"); wx_b(c, "wx_poll_ready");
