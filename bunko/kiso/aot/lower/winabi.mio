    wx_call(c, patches, "GetFinalPathNameByHandleW"); wx_bool(c); wx_cbz(c, 0, "wx_fcntl_failed");
    wx(c, arm64.add_imm_x(2, 31, 0, iie)); wx(c, arm64.ldrh_w(9, 31, 0)); wx_cmpi(c, 9, 92); wx_bcc(c, 1, "wx_fcntl_convert");
    wx(c, arm64.ldrh_w(9, 31, 2)); wx_cmpi(c, 9, 92); wx_bcc(c, 1, "wx_fcntl_convert");
    wx(c, arm64.ldrh_w(9, 31, 4)); wx_cmpi(c, 9, 63); wx_bcc(c, 1, "wx_fcntl_convert");
    wx(c, arm64.ldrh_w(9, 31, 6)); wx_cmpi(c, 9, 92); wx_bcc(c, 1, "wx_fcntl_convert");
    wx(c, arm64.add_imm_x(2, 31, 8, iie));
    wx_label(c, "wx_fcntl_convert");
    wx_li(c, 0, 65001); wx_li(c, 1, 0); wx(c, arm64.movn_x(3, 0, 0)); wx_ldr(c, 4, 2048); wx_li(c, 5, 1023); wx_li(c, 6, 0); wx_li(c, 7, 0);
    wx_call(c, patches, "WideCharToMultiByte"); wx_bool(c); wx_cbz(c, 0, "wx_fcntl_failed");
    wx_slashes(c, 2048, "wx_fcntl_slashes");
    wx_free(c, 2304); wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_fcntl_failed"); wx_fail_last(c, patches, 2304);
    wx_label(c, "wx_fcntl_badfd"); wx_free(c, 2304); wx_b(c, "wx_badfd");
    wx_label(c, "wx_fcntl_other"); wx_li(c, 0, 0); wx_b(c, "wx_ok");

    // ---- proc_info(PIDINFO = 2, pid, PIDPATHINFO = 11, 0, buffer, size) -> GetModuleFileNameW(NULL) as UTF-8
    wx_label(c, "wx_procinfo");
    wx_cmpi(c, 0, 2); wx_bcc(c, 1, "wx_unsupported"); wx_cmpi(c, 2, 11); wx_bcc(c, 1, "wx_unsupported");
    wx_alloc(c, 2304); wx_str(c, 4, 2048); wx_str(c, 5, 2056);
    wx_li(c, 0, 0); wx(c, arm64.add_imm_x(1, 31, 0, iie)); wx_li(c, 2, 1024); wx_call(c, patches, "GetModuleFileNameW"); wx_bool(c); wx_cbz(c, 0, "wx_procinfo_failed");
    wx_li(c, 0, 65001); wx_li(c, 1, 0); wx(c, arm64.add_imm_x(2, 31, 0, iie)); wx(c, arm64.movn_x(3, 0, 0)); wx_ldr(c, 4, 2048); wx_ldr(c, 5, 2056); wx_li(c, 6, 0); wx_li(c, 7, 0);
    wx_call(c, patches, "WideCharToMultiByte"); wx_bool(c); wx_cbz(c, 0, "wx_procinfo_failed");
    wx_slashes(c, 2048, "wx_procinfo_slashes");
    wx_free(c, 2304); wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_procinfo_failed"); wx_fail_last(c, patches, 2304);

    // ---- system queries: physical memory is unavailable, the memory-pressure level is optional, no resource limits
    wx_label(c, "wx_sysctl"); wx_li(c, 0, 2); wx_b(c, "wx_error");
    wx_label(c, "wx_sysctlbyname"); wx_li(c, 0, 2); wx_b(c, "wx_error");
    wx_label(c, "wx_getrlimit");
    wx(c, arm64.movn_x(9, 0, 0)); wx(c, arm64.lsr_x(9, 9, 1)); wx(c, arm64.str_x(9, 1, 0)); wx(c, arm64.str_x(9, 1, 8)); wx_li(c, 0, 0); wx_b(c, "wx_ok");

    // ================= process emulation =================
    // Windows has no fork. The Darwin runtime's spawn is fork; (redirect fds, set limits); execve in the child; wait4 in the
    // parent. fork saves the caller's context and returns as the "child" in this same process; the child path only touches the
    // descriptor table (dup2/close/open), the limits (setitimer/setrlimit, recorded) and then calls execve, which performs the
    // real CreateProcessW, waits (killing the process with status 142 after the timeout), restores the descriptor table and
    // resumes the parent at the saved context with the child's status for wait4. exit() in the child resumes the parent too.
    wx_label(c, "wx_fork");
    wx(c, arm64.add_imm_x(9, 31, 288, iie)); wx_put(c, patches, base, 9, 132);
    wx(c, arm64.ldr_x(9, 31, 120)); wx_put(c, patches, base, 9, 133);
    wx(c, arm64.ldr_x(9, 31, 288)); wx_put(c, patches, base, 9, 134);
    wx_data(c, patches, base, 11, 136);
    kaku reg = 0;
    aida (reg < 14) { wx(c, arm64.ldr_x(9, 31, reg * 8)); wx(c, arm64.str_x(9, 11, reg * 8)); reg = reg + 1; }
    wx(c, arm64.ldr_x(9, 31, 112)); wx(c, arm64.str_x(9, 11, 112));
    // the callee-saved registers and the frame pointer: the emulated child path enters routines that never unwind
    wx(c, arm64.stp_x(19, 20, 11, 120)); wx(c, arm64.stp_x(21, 22, 11, 136)); wx(c, arm64.stp_x(23, 24, 11, 152));
    wx(c, arm64.stp_x(25, 26, 11, 168)); wx(c, arm64.stp_x(27, 28, 11, 184)); wx(c, arm64.str_x(29, 11, 200));
    wx_data(c, patches, base, 11, 0); wx_data(c, patches, base, 12, 192); wx_li(c, 13, 0);
    wx_label(c, "wx_fork_snapshot");
    wx(c, arm64.lsl_x(14, 13, 3)); wx(c, arm64.add_x(15, 11, 14)); wx(c, arm64.ldr_x(9, 15, 0)); wx(c, arm64.add_x(15, 12, 14)); wx(c, arm64.str_x(9, 15, 0));
    wx(c, arm64.add_imm_x(13, 13, 1, iie)); wx_cmpi(c, 13, 64); wx_bcc(c, 3, "wx_fork_snapshot");
    wx_li(c, 9, 1); wx_put(c, patches, base, 9, 128); wx_li(c, 9, 0); wx_put(c, patches, base, 9, 129);
    wx_li(c, 9, 1); wx(c, arm64.str_x(9, 31, 128));
    wx_li(c, 0, 4243); wx_b(c, "wx_ok");

    // resume the parent after fork: x0 = child pid (x1 = 0, carry clear, x2-x15 and x17 restored, caller's lr slot rebuilt)
    wx_label(c, "wx_resume");
    wx_data(c, patches, base, 16, 132); wx(c, arm64.ldr_x(9, 16, 0)); wx(c, arm64.add_imm_x(31, 9, 0, iie));
    wx_data(c, patches, base, 16, 134); wx(c, arm64.ldr_x(9, 16, 0)); wx(c, arm64.str_x(9, 31, 0)); wx(c, arm64.str_x(31, 31, 8));
    wx_data(c, patches, base, 16, 136);
    wx(c, arm64.ldp_x(2, 3, 16, 0)); wx(c, arm64.ldp_x(4, 5, 16, 16)); wx(c, arm64.ldp_x(6, 7, 16, 32)); wx(c, arm64.ldp_x(8, 9, 16, 48));
    wx(c, arm64.ldp_x(10, 11, 16, 64)); wx(c, arm64.ldp_x(12, 13, 16, 80)); wx(c, arm64.ldp_x(14, 15, 16, 96)); wx(c, arm64.ldr_x(17, 16, 112));
    wx(c, arm64.ldp_x(19, 20, 16, 120)); wx(c, arm64.ldp_x(21, 22, 16, 136)); wx(c, arm64.ldp_x(23, 24, 16, 152));
    wx(c, arm64.ldp_x(25, 26, 16, 168)); wx(c, arm64.ldp_x(27, 28, 16, 184)); wx(c, arm64.ldr_x(29, 16, 200));
    wx_data(c, patches, base, 16, 133); wx(c, arm64.ldr_x(30, 16, 0));
    wx_li(c, 1, 0); wx(c, arm64.cmn_imm_x(0, 0, iie)); wx(c, arm64.ret());

    // the emulated child finished with exit code x0: record it, restore the descriptor table, resume the parent
    wx_label(c, "wx_child_done");
    wx_put(c, patches, base, 0, 130); wx_li(c, 9, 4243); wx_put(c, patches, base, 9, 131); wx(c, arm64.str_x(31, 31, 152));
    wx_label(c, "wx_child_restore");
