yobu "kiso/aot/arm64";
yobu "kiso/aot/macho";
yobu "kiso/array";
yobu "kiso/convert";
yobu "kiso/string";

// Windows ARM64 operating-system adapter for the Darwin/AArch64 lowering.
//
// The Darwin backend reaches the kernel only through `SVC #128` (BSD number in x16; carry set and a positive errno in x0 on
// failure). With the label `windows_abi` defined (see arm64.assembler_emit) every such SVC becomes a call of
// `windows_syscall`, emitted here: it performs the equivalent Win32 call through the import address table (IAT) and
// returns the Darwin convention. Win32 has no stable system-call interface, so every operation goes through kernel32 /
// ws2_32 imports; the loader fills the IAT. Calls without a translation fail explicitly with ENOSYS (Darwin value 78).
// All registers except x0, x1, x16 and the flags are preserved (Win32 clobbers x0-x17; the adapter saves and restores).
//
// IAT slots are addressed with ADRP/ADD AddressPatch records of target kind 3 (target_offset = flattened import index * 8);
// the image builder (kiso/aot/winarm64) resolves them. Frame (288 bytes): 0..127 saved x2-x15, x17, x30; 128 original x1;
// 144..271 scratch.

// The imports in IAT order: pairs of (library, symbol). The image builder groups them by library in this order.
koukai waza windows_imports() -> []string {
    kaku names = ["ExitProcess", "GetStdHandle", "WriteFile", "ReadFile", "CloseHandle", "VirtualAlloc", "VirtualFree", "CreateFileW",
        "GetLastError", "MultiByteToWideChar", "WideCharToMultiByte", "GetFileAttributesExW", "CreateDirectoryW", "RemoveDirectoryW",
        "DeleteFileW", "GetFileInformationByHandleEx", "GetCurrentProcessId", "GetFinalPathNameByHandleW", "GetModuleFileNameW",
        "SetConsoleOutputCP", "SetConsoleCP", "GetCommandLineW", "GetEnvironmentStringsW", "CreateProcessW", "WaitForSingleObject",
        "GetExitCodeProcess", "TerminateProcess", "SetHandleInformation", "GetStartupInfoW", "GetFileType", "PeekNamedPipe", "Sleep"];
    kaku pairs: []string = []; kaku at = 0;
    aida (at < len(names)) { array.push(pairs, "kernel32.dll"); array.push(pairs, names[at]); at = at + 1; }
    kaku sockets = ["WSAStartup", "WSASocketW", "bind", "connect", "listen", "accept", "setsockopt", "closesocket", "WSAGetLastError", "ioctlsocket", "getsockopt", "recv", "send"];
    at = 0;
    aida (at < len(sockets)) { array.push(pairs, "ws2_32.dll"); array.push(pairs, sockets[at]); at = at + 1; }
    array.push(pairs, "shell32.dll"); array.push(pairs, "CommandLineToArgvW");
    kaesu pairs;
}

// Adapter data (64-bit words appended after the program's globals): the descriptor table has 64 entries (HANDLE or 0 = free)
// at word 0 (entries 0..2 are the standard handles); per-descriptor "directory enumeration started" flags at word 64.
// Process emulation state (see the fork/execve blocks): word 128 mode (1 while the emulated child runs), 129 timeout seconds,
// 130 last child exit code, 131 child pid, 132 saved sp, 133 saved return address, 134 saved caller lr, 136..149 saved x2-x15,
// 150 saved x17, 151..160 saved x19-x28, 161 saved x29, 162 Winsock started, 192..255 snapshot of the descriptor table taken at fork.
// Sockets live in a second table of 4032 SOCKET entries at word 256 (descriptors 64..4095, 0 = free): the 64-entry table above is for
// files, pipes and the standard handles, so a program can hold thousands of sockets while process emulation keeps its layout.
koukai waza windows_adapter_words() -> int64 { kaesu 256 + 4032; }

waza wx(c: arm64.Assembler, i: arm64.Instruction) -> unit { arm64.assembler_emit(c, i); }
waza wx_label(c: arm64.Assembler, name: string) -> unit { arm64.assembler_label(c, name); }
waza wx_b(c: arm64.Assembler, name: string) -> unit { arm64.assembler_b(c, name); }
waza wx_bcc(c: arm64.Assembler, condition: int64, name: string) -> unit { arm64.assembler_b_cond(c, condition, name); }
waza wx_cbz(c: arm64.Assembler, reg: int64, name: string) -> unit { arm64.assembler_cbz_x(c, reg, name); }
waza wx_mov(c: arm64.Assembler, rd: int64, rn: int64) -> unit { wx(c, arm64.add_imm_x(rd, rn, 0, iie)); }
waza wx_li(c: arm64.Assembler, reg: int64, value: int64) -> unit {
    moshi (value < 0) { wx(c, arm64.movn_x(reg, -value - 1, 0)); kaesu; }
    moshi (value < 65536) { wx(c, arm64.movz_x(reg, value, 0)); kaesu; }
    kaku low = value - (value / 65536) * 65536;
    wx(c, arm64.movz_x(reg, low, 0)); wx(c, arm64.movk_x(reg, (value / 65536) - ((value / 65536) / 65536) * 65536, 1));
    moshi (value >= 4294967296) { wx(c, arm64.movk_x(reg, value / 4294967296, 2)); }
}
waza wx_name(prefix: string, index: int64) -> string { kaesu string.concat(prefix, convert.format_int(index)); }

waza import_index(symbol: string) -> int64 {
    kaku names = windows_imports(); kaku at = 1;
    aida (at < len(names)) { moshi (names[at] == symbol) { kaesu at / 2; } at = at + 2; }
    kaesu -1;
}

// Call the imported function `symbol`: x16 = address of its IAT slot (patched ADRP/ADD), x16 = [x16], blr x16.
waza wx_call(c: arm64.Assembler, patches: []macho.AddressPatch, symbol: string) -> unit {
    kaku index = import_index(symbol);
    kaku at = len(c.words);
    wx(c, arm64.Instruction { word: uint32(0), error: mu }); wx(c, arm64.Instruction { word: uint32(0), error: mu });
    array.push(patches, macho.AddressPatch { at_word: at, add_at_word: at + 1, target: macho.AddressTarget { kind: 3 }, target_offset: index * 8, register: 16 });
    wx(c, arm64.ldr_x(16, 16, 0)); wx(c, arm64.blr_x(16));
}

// x(reg) = address of adapter data word `word` (ADRP/ADD with a globals patch; the image builder resolves it).
waza wx_data(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64, reg: int64, word: int64) -> unit {
    kaku at = len(c.words);
    wx(c, arm64.Instruction { word: uint32(0), error: mu }); wx(c, arm64.Instruction { word: uint32(0), error: mu });
    array.push(patches, macho.AddressPatch { at_word: at, add_at_word: at + 1, target: macho.data_target(), target_offset: (base + word) * 8, register: reg });
}

// [adapter word] <-> register (clobbers x10)
waza wx_get(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64, dst: int64, word: int64) -> unit { wx_data(c, patches, base, 10, word); wx(c, arm64.ldr_x(dst, 10, 0)); }
waza wx_put(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64, src: int64, word: int64) -> unit { wx_data(c, patches, base, 10, word); wx(c, arm64.str_x(src, 10, 0)); }

// BOOL results are 32-bit: clear the undefined upper half.
waza wx_bool(c: arm64.Assembler) -> unit { wx(c, arm64.lsl_x(0, 0, 32)); wx(c, arm64.lsr_x(0, 0, 32)); }

waza wx_save(c: arm64.Assembler, a: int64, b: int64, offset: int64) -> unit { wx(c, arm64.stp_x(a, b, 31, offset)); }
waza wx_load(c: arm64.Assembler, a: int64, b: int64, offset: int64) -> unit { wx(c, arm64.ldp_x(a, b, 31, offset)); }


// ---- small assembly helpers used by the blocks below
waza wx_cmpi(c: arm64.Assembler, reg: int64, value: int64) -> unit { wx(c, arm64.cmp_imm_x(reg, value, iie)); }
waza wx_ldr(c: arm64.Assembler, rt: int64, off: int64) -> unit { wx(c, arm64.ldr_x(rt, 31, off)); }
waza wx_str(c: arm64.Assembler, rt: int64, off: int64) -> unit { wx(c, arm64.str_x(rt, 31, off)); }
waza wx_cbnz(c: arm64.Assembler, reg: int64, name: string) -> unit { arm64.assembler_cbnz_x(c, reg, name); }
waza wx_bl(c: arm64.Assembler, name: string) -> unit { arm64.assembler_bl(c, name); }

// Frame allocation in two probed halves (each below a page) so the guard-page mechanism can commit the stack in order.
waza wx_alloc(c: arm64.Assembler, size: int64) -> unit {
    // each half must be a multiple of 16: SP is checked for alignment on every access through it
    moshi ((size / 2) - ((size / 2) / 16) * 16 != 0 || size - (size / 2) * 2 != 0) { array.push(c.errors, arm64.EncodeError.MisalignedOffset()); }
    wx(c, arm64.sub_imm_x(31, 31, size / 2, iie)); wx(c, arm64.str_x(31, 31, 0));
    wx(c, arm64.sub_imm_x(31, 31, size / 2, iie)); wx(c, arm64.str_x(31, 31, 0));
}
waza wx_free(c: arm64.Assembler, size: int64) -> unit {
    wx(c, arm64.add_imm_x(31, 31, size / 2, iie)); wx(c, arm64.add_imm_x(31, 31, size / 2, iie));
}

// Win32 error code (x0) -> Darwin errno (x0). Leaf routine, clobbers x9-x10.
waza wx_map_error(c: arm64.Assembler) -> unit {
    wx_label(c, "wx_map_error");
    kaku pairs = [2, 2, 3, 2, 5, 13, 6, 9, 32, 13, 80, 17, 183, 17, 267, 20, 145, 66, 87, 22, 123, 63, 161, 63, 206, 63,
        10013, 13, 10022, 22, 10035, 35, 10036, 36, 10038, 38, 10040, 40, 10047, 47, 10048, 48, 10049, 49, 10051, 51, 10053, 53, 10054, 54, 10056, 56,
        10057, 57, 10060, 60, 10061, 61, 10065, 65, 64, 54];
    kaku at = 0;
    aida (at < len(pairs)) {
        kaku next = wx_name("wx_map_error_next_", at);
        wx_li(c, 9, pairs[at]); wx(c, arm64.cmp_x(0, 9)); wx_bcc(c, 1, next); wx_li(c, 0, pairs[at + 1]); wx(c, arm64.ret());
        wx_label(c, next);
        at = at + 2;
    }
    wx_li(c, 0, 5); wx(c, arm64.ret());
}

// Calls GetLastError, maps it and jumps to the common error exit; `cleanup` bytes of stack are released first.
waza wx_fail_last(c: arm64.Assembler, patches: []macho.AddressPatch, cleanup: int64) -> unit {
    wx_call(c, patches, "GetLastError"); wx_bool(c); wx_bl(c, "wx_map_error");
    moshi (cleanup > 0) { wx_free(c, cleanup); }
    wx_b(c, "wx_error");
}

// x0 = descriptor -> x0 = HANDLE, or 0 when the descriptor is not open. Clobbers x9, x10.
waza wx_handle_routine(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64) -> unit {
    wx_label(c, "wx_handle");
    wx_cmpi(c, 0, 64); wx_bcc(c, 2, "wx_handle_socket");
    wx_data(c, patches, base, 10, 0);
    wx(c, arm64.ldr_x_register_scaled(0, 10, 0)); wx(c, arm64.ret());
    wx_label(c, "wx_handle_socket");
    wx(c, arm64.sub_imm_x(0, 0, 64, iie)); wx_cmpi(c, 0, 4032); wx_bcc(c, 2, "wx_handle_none");
    wx_data(c, patches, base, 10, 256);
    wx(c, arm64.ldr_x_register_scaled(0, 10, 0)); wx(c, arm64.ret());
    wx_label(c, "wx_handle_none"); wx_li(c, 0, 0); wx(c, arm64.ret());
}

// UTF-8 C string at [sp, #source] -> UTF-16 at [sp] (1024 code units): x0 = number of units including the NUL, 0 on failure.
waza wx_to_utf16(c: arm64.Assembler, patches: []macho.AddressPatch, source: int64) -> unit {
    wx_li(c, 0, 65001); wx_li(c, 1, 0); wx_ldr(c, 2, source); wx(c, arm64.movn_x(3, 0, 0)); wx(c, arm64.add_imm_x(4, 31, 0, iie)); wx_li(c, 5, 1024);
    wx_call(c, patches, "MultiByteToWideChar"); wx_bool(c);
}

// bytes at [reg] equal `text` (and its NUL): fall through when equal, jump to `fail` otherwise. Uses x9.
waza wx_streq(c: arm64.Assembler, reg: int64, text: string, fail: string) -> unit {
    kaku bytes = string.to_bytes(text); kaku at = 0;
    aida (at <= len(bytes)) {
        kaku expected = 0; moshi (at < len(bytes)) { expected = int64(bytes[at]); }
        wx(c, arm64.ldrb_w(9, reg, at)); wx_cmpi(c, 9, expected); wx_bcc(c, 1, fail);
        at = at + 1;
    }
}

// The Mio front end expects drive-absolute paths with '/' separators from os.canonical_path (as the Windows amd64 backend
// provides): rewrite every backslash of the NUL-terminated UTF-8 string whose pointer is saved at [sp, #slot].
waza wx_slashes(c: arm64.Assembler, slot: int64, prefix: string) -> unit {
    wx_ldr(c, 9, slot);
    wx_label(c, string.concat(prefix, "_loop"));
    wx(c, arm64.ldrb_w(10, 9, 0)); wx_cbz(c, 10, string.concat(prefix, "_done"));
    wx_cmpi(c, 10, 92); wx_bcc(c, 1, string.concat(prefix, "_next"));
    wx_li(c, 11, 47); wx(c, arm64.strb_w(11, 9, 0));
    wx_label(c, string.concat(prefix, "_next")); wx(c, arm64.add_imm_x(9, 9, 1, iie)); wx_b(c, string.concat(prefix, "_loop"));
    wx_label(c, string.concat(prefix, "_done"));
}

// Defines `windows_syscall`; `base` is the first adapter data word (see windows_adapter_words).
koukai waza emit_windows_abi_runtime(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64) -> unit {
    wx_label(c, "windows_syscall");
    wx(c, arm64.sub_imm_x(31, 31, 288, iie));
    wx_save(c, 2, 3, 0); wx_save(c, 4, 5, 16); wx_save(c, 6, 7, 32); wx_save(c, 8, 9, 48);
    wx_save(c, 10, 11, 64); wx_save(c, 12, 13, 80); wx_save(c, 14, 15, 96); wx_save(c, 17, 30, 112);
    wx(c, arm64.str_x(1, 31, 128));
    kaku calls = [1, 2, 3, 4, 5, 6, 7, 10, 15, 20, 30, 54, 59, 73, 74, 83, 90, 92, 97, 98, 104, 105, 106, 118, 136, 137, 194, 195, 197, 202, 230, 274, 336, 338, 344];
    kaku names = ["wx_exit", "wx_fork", "wx_read", "wx_write", "wx_open", "wx_close", "wx_wait4", "wx_unlink", "wx_chmod", "wx_getpid", "wx_accept", "wx_ioctl", "wx_execve", "wx_munmap",
        "wx_mprotect", "wx_setitimer", "wx_dup2", "wx_fcntl", "wx_socket", "wx_connect", "wx_bind", "wx_setsockopt", "wx_listen", "wx_getsockopt", "wx_mkdir", "wx_rmdir", "wx_getrlimit",
        "wx_setrlimit", "wx_mmap", "wx_sysctl", "wx_poll", "wx_sysctlbyname", "wx_procinfo", "wx_stat", "wx_dirents"];
    kaku at = 0;
    aida (at < len(calls)) {
        kaku next = wx_name("wx_dispatch_next_", at);
        wx(c, arm64.cmp_imm_x(16, calls[at], iie)); wx_bcc(c, 1, next); wx_b(c, names[at]);
        wx_label(c, next);
        at = at + 1;
    }
    // unsupported: ENOSYS (Darwin 78), carry set
    wx_label(c, "wx_unsupported"); wx_li(c, 0, 78);
    wx_label(c, "wx_error"); wx(c, arm64.cmp_x(31, 31)); wx_b(c, "wx_done");
    wx_label(c, "wx_ok"); wx(c, arm64.cmn_imm_x(0, 0, iie));
    wx_label(c, "wx_done");
    wx(c, arm64.ldr_x(1, 31, 128));
    wx_load(c, 2, 3, 0); wx_load(c, 4, 5, 16); wx_load(c, 6, 7, 32); wx_load(c, 8, 9, 48);
    wx_load(c, 10, 11, 64); wx_load(c, 12, 13, 80); wx_load(c, 14, 15, 96); wx_load(c, 17, 30, 112);
    wx(c, arm64.add_imm_x(31, 31, 288, iie)); wx(c, arm64.ret());
    wx_map_error(c);
    wx_handle_routine(c, patches, base);

    // ---- exit(status) -> ExitProcess(status)
    wx_label(c, "wx_exit");
    wx_get(c, patches, base, 9, 128); wx_cbz(c, 9, "wx_exit_process"); wx_b(c, "wx_child_done");
    wx_label(c, "wx_exit_process"); wx_call(c, patches, "ExitProcess"); wx_b(c, "wx_unsupported");
    wx_label(c, "wx_badfd"); wx_li(c, 0, 9); wx_b(c, "wx_error");
    wx_label(c, "wx_inval"); wx_li(c, 0, 22); wx_b(c, "wx_error");

    // ---- read(fd, buffer, length) -> ReadFile; a broken pipe or end of file reads as 0 bytes
    wx_label(c, "wx_read");
    wx(c, arm64.str_x(1, 31, 144)); wx(c, arm64.str_x(2, 31, 152)); wx(c, arm64.str_x(0, 31, 168));
    wx_bl(c, "wx_handle"); wx_cbz(c, 0, "wx_badfd");
    // POSIX: a zero-length read returns 0 at once; ReadFile(0 bytes) on a socket or pipe would wait for data
    wx(c, arm64.ldr_x(2, 31, 152)); wx_cbnz(c, 2, "wx_read_nonzero"); wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_read_nonzero");
    // a socket (descriptor >= 64) reads with recv: ReadFile on a Winsock socket ignores nonblocking mode
    wx(c, arm64.ldr_x(9, 31, 168)); wx_cmpi(c, 9, 64); wx_bcc(c, 3, "wx_read_file");
    wx(c, arm64.ldr_x(1, 31, 144)); wx(c, arm64.ldr_x(2, 31, 152)); wx_li(c, 3, 0);
    wx_call(c, patches, "recv"); wx_bool(c); wx_li(c, 9, 4294967295); wx(c, arm64.cmp_x(0, 9)); wx_bcc(c, 0, "wx_net_failed"); wx_b(c, "wx_ok");
    wx_label(c, "wx_read_file");
    wx(c, arm64.ldr_x(1, 31, 144)); wx(c, arm64.ldr_x(2, 31, 152)); wx(c, arm64.add_imm_x(3, 31, 160, iie)); wx_li(c, 4, 0);
    wx_call(c, patches, "ReadFile"); wx_bool(c); wx_cbz(c, 0, "wx_read_failed");
    wx(c, arm64.ldr_w(0, 31, 160)); wx_b(c, "wx_ok");
    wx_label(c, "wx_read_failed");
    wx_call(c, patches, "GetLastError"); wx_bool(c);
    wx_cmpi(c, 0, 109); wx_bcc(c, 0, "wx_eof"); wx_cmpi(c, 0, 38); wx_bcc(c, 0, "wx_eof");
    wx_bl(c, "wx_map_error"); wx_b(c, "wx_error");
    wx_label(c, "wx_eof"); wx_li(c, 0, 0); wx_b(c, "wx_ok");

    // ---- write(fd, buffer, length) -> WriteFile
    wx_label(c, "wx_write");
    wx(c, arm64.str_x(1, 31, 144)); wx(c, arm64.str_x(2, 31, 152)); wx(c, arm64.str_x(0, 31, 168));
    wx_bl(c, "wx_handle"); wx_cbz(c, 0, "wx_badfd");
    wx(c, arm64.ldr_x(2, 31, 152)); wx_cbnz(c, 2, "wx_write_nonzero"); wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_write_nonzero");
    wx(c, arm64.ldr_x(9, 31, 168)); wx_cmpi(c, 9, 64); wx_bcc(c, 3, "wx_write_file");
    wx(c, arm64.ldr_x(1, 31, 144)); wx(c, arm64.ldr_x(2, 31, 152)); wx_li(c, 3, 0);
    wx_call(c, patches, "send"); wx_bool(c); wx_li(c, 9, 4294967295); wx(c, arm64.cmp_x(0, 9)); wx_bcc(c, 0, "wx_net_failed"); wx_b(c, "wx_ok");
    wx_label(c, "wx_write_file");
    wx(c, arm64.ldr_x(1, 31, 144)); wx(c, arm64.ldr_x(2, 31, 152)); wx(c, arm64.add_imm_x(3, 31, 160, iie)); wx_li(c, 4, 0);
    wx_call(c, patches, "WriteFile"); wx_bool(c); wx_cbz(c, 0, "wx_io_error");
    wx(c, arm64.ldr_w(0, 31, 160)); wx_b(c, "wx_ok");
    wx_label(c, "wx_io_error"); wx_fail_last(c, patches, 0);

    // ---- close(fd): the standard descriptors stay open; others are removed from the table and closed
    wx_label(c, "wx_close");
    wx_cmpi(c, 0, 2); wx_bcc(c, 8, "wx_close_real"); wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_close_real");
    wx_cmpi(c, 0, 64); wx_bcc(c, 2, "wx_close_socket_entry");
    wx(c, arm64.str_x(0, 31, 144)); wx_bl(c, "wx_handle"); wx_cbz(c, 0, "wx_badfd");
    wx(c, arm64.str_x(0, 31, 152));
    wx_data(c, patches, base, 10, 0); wx(c, arm64.ldr_x(11, 31, 144)); wx(c, arm64.lsl_x(11, 11, 3)); wx(c, arm64.add_x(10, 10, 11)); wx(c, arm64.str_x(31, 10, 0));
    wx_data(c, patches, base, 10, 0); wx_li(c, 11, 0); wx(c, arm64.ldr_x(12, 31, 152));
    wx_label(c, "wx_close_scan");
    wx_cmpi(c, 11, 64); wx_bcc(c, 2, "wx_close_last");
    wx(c, arm64.ldr_x_register_scaled(13, 10, 11)); wx(c, arm64.cmp_x(13, 12)); wx_bcc(c, 0, "wx_close_shared");
    wx(c, arm64.add_imm_x(11, 11, 1, iie)); wx_b(c, "wx_close_scan");
    wx_label(c, "wx_close_shared"); wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_close_last");
    wx_data(c, patches, base, 10, 64); wx(c, arm64.ldr_x(11, 31, 144)); wx(c, arm64.lsl_x(11, 11, 3)); wx(c, arm64.add_x(10, 10, 11)); wx(c, arm64.ldr_x(12, 10, 0));
    wx(c, arm64.str_x(31, 10, 0)); wx(c, arm64.ldr_x(0, 31, 152)); wx_cmpi(c, 12, 2); wx_bcc(c, 0, "wx_close_socket");
    wx_call(c, patches, "CloseHandle"); wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_close_socket"); wx_call(c, patches, "closesocket"); wx_li(c, 0, 0); wx_b(c, "wx_ok");
    // a socket descriptor (>= 64): clear its entry of the socket table and closesocket the SOCKET
    wx_label(c, "wx_close_socket_entry");
    wx(c, arm64.str_x(0, 31, 144)); wx_bl(c, "wx_handle"); wx_cbz(c, 0, "wx_badfd");
    wx(c, arm64.str_x(0, 31, 152));
    wx_data(c, patches, base, 10, 256); wx(c, arm64.ldr_x(11, 31, 144)); wx(c, arm64.sub_imm_x(11, 11, 64, iie)); wx(c, arm64.lsl_x(11, 11, 3)); wx(c, arm64.add_x(10, 10, 11)); wx(c, arm64.str_x(31, 10, 0));
    wx(c, arm64.ldr_x(0, 31, 152)); wx_call(c, patches, "closesocket"); wx_li(c, 0, 0); wx_b(c, "wx_ok");

    // ---- open(path, flags, mode): "/dev/stdin|stdout|stderr" are descriptors 0..2, "/dev/null" is NUL; files via CreateFileW
    wx_label(c, "wx_open");
    wx_alloc(c, 2304);
    wx_str(c, 0, 2048); wx_str(c, 1, 2056);
    wx_streq(c, 0, "/dev/stdin", "wx_open_not_stdin"); wx_li(c, 0, 0); wx_free(c, 2304); wx_b(c, "wx_ok");
    wx_label(c, "wx_open_not_stdin"); wx_ldr(c, 0, 2048);
    wx_streq(c, 0, "/dev/stdout", "wx_open_not_stdout"); wx_li(c, 0, 1); wx_free(c, 2304); wx_b(c, "wx_ok");
    wx_label(c, "wx_open_not_stdout"); wx_ldr(c, 0, 2048);
    wx_streq(c, 0, "/dev/stderr", "wx_open_not_stderr"); wx_li(c, 0, 2); wx_free(c, 2304); wx_b(c, "wx_ok");
    wx_label(c, "wx_open_not_stderr"); wx_ldr(c, 0, 2048);
    wx_streq(c, 0, "/dev/null", "wx_open_path");
    wx_li(c, 9, 5002574); wx(c, arm64.str_x(9, 31, 2104)); wx(c, arm64.add_imm_x(9, 31, 2104, iie)); wx_str(c, 9, 2048);
    wx_label(c, "wx_open_path");
    wx_to_utf16(c, patches, 2048); wx_cbz(c, 0, "wx_open_invalid");
    wx_ldr(c, 9, 2056);
    // desired access from the low two flag bits (0 read, 1 write, 2 both); O_APPEND replaces write by FILE_APPEND_DATA
    wx_li(c, 10, 3); wx(c, arm64.and_x(10, 9, 10));
    wx_li(c, 1, 2147483648); wx_cbz(c, 10, "wx_open_access_done");
    wx_li(c, 1, 1073741824); wx_cmpi(c, 10, 1); wx_bcc(c, 0, "wx_open_access_done"); wx_li(c, 1, 3221225472);
    wx_label(c, "wx_open_access_done");
    wx_li(c, 11, 8); wx(c, arm64.and_x(11, 9, 11)); wx_cbz(c, 11, "wx_open_not_append");
    wx_cbz(c, 10, "wx_open_not_append");
    wx_li(c, 12, 1048580); wx_cmpi(c, 10, 2); wx_bcc(c, 1, "wx_open_append_only"); wx_li(c, 1, 2148532228); wx_b(c, "wx_open_not_append");
    wx_label(c, "wx_open_append_only"); wx_mov(c, 1, 12);
    wx_label(c, "wx_open_not_append");
    // creation disposition
