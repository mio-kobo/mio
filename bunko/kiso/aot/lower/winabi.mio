    wx_li(c, 10, 2048); wx(c, arm64.and_x(10, 9, 10)); wx_cbz(c, 10, "wx_open_create_plain"); wx_li(c, 4, 1); wx_b(c, "wx_open_disposition_done");
    wx_label(c, "wx_open_create_plain"); wx_li(c, 10, 1024); wx(c, arm64.and_x(10, 9, 10)); wx_li(c, 4, 4); wx_cbz(c, 10, "wx_open_disposition_done"); wx_li(c, 4, 2); wx_b(c, "wx_open_disposition_done");
    wx_label(c, "wx_open_no_create");
    wx_li(c, 10, 1024); wx(c, arm64.and_x(10, 9, 10)); wx_li(c, 4, 3); wx_cbz(c, 10, "wx_open_disposition_done"); wx_li(c, 4, 5);
    wx_label(c, "wx_open_disposition_done");
    wx(c, arm64.add_imm_x(0, 31, 0, iie)); wx_li(c, 2, 7); wx_li(c, 3, 0); wx_li(c, 5, 33554560); wx_li(c, 6, 0);
    wx_call(c, patches, "CreateFileW");
    wx(c, arm64.cmn_imm_x(0, 1, iie)); wx_bcc(c, 0, "wx_open_failed");
