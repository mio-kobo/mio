    wx_li(c, 9, 1); wx_put(c, patches, base, 9, 162);
    wx_label(c, "wx_socket_started");
    wx_ldr(c, 0, 2048); wx_ldr(c, 1, 2056); wx_ldr(c, 2, 2064); wx_li(c, 3, 0); wx_li(c, 4, 0); wx_li(c, 5, 0);
    wx_call(c, patches, "WSASocketW"); wx(c, arm64.cmn_imm_x(0, 1, iie)); wx_bcc(c, 0, "wx_socket_failed");
    wx_str(c, 0, 2072);
    wx_data(c, patches, base, 10, 256); wx_li(c, 11, 0);
    wx_label(c, "wx_socket_scan");
    wx_cmpi(c, 11, 4032); wx_bcc(c, 2, "wx_socket_full");
    wx(c, arm64.ldr_x_register_scaled(12, 10, 11)); wx_cbz(c, 12, "wx_socket_found");
    wx(c, arm64.add_imm_x(11, 11, 1, iie)); wx_b(c, "wx_socket_scan");
    wx_label(c, "wx_socket_found");
    wx_ldr(c, 0, 2072); wx(c, arm64.lsl_x(12, 11, 3)); wx(c, arm64.add_x(12, 10, 12)); wx(c, arm64.str_x(0, 12, 0));
    wx(c, arm64.add_imm_x(0, 11, 64, iie)); wx_free(c, 2304); wx_b(c, "wx_ok");
    wx_label(c, "wx_socket_full"); wx_ldr(c, 0, 2072); wx_call(c, patches, "closesocket"); wx_free(c, 2304); wx_li(c, 0, 24); wx_b(c, "wx_error");
    wx_label(c, "wx_socket_wsa_failed"); wx_bl(c, "wx_map_error"); wx_free(c, 2304); wx_b(c, "wx_error");
    wx_label(c, "wx_socket_failed"); wx_call(c, patches, "WSAGetLastError"); wx_bool(c); wx_bl(c, "wx_map_error"); wx_free(c, 2304); wx_b(c, "wx_error");

    // bind / connect (fd, sockaddr_in, length): Darwin's sin_len + 8-bit family becomes Windows' 16-bit family
    wx_label(c, "wx_bind"); wx_li(c, 9, 0); wx_b(c, "wx_sockaddr");
    wx_label(c, "wx_connect"); wx_li(c, 9, 1);
    wx_label(c, "wx_sockaddr");
    wx_alloc(c, 2304); wx_str(c, 9, 2048);
    wx(c, arm64.ldp_x(10, 11, 1, 0)); wx(c, arm64.stp_x(10, 11, 31, 16));
    wx_li(c, 10, 2); wx(c, arm64.strb_w(10, 31, 16)); wx(c, arm64.strb_w(31, 31, 17));
    wx_bl(c, "wx_handle"); wx_cbz(c, 0, "wx_sockaddr_badfd");
    wx(c, arm64.add_imm_x(1, 31, 16, iie)); wx_li(c, 2, 16); wx_ldr(c, 9, 2048);
    wx_cbz(c, 9, "wx_sockaddr_bind"); wx_call(c, patches, "connect"); wx_b(c, "wx_sockaddr_result");
    wx_label(c, "wx_sockaddr_bind"); wx_call(c, patches, "bind");
    wx_label(c, "wx_sockaddr_result");
    wx_bool(c); wx_cbnz(c, 0, "wx_sockaddr_failed");
    wx_free(c, 2304); wx_li(c, 0, 0); wx_b(c, "wx_ok");
    // A nonblocking connect reports WSAEWOULDBLOCK (mapped to EAGAIN, 35) while it is in progress: that is EINPROGRESS (36) on Darwin.
    wx_label(c, "wx_sockaddr_failed"); wx_call(c, patches, "WSAGetLastError"); wx_bool(c); wx_bl(c, "wx_map_error");
    wx_ldr(c, 9, 2048); wx_cbz(c, 9, "wx_sockaddr_failed_done"); wx_cmpi(c, 0, 35); wx_bcc(c, 1, "wx_sockaddr_failed_done"); wx_li(c, 0, 36);
    wx_label(c, "wx_sockaddr_failed_done"); wx_free(c, 2304); wx_b(c, "wx_error");
    wx_label(c, "wx_sockaddr_badfd"); wx_free(c, 2304); wx_b(c, "wx_badfd");

    // listen(fd, backlog)
    wx_label(c, "wx_listen");
    wx(c, arm64.str_x(1, 31, 144)); wx_bl(c, "wx_handle"); wx_cbz(c, 0, "wx_badfd");
    wx(c, arm64.ldr_x(1, 31, 144)); wx_call(c, patches, "listen"); wx_bool(c); wx_cbnz(c, 0, "wx_net_failed");
    wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_net_failed"); wx_call(c, patches, "WSAGetLastError"); wx_bool(c); wx_bl(c, "wx_map_error"); wx_b(c, "wx_error");

    // accept(fd, NULL, NULL): the new SOCKET gets a descriptor of its own
    wx_label(c, "wx_accept");
    wx_bl(c, "wx_handle"); wx_cbz(c, 0, "wx_badfd");
    wx_li(c, 1, 0); wx_li(c, 2, 0); wx_call(c, patches, "accept"); wx(c, arm64.cmn_imm_x(0, 1, iie)); wx_bcc(c, 0, "wx_net_failed");
    wx(c, arm64.str_x(0, 31, 144));
    wx_data(c, patches, base, 10, 256); wx_li(c, 11, 0);
    wx_label(c, "wx_accept_scan");
    wx_cmpi(c, 11, 4032); wx_bcc(c, 2, "wx_accept_full");
    wx(c, arm64.ldr_x_register_scaled(12, 10, 11)); wx_cbz(c, 12, "wx_accept_found");
    wx(c, arm64.add_imm_x(11, 11, 1, iie)); wx_b(c, "wx_accept_scan");
    wx_label(c, "wx_accept_found");
    wx(c, arm64.ldr_x(0, 31, 144)); wx(c, arm64.lsl_x(12, 11, 3)); wx(c, arm64.add_x(12, 10, 12)); wx(c, arm64.str_x(0, 12, 0));
    wx(c, arm64.add_imm_x(0, 11, 64, iie)); wx_b(c, "wx_ok");
    wx_label(c, "wx_accept_full"); wx(c, arm64.ldr_x(0, 31, 144)); wx_call(c, patches, "closesocket"); wx_li(c, 0, 24); wx_b(c, "wx_error");

    // setsockopt(fd, level, name, value, length): SO_NOSIGPIPE (0x1022) has no Windows counterpart and is ignored
    wx_label(c, "wx_setsockopt");
    wx_li(c, 9, 4130); wx(c, arm64.cmp_x(2, 9)); wx_bcc(c, 1, "wx_setsockopt_real"); wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_setsockopt_real");
    // Darwin's SO_REUSEADDR only allows reuse of a port in TIME_WAIT; on Windows it would let a second socket take over a live
    // port, so (like the Windows amd64 runtime) it becomes SO_EXCLUSIVEADDRUSE (0xFFFFFFFB): a second bind reports AddressInUse
    wx_cmpi(c, 2, 4); wx_bcc(c, 1, "wx_setsockopt_pass"); wx_li(c, 2, 4294967291);
    wx_label(c, "wx_setsockopt_pass");
    wx(c, arm64.stp_x(1, 2, 31, 144)); wx(c, arm64.stp_x(3, 4, 31, 160));
    wx_bl(c, "wx_handle"); wx_cbz(c, 0, "wx_badfd");
    wx(c, arm64.ldp_x(1, 2, 31, 144)); wx(c, arm64.ldp_x(3, 4, 31, 160));
    wx_call(c, patches, "setsockopt"); wx_bool(c); wx_cbnz(c, 0, "wx_net_failed");
    wx_li(c, 0, 0); wx_b(c, "wx_ok");

    // ---- memory. Darwin pages are 16 KiB: lengths are rounded up to 16 KiB (VirtualAlloc returns 64 KiB-aligned regions).
    // mmap -> VirtualAlloc(NULL, length, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE)
    wx_label(c, "wx_mmap");
    wx_li(c, 9, 16383); wx(c, arm64.add_x(1, 1, 9)); wx(c, arm64.movn_x(10, 16383, 0)); wx(c, arm64.and_x(1, 1, 10));
    wx_li(c, 0, 0); wx_li(c, 2, 12288); wx_li(c, 3, 4); wx_call(c, patches, "VirtualAlloc");
    wx_cbz(c, 0, "wx_nomem"); wx_b(c, "wx_ok");
    wx_label(c, "wx_nomem"); wx_li(c, 0, 12); wx_b(c, "wx_error");
    // mprotect(addr, length, prot): PROT_NONE decommits the range, anything else commits it read/write
    wx_label(c, "wx_mprotect");
    wx(c, arm64.str_x(0, 31, 144)); wx(c, arm64.str_x(1, 31, 152));
    wx_cbz(c, 2, "wx_decommit");
    wx_li(c, 2, 4096); wx_li(c, 3, 4); wx_call(c, patches, "VirtualAlloc"); wx_cbz(c, 0, "wx_nomem");
    wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_decommit");
    wx_li(c, 2, 16384); wx_call(c, patches, "VirtualFree"); wx_bool(c); wx_cbz(c, 0, "wx_nomem");
    wx_li(c, 0, 0); wx_b(c, "wx_ok");
    // munmap(addr, length): release the whole region when addr is its base, otherwise decommit the range
    wx_label(c, "wx_munmap");
    wx(c, arm64.str_x(0, 31, 144)); wx(c, arm64.str_x(1, 31, 152));
    wx_li(c, 1, 0); wx_li(c, 2, 32768); wx_call(c, patches, "VirtualFree"); wx_bool(c); wx_cbz(c, 0, "wx_munmap_range");
    wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_munmap_range");
    wx(c, arm64.ldr_x(0, 31, 144)); wx(c, arm64.ldr_x(1, 31, 152));
    wx_li(c, 9, 16383); wx(c, arm64.add_x(1, 1, 9)); wx(c, arm64.movn_x(10, 16383, 0)); wx(c, arm64.and_x(1, 1, 10));
    wx_li(c, 2, 16384); wx_call(c, patches, "VirtualFree"); wx_bool(c); wx_cbz(c, 0, "wx_nomem");
    wx_li(c, 0, 0); wx_b(c, "wx_ok");
}

// Start-up: the three standard handles go into descriptor-table entries 0..2 and the console is switched to UTF-8.
koukai waza emit_windows_init(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64) -> unit {
    wx_label(c, "windows_init");
    wx(c, arm64.stp_pre_x(29, 30, 31, -16));
    kaku handle = 0;
    aida (handle < 3) {
        wx_li(c, 0, 4294967286 - handle); wx_call(c, patches, "GetStdHandle");
        wx_data(c, patches, base, 10, 0); wx(c, arm64.str_x(0, 10, handle * 8));
        handle = handle + 1;
    }
    wx_li(c, 0, 65001); wx_call(c, patches, "SetConsoleOutputCP");
    wx_li(c, 0, 65001); wx_call(c, patches, "SetConsoleCP");
    // a parent that passed a records channel (spawn_test) describes it in STARTUPINFO.lpReserved2 with the C runtime layout:
    // count (4 bytes), count flag bytes, count handles; descriptor 3 becomes table entry 3
    wx_alloc(c, 128);
    wx(c, arm64.add_imm_x(0, 31, 0, iie)); wx_call(c, patches, "GetStartupInfoW");
    wx(c, arm64.ldrh_w(9, 31, 66)); wx_cmpi(c, 9, 40); wx_bcc(c, 3, "windows_init_done");
    wx(c, arm64.ldr_x(9, 31, 72)); wx_cbz(c, 9, "windows_init_done");
    wx(c, arm64.ldr_w(10, 9, 0)); wx_cmpi(c, 10, 4); wx_bcc(c, 3, "windows_init_done");
    wx(c, arm64.ldrb_w(11, 9, 7)); wx_li(c, 12, 1); wx(c, arm64.and_x(11, 11, 12)); wx_cbz(c, 11, "windows_init_done");
    wx(c, arm64.add_x(12, 9, 10)); wx(c, arm64.add_imm_x(12, 12, 28, iie)); wx(c, arm64.ldr_x(13, 12, 0));
    wx_data(c, patches, base, 14, 0); wx(c, arm64.str_x(13, 14, 24));
    wx_label(c, "windows_init_done");
    wx_free(c, 128);
    wx(c, arm64.ldp_post_x(29, 30, 31, 16)); wx(c, arm64.ret());
}

// Process arguments and environment as the Darwin entry expects them: x0 = argc, x1 = argv (UTF-8, NULL-terminated array),
// x2 = envp (UTF-8 "NAME=VALUE" strings, NULL-terminated array). Everything lives in a 4 MiB arena that is never freed.
// The command line is split by CommandLineToArgvW (the Windows quoting rules), then each argument is converted to UTF-8;
// the environment block (a double-NUL-terminated UTF-16 list) is converted in one call and indexed.
koukai waza emit_windows_args(c: arm64.Assembler, patches: []macho.AddressPatch) -> unit {
    wx_label(c, "windows_args");
    wx(c, arm64.stp_pre_x(29, 30, 31, -128));
    // arena
    wx_li(c, 0, 0); wx_li(c, 1, 4194304); wx_li(c, 2, 12288); wx_li(c, 3, 4); wx_call(c, patches, "VirtualAlloc");
    wx_cbz(c, 0, "windows_args_fail"); wx_str(c, 0, 16); wx_str(c, 0, 24);
    // argc / wide argv
    wx_call(c, patches, "GetCommandLineW"); wx(c, arm64.add_imm_x(1, 31, 32, iie)); wx_call(c, patches, "CommandLineToArgvW");
    wx_cbz(c, 0, "windows_args_fail"); wx_str(c, 0, 40);
    wx(c, arm64.ldr_w(9, 31, 32)); wx_str(c, 9, 32);
    // the argv pointer array
    wx_ldr(c, 10, 24); wx_str(c, 10, 48); wx(c, arm64.add_imm_x(11, 9, 1, iie)); wx(c, arm64.lsl_x(11, 11, 3)); wx(c, arm64.add_x(10, 10, 11)); wx_str(c, 10, 24);
    wx_str(c, 31, 56);
    wx_label(c, "windows_args_next");
    wx_ldr(c, 9, 56); wx_ldr(c, 10, 32); wx(c, arm64.cmp_x(9, 10)); wx_bcc(c, 2, "windows_args_done");
    wx_ldr(c, 11, 40); wx(c, arm64.ldr_x_register_scaled(2, 11, 9));
    wx_li(c, 0, 65001); wx_li(c, 1, 0); wx(c, arm64.movn_x(3, 0, 0)); wx_ldr(c, 4, 24);
    wx_ldr(c, 9, 16); wx_li(c, 12, 4194304); wx(c, arm64.add_x(9, 9, 12)); wx(c, arm64.sub_x(5, 9, 4)); wx_li(c, 6, 0); wx_li(c, 7, 0);
    wx_call(c, patches, "WideCharToMultiByte"); wx_bool(c); wx_cbz(c, 0, "windows_args_fail");
    wx_ldr(c, 9, 56); wx_ldr(c, 10, 48); wx_ldr(c, 11, 24); wx(c, arm64.lsl_x(12, 9, 3)); wx(c, arm64.add_x(12, 10, 12)); wx(c, arm64.str_x(11, 12, 0));
    wx(c, arm64.add_x(11, 11, 0)); wx_str(c, 11, 24);
    wx(c, arm64.add_imm_x(9, 9, 1, iie)); wx_str(c, 9, 56); wx_b(c, "windows_args_next");
    wx_label(c, "windows_args_done");
    wx_ldr(c, 9, 32); wx_ldr(c, 10, 48); wx(c, arm64.lsl_x(9, 9, 3)); wx(c, arm64.add_x(10, 10, 9)); wx(c, arm64.str_x(31, 10, 0));
    // the environment block
    wx_ldr(c, 11, 24); wx(c, arm64.add_imm_x(11, 11, 7, iie)); wx(c, arm64.movn_x(12, 7, 0)); wx(c, arm64.and_x(11, 11, 12)); wx_str(c, 11, 24);
    wx_call(c, patches, "GetEnvironmentStringsW"); wx_str(c, 0, 64); wx_cbz(c, 0, "windows_args_noenv");
    // length in UTF-16 units: up to and including the terminating pair of NULs
    wx_mov(c, 9, 0);
    wx_label(c, "windows_args_scan");
    wx(c, arm64.ldrh_w(10, 9, 0)); wx_cbnz(c, 10, "windows_args_advance");
    wx(c, arm64.ldrh_w(10, 9, 2)); wx_cbz(c, 10, "windows_args_scanned");
    wx_label(c, "windows_args_advance"); wx(c, arm64.add_imm_x(9, 9, 2, iie)); wx_b(c, "windows_args_scan");
    wx_label(c, "windows_args_scanned");
    wx_ldr(c, 10, 64); wx(c, arm64.sub_x(9, 9, 10)); wx(c, arm64.lsr_x(3, 9, 1)); wx(c, arm64.add_imm_x(3, 3, 2, iie));
    wx_li(c, 0, 65001); wx_li(c, 1, 0); wx_ldr(c, 2, 64); wx_ldr(c, 4, 24);
    wx_ldr(c, 9, 16); wx_li(c, 12, 4194304); wx(c, arm64.add_x(9, 9, 12)); wx(c, arm64.sub_x(5, 9, 4)); wx_li(c, 6, 0); wx_li(c, 7, 0);
    wx_call(c, patches, "WideCharToMultiByte"); wx_bool(c); wx_cbz(c, 0, "windows_args_noenv");
    wx_str(c, 0, 80); wx_ldr(c, 9, 24); wx_str(c, 9, 72);
    wx_ldr(c, 10, 80); wx(c, arm64.add_x(9, 9, 10)); wx(c, arm64.add_imm_x(9, 9, 7, iie)); wx(c, arm64.movn_x(12, 7, 0)); wx(c, arm64.and_x(9, 9, 12)); wx_str(c, 9, 88);
    // envp[k] = start of each non-empty string
    wx_li(c, 11, 0); wx_li(c, 12, 1); wx_li(c, 13, 0);
    wx_label(c, "windows_args_env_loop");
    wx_ldr(c, 10, 80); wx(c, arm64.cmp_x(11, 10)); wx_bcc(c, 2, "windows_args_env_end");
    wx_ldr(c, 9, 72); wx(c, arm64.add_x(9, 9, 11)); wx(c, arm64.ldrb_w(14, 9, 0));
    wx_cbz(c, 14, "windows_args_env_nul"); wx_cbz(c, 12, "windows_args_env_cont");
    wx_ldr(c, 15, 88); wx(c, arm64.lsl_x(16, 13, 3)); wx(c, arm64.add_x(15, 15, 16)); wx(c, arm64.str_x(9, 15, 0)); wx(c, arm64.add_imm_x(13, 13, 1, iie));
    wx_label(c, "windows_args_env_cont"); wx_li(c, 12, 0); wx(c, arm64.add_imm_x(11, 11, 1, iie)); wx_b(c, "windows_args_env_loop");
    wx_label(c, "windows_args_env_nul"); wx_li(c, 12, 1); wx(c, arm64.add_imm_x(11, 11, 1, iie)); wx_b(c, "windows_args_env_loop");
    wx_label(c, "windows_args_env_end");
    wx_ldr(c, 15, 88); wx(c, arm64.lsl_x(16, 13, 3)); wx(c, arm64.add_x(15, 15, 16)); wx(c, arm64.str_x(31, 15, 0));
    wx_b(c, "windows_args_return");
    wx_label(c, "windows_args_noenv");
    wx_ldr(c, 9, 24); wx_str(c, 9, 88); wx(c, arm64.str_x(31, 9, 0));
    wx_label(c, "windows_args_return");
    wx_ldr(c, 0, 32); wx_ldr(c, 1, 48); wx_ldr(c, 2, 88);
    wx(c, arm64.ldp_post_x(29, 30, 31, 128)); wx(c, arm64.ret());
    wx_label(c, "windows_args_fail"); wx_li(c, 0, 3); wx_call(c, patches, "ExitProcess");
    wx_label(c, "windows_args_hang"); wx_b(c, "windows_args_hang");
}

// PE entry point: the loader calls it with no arguments. It initialises the adapter, builds argc/argv/envp from the real
// command line and environment, and continues at the first lowered word (label windows_main) with the Darwin entry registers.
koukai waza emit_windows_start(c: arm64.Assembler) -> unit {
    wx_label(c, "windows_start");
    wx_bl(c, "windows_init");
    wx_bl(c, "windows_args");
    wx_b(c, "windows_main");
}
