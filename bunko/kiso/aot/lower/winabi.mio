    wx_li(c, 2, 0); wx_li(c, 3, 0); wx_li(c, 4, 1); wx_li(c, 5, 0); wx_li(c, 6, 0); wx_li(c, 7, 0);
    wx_call(c, patches, "CreateProcessW"); wx_bool(c); wx_cbz(c, 0, "wx_exec_start_failed");
