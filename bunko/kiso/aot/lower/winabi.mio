    wx_label(c, "wx_poll_sleep"); wx_li(c, 0, 10); wx_call(c, patches, "Sleep"); wx_b(c, "wx_poll_again");
    wx_label(c, "wx_poll_timeout"); wx(c, arm64.ldr_x(9, 31, 144)); wx(c, arm64.strh_w(31, 9, 6)); wx_li(c, 0, 0); wx_b(c, "wx_ok");
    wx_label(c, "wx_poll_ready"); wx(c, arm64.ldr_x(9, 31, 144)); wx_li(c, 10, 1); wx(c, arm64.strh_w(10, 9, 6)); wx_li(c, 0, 1); wx_b(c, "wx_ok");
