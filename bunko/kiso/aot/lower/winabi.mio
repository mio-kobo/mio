    wx(c, arm64.ldr_x(9, 31, 144)); wx_li(c, 10, 4); wx(c, arm64.strh_w(10, 9, 6)); wx_li(c, 0, 1); wx_b(c, "wx_ok");
    wx_label(c, "wx_poll_socket_error"); wx(c, arm64.ldr_x(9, 31, 144)); wx_li(c, 10, 8); wx(c, arm64.strh_w(10, 9, 6)); wx_li(c, 0, 1); wx_b(c, "wx_ok");

