    wx_data(c, patches, base, 10, 0);
    wx(c, arm64.ldr_x(9, 10, 0)); wx_str(c, 9, 2192); wx(c, arm64.ldr_x(9, 10, 8)); wx_str(c, 9, 2200); wx(c, arm64.ldr_x(9, 10, 16)); wx_str(c, 9, 2208);
