    emit(code, arm64.sub_imm_x(9, 22, 16, iie)); emit(code, arm64.str_x(9, 13, 8));
    emit(code, arm64.lsr_x(11, 14, 4)); emit(code, arm64.cmp_imm_x(11, 31, iie));
    arm64.assembler_b_cond(code, 9, "runtime_alloc_split_class"); emit(code, arm64.movz_x(11, 31, 0));
    arm64.assembler_label(code, "runtime_alloc_split_class");
    emit(code, arm64.lsl_x(11, 11, 3)); emit(code, arm64.add_imm_x(12, 23, 24, iie)); emit(code, arm64.add_x(12, 12, 11));
    emit(code, arm64.ldr_x(9, 12, 0)); emit(code, arm64.str_x(9, 15, 16)); emit(code, arm64.str_x(15, 12, 0));
    arm64.assembler_label(code, "runtime_alloc_taken");
    emit(code, arm64.str_x(20, 13, 0)); emit(code, arm64.add_imm_x(0, 13, 16, iie)); arm64.assembler_b(code, "runtime_alloc_done");
    arm64.assembler_label(code, "runtime_alloc_next_bin");
    emit(code, arm64.add_imm_x(11, 11, 1, iie)); emit(code, arm64.cmp_imm_x(11, 32, iie)); arm64.assembler_b_cond(code, 3, "runtime_alloc_bin");
    emit(code, arm64.ldr_x(13, 23, 0)); emit(code, arm64.add_x(14, 13, 22)); emit(code, arm64.ldr_x(9, 23, 8)); emit(code, arm64.cmp_x(14, 9));
    arm64.assembler_b_cond(code, 9, "runtime_alloc_bump");
    arm64.assembler_cbnz_x(code, 21, "runtime_alloc_fail");
    emit(code, arm64.movz_x(21, 1, 0)); arm64.assembler_bl(code, "runtime_collect"); arm64.assembler_b(code, "runtime_alloc_retry");
    arm64.assembler_label(code, "runtime_alloc_bump");
    emit(code, arm64.str_x(14, 23, 0)); emit(code, arm64.str_x(20, 13, 0)); emit(code, arm64.sub_imm_x(9, 22, 16, iie)); emit(code, arm64.str_x(9, 13, 8)); emit(code, arm64.add_imm_x(0, 13, 16, iie)); arm64.assembler_b(code, "runtime_alloc_done");
    arm64.assembler_label(code, "runtime_alloc_fail"); emit(code, arm64.movz_x(0, 0, 0));
    arm64.assembler_label(code, "runtime_alloc_done");
    emit(code, arm64.ldp_post_x(21, 22, 31, 16)); emit(code, arm64.ldp_post_x(19, 20, 31, 16)); emit(code, arm64.ldp_post_x(29, 30, 31, 16)); emit(code, arm64.ret());
}

// M16b type 101/102 runtime. Copy loops have no allocation/call safepoints.
waza emit_array_runtime(code: arm64.Assembler) -> unit {
    arm64.assembler_label(code, "runtime_array_move");
    arm64.assembler_cbz_x(code, 2, "runtime_array_move_done");
    emit(code, arm64.cmp_x(0, 1));
    arm64.assembler_b_cond(code, 9, "runtime_array_move_forward");
    emit(code, arm64.add_x(0, 0, 2));
    emit(code, arm64.add_x(1, 1, 2));
    arm64.assembler_label(code, "runtime_array_move_back");
    emit(code, arm64.sub_imm_x(0, 0, 1, iie));
    emit(code, arm64.sub_imm_x(1, 1, 1, iie));
    emit(code, arm64.ldrb_w(9, 1, 0));
    emit(code, arm64.strb_w(9, 0, 0));
    emit(code, arm64.sub_imm_x(2, 2, 1, iie));
    arm64.assembler_cbz_x(code, 2, "runtime_array_move_done");
    arm64.assembler_b(code, "runtime_array_move_back");
    arm64.assembler_label(code, "runtime_array_move_forward");
    emit(code, arm64.ldrb_w(9, 1, 0));
    emit(code, arm64.strb_w(9, 0, 0));
    emit(code, arm64.add_imm_x(0, 0, 1, iie));
    emit(code, arm64.add_imm_x(1, 1, 1, iie));
    emit(code, arm64.sub_imm_x(2, 2, 1, iie));
    arm64.assembler_cbz_x(code, 2, "runtime_array_move_done");
    arm64.assembler_b(code, "runtime_array_move_forward");
    arm64.assembler_label(code, "runtime_array_move_done");
    emit(code, arm64.ret());
    arm64.assembler_label(code, "runtime_array_reserve");
    emit(code, arm64.sub_imm_x(31, 31, 64, iie));
    emit(code, arm64.str_x(30, 31, 0));
    emit(code, arm64.str_x(0, 31, 8));
    arm64.assembler_cbz_x(code, 0, "runtime_error");
    emit(code, arm64.cmp_imm_x(1, 0, iie));
    arm64.assembler_b_cond(code, 11, "runtime_error");
    emit(code, arm64.ldr_x(10, 0, 8));
    emit(code, arm64.add_x(11, 10, 1));
    emit(code, arm64.cmp_x(11, 10));
    arm64.assembler_b_cond(code, 3, "runtime_error");
    emit(code, arm64.cmp_imm_x(11, 0, iie));
    arm64.assembler_b_cond(code, 11, "runtime_error");
    emit(code, arm64.str_x(11, 31, 16));
    emit(code, arm64.ldr_x(9, 0, 0));
    emit(code, arm64.lsr_x(9, 9, 8));
    move_bits(code, 12, uint32(0), uint32(255));
    emit(code, arm64.and_x(9, 9, 12));
    emit(code, arm64.str_x(9, 31, 32));
    move_bits(code, 12, uint32(0), uint32(runtime_max_storage_bytes));
    emit(code, arm64.udiv_x(12, 12, 9));
    emit(code, arm64.cmp_x(11, 12));
    arm64.assembler_b_cond(code, 8, "runtime_oom");
    emit(code, arm64.ldr_x(10, 0, 16));
    emit(code, arm64.cmp_x(10, 11));
    arm64.assembler_b_cond(code, 2, "runtime_array_reserve_done");
    emit(code, arm64.cmp_imm_x(10, 4, iie));
    arm64.assembler_b_cond(code, 2, "runtime_array_grow");
    move_bits(code, 10, uint32(0), uint32(4));
    arm64.assembler_label(code, "runtime_array_grow");
    emit(code, arm64.cmp_x(10, 11));
    arm64.assembler_b_cond(code, 2, "runtime_array_allocate");
    emit(code, arm64.cmp_imm_x(10, 1024, iie));
    arm64.assembler_b_cond(code, 3, "runtime_array_double");
    emit(code, arm64.lsr_x(13, 10, 1));
    emit(code, arm64.add_x(10, 10, 13));
    arm64.assembler_b(code, "runtime_array_grow_limit");
    arm64.assembler_label(code, "runtime_array_double");
    emit(code, arm64.add_x(10, 10, 10));
    arm64.assembler_label(code, "runtime_array_grow_limit");
    emit(code, arm64.cmp_x(10, 12));
    arm64.assembler_b_cond(code, 9, "runtime_array_grow");
    move_x(code, 10, 11);
    arm64.assembler_label(code, "runtime_array_allocate");
    emit(code, arm64.str_x(10, 31, 24));
    emit(code, arm64.mul_x(0, 10, 9));
    emit(code, arm64.add_imm_x(0, 0, 32, iie));
    move_bits(code, 1, uint32(0), uint32(102));
    arm64.assembler_bl(code, "runtime_alloc");
    arm64.assembler_cbz_x(code, 0, "runtime_oom");
    emit(code, arm64.str_x(0, 31, 40));
    emit(code, arm64.ldr_x(12, 31, 8));
    emit(code, arm64.ldr_x(9, 12, 0));
    emit(code, arm64.add_imm_x(9, 9, 1, iie));
    emit(code, arm64.str_x(9, 0, 0));
    emit(code, arm64.ldr_x(10, 31, 24));
    emit(code, arm64.str_x(10, 0, 8));
    move_bits(code, 11, uint32(0), uint32(1));
    emit(code, arm64.str_x(11, 0, 16));
    emit(code, arm64.lsr_x(11, 9, 16));
    move_bits(code, 13, uint32(0), uint32(1));
    emit(code, arm64.and_x(11, 11, 13));
    emit(code, arm64.str_x(11, 0, 24));
    emit(code, arm64.ldr_x(9, 31, 32));
    emit(code, arm64.mul_x(10, 10, 9));
    emit(code, arm64.add_imm_x(11, 0, 32, iie));
    arm64.assembler_label(code, "runtime_array_zero");
    arm64.assembler_cbz_x(code, 10, "runtime_array_preserve");
    emit(code, arm64.strb_w(31, 11, 0));
    emit(code, arm64.add_imm_x(11, 11, 1, iie));
    emit(code, arm64.sub_imm_x(10, 10, 1, iie));
    arm64.assembler_b(code, "runtime_array_zero");
    arm64.assembler_label(code, "runtime_array_preserve");
    emit(code, arm64.ldr_x(2, 12, 8));
    emit(code, arm64.mul_x(2, 2, 9));
    emit(code, arm64.ldr_x(1, 12, 40));
    emit(code, arm64.add_imm_x(1, 1, 32, iie));
    emit(code, arm64.add_imm_x(0, 0, 32, iie));
    arm64.assembler_bl(code, "runtime_array_move");
    emit(code, arm64.ldr_x(12, 31, 8));
    emit(code, arm64.ldr_x(9, 31, 40));
    emit(code, arm64.str_x(9, 12, 40));
    emit(code, arm64.ldr_x(9, 31, 24));
    emit(code, arm64.str_x(9, 12, 16));
    arm64.assembler_label(code, "runtime_array_reserve_done");
    emit(code, arm64.ldr_x(30, 31, 0));
    emit(code, arm64.add_imm_x(31, 31, 64, iie));
    emit(code, arm64.ret());
    arm64.assembler_label(code, "runtime_array_append");
    emit(code, arm64.sub_imm_x(31, 31, 48, iie));
    emit(code, arm64.str_x(30, 31, 0));
    emit(code, arm64.str_x(0, 31, 8));
    emit(code, arm64.str_x(1, 31, 16));
    arm64.assembler_cbz_x(code, 0, "runtime_error");
    arm64.assembler_cbz_x(code, 1, "runtime_error");
    emit(code, arm64.ldr_x(9, 1, 8));
    emit(code, arm64.str_x(9, 31, 24));
    arm64.assembler_cbz_x(code, 9, "runtime_array_append_done");
    emit(code, arm64.ldr_x(10, 0, 8));
    emit(code, arm64.str_x(10, 31, 32));
    emit(code, arm64.ldr_x(10, 0, 0));
    emit(code, arm64.ldr_x(11, 1, 0));
    emit(code, arm64.cmp_x(10, 11));
    arm64.assembler_b_cond(code, 1, "runtime_error");
    move_x(code, 1, 9);
    arm64.assembler_bl(code, "runtime_array_reserve");
    emit(code, arm64.ldr_x(12, 31, 8));
    emit(code, arm64.ldr_x(13, 31, 16));
    emit(code, arm64.ldr_x(0, 12, 40));
    emit(code, arm64.ldr_x(1, 13, 40));
    emit(code, arm64.add_imm_x(0, 0, 32, iie));
    emit(code, arm64.add_imm_x(1, 1, 32, iie));
    emit(code, arm64.ldr_x(9, 12, 0));
    emit(code, arm64.lsr_x(9, 9, 8));
    move_bits(code, 10, uint32(0), uint32(255));
    emit(code, arm64.and_x(9, 9, 10));
    emit(code, arm64.ldr_x(10, 31, 32));
    emit(code, arm64.mul_x(10, 10, 9));
    emit(code, arm64.add_x(0, 0, 10));
    emit(code, arm64.ldr_x(2, 31, 24));
    emit(code, arm64.mul_x(2, 2, 9));
    arm64.assembler_bl(code, "runtime_array_move");
    emit(code, arm64.ldr_x(12, 31, 8));
    emit(code, arm64.ldr_x(9, 31, 24));
    emit(code, arm64.ldr_x(10, 31, 32));
    emit(code, arm64.add_x(9, 9, 10));
    emit(code, arm64.str_x(9, 12, 8));
    arm64.assembler_label(code, "runtime_array_append_done");
    emit(code, arm64.ldr_x(30, 31, 0));
    emit(code, arm64.add_imm_x(31, 31, 48, iie));
    emit(code, arm64.ret());
    arm64.assembler_label(code, "runtime_array_push");
    emit(code, arm64.sub_imm_x(31, 31, 32, iie));
    emit(code, arm64.str_x(30, 31, 0));
    emit(code, arm64.str_x(0, 31, 8));
    emit(code, arm64.str_x(1, 31, 16));
    move_bits(code, 1, uint32(0), uint32(1));
    arm64.assembler_bl(code, "runtime_array_reserve");
    emit(code, arm64.ldr_x(12, 31, 8));
    emit(code, arm64.ldr_x(9, 31, 16));
    emit(code, arm64.ldr_x(10, 12, 8));
    emit(code, arm64.ldr_x(11, 12, 40));
    emit(code, arm64.add_imm_x(11, 11, 32, iie));
    emit(code, arm64.ldr_x(13, 12, 0));
    emit(code, arm64.lsr_x(13, 13, 8));
    move_bits(code, 14, uint32(0), uint32(255));
    emit(code, arm64.and_x(13, 13, 14));
    emit(code, arm64.cmp_imm_x(13, 1, iie));
    arm64.assembler_b_cond(code, 0, "runtime_array_push_byte");
    emit(code, arm64.lsl_x(14, 10, 3));
    emit(code, arm64.add_x(11, 11, 14));
    emit(code, arm64.str_x(9, 11, 0));
    arm64.assembler_b(code, "runtime_array_push_commit");
    arm64.assembler_label(code, "runtime_array_push_byte");
    emit(code, arm64.add_x(11, 11, 10));
    emit(code, arm64.strb_w(9, 11, 0));
    arm64.assembler_label(code, "runtime_array_push_commit");
    emit(code, arm64.add_imm_x(10, 10, 1, iie));
    emit(code, arm64.str_x(10, 12, 8));
    emit(code, arm64.ldr_x(30, 31, 0));
    emit(code, arm64.add_imm_x(31, 31, 32, iie));
    emit(code, arm64.ret());
    arm64.assembler_label(code, "runtime_array_truncate");
    arm64.assembler_cbz_x(code, 0, "runtime_error");
    emit(code, arm64.ldr_x(9, 0, 8));
    emit(code, arm64.cmp_x(1, 9));
    arm64.assembler_b_cond(code, 8, "runtime_error");
    emit(code, arm64.str_x(1, 0, 8));
    emit(code, arm64.ldr_x(10, 0, 0));
    emit(code, arm64.lsr_x(10, 10, 8));
    move_bits(code, 11, uint32(0), uint32(255));
    emit(code, arm64.and_x(10, 10, 11));
    emit(code, arm64.sub_x(2, 9, 1));
    emit(code, arm64.mul_x(2, 2, 10));
    emit(code, arm64.mul_x(1, 1, 10));
    emit(code, arm64.ldr_x(11, 0, 40));
    emit(code, arm64.add_imm_x(11, 11, 32, iie));
    emit(code, arm64.add_x(11, 11, 1));
    arm64.assembler_label(code, "runtime_array_truncate_clear");
    arm64.assembler_cbz_x(code, 2, "runtime_array_truncate_done");
    emit(code, arm64.strb_w(31, 11, 0));
    emit(code, arm64.add_imm_x(11, 11, 1, iie));
    emit(code, arm64.sub_imm_x(2, 2, 1, iie));
    arm64.assembler_b(code, "runtime_array_truncate_clear");
    arm64.assembler_label(code, "runtime_array_truncate_done");
    emit(code, arm64.ret());
}

waza emit_managed_runtime(code: arm64.Assembler, gc_stress: bool) -> unit {
    emit_runtime_alloc(code, gc_stress);
    emit_runtime_collect(code);
    emit_runtime_mark(code);
    emit_array_runtime(code);
    emit_utf8_runtime(code);
}

koukai waza compile(file: mochi.File) -> LowerResult { kaesu compile_impl(file, iie, runtime_default_heap_bytes); }

// Verification mode uses the identical allocator and object protocol, collecting
// at every allocation entry in addition to the ordinary bounded-heap retry.
koukai waza compile_gc_stress(file: mochi.File) -> LowerResult { kaesu compile_impl(file, hai, runtime_default_heap_bytes); }

// Explicit bounded target capacity; does not change the seed builder's heap.
koukai waza compile_with_heap(file: mochi.File, capacity: int64, gc_stress: bool) -> LowerResult {
    kaesu compile_impl(file, gc_stress, capacity);
}

waza compile_impl(file: mochi.File, gc_stress: bool, capacity: int64) -> LowerResult {
    moshi (capacity < 64 || capacity > runtime_max_heap_bytes || capacity - (capacity / 16) * 16 != 0) { kaesu failed(LowerError.InvalidOperand(1)); }
    moshi (file.version < 1 || file.version > 14 || file.global_count < 0 || file.global_count > 2048) { kaesu failed(LowerError.InvalidOperand(1)); }
    kaku type_result = types.analyze_types(file);
    moshi (type_result.error_detail != 0) { kaesu failed(LowerError.UnsafeType(type_result.error_detail)); }
    kaku ids = string_ids(file.constants);
    kaku code = arm64.assembler();
    kaku patches: []macho.AddressPatch = [];
    array.reserve(patches, file.global_count * 2);
    kaku native_fs = file_uses_nativefs(file);
    emit_main_prologue(code);
    moshi (native_fs) { emit(code, arm64.movz_x(27, 0, 0)); }
    kaku has_constants = iie;
    kaku constant_index = 0;
    aida (constant_index < len(file.constants)) {
        moshi (file.constants[constant_index].tag == uint8(2)) { has_constants = hai; }
        constant_index = constant_index + 1;
    }
    moshi (has_constants || native_fs) {
        kaku constant_at = len(code.words);
        emit(code, arm64.Instruction { word: uint32(0), error: mu }); emit(code, arm64.Instruction { word: uint32(0), error: mu });
        array.push(patches, macho.AddressPatch { at_word: constant_at, add_at_word: constant_at + 1,
            target: macho.const_target(), target_offset: 0, register: 28 });
    }
    kaku managed = file_uses_heap(file);
    moshi (managed) {
        emit_runtime_init(code, capacity);
    }
    kaku problem = emit_block(code, patches, file, type_result, ids, file.instructions, "main_", -1);
    moshi (problem != mu) { kaesu failed(problem); }
    arm64.assembler_cbz_x(code, 26, "normal_exit"); move_x(code, 0, 25); arm64.assembler_bl(code, "print_int64");
    arm64.assembler_label(code, "normal_exit");
    moshi (native_fs) { arm64.assembler_bl(code, "nativefs_cleanup"); }
    emit(code, arm64.movz_x(0, 0, 0)); emit(code, arm64.movz_x(16, 1, 0)); emit(code, arm64.svc(128));
    arm64.assembler_label(code, "runtime_error");
    emit(code, arm64.movz_x(0, 1, 0)); emit(code, arm64.movz_x(16, 1, 0)); emit(code, arm64.svc(128));
    arm64.assembler_label(code, "runtime_oom");
    emit(code, arm64.movz_x(0, 2, 0)); emit(code, arm64.movz_x(16, 1, 0)); emit(code, arm64.svc(128));
    arm64.assembler_label(code, "runtime_gc_bad_type");
    emit(code, arm64.movz_x(0, 3, 0)); emit(code, arm64.movz_x(16, 1, 0)); emit(code, arm64.svc(128));
    arm64.assembler_label(code, "runtime_gc_bad_kind");
    emit(code, arm64.movz_x(0, 4, 0)); emit(code, arm64.movz_x(16, 1, 0)); emit(code, arm64.svc(128));
    arm64.assembler_label(code, "runtime_gc_bad_count");
    emit(code, arm64.movz_x(0, 5, 0)); emit(code, arm64.movz_x(16, 1, 0)); emit(code, arm64.svc(128));

    kaku function_reachable = types.reachable_functions(file);
    kaku id = 0;
    aida (id < len(file.functions)) {
        kaku function = file.functions[id];
        moshi (function.id != id) { kaesu failed(LowerError.UnsupportedClosure()); }
        kaku native_op = nativefs.operation(function.name);
        moshi (len(function.instructions) == 0 && native_op == nativefs.op_none) { kaesu failed(LowerError.UnsupportedNative((id + 1) * 1000000)); }
        arm64.assembler_label(code, function_label(id));
        moshi (!function_reachable[id]) { arm64.assembler_b(code, "runtime_error"); }
        sore {
            problem = emit_function_prologue(code, function); moshi (problem != mu) { kaesu failed(problem); }
            moshi (native_op != nativefs.op_none) {
                moshi (!emit_native_body(code, function, native_op)) { kaesu failed(LowerError.UnsupportedNative((id + 1) * 1000000)); }
            }
            sore {
                problem = emit_block(code, patches, file, type_result, ids, function.instructions, string.concat(function_label(id), "_"), id);
                moshi (problem != mu) { kaesu failed(problem); }
            }
            emit_function_epilogue(code, id);
        }
        id = id + 1;
    }
    emit_print_int64(code);
    emit_print_bool_nil(code);
    emit_print_string(code);
    moshi (managed) { emit_managed_runtime(code, gc_stress); }
    moshi (native_fs) { nativefs.emit_runtime(code, empty_string_id(file.constants, ids) * 2 + 1); }
    kaku pi = 0;
    aida (pi < len(patches)) {
        kaku patch = patches[pi];
        moshi (patch.target_offset < 0) {
            kaku target = arm64.assembler_label_word(code, function_label(-patch.target_offset - 1));
            moshi (target < 0) { kaesu failed(LowerError.InvalidFunction()); }
            patches[pi] = macho.AddressPatch { at_word: patch.at_word, add_at_word: patch.add_at_word, target: patch.target, target_offset: target * 4, register: patch.register };
        }
        pi = pi + 1;
    }
    kaku assembled = arm64.assembler_assemble(code);
    moshi (assembled.error != mu) {
        // All conditional fixups already own two words. Diagnose the actual
        // remaining transfer (B/BL, or the B in a long conditional sequence).
        moshi (len(code.errors) == 0) {
            kaku i = 0;
            aida (i < len(code.fixups)) {
                kaku fix = code.fixups[i]; kaku target = arm64.assembler_label_word(code, fix.target);
                kaku delta = target - fix.at_word;
                moshi (fix.kind >= 2 && (delta < -262144 || delta > 262143) && !(fix.kind == 2 && fix.operand >= 14)) { delta = delta - 1; }
                moshi (target >= 0 && (delta < -33554432 || delta > 33554431)) {
                    kaesu failed(LowerError.BranchOutOfRange(fix.at_word));
                }
                i = i + 1;
            }
        }
        kaesu failed(LowerError.EncodeFailure());
    }
    kaku data_words = file.global_count;
    kaesu LowerResult { words: assembled.words, constants: constant_image(file.constants, ids, native_fs), patches: patches, globals: data_words, error: mu };
}
