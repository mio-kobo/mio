    emit(code, arm64.movz_x(2, 1, 0)); emit(code, arm64.movz_x(5, 0, 0));
    emit(code, arm64.cmp_imm_x(0, 0, iie)); arm64.assembler_b_cond(code, 10, "print_positive");
    emit(code, arm64.movz_x(5, 1, 0)); emit(code, arm64.sub_x(0, 31, 0));
    arm64.assembler_label(code, "print_positive"); emit(code, arm64.movz_x(6, 10, 0));
    arm64.assembler_label(code, "print_digit");
    emit(code, arm64.udiv_x(3, 0, 6)); emit(code, arm64.msub_x(4, 3, 6, 0));
    emit(code, arm64.add_imm_w(4, 4, 48)); emit(code, arm64.sub_imm_x(1, 1, 1, iie));
    emit(code, arm64.strb_w(4, 1, 0)); emit(code, arm64.add_imm_x(2, 2, 1, iie));
    move_x(code, 0, 3); arm64.assembler_cbnz_x(code, 0, "print_digit");
    arm64.assembler_cbz_x(code, 5, "print_write");
    emit(code, arm64.sub_imm_x(1, 1, 1, iie)); emit(code, arm64.movz_w(4, 45));
    emit(code, arm64.strb_w(4, 1, 0)); emit(code, arm64.add_imm_x(2, 2, 1, iie));
    arm64.assembler_label(code, "print_write");
    emit(code, arm64.movz_x(0, 1, 0)); emit(code, arm64.movz_x(16, 4, 0)); emit(code, arm64.svc(128));
    emit(code, arm64.add_imm_x(31, 31, 32, iie)); emit(code, arm64.ret());
}

