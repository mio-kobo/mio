yobu "kiso/aot/arm64";
yobu "kiso/convert";
yobu "kiso/string";

// Linux AArch64 reactor (group M): epoll backend of the mio/sys/socket reactor primitives, emitted when the lowering targets Linux
// (abi 1). These routines call the Linux kernel directly (`svc #0`, number in x8, negative errno in x0), unlike the rest of the
// NativeFS code, which speaks Darwin numbers to the linux_syscall adapter: epoll has no Darwin counterpart. A failure is converted to
// the Darwin errno the shared classifier expects with the adapter's lx_errno. Linux AArch64 numbers: eventfd2 19, epoll_create1 20,
// epoll_ctl 21, epoll_pwait 22, read 63, write 64. Unlike x86-64, struct epoll_event is not packed here: events (u32) at 0, data (u64) at 8.
// Level-triggered, the same contract as the x86-64 and kqueue backends: wake-up through an eventfd registered with the epoll instance.

waza lrx(code: arm64.Assembler, value: arm64.Instruction) -> unit { emit(code, value); }
waza lrb(code: arm64.Assembler, target: string) -> unit { arm64.assembler_b(code, target); }
waza lrc(code: arm64.Assembler, condition: int64, target: string) -> unit { arm64.assembler_b_cond(code, condition, target); }
waza lrz(code: arm64.Assembler, reg: int64, target: string) -> unit { arm64.assembler_cbz_x(code, reg, target); }
waza lrnz(code: arm64.Assembler, reg: int64, target: string) -> unit { arm64.assembler_cbnz_x(code, reg, target); }
waza lrl(code: arm64.Assembler, target: string) -> unit { arm64.assembler_bl(code, target); }
waza lrlabel(code: arm64.Assembler, name: string) -> unit { arm64.assembler_label(code, name); }

// After `svc #0`: a non-negative x0 continues at `ok`; a negative errno becomes the positive Darwin errno in x0 and continues at `error`.
waza linux_result(code: arm64.Assembler, ok: string, error: string) -> unit {
    lrx(code, arm64.cmp_imm_x(0, 0, iie)); lrc(code, 10, ok);
    lrx(code, arm64.sub_x(0, 31, 0)); lrl(code, "lx_errno"); lrb(code, error);
}

waza lookup_fd_linux(code: arm64.Assembler, closed: string) -> unit {
    lrx(code, arm64.movz_x(1, 3, 0)); lrl(code, "nativefs_handle_lookup"); lrz(code, 0, closed);
    lrx(code, arm64.ldr_x(9, 0, 0)); lrx(code, arm64.cmp_imm_x(9, 0, iie)); lrc(code, 11, closed);
}

koukai waza emit_reactor_runtime_linux(code: arm64.Assembler, empty: int64) -> unit {
    // ---- reactor_open(kind x0): 0 epoll_create1(EPOLL_CLOEXEC), 1 eventfd2(0, EFD_CLOEXEC | EFD_NONBLOCK); anything else is invalid.
    lrlabel(code, "native_reactor_open"); enter(code); lrx(code, arm64.sub_imm_x(31, 31, 32, iie));
    lrx(code, arm64.cmp_imm_x(0, 1, iie)); lrc(code, 8, "native_reactor_open_invalid");
    lrz(code, 0, "native_reactor_open_epoll");
    lrx(code, arm64.movz_x(0, 0, 0)); bits(code, 1, 526336); lrx(code, arm64.movz_x(8, 19, 0)); lrx(code, arm64.svc(0)); lrb(code, "native_reactor_open_result");
    lrlabel(code, "native_reactor_open_epoll"); bits(code, 0, 524288); lrx(code, arm64.movz_x(8, 20, 0)); lrx(code, arm64.svc(0));
    lrlabel(code, "native_reactor_open_result"); linux_result(code, "native_reactor_open_good", "native_reactor_open_error");
    lrlabel(code, "native_reactor_open_good"); mov(code, 1, 0); lrx(code, arm64.movz_x(2, 0, 0)); lrb(code, "native_reactor_open_alloc");
    lrlabel(code, "native_reactor_open_error"); mov(code, 2, 0); lrx(code, arm64.movn_x(1, 0, 0)); lrb(code, "native_reactor_open_alloc");
    lrlabel(code, "native_reactor_open_invalid"); lrx(code, arm64.movz_x(2, 22, 0)); lrx(code, arm64.movn_x(1, 0, 0));
    lrlabel(code, "native_reactor_open_alloc"); lrx(code, arm64.str_x(1, 31, 8)); lrx(code, arm64.movz_x(0, 3, 0)); lrl(code, "nativefs_handle_alloc");
    lrx(code, arm64.str_x(0, 31, 0)); lrnz(code, 0, "native_reactor_open_done");
    lrx(code, arm64.ldr_x(0, 31, 8)); lrx(code, arm64.cmp_imm_x(0, 0, iie)); lrc(code, 11, "native_reactor_open_done"); lrx(code, arm64.movz_x(16, 6, 0)); lrx(code, arm64.svc(128));
    lrlabel(code, "native_reactor_open_done"); lrx(code, arm64.ldr_x(0, 31, 0)); leave(code);

    // ---- reactor_ctl(reactor x0, target x1, packed x2 = op | interest << 8 | token << 16, status x3): epoll_ctl add 1 / delete 2 / modify 3
    // (the kernel's own numbers); interest bit 0 EPOLLIN, bit 1 EPOLLOUT.
    lrlabel(code, "native_reactor_ctl"); enter(code); lrx(code, arm64.sub_imm_x(31, 31, 80, iie));
    lrx(code, arm64.str_x(3, 31, 0)); lrx(code, arm64.str_x(2, 31, 8)); lrx(code, arm64.str_x(1, 31, 16));
    lookup_fd_linux(code, "native_reactor_ctl_closed"); lrx(code, arm64.str_x(9, 31, 24));
    lrx(code, arm64.ldr_x(0, 31, 16)); lookup_fd_linux(code, "native_reactor_ctl_closed"); lrx(code, arm64.str_x(9, 31, 32));
    lrx(code, arm64.ldr_x(9, 31, 8)); lrx(code, arm64.cmp_imm_x(9, 0, iie)); lrc(code, 11, "native_reactor_ctl_invalid");
    bits(code, 11, 255); lrx(code, arm64.and_x(10, 9, 11)); lrx(code, arm64.sub_imm_x(12, 10, 1, iie)); lrx(code, arm64.cmp_imm_x(12, 2, iie)); lrc(code, 8, "native_reactor_ctl_invalid");
    lrx(code, arm64.str_x(10, 31, 40));
    lrx(code, arm64.lsr_x(12, 9, 8)); lrx(code, arm64.and_x(12, 12, 11)); lrx(code, arm64.cmp_imm_x(12, 3, iie)); lrc(code, 8, "native_reactor_ctl_invalid");
    lrx(code, arm64.movz_x(13, 1, 0)); lrx(code, arm64.and_x(14, 12, 13)); lrx(code, arm64.movz_x(15, 2, 0)); lrx(code, arm64.and_x(15, 12, 15)); lrx(code, arm64.lsl_x(15, 15, 1)); lrx(code, arm64.add_x(14, 14, 15));
    lrx(code, arm64.str_x(14, 31, 48)); lrx(code, arm64.lsr_x(13, 9, 16)); lrx(code, arm64.str_x(13, 31, 56));
    lrx(code, arm64.ldr_x(0, 31, 24)); lrx(code, arm64.ldr_x(1, 31, 40)); lrx(code, arm64.ldr_x(2, 31, 32)); lrx(code, arm64.add_imm_x(3, 31, 48, iie));
    lrx(code, arm64.movz_x(8, 21, 0)); lrx(code, arm64.svc(0)); linux_result(code, "native_reactor_ctl_ok", "native_reactor_ctl_status");
    lrlabel(code, "native_reactor_ctl_ok"); lrx(code, arm64.movz_x(0, 0, 0)); lrb(code, "native_reactor_ctl_status");
    lrlabel(code, "native_reactor_ctl_closed"); lrx(code, arm64.movz_x(0, 9, 0)); lrb(code, "native_reactor_ctl_status");
    lrlabel(code, "native_reactor_ctl_invalid"); lrx(code, arm64.movz_x(0, 22, 0));
    lrlabel(code, "native_reactor_ctl_status"); socket_status_return(code, 0, empty);

    // ---- reactor_wait(reactor x0, events x1, max x2 (1..64), timeout_ms x3, status x4): epoll_pwait, then each kernel event
    // (u32 events at 0, u64 data at 8) becomes a 16-byte (token, mask) record; EINTR reports zero events.
    // Frame: 0..63 locals, 64 count, 128.. kernel buffer (64 * 16 bytes).
    lrlabel(code, "native_reactor_wait"); enter(code); lrx(code, arm64.sub_imm_x(31, 31, 1184, iie));
    lrx(code, arm64.str_x(1, 31, 0)); lrx(code, arm64.str_x(2, 31, 8)); lrx(code, arm64.str_x(3, 31, 16)); lrx(code, arm64.str_x(4, 31, 24));
    lookup_fd_linux(code, "native_reactor_wait_closed"); lrx(code, arm64.str_x(9, 31, 32));
    lrx(code, arm64.ldr_x(9, 31, 8)); lrx(code, arm64.sub_imm_x(10, 9, 1, iie)); lrx(code, arm64.cmp_imm_x(10, 63, iie)); lrc(code, 8, "native_reactor_wait_invalid");
    lrx(code, arm64.ldr_x(9, 31, 16)); lrx(code, arm64.add_imm_x(10, 9, 1, iie)); lrx(code, arm64.cmp_imm_x(10, 0, iie)); lrc(code, 11, "native_reactor_wait_invalid");
    bits(code, 11, 2147483647); lrx(code, arm64.cmp_x(9, 11)); lrc(code, 12, "native_reactor_wait_invalid");
    lrx(code, arm64.ldr_x(0, 31, 0)); lrz(code, 0, "native_reactor_wait_invalid"); lrl(code, "nativefs_array_ptr"); lrx(code, arm64.str_x(0, 31, 40));
    lrx(code, arm64.ldr_x(10, 31, 8)); lrx(code, arm64.lsl_x(10, 10, 4)); lrx(code, arm64.cmp_x(1, 10)); lrc(code, 3, "native_reactor_wait_invalid");
    lrx(code, arm64.ldr_x(0, 31, 32)); lrx(code, arm64.add_imm_x(1, 31, 128, iie)); lrx(code, arm64.ldr_x(2, 31, 8)); lrx(code, arm64.ldr_x(3, 31, 16));
    lrx(code, arm64.movz_x(4, 0, 0)); lrx(code, arm64.movz_x(5, 8, 0)); lrx(code, arm64.movz_x(8, 22, 0)); lrx(code, arm64.svc(0));
    lrx(code, arm64.cmp_imm_x(0, 0, iie)); lrc(code, 11, "native_reactor_wait_failed");
    lrx(code, arm64.str_x(0, 31, 64)); lrx(code, arm64.ldr_x(9, 31, 40)); lrx(code, arm64.movz_x(10, 0, 0)); lrx(code, arm64.add_imm_x(11, 31, 128, iie));
    lrlabel(code, "native_reactor_wait_copy");
    lrx(code, arm64.ldr_x(12, 31, 64)); lrx(code, arm64.cmp_x(10, 12)); lrc(code, 2, "native_reactor_wait_copied");
    lrx(code, arm64.ldr_x(13, 11, 8)); lrx(code, arm64.str_x(13, 9, 0)); lrx(code, arm64.ldr_w(14, 11, 0)); lrx(code, arm64.movz_x(13, 0, 0));
    lrx(code, arm64.movz_x(12, 1, 0)); lrx(code, arm64.and_x(12, 12, 14)); lrx(code, arm64.add_x(13, 13, 12));
    lrx(code, arm64.movz_x(12, 4, 0)); lrx(code, arm64.and_x(12, 12, 14)); lrx(code, arm64.lsr_x(12, 12, 1)); lrx(code, arm64.add_x(13, 13, 12));
    lrx(code, arm64.movz_x(12, 8, 0)); lrx(code, arm64.and_x(12, 12, 14)); lrx(code, arm64.lsr_x(12, 12, 1)); lrx(code, arm64.add_x(13, 13, 12));
    lrx(code, arm64.movz_x(12, 16, 0)); lrx(code, arm64.and_x(12, 12, 14)); lrx(code, arm64.lsr_x(12, 12, 1)); lrx(code, arm64.add_x(13, 13, 12));
    lrx(code, arm64.str_x(13, 9, 8)); lrx(code, arm64.add_imm_x(9, 9, 16, iie)); lrx(code, arm64.add_imm_x(11, 11, 16, iie)); lrx(code, arm64.add_imm_x(10, 10, 1, iie)); lrb(code, "native_reactor_wait_copy");
    lrlabel(code, "native_reactor_wait_copied");
    lrx(code, arm64.ldr_x(9, 31, 64)); lrx(code, arm64.movz_x(10, 0, 0)); lrx(code, arm64.movz_x(11, 0, 0)); lrb(code, "native_reactor_wait_status");
    lrlabel(code, "native_reactor_wait_failed");
    lrx(code, arm64.sub_x(0, 31, 0)); lrx(code, arm64.cmp_imm_x(0, 4, iie)); lrc(code, 0, "native_reactor_wait_interrupted"); lrl(code, "lx_errno"); mov(code, 11, 0);
    lrx(code, arm64.movz_x(9, 0, 0)); lrx(code, arm64.movz_x(10, 0, 0)); lrb(code, "native_reactor_wait_status");
    lrlabel(code, "native_reactor_wait_interrupted"); lrx(code, arm64.movz_x(9, 0, 0)); lrx(code, arm64.movz_x(10, 0, 0)); lrx(code, arm64.movz_x(11, 0, 0)); lrb(code, "native_reactor_wait_status");
    lrlabel(code, "native_reactor_wait_closed"); lrx(code, arm64.movz_x(9, 0, 0)); lrx(code, arm64.movz_x(10, 0, 0)); lrx(code, arm64.movz_x(11, 9, 0)); lrb(code, "native_reactor_wait_status");
    lrlabel(code, "native_reactor_wait_invalid"); lrx(code, arm64.movz_x(9, 0, 0)); lrx(code, arm64.movz_x(10, 0, 0)); lrx(code, arm64.movz_x(11, 22, 0));
    lrlabel(code, "native_reactor_wait_status");
    lrx(code, arm64.ldr_x(12, 31, 24)); lrx(code, arm64.ldr_x(13, 12, 8)); lrx(code, arm64.cmp_imm_x(13, 10, iie)); lrc(code, 3, "native_reactor_wait_return");
    lrx(code, arm64.ldr_x(12, 12, 40)); lrx(code, arm64.add_imm_x(12, 12, 32, iie)); lrx(code, arm64.str_x(9, 12, 0)); lrx(code, arm64.add_imm_x(13, 12, 8, iie)); lrx(code, arm64.strb_w(10, 13, 0));
    mov(code, 0, 11); lrx(code, arm64.movz_x(1, 0, 0)); lrl(code, "native_socket_classify"); lrx(code, arm64.add_imm_x(13, 12, 9, iie)); lrx(code, arm64.strb_w(0, 13, 0));
    lrlabel(code, "native_reactor_wait_return"); empty_return(code, empty);

    // ---- reactor_signal / reactor_ack(eventfd x0, status x1): write / read eight bytes. EAGAIN (-11) is success: the counter is
    // already signalled / nothing is pending.
    kaku which = 0;
    aida (which < 2) {
        kaku name = "native_reactor_signal"; kaku number = 64;
        moshi (which == 1) { name = "native_reactor_ack"; number = 63; }
        lrlabel(code, name); enter(code); lrx(code, arm64.sub_imm_x(31, 31, 48, iie));
        lrx(code, arm64.str_x(1, 31, 0)); lookup_fd_linux(code, string.concat(name, "_closed"));
        lrx(code, arm64.movz_x(10, 1, 0)); lrx(code, arm64.str_x(10, 31, 16));
        mov(code, 0, 9); lrx(code, arm64.add_imm_x(1, 31, 16, iie)); lrx(code, arm64.movz_x(2, 8, 0)); lrx(code, arm64.movz_x(8, number, 0)); lrx(code, arm64.svc(0));
        lrx(code, arm64.cmp_imm_x(0, 0, iie)); lrc(code, 10, string.concat(name, "_ok"));
        lrx(code, arm64.sub_x(0, 31, 0)); lrx(code, arm64.cmp_imm_x(0, 11, iie)); lrc(code, 0, string.concat(name, "_ok"));
        lrx(code, arm64.cmp_imm_x(0, 4, iie)); lrc(code, 0, string.concat(name, "_ok"));
        lrl(code, "lx_errno"); lrb(code, string.concat(name, "_status"));
        lrlabel(code, string.concat(name, "_ok")); lrx(code, arm64.movz_x(0, 0, 0)); lrb(code, string.concat(name, "_status"));
        lrlabel(code, string.concat(name, "_closed")); lrx(code, arm64.movz_x(0, 9, 0));
        lrlabel(code, string.concat(name, "_status")); socket_status_return(code, 0, empty);
        which = which + 1;
    }
}
