    emit(c,arm64.ldr_x(7,26,gc.thread_imports));arm64.assembler_bl(c,"attached_platform_now");emit(c,arm64.str_x(0,26,8656));
    emit(c,arm64.ldr_x(23,26,568));emit(c,arm64.ldr_x(28,26,8640));emit(c,arm64.add_imm_x(24,26,544,iie));emit(c,arm64.movz_x(22,0,0));emit(c,arm64.movz_x(27,0,0));
    emit(c,arm64.ldr_x(9,26,gc.thread_user));emit(c,arm64.ldr_x(25,9,40));emit(c,arm64.ldr_x(16,9,32));emit(c,arm64.blr_x(16));
    // an entry that returns nothing leaves garbage in x0: publish 0 for it, the returned integer otherwise
    emit(c,arm64.ldr_x(9,26,gc.thread_user));emit(c,arm64.ldr_x(10,9,24));arm64.assembler_cbnz_x(c,10,"worker_result_keep");emit(c,arm64.movz_x(0,0,0));arm64.assembler_label(c,"worker_result_keep");emit(c,arm64.str_x(0,26,wr_result));
    move_x(c,0,26);move_x(c,1,24);emit(c,arm64.ldr_x(7,26,gc.thread_imports));wr_call(c,"gc_mutator_poll");
    moshi(arm64.assembler_label_word(c,"nativefs_cleanup")>=0){arm64.assembler_bl(c,"nativefs_cleanup");}
    emit(c,arm64.ldr_x(7,26,gc.thread_imports));arm64.assembler_bl(c,"attached_platform_now");emit(c,arm64.str_x(0,26,8664));
    move_x(c,0,26);wr_call(c,"thread_leave");
    emit(c,arm64.str_x(31,26,560));emit(c,arm64.str_x(31,26,gc.thread_user));emit(c,arm64.movz_x(0,0,0));stw_bridge_leave(c);
