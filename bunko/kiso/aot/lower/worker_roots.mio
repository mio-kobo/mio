// Darwin/AArch64 implementation of the portable managed-mutator protocol.
// The internal bridge has two joinable worker slots and a shared process key.
// Each slot owns native context/opaque locks/bootstrap root/snapshot storage.
// The bridge owns one context per concurrently live worker (plus the main thread's): `worker_slots` of them, 8800 bytes each. A start with
// every slot in use is a runtime error (never a silent wait); the public thread API will turn that into an explicit error value.
koukai teisu worker_slots=128;
koukai teisu word_blocks=16384;
// Off-heap control words for channels: a pool of word_blocks blocks of 8 words after the thread contexts. Word 0 of the pool counts issued
// blocks; block h (a handle, 1..word_blocks) starts at word 8*h. Blocks are never reused (a channel's control block stays valid for the life of
// the process, so a thread still inside send/receive or using an old Channel alias can never touch recycled memory).
// Exhaustion is permanent for that process: words_new returns -12 without issuing a handle or modifying any block.
// Words per thread context: the fixed records, then (from wr_snapshot) the collector's root snapshot of wr_snapshot_capacity entries.
teisu wr_ctx_words=5200;
koukai teisu worker_root_words=(worker_slots+1)*wr_ctx_words+4+(word_blocks+1)*8;
teisu wr_stride=41600;
// Context word at +8800: the integer a worker entry returned (0 for an entry that returns nothing); join hands it to the caller.
teisu wr_result=8800;
// Context word at +8808: zero when free, -1 during start or join, otherwise the exact joinable handle.
teisu wr_claim=8808;
// Context word at +8816: generation of the slot (counts joins; part of the handle). Word at +8824: status of this thread's last join (0 or 22).
teisu wr_generation=8816;
teisu wr_join_status=8824;
teisu wr_snapshot=9000;
// 4000 roots: with 128 live threads the stopped-world snapshot needs several dozen per thread (1000 overflowed: gc_scan_roots failed).
teisu wr_snapshot_capacity=4000;
// Diagnostic counters of an observed build (label worker_observe, mio build --observe), kept in the TAIL of each thread context. Layout audit: the
// snapshot header and entries end at wr_snapshot+16+8*wr_snapshot_capacity = 41016 (gc_snapshot_root refuses an entry past the capacity) and the stride
// is 41600, so bytes 41016..41599 of every context are referenced by no routine; contexts are zero-initialized global data that nothing clears or
// reuses as a whole, so a slot's counters accumulate over the threads that used it. 3 kinds x 11 words + 1 word = 272 bytes from wr_obs. A normal
// build never reads or writes these bytes and its image is byte-identical to one built before this code existed.
//   kind 0 = gc_heap_enter (epoch acquisition), 1 = gc_mutator_poll (release / park), 2 = gc_block_leave (return from a blocking native)
//   per kind: 9 buckets of elapsed nanoseconds [<1us, <4us, <16us, <64us, <256us, <1ms, <4ms, <16ms, >=16ms], then the sum and the maximum in ns.
teisu wr_obs=41032;
teisu wr_obs_kind=88;
teisu wr_obs_retained=264;
// Allocation lock (docs/darwin-thread-heap-exclusion-design.md section 11). The lock word lives in the zero-initialized tail of the main thread's
// context (context 0, nothing else uses bytes 41304..41599). Observed builds also count, per thread context: allocations served by the lock fast path,
// allocations that took the Epoch path, and attempts that exhausted the contention budget.
// The last two counters track blocked wait rounds and requests that entered the wait path at least once.
teisu wr_alloc_lock=41440;
teisu wr_obs_alloc=41304;
teisu wr_alloc_spin=256;
teisu wr_alloc_wait_rounds=64;
teisu wr_alloc_wait_us=1000;
teisu wr_alloc_locked=1;
teisu wr_alloc_waiting=2;
// Darwin raw UNIX syscall errno values (carry set on error).
teisu wr_ulock_enoent=2;
teisu wr_ulock_eintr=4;
teisu wr_ulock_etimedout=60;
teisu wr_obs_wait_guard=41488; // first word after the allocation-lock stress fields
teisu wr_obs_wait_preflight=41496;
teisu wr_alloc_wait_disabled=41504; // main context, monotonic after a hard syscall error
teisu wr_wait_test_arm=41512;       // per-thread test command
teisu wr_wait_test_phase=41520;    // main context, test only
teisu wr_wait_test_ctx=41528;      // main context, test only
teisu wr_wait_test_gc_count=41536;
waza wr_wait_test(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,"worker_alloc_wait_test")>=0;}
waza wr_wait_owner_test(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,"worker_alloc_wait_owner_test")>=0;}
waza wr_wait_error_test(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,"worker_alloc_wait_error_test")>=0;}
waza wr_wait_park_test(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,"worker_alloc_wait_park_test")>=0;}
waza wr_main_word(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,dst:int64,offset:int64) -> unit {
    wr_ctx(c,p,first,dst,0);wr_addr(c,dst,dst,offset);
}
// Lock-stress words, all in context 0's tail and touched only while holding the lock: +8 epoch seen at entry, +16 attempt counter.
teisu wr_stress_period=4;
// Largest request served by the lock fast path (the legacy allocator maps a large object at 128 KiB or more and the fast path never maps).
teisu wr_alloc_small=4095;
// Test-only lock-stress image (design doc section 12): label worker_alloc_lock_stress. Never present in a default image.
waza wr_lock_stress(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,"worker_alloc_lock_stress")>=0;}
// Detector-sensitivity control (MIO_ALLOC_LOCK_STRESS=violate): the image deliberately polls inside the locked region, which the real protocol forbids.
waza wr_lock_violate(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,"worker_alloc_lock_violate")>=0;}
waza wr_observed(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,"worker_observe")>=0;}
// Start of a timed runtime call: push the current time (attached_platform_now returns nanoseconds in x0).
waza wr_obs_begin(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {
    moshi(!wr_observed(c)){kaesu;}
    wr_imports(c,p,first);arm64.assembler_bl(c,"attached_platform_now");emit(c,arm64.sub_imm_x(31,31,16,iie));emit(c,arm64.str_x(0,31,0));
}
// End of a timed runtime call: elapsed time into the bucket, sum and maximum of this thread's context for `kind` (only this thread writes its context).
waza wr_obs_end(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,kind:int64) -> unit {
    moshi(!wr_observed(c)){kaesu;}
    wr_imports(c,p,first);arm64.assembler_bl(c,"attached_platform_now");emit(c,arm64.ldr_x(1,31,0));emit(c,arm64.sub_x(0,0,1));emit(c,arm64.str_x(0,31,0));
    wr_current(c,p,first);emit(c,arm64.ldr_x(2,31,0));emit(c,arm64.add_imm_x(31,31,16,iie));
    // x0 = context, x2 = elapsed ns. Bucket index in x3: the number of times 1000 * 4^k is <= elapsed (at most 8).
    emit(c,arm64.movz_x(3,0,0));wr_num(c,4,1000);
    kaku loop=block_label("wr_obs_bucket_",len(c.words));kaku done=string.concat(loop,"_done");
    arm64.assembler_label(c,loop);emit(c,arm64.cmp_x(2,4));arm64.assembler_b_cond(c,3,done);emit(c,arm64.add_imm_x(3,3,1,iie));emit(c,arm64.cmp_imm_x(3,8,iie));arm64.assembler_b_cond(c,0,done);emit(c,arm64.lsl_x(4,4,2));arm64.assembler_b(c,loop);
    arm64.assembler_label(c,done);
    wr_num(c,5,wr_obs+kind*wr_obs_kind);emit(c,arm64.add_x(5,0,5));
    emit(c,arm64.lsl_x(6,3,3));emit(c,arm64.add_x(6,5,6));emit(c,arm64.ldr_x(7,6,0));emit(c,arm64.add_imm_x(7,7,1,iie));emit(c,arm64.str_x(7,6,0));
    emit(c,arm64.ldr_x(7,5,72));emit(c,arm64.add_x(7,7,2));emit(c,arm64.str_x(7,5,72));
    kaku skip=block_label("wr_obs_max_",len(c.words));
    emit(c,arm64.ldr_x(7,5,80));emit(c,arm64.cmp_x(2,7));arm64.assembler_b_cond(c,9,skip);emit(c,arm64.str_x(2,5,80));arm64.assembler_label(c,skip);
}
waza worker_roots_enabled(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,"worker_roots_enabled")>=0;}
waza emit_print_boundary(c:arm64.Assembler) -> unit {
    moshi(worker_roots_enabled(c)){
        emit(c,arm64.sub_imm_x(31,31,16,iie));emit(c,arm64.str_x(30,31,0));arm64.assembler_bl(c,"attached_native_enter");
        emit(c,arm64.svc(128));arm64.assembler_bl(c,"attached_native_leave");emit(c,arm64.ldr_x(30,31,0));emit(c,arm64.add_imm_x(31,31,16,iie));
    } sore {emit(c,arm64.svc(128));}
}
waza wr_emit(c:arm64.Assembler,w:arm64.Instruction) -> unit {emit(c,w);}
waza wr_ctx(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,r:int64,slot:int64) -> unit {attached_data_address(c,p,first+worker_import_slots(c)+slot*wr_ctx_words,r);}
waza wr_pool(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,r:int64) -> unit {attached_data_address(c,p,first+worker_import_slots(c)+(worker_slots+1)*wr_ctx_words,r);}
waza wr_neg(c:arm64.Assembler,r:int64,n:int64) -> unit {wr_num(c,r,n);emit(c,arm64.sub_x(r,31,r));}
// Leaves the address of word x1 of block x0 in x13 or branches to bad. Clobbers x9-x13.
waza word_address(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,bad:string) -> unit {
    arm64.assembler_cbz_x(c,0,bad);wr_num(c,14,word_blocks);emit(c,arm64.cmp_x(0,14));arm64.assembler_b_cond(c,8,bad);
    emit(c,arm64.cmp_imm_x(1,8,iie));arm64.assembler_b_cond(c,2,bad);
    wr_pool(c,p,first,9);emit(c,arm64.ldr_x(10,9,0));emit(c,arm64.cmp_x(0,10));arm64.assembler_b_cond(c,8,bad);
    wr_num(c,12,8);emit(c,arm64.mul_x(11,0,12));emit(c,arm64.add_x(11,11,1));emit(c,arm64.mul_x(11,11,12));emit(c,arm64.add_x(13,9,11));
}
waza emit_word_natives(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {
    // words_new(n): n in 1..8
    arm64.assembler_label(c,"native_words_new");emit(c,arm64.cmp_imm_x(0,1,iie));arm64.assembler_b_cond(c,11,"native_word_bad");emit(c,arm64.cmp_imm_x(0,8,iie));arm64.assembler_b_cond(c,12,"native_word_bad");
    wr_pool(c,p,first,9);arm64.assembler_label(c,"native_words_new_retry");emit(c,arm64.ldxr_x(10,9,hai));wr_num(c,14,word_blocks);emit(c,arm64.cmp_x(10,14));arm64.assembler_b_cond(c,2,"native_words_full");
    emit(c,arm64.add_imm_x(11,10,1,iie));emit(c,arm64.stxr_x(12,11,9,hai));arm64.assembler_cbnz_x(c,12,"native_words_new_retry");emit(c,arm64.add_imm_x(0,10,1,iie));emit(c,arm64.ret());
    arm64.assembler_label(c,"native_words_full");emit(c,arm64.clrex());wr_neg(c,0,12);emit(c,arm64.ret());
    arm64.assembler_label(c,"native_word_bad");wr_neg(c,0,22);emit(c,arm64.ret());
    // words_free(h, n): blocks stay mapped for the life of the process
    arm64.assembler_label(c,"native_join_status");emit(c,arm64.sub_imm_x(31,31,16,iie));emit(c,arm64.str_x(30,31,0));arm64.assembler_bl(c,"attached_join_status");emit(c,arm64.ldr_x(30,31,0));emit(c,arm64.add_imm_x(31,31,16,iie));emit(c,arm64.ret());
    arm64.assembler_label(c,"native_words_free");emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ret());
    arm64.assembler_label(c,"native_word_get");
    moshi(wr_wait_park_test(c)){arm64.assembler_cbz_x(c,0,"runtime_alloc_test_command");}
    word_address(c,p,first,"native_word_bad");emit(c,arm64.ldar_x(0,13));emit(c,arm64.ret());
    arm64.assembler_label(c,"native_word_set");word_address(c,p,first,"native_word_bad");emit(c,arm64.stlr_x(2,13));emit(c,arm64.dmb_ish());emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ret());
    // word_cas(h, i, expected, new) -> the value found
    arm64.assembler_label(c,"native_word_cas");word_address(c,p,first,"native_word_bad");
    arm64.assembler_label(c,"native_word_cas_retry");emit(c,arm64.ldxr_x(14,13,hai));emit(c,arm64.cmp_x(14,2));arm64.assembler_b_cond(c,1,"native_word_cas_done");
    emit(c,arm64.stxr_x(15,3,13,hai));arm64.assembler_cbnz_x(c,15,"native_word_cas_retry");
    arm64.assembler_label(c,"native_word_cas_done");move_x(c,0,14);emit(c,arm64.dmb_ish());emit(c,arm64.ret());
    // word_add(h, i, delta) -> the value before
    arm64.assembler_label(c,"native_word_add");word_address(c,p,first,"native_word_bad");
    arm64.assembler_label(c,"native_word_add_retry");emit(c,arm64.ldxr_x(14,13,hai));emit(c,arm64.add_x(10,14,2));emit(c,arm64.stxr_x(15,10,13,hai));arm64.assembler_cbnz_x(c,15,"native_word_add_retry");
    move_x(c,0,14);emit(c,arm64.dmb_ish());emit(c,arm64.ret());
    // word_wake(h, i, n): waiters poll with a short timed sleep, so there is nothing to signal
    arm64.assembler_label(c,"native_word_wake");word_address(c,p,first,"native_word_bad");
    // ulock wake: one waiter for a count of 1 (a mutex hand-off), every waiter otherwise (flag 0x100, wake all). A wake with nobody waiting is a no-op.
    emit(c,arm64.cmp_imm_x(2,1,iie));arm64.assembler_b_cond(c,0,"native_word_wake_one");wr_num(c,0,261);arm64.assembler_b(c,"native_word_wake_go");
    arm64.assembler_label(c,"native_word_wake_one");wr_num(c,0,5);
    arm64.assembler_label(c,"native_word_wake_go");move_x(c,1,13);emit(c,arm64.movz_x(2,0,0));wr_num(c,16,516);emit(c,arm64.svc(128));emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ret());
    // word_wait(h, i, expected): returns once the word differs from expected, on a wake, or after at most 100 ms (callers re-check).
    arm64.assembler_label(c,"native_word_wait");word_address(c,p,first,"native_word_bad");
    emit(c,arm64.sub_imm_x(31,31,48,iie));emit(c,arm64.str_x(30,31,0));emit(c,arm64.str_x(0,31,8));emit(c,arm64.str_x(1,31,16));emit(c,arm64.str_x(2,31,24));
    // Short holds are the common case: spin a bounded number of reads (no safepoint, so a collector waiting for this thread's acknowledgement waits
    // for the whole spin) before sleeping. The budget is for this one call only; it never spans an epoch change and it is not the collector-park spin
    // that #113 removed. Measured on macOS 15 with 3 cores and 9 channel threads (run 43818508856, mpmc_long): 4000 reads put 43 % of all samples into
    // this loop, because with more runnable threads than cores the holder that must change the word is usually not running. 128 reads (about a
    // microsecond at most) still cover a hold by a running thread.
    wr_num(c,15,128);arm64.assembler_label(c,"native_word_wait_spin");emit(c,arm64.ldar_x(14,13));emit(c,arm64.cmp_x(14,2));arm64.assembler_b_cond(c,1,"native_word_wait_done");
    emit(c,arm64.sub_imm_x(15,15,1,iie));arm64.assembler_cbnz_x(c,15,"native_word_wait_spin");
    // Then block in the kernel on the word (ulock wait, 64-bit compare-and-wait) until a wake or 100 ms (a safety net: callers re-check the word).
    // The thread is in the blocked region for the whole wait, exactly like a blocking write: a stop-the-world collection does not wait for it and its
    // roots are already published; leaving the region parks it if a collection is running. This replaces the sleep-polling loop, whose shortest sleep
    // cost about 0.65 ms on macOS (a ping-pong round trip took 1.3 ms) and which needed a periodic wake-up per waiting thread.
    wr_num(c,0,5);move_x(c,1,13);emit(c,arm64.ldr_x(2,31,24));wr_num(c,3,100000);wr_num(c,16,515);
    arm64.assembler_bl(c,"attached_native_enter");emit(c,arm64.svc(128));arm64.assembler_bl(c,"attached_native_leave");
    arm64.assembler_label(c,"native_word_wait_done");emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ldr_x(30,31,0));emit(c,arm64.add_imm_x(31,31,48,iie));emit(c,arm64.ret());
}
waza wr_imports(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {attached_data_address(c,p,first,7);}
waza wr_num(c:arm64.Assembler,r:int64,n:int64) -> unit {move_bits(c,r,uint32(0),uint32(n));}
waza wr_current(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {
    wr_ctx(c,p,first,0,0);wr_imports(c,p,first);emit(c,arm64.ldr_x(0,0,gc.thread_key));aarch64.emit_import_call(c,7,5,28);arm64.assembler_cbz_x(c,0,"runtime_error");
    wr_ctx(c,p,first,9,0);emit(c,arm64.add_imm_x(9,9,400,iie));emit(c,arm64.ldr_x(10,0,gc.thread_registry));emit(c,arm64.cmp_x(9,10));arm64.assembler_b_cond(c,1,"runtime_error");
    emit(c,arm64.ldr_x(10,0,gc.thread_registered));arm64.assembler_cbz_x(c,10,"runtime_error");
    emit(c,arm64.add_imm_x(9,0,gc.thread_shadow,iie));emit(c,arm64.stlr_x(24,9));wr_imports(c,p,first);
}
// x9 = allocation lock. SWPL xzr,x10,[x9] is available on Darwin ARM64
// (FEAT_LSE). Clear the word and take its old value in one release operation.
// A waiter can change held -> waiting even while its mutator is parked.
waza wr_alloc_unlock(c:arm64.Assembler) -> unit {
    emit(c,arm64.swpl_x(31,10,9));
    emit(c,arm64.cmp_imm_x(10,wr_alloc_waiting,iie));
    kaku done=block_label("runtime_alloc_unlock_",len(c.words));
    arm64.assembler_b_cond(c,1,done);
    arm64.assembler_bl(c,"runtime_alloc_wake");
    arm64.assembler_label(c,done);
}
waza wr_alloc_observe(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,offset:int64) -> unit {
    moshi(!wr_observed(c)){kaesu;}
    wr_current(c,p,first);
    wr_addr(c,11,0,wr_obs_alloc+offset);
    wr_increment(c,11,0);
}
// A failed runtime call ends the process. In the public thread build the exit status says which call failed and how (30 + 4 * call + min(result, 3));
// test builds keep the plain runtime error (status 1).
waza wr_call(c:arm64.Assembler,name:string) -> unit {
    arm64.assembler_bl(c,string.concat("attached_",name));
    moshi(arm64.assembler_label_word(c,"worker_evidence")>=0){arm64.assembler_cbnz_x(c,0,"runtime_error");}
    sore {
        kaku names=["gc_block_enter","gc_block_leave","thread_open_shared","thread_wait_started","thread_wait_completion","thread_close","gc_mutator_poll","gc_heap_enter","thread_attach","thread_enter","thread_leave","gc_scan_roots"];
        kaku id=12;kaku i=0;aida(i<len(names)){moshi(names[i]==name){id=i;}i=i+1;}
        kaku ok=block_label("wr_ok_",len(c.words));arm64.assembler_cbz_x(c,0,ok);
        emit(c,arm64.cmp_imm_x(0,3,iie));kaku keep=block_label("wr_rc_",len(c.words));arm64.assembler_b_cond(c,9,keep);emit(c,arm64.movz_x(0,3,0));arm64.assembler_label(c,keep);
        emit(c,arm64.add_imm_x(0,0,30+id*4,iie));emit(c,arm64.movz_x(16,1,0));emit(c,arm64.svc(128));arm64.assembler_label(c,ok);
    }
}
waza wr_poll(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,operation:string) -> unit {wr_current(c,p,first);move_x(c,1,24);wr_call(c,operation);}
waza wr_addr(c:arm64.Assembler,r:int64,base:int64,offset:int64) -> unit {wr_num(c,12,offset);emit(c,arm64.add_x(r,base,12));}
waza wr_increment(c:arm64.Assembler,ctx:int64,offset:int64) -> unit {emit(c,arm64.ldr_x(10,ctx,offset));emit(c,arm64.add_imm_x(10,10,1,iie));emit(c,arm64.str_x(10,ctx,offset));}
waza wr_snapshot_trace(c:arm64.Assembler,ctx:int64) -> unit {
    kaku done=block_label("worker_snapshot_max_",len(c.words));emit(c,arm64.ldr_x(10,ctx,wr_snapshot+8));emit(c,arm64.ldr_x(11,ctx,8672));emit(c,arm64.cmp_x(10,11));arm64.assembler_b_cond(c,9,done);emit(c,arm64.str_x(10,ctx,8672));arm64.assembler_label(c,done);
    emit(c,arm64.ldr_x(11,ctx,gc.thread_registry));emit(c,arm64.add_imm_x(11,11,gc.gc_registry_epoch,iie));emit(c,arm64.ldar_x(10,11));emit(c,arm64.str_x(10,ctx,8680));
}
// Observed builds: the main thread prints the epoch-protocol counters once, after every thread it started has been joined (stderr, text, same format
// family as the heap observation record: `mio-thread name=value`). Sums over every context slot; maxima over every slot. The registry epoch word is
// the number of epochs entered by anyone (gc_begin increments it), the buckets are timed calls described at wr_obs.
waza wr_obs_print(c:arm64.Assembler,name:string) -> unit {
    kaku prefix=string.to_bytes(string.concat(string.concat("mio-thread ",name),"="));kaku bytes=((len(prefix)+15)/16)*16;
    emit(c,arm64.sub_imm_x(31,31,bytes,iie));kaku i=0;
    aida(i<len(prefix)){emit(c,arm64.movz_w(9,int64(prefix[i])));emit(c,arm64.strb_w(9,31,i));i=i+1;}
    emit(c,arm64.movz_x(0,2,0));emit(c,arm64.add_imm_x(1,31,0,iie));emit(c,arm64.movz_x(2,len(prefix),0));emit(c,arm64.movz_x(16,4,0));emit(c,arm64.svc(128));
