    wr_imports(c,p,first);emit(c,arm64.str_x(7,10,gc.thread_imports));wr_num(c,11,3);emit(c,arm64.str_x(11,10,gc.thread_version));
    wr_ctx(c,p,first,9,0);emit(c,arm64.ldr_x(11,9,gc.thread_key));emit(c,arm64.str_x(11,10,gc.thread_key));emit(c,arm64.add_imm_x(9,9,400,iie));emit(c,arm64.str_x(9,10,gc.thread_registry));
    emit(c,arm64.add_imm_x(9,10,288,iie));emit(c,arm64.str_x(9,10,gc.thread_mutex));emit(c,arm64.add_imm_x(9,10,352,iie));emit(c,arm64.str_x(9,10,gc.thread_condition));
    emit(c,arm64.ldr_x(9,31,176));arm64.assembler_cbz_x(c,9,"runtime_error");emit(c,arm64.ldr_x(11,9,0));emit(c,arm64.cmp_imm_x(11,4,iie));arm64.assembler_b_cond(c,1,"runtime_error");
    emit(c,arm64.ldr_x(11,9,16));arm64.assembler_cbnz_x(c,11,"runtime_error");
    emit(c,arm64.str_x(9,10,gc.thread_user));emit(c,arm64.str_x(9,10,560));emit(c,arm64.str_x(31,10,544));wr_num(c,11,1);emit(c,arm64.str_x(11,10,552));emit(c,arm64.add_imm_x(9,10,544,iie));emit(c,arm64.str_x(9,10,gc.thread_shadow));
