// A failed runtime call ends the process. In the public thread build the exit status says which call failed and how (30 + 4 * call + min(result, 3));
// test builds keep the plain runtime error (status 1).
waza wr_call(c:arm64.Assembler,name:string) -> unit {
    arm64.assembler_bl(c,string.concat("attached_",name));
    moshi(arm64.assembler_label_word(c,"worker_evidence")>=0){arm64.assembler_cbnz_x(c,0,"runtime_error");}
    sore {
        kaku names=["gc_block_enter","gc_block_leave","thread_open_shared","thread_wait_started","thread_wait_completion","thread_close","gc_mutator_poll","gc_heap_enter","thread_attach","thread_enter","thread_leave","gc_scan_roots"];
        kaku id=12;kaku i=0;aida(i<len(names)){moshi(names[i]==name){id=i;}i=i+1;}
        kaku ok=block_label("wr_ok_",len(c.words));arm64.assembler_cbz_x(c,0,ok);
        emit(c,arm64.cmp_imm_x(0,3,iie));kaku keep=block_label("wr_rc_",len(c.words));arm64.assembler_b_cond(c,9,keep);emit(c,arm64.movz_x(0,3,0));arm64.assembler_label(c,keep);
        emit(c,arm64.add_imm_x(0,0,30+id*4,iie));emit(c,arm64.movz_x(16,1,0));emit(c,arm64.svc(128));arm64.assembler_label(c,ok);
    }
}
waza wr_poll(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,operation:string) -> unit {wr_current(c,p,first);move_x(c,1,24);wr_call(c,operation);}
waza wr_addr(c:arm64.Assembler,r:int64,base:int64,offset:int64) -> unit {wr_num(c,12,offset);emit(c,arm64.add_x(r,base,12));}
waza wr_increment(c:arm64.Assembler,ctx:int64,offset:int64) -> unit {emit(c,arm64.ldr_x(10,ctx,offset));emit(c,arm64.add_imm_x(10,10,1,iie));emit(c,arm64.str_x(10,ctx,offset));}
waza wr_snapshot_trace(c:arm64.Assembler,ctx:int64) -> unit {
    kaku done=block_label("worker_snapshot_max_",len(c.words));emit(c,arm64.ldr_x(10,ctx,wr_snapshot+8));emit(c,arm64.ldr_x(11,ctx,8672));emit(c,arm64.cmp_x(10,11));arm64.assembler_b_cond(c,9,done);emit(c,arm64.str_x(10,ctx,8672));arm64.assembler_label(c,done);
    emit(c,arm64.ldr_x(11,ctx,gc.thread_registry));emit(c,arm64.add_imm_x(11,11,gc.gc_registry_epoch,iie));emit(c,arm64.ldar_x(10,11));emit(c,arm64.str_x(10,ctx,8680));
}
waza emit_worker_root_runtime(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,queue_slots:int64) -> string {
