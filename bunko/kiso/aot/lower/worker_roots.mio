// Darwin/AArch64 implementation of the portable managed-mutator protocol.
// The internal bridge has two joinable worker slots and a shared process key.
// Each slot owns native context/opaque locks/bootstrap root/snapshot storage.
// The bridge owns one context per concurrently live worker (plus the main thread's): `worker_slots` of them, 8800 bytes each. A start with
// every slot in use is a runtime error (never a silent wait); the public thread API will turn that into an explicit error value.
koukai teisu worker_slots=128;
koukai teisu word_blocks=16384;
// Off-heap control words for channels: a pool of word_blocks blocks of 8 words after the thread contexts. Word 0 of the pool counts issued
// blocks; block h (a handle, 1..word_blocks) starts at word 8*h. Blocks are never reused (a channel's control block stays valid for the life of
// the process, so a thread still inside send/receive can never touch recycled memory); the 16385th words_new fails with -12.
// Words per thread context: the fixed records, then (from wr_snapshot) the collector's root snapshot of wr_snapshot_capacity entries.
teisu wr_ctx_words=5200;
// After the word pool: 16 words for the main thread control block of the Linux thread layer (linuxthreads.mio).
koukai teisu worker_root_words=(worker_slots+1)*wr_ctx_words+4+(word_blocks+1)*8+16;
teisu wr_stride=41600;
// Context word at +8800: the integer a worker entry returned (0 for an entry that returns nothing); join hands it to the caller.
teisu wr_result=8800;
// Context word at +8808: nonzero while the slot is claimed by a start and not yet joined.
teisu wr_claim=8808;
// Context word at +8816: generation of the slot (counts joins; part of the handle). Word at +8824: status of this thread's last join (0 or 22).
teisu wr_generation=8816;
teisu wr_join_status=8824;
teisu wr_snapshot=9000;
// 4000 roots: with 128 live threads the stopped-world snapshot needs several dozen per thread (1000 overflowed: gc_scan_roots failed).
teisu wr_snapshot_capacity=4000;
waza worker_roots_enabled(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,"worker_roots_enabled")>=0;}
waza emit_print_boundary(c:arm64.Assembler) -> unit {
    moshi(worker_roots_enabled(c)){
        emit(c,arm64.sub_imm_x(31,31,16,iie));emit(c,arm64.str_x(30,31,0));arm64.assembler_bl(c,"attached_native_enter");
        emit(c,arm64.svc(128));arm64.assembler_bl(c,"attached_native_leave");emit(c,arm64.ldr_x(30,31,0));emit(c,arm64.add_imm_x(31,31,16,iie));
    } sore {emit(c,arm64.svc(128));}
}
waza wr_emit(c:arm64.Assembler,w:arm64.Instruction) -> unit {emit(c,w);}
waza wr_ctx(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,r:int64,slot:int64) -> unit {attached_data_address(c,p,first+worker_import_slots(c)+slot*wr_ctx_words,r);}
waza wr_pool(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,r:int64) -> unit {attached_data_address(c,p,first+worker_import_slots(c)+(worker_slots+1)*wr_ctx_words,r);}
waza wr_neg(c:arm64.Assembler,r:int64,n:int64) -> unit {wr_num(c,r,n);emit(c,arm64.sub_x(r,31,r));}
// Leaves the address of word x1 of block x0 in x13 or branches to bad. Clobbers x9-x13.
waza word_address(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,bad:string) -> unit {
    arm64.assembler_cbz_x(c,0,bad);wr_num(c,14,word_blocks);emit(c,arm64.cmp_x(0,14));arm64.assembler_b_cond(c,8,bad);
    emit(c,arm64.cmp_imm_x(1,8,iie));arm64.assembler_b_cond(c,2,bad);
    wr_pool(c,p,first,9);emit(c,arm64.ldr_x(10,9,0));emit(c,arm64.cmp_x(0,10));arm64.assembler_b_cond(c,8,bad);
    wr_num(c,12,8);emit(c,arm64.mul_x(11,0,12));emit(c,arm64.add_x(11,11,1));emit(c,arm64.mul_x(11,11,12));emit(c,arm64.add_x(13,9,11));
}
waza emit_word_natives(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {
    // words_new(n): n in 1..8
    arm64.assembler_label(c,"native_words_new");emit(c,arm64.cmp_imm_x(0,1,iie));arm64.assembler_b_cond(c,11,"native_word_bad");emit(c,arm64.cmp_imm_x(0,8,iie));arm64.assembler_b_cond(c,12,"native_word_bad");
    wr_pool(c,p,first,9);arm64.assembler_label(c,"native_words_new_retry");emit(c,arm64.ldxr_x(10,9,hai));wr_num(c,14,word_blocks);emit(c,arm64.cmp_x(10,14));arm64.assembler_b_cond(c,2,"native_words_full");
    emit(c,arm64.add_imm_x(11,10,1,iie));emit(c,arm64.stxr_x(12,11,9,hai));arm64.assembler_cbnz_x(c,12,"native_words_new_retry");emit(c,arm64.add_imm_x(0,10,1,iie));emit(c,arm64.ret());
    arm64.assembler_label(c,"native_words_full");wr_neg(c,0,12);emit(c,arm64.ret());
    arm64.assembler_label(c,"native_word_bad");wr_neg(c,0,22);emit(c,arm64.ret());
    // words_free(h, n): blocks stay mapped for the life of the process
    arm64.assembler_label(c,"native_join_status");emit(c,arm64.sub_imm_x(31,31,16,iie));emit(c,arm64.str_x(30,31,0));arm64.assembler_bl(c,"attached_join_status");emit(c,arm64.ldr_x(30,31,0));emit(c,arm64.add_imm_x(31,31,16,iie));emit(c,arm64.ret());
    arm64.assembler_label(c,"native_words_free");emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ret());
    arm64.assembler_label(c,"native_word_get");word_address(c,p,first,"native_word_bad");emit(c,arm64.ldar_x(0,13));emit(c,arm64.ret());
    arm64.assembler_label(c,"native_word_set");word_address(c,p,first,"native_word_bad");emit(c,arm64.stlr_x(2,13));emit(c,arm64.dmb_ish());emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ret());
    // word_cas(h, i, expected, new) -> the value found
    arm64.assembler_label(c,"native_word_cas");word_address(c,p,first,"native_word_bad");
    arm64.assembler_label(c,"native_word_cas_retry");emit(c,arm64.ldxr_x(14,13,hai));emit(c,arm64.cmp_x(14,2));arm64.assembler_b_cond(c,1,"native_word_cas_done");
    emit(c,arm64.stxr_x(15,3,13,hai));arm64.assembler_cbnz_x(c,15,"native_word_cas_retry");
    arm64.assembler_label(c,"native_word_cas_done");move_x(c,0,14);emit(c,arm64.dmb_ish());emit(c,arm64.ret());
    // word_add(h, i, delta) -> the value before
    arm64.assembler_label(c,"native_word_add");word_address(c,p,first,"native_word_bad");
    arm64.assembler_label(c,"native_word_add_retry");emit(c,arm64.ldxr_x(14,13,hai));emit(c,arm64.add_x(10,14,2));emit(c,arm64.stxr_x(15,10,13,hai));arm64.assembler_cbnz_x(c,15,"native_word_add_retry");
    move_x(c,0,14);emit(c,arm64.dmb_ish());emit(c,arm64.ret());
    // word_wake(h, i, n): waiters poll with a short timed sleep, so there is nothing to signal
    arm64.assembler_label(c,"native_word_wake");word_address(c,p,first,"native_word_bad");emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ret());
    // word_wait(h, i, expected): returns once the word differs from expected (or after a short timeout: callers re-check). A safepoint every round.
    arm64.assembler_label(c,"native_word_wait");word_address(c,p,first,"native_word_bad");
    emit(c,arm64.sub_imm_x(31,31,48,iie));emit(c,arm64.str_x(30,31,0));emit(c,arm64.str_x(0,31,8));emit(c,arm64.str_x(1,31,16));emit(c,arm64.str_x(2,31,24));
    // Short holds are the common case: spin a bounded number of reads (no safepoint needed, it ends in microseconds) before sleeping.
    wr_num(c,15,4000);arm64.assembler_label(c,"native_word_wait_spin");emit(c,arm64.ldar_x(14,13));emit(c,arm64.cmp_x(14,2));arm64.assembler_b_cond(c,1,"native_word_wait_done");
    emit(c,arm64.sub_imm_x(15,15,1,iie));arm64.assembler_cbnz_x(c,15,"native_word_wait_spin");
    // Then sleep with exponential backoff (50us doubling to 20ms, 64 rounds at most) taking a safepoint every round: a long waiter costs almost
    // no CPU and does not hammer the registry lock, so a hundred blocked threads cannot starve the ones that make progress or the collector's handshake.
    wr_num(c,9,50000);emit(c,arm64.str_x(9,31,32));wr_num(c,9,64);emit(c,arm64.str_x(9,31,40));
    arm64.assembler_label(c,"native_word_wait_sleep");emit(c,arm64.ldr_x(0,31,32));arm64.assembler_bl(c,"attached_worker_wait");
    emit(c,arm64.ldr_x(0,31,8));emit(c,arm64.ldr_x(1,31,16));word_address(c,p,first,"native_word_wait_done");emit(c,arm64.ldar_x(14,13));emit(c,arm64.ldr_x(2,31,24));emit(c,arm64.cmp_x(14,2));arm64.assembler_b_cond(c,1,"native_word_wait_done");
    emit(c,arm64.ldr_x(9,31,32));emit(c,arm64.lsl_x(9,9,1));wr_num(c,10,20000000);emit(c,arm64.cmp_x(9,10));arm64.assembler_b_cond(c,9,"native_word_wait_cap");move_x(c,9,10);
    arm64.assembler_label(c,"native_word_wait_cap");emit(c,arm64.str_x(9,31,32));emit(c,arm64.ldr_x(9,31,40));emit(c,arm64.sub_imm_x(9,9,1,iie));emit(c,arm64.str_x(9,31,40));arm64.assembler_cbnz_x(c,9,"native_word_wait_sleep");
    arm64.assembler_label(c,"native_word_wait_done");emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ldr_x(30,31,0));emit(c,arm64.add_imm_x(31,31,48,iie));emit(c,arm64.ret());
}
waza wr_imports(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {attached_data_address(c,p,first,7);}
waza wr_num(c:arm64.Assembler,r:int64,n:int64) -> unit {move_bits(c,r,uint32(0),uint32(n));}
waza wr_current(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {
    wr_ctx(c,p,first,0,0);wr_imports(c,p,first);emit(c,arm64.ldr_x(0,0,gc.thread_key));aarch64.emit_import_call(c,7,5,28);arm64.assembler_cbz_x(c,0,"runtime_error");
    wr_ctx(c,p,first,9,0);emit(c,arm64.add_imm_x(9,9,400,iie));emit(c,arm64.ldr_x(10,0,gc.thread_registry));emit(c,arm64.cmp_x(9,10));arm64.assembler_b_cond(c,1,"runtime_error");
    emit(c,arm64.ldr_x(10,0,gc.thread_registered));arm64.assembler_cbz_x(c,10,"runtime_error");
    emit(c,arm64.add_imm_x(9,0,gc.thread_shadow,iie));emit(c,arm64.stlr_x(24,9));wr_imports(c,p,first);
