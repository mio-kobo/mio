    kaku error=aarch64.emit_program(c,functions,bindings,worker_import_slots(c),"attached");moshi(error!=""){kaesu error;}
    i=0;aida(i<len(callbacks)){kaku target=arm64.assembler_label_word(c,callbacks[i]);kaku ins=arm64.adr(9,(target-relocations[i])*4);moshi(ins.error!=mu){kaesu "WORKER_CALLBACK_RANGE";}c.words[relocations[i]]=ins.word;i=i+1;}
    kaku target=arm64.assembler_label_word(c,"worker_user_entry");kaku entry=arm64.adr(9,(target-worker_address)*4);moshi(entry.error!=mu){kaesu "WORKER_ENTRY_RANGE";}c.words[worker_address]=entry.word;
    kaesu "";
}
