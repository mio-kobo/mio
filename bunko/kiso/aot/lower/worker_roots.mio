    emit(c,arm64.str_x(7,0,gc.thread_imports));wr_num(c,9,3);emit(c,arm64.str_x(9,0,gc.thread_version));
    emit(c,arm64.add_imm_x(10,0,288,iie));emit(c,arm64.str_x(10,0,gc.thread_mutex));emit(c,arm64.add_imm_x(10,0,352,iie));emit(c,arm64.str_x(10,0,gc.thread_condition));
    emit(c,arm64.add_imm_x(10,0,400,iie));emit(c,arm64.str_x(10,0,gc.thread_registry));emit(c,arm64.str_x(9,10,0));
    kaku relocations:[]int64=[];kaku callbacks=["attached_gc_snapshot_root","worker_heap_collect","worker_heap_alloc"];moshi(old_sweep_enabled(c)){array.append_all(callbacks,["worker_sweep_account","worker_sweep_unmap"]);}
    kaku i=0;aida(i<len(callbacks)){array.push(relocations,len(c.words));emit(c,arm64.movz_x(9,0,0));emit(c,arm64.str_x(9,7,(25+i)*8));i=i+1;}
    moshi(old_mark_proto_enabled(c)){wr_ctx(c,p,first,9,0);wr_addr(c,9,9,8696);kaku link_slot=0;aida(link_slot<3){wr_ctx(c,p,first,10,link_slot);emit(c,arm64.str_x(9,10,8704));link_slot=link_slot+1;}}
