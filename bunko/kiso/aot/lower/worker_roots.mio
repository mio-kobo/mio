    wr_num(c,15,wr_claim);emit(c,arm64.add_x(14,10,15));
    arm64.assembler_label(c,"worker_slot_claim");emit(c,arm64.ldxr_x(11,14,hai));arm64.assembler_cbnz_x(c,11,"worker_slot_next");emit(c,arm64.movz_x(11,1,0));emit(c,arm64.stxr_x(9,11,14,hai));arm64.assembler_cbnz_x(c,9,"worker_slot_claim");arm64.assembler_b(c,"worker_slot_ready");
    arm64.assembler_label(c,"worker_slot_next");emit(c,arm64.add_x(10,10,13));emit(c,arm64.sub_imm_x(12,12,1,iie));arm64.assembler_cbnz_x(c,12,"worker_slot_scan");
    // every slot is live: report -11 (no thread was created) instead of aborting
