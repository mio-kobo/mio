yobu "kiso/aot/elf";
yobu "kiso/aot/elfrel";
yobu "kiso/array";
yobu "kiso/convert";
yobu "kiso/string";

// Pure Mio Linux x86-64 ELF64 shared-object (ET_DYN) linker for self-contained Mio modules: the
// `mio build --shared --linker native` path. It links the lowered module (the same elfrel.ObjectSpec the ET_REL
// writer receives) directly into a loadable shared object, without cc, ld or lld.
//
// R_X86_64_PC32 references from .text to the module's own data area are resolved at link time (the distance between
// .text and .bss is fixed). link() takes self-contained modules only: its output has no dynamic relocations, GOT, PLT
// or DT_NEEDED, and R_X86_64_PLT32 fails with UNSUPPORTED_EXTERNAL. link_with() also takes declared imports: each
// R_X86_64_PLT32 target becomes an undefined dynamic symbol, a PLT stub and a RELRO GOT slot bound by an
// R_X86_64_JUMP_SLOT relocation, with DT_NEEDED/DT_RUNPATH. Other relocation types fail with UNSUPPORTED_RELOCATION.
// Nothing falls back to another linker.
//
// Layout (file offset == virtual address, base 0, 4 KiB pages):
//   0x0000  ELF header, program headers, .gnu.hash, .dynsym, .dynstr         PT_LOAD R
//   page    .text                                                            PT_LOAD R+X
//   page    .dynamic (PT_DYNAMIC, PT_GNU_RELRO up to the page end), then     PT_LOAD R+W
//   page    .bss (zero-filled, memory only)
//   after   .symtab, .strtab, .shstrtab and the section headers (not loaded)
// Program headers: the three PT_LOADs, PT_DYNAMIC, PT_GNU_RELRO and a non-executable PT_GNU_STACK.
// Dynamic tags: DT_GNU_HASH, DT_STRTAB, DT_SYMTAB, DT_STRSZ, DT_SYMENT, DT_SONAME, DT_FLAGS = DF_BIND_NOW,
// DT_FLAGS_1 = DF_1_NOW, DT_NULL. The dynamic symbol table holds exactly the exports (GLOBAL FUNC, default
// visibility); the module's local functions are only in .symtab. The output is a pure function of the input.

// The declared external dependencies of a link (see link_with).
koukai kata Imports {
    needed: []string;
    runpath: string;
    symbols: []string;
}

koukai kata LinkResult {
    bytes: []uint8;
    error: string;
}

teisu page = 4096;
teisu header_size = 64;
teisu program_header_size = 56;
teisu program_headers = 6;
teisu section_header_size = 64;
teisu symbol_size = 24;
teisu dynamic_entry_size = 16;
teisu maximum_bss = 1073741824;
teisu maximum_code = 1073741824;
teisu bloom_shift = 26;

waza fail(message: string) -> LinkResult { kaesu LinkResult { bytes: [], error: message }; }

waza add_name(table: []uint8, name: string) -> int64 {
    kaku at = len(table);
    array.append_all(table, string.to_bytes(name));
    array.push(table, uint8(0));
    kaesu at;
}

waza pad_to(out: []uint8, size: int64) -> unit {
    aida (len(out) < size) { array.push(out, uint8(0)); }
}

// Overwrites 4 bytes at `at` with the two's-complement little-endian value.
waza patch32(code: []uint8, at: int64, value: int64) -> unit {
    kaku x = value;
    moshi (x < 0) { x = x + 4294967296; }
    kaku i = 0;
    aida (i < 4) {
        code[at + i] = uint8(x - (x / 256) * 256);
        x = x / 256;
        i = i + 1;
    }
}

// The GNU hash of a symbol name (dl_new_hash): h = h * 33 + c over the bytes, modulo 2^32.
koukai waza gnu_hash(name: string) -> int64 {
    kaku bytes = string.to_bytes(name);
    kaku h = 5381;
    kaku at = 0;
    aida (at < len(bytes)) {
        h = (h * 33 + int64(bytes[at])) - ((h * 33 + int64(bytes[at])) / 4294967296) * 4294967296;
        at = at + 1;
    }
    kaesu h;
}

waza power_of_two(n: int64) -> int64 {
    kaku value = 1;
    kaku i = 0;
    aida (i < n) { value = value * 2; i = i + 1; }
    kaesu value;
}

// Sets bit `bit` (0..63) of the little-endian 64-bit word at bloom[word * 8].
waza set_bloom_bit(bloom: []uint8, word: int64, bit: int64) -> unit {
    kaku index = word * 8 + bit / 8;
    kaku mask = power_of_two(bit - (bit / 8) * 8);
    kaku current = int64(bloom[index]);
    moshi ((current / mask) - ((current / mask) / 2) * 2 == 0) { bloom[index] = uint8(current + mask); }
}

waza section_header(out: []uint8, name: int64, kind: int64, flags: int64, address: int64, offset: int64, size: int64, link: int64, info: int64, alignment: int64, entry_size: int64) -> unit {
    elf.put(out, name, 4);
    elf.put(out, kind, 4);
    elf.put(out, flags, 8);
    elf.put(out, address, 8);
    elf.put(out, offset, 8);
    elf.put(out, size, 8);
    elf.put(out, link, 4);
    elf.put(out, info, 4);
    elf.put(out, alignment, 8);
    elf.put(out, entry_size, 8);
}

waza program_header(out: []uint8, kind: int64, flags: int64, offset: int64, address: int64, file_size: int64, memory_size: int64, alignment: int64) -> unit {
    elf.put(out, kind, 4);
    elf.put(out, flags, 4);
    elf.put(out, offset, 8);
    elf.put(out, address, 8);
    elf.put(out, address, 8);
    elf.put(out, file_size, 8);
    elf.put(out, memory_size, 8);
    elf.put(out, alignment, 8);
}

waza symbol(out: []uint8, name: int64, info: int64, section_index: int64, value: int64, size: int64) -> unit {
    elf.put(out, name, 4);
    elf.put(out, info, 1);
    elf.put(out, 0, 1);
    elf.put(out, section_index, 2);
    elf.put(out, value, 8);
    elf.put(out, size, 8);
}

waza dynamic(out: []uint8, tag: int64, value: int64) -> unit {
    elf.put(out, tag, 8);
    elf.put(out, value, 8);
}

// A SONAME is a file name: non-empty, no NUL, no "/", at most 255 bytes.
koukai waza valid_soname(soname: string) -> bool {
    kaku bytes = string.to_bytes(soname);
    moshi (len(bytes) == 0 || len(bytes) > 255) { kaesu iie; }
    kaku at = 0;
    aida (at < len(bytes)) {
        moshi (bytes[at] == uint8(0) || bytes[at] == uint8(47)) { kaesu iie; }
        at = at + 1;
    }
    kaesu hai;
}

waza validate(spec: elfrel.ObjectSpec, soname: string, imports: Imports) -> string {
    moshi (!valid_soname(soname)) { kaesu "INVALID_SONAME"; }
    moshi (len(spec.code) == 0) { kaesu "EMPTY_TEXT"; }
    moshi (len(spec.code) > maximum_code) { kaesu "TEXT_TOO_LARGE"; }
    moshi (spec.bss_size < 0 || spec.bss_size > maximum_bss) { kaesu "INVALID_BSS"; }
    kaku at = 0;
    aida (at < len(imports.needed)) {
        moshi (!valid_symbol_name(imports.needed[at]) || len(string.to_bytes(imports.needed[at])) > 4096) { kaesu "INVALID_NEEDED"; }
        kaku other = 0;
        aida (other < at) { moshi (imports.needed[other] == imports.needed[at]) { kaesu string.concat("DUPLICATE_NEEDED ", imports.needed[at]); } other = other + 1; }
        at = at + 1;
    }
    moshi (imports.runpath != "" && (!valid_symbol_name(imports.runpath) || len(string.to_bytes(imports.runpath)) > 4096)) { kaesu "INVALID_RUNPATH"; }
    at = 0;
    aida (at < len(spec.exports)) {
        kaku entry = spec.exports[at];
        moshi (!valid_symbol_name(entry.symbol) || entry.offset < 0 || entry.size < 0 || entry.offset > len(spec.code) - entry.size) { kaesu "INVALID_EXPORT"; }
        kaku other = 0;
        aida (other < at) {
            moshi (spec.exports[other].symbol == entry.symbol) { kaesu string.concat("DUPLICATE_EXPORT ", entry.symbol); }
            other = other + 1;
        }
        at = at + 1;
    }
    at = 0;
    aida (at < len(spec.locals)) {
        kaku entry = spec.locals[at];
        moshi (!valid_symbol_name(entry.symbol) || entry.offset < 0 || entry.size < 0 || entry.offset > len(spec.code) - entry.size) { kaesu "INVALID_LOCAL"; }
        at = at + 1;
    }
    kaku linking = len(imports.needed) > 0;
    at = 0;
    aida (at < len(spec.relocations)) {
        kaku reloc = spec.relocations[at];
        moshi (reloc.kind == elfrel.r_x86_64_plt32) {
            moshi (!linking) { kaesu string.concat("UNSUPPORTED_EXTERNAL ", reloc.symbol); }
            moshi (!valid_symbol_name(reloc.symbol)) { kaesu "INVALID_RELOCATION_SYMBOL"; }
            moshi (is_export(spec, reloc.symbol)) { kaesu string.concat("UNSUPPORTED_SELF_REFERENCE ", reloc.symbol); }
            moshi (!contains(imports.symbols, reloc.symbol)) { kaesu string.concat("UNRESOLVED_SYMBOL ", reloc.symbol); }
            moshi (reloc.addend != -4) { kaesu "INVALID_RELOCATION_ADDEND"; }
        } sore {
            moshi (reloc.kind != elfrel.r_x86_64_pc32) { kaesu string.concat("UNSUPPORTED_RELOCATION type ", convert.format_int(reloc.kind)); }
            moshi (reloc.symbol != "") { kaesu "INVALID_RELOCATION_SYMBOL"; }
            moshi (reloc.addend < -4 || reloc.addend > spec.bss_size - 4) { kaesu "INVALID_RELOCATION_ADDEND"; }
        }
        moshi (reloc.at < 0 || reloc.at > len(spec.code) - 4) { kaesu "INVALID_RELOCATION_OFFSET"; }
        kaku other = 0;
        aida (other < at) {
            kaku previous = spec.relocations[other].at;
            moshi (previous > reloc.at - 4 && previous < reloc.at + 4) { kaesu "OVERLAPPING_RELOCATIONS"; }
            other = other + 1;
        }
        at = at + 1;
    }
    kaesu "";
}

waza contains(names: []string, name: string) -> bool {
    kaku at = 0;
    aida (at < len(names)) { moshi (names[at] == name) { kaesu hai; } at = at + 1; }
    kaesu iie;
}

waza is_export(spec: elfrel.ObjectSpec, name: string) -> bool {
    kaku at = 0;
    aida (at < len(spec.exports)) { moshi (spec.exports[at].symbol == name) { kaesu hai; } at = at + 1; }
    kaesu iie;
}

waza valid_symbol_name(name: string) -> bool {
    kaku bytes = string.to_bytes(name);
    moshi (len(bytes) == 0) { kaesu iie; }
    kaku at = 0;
    aida (at < len(bytes)) {
        moshi (bytes[at] == uint8(0)) { kaesu iie; }
        at = at + 1;
    }
    kaesu hai;
}

// link produces the ET_DYN image of a self-contained module. soname becomes DT_SONAME.
koukai waza link(spec: elfrel.ObjectSpec, soname: string) -> LinkResult {
    kaesu link_with(spec, soname, Imports { needed: [], runpath: "", symbols: [] });
}

// One entry of the section header table being built.
kata Section { name: string; kind: int64; flags: int64; address: int64; offset: int64; size: int64; link: int64; info: int64; alignment: int64; entry_size: int64; }

// link_with links a module that may call declared external C symbols. imports.needed are the DT_NEEDED names in
// order, imports.runpath the DT_RUNPATH string ("" for none), and imports.symbols the external names the caller
// verified are defined by those libraries. Every R_X86_64_PLT32 target must be in imports.symbols; it becomes an
// undefined dynamic symbol, a 16-byte PLT stub `jmp *GOT(%rip)` and a GOT slot filled at load time by an
// R_X86_64_JUMP_SLOT relocation (BIND_NOW: all slots are bound before the library runs, and .got.plt is RELRO).
koukai waza link_with(spec: elfrel.ObjectSpec, soname: string, imports: Imports) -> LinkResult {
    kaku problem = validate(spec, soname, imports);
    moshi (problem != "") { kaesu fail(problem); }
    kaku exports = len(spec.exports);

    // External symbols in first-use order (deterministic).
    kaku externals: []string = [];
    kaku at = 0;
    aida (at < len(spec.relocations)) {
        kaku reloc = spec.relocations[at];
        moshi (reloc.kind == elfrel.r_x86_64_plt32 && !contains(externals, reloc.symbol)) { array.push(externals, reloc.symbol); }
        at = at + 1;
    }
    kaku imported = len(externals);
    // Dynamic symbols: [0] null, the undefined imports, then the exports grouped by GNU hash bucket.
    kaku symoffset = 1 + imported;
    kaku buckets = exports;
    moshi (buckets == 0) { buckets = 1; }
    kaku hashes: []int64 = [];
    at = 0;
    aida (at < exports) { array.push(hashes, gnu_hash(spec.exports[at].symbol)); at = at + 1; }
    kaku order: []int64 = [];
    kaku bucket = 0;
    aida (bucket < buckets) {
        at = 0;
        aida (at < exports) {
            moshi (hashes[at] - (hashes[at] / buckets) * buckets == bucket) { array.push(order, at); }
            at = at + 1;
        }
        bucket = bucket + 1;
    }

    kaku dynstr: []uint8 = [uint8(0)];
    kaku soname_name = add_name(dynstr, soname);
    kaku needed_names: []int64 = [];
    at = 0;
    aida (at < len(imports.needed)) { array.push(needed_names, add_name(dynstr, imports.needed[at])); at = at + 1; }
    kaku runpath_name = 0;
    moshi (imports.runpath != "") { runpath_name = add_name(dynstr, imports.runpath); }
    kaku import_names: []int64 = [];
    at = 0;
    aida (at < imported) { array.push(import_names, add_name(dynstr, externals[at])); at = at + 1; }
    kaku dyn_names: []int64 = [];
    at = 0;
    aida (at < exports) { array.push(dyn_names, add_name(dynstr, spec.exports[order[at]].symbol)); at = at + 1; }

    // .gnu.hash: header, one bloom word, buckets, chains (for the exports only).
    kaku gnu_hash_table: []uint8 = [];
    elf.put(gnu_hash_table, buckets, 4);
    elf.put(gnu_hash_table, symoffset, 4);
    elf.put(gnu_hash_table, 1, 4);
    elf.put(gnu_hash_table, bloom_shift, 4);
    kaku bloom: []uint8 = array.make[uint8](8, uint8(0));
    at = 0;
    aida (at < exports) {
        kaku h = hashes[at];
        set_bloom_bit(bloom, 0, h - (h / 64) * 64);
        kaku shifted = h / power_of_two(bloom_shift);
        set_bloom_bit(bloom, 0, shifted - (shifted / 64) * 64);
        at = at + 1;
    }
    array.append_all(gnu_hash_table, bloom);
    bucket = 0;
    aida (bucket < buckets) {
        kaku first = 0;
        at = 0;
        aida (at < exports && first == 0) {
            kaku h = hashes[order[at]];
            moshi (h - (h / buckets) * buckets == bucket) { first = symoffset + at; }
            at = at + 1;
        }
        elf.put(gnu_hash_table, first, 4);
        bucket = bucket + 1;
    }
    at = 0;
    aida (at < exports) {
        kaku h = hashes[order[at]];
        kaku value = h - (h - (h / 2) * 2);
        kaku last = at == exports - 1;
        moshi (!last) {
            kaku next = hashes[order[at + 1]];
            last = next - (next / buckets) * buckets != h - (h / buckets) * buckets;
        }
        moshi (last) { value = value + 1; }
        elf.put(gnu_hash_table, value, 4);
        at = at + 1;
    }

    // Addresses (file offset == virtual address).
    kaku gnu_hash_offset = elf.align(header_size + program_headers * program_header_size, 8);
    kaku dynsym_offset = elf.align(gnu_hash_offset + len(gnu_hash_table), 8);
    kaku dynsym_size = (symoffset + exports) * symbol_size;
    kaku dynstr_offset = dynsym_offset + dynsym_size;
    kaku rela_plt_offset = elf.align(dynstr_offset + len(dynstr), 8);
    kaku rela_plt_size = imported * 24;
    kaku read_end = rela_plt_offset + rela_plt_size;
    moshi (imported == 0) { read_end = dynstr_offset + len(dynstr); }
    kaku text_offset = elf.align(read_end, page);
    kaku plt_offset = elf.align(text_offset + len(spec.code), 16);
    kaku plt_size = imported * 16;
    kaku text_end = text_offset + len(spec.code);
    moshi (imported > 0) { text_end = plt_offset + plt_size; }
    kaku dynamic_offset = elf.align(text_end, page);
    kaku dynamic_count = 1 + len(imports.needed) + 5 + 2 + 2;
    moshi (imports.runpath != "") { dynamic_count = dynamic_count + 1; }
    moshi (imported > 0) { dynamic_count = dynamic_count + 4; }
    kaku dynamic_size = dynamic_count * dynamic_entry_size;
    kaku got_offset = dynamic_offset + dynamic_size;
    kaku got_size = 0;
    moshi (imported > 0) { got_size = (3 + imported) * 8; }
    kaku relro_end = got_offset + got_size;
    kaku bss_address = elf.align(relro_end, page);
    kaku file_loaded_end = relro_end;

    // Relocations resolved at link time: PC32 to .bss (S + A - P) and PLT32 to the import's PLT stub (L + A - P).
    kaku code = array.clone(spec.code);
    at = 0;
    aida (at < len(spec.relocations)) {
        kaku reloc = spec.relocations[at];
        kaku target = bss_address;
        moshi (reloc.kind == elfrel.r_x86_64_plt32) {
            kaku index = 0;
            aida (externals[index] != reloc.symbol) { index = index + 1; }
            target = plt_offset + index * 16;
        }
        kaku value = target + reloc.addend - (text_offset + reloc.at);
        moshi (value < -2147483648 || value > 2147483647) { kaesu fail("RELOCATION_OVERFLOW"); }
        patch32(code, reloc.at, value);
        at = at + 1;
    }
    kaku plt: []uint8 = [];
    kaku rela_plt: []uint8 = [];
    kaku got: []uint8 = [];
    moshi (imported > 0) {
        elf.put(got, dynamic_offset, 8);  // GOT[0] = _DYNAMIC
        elf.put(got, 0, 8);
        elf.put(got, 0, 8);
    }
    at = 0;
    aida (at < imported) {
        kaku slot = got_offset + (3 + at) * 8;
        kaku stub = plt_offset + at * 16;
        // jmp qword ptr [rip + disp32]; the rest of the 16-byte stub is int3
        array.append_all(plt, [uint8(255), uint8(37)]);
        kaku disp: []uint8 = [uint8(0), uint8(0), uint8(0), uint8(0)];
        patch32(disp, 0, slot - (stub + 6));
        array.append_all(plt, disp);
        kaku pad = 0;
        aida (pad < 10) { array.push(plt, uint8(204)); pad = pad + 1; }
        elf.put(got, 0, 8);
        // Elf64_Rela: r_offset, r_info = sym << 32 | R_X86_64_JUMP_SLOT (7), r_addend
        elf.put(rela_plt, slot, 8);
        elf.put(rela_plt, (1 + at) * 4294967296 + 7, 8);
        elf.put(rela_plt, 0, 8);
        at = at + 1;
    }

    // Section indexes depend on whether the import sections exist.
    kaku sections: []Section = [];
    array.push(sections, Section { name: "", kind: 0, flags: 0, address: 0, offset: 0, size: 0, link: 0, info: 0, alignment: 0, entry_size: 0 });
    kaku i_gnu_hash = len(sections);
    array.push(sections, Section { name: ".gnu.hash", kind: 1879048182, flags: 2, address: gnu_hash_offset, offset: gnu_hash_offset, size: len(gnu_hash_table), link: 2, info: 0, alignment: 8, entry_size: 0 });
    kaku i_dynsym = len(sections);
    array.push(sections, Section { name: ".dynsym", kind: 11, flags: 2, address: dynsym_offset, offset: dynsym_offset, size: dynsym_size, link: 3, info: 1, alignment: 8, entry_size: symbol_size });
    kaku i_dynstr = len(sections);
    array.push(sections, Section { name: ".dynstr", kind: 3, flags: 2, address: dynstr_offset, offset: dynstr_offset, size: len(dynstr), link: 0, info: 0, alignment: 1, entry_size: 0 });
    kaku i_rela_plt = -1;
    moshi (imported > 0) {
        i_rela_plt = len(sections);
        // SHF_ALLOC | SHF_INFO_LINK; sh_info (the .got.plt index) is set below
        array.push(sections, Section { name: ".rela.plt", kind: 4, flags: 66, address: rela_plt_offset, offset: rela_plt_offset, size: rela_plt_size, link: i_dynsym, info: 0, alignment: 8, entry_size: 24 });
    }
    kaku i_text = len(sections);
    array.push(sections, Section { name: ".text", kind: 1, flags: 6, address: text_offset, offset: text_offset, size: len(spec.code), link: 0, info: 0, alignment: 16, entry_size: 0 });
    moshi (imported > 0) {
        array.push(sections, Section { name: ".plt", kind: 1, flags: 6, address: plt_offset, offset: plt_offset, size: plt_size, link: 0, info: 0, alignment: 16, entry_size: 16 });
    }
    array.push(sections, Section { name: ".dynamic", kind: 6, flags: 3, address: dynamic_offset, offset: dynamic_offset, size: dynamic_size, link: i_dynstr, info: 0, alignment: 8, entry_size: dynamic_entry_size });
    moshi (imported > 0) {
        kaku i_got = len(sections);
        array.push(sections, Section { name: ".got.plt", kind: 1, flags: 3, address: got_offset, offset: got_offset, size: got_size, link: 0, info: 0, alignment: 8, entry_size: 8 });
        kaku rela = sections[i_rela_plt];
        sections[i_rela_plt] = Section { name: rela.name, kind: rela.kind, flags: rela.flags, address: rela.address, offset: rela.offset, size: rela.size, link: rela.link, info: i_got, alignment: rela.alignment, entry_size: rela.entry_size };
    }
    array.push(sections, Section { name: ".bss", kind: 8, flags: 3, address: bss_address, offset: file_loaded_end, size: spec.bss_size, link: 0, info: 0, alignment: page, entry_size: 0 });
    kaku i_symtab = len(sections);
    kaku i_strtab = i_symtab + 1;
    kaku i_shstrtab = i_symtab + 2;
    // keep the fixed links of .gnu.hash / .dynsym consistent with the computed indexes
    sections[i_gnu_hash] = Section { name: ".gnu.hash", kind: 1879048182, flags: 2, address: gnu_hash_offset, offset: gnu_hash_offset, size: len(gnu_hash_table), link: i_dynsym, info: 0, alignment: 8, entry_size: 0 };
    sections[i_dynsym] = Section { name: ".dynsym", kind: 11, flags: 2, address: dynsym_offset, offset: dynsym_offset, size: dynsym_size, link: i_dynstr, info: 1, alignment: 8, entry_size: symbol_size };

    kaku dynsym: []uint8 = [];
    symbol(dynsym, 0, 0, 0, 0, 0);
    at = 0;
    aida (at < imported) {
        // undefined STB_GLOBAL STT_FUNC
        symbol(dynsym, import_names[at], 18, 0, 0, 0);
        at = at + 1;
    }
    at = 0;
    aida (at < exports) {
        kaku entry = spec.exports[order[at]];
        symbol(dynsym, dyn_names[at], 18, i_text, text_offset + entry.offset, entry.size);
        at = at + 1;
    }

    kaku dynamic_table: []uint8 = [];
    dynamic(dynamic_table, 14, soname_name);              // DT_SONAME
    at = 0;
    aida (at < len(needed_names)) { dynamic(dynamic_table, 1, needed_names[at]); at = at + 1; } // DT_NEEDED
    moshi (imports.runpath != "") { dynamic(dynamic_table, 29, runpath_name); } // DT_RUNPATH
    dynamic(dynamic_table, 1879047925, gnu_hash_offset);  // DT_GNU_HASH
    dynamic(dynamic_table, 5, dynstr_offset);             // DT_STRTAB
    dynamic(dynamic_table, 6, dynsym_offset);             // DT_SYMTAB
    dynamic(dynamic_table, 10, len(dynstr));              // DT_STRSZ
    dynamic(dynamic_table, 11, symbol_size);              // DT_SYMENT
    moshi (imported > 0) {
        dynamic(dynamic_table, 3, got_offset);            // DT_PLTGOT
        dynamic(dynamic_table, 2, rela_plt_size);         // DT_PLTRELSZ
        dynamic(dynamic_table, 20, 7);                    // DT_PLTREL = DT_RELA
        dynamic(dynamic_table, 23, rela_plt_offset);      // DT_JMPREL
    }
    dynamic(dynamic_table, 30, 8);                        // DT_FLAGS = DF_BIND_NOW
    dynamic(dynamic_table, 1879048187, 1);                // DT_FLAGS_1 = DF_1_NOW
    dynamic(dynamic_table, 0, 0);                         // DT_NULL
    dynamic(dynamic_table, 0, 0);                         // padding (DT_NULL)

    // Non-loaded tables: .symtab (locals then exports), .strtab, .shstrtab.
    kaku strtab: []uint8 = [uint8(0)];
    kaku symtab: []uint8 = [];
    symbol(symtab, 0, 0, 0, 0, 0);
    at = 0;
    aida (at < len(spec.locals)) {
        symbol(symtab, add_name(strtab, spec.locals[at].symbol), 2, i_text, text_offset + spec.locals[at].offset, spec.locals[at].size);
        at = at + 1;
    }
    kaku first_global = 1 + len(spec.locals);
    at = 0;
    aida (at < exports) {
        kaku entry = spec.exports[order[at]];
        symbol(symtab, add_name(strtab, entry.symbol), 18, i_text, text_offset + entry.offset, entry.size);
        at = at + 1;
    }
    at = 0;
    aida (at < imported) { symbol(symtab, add_name(strtab, externals[at]), 18, 0, 0, 0); at = at + 1; }
    kaku symtab_offset = elf.align(file_loaded_end, 8);
    kaku strtab_offset = symtab_offset + len(symtab);
    array.push(sections, Section { name: ".symtab", kind: 2, flags: 0, address: 0, offset: symtab_offset, size: len(symtab), link: i_strtab, info: first_global, alignment: 8, entry_size: symbol_size });
    array.push(sections, Section { name: ".strtab", kind: 3, flags: 0, address: 0, offset: strtab_offset, size: len(strtab), link: 0, info: 0, alignment: 1, entry_size: 0 });
    kaku shstrtab: []uint8 = [uint8(0)];
    kaku shnames: []int64 = [];
    at = 0;
    aida (at < len(sections)) {
        moshi (at == 0) { array.push(shnames, 0); } sore { array.push(shnames, add_name(shstrtab, sections[at].name)); }
        at = at + 1;
    }
    array.push(shnames, add_name(shstrtab, ".shstrtab"));
    kaku shstrtab_offset = strtab_offset + len(strtab);
    array.push(sections, Section { name: ".shstrtab", kind: 3, flags: 0, address: 0, offset: shstrtab_offset, size: len(shstrtab), link: 0, info: 0, alignment: 1, entry_size: 0 });
    kaku sections_offset = elf.align(shstrtab_offset + len(shstrtab), 8);

    kaku out: []uint8 = array.with_capacity[uint8](sections_offset + len(sections) * section_header_size);
    array.append_all(out, [uint8(127), uint8(69), uint8(76), uint8(70), uint8(2), uint8(1), uint8(1), uint8(0)]);
    elf.put(out, 0, 8);
    elf.put(out, 3, 2);                   // ET_DYN
    elf.put(out, elf.machine_x86_64, 2);
    elf.put(out, 1, 4);
    elf.put(out, 0, 8);                   // no entry point
    elf.put(out, header_size, 8);         // e_phoff
    elf.put(out, sections_offset, 8);     // e_shoff
    elf.put(out, 0, 4);
    elf.put(out, header_size, 2);
    elf.put(out, program_header_size, 2);
    elf.put(out, program_headers, 2);
    elf.put(out, section_header_size, 2);
    elf.put(out, len(sections), 2);
    elf.put(out, i_shstrtab, 2);
    // Program headers (PF_X = 1, PF_W = 2, PF_R = 4)
    program_header(out, 1, 4, 0, 0, read_end, read_end, page);
    program_header(out, 1, 5, text_offset, text_offset, text_end - text_offset, text_end - text_offset, page);
    program_header(out, 1, 6, dynamic_offset, dynamic_offset, relro_end - dynamic_offset, bss_address + spec.bss_size - dynamic_offset, page);
    program_header(out, 2, 6, dynamic_offset, dynamic_offset, dynamic_size, dynamic_size, 8);
    program_header(out, 1685382482, 4, dynamic_offset, dynamic_offset, relro_end - dynamic_offset, bss_address - dynamic_offset, 1);
    program_header(out, 1685382481, 6, 0, 0, 0, 0, 16);
    pad_to(out, gnu_hash_offset);
    array.append_all(out, gnu_hash_table);
    pad_to(out, dynsym_offset);
    array.append_all(out, dynsym);
    array.append_all(out, dynstr);
    pad_to(out, rela_plt_offset);
    array.append_all(out, rela_plt);
    pad_to(out, text_offset);
    array.append_all(out, code);
    pad_to(out, plt_offset);
    array.append_all(out, plt);
    pad_to(out, dynamic_offset);
    array.append_all(out, dynamic_table);
    array.append_all(out, got);
    pad_to(out, symtab_offset);
    array.append_all(out, symtab);
    array.append_all(out, strtab);
    array.append_all(out, shstrtab);
    pad_to(out, sections_offset);
    at = 0;
    aida (at < len(sections)) {
        kaku s = sections[at];
        section_header(out, shnames[at], s.kind, s.flags, s.address, s.offset, s.size, s.link, s.info, s.alignment, s.entry_size);
        at = at + 1;
    }
    kaesu LinkResult { bytes: out, error: "" };
}
