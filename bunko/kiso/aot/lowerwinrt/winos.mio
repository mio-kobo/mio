    x86_64.add_ri(code, x86_64.r9, 8);
    x86_64.add_ri(code, x86_64.r8, 1);
    x86_64.mov_ri(code, x86_64.r10, 0);
    x86_64.label(code, "rt.win_args.char");
    x86_64.mov_load8(code, x86_64.rax, x86_64.rsi, 0);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.win_args.end");
    x86_64.cmp_ri(code, x86_64.rax, 92);
    x86_64.jcc(code, x86_64.cc_e, "rt.win_args.backslash");
    x86_64.cmp_ri(code, x86_64.rax, 34);
    x86_64.jcc(code, x86_64.cc_e, "rt.win_args.quote");
    x86_64.test_rr(code, x86_64.r10, x86_64.r10);
    x86_64.jcc(code, x86_64.cc_ne, "rt.win_args.copy");
    x86_64.cmp_ri(code, x86_64.rax, 32);
    x86_64.jcc(code, x86_64.cc_e, "rt.win_args.space");
    x86_64.cmp_ri(code, x86_64.rax, 9);
    x86_64.jcc(code, x86_64.cc_e, "rt.win_args.space");
    x86_64.label(code, "rt.win_args.copy");
    x86_64.mov_store8(code, x86_64.rdi, 0, x86_64.rax);
    x86_64.add_ri(code, x86_64.rdi, 1);
    x86_64.add_ri(code, x86_64.rsi, 1);
    x86_64.jmp(code, "rt.win_args.char");
    x86_64.label(code, "rt.win_args.quote");
    x86_64.add_ri(code, x86_64.rsi, 1);
    x86_64.mov_ri(code, x86_64.rax, 1);
    x86_64.xor_rr(code, x86_64.r10, x86_64.rax);
    x86_64.jmp(code, "rt.win_args.char");
    // n backslashes: if followed by a quote, emit n/2 and (odd) a literal quote, else emit n
    x86_64.label(code, "rt.win_args.backslash");
    x86_64.mov_ri(code, x86_64.rcx, 0);
    x86_64.label(code, "rt.win_args.bs_count");
    x86_64.mov_load8(code, x86_64.rax, x86_64.rsi, 0);
    x86_64.cmp_ri(code, x86_64.rax, 92);
    x86_64.jcc(code, x86_64.cc_ne, "rt.win_args.bs_counted");
    x86_64.add_ri(code, x86_64.rcx, 1);
    x86_64.add_ri(code, x86_64.rsi, 1);
    x86_64.jmp(code, "rt.win_args.bs_count");
    x86_64.label(code, "rt.win_args.bs_counted");
    x86_64.cmp_ri(code, x86_64.rax, 34);
    x86_64.jcc(code, x86_64.cc_ne, "rt.win_args.bs_literal");
    x86_64.mov_rr(code, x86_64.rdx, x86_64.rcx);
    x86_64.shr_ri(code, x86_64.rdx, 1);
    x86_64.mov_ri(code, x86_64.rax, 92);
    x86_64.label(code, "rt.win_args.bs_half");
    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);
    x86_64.jcc(code, x86_64.cc_e, "rt.win_args.bs_half_done");
    x86_64.mov_store8(code, x86_64.rdi, 0, x86_64.rax);
    x86_64.add_ri(code, x86_64.rdi, 1);
    x86_64.sub_ri(code, x86_64.rdx, 1);
    x86_64.jmp(code, "rt.win_args.bs_half");
    x86_64.label(code, "rt.win_args.bs_half_done");
    x86_64.and_ri(code, x86_64.rcx, 1);
    x86_64.jcc(code, x86_64.cc_e, "rt.win_args.quote");
    x86_64.mov_ri(code, x86_64.rax, 34);
    x86_64.mov_store8(code, x86_64.rdi, 0, x86_64.rax);
    x86_64.add_ri(code, x86_64.rdi, 1);
    x86_64.add_ri(code, x86_64.rsi, 1);
    x86_64.jmp(code, "rt.win_args.char");
    x86_64.label(code, "rt.win_args.bs_literal");
    x86_64.mov_ri(code, x86_64.rax, 92);
    x86_64.label(code, "rt.win_args.bs_literal_loop");
    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);
    x86_64.jcc(code, x86_64.cc_e, "rt.win_args.char");
    x86_64.mov_store8(code, x86_64.rdi, 0, x86_64.rax);
    x86_64.add_ri(code, x86_64.rdi, 1);
    x86_64.sub_ri(code, x86_64.rcx, 1);
    x86_64.jmp(code, "rt.win_args.bs_literal_loop");
    x86_64.label(code, "rt.win_args.space");
    x86_64.add_ri(code, x86_64.rsi, 1);
    x86_64.label(code, "rt.win_args.end");
    x86_64.mov_ri(code, x86_64.rax, 0);
    x86_64.mov_store8(code, x86_64.rdi, 0, x86_64.rax);
    x86_64.add_ri(code, x86_64.rdi, 1);
    x86_64.jmp(code, "rt.win_args.next");
    x86_64.label(code, "rt.win_args.args_done");
    x86_64.mov_ri(code, x86_64.rax, 0);
    x86_64.mov_store(code, x86_64.r9, 0, x86_64.rax);
    x86_64.add_ri(code, x86_64.r9, 8);
    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 64);
    x86_64.mov_store(code, x86_64.rax, 0, x86_64.r8);
    x86_64.mov_store(code, x86_64.rsp, 80, x86_64.r9);
    // environment: every "NAME=value" entry that does not start with '=' becomes a UTF-8 string
    import_call(code, ctx, import_environment_strings);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.win_args.env_done");
    x86_64.mov_store(code, x86_64.rsp, 88, x86_64.rax);
    x86_64.label(code, "rt.win_args.env_next");
    x86_64.mov_load(code, x86_64.rsi, x86_64.rsp, 88);
    x86_64.mov_load8(code, x86_64.rax, x86_64.rsi, 0);
    x86_64.mov_load8(code, x86_64.rcx, x86_64.rsi, 1);
    x86_64.or_rr(code, x86_64.rax, x86_64.rcx);
    x86_64.jcc(code, x86_64.cc_e, "rt.win_args.env_done");
    // length in wide characters (incl. NUL) -> advance the cursor after converting
    x86_64.mov_rr(code, x86_64.rdi, x86_64.rsi);
    x86_64.label(code, "rt.win_args.env_len");
    x86_64.mov_load8(code, x86_64.rax, x86_64.rdi, 0);
    x86_64.mov_load8(code, x86_64.rcx, x86_64.rdi, 1);
    x86_64.add_ri(code, x86_64.rdi, 2);
    x86_64.or_rr(code, x86_64.rax, x86_64.rcx);
    x86_64.jcc(code, x86_64.cc_ne, "rt.win_args.env_len");
    x86_64.mov_store(code, x86_64.rsp, 88, x86_64.rdi);
    x86_64.mov_load8(code, x86_64.rax, x86_64.rsi, 0);
    x86_64.cmp_ri(code, x86_64.rax, 61);
    x86_64.jcc(code, x86_64.cc_e, "rt.win_args.env_next");
    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 72);
    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 80);
    x86_64.mov_store(code, x86_64.rdx, 0, x86_64.rax);
    x86_64.add_ri(code, x86_64.rdx, 8);
    x86_64.mov_store(code, x86_64.rsp, 80, x86_64.rdx);
    x86_64.mov_ri(code, x86_64.rcx, 65001);
    x86_64.mov_ri(code, x86_64.rdx, 0);
    x86_64.mov_rr(code, x86_64.r8, x86_64.rsi);
    x86_64.mov_ri(code, x86_64.r9, -1);
    x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rax);
    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 64);
    x86_64.mov_ri(code, x86_64.rdi, 4194304);
    x86_64.add_rr(code, x86_64.rax, x86_64.rdi);
    x86_64.mov_load(code, x86_64.rdi, x86_64.rsp, 72);
    x86_64.sub_rr(code, x86_64.rax, x86_64.rdi);
    x86_64.jcc(code, x86_64.cc_be, "rt.trap.memory");
    x86_64.mov_store(code, x86_64.rsp, 40, x86_64.rax);
    x86_64.mov_ri(code, x86_64.rax, 0);
    x86_64.mov_store(code, x86_64.rsp, 48, x86_64.rax);
    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rax);
    import_call(code, ctx, import_wide_to_multibyte);
    x86_64.zero_extend_eax(code);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.trap.memory");
    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 72);
    x86_64.add_rr(code, x86_64.rdx, x86_64.rax);
    x86_64.mov_store(code, x86_64.rsp, 72, x86_64.rdx);
    x86_64.jmp(code, "rt.win_args.env_next");
    x86_64.label(code, "rt.win_args.env_done");
    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 80);
    x86_64.mov_ri(code, x86_64.rax, 0);
    x86_64.mov_store(code, x86_64.rdx, 0, x86_64.rax);
    emit_epilogue(code);
    close_frame(code, ctx, begin, 0);
}

waza emit_win_runtime(code: x86_64.Assembler, ctx: WinContext) -> unit {
    emit_win_args(code, ctx);
    emit_win_syscall(code, ctx);
    emit_win_exit(code, ctx);
    emit_win_write(code, ctx);
    emit_win_virtual_alloc(code, ctx);
    emit_win_commit(code, ctx);
    emit_win_init(code, ctx);
    emit_win_heap_grow(code, ctx);
    emit_win_process(code, ctx);
    emit_win_testing(code, ctx);
    // Body-less native functions without a Windows implementation yet stop with an explicit runtime error.
    x86_64.label(code, "rt.os_exit");
    x86_64.mov_rr(code, x86_64.rcx, x86_64.rdi);
    x86_64.jmp(code, "rt.exit");
    x86_64.label(code, "rt.os_unsupported");
    x86_64.jmp(code, "rt.trap.unreachable");
}

// Body-less native functions: kiso/fs operations go through runtime_fs.mio (Linux protocol layer over rt.syscall);
// of the os operations only exit exists. Everything else stops at call time with the explicit runtime error
// "unsupported operation" (rt.os_unsupported).
waza os_routine(operation: string) -> string {
    moshi (operation == "argc") { kaesu "rt.os_argc"; }
    moshi (operation == "arg_size") { kaesu "rt.os_arg_size"; }
    moshi (operation == "arg_copy") { kaesu "rt.os_arg_copy"; }
    moshi (operation == "exit") { kaesu "rt.os_exit"; }
    moshi (operation == "chmod") { kaesu "rt.os_chmod"; }
    moshi (operation == "remove") { kaesu "rt.os_remove"; }
    moshi (operation == "rmdir") { kaesu "rt.os_rmdir"; }
    moshi (operation == "pid") { kaesu "rt.os_pid"; }
    moshi (operation == "real_path") { kaesu "rt.os_real_path"; }
    moshi (operation == "env_size") { kaesu "rt.os_env_size"; }
    moshi (operation == "env_copy") { kaesu "rt.os_env_copy"; }
    moshi (operation == "monotonic_ms") { kaesu "rt.os_monotonic_ms"; }
    moshi (operation == "spawn") { kaesu "rt.os_spawn"; }
    moshi (operation == "exec") { kaesu "rt.os_exec"; }
    moshi (operation == "spawn_test") { kaesu "rt.os_spawn_test"; }
    moshi (operation == "stdin_ready") { kaesu "rt.os_stdin_ready"; }
    moshi (operation == "stdin_wait") { kaesu "rt.os_stdin_wait"; }
    kaesu "";
}
waza initial_sp_cell() -> int64 { kaesu gc_state() + 72; }
