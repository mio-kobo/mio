yobu "kiso/aot/pe";
yobu "kiso/aot/lower/types";
yobu "kiso/aot/x86_64";
yobu "kiso/array";
yobu "kiso/convert";
yobu "kiso/encoding/mochi";
yobu "kiso/string";

// Pure Mio Mochi -> Linux x86-64 ELF64 lowering (scalar subset, first slice).
//
// Execution model: the Mochi operand stack is the native stack (rsp). Locals of a
// function live in its frame (rbp-relative); arguments are pushed by the caller
// and popped by the caller after the call. Globals are 64-bit slots at the start
// of the zero-filled RW segment. Anything outside the supported subset is a
// compile error: nothing is ignored, and there is no VM fallback.
koukai kata LowerResult { bytes: []uint8; error: string; }

waza failed(message: string) -> LowerResult { kaesu LowerResult { bytes: [], error: message }; }

waza block_label(prefix: string, offset: int64) -> string {
    kaesu string.concat(prefix, string.concat(".", convert.format_int(offset)));
}
waza function_label(id: int64) -> string { kaesu string.concat("fn.", convert.format_int(id)); }
waza operand_u16(data: []uint8, offset: int64) -> int64 {
    kaesu int64(data[offset + 1]) * 256 + int64(data[offset + 2]);
}

// 64-bit constant from the serialized high/low halves, as a signed value.
waza constant_value(constant: mochi.Constant) -> int64 {
    kaku high = int64(constant.bits.high);
    kaku low = int64(constant.bits.low);
    kaku tag = int64(constant.tag);
    // Fixed-width constants carry their exact payload: int8/16/32 sign-extend, uint8/16/32 zero-extend.
    moshi (tag == 5) { moshi (low >= 128) { kaesu low - 256; } kaesu low; }
    moshi (tag == 6) { moshi (low >= 32768) { kaesu low - 65536; } kaesu low; }
    moshi (tag == 7) { moshi (low >= 2147483648) { kaesu low - 4294967296; } kaesu low; }
    moshi (tag >= 8) { kaesu low; }
    moshi (high >= 2147483648) { high = high - 4294967296; }
    kaesu high * 4294967296 + low;
}

waza push(code: x86_64.Assembler, reg: int64) -> unit { x86_64.push_r(code, reg); }
waza pop(code: x86_64.Assembler, reg: int64) -> unit { x86_64.pop_r(code, reg); }

// Slot address of local `index` of a function with `parameters` parameters.
waza local_disp(parameters: int64, index: int64) -> int64 {
    moshi (index < parameters) { kaesu 16 + 8 * (parameters - 1 - index); }
    kaesu -8 * (index - parameters + 1);
}

waza emit_write_literal(code: x86_64.Assembler, label: string, length: int64, fd: int64) -> unit {
    x86_64.mov_ri(code, x86_64.rcx, fd);
    x86_64.lea_label(code, x86_64.rdx, label);
    x86_64.mov_ri(code, x86_64.r8, length);
    x86_64.call(code, "rt.write");
}

waza emit_exit(code: x86_64.Assembler, status: int64) -> unit {
    x86_64.mov_ri(code, x86_64.rcx, status);
    x86_64.call(code, "rt.exit");
}

waza data_string(code: x86_64.Assembler, label: string, text: string) -> unit {
    x86_64.label(code, label);
    kaku bytes = string.to_bytes(text);
    kaku at = 0;
    aida (at < len(bytes)) { x86_64.byte(code, int64(bytes[at])); at = at + 1; }
}

// rt.print_int: value in rax; writes the decimal text and a newline to stdout.
waza emit_print_int(code: x86_64.Assembler, ctx: WinContext) -> unit {
    kaku begin = open_frame(code, "rt.print_int", 64);
    x86_64.mov_ri(code, x86_64.r9, 0);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_ge, "rt.print_int.positive");
    x86_64.neg_r(code, x86_64.rax);
    x86_64.mov_ri(code, x86_64.r9, 1);
    x86_64.label(code, "rt.print_int.positive");
    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -1);
    x86_64.mov_ri(code, x86_64.rdx, 10);
    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);
    x86_64.mov_ri(code, x86_64.r8, 10);
    x86_64.label(code, "rt.print_int.digit");
    x86_64.mov_ri(code, x86_64.rdx, 0);
    x86_64.div_r(code, x86_64.r8);
    x86_64.add_ri(code, x86_64.rdx, 48);
    x86_64.sub_ri(code, x86_64.rsi, 1);
    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_ne, "rt.print_int.digit");
    x86_64.test_rr(code, x86_64.r9, x86_64.r9);
    x86_64.jcc(code, x86_64.cc_e, "rt.print_int.write");
    x86_64.mov_ri(code, x86_64.rdx, 45);
    x86_64.sub_ri(code, x86_64.rsi, 1);
    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);
    x86_64.label(code, "rt.print_int.write");
    x86_64.lea(code, x86_64.r8, x86_64.rbp, 0);
    x86_64.sub_rr(code, x86_64.r8, x86_64.rsi);
    x86_64.mov_rr(code, x86_64.rdx, x86_64.rsi);
    x86_64.mov_ri(code, x86_64.rcx, 1);
    x86_64.call(code, "rt.write");
    emit_epilogue(code);
    close_frame(code, ctx, begin, 64);
}

// rt.print_bool: value in rax.
waza emit_print_bool(code: x86_64.Assembler) -> unit {
    x86_64.label(code, "rt.print_bool");
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.print_bool.false");
    emit_write_literal(code, "rt.text.true", 4, 1);
    x86_64.ret(code);
    x86_64.label(code, "rt.print_bool.false");
    emit_write_literal(code, "rt.text.false", 4, 1);
    x86_64.ret(code);
}

// A trap writes its complete message (length taken from the text itself) to stderr and exits with status 1.
waza emit_trap(code: x86_64.Assembler, label: string, text_label: string, text: string) -> unit {
    x86_64.label(code, label);
    emit_write_literal(code, text_label, len(string.to_bytes(text)), 2);
    emit_exit(code, 1);
    data_string(code, text_label, text);
}

waza emit_runtime(code: x86_64.Assembler, ctx: WinContext) -> unit {
    emit_win_runtime(code, ctx);
    emit_print_int(code, ctx);
    emit_print_bool(code);
    emit_gc_runtime(code);
    emit_string_equal(code);
    emit_print_string(code);
    emit_fail_string(code);
    emit_object_runtime(code);
    emit_box_runtime(code);
    emit_fs_runtime(code);
    emit_os_runtime(code);
    emit_map_runtime(code);
    emit_trap(code, "rt.trap.nil", "rt.text.nil", "runtime error: nil reference\n");
    emit_trap(code, "rt.trap.index", "rt.text.index", "runtime error: index out of range\n");
    emit_trap(code, "rt.trap.convert", "rt.text.convert", "runtime error: integer out of range\n");
    emit_trap(code, "rt.trap.unreachable", "rt.text.unreachable", "runtime error: unsupported operation\n");
    emit_trap(code, "rt.trap.call", "rt.text.call", "runtime error: invalid call\n");
    x86_64.label(code, "rt.trap.memory");
    emit_write_literal(code, "rt.text.memory", 22, 2);
    emit_exit(code, 1);
    data_string(code, "rt.text.newline", "\n");
    data_string(code, "rt.text.nilline", "nil\n");
    data_string(code, "rt.text.memory", "runtime error: memory\n");
    x86_64.label(code, "rt.trap.divide");
    emit_write_literal(code, "rt.text.divide", 32, 2);
    emit_exit(code, 1);
    data_string(code, "rt.text.true", "hai\n");
    data_string(code, "rt.text.false", "iie\n");
    data_string(code, "rt.text.divide", "runtime error: division by zero\n");
}

waza condition_for(opcode: int64) -> int64 {
    moshi (opcode == 11) { kaesu x86_64.cc_e; }
    moshi (opcode == 12) { kaesu x86_64.cc_ne; }
    moshi (opcode == 13) { kaesu x86_64.cc_l; }
    moshi (opcode == 14) { kaesu x86_64.cc_le; }
    moshi (opcode == 15) { kaesu x86_64.cc_g; }
    kaesu x86_64.cc_ge;
}

// Data segment: word 0 = heap_next, word 1 = heap_end, 16..1552 = NativeFS handle table, 1552..3600 = directory iteration state, then the Mochi globals.
waza global_address(code: x86_64.Assembler, slot: int64) -> unit {
    x86_64.mov_ri(code, x86_64.rcx, globals_base() + slot * 8);
}

// Object header word: kind in the low byte, total size in bytes above it.
waza object_kind_string() -> int64 { kaesu 6; }

waza emit_word(code: x86_64.Assembler, value: int64) -> unit {
    kaku rest = value;
    kaku at = 0;
    aida (at < 8) {
        kaku low = rest - (rest / 256) * 256;
        x86_64.byte(code, low);
        rest = rest / 256;
        at = at + 1;
    }
}

waza string_label(index: int64) -> string { kaesu string.concat("str.", convert.format_int(index)); }

// String constants are immutable objects in the code segment: header, gc word, length, bytes.
waza emit_string_constants(code: x86_64.Assembler, file: mochi.File) -> unit {
    kaku index = 0;
    aida (index < len(file.constants)) {
        kaku constant = file.constants[index];
        moshi (int64(constant.tag) == 2) {
            x86_64.label(code, string_label(index));
            emit_word(code, object_kind_string() + 256 * (24 + len(constant.data)));
            emit_word(code, 0);
            emit_word(code, len(constant.data));
            kaku at = 0;
            aida (at < len(constant.data)) { x86_64.byte(code, int64(constant.data[at])); at = at + 1; }
        }
        index = index + 1;
    }
}

// rt.string_equal: rax, rcx = strings -> rax = 1 when equal.
waza emit_string_equal(code: x86_64.Assembler) -> unit {
    x86_64.label(code, "rt.string_equal");
    x86_64.mov_load(code, x86_64.rdx, x86_64.rax, 16);
    x86_64.mov_load(code, x86_64.r8, x86_64.rcx, 16);
    x86_64.cmp_rr(code, x86_64.rdx, x86_64.r8);
    x86_64.jcc(code, x86_64.cc_ne, "rt.string_equal.no");
    x86_64.lea(code, x86_64.rax, x86_64.rax, 24);
    x86_64.lea(code, x86_64.rcx, x86_64.rcx, 24);
    x86_64.label(code, "rt.string_equal.loop");
    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);
    x86_64.jcc(code, x86_64.cc_e, "rt.string_equal.yes");
    x86_64.mov_load8(code, x86_64.r8, x86_64.rax, 0);
    x86_64.mov_load8(code, x86_64.r9, x86_64.rcx, 0);
    x86_64.cmp_rr(code, x86_64.r8, x86_64.r9);
    x86_64.jcc(code, x86_64.cc_ne, "rt.string_equal.no");
    x86_64.add_ri(code, x86_64.rax, 1);
    x86_64.add_ri(code, x86_64.rcx, 1);
    x86_64.sub_ri(code, x86_64.rdx, 1);
    x86_64.jmp(code, "rt.string_equal.loop");
    x86_64.label(code, "rt.string_equal.yes");
    x86_64.mov_ri(code, x86_64.rax, 1);
    x86_64.ret(code);
    x86_64.label(code, "rt.string_equal.no");
    x86_64.mov_ri(code, x86_64.rax, 0);
    x86_64.ret(code);
}

// rt.fail_string: rax = message -> message and a newline on stderr, exit status 1.
waza emit_fail_string(code: x86_64.Assembler) -> unit {
    x86_64.label(code, "rt.fail_string");
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.trap.nil");
    x86_64.mov_load(code, x86_64.r8, x86_64.rax, 16);
    x86_64.lea(code, x86_64.rdx, x86_64.rax, 24);
    x86_64.mov_ri(code, x86_64.rcx, 2);
    x86_64.call(code, "rt.write");
    emit_write_literal(code, "rt.text.newline", 1, 2);
    emit_exit(code, 1);
}

// rt.print_string: rax = string -> text and a newline on stdout.
waza emit_print_string(code: x86_64.Assembler) -> unit {
    x86_64.label(code, "rt.print_string");
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_ne, "rt.print_string.text");
    emit_write_literal(code, "rt.text.nilline", 4, 1);
    x86_64.ret(code);
    x86_64.label(code, "rt.print_string.text");
    x86_64.mov_load(code, x86_64.r8, x86_64.rax, 16);
    x86_64.lea(code, x86_64.rdx, x86_64.rax, 24);
    x86_64.mov_ri(code, x86_64.rcx, 1);
    x86_64.call(code, "rt.write");
    emit_write_literal(code, "rt.text.newline", 1, 1);
    x86_64.ret(code);
}

// Emits the instructions of the main program (function_id < 0) or of one function.
waza emit_block(code: x86_64.Assembler, file: mochi.File, analysis: types.TypeAnalysis, data: []uint8,
    prefix: string, function_id: int64, parameters: int64) -> string {
    kaku offset = 0;
    aida (offset < len(data)) {
        x86_64.label(code, block_label(prefix, offset));
        kaku opcode = int64(data[offset]);
        moshi (!supported(opcode)) { kaesu string.concat("UNSUPPORTED_OPCODE ", convert.format_int(opcode)); }
        kaku step = types.type_instruction_width(opcode);
        moshi (step == 0) { kaesu string.concat("UNSUPPORTED_OPCODE ", convert.format_int(opcode)); }
        kaku operand = 0;
        moshi (step >= 3) { operand = operand_u16(data, offset); }
        moshi (opcode == 65) { operand = int64(data[offset + 1]); }
        moshi (opcode == 1) {
            moshi (operand < 0 || operand >= len(file.constants)) { kaesu "INVALID_CONSTANT_INDEX"; }
            kaku constant = file.constants[operand];
            moshi (int64(constant.tag) == 2) { x86_64.lea_label(code, x86_64.rax, string_label(operand)); push(code, x86_64.rax); }
            moshi (int64(constant.tag) == 1 || (int64(constant.tag) >= 3 && int64(constant.tag) <= 10)) { x86_64.mov_ri(code, x86_64.rax, constant_value(constant)); push(code, x86_64.rax); }
            moshi (int64(constant.tag) != 1 && int64(constant.tag) != 2 && !(int64(constant.tag) >= 3 && int64(constant.tag) <= 10)) { kaesu string.concat("UNSUPPORTED_CONSTANT_TAG ", convert.format_int(int64(constant.tag))); }
        }
        moshi (opcode >= 11 && opcode <= 16 && operand_is_string(analysis, function_id, offset)) {
            moshi (opcode >= 13) { kaesu "UNSUPPORTED_STRING_ORDERING"; }
            kaku raw = block_label(string.concat(prefix, ".sraw"), offset);
            kaku finished = block_label(string.concat(prefix, ".sdone"), offset);
            pop(code, x86_64.rcx); pop(code, x86_64.rax);
            x86_64.test_rr(code, x86_64.rax, x86_64.rax);
            x86_64.jcc(code, x86_64.cc_e, raw);
            x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);
            x86_64.jcc(code, x86_64.cc_e, raw);
            x86_64.call(code, "rt.string_equal");
            x86_64.jmp(code, finished);
            x86_64.label(code, raw);
            x86_64.cmp_rr(code, x86_64.rax, x86_64.rcx);
            x86_64.setcc_rax(code, x86_64.cc_e);
            x86_64.label(code, finished);
            moshi (opcode == 12) { x86_64.mov_ri(code, x86_64.rcx, 1); x86_64.xor_rr(code, x86_64.rax, x86_64.rcx); }
            push(code, x86_64.rax);
        }
        moshi ((opcode == 11 || opcode == 12) && (nilish(analysis, stack_node(analysis, function_id, offset, 0)) || nilish(analysis, stack_node(analysis, function_id, offset, 1))) && !operand_is_string(analysis, function_id, offset)) {
            // A value that the analysis types as non-nullable can never be nil, whatever bits it holds.
            kaku left_nil = nilish(analysis, stack_node(analysis, function_id, offset, 1));
            kaku right_nil = nilish(analysis, stack_node(analysis, function_id, offset, 0));
            kaku is_nil_case = block_label(string.concat(prefix, ".nnil"), offset);
            kaku non_nil_case = block_label(string.concat(prefix, ".nval"), offset);
            kaku finished = block_label(string.concat(prefix, ".ndone"), offset);
            pop(code, x86_64.rcx); pop(code, x86_64.rax);
            moshi (left_nil) { x86_64.test_rr(code, x86_64.rax, x86_64.rax); x86_64.jcc(code, x86_64.cc_e, is_nil_case); }
            moshi (right_nil) { x86_64.test_rr(code, x86_64.rcx, x86_64.rcx); x86_64.jcc(code, x86_64.cc_e, is_nil_case); }
            x86_64.jmp(code, non_nil_case);
            x86_64.label(code, is_nil_case);
            moshi (left_nil && right_nil) {
                x86_64.cmp_rr(code, x86_64.rax, x86_64.rcx);
                moshi (opcode == 11) { x86_64.setcc_rax(code, x86_64.cc_e); }
                moshi (opcode == 12) { x86_64.setcc_rax(code, x86_64.cc_ne); }
            }
            moshi (!(left_nil && right_nil)) { x86_64.mov_ri(code, x86_64.rax, opcode - 11); }
            x86_64.jmp(code, finished);
            x86_64.label(code, non_nil_case);
            moshi (nullable_scalar(analysis, stack_node(analysis, function_id, offset, 1))) { x86_64.mov_load(code, x86_64.rax, x86_64.rax, 16); }
            moshi (nullable_scalar(analysis, stack_node(analysis, function_id, offset, 0))) { x86_64.mov_load(code, x86_64.rcx, x86_64.rcx, 16); }
            // Two present floats compare by IEEE 754 value (-0.0 == 0.0, NaN != NaN), as without nullability.
            kaku value_kind = float_kind(analysis, stack_node(analysis, function_id, offset, 0));
            moshi (value_kind == 0) { value_kind = float_kind(analysis, stack_node(analysis, function_id, offset, 1)); }
            moshi (value_kind != 0) {
                emit_float_load(code, value_kind, 0, x86_64.rax); emit_float_load(code, value_kind, 1, x86_64.rcx);
                x86_64.ucomis(code, value_kind == 2, 0, 1);
                moshi (opcode == 11) { x86_64.setcc_rax(code, x86_64.cc_e); x86_64.setcc_rcx(code, 11); x86_64.and_rr(code, x86_64.rax, x86_64.rcx); }
                moshi (opcode == 12) { x86_64.setcc_rax(code, x86_64.cc_ne); x86_64.setcc_rcx(code, 10); x86_64.or_rr(code, x86_64.rax, x86_64.rcx); }
            } sore {
                x86_64.cmp_rr(code, x86_64.rax, x86_64.rcx);
                moshi (opcode == 11) { x86_64.setcc_rax(code, x86_64.cc_e); }
                moshi (opcode == 12) { x86_64.setcc_rax(code, x86_64.cc_ne); }
            }
            x86_64.label(code, finished);
            push(code, x86_64.rax);
        }
        moshi ((opcode == 2 || opcode == 4 || opcode == 5 || opcode == 6 || (opcode >= 11 && opcode <= 16)) && float_kind(analysis, stack_node(analysis, function_id, offset, 0)) != 0 && !nil_equality(analysis, function_id, offset, opcode)) {
            kaku fk = float_kind(analysis, stack_node(analysis, function_id, offset, 0));
            pop(code, x86_64.rcx); pop(code, x86_64.rax);
            unbox_node(code, analysis, stack_node(analysis, function_id, offset, 0), x86_64.rcx); unbox_node(code, analysis, stack_node(analysis, function_id, offset, 1), x86_64.rax);
            emit_float_load(code, fk, 0, x86_64.rax); emit_float_load(code, fk, 1, x86_64.rcx);
            kaku double = fk == 2;
            moshi (opcode == 2) { x86_64.sse_arith(code, double, 88, 0, 1); }
            moshi (opcode == 4) { x86_64.sse_arith(code, double, 92, 0, 1); }
            moshi (opcode == 5) { x86_64.sse_arith(code, double, 89, 0, 1); }
            moshi (opcode == 6) { x86_64.sse_arith(code, double, 94, 0, 1); }
            moshi (opcode <= 6) { emit_float_store(code, fk, x86_64.rax, 0); }
            moshi (opcode == 11) {
                x86_64.ucomis(code, double, 0, 1);
                x86_64.setcc_rax(code, x86_64.cc_e); x86_64.setcc_rcx(code, 11); x86_64.and_rr(code, x86_64.rax, x86_64.rcx);
            }
            moshi (opcode == 12) {
                x86_64.ucomis(code, double, 0, 1);
                x86_64.setcc_rax(code, x86_64.cc_ne); x86_64.setcc_rcx(code, 10); x86_64.or_rr(code, x86_64.rax, x86_64.rcx);
            }
            moshi (opcode == 13 || opcode == 14) {
                x86_64.ucomis(code, double, 1, 0);
                moshi (opcode == 13) { x86_64.setcc_rax(code, x86_64.cc_a); }
                moshi (opcode == 14) { x86_64.setcc_rax(code, x86_64.cc_ae); }
            }
            moshi (opcode == 15 || opcode == 16) {
                x86_64.ucomis(code, double, 0, 1);
                moshi (opcode == 15) { x86_64.setcc_rax(code, x86_64.cc_a); }
                moshi (opcode == 16) { x86_64.setcc_rax(code, x86_64.cc_ae); }
            }
            push(code, x86_64.rax);
        }
        moshi (opcode == 7 && float_kind(analysis, stack_node(analysis, function_id, offset, 0)) != 0) {
            kaku fk = float_kind(analysis, stack_node(analysis, function_id, offset, 0));
            pop(code, x86_64.rax);
            unbox_node(code, analysis, stack_node(analysis, function_id, offset, 0), x86_64.rax);
            moshi (fk == 2) { x86_64.mov_ri(code, x86_64.rcx, -9223372036854775807 - 1); }
            moshi (fk == 1) { x86_64.mov_ri(code, x86_64.rcx, 2147483648); }
