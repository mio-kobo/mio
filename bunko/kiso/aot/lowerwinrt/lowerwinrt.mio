            moshi (kind == types.type_integer) { x86_64.call(code, "rt.print_int"); }
            moshi (kind == types.type_bool) { x86_64.call(code, "rt.print_bool"); }
            moshi (kind == types.type_string_id) { x86_64.call(code, "rt.print_string"); }
        }
        moshi (opcode == 23 || opcode == 49 || opcode == 24) {
            moshi (function_id < 0) { kaesu "LOCAL_OUTSIDE_FUNCTION"; }
            moshi (operand < 0 || operand >= file.functions[function_id].local_count) { kaesu "INVALID_LOCAL_INDEX"; }
            kaku disp = local_disp(parameters, operand);
            kaku captured = operand < len(analysis.cells[function_id]) && analysis.cells[function_id][operand];
            moshi (!captured) {
                moshi (opcode == 24) {
                    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, disp);
                    convert_scalar(code, analysis, analysis.locals[function_id][operand], stack_node(analysis, function_id, offset + step, 0));
                    push(code, x86_64.rax);
                }
                moshi (opcode != 24) { pop(code, x86_64.rax); x86_64.mov_store(code, x86_64.rbp, disp, x86_64.rax); }
            }
            moshi (captured) {
                kaku node = analysis.locals[function_id][operand];
                    kaku reference = is_reference_node(analysis, node);
                moshi (opcode == 49) {
                    pop(code, x86_64.r9);
                    emit_new_cell(code, reference);
                    x86_64.mov_store(code, x86_64.rax, 16, x86_64.r9);
                    x86_64.mov_store(code, x86_64.rbp, disp, x86_64.rax);
                }
                moshi (opcode == 23) {
                    pop(code, x86_64.r9);
                    emit_cell_pointer(code, disp, reference);
                    x86_64.mov_store(code, x86_64.rax, 16, x86_64.r9);
                }
                moshi (opcode == 24) {
                    emit_cell_pointer(code, disp, reference);
                    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 16);
                    convert_scalar(code, analysis, node, stack_node(analysis, function_id, offset + step, 0));
                    push(code, x86_64.rax);
                }
            }
        }
        moshi (opcode == 44 || opcode == 46) {
            moshi (operand < 0 || operand >= len(file.functions)) { kaesu "INVALID_FUNCTION_INDEX"; }
            kaku problem = emit_closure(code, file, analysis, function_id, parameters, operand, opcode == 46);
            moshi (problem != "") { kaesu problem; }
        }
        moshi (opcode == 47 || opcode == 48) {
            moshi (function_id < 0 || operand >= len(analysis.upvalues[function_id])) { kaesu "INVALID_UPVALUE"; }
            kaku node = analysis.upvalues[function_id][operand];
            x86_64.mov_load(code, x86_64.rax, x86_64.rbp, 16 + 8 * parameters);
            x86_64.mov_load(code, x86_64.rax, x86_64.rax, 40);
            x86_64.mov_load(code, x86_64.rax, x86_64.rax, 24 + 8 * operand);
            moshi (opcode == 47) { x86_64.mov_load(code, x86_64.rax, x86_64.rax, 16); push(code, x86_64.rax); }
            moshi (opcode == 48) { pop(code, x86_64.rcx); x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx); }
        }
        moshi (opcode >= 41 && opcode <= 43) {
            kaku map_problem = emit_map_op(code, analysis, function_id, offset, step, opcode);
            moshi (map_problem != "") { kaesu map_problem; }
        }
        moshi (opcode == 66) {
            // declared representation of the value on top of the stack: enforced by the analysis, no code
        }
        moshi (opcode == 45 || opcode == 67) {
            kaku entries = analysis.blocks[function_id + 1].entry[offset];
            kaku after = analysis.blocks[function_id + 1].entry[offset + step];
            kaku returns = 0;
            moshi (len(after) == len(entries) - operand) { returns = 1; }
            moshi (opcode == 67) { returns = int64(data[offset + 3]); }
            x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 8 * operand);
            x86_64.test_rr(code, x86_64.rax, x86_64.rax);
            x86_64.jcc(code, x86_64.cc_e, "rt.trap.nil");
            x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 24);
            x86_64.cmp_ri(code, x86_64.rcx, operand);
            x86_64.jcc(code, x86_64.cc_ne, "rt.trap.call");
            x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 32);
            x86_64.cmp_ri(code, x86_64.rcx, returns);
            x86_64.jcc(code, x86_64.cc_ne, "rt.trap.call");
            x86_64.call_memory(code, x86_64.rax, 48);
            kaku site = emit_frame_descriptor(code, file, analysis, function_id, offset, parameters);
            moshi (site != "") { kaesu site; }
            x86_64.add_ri(code, x86_64.rsp, 8 * (operand + 1));
            moshi (returns == 1) { push(code, x86_64.rax); }
        }
        moshi (opcode == 25 && operand >= 0 && operand < len(file.functions) && types.is_float_predicate(file.functions[operand])) {
            // A width-polymorphic predicate (math.is_nan / is_inf / is_finite instance) has no shared argument
            // representation: evaluate it inline with the argument's width at this call site, as the darwin-arm64
            // backend does (kiso/aot/lower). Calling the shared body would read a float32 argument as float64.
            kaku argument = stack_node(analysis, function_id, offset, 0);
            kaku width = float_kind(analysis, argument);
            moshi (width != 1 && types.type_kind(analysis, argument) != types.type_float64) { kaesu "UNSAFE_FLOAT_PREDICATE_OPERAND"; }
            pop(code, x86_64.rax); unbox_node(code, analysis, argument, x86_64.rax);
            emit_float_predicate(code, width, int64(file.functions[operand].instructions[4]));
            push(code, x86_64.rax);
        } sore { moshi (opcode == 25) {
            moshi (operand < 0 || operand >= len(file.functions)) { kaesu "INVALID_FUNCTION_INDEX"; }
            kaku callee = file.functions[operand];
            x86_64.call(code, function_label(operand));
            kaku site = emit_frame_descriptor(code, file, analysis, function_id, offset, parameters);
            moshi (site != "") { kaesu site; }
            moshi (callee.parameter_count > 0) { x86_64.add_ri(code, x86_64.rsp, 8 * callee.parameter_count); }
            moshi (callee.returns_value) { push(code, x86_64.rax); }
        } }
        moshi (opcode == 26 || opcode == 27) {
            moshi (function_id < 0) { kaesu "RETURN_OUTSIDE_FUNCTION"; }
            moshi (opcode == 27) { pop(code, x86_64.rax); }
            emit_epilogue(code);
        }
        moshi (!supported(opcode)) { kaesu string.concat("UNSUPPORTED_OPCODE ", convert.format_int(opcode)); }
        moshi (raw_producer(opcode) && offset + step <= len(data)) {
            kaku produced = stack_node(analysis, function_id, offset + step, 0);
            moshi (produced >= 0 && nullable_scalar(analysis, produced)) {
                pop(code, x86_64.rax);
                x86_64.call(code, "rt.box_scalar");
                push(code, x86_64.rax);
            }
        }
        offset = offset + step;
    }
    x86_64.label(code, block_label(prefix, offset));
    kaesu "";
}

// Fresh cell in rax (kind 9 holds a scalar, kind 10 a reference). Clobbers rcx, rdx, r8.
waza emit_new_cell(code: x86_64.Assembler, reference: bool) -> unit {
    x86_64.mov_ri(code, x86_64.rax, 24);
    x86_64.call(code, "rt.alloc");
    kaku kind = 9;
    moshi (reference) { kind = 10; }
    x86_64.mov_ri(code, x86_64.rcx, 24 * 256 + kind);
    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);
}

// rax = the cell stored in the frame slot at `disp`, created on first use.
waza emit_cell_pointer(code: x86_64.Assembler, disp: int64, reference: bool) -> unit {
    kaku ready = block_label("cell_ready", len(code.bytes));
    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, disp);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_ne, ready);
    emit_new_cell(code, reference);
    x86_64.mov_store(code, x86_64.rbp, disp, x86_64.rax);
    x86_64.label(code, ready);
}

// Closure object (kind 7): [16] target, [24] parameters, [32] returns, [40] environment, [48] code address.
// Environment (kind 8): [16] count, [24 + 8i] cells of the captured variables.
waza emit_closure(code: x86_64.Assembler, file: mochi.File, analysis: types.TypeAnalysis, function_id: int64,
    parameters: int64, target: int64, captures: bool) -> string {
    kaku callee = file.functions[target];
    kaku count = len(callee.captures);
    moshi (!captures && count != 0) { kaesu "CAPTURES_WITHOUT_ENVIRONMENT"; }
    moshi (count > 0) {
        x86_64.mov_ri(code, x86_64.rax, 24 + 8 * count);
        x86_64.call(code, "rt.alloc");
        x86_64.mov_ri(code, x86_64.rcx, (24 + 8 * count) * 256 + 8);
        x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);
        x86_64.mov_ri(code, x86_64.rcx, count);
        x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);
        x86_64.push_r(code, x86_64.rax);
        kaku index = 0;
        aida (index < count) {
            kaku capture = callee.captures[index];
            moshi (capture.local) {
                moshi (function_id < 0) { kaesu "CAPTURE_OUTSIDE_FUNCTION"; }
                kaku node = analysis.locals[function_id][capture.index];
                    emit_cell_pointer(code, local_disp(parameters, capture.index), is_reference_node(analysis, node));
            }
            moshi (!capture.local) {
                moshi (function_id < 0) { kaesu "CAPTURE_OUTSIDE_FUNCTION"; }
                x86_64.mov_load(code, x86_64.rax, x86_64.rbp, 16 + 8 * parameters);
                x86_64.mov_load(code, x86_64.rax, x86_64.rax, 40);
                x86_64.mov_load(code, x86_64.rax, x86_64.rax, 24 + 8 * capture.index);
            }
            x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 0);
            x86_64.mov_store(code, x86_64.rcx, 24 + 8 * index, x86_64.rax);
            index = index + 1;
        }
    }
    moshi (count == 0) { x86_64.mov_ri(code, x86_64.rax, 0); x86_64.push_r(code, x86_64.rax); }
    x86_64.mov_ri(code, x86_64.rax, 56);
    x86_64.call(code, "rt.alloc");
    x86_64.mov_ri(code, x86_64.rcx, 56 * 256 + 7);
    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);
    x86_64.mov_ri(code, x86_64.rcx, target);
    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);
    x86_64.mov_ri(code, x86_64.rcx, callee.parameter_count);
    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rcx);
    kaku returns = 0;
    moshi (callee.returns_value) { returns = 1; }
    x86_64.mov_ri(code, x86_64.rcx, returns);
    x86_64.mov_store(code, x86_64.rax, 32, x86_64.rcx);
    x86_64.pop_r(code, x86_64.rcx);
    x86_64.mov_store(code, x86_64.rax, 40, x86_64.rcx);
    x86_64.lea_label(code, x86_64.rcx, function_label(target));
    x86_64.mov_store(code, x86_64.rax, 48, x86_64.rcx);
    push(code, x86_64.rax);
    kaesu "";
}

// 0 = not a float, 1 = float32, 2 = float64 (an unresolved float literal counts as float64).
waza float_kind(analysis: types.TypeAnalysis, node: int64) -> int64 {
    moshi (node < 0) { kaesu 0; }
    kaku kind = types.type_kind(analysis, node);
    moshi (kind == types.type_float32) { kaesu 1; }
    moshi (kind == types.type_float64 || kind == types.type_float_any) { kaesu 2; }
    kaesu 0;
}

// Float predicate on the raw bits in rax for width fk (1 float32, 2 float64): primitive 6 is_nan, 7 is_inf,
// 8 is_finite -> rax = 0/1. Clobbers rcx, rdx, xmm0.
waza emit_float_predicate(code: x86_64.Assembler, fk: int64, primitive: int64) -> unit {
    kaku double = fk == 2;
    moshi (primitive == 6) {
        emit_float_load(code, fk, 0, x86_64.rax); x86_64.ucomis(code, double, 0, 0); x86_64.setcc_rax(code, 10);
    }
    moshi (primitive == 7 || primitive == 8) {
        // exponent field all ones: infinity or NaN; infinity has a zero fraction
        kaku bits = 52; kaku mask = 2047; kaku infinity = 9218868437227405312;
        moshi (fk == 1) { bits = 23; mask = 255; infinity = 2139095040; x86_64.mov_ri(code, x86_64.rcx, 4294967295); x86_64.and_rr(code, x86_64.rax, x86_64.rcx); }
        x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);
        x86_64.shr_ri(code, x86_64.rcx, bits);
        x86_64.and_ri(code, x86_64.rcx, mask);
        x86_64.cmp_ri(code, x86_64.rcx, mask);
        moshi (primitive == 8) { x86_64.setcc_rax(code, x86_64.cc_ne); }
        moshi (primitive == 7) {
            x86_64.setcc_rcx(code, x86_64.cc_e);
            x86_64.mov_ri(code, x86_64.rdx, infinity);
            moshi (fk == 1) { x86_64.and_ri(code, x86_64.rax, 2147483647); }
            moshi (fk == 2) { x86_64.shl_ri(code, x86_64.rax, 1); x86_64.shr_ri(code, x86_64.rax, 1); }
            x86_64.cmp_rr(code, x86_64.rax, x86_64.rdx);
            x86_64.setcc_rax(code, x86_64.cc_e);
            x86_64.and_rr(code, x86_64.rax, x86_64.rcx);
        }
    }
}

// xmm0 <- rax, xmm1 <- rcx for the given float kind (1 or 2).
waza emit_float_load(code: x86_64.Assembler, kind: int64, xmm: int64, reg: int64) -> unit {
    moshi (kind == 2) { x86_64.movq_xmm_r(code, xmm, reg); }
    moshi (kind == 1) { x86_64.movd_xmm_r(code, xmm, reg); }
}
waza emit_float_store(code: x86_64.Assembler, kind: int64, reg: int64, xmm: int64) -> unit {
    moshi (kind == 2) { x86_64.movq_r_xmm(code, reg, xmm); }
    moshi (kind == 1) { x86_64.movd_r_xmm(code, reg, xmm); }
}


// Nullable scalars (int64?, bool?, float64? ...) are boxed: a pointer to a kind-11 object holding the value at
// [16], or 0 for nil. Every stack/storage slot whose analysis type is a nullable scalar holds such a box.
waza unbox_node(code: x86_64.Assembler, analysis: types.TypeAnalysis, node: int64, reg: int64) -> unit {
    moshi (node >= 0 && nullable_scalar(analysis, node)) {
        x86_64.test_rr(code, reg, reg);
        x86_64.jcc(code, x86_64.cc_e, "rt.trap.nil");
        x86_64.mov_load(code, reg, reg, 16);
    }
}

waza nilish(analysis: types.TypeAnalysis, node: int64) -> bool {
    kaesu node >= 0 && (types.type_nullable(analysis, node) || types.type_kind(analysis, node) == types.type_nil);
}

// Convert the value in rax between the representation of `source` and of `target` (box <-> raw).
// Clobbers rcx, rdx, r8, r9 when it boxes.
waza convert_scalar(code: x86_64.Assembler, analysis: types.TypeAnalysis, source: int64, target: int64) -> unit {
    moshi (source < 0 || target < 0) { kaesu; }
    moshi (types.type_kind(analysis, source) == types.type_nil) { kaesu; }
    kaku source_box = nullable_scalar(analysis, source);
    kaku target_box = nullable_scalar(analysis, target);
    moshi (source_box && !target_box) { unbox_node(code, analysis, source, x86_64.rax); }
    moshi (!source_box && target_box) { x86_64.call(code, "rt.box_scalar"); }
}

waza nil_equality(analysis: types.TypeAnalysis, function_id: int64, offset: int64, opcode: int64) -> bool {
    moshi (opcode != 11 && opcode != 12) { kaesu iie; }
    kaesu (nilish(analysis, stack_node(analysis, function_id, offset, 0)) || nilish(analysis, stack_node(analysis, function_id, offset, 1))) && !operand_is_string(analysis, function_id, offset);
}

// Element node of the array whose analysis node is `array_node` (-1 when unknown).
waza element_node(analysis: types.TypeAnalysis, array_node: int64) -> int64 {
    moshi (array_node < 0 || types.type_kind(analysis, array_node) != types.type_array_ref) { kaesu -1; }
    kaesu types.type_array_element(analysis.arena, array_node);
}

waza raw_producer(opcode: int64) -> bool {
    kaesu opcode == 1 || opcode == 8 || opcode == 9 || opcode == 10 || opcode == 34 || opcode == 7 || opcode == 2 ||
        (opcode >= 4 && opcode <= 6) || (opcode >= 11 && opcode <= 16) || (opcode >= 28 && opcode <= 29) ||
        (opcode >= 50 && opcode <= 55) || opcode == 32 || opcode == 60;
}

waza emit_box_runtime(code: x86_64.Assembler) -> unit {
    x86_64.label(code, "rt.box_scalar");
    x86_64.mov_rr(code, x86_64.r9, x86_64.rax);
    x86_64.mov_ri(code, x86_64.rax, 24);
    x86_64.call(code, "rt.alloc");
    x86_64.mov_ri(code, x86_64.rcx, 24 * 256 + 11);
    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);
    x86_64.mov_store(code, x86_64.rax, 16, x86_64.r9);
    x86_64.ret(code);
}

waza nullable_scalar_descriptor(descriptor: int64) -> bool {
    kaku kind = descriptor - (descriptor / 128) * 128;
    kaesu descriptor >= 128 && (kind == 1 || kind == 4 || kind == 2 || kind == 3 || (kind >= 12 && kind <= 17));
}

waza supported(opcode: int64) -> bool {
    kaesu (opcode >= 1 && opcode <= 20) || opcode == 22 || (opcode >= 23 && opcode <= 27) || (opcode >= 30 && opcode <= 40) || opcode == 28 || opcode == 29 || (opcode >= 50 && opcode <= 53) || opcode == 49 || (opcode >= 44 && opcode <= 48) || opcode == 66 || opcode == 67 || (opcode >= 41 && opcode <= 43) || opcode == 54 || opcode == 55 || (opcode >= 56 && opcode <= 65) || opcode == 21;
}


waza stack_node(analysis: types.TypeAnalysis, function_id: int64, offset: int64, depth: int64) -> int64 {
    kaku entries = analysis.blocks[function_id + 1].entry[offset];
    moshi (depth >= len(entries)) { kaesu -1; }
    kaesu entries[len(entries) - 1 - depth];
}

waza scalar_kind(kind: int64) -> bool {
    kaesu kind == types.type_integer || kind == types.type_bool || kind == types.type_float32 || kind == types.type_float64 || kind == types.type_float_any;
}

// Nullable scalars are boxed by the ARM64 backend; this backend does not support them yet.
waza nullable_scalar(analysis: types.TypeAnalysis, node: int64) -> bool {
    kaesu types.type_nullable(analysis, node) && scalar_kind(types.type_kind(analysis, node));
}

waza is_reference_node(analysis: types.TypeAnalysis, node: int64) -> bool {
    kaesu types.type_is_heap_reference(analysis, node);
}

// Wrap rax to the fixed-width integer type described by `descriptor` (12..17 = int8..uint32 as in the analysis).
waza emit_normalize(code: x86_64.Assembler, descriptor: int64) -> unit {
    moshi (descriptor < 12 || descriptor > 17) { kaesu; }
    kaku width = 8;
    moshi (descriptor == 13 || descriptor == 16) { width = 16; }
    moshi (descriptor == 14 || descriptor == 17) { width = 32; }
    x86_64.shl_ri(code, x86_64.rax, 64 - width);
    moshi (descriptor <= 14) { x86_64.sar_ri(code, x86_64.rax, 64 - width); }
    moshi (descriptor > 14) { x86_64.shr_ri(code, x86_64.rax, 64 - width); }
}

waza array_width(descriptor: int64) -> int64 {
    moshi (descriptor == 15) { kaesu 1; }
    kaesu 8;
}
waza array_is_reference(descriptor: int64) -> bool {
    kaku nullable = descriptor >= 128;
    kaku kind = descriptor - (descriptor / 128) * 128;
    kaesu nullable || kind == 5 || kind == 7 || kind == 8 || kind == 9 || kind == 10 || kind == 11;
}
waza inferred_descriptor(analysis: types.TypeAnalysis, node: int64) -> int64 {
    kaku root = node;
    aida (analysis.arena.parent[root] != root) { root = analysis.arena.parent[root]; }
    kaku fields = analysis.arena.fields[root];
    moshi (len(fields) == 0) { kaesu -1; }
    kaku element = fields[0];
    kaku kind = types.type_kind(analysis, element);
    moshi (kind == types.type_unknown) { kaesu -1; }
    kaku descriptor = 1;
    moshi (analysis.arena.array_width[root] == 1) { descriptor = 15; }
    moshi (kind == types.type_string_id) { descriptor = 5; }
    moshi (kind == types.type_array_ref) { descriptor = 7; }
    moshi (kind == types.type_struct_ref) { descriptor = 8; }
    moshi (kind == types.type_enum_ref) { descriptor = 9; }
    moshi (kind == types.type_map_ref) { descriptor = 10; }
    moshi (kind == types.type_function_ref) { descriptor = 11; }
    moshi (types.type_nullable(analysis, element)) { descriptor = descriptor + 128; }
    kaesu descriptor;
}

// rdi = length, rsi = capacity are set by the caller; this loads width/reference and calls rt.array_new.
waza emit_array_new_call(code: x86_64.Assembler, descriptor: int64) -> unit {
    x86_64.mov_ri(code, x86_64.rdx, array_width(descriptor));
    kaku reference = 0;
    moshi (array_is_reference(descriptor)) { reference = 1; }
    x86_64.mov_ri(code, x86_64.r8, reference);
    x86_64.call(code, "rt.array_new");
}

// Allocates a struct (kind 1) or enum (kind 2) with `count` payload words taken from the stack.
waza emit_record(code: x86_64.Assembler, analysis: types.TypeAnalysis, function_id: int64, offset: int64,
    kind: int64, tag: int64, count: int64) -> string {
    moshi (count > 62) { kaesu "UNSUPPORTED_LARGE_RECORD"; }
    kaku bitmap = 0;
    kaku power = 1;
    kaku field = 0;
    aida (field < count) {
        kaku node = stack_node(analysis, function_id, offset, count - 1 - field);
        moshi (node < 0) { kaesu "MISSING_TYPE_INFO"; }
        moshi (types.type_kind(analysis, node) == types.type_unknown) { kaesu "UNSUPPORTED_UNKNOWN_FIELD"; }
        moshi (is_reference_node(analysis, node)) { bitmap = bitmap + power; }
        power = power * 2;
        field = field + 1;
    }
    kaku size = 40 + 8 * count;
    x86_64.mov_ri(code, x86_64.rax, size);
    x86_64.call(code, "rt.alloc");
    x86_64.mov_ri(code, x86_64.rcx, size * 256 + kind);
    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);
    x86_64.mov_ri(code, x86_64.rcx, count);
    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);
    x86_64.mov_ri(code, x86_64.rcx, bitmap);
    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rcx);
    x86_64.mov_ri(code, x86_64.rcx, tag);
    x86_64.mov_store(code, x86_64.rax, 32, x86_64.rcx);
    field = count;
    aida (field > 0) {
        field = field - 1;
        pop(code, x86_64.rcx);
        x86_64.mov_store(code, x86_64.rax, 40 + 8 * field, x86_64.rcx);
    }
    push(code, x86_64.rax);
    kaesu "";
}

// Dereference a record in rax and load payload word `index` (null checked).
waza emit_record_load(code: x86_64.Assembler, index: int64) -> unit {
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.trap.nil");
    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 40 + 8 * index);
}

waza emit_array_op_check(analysis: types.TypeAnalysis, function_id: int64, offset: int64, depth: int64) -> string {
    kaku node = stack_node(analysis, function_id, offset, depth);
    moshi (node < 0) { kaesu "MISSING_TYPE_INFO"; }
    moshi (types.type_kind(analysis, node) != types.type_array_ref) { kaesu "UNSUPPORTED_ARRAY_OPERAND"; }
    kaesu "";
}

// True when the two operands on top of the stack at `offset` are strings.
waza operand_is_string(analysis: types.TypeAnalysis, function_id: int64, offset: int64) -> bool {
    kaku entries = analysis.blocks[function_id + 1].entry[offset];
    moshi (len(entries) < 2) { kaesu iie; }
    kaesu types.type_kind(analysis, entries[len(entries) - 1]) == types.type_string_id && types.type_kind(analysis, entries[len(entries) - 2]) == types.type_string_id;
}

waza emit_function(code: x86_64.Assembler, ctx: WinContext, file: mochi.File, analysis: types.TypeAnalysis, index: int64, reachable: bool) -> string {
    kaku function = file.functions[index];
    moshi (!reachable) {
        kaku dead = open_frame(code, function_label(index), 0);
        x86_64.call(code, "rt.trap.unreachable");
        emit_epilogue(code);
        close_frame(code, ctx, dead, 0);
        kaesu "";
    }
    moshi (len(function.instructions) == 0 && (types.is_testing_report(function.name) || types.is_testing_packet(function.name))) {
        moshi (function.parameter_count != 2 || function.returns_value || len(function.captures) != 0) { kaesu "INVALID_TESTING_REPORT"; }
        kaku report_begin = open_frame(code, function_label(index), 0);
        x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, local_disp(2, 0));
        unbox_node(code, analysis, analysis.locals[index][0], x86_64.rdi);
        x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, local_disp(2, 1));
        x86_64.mov_ri(code, x86_64.rdx, 0);
        moshi (types.is_testing_packet(function.name)) { x86_64.mov_ri(code, x86_64.rdx, 1); }
        x86_64.call(code, "rt.testing_report");
        emit_epilogue(code);
        close_frame(code, ctx, report_begin, 0);
        kaesu "";
    }
    moshi (len(function.instructions) == 0) {
        kaku operation = native_operation(function.name);
        kaku routine = native_routine(operation);
        moshi (routine == "") { routine = "rt.os_unsupported"; }
        moshi (routine != "rt.os_unsupported" && function.parameter_count > 6) { kaesu "UNSUPPORTED_NATIVE_ARITY"; }
        kaku native_begin = open_frame(code, function_label(index), 0);
        kaku registers: []int64 = [x86_64.rdi, x86_64.rsi, x86_64.rdx, x86_64.rcx, x86_64.r8, x86_64.r9];
        kaku arg = 0;
        aida (arg < function.parameter_count && routine != "rt.os_unsupported") {
            x86_64.mov_load(code, registers[arg], x86_64.rbp, local_disp(function.parameter_count, arg));
            arg = arg + 1;
        }
        x86_64.call(code, routine);
        emit_epilogue(code);
        close_frame(code, ctx, native_begin, 0);
        kaesu "";
    }
    kaku locals = function.local_count - function.parameter_count;
    moshi (locals < 0) { kaesu "INVALID_LOCAL_COUNT"; }
    kaku alloc = 8 * locals;
    kaku begin = open_frame(code, function_label(index), alloc);
    moshi (locals > 0) {
        x86_64.mov_ri(code, x86_64.rax, 0);
        kaku slot = 0;
        aida (slot < locals) { x86_64.mov_store(code, x86_64.rbp, -8 * (slot + 1), x86_64.rax); slot = slot + 1; }
    }
    kaku param = 0;
    aida (param < function.parameter_count) {
        moshi (param < len(analysis.cells[index]) && analysis.cells[index][param]) {
            kaku node = analysis.locals[index][param];
            emit_new_cell(code, is_reference_node(analysis, node));
            x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, local_disp(function.parameter_count, param));
            x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);
            x86_64.mov_store(code, x86_64.rbp, local_disp(function.parameter_count, param), x86_64.rax);
        }
        param = param + 1;
    }
    kaku entry_poll = emit_poll(code, file, analysis, index, 0, function.parameter_count);
    moshi (entry_poll != "") { kaesu string.concat(function.name, string.concat(": ", entry_poll)); }
    kaku body = emit_block(code, file, analysis, function.instructions, string.concat("f", convert.format_int(index)), index, function.parameter_count);
    moshi (body != "") { kaesu string.concat(function.name, string.concat(": ", body)); }
    emit_epilogue(code);
    close_frame(code, ctx, begin, alloc);
    kaesu "";
}

// First-collection threshold in bytes allocated; the default is 32 MiB. Tests use tiny values to force frequent collections.
koukai waza compile(file: mochi.File) -> LowerResult { kaesu compile_with_gc_threshold(file, 33554432); }

koukai waza compile_with_gc_threshold(file: mochi.File, gc_threshold: int64) -> LowerResult {
    moshi (gc_threshold < 4096) { kaesu failed("INVALID_GC_THRESHOLD"); }
    kaku analysis = types.analyze_types(file);
    kaku ctx = WinContext { patches: [], frames: [] };
    kaku code = x86_64.assembler();
    kaku begin = open_frame(code, "start", 0);
    // The loader's rbp is replaced by 0: the collector's frame walk ends at the main program frame.
    x86_64.mov_ri(code, x86_64.rax, 0);
    x86_64.mov_store(code, x86_64.rbp, 0, x86_64.rax);
    x86_64.mov_ri(code, x86_64.rcx, initial_sp_cell());
    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rsp);
    x86_64.call(code, "rt.init");
    x86_64.call(code, "rt.win_args");
    x86_64.mov_ri(code, x86_64.rcx, gc_state());
    x86_64.mov_ri(code, x86_64.rax, gc_threshold);
    x86_64.mov_store(code, x86_64.rcx, 16, x86_64.rax);
    x86_64.mov_store(code, x86_64.rcx, 64, x86_64.rax);
    kaku problem = emit_block(code, file, analysis, file.instructions, "main", -1, 0);
    moshi (problem != "") { kaesu failed(string.concat("main: ", problem)); }
    moshi (uses_testing(file)) {
        x86_64.mov_ri(code, x86_64.rdi, 0);
        moshi (uses_testing_packet(file)) { x86_64.mov_ri(code, x86_64.rdi, 1); }
        x86_64.call(code, "rt.testing_finish");
    }
    emit_exit(code, 0);
    emit_epilogue(code);
    close_frame(code, ctx, begin, 0);
    kaku reached = types.reachable_functions(file);
    kaku index = 0;
    aida (index < len(file.functions)) {
        kaku failure = emit_function(code, ctx, file, analysis, index, reached[index]);
        moshi (failure != "") { kaesu failed(failure); }
        index = index + 1;
    }
    emit_runtime(code, ctx);
    emit_globals_map(code, file, analysis);
    emit_string_constants(code, file);
    kaku assembled = x86_64.assemble(code);
    moshi (assembled.error != "") { kaesu failed(assembled.error); }
    kaku bss = 8192 + 2097152 + 131072 + 8 * file.global_count + 32;
    kaku image = pe.executable_placed(pe.ImageSpec { text: assembled.bytes, rdata: [], data: [], zero_fill: bss, entry: 0,
        imports: [pe.ImportLibrary { name: "KERNEL32.dll", symbols: ["GetStdHandle", "WriteFile", "ExitProcess", "VirtualAlloc", "CreateFileW", "ReadFile", "CloseHandle", "MultiByteToWideChar", "GetLastError", "GetFileAttributesW", "CreateDirectoryW", "FindFirstFileW", "FindNextFileW", "FindClose", "WideCharToMultiByte", "GetCommandLineW", "GetEnvironmentStringsW", "DeleteFileW", "RemoveDirectoryW", "GetCurrentProcessId", "GetTickCount64", "GetFullPathNameW", "GetModuleFileNameW", "CreateProcessW", "WaitForSingleObject", "GetExitCodeProcess", "TerminateProcess", "GetStartupInfoW", "PeekNamedPipe", "GetFileType", "Sleep"] }],
        patches: ctx.patches, unwind: [] }, ctx.frames, 67108864, data_rva);
    moshi (image.error != mu) { kaesu failed("PE_IMAGE_ERROR"); }
    kaesu LowerResult { bytes: image.bytes, error: "" };
}
