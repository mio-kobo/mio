yobu "kiso/array";
yobu "kiso/string";

// 空指令体是原生声明在 Mochi 中的既有表示。专用前缀携带固定原型，
// 普通 Mio 和 MMA 函数都不能使用这一命名空间。
koukai teisu prefix = "$cabi::";
// 间接调用的保留符号：第一个参数是目标函数指针（cptr，通常来自 dlsym），其余参数是 C 参数。
koukai teisu indirect_symbol = "mio_ffi_indirect";
// 保留 "require native darwin-arm64" 这一段措辞：Darwin 回归测试按它匹配跨目标构建的拒绝诊断。
koukai teisu target_error = "E_CABI C ABI declarations require native darwin-arm64 or linux-amd64 on a matching host";

// 唯一带有 C ABI 后端的目标。其余目标（linux-arm64、darwin-amd64、windows-*）一律在编译期拒绝，
// 不会退回 Mio 内部调用约定。
koukai waza supports_target(target: string) -> bool { kaesu target == "darwin-arm64" || target == "linux-amd64"; }

koukai waza is_external(name: string) -> bool { kaesu string.has_prefix(name, prefix); }

koukai waza valid_symbol(name: string) -> bool {
    kaku bytes = string.to_bytes(name);
    moshi (name == "main" || len(bytes) == 0 || len(bytes) > 1024) { kaesu iie; }
    kaku at = 0;
    aida (at < len(bytes)) {
        kaku b = int64(bytes[at]);
        moshi (!(b == 95 || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (at > 0 && b >= 48 && b <= 57))) { kaesu iie; }
        at = at + 1;
    }
    kaesu hai;
}

koukai waza type_code(name: string) -> string {
    moshi (name == "unit") { kaesu "v"; }
    moshi (name == "int8") { kaesu "a"; }
    moshi (name == "uint8") { kaesu "b"; }
    moshi (name == "int16") { kaesu "c"; }
    moshi (name == "uint16") { kaesu "d"; }
    moshi (name == "int32") { kaesu "e"; }
    moshi (name == "uint32") { kaesu "f"; }
    moshi (name == "int64") { kaesu "g"; }
    moshi (name == "uint64") { kaesu "h"; }
    moshi (name == "float32") { kaesu "i"; }
    moshi (name == "float64") { kaesu "j"; }
    moshi (name == "cptr") { kaesu "k"; }
    moshi (name == "bool") { kaesu "l"; }
    kaesu "";
}

// 参数专用代码：[]uint8 传递数据首地址（"m"），数组仍归 Mio 所有，指针只在调用期间有效。
koukai waza param_code(name: string, element: string) -> string {
    moshi (name == "[]") { moshi (element == "uint8") { kaesu "m"; } kaesu ""; }
    moshi (element != "") { kaesu ""; }
    kaesu type_code(name);
}

koukai kata Signature { symbol: string; result: int64; parameters: []int64; valid: bool; indirect: bool; }

koukai waza signature(name: string, count: int64, returns_value: bool) -> Signature {
    kaku invalid = Signature { symbol: "", result: 0, parameters: [], valid: iie, indirect: iie };
    moshi (!is_external(name) || count < 0 || count > 256) { kaesu invalid; }
    kaku bytes = string.to_bytes(name);
    kaku at = 7;
    kaku symbol_bytes: []uint8 = [];
    aida (at < len(bytes) && bytes[at] != uint8(58)) { array.push(symbol_bytes, bytes[at]); at = at + 1; }
    kaku symbol = string.from_utf8(symbol_bytes);
    moshi (symbol == mu) { kaesu invalid; }
    moshi (!valid_symbol(symbol) || len(bytes) != at + 2 + count || bytes[at] != uint8(58)) { kaesu invalid; }
    kaku result = int64(bytes[at + 1]);
    moshi ((result != 118 && (result < 97 || result > 108)) || returns_value != (result != 118)) { kaesu invalid; }
    kaku parameters = array.with_capacity[int64](count);
    at = at + 2;
    aida (at < len(bytes)) {
        kaku parameter = int64(bytes[at]);
        moshi (parameter < 97 || parameter > 109) { kaesu invalid; }
        array.push(parameters, parameter);
        at = at + 1;
    }
    kaku indirect = symbol == indirect_symbol;
    moshi (indirect && (len(parameters) == 0 || parameters[0] != 107)) { kaesu invalid; }
    kaesu Signature { symbol: symbol, result: result, parameters: parameters, valid: hai, indirect: indirect };
}
