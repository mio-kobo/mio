yobu "kiso/testing";

waza test_fixed_c_signature() -> unit {
    kaku parsed = signature("$cabi::mio_sum:eigk", 3, hai);
    testing.expect(parsed.valid && parsed.symbol == "mio_sum", "symbol survives Mochi metadata");
    testing.expect(parsed.result == 101 && len(parsed.parameters) == 3, "C prototype result and arity");
    testing.expect(!signature("$cabi::mio_sum:eigk", 2, hai).valid, "arity mismatch");
    testing.expect(!signature("$cabi::mio_sum:vv", 1, iie).valid, "void parameter");
    testing.expect(!signature("$cabi::mio-sum:v", 0, iie).valid, "invalid external symbol");
    testing.expect(!signature("$cabi::mio_sum:z", 0, hai).valid, "unknown result type");
    testing.expect(is_external("$cabi::mio_sum:v") && !is_external("ordinary"), "isolated external namespace");
    testing.expect(valid_symbol("mio_sum") && !valid_symbol("main"), "the Mio entry is reserved");
    testing.expect(type_code("float64") == "j" && type_code("string") == "", "supported scalar names");
}

waza test_c_target_capabilities() -> unit {
    testing.expect(supports_target("darwin-arm64") && supports_target("linux-amd64"), "the two C ABI backends");
    testing.expect(!supports_target("linux-arm64") && !supports_target("darwin-amd64"), "no C ABI backend on the other Unix targets");
    testing.expect(!supports_target("windows-amd64") && !supports_target("windows-arm64") && !supports_target(""), "no C ABI backend on Windows");
}

waza test_export_and_indirect_call_signatures() -> unit {
    kaku external = signature("$cabi::mio_ffi_indirect:gkm", 2, hai);
    testing.expect(external.valid && external.indirect, "indirect call accepts a target pointer and buffer");
    testing.expect(!signature("$cabi::mio_ffi_indirect:gg", 1, hai).valid, "indirect call requires a target pointer");

    kaku exported = export_signature("$export::mio_ffi_indirect:gg", 1, hai);
    testing.expect(exported.valid && !exported.indirect, "the same symbol is an ordinary scalar export");
    testing.expect(!export_signature("$export::mio_ffi_v1_state:gg", 1, hai).valid, "runtime export names are reserved");
    testing.expect(!export_signature("$export::mio_buffer:gm", 1, hai).valid, "exports only accept scalar parameters");
}
