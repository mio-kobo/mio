yobu "kiso/aot/arm64";
yobu "kiso/encoding/binary";
yobu "kiso/testing";

waza test_mach_o_header_layout_and_limits() -> unit {
    kaku words: []uint32 = [arm64.movz_x(0, 0, 0).word, arm64.movz_x(16, 1, 0).word, arm64.svc(128).word];
    kaku constants: []uint8 = [77, 105, 111, 0, 228, 184, 173, 240, 159, 140, 159];
    kaku patches: []AddressPatch = [];
    kaku image = executable(ImageSpec { words: words, constants: constants, globals: 1, patches: patches });
    testing.expect(image.error == mu && len(image.bytes) == 32768, "text and data pages emitted");
    testing.expect(binary.read_u32_le(image.bytes, 0).value == uint32(4277009103), "Mach-O 64 magic");
    testing.expect(binary.read_u32_le(image.bytes, 4).value == uint32(16777228), "ARM64 CPU type");
    testing.expect(binary.read_u32_le(image.bytes, 16).value == uint32(9), "load command count");
    testing.expect(binary.read_u32_le(image.bytes, 768).value == words[0], "entry machine code is little endian");
    testing.expect(image.layout.const_offset == 784 && image.bytes[784] == uint8(77) && image.bytes[787] == uint8(0), "constant bytes preserve embedded NUL");
    testing.expect(executable(ImageSpec { words: [], constants: [], globals: 0, patches: patches }).error != mu, "empty text rejected");
    testing.expect(executable(ImageSpec { words: words, constants: [], globals: 2049, patches: patches }).error != mu, "global limit rejected");
}

waza test_image_address_patch_bounds() -> unit {
    kaku words: []uint32 = [uint32(0), uint32(0), arm64.ret().word];
    kaku constants: []uint8 = [1, 2, 3];
    kaku good: []AddressPatch = [AddressPatch { at_word: 0, add_at_word: 1, target: const_target(), target_offset: 0, register: 8 }];
    kaku image = executable(ImageSpec { words: words, constants: constants, globals: 0, patches: good });
    testing.expect(image.error == mu && binary.read_u32_le(image.bytes, 768).value != uint32(0), "layout-time ADRP patched");
    kaku bad: []AddressPatch = [AddressPatch { at_word: 9, add_at_word: -1, target: data_target(), target_offset: 0, register: 8 }];
    testing.expect(executable(ImageSpec { words: words, constants: [], globals: 0, patches: bad }).error != mu, "out-of-bounds patch rejected");
}
