yobu "kiso/testing";

waza test_address_validation_and_listener_lifecycle() -> unit {
    kaku bad = IPv4Address { octets: [uint8(127)], port: 1234 };
    kaku invalid = connect(bad);
    testing.expect(invalid.connection == mu && invalid.error != mu, "IPv4 must contain exactly four octets");

    kaku invalid_port = connect(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), -1));
    testing.expect(invalid_port.error != mu, "invalid port must fail without opening a socket");

    kaku server = listen(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), 0));
    testing.expect(server.error == mu, "loopback listener should bind to an ephemeral port");
    kaku listener = server.listener;
    moshi (listener != mu) {
        kaku first = close_listener(listener);
        testing.expect(first.error == mu, "listener must close successfully");
        kaku second = close_listener(listener);
        testing.expect(second.error != mu, "closing a stale handle must fail safely");
    }
}

// Loopback round trip on one thread: the kernel completes connect() through the listen backlog, so connect, accept,
// write and read can run in sequence. Covers byte transfer, EOF after the peer closes, errors on closed handles and a
// refused connection to a port nobody listens on.
waza test_loopback_roundtrip_eof_and_errors() -> unit {
    kaku port = 41000;
    kaku server = listen(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    aida (server.error != mu && port < 41050) {
        port = port + 1;
        server = listen(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    }
    testing.expect(server.error == mu, "a loopback listener can be created");
    kaku listener = server.listener;
    moshi (listener == mu) { kaesu; }
    kaku client = connect(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    testing.expect(client.error == mu, "connect to the listener succeeds");
    kaku accepted = accept(listener);
    testing.expect(accepted.error == mu, "accept returns the pending connection");
    kaku maybe_out = client.connection;
    kaku maybe_in = accepted.connection;
    moshi (maybe_out == mu) { close_listener(listener); kaesu; }
    moshi (maybe_in == mu) { close_listener(listener); kaesu; }
    kaku outgoing = maybe_out;
    kaku incoming = maybe_in;
    moshi (hai) {
        kaku payload: []uint8 = [uint8(104), uint8(105), uint8(33)];
        kaku sent = write_all(outgoing, payload, 0, 3);
        testing.expect(sent.error == mu && sent.count == 3, "all bytes are written");
        kaku buffer = array.make[uint8](16, uint8(0));
        kaku received = read(incoming, buffer, 0, 16);
        testing.expect(received.error == mu && received.count == 3 && !received.eof, "the bytes arrive");
        testing.expect(buffer[0] == uint8(104) && buffer[1] == uint8(105) && buffer[2] == uint8(33), "the bytes are intact");
        kaku zero = read(incoming, buffer, 0, 0);
        testing.expect(zero.error == mu && zero.count == 0 && !zero.eof, "a zero-length read is not EOF");
        testing.expect(read(incoming, buffer, 0, 99).error != mu, "a range outside the buffer is rejected");
        testing.expect(close(outgoing).error == mu, "the client closes");
        kaku finished = read(incoming, buffer, 0, 16);
        testing.expect(finished.error == mu && finished.count == 0 && finished.eof, "EOF after the peer closed");
        testing.expect(write(outgoing, payload, 0, 3).error != mu, "writing on a closed connection fails");
        testing.expect(close(outgoing).error != mu, "closing twice fails");
        testing.expect(close(incoming).error == mu, "the server side closes");
    }
    testing.expect(close_listener(listener).error == mu, "the listener closes");
    kaku refused = connect(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    testing.expect(refused.connection == mu && refused.error != mu, "a connection to a closed port is refused");
    kaku in_use = listen(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    testing.expect(in_use.error == mu, "the port can be listened on again after close");
    kaku again = in_use.listener;
    moshi (again != mu) {
        kaku clash = listen(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
        testing.expect(clash.error != mu, "a second listener on the same port reports address in use");
        close_listener(again);
    }
}

// listen_with_backlog and the kiso/io adapters over a loopback connection.
waza test_backlog_and_io_adapters() -> unit {
    kaku port = 41100;
    kaku server = listen_with_backlog(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port), 4);
    aida (server.error != mu && port < 41150) {
        port = port + 1;
        server = listen_with_backlog(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port), 4);
    }
    testing.expect(server.error == mu, "a listener with an explicit backlog can be created");
    testing.expect(listen_with_backlog(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), 0), -1).error != mu, "a negative backlog is rejected");
    kaku listener = server.listener;
    moshi (listener == mu) { kaesu; }
    kaku client = connect(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    kaku accepted = accept(listener);
    kaku maybe_out = client.connection; kaku maybe_in = accepted.connection;
    moshi (maybe_out == mu) { close_listener(listener); kaesu; }
    moshi (maybe_in == mu) { close_listener(listener); kaesu; }
    kaku outgoing = maybe_out; kaku incoming = maybe_in;
    kaku sent = io.write_all(writer(outgoing), [77, 105, 111], 0, 3);
    testing.expect(sent.count == 3 && sent.error == mu, "io.write_all through the connection writer");
    kaku buffer = array.make[uint8](3, uint8(0));
    kaku got = io.read_full(reader(incoming), buffer, 0, 3);
    testing.expect(got.count == 3 && buffer[0] == uint8(77) && buffer[2] == uint8(111), "io.read_full through the connection reader");
    close(outgoing); close(incoming);
    testing.expect(close_listener(listener).error == mu, "the listener closes");
}
