yobu "kiso/testing";

waza tcp_error_code(failure: TcpError?) -> int64 {
    moshi (failure == mu) { kaesu 0; }
    awase (failure) {
        baai InvalidArgument { kaesu 1; }
        baai Closed { kaesu 2; }
        baai TimedOut { kaesu 3; }
        baai ConnectionRefused { kaesu 4; }
        baai ConnectionReset { kaesu 5; }
        baai AddressInUse { kaesu 6; }
        baai PermissionDenied { kaesu 7; }
        baai WouldBlock { kaesu 8; }
        baai Other(message) { kaesu 9; }
    }
    kaesu 9;
}

waza test_address_validation_and_listener_lifecycle() -> unit {
    kaku bad = IPv4Address { octets: [uint8(127)], port: 1234 };
    kaku invalid = connect(bad);
    testing.expect(invalid.connection == mu && tcp_error_code(invalid.error) == 1, "IPv4 must contain exactly four octets");

    kaku invalid_port = connect(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), -1));
    testing.expect(tcp_error_code(invalid_port.error) == 1, "invalid port must fail without opening a socket");

    kaku server = listen(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), 0));
    testing.expect(server.error == mu, "loopback listener should bind to an ephemeral port");
    kaku listener = server.listener;
    moshi (listener != mu) {
        kaku first = close_listener(listener);
        testing.expect(first.error == mu, "listener must close successfully");
        kaku second = close_listener(listener);
        testing.expect(tcp_error_code(second.error) == 2, "closing a stale handle reports Closed");
        kaku stale = accept(listener);
        testing.expect(stale.connection == mu && tcp_error_code(stale.error) == 2, "accept on a closed listener reports Closed");
    }
}

// Loopback round trip on one thread: the kernel completes connect() through the listen backlog, so connect, accept,
// write and read can run in sequence. Covers byte transfer, EOF after the peer closes, errors on closed handles and a
// refused connection to a port nobody listens on.
waza test_loopback_roundtrip_eof_and_errors() -> unit {
    kaku port = 41000;
    kaku server = listen(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    aida (server.error != mu && port < 41050) {
        port = port + 1;
        server = listen(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    }
    testing.expect(server.error == mu, "a loopback listener can be created");
    kaku listener = server.listener;
    moshi (listener == mu) { kaesu; }
    kaku client = connect(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    testing.expect(client.error == mu, "connect to the listener succeeds");
    kaku maybe_out = client.connection;
    moshi (maybe_out == mu) { close_listener(listener); kaesu; }
    kaku accepted = accept(listener);
    testing.expect(accepted.error == mu, "accept returns the pending connection");
    kaku maybe_in = accepted.connection;
    moshi (maybe_in == mu) { close(maybe_out); close_listener(listener); kaesu; }
    kaku outgoing = maybe_out;
    kaku incoming = maybe_in;
    moshi (hai) {
        kaku payload: []uint8 = [uint8(104), uint8(105), uint8(33)];
        kaku sent = write_all(outgoing, payload, 1, 1);
        testing.expect(sent.error == mu && sent.count == 1, "the byte at the source offset is written");
        kaku buffer = array.make[uint8](16, uint8(0));
        kaku received = read(incoming, buffer, 2, 12);
        testing.expect(received.error == mu && received.count == 1 && !received.eof, "a short read returns available data");
        testing.expect(buffer[1] == uint8(0) && buffer[2] == uint8(105) && buffer[3] == uint8(0), "only the byte at the destination offset changes");
        kaku zero = read(incoming, buffer, 0, 0);
        testing.expect(zero.error == mu && zero.count == 0 && !zero.eof, "a zero-length read is not EOF");
        testing.expect(tcp_error_code(read(incoming, buffer, 0, 99).error) == 1, "a read outside the buffer is rejected");
        testing.expect(tcp_error_code(write(outgoing, payload, -1, 1).error) == 1, "a write outside the buffer is rejected");
        kaku zero_write = write(outgoing, payload, len(payload), 0);
        testing.expect(zero_write.error == mu && zero_write.count == 0, "a zero-length write succeeds");
        testing.expect(close(outgoing).error == mu, "the client closes");
        kaku finished = read(incoming, buffer, 0, 16);
        testing.expect(finished.error == mu && finished.count == 0 && finished.eof, "EOF after the peer closed");
        testing.expect(write(outgoing, payload, 0, 3).error != mu, "writing on a closed connection fails");
        testing.expect(close(outgoing).error != mu, "closing twice fails");
        testing.expect(close(incoming).error == mu, "the server side closes");
    }
    testing.expect(close_listener(listener).error == mu, "the listener closes");
    kaku refused = connect(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    testing.expect(refused.connection == mu && tcp_error_code(refused.error) == 4, "a connection to a closed port reports ConnectionRefused");
    kaku in_use = listen(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    testing.expect(in_use.error == mu, "the port can be listened on again after close");
    kaku again = in_use.listener;
    moshi (again != mu) {
        kaku clash = listen(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
        testing.expect(clash.listener == mu && tcp_error_code(clash.error) == 6, "a second listener on the same port reports AddressInUse");
        close_listener(again);
    }
    kaku wildcard = listen(ipv4(uint8(0), uint8(0), uint8(0), uint8(0), port)).listener;
    testing.expect(wildcard != mu, "the wildcard listener can bind after close");
    moshi (wildcard != mu) {
        kaku clash = listen(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
        testing.expect(clash.listener == mu && tcp_error_code(clash.error) == 6, "an overlapping wildcard listener reports AddressInUse");
        close_listener(wildcard);
    }
}

// listen_with_backlog and the kiso/io adapters over a loopback connection.
waza test_backlog_and_io_adapters() -> unit {
    kaku port = 41100;
    kaku server = listen_with_backlog(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port), 4);
    aida (server.error != mu && port < 41150) {
        port = port + 1;
        server = listen_with_backlog(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port), 4);
    }
    testing.expect(server.error == mu, "a listener with an explicit backlog can be created");
    testing.expect(tcp_error_code(listen_with_backlog(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), 0), -1).error) == 1, "a negative backlog is rejected");
    kaku listener = server.listener;
    moshi (listener == mu) { kaesu; }
    kaku client = connect(ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port));
    testing.expect(client.error == mu, "connect with an explicit listen backlog succeeds");
    kaku maybe_out = client.connection;
    moshi (maybe_out == mu) { close_listener(listener); kaesu; }
    kaku accepted = accept(listener);
    testing.expect(accepted.error == mu, "accept with an explicit listen backlog succeeds");
    kaku maybe_in = accepted.connection;
    moshi (maybe_in == mu) { close(maybe_out); close_listener(listener); kaesu; }
    kaku outgoing = maybe_out; kaku incoming = maybe_in;
    kaku sent = io.write_all(writer(outgoing), [77, 105, 111], 0, 3);
    testing.expect(sent.count == 3 && sent.error == mu, "io.write_all through the connection writer");
    kaku buffer = array.make[uint8](3, uint8(0));
    kaku got = io.read_full(reader(incoming), buffer, 0, 3);
    testing.expect(got.count == 3 && buffer[0] == uint8(77) && buffer[2] == uint8(111), "io.read_full through the connection reader");
    close(outgoing); close(incoming);
    testing.expect(close_listener(listener).error == mu, "the listener closes");
}

// Winsock can recycle a SOCKET as soon as closesocket returns. Opening the
// replacement also reuses the first free slot in the native Mio resource table.
waza test_stale_connection_after_slot_reuse() -> unit {
    kaku port = 41200;
    kaku address = ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port);
    kaku server = listen(address);
    aida (server.error != mu && port < 41250) {
        port = port + 1;
        address = ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port);
        server = listen(address);
    }
    testing.expect(server.error == mu, "a loopback listener can be created");
    kaku listener = server.listener;
    moshi (listener == mu) { kaesu; }
    kaku first = connect(address).connection;
    testing.expect(first != mu, "the initial client connects");
    moshi (first == mu) { close_listener(listener); kaesu; }
    kaku peer = accept(listener).connection;
    testing.expect(peer != mu, "the initial client is accepted");
    testing.expect(close(first).error == mu, "the original client closes");
    moshi (peer != mu) { close(peer); }

    kaku replacement = connect(address).connection;
    testing.expect(replacement != mu, "the replacement client connects");
    moshi (replacement == mu) { close_listener(listener); kaesu; }
    kaku next_peer = accept(listener).connection;
    testing.expect(next_peer != mu, "the replacement client is accepted");
    kaku data: []uint8 = [uint8(42)];
    testing.expect(tcp_error_code(write(first, data, 0, 1).error) == 2, "the stale client cannot write to the replacement");
    testing.expect(tcp_error_code(close(first).error) == 2, "the stale client cannot close the replacement");
    testing.expect(write_all(replacement, data, 0, 1).count == 1, "the replacement remains usable");
    close(replacement);
    moshi (next_peer != mu) { close(next_peer); }
    close_listener(listener);
}
