koukai waza sqrt<T: Float>(value: T) -> T { kaesu __sqrt(value); }

koukai waza floor<T: Float>(value: T) -> T { kaesu __floor(value); }

koukai waza ceil<T: Float>(value: T) -> T { kaesu __ceil(value); }

koukai waza round<T: Float>(value: T) -> T { kaesu __round_even(value); }

koukai waza trunc<T: Float>(value: T) -> T { kaesu __trunc(value); }

koukai waza is_nan<T: Float>(value: T) -> bool { kaesu __is_nan(value); }

koukai waza is_inf<T: Float>(value: T) -> bool { kaesu __is_inf(value); }

koukai waza is_finite<T: Float>(value: T) -> bool { kaesu __is_finite(value); }
