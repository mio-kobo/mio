yobu "kiso/array";

// Immutable arithmetic lookup tables; no host crypto or foreign compiler is
// involved. Values stay nonnegative int64 while sums wrap modulo 2^32.
koukai kata Context { xor_nibbles: []int64; powers: []int64; constants: []int64; }

koukai waza context() -> Context {
    kaku table: []int64 = []; kaku b = 0;
    aida (b < 16) {
        kaku a = 0;
        aida (a < 16) {
            kaku left = a; kaku right = b; kaku power = 1; kaku result = 0; kaku bit = 0;
            aida (bit < 4) {
                kaku x = left - (left / 2) * 2; kaku y = right - (right / 2) * 2;
                moshi (x != y) { result = result + power; }
                left = left / 2; right = right / 2; power = power * 2; bit = bit + 1;
            }
            array.push(table, result); a = a + 1;
        }
        b = b + 1;
    }
    kaku powers: []int64 = [1]; kaku at = 0;
    aida (at < 32) { array.push(powers, powers[at] * 2); at = at + 1; }
    kaesu Context { xor_nibbles: table, powers: powers, constants: [
        1116352408,1899447441,3049323471,3921009573,961987163,1508970993,2453635748,2870763221,
        3624381080,310598401,607225278,1426881987,1925078388,2162078206,2614888103,3248222580,
        3835390401,4022224774,264347078,604807628,770255983,1249150122,1555081692,1996064986,
        2554220882,2821834349,2952996808,3210313671,3336571891,3584528711,113926993,338241895,
        666307205,773529912,1294757372,1396182291,1695183700,1986661051,2177026350,2456956037,
        2730485921,2820302411,3259730800,3345764771,3516065817,3600352804,4094571909,275423344,
        430227734,506948616,659060556,883997877,958139571,1322822218,1537002063,1747873779,
        1955562222,2024104815,2227730452,2361852424,2428436474,2756734187,3204031479,3329325298] };
}

waza wrap(value: int64) -> int64 { kaesu value - (value / 4294967296) * 4294967296; }
waza xor32(ctx: Context, a: int64, b: int64) -> int64 {
    kaku left = a; kaku right = b; kaku value = 0; kaku scale = 1; kaku at = 0;
    aida (at < 8) {
        kaku x = left - (left / 16) * 16; kaku y = right - (right / 16) * 16;
        value = value + ctx.xor_nibbles[x + y * 16] * scale;
        left = left / 16; right = right / 16; scale = scale * 16; at = at + 1;
    }
    kaesu value;
}
waza and32(ctx: Context, a: int64, b: int64) -> int64 { kaesu (a + b - xor32(ctx, a, b)) / 2; }
waza rotate(ctx: Context, value: int64, count: int64) -> int64 {
    kaku divisor = ctx.powers[count];
    kaesu value / divisor + (value - (value / divisor) * divisor) * ctx.powers[32 - count];
}
waza sigma(ctx: Context, value: int64, a: int64, b: int64, c: int64, small: bool) -> int64 {
    kaku third = rotate(ctx, value, c); moshi (small) { third = value / ctx.powers[c]; }
    kaesu xor32(ctx, xor32(ctx, rotate(ctx, value, a), rotate(ctx, value, b)), third);
}

// Hash a range without allocating a copy of the input or its padding.
// Invalid ranges return an empty digest; callers must check the 32-byte result.
koukai waza sum_range(ctx: Context, data: []uint8, start: int64, length: int64) -> []uint8 {
    moshi (start < 0 || length < 0 || start > len(data) || length > len(data) - start) { kaesu []; }
    kaku state: []int64 = [1779033703,3144134277,1013904242,2773480762,1359893119,2600822924,528734635,1541459225];
    kaku words = array.make[int64](64, 0); kaku blocks = (length + 9 + 63) / 64; kaku block = 0;
    aida (block < blocks) {
        kaku at = 0;
        aida (at < 16) {
            kaku value = 0; kaku byte = 0;
            aida (byte < 4) {
                kaku position = block * 64 + at * 4 + byte; kaku octet = 0;
                moshi (position < length) { octet = int64(data[start + position]); }
                sore { moshi (position == length) { octet = 128; }
                    sore { moshi (position >= blocks * 64 - 8) {
                        kaku shift = (blocks * 64 - 1 - position) * 8;
                        kaku bits = length * 8;
                        // Input arrays are bounded below 2^32 bytes. The high
                        // length word is still encoded for the complete ABI.
                        kaku divisor = 1; kaku bit = 0;
                        aida (bit < shift) { divisor = divisor * 2; bit = bit + 1; }
                        octet = bits / divisor; octet = octet - (octet / 256) * 256;
                    } }
                }
                value = value * 256 + octet; byte = byte + 1;
            }
            words[at] = value; at = at + 1;
        }
        aida (at < 64) {
            words[at] = wrap(sigma(ctx, words[at - 2], 17, 19, 10, hai) + words[at - 7] + sigma(ctx, words[at - 15], 7, 18, 3, hai) + words[at - 16]); at = at + 1;
        }
        kaku a = state[0]; kaku b = state[1]; kaku c = state[2]; kaku d = state[3];
        kaku e = state[4]; kaku f = state[5]; kaku g = state[6]; kaku h = state[7]; at = 0;
        aida (at < 64) {
            kaku choice = xor32(ctx, g, and32(ctx, e, xor32(ctx, f, g)));
            kaku majority = xor32(ctx, and32(ctx, a, b), and32(ctx, c, xor32(ctx, a, b)));
            kaku first = wrap(h + sigma(ctx, e, 6, 11, 25, iie) + choice + ctx.constants[at] + words[at]);
            kaku second = wrap(sigma(ctx, a, 2, 13, 22, iie) + majority);
            h = g; g = f; f = e; e = wrap(d + first); d = c; c = b; b = a; a = wrap(first + second); at = at + 1;
        }
        state[0] = wrap(state[0] + a); state[1] = wrap(state[1] + b); state[2] = wrap(state[2] + c); state[3] = wrap(state[3] + d);
        state[4] = wrap(state[4] + e); state[5] = wrap(state[5] + f); state[6] = wrap(state[6] + g); state[7] = wrap(state[7] + h);
        block = block + 1;
    }
    kaku output: []uint8 = []; kaku at = 0;
    aida (at < 8) {
        kaku divisor = 16777216; kaku byte = 0;
        aida (byte < 4) { kaku value = state[at] / divisor; array.push(output, uint8(value - (value / 256) * 256)); divisor = divisor / 256; byte = byte + 1; }
        at = at + 1;
    }
    kaesu output;
}
koukai waza sum(data: []uint8) -> []uint8 { kaesu sum_range(context(), data, 0, len(data)); }
