yobu "mio/thread/runtime";
yobu "kiso/array";

// OS threads and zero-copy channels (Linux x86-64 only; every other target rejects programs that use this package).
// Names are PROVISIONAL (decision D-2 of docs/concurrency.md is open).
//
// A channel moves a reference between threads: sending stores the reference in a ring slot and receiving takes it out, nothing is ever
// copied. Together with `yuzuru` at the send site the compiler guarantees that the sender can no longer reach the graph it handed over, so
// the receiver becomes its only owner. A failed send (closed channel) hands the graph back inside the result: the sender never loses a
// graph merely because a transfer was attempted.

// Starts a thread running entry. Returns a positive handle, or a negative errno when the thread could not be created or registered: -11 when
// 4096 threads are already live (unjoined), -12 when the runtime has no memory for it, otherwise the system error. Nothing is left behind on failure.
koukai waza start(entry: () -> int64) -> int64 { kaesu runtime.start(entry); }

// Waits for the thread and returns entry's result. A handle that is not a live thread handle (never issued, already joined, stale, or made up)
// is detected and yields -22 instead of touching memory; an entry that itself returns a negative number cannot be told apart from that error
// by this function, so use join_checked when that matters.
koukai waza join(handle: int64) -> int64 { kaesu runtime.join(handle); }

// ok == iie: the handle was not a live thread handle (value is 0). Otherwise value is entry's result.
koukai kata JoinResult { ok: bool; value: int64; }

koukai waza join_checked(handle: int64) -> JoinResult {
    kaku value = runtime.join(handle);
    moshi (runtime.join_status() != 0) { kaesu JoinResult { ok: iie, value: 0 }; }
    kaesu JoinResult { ok: hai, value: value };
}

// A bounded multi-producer multi-consumer queue of T. `words` is an off-heap block of control words (lock, head, tail, count, closed,
// receive sequence, send sequence); `ring` holds the payload references, so in-flight graphs are ordinary heap references that the
// collector traces. `filler` is a value of T used to clear drained slots (so a drained graph can be collected).
koukai kata Channel<T> { words: int64; ring: []T; filler: T; capacity: int64; }

// sent == hai: the value was stored. Otherwise the channel was closed and `back` is the very value that was passed in.
koukai kata SendResult<T> { sent: bool; back: T; }

// closed == hai: the channel is closed and drained (item is the filler). Otherwise item is the received value.
koukai kata Received<T> { item: T; closed: bool; }

koukai waza channel_new<T>(capacity: int64, filler: T) -> Channel<T> {
    kaku slots = capacity;
    moshi (slots < 1) { slots = 1; }
    kaesu Channel[T] { words: runtime.words_new(8), ring: array.make[T](slots, filler), filler: filler, capacity: slots };
}

// Mutex on word 0: 0 free, 1 locked, 2 locked with waiters. A waiter sleeps in word_wait (a safepoint) instead of spinning.
waza lock<T>(channel: Channel<T>) -> int64 {
    kaku c = runtime.word_cas(channel.words, 0, 0, 1);
    moshi (c == 0) { kaesu 0; }
    aida (hai) {
        moshi (c != 2) { c = runtime.word_cas(channel.words, 0, 1, 2); }
        moshi (c != 0) { runtime.word_wait(channel.words, 0, 2); }
        c = runtime.word_cas(channel.words, 0, 0, 2);
        moshi (c == 0) { kaesu 0; }
    }
    kaesu 0;
}
waza unlock<T>(channel: Channel<T>) -> int64 {
    kaku before = runtime.word_add(channel.words, 0, -1);
    moshi (before != 1) {
        runtime.word_set(channel.words, 0, 0);
        runtime.word_wake(channel.words, 0, 1);
    }
    kaesu 0;
}
// Waiter counts live in word 7: the receivers sleeping on word 5 in the low 32 bits, the senders sleeping on word 6 in the high bits. A thread that is
// about to sleep announces itself (a full barrier) before the kernel compares the sequence word with the value it saw; a thread that changed the
// sequence word (a full barrier) reads the counts afterwards. Either the sleeper sees the new sequence and does not sleep, or the waker sees the
// sleeper and wakes it: no wake-up is lost, and a transfer that nobody waits for costs no system call.
teisu receiver_unit = 1;
teisu sender_unit = 4294967296;
waza sleep_on<T>(channel: Channel<T>, sequence: int64, seen: int64, unit: int64) -> int64 {
    runtime.word_add(channel.words, 7, unit);
    runtime.word_wait(channel.words, sequence, seen);
    runtime.word_add(channel.words, 7, 0 - unit);
    kaesu 0;
}
// One item was queued: wake one sleeping receiver, if there is any. (A woken receiver re-checks the queue under the lock, so one wake per item
// is enough; close and destroy wake everybody.)
waza wake_receiver<T>(channel: Channel<T>) -> int64 {
    kaku counts = runtime.word_get(channel.words, 7);
    kaku receivers = counts - (counts / 4294967296) * 4294967296;
    moshi (receivers != 0) { runtime.word_wake(channel.words, 5, 1); }
    kaesu 0;
}
// One slot was freed: wake one sleeping sender, if there is any.
waza wake_sender<T>(channel: Channel<T>) -> int64 {
    kaku counts = runtime.word_get(channel.words, 7);
    moshi (counts / 4294967296 != 0) { runtime.word_wake(channel.words, 6, 1); }
    kaesu 0;
}
waza next_slot(index: int64, capacity: int64) -> int64 { kaesu (index + 1) - ((index + 1) / capacity) * capacity; }

// Blocks while the channel is full. Pass the graph with yuzuru: `thread.send[Graph](channel, yuzuru graph)`.
koukai waza send<T>(channel: Channel<T>, value: T) -> SendResult<T> {
    aida (hai) {
        lock[T](channel);
        moshi (runtime.word_get(channel.words, 4) != 0) { unlock[T](channel); kaesu SendResult[T] { sent: iie, back: value }; }
        kaku count = runtime.word_get(channel.words, 3);
        moshi (count < channel.capacity) {
            kaku tail = runtime.word_get(channel.words, 2);
            channel.ring[tail] = value;
            runtime.word_set(channel.words, 2, next_slot(tail, channel.capacity));
            runtime.word_set(channel.words, 3, count + 1);
            runtime.word_add(channel.words, 5, 1);
            unlock[T](channel);
            wake_receiver[T](channel);
            kaesu SendResult[T] { sent: hai, back: channel.filler };
        }
        kaku seen = runtime.word_get(channel.words, 6);
        unlock[T](channel);
        sleep_on[T](channel, 6, seen, sender_unit);
    }
    kaesu SendResult[T] { sent: iie, back: value };
}

// Blocks while the channel is empty and open.
koukai waza receive<T>(channel: Channel<T>) -> Received<T> {
    aida (hai) {
        lock[T](channel);
        kaku count = runtime.word_get(channel.words, 3);
        moshi (count > 0) {
            kaku head = runtime.word_get(channel.words, 1);
            kaku item = channel.ring[head];
            channel.ring[head] = channel.filler;
            runtime.word_set(channel.words, 1, next_slot(head, channel.capacity));
            runtime.word_set(channel.words, 3, count - 1);
            runtime.word_add(channel.words, 6, 1);
            unlock[T](channel);
            wake_sender[T](channel);
            kaesu Received[T] { item: item, closed: iie };
        }
        moshi (runtime.word_get(channel.words, 4) != 0) { unlock[T](channel); kaesu Received[T] { item: channel.filler, closed: hai }; }
        kaku seen = runtime.word_get(channel.words, 5);
        unlock[T](channel);
        sleep_on[T](channel, 5, seen, receiver_unit);
    }
    kaesu Received[T] { item: channel.filler, closed: hai };
}

// Closes the channel: further sends are rejected (and return their value), receivers drain what is queued and then see closed.
koukai waza close<T>(channel: Channel<T>) -> int64 {
    lock[T](channel);
    runtime.word_set(channel.words, 4, 1);
    unlock[T](channel);
    runtime.word_add(channel.words, 5, 1);
    runtime.word_add(channel.words, 6, 1);
    runtime.word_wake(channel.words, 5, 1000000);
    runtime.word_wake(channel.words, 6, 1000000);
    kaesu 0;
}

// Closes the channel for good and drops whatever is still queued (use close and drain with receive to keep it). Safe to call more than once
// and from any thread; operations on a destroyed channel behave exactly like operations on a closed one (a send is rejected and returns its
// value, a receive reports closed). The 64-byte control block stays mapped for the life of the process on purpose, so a thread still inside
// send/receive can never see freed memory.
koukai waza destroy<T>(channel: Channel<T>) -> int64 {
    lock[T](channel);
    runtime.word_set(channel.words, 4, 1);
    runtime.word_set(channel.words, 3, 0);
    runtime.word_set(channel.words, 1, 0);
    runtime.word_set(channel.words, 2, 0);
    kaku i = 0;
    aida (i < channel.capacity) { channel.ring[i] = channel.filler; i = i + 1; }
    unlock[T](channel);
    runtime.word_add(channel.words, 5, 1);
    runtime.word_add(channel.words, 6, 1);
    runtime.word_wake(channel.words, 5, 1000000);
    runtime.word_wake(channel.words, 6, 1000000);
    kaesu 0;
}
