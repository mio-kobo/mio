yobu "kiso/aot/cabi";
yobu "kiso/array";
yobu "kiso/math";
yobu "kiso/string";

waza dlopen(path: cptr, flags: int32) -> cptr = c "dlopen";
waza dlsym(image: cptr, name: cptr) -> cptr = c "dlsym";
waza dlclose(image: cptr) -> int32 = c "dlclose";
waza dlerror() -> cptr = c "dlerror";
waza malloc(size: uint64) -> cptr = c "malloc";
waza native_free(pointer: cptr) -> unit = c "free";
waza native_lock(pointer: cptr) -> unit = c "os_unfair_lock_lock";
waza native_unlock(pointer: cptr) -> unit = c "os_unfair_lock_unlock";
waza dladdr(address: cptr, info: cptr) -> int32 = c "dladdr";
waza getsectiondata(image: cptr, segment: cptr, section: cptr, size: cptr) -> cptr = c "getsectiondata";
waza load_pointer(pointer: cptr, offset: uint64) -> cptr = c "mio_ffi_load_pointer";
waza pointer_offset(address: cptr, base: cptr) -> int64 = c "mio_ffi_pointer_offset";
waza load_word(pointer: cptr) -> int64 = c "mio_ffi_load_word";
waza store_byte(pointer: cptr, offset: uint64, value: uint8) -> unit = c "mio_ffi_store_byte";
waza load_byte(pointer: cptr, offset: uint64) -> uint8 = c "mio_ffi_load_byte";
waza call_g(address: cptr) -> int64 = c "mio_ffi_call_g";
waza call_gg(address: cptr, a: int64) -> int64 = c "mio_ffi_call_gg";
waza call_ggg(address: cptr, a: int64, b: int64) -> int64 = c "mio_ffi_call_ggg";
waza call_jj(address: cptr, a: float64) -> float64 = c "mio_ffi_call_jj";
waza call_jgg(address: cptr, a: int64, b: int64) -> float64 = c "mio_ffi_call_jgg";
waza call_lg(address: cptr, a: int64) -> bool = c "mio_ffi_call_lg";

kata Ticket { id: int64; }
koukai kata Library { ticket: Ticket; }
koukai kata Function { ticket: Ticket; }
koukai kata OpenResult { library: Library?; error: string; }
koukai kata SymbolResult { function: Function?; error: string; }
koukai kata IntResult { value: int64; error: string; }
koukai kata FloatResult { value: float64; error: string; }
koukai kata BoolResult { value: bool; error: string; }

koukai sentaku Prototype {
    Int64;
    Int64FromInt64;
    Int64FromTwoInt64;
    Float64FromFloat64;
    Float64FromTwoInt64;
    BoolFromInt64;
}

kata LibraryEntry {
    id: int64;
    address: cptr;
    state: []int64;
}
teisu active_calls = 0;
teisu close_in_progress = 1;
teisu abi_is_checked = 2;

kata FunctionEntry {
    id: int64;
    owner: int64;
    address: cptr;
    signature: string;
    layout: cabi.DarwinLayout;
}
kaku libraries: []LibraryEntry = [];
kaku functions: []FunctionEntry = [];
kaku next_id: int64 = 1;
// os_unfair_lock uses one zero-initialized native word for its unlocked state.
kaku registry_guard = allocate_zeroed(uint64(1), uint64(8));

waza registry_lock() -> unit {
    moshi (registry_guard == cptr(0)) { math.fail("cannot allocate Darwin FFI registry lock"); }
    native_lock(registry_guard);
}

waza registry_unlock() -> unit { native_unlock(registry_guard); }

waza take_id() -> int64 {
    moshi (next_id == 9223372036854775807) { kaesu 0; }
    kaku id = next_id;
    next_id = next_id + 1;
    kaesu id;
}

waza c_string(value: string) -> cptr {
    kaku bytes = string.to_bytes(value);
    moshi (len(bytes) == 0 || len(bytes) > 4096) { kaesu cptr(0); }
    kaku at = 0;
    aida (at < len(bytes)) {
        moshi (bytes[at] == uint8(0)) { kaesu cptr(0); }
        at = at + 1;
    }
    kaku buffer = malloc(uint64(len(bytes) + 1));
    moshi (buffer == cptr(0)) { kaesu buffer; }
    at = 0;
    aida (at < len(bytes)) {
        store_byte(buffer, uint64(at), bytes[at]);
        at = at + 1;
    }
    store_byte(buffer, uint64(at), uint8(0));
    kaesu buffer;
}

waza error_text(address: cptr, fallback: string) -> string {
    moshi (address == cptr(0)) { kaesu fallback; }
    kaku bytes: []uint8 = [];
    kaku at = 0;
    aida (at < 4096) {
        kaku byte = load_byte(address, uint64(at));
        moshi (byte == uint8(0)) { nukeru; }
        array.push(bytes, byte);
        at = at + 1;
    }
    kaku value = string.from_utf8(bytes);
    moshi (value == mu) { kaesu fallback; }
    moshi (at == 0) { kaesu fallback; }
    kaesu value;
}

waza library_slot(id: int64) -> int64 {
    kaku at = 0;
    aida (at < len(libraries)) {
        moshi (libraries[at].id == id) { kaesu at; }
        at = at + 1;
    }
    kaesu -1;
}

// Registry entries may move when another ticket closes. Pin by identity.
waza pin_library(library: Library) -> LibraryEntry? {
    registry_lock();
    kaku slot = library_slot(library.ticket.id);
    moshi (slot < 0 || libraries[slot].state[close_in_progress] != 0) { registry_unlock(); kaesu mu; }
    kaku entry = libraries[slot];
    entry.state[active_calls] = entry.state[active_calls] + 1;
    registry_unlock();
    kaesu entry;
}

waza unpin_library(id: int64) -> unit {
    registry_lock();
    kaku slot = library_slot(id);
    kaku entry = libraries[slot];
    entry.state[active_calls] = entry.state[active_calls] - 1;
    registry_unlock();
}

kata LookupResult { address: cptr; error: string; }
waza lookup(image: cptr, name: string) -> LookupResult {
    kaku buffer = c_string(name);
    moshi (buffer == cptr(0)) { kaesu LookupResult { address: cptr(0), error: "invalid or unallocatable symbol name" }; }
    dlerror();
    kaku address = dlsym(image, buffer);
    kaku problem = dlerror();
    kaku error = "";
    moshi (problem != cptr(0) || address == cptr(0)) { error = error_text(problem, "symbol has no address"); }
    native_free(buffer);
    kaesu LookupResult { address: address, error: error };
}

koukai waza open(path: string) -> OpenResult {
    kaku buffer = c_string(path);
    moshi (buffer == cptr(0)) { kaesu OpenResult { library: mu, error: "invalid or unallocatable library path" }; }
    registry_lock();
    kaku id = take_id();
    registry_unlock();
    moshi (id == 0) {
        native_free(buffer);
        kaesu OpenResult { library: mu, error: "FFI ticket space exhausted" };
    }
    dlerror();
    // RTLD_FIRST scopes dlsym to this image rather than its dependencies.
    kaku image = dlopen(buffer, int32(262));
    kaku error = "";
    moshi (image == cptr(0)) { error = error_text(dlerror(), "cannot open dynamic library"); }
    native_free(buffer);
    moshi (error != "") { kaesu OpenResult { library: mu, error: error }; }
    registry_lock();
    array.push(libraries, LibraryEntry { id: id, address: image, state: [0, 0, 0] });
    registry_unlock();
    kaesu OpenResult { library: Library { ticket: Ticket { id: id } }, error: "" };
}

waza prototype_code(prototype: Prototype) -> string {
    awase (prototype) {
        baai Int64 { kaesu "g"; }
        baai Int64FromInt64 { kaesu "gg"; }
        baai Int64FromTwoInt64 { kaesu "ggg"; }
        baai Float64FromFloat64 { kaesu "jj"; }
        baai Float64FromTwoInt64 { kaesu "jgg"; }
        baai BoolFromInt64 { kaesu "lg"; }
    }
    kaesu "";
}

waza text_entry(address: cptr) -> bool {
    kaku info = malloc(uint64(32));
    moshi (info == cptr(0)) { kaesu iie; }
    moshi (dladdr(address, info) == int32(0)) { native_free(info); kaesu iie; }
    // Dl_info's second pointer is the image header. Reuse the allocation for
    // getsectiondata's size_t output after fetching that pointer.
    kaku image = load_pointer(info, uint64(8));
    kaku segment = c_string("__TEXT");
    kaku section = c_string("__text");
    kaku valid = iie;
    moshi (image != cptr(0) && segment != cptr(0) && section != cptr(0)) {
        kaku text = getsectiondata(image, segment, section, info);
        moshi (text != cptr(0)) {
            kaku offset = pointer_offset(address, text);
            valid = offset >= 0 && offset < load_word(info) && offset - (offset / 4) * 4 == 0;
        }
    }
    native_free(section);
    native_free(segment);
    native_free(info);
    kaesu valid;
}

waza validate_mio_abi(entry: LibraryEntry) -> string {
    registry_lock();
    kaku checked = entry.state[abi_is_checked] != 0;
    registry_unlock();
    moshi (checked) { kaesu ""; }
    kaku name = "mio_module_abi_version";
    kaku version = lookup(entry.address, name);
    kaku marker = lookup(entry.address, cabi.dylib_marker(name, "g", ""));
    moshi (version.error != "" || marker.error != "" || version.address != marker.address ||
        !text_entry(version.address)) {
        kaesu "invalid Mio FFI ABI version export";
    }
    moshi (call_g(version.address) != 1) { kaesu "unsupported Mio FFI ABI version"; }
    registry_lock();
    entry.state[abi_is_checked] = 1;
    registry_unlock();
    kaesu "";
}

waza resolve_function(entry: LibraryEntry, name: string, signature: string, mio: bool) -> SymbolResult {
    kaku image = entry.address;
    kaku found = lookup(image, name);
    moshi (found.error != "") { kaesu SymbolResult { function: mu, error: found.error }; }
    moshi (!text_entry(found.address)) {
        kaesu SymbolResult { function: mu, error: "symbol does not identify an ARM64 text entry" };
    }
    moshi (mio) {
        kaku marker = lookup(image, cabi.dylib_marker(name, signature, ""));
        moshi (marker.error != "" || marker.address != found.address) {
            kaesu SymbolResult { function: mu, error: "Mio FFI function signature mismatch" };
        }
        kaku error = validate_mio_abi(entry);
        moshi (error != "") { kaesu SymbolResult { function: mu, error: error }; }
    }
    kaku codes = string.to_bytes(signature);
    kaku parameters = array.with_capacity[int64](len(codes) - 1);
    kaku at = 1;
    aida (at < len(codes)) {
        array.push(parameters, int64(codes[at]));
        at = at + 1;
    }
    kaku layout = cabi.darwin_layout(parameters);
    registry_lock();
    kaku id = take_id();
    moshi (id == 0) { registry_unlock(); kaesu SymbolResult { function: mu, error: "FFI ticket space exhausted" }; }
    array.push(functions, FunctionEntry {
        id: id, owner: entry.id, address: found.address, signature: signature, layout: layout
    });
    registry_unlock();
    kaesu SymbolResult { function: Function { ticket: Ticket { id: id } }, error: "" };
}

waza bind_function(library: Library, name: string, signature: string, mio: bool) -> SymbolResult {
    moshi (mio && (!cabi.valid_symbol(name) || !string.has_prefix(name, "mio_"))) {
        kaesu SymbolResult { function: mu, error: "invalid Mio FFI symbol" };
    }
    moshi (!mio && name != "main" && !cabi.valid_symbol(name)) {
        kaesu SymbolResult { function: mu, error: "invalid C FFI symbol" };
    }
    kaku entry = pin_library(library);
    moshi (entry == mu) { kaesu SymbolResult { function: mu, error: "library is closed or closing" }; }
    kaku result = resolve_function(entry, name, signature, mio);
    unpin_library(entry.id);
    kaesu result;
}

koukai waza symbol(library: Library, name: string, prototype: Prototype) -> SymbolResult {
    kaesu bind_function(library, name, prototype_code(prototype), hai);
}

koukai waza close(library: Library) -> string {
    registry_lock();
    kaku slot = library_slot(library.ticket.id);
    moshi (slot < 0) { registry_unlock(); kaesu "library is closed"; }
    kaku entry = libraries[slot];
    moshi (entry.state[close_in_progress] != 0 || entry.state[active_calls] != 0) {
        registry_unlock();
        kaesu "library is busy";
    }
    entry.state[close_in_progress] = 1;
    registry_unlock();

    dlerror();
    kaku error = "";
    moshi (dlclose(entry.address) != int32(0)) {
        error = error_text(dlerror(), "cannot close dynamic library");
    }
    registry_lock();
    moshi (error != "") {
        entry.state[close_in_progress] = 0;
        registry_unlock();
        kaesu error;
    }
    slot = library_slot(entry.id);
    libraries[slot] = libraries[len(libraries) - 1];
    array.truncate(libraries, len(libraries) - 1);
    kaku at = 0;
    aida (at < len(functions)) {
        moshi (functions[at].owner == entry.id) {
            functions[at] = functions[len(functions) - 1];
            array.truncate(functions, len(functions) - 1);
        } sore { at = at + 1; }
    }
    registry_unlock();
    kaesu "";
}

waza function_slot(function: Function) -> int64 {
    kaku at = 0;
    aida (at < len(functions)) {
        moshi (functions[at].id == function.ticket.id) { kaesu at; }
        at = at + 1;
    }
    kaesu -1;
}

waza pin_function(function: Function, signature: string) -> FunctionEntry? {
    registry_lock();
    kaku slot = function_slot(function);
    moshi (slot < 0) { registry_unlock(); kaesu mu; }
    kaku entry = functions[slot];
    moshi (signature != "" && entry.signature != signature) { registry_unlock(); kaesu mu; }
    kaku owner = library_slot(entry.owner);
    moshi (owner < 0 || libraries[owner].state[close_in_progress] != 0) { registry_unlock(); kaesu mu; }
    kaku library = libraries[owner];
    library.state[active_calls] = library.state[active_calls] + 1;
    registry_unlock();
    kaesu entry;
}

koukai waza release(function: Function) -> string {
    registry_lock();
    kaku slot = function_slot(function);
    moshi (slot < 0) { registry_unlock(); kaesu "function is released"; }
    functions[slot] = functions[len(functions) - 1];
    array.truncate(functions, len(functions) - 1);
    registry_unlock();
    kaesu "";
}

koukai waza invoke_int64(function: Function) -> IntResult {
    kaku entry = pin_function(function, "g");
    moshi (entry == mu) { kaesu IntResult { value: 0, error: "invalid function or signature" }; }
    kaku value = call_g(entry.address);
    unpin_library(entry.owner);
    kaesu IntResult { value: value, error: "" };
}

koukai waza invoke_int64_1(function: Function, a: int64) -> IntResult {
    kaku entry = pin_function(function, "gg");
    moshi (entry == mu) { kaesu IntResult { value: 0, error: "invalid function or signature" }; }
    kaku value = call_gg(entry.address, a);
    unpin_library(entry.owner);
    kaesu IntResult { value: value, error: "" };
}

koukai waza invoke_int64_2(function: Function, a: int64, b: int64) -> IntResult {
    kaku entry = pin_function(function, "ggg");
    moshi (entry == mu) { kaesu IntResult { value: 0, error: "invalid function or signature" }; }
    kaku value = call_ggg(entry.address, a, b);
    unpin_library(entry.owner);
    kaesu IntResult { value: value, error: "" };
}

koukai waza invoke_float64(function: Function, a: float64) -> FloatResult {
    kaku entry = pin_function(function, "jj");
    moshi (entry == mu) { kaesu FloatResult { value: 0.0, error: "invalid function or signature" }; }
    kaku value = call_jj(entry.address, a);
    unpin_library(entry.owner);
    kaesu FloatResult { value: value, error: "" };
}

koukai waza invoke_float64_from_ints(function: Function, a: int64, b: int64) -> FloatResult {
    kaku entry = pin_function(function, "jgg");
    moshi (entry == mu) { kaesu FloatResult { value: 0.0, error: "invalid function or signature" }; }
    kaku value = call_jgg(entry.address, a, b);
    unpin_library(entry.owner);
    kaesu FloatResult { value: value, error: "" };
}

koukai waza invoke_bool(function: Function, a: int64) -> BoolResult {
    kaku entry = pin_function(function, "lg");
    moshi (entry == mu) { kaesu BoolResult { value: iie, error: "invalid function or signature" }; }
    kaku value = call_lg(entry.address, a);
    unpin_library(entry.owner);
    kaesu BoolResult { value: value, error: "" };
}
