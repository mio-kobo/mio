yobu "kiso/aot/cabi";
yobu "kiso/array";
yobu "kiso/string";

waza dlopen(path: cptr, flags: int32) -> cptr = c "dlopen";
waza dlsym(image: cptr, name: cptr) -> cptr = c "dlsym";
waza dlclose(image: cptr) -> int32 = c "dlclose";
waza dlerror() -> cptr = c "dlerror";
waza malloc(size: uint64) -> cptr = c "malloc";
waza free(pointer: cptr) -> unit = c "free";
waza dladdr(address: cptr, info: cptr) -> int32 = c "dladdr";
waza getsectiondata(image: cptr, segment: cptr, section: cptr, size: cptr) -> cptr = c "getsectiondata";
waza load_pointer(pointer: cptr, offset: uint64) -> cptr = c "mio_ffi_load_pointer";
waza pointer_offset(address: cptr, base: cptr) -> int64 = c "mio_ffi_pointer_offset";
waza load_word(pointer: cptr) -> int64 = c "mio_ffi_load_word";
waza store_byte(pointer: cptr, offset: uint64, value: uint8) -> unit = c "mio_ffi_store_byte";
waza load_byte(pointer: cptr, offset: uint64) -> uint8 = c "mio_ffi_load_byte";
waza call_g(address: cptr) -> int64 = c "mio_ffi_call_g";
waza call_gg(address: cptr, a: int64) -> int64 = c "mio_ffi_call_gg";
waza call_ggg(address: cptr, a: int64, b: int64) -> int64 = c "mio_ffi_call_ggg";
waza call_jj(address: cptr, a: float64) -> float64 = c "mio_ffi_call_jj";
waza call_jgg(address: cptr, a: int64, b: int64) -> float64 = c "mio_ffi_call_jgg";
waza call_lg(address: cptr, a: int64) -> bool = c "mio_ffi_call_lg";

kata Ticket { id: int64; }
koukai kata Library { ticket: Ticket; }
koukai kata Function { ticket: Ticket; }
koukai kata OpenResult { library: Library?; error: string; }
koukai kata SymbolResult { function: Function?; error: string; }
koukai kata IntResult { value: int64; error: string; }
koukai kata FloatResult { value: float64; error: string; }
koukai kata BoolResult { value: bool; error: string; }

koukai sentaku Prototype {
    Int64;
    Int64FromInt64;
    Int64FromTwoInt64;
    Float64FromFloat64;
    Float64FromTwoInt64;
    BoolFromInt64;
}

kata LibraryEntry { id: int64; address: cptr; }
kata FunctionEntry { id: int64; owner: int64; address: cptr; prototype: Prototype; }
kaku libraries: []LibraryEntry = [];
kaku functions: []FunctionEntry = [];
kaku next_id: int64 = 1;

waza c_string(value: string) -> cptr {
    kaku bytes = string.to_bytes(value);
    moshi (len(bytes) == 0 || len(bytes) > 4096) { kaesu cptr(0); }
    kaku at = 0;
    aida (at < len(bytes)) {
        moshi (bytes[at] == uint8(0)) { kaesu cptr(0); }
        at = at + 1;
    }
    kaku buffer = malloc(uint64(len(bytes) + 1));
    moshi (buffer == cptr(0)) { kaesu buffer; }
    at = 0;
    aida (at < len(bytes)) {
        store_byte(buffer, uint64(at), bytes[at]);
        at = at + 1;
    }
    store_byte(buffer, uint64(at), uint8(0));
    kaesu buffer;
}

waza error_text(address: cptr, fallback: string) -> string {
    moshi (address == cptr(0)) { kaesu fallback; }
    kaku bytes: []uint8 = [];
    kaku at = 0;
    aida (at < 4096) {
        kaku byte = load_byte(address, uint64(at));
        moshi (byte == uint8(0)) { nukeru; }
        array.push(bytes, byte);
        at = at + 1;
    }
    kaku value = string.from_utf8(bytes);
    moshi (value == mu) { kaesu fallback; }
    moshi (at == 0) { kaesu fallback; }
    kaesu value;
}

waza library_slot(library: Library) -> int64 {
    kaku at = 0;
    aida (at < len(libraries)) {
        moshi (libraries[at].id == library.ticket.id) { kaesu at; }
        at = at + 1;
    }
    kaesu -1;
}

kata LookupResult { address: cptr; error: string; }
waza lookup(image: cptr, name: string) -> LookupResult {
    kaku buffer = c_string(name);
    moshi (buffer == cptr(0)) { kaesu LookupResult { address: cptr(0), error: "invalid or unallocatable symbol name" }; }
    dlerror();
    kaku address = dlsym(image, buffer);
    kaku problem = dlerror();
    kaku error = "";
    moshi (problem != cptr(0) || address == cptr(0)) { error = error_text(problem, "symbol has no address"); }
    free(buffer);
    kaesu LookupResult { address: address, error: error };
}

koukai waza open(path: string) -> OpenResult {
    kaku buffer = c_string(path);
    moshi (buffer == cptr(0)) { kaesu OpenResult { library: mu, error: "invalid or unallocatable library path" }; }
    dlerror();
    // RTLD_FIRST scopes dlsym to this image rather than its dependencies.
    kaku image = dlopen(buffer, int32(262));
    kaku error = "";
    moshi (image == cptr(0)) { error = error_text(dlerror(), "cannot open dynamic library"); }
    free(buffer);
    moshi (error != "") { kaesu OpenResult { library: mu, error: error }; }
    kaku id = next_id; next_id = next_id + 1;
    array.push(libraries, LibraryEntry { id: id, address: image });
    kaesu OpenResult { library: Library { ticket: Ticket { id: id } }, error: "" };
}

waza prototype_code(prototype: Prototype) -> string {
    awase (prototype) {
        baai Int64 { kaesu "g"; }
        baai Int64FromInt64 { kaesu "gg"; }
        baai Int64FromTwoInt64 { kaesu "ggg"; }
        baai Float64FromFloat64 { kaesu "jj"; }
        baai Float64FromTwoInt64 { kaesu "jgg"; }
        baai BoolFromInt64 { kaesu "lg"; }
    }
    kaesu "";
}

waza text_entry(address: cptr) -> bool {
    kaku info = malloc(uint64(32));
    moshi (info == cptr(0)) { kaesu iie; }
    moshi (dladdr(address, info) == int32(0)) { free(info); kaesu iie; }
    // Dl_info's second pointer is the image header. Reuse the allocation for
    // getsectiondata's size_t output after fetching that pointer.
    kaku image = load_pointer(info, uint64(8));
    kaku segment = c_string("__TEXT");
    kaku section = c_string("__text");
    kaku valid = iie;
    moshi (image != cptr(0) && segment != cptr(0) && section != cptr(0)) {
        kaku text = getsectiondata(image, segment, section, info);
        moshi (text != cptr(0)) {
            kaku offset = pointer_offset(address, text);
            valid = offset >= 0 && offset < load_word(info) && offset - (offset / 4) * 4 == 0;
        }
    }
    free(section);
    free(segment);
    free(info);
    kaesu valid;
}

koukai waza symbol(library: Library, name: string, prototype: Prototype) -> SymbolResult {
    kaku slot = library_slot(library);
    moshi (slot < 0) { kaesu SymbolResult { function: mu, error: "library is closed" }; }
    moshi (!cabi.valid_symbol(name) || !string.has_prefix(name, "mio_")) {
        kaesu SymbolResult { function: mu, error: "invalid Mio FFI symbol" };
    }
    kaku image = libraries[slot].address;
    kaku found = lookup(image, name);
    moshi (found.error != "") { kaesu SymbolResult { function: mu, error: found.error }; }
    kaku marker = lookup(image, cabi.dylib_marker(name, prototype_code(prototype), ""));
    moshi (marker.error != "" || marker.address != found.address) {
        kaesu SymbolResult { function: mu, error: "Mio FFI function signature mismatch" };
    }
    moshi (!text_entry(found.address)) {
        kaesu SymbolResult { function: mu, error: "symbol does not identify an ARM64 text entry" };
    }
    kaku id = next_id; next_id = next_id + 1;
    array.push(functions, FunctionEntry { id: id, owner: library.ticket.id, address: found.address, prototype: prototype });
    kaesu SymbolResult { function: Function { ticket: Ticket { id: id } }, error: "" };
}

koukai waza close(library: Library) -> string {
    kaku slot = library_slot(library);
    moshi (slot < 0) { kaesu "library is closed"; }
    dlerror();
    moshi (dlclose(libraries[slot].address) != int32(0)) {
        kaesu error_text(dlerror(), "cannot close dynamic library");
    }
    libraries[slot] = libraries[len(libraries) - 1];
    array.truncate(libraries, len(libraries) - 1);
    kaku at = 0;
    aida (at < len(functions)) {
        moshi (functions[at].owner == library.ticket.id) {
            functions[at] = functions[len(functions) - 1];
            array.truncate(functions, len(functions) - 1);
        } sore { at = at + 1; }
    }
    kaesu "";
}

waza function_address(function: Function, prototype: Prototype) -> cptr {
    kaku at = 0;
    aida (at < len(functions)) {
        kaku entry = functions[at];
        moshi (entry.id == function.ticket.id && prototype_code(entry.prototype) == prototype_code(prototype)) { kaesu entry.address; }
        at = at + 1;
    }
    kaesu cptr(0);
}

koukai waza invoke_int64(function: Function) -> IntResult {
    kaku address = function_address(function, Prototype.Int64());
    moshi (address == cptr(0)) { kaesu IntResult { value: 0, error: "invalid function or signature" }; }
    kaesu IntResult { value: call_g(address), error: "" };
}

koukai waza invoke_int64_1(function: Function, a: int64) -> IntResult {
    kaku address = function_address(function, Prototype.Int64FromInt64());
    moshi (address == cptr(0)) { kaesu IntResult { value: 0, error: "invalid function or signature" }; }
    kaesu IntResult { value: call_gg(address, a), error: "" };
}

koukai waza invoke_int64_2(function: Function, a: int64, b: int64) -> IntResult {
    kaku address = function_address(function, Prototype.Int64FromTwoInt64());
    moshi (address == cptr(0)) { kaesu IntResult { value: 0, error: "invalid function or signature" }; }
    kaesu IntResult { value: call_ggg(address, a, b), error: "" };
}

koukai waza invoke_float64(function: Function, a: float64) -> FloatResult {
    kaku address = function_address(function, Prototype.Float64FromFloat64());
    moshi (address == cptr(0)) { kaesu FloatResult { value: 0.0, error: "invalid function or signature" }; }
    kaesu FloatResult { value: call_jj(address, a), error: "" };
}

koukai waza invoke_float64_from_ints(function: Function, a: int64, b: int64) -> FloatResult {
    kaku address = function_address(function, Prototype.Float64FromTwoInt64());
    moshi (address == cptr(0)) { kaesu FloatResult { value: 0.0, error: "invalid function or signature" }; }
    kaesu FloatResult { value: call_jgg(address, a, b), error: "" };
}

koukai waza invoke_bool(function: Function, a: int64) -> BoolResult {
    kaku address = function_address(function, Prototype.BoolFromInt64());
    moshi (address == cptr(0)) { kaesu BoolResult { value: iie, error: "invalid function or signature" }; }
    kaesu BoolResult { value: call_lg(address, a), error: "" };
}
