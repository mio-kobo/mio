yobu "kiso/fs";
yobu "kiso/os";
yobu "kiso/path";
yobu "kiso/convert";
yobu "kiso/encoding/json";
yobu "selfhost/resources";

waza fatal(message: string) -> unit {fs.write_all("/dev/stderr",string.to_bytes(string.concat("native-ci: ",string.concat(message,"\n"))));os.exit(1);}
waza require(ok: bool, message: string) -> unit {moshi(!ok){fatal(message);}}
waza read_file(file: string) -> []uint8 {kaku result=fs.read_all(file);moshi(result.error!=mu){fatal(string.concat("cannot read ",file));kaesu [];}kaesu result.data;}
waza write_file(file: string, data: []uint8) -> unit {require(fs.write_all(file,data).error==mu,string.concat("cannot write ",file));}
waza write_text(file: string, text: string) -> unit {write_file(file,string.to_bytes(text));}
waza new_directory(directory: string) -> unit {require(!fs.exists(directory),string.concat("preserve existing path: ",directory));require(fs.create_dir(directory).error==mu,string.concat("cannot create ",directory));require(os.chmod(directory,448)==0,"protect output directory");}
waza hex(data: []uint8) -> string {kaku digits=string.to_bytes("0123456789abcdef");kaku output: []uint8=[];kaku at=0;aida(at<len(data)){kaku n=int64(data[at]);array.push(output,digits[n/16]);array.push(output,digits[n-(n/16)*16]);at=at+1;}kaku value=string.from_utf8(output);moshi(value==mu){fatal("invalid hex encoding");kaesu "";}kaesu value;}
waza digest(data: []uint8) -> string {kaesu hex(sha256.sum(data));}
waza string_of(data: []uint8) -> string {kaku value=string.from_utf8(data);moshi(value==mu){fatal("invalid UTF8 text");kaesu "";}kaesu value;}
waza absolute_existing(input: string) -> string {kaku value=os.canonical_path(input);moshi(value==mu){fatal(string.concat("missing physical input: ",input));kaesu "";}kaesu value;}
waza output_path(input: string) -> string {require(path.is_abs(input),"output/prefix must be absolute");kaku parent=absolute_existing(path.dir(input));kaku name=path.base(input);require(name!="" && name!="." && name!="..","invalid output name");kaesu path.join(parent,name);}
waza image_valid(data: []uint8) -> bool {kaesu len(data)>=768 && little(data,0,4)==4277009103 && little(data,4,4)==16777228 && little(data,12,4)==2;}
waza progress(name: string, status: string) -> unit {kaku out=string.new_builder();string.write_string(out,"{\"stage\":");string.write_string(out,json.quote(name));string.write_string(out,",\"status\":");string.write_string(out,json.quote(status));string.write_string(out,"}");chant(string.builder_string(out));}
waza child(program: string, args: []string, label: string) -> unit {progress(label,"START");require(os.spawn(program,args)==0,string.concat("native child failed: ",label));progress(label,"PASS");}
waza path_before(first: string, second: string) -> bool {kaku left=string.to_bytes(first);kaku right=string.to_bytes(second);kaku at=0;aida(at<len(left) && at<len(right)){kaku a=int64(left[at]);kaku b=int64(right[at]);moshi(a==47){a=0;}moshi(b==47){b=0;}moshi(a!=b){kaesu a<b;}at=at+1;}kaesu len(left)<len(right);}
waza sort_paths(paths: []string) -> unit {kaku at=1;aida(at<len(paths)){kaku next=at;aida(next>0 && path_before(paths[next],paths[next-1])){kaku previous=paths[next-1];paths[next-1]=paths[next];paths[next]=previous;next=next-1;}at=at+1;}}
waza gather(root: string, relative: string, paths: []string, depth: int64) -> unit {
 require(depth<128,"source directory nesting limit");kaku listing=fs.read_dir(path.join(root,relative));require(listing.error==mu,string.concat("cannot enumerate ",relative));kaku at=0;
 aida(at<len(listing.entries)){kaku entry=listing.entries[at];kaku name=path.join(relative,entry.name);moshi(entry.is_dir){gather(root,name,paths,depth+1);}sore{moshi(string.has_suffix(entry.name,".mio")){require(entry.is_file,"nonregular Mio source rejected");array.push(paths,name);}}at=at+1;}
}
waza manifest(root: string, paths: []string) -> string {sort_paths(paths);kaku out=string.new_builder();string.write_string(out,"[\n");kaku at=0;aida(at<len(paths)){moshi(at>0){string.write_string(out,",\n");}string.write_string(out,"  {\n    \"path\": ");string.write_string(out,json.quote(paths[at]));string.write_string(out,",\n    \"sha256\": ");string.write_string(out,json.quote(digest(read_file(path.join(root,paths[at])))));string.write_string(out,"\n  }");at=at+1;}string.write_string(out,"\n]\n");kaesu string.builder_string(out);}
waza core_manifest(root: string) -> string {kaku paths: []string=[];gather(root,"bunko",paths,0);gather(root,"selfhost",paths,0);kaesu manifest(root,paths);}
waza component_manifest(root: string) -> string {kaku paths: []string=[];gather(root,"tools/native-ci",paths,0);array.push(paths,"tests/gofree/runtime_metadata.mio.fixture");array.push(paths,"tests/gofree/unsigned_image_audit.mio.fixture");array.push(paths,"LICENSE");array.push(paths,"VERSION");kaesu manifest(root,paths);}
waza verify_resources(root: string) -> unit {kaku files=resources.files();require(len(files)>0,"embedded resource manifest missing");kaku at=0;aida(at<len(files)){kaku file=files[at];kaku disk=read_file(path.join(path.join(root,"bunko"),file.path));kaku embedded=string.to_bytes(file.source);require(len(disk)==file.length && bytes.equal(disk,embedded) && digest(embedded)==file.sha256,string.concat("stale embedded resource: ",file.path));at=at+1;}}
waza contains_bytes(data: []uint8, pattern: []uint8) -> bool {kaku at=0;aida(at+len(pattern)<=len(data)){kaku i=0;aida(i<len(pattern) && data[at+i]==pattern[i]){i=i+1;}moshi(i==len(pattern)){kaesu hai;}at=at+1;}kaesu iie;}
waza verify_no_foreign_runtime(data: []uint8) -> unit {kaku info: []uint8=[255];array.append_all(info,string.to_bytes(" Go buildinf:"));require(!contains_bytes(data,info) && !contains_bytes(data,string.to_bytes("__go_buildid")) && !contains_bytes(data,string.to_bytes("__gopclntab")),"foreign runtime magic found");}
waza runtime_audit(root: string, mio: string, output: string) -> unit {
 kaku source=path.join(output,"runtime-source");new_directory(source);kaku listing=fs.read_dir(path.join(root,"bunko/kiso/aot/lower"));require(listing.error==mu,"runtime source enumeration");kaku at=0;
 aida(at<len(listing.entries)){kaku file=listing.entries[at];moshi(file.is_file && string.has_suffix(file.name,".mio") && !string.has_suffix(file.name,"_test.mio")){write_file(path.join(source,file.name),read_file(path.join(path.join(root,"bunko/kiso/aot/lower"),file.name)));}at=at+1;}
 write_file(path.join(source,"audit.mio"),read_file(path.join(root,"tests/gofree/runtime_metadata.mio.fixture")));kaku builder=path.join(output,"runtime-builder.native");child(mio,[mio,"build",source,"--bunko-root",path.join(root,"bunko"),"-o",builder],"native-runtime-audit-build");kaku programs=path.join(output,"runtime-programs");new_directory(programs);child(builder,[builder,programs],"native-runtime-audit-generation");kaku modes: []string=["ages","remembered","promotion-edge","major","precision","adaptive","cross-graph","alternating","minor-scan","precision-storage","shadow-frame-pop"];at=0;aida(at<len(modes)){kaku program=path.join(programs,modes[at]);child(program,[program],string.concat("native-runtime-",modes[at]));at=at+1;}
}
waza artifact_name() -> string {kaesu "mio-2.0.0-dev-darwin-arm64.tar.gz";}
waza bundle_files(image: []uint8, license: []uint8) -> []Payload {kaku readme=string.to_bytes("Mio v2.0.0-dev — pure Mio Native AOT\nOne installed executable: mio. Bunko and Native Runtime/GC are embedded.\nLocal ad-hoc signature; no Developer ID/notarization or public Release claim.\nNative default build/run; explicit --emit=mochi and native exec/disasm retained.\nSource provenance and hashes are separate distribution metadata.\n");kaesu [Payload {name:"mio",data:image,mode:493},Payload {name:"LICENSE",data:license,mode:420},Payload {name:"README.txt",data:readme,mode:420}];}
waza package_image(image: []uint8, license: []uint8, directory: string) -> string {require(image_valid(image),"package requires ARM64 Mach-O executable");kaku files=bundle_files(image,license);kaku packed=gzip_store(tar_store(files));kaku reopened=archive_open(packed);require(reopened.error=="" && len(reopened.files)==3 && bytes.equal(reopened.files[0].data,image),"native archive roundtrip");write_file(path.join(directory,artifact_name()),packed);kaku hash=digest(packed);kaku sums=string.new_builder();string.write_string(sums,hash);string.write_string(sums,"  ");string.write_string(sums,artifact_name());string.write_string(sums,"\n");string.write_string(sums,digest(image));string.write_string(sums,"  mio\n");write_text(path.join(directory,"SHA256SUMS"),string.builder_string(sums));kaesu hash;}
waza install_image(archive: []uint8, prefix: string, expected: string) -> unit {
 kaku unpacked=archive_open(archive);require(unpacked.error=="" && len(unpacked.files)==3,string.concat("invalid package: ",unpacked.error));kaku selected: []uint8=[];kaku at=0;aida(at<len(unpacked.files)){moshi(unpacked.files[at].name=="mio"){selected=unpacked.files[at].data;}at=at+1;}require(image_valid(selected) && digest(selected)==expected,"installed image hash/architecture mismatch");
 new_directory(prefix);at=0;aida(at<len(unpacked.files)){kaku file=unpacked.files[at];kaku target=path.join(prefix,file.name);require(!fs.exists(target),"refuse to overwrite installation");write_file(target,file.data);require(os.chmod(target,file.mode)==0,"installed file permissions");at=at+1;}
 child(path.join(prefix,"mio"),[path.join(prefix,"mio"),"version"],"installed-version");
}
waza metadata(root: string, seed_hash: string, image_hash: string, archive_hash: string, core_hash: string, component_hash: string, revision: string) -> string {kaku out=string.new_builder();string.write_string(out,"{\n  \"schema_version\": 1,\n  \"status\": \"NATIVE_CANDIDATE\",\n  \"artifact_version\": \"2.0.0-dev\",\n  \"platform\": \"darwin-arm64\",\n  \"source_date_epoch\": 0,\n  \"managed_capacity\": 1073741824,\n  \"implementation\": \"Mio Native AOT\",\n  \"signature\": \"Mio local ad-hoc\",\n  \"publication\": \"NOT_RUN\",\n  \"hosted_ci\": \"NOT_RUN\",\n  \"legacy_M19_race\": \"historical state preserved; no waiver\",\n  \"bootstrap_generations_executed_in_this_ci_run\": 1,\n  \"seed_equals_candidate_complete_bytes\": true,\n  \"core_manifest_sha256\": ");string.write_string(out,json.quote(core_hash));string.write_string(out,",\n  \"ci_component_manifest_sha256\": ");string.write_string(out,json.quote(component_hash));string.write_string(out,",\n  \"trusted_seed_sha256\": ");string.write_string(out,json.quote(seed_hash));string.write_string(out,",\n  \"candidate_sha256\": ");string.write_string(out,json.quote(image_hash));string.write_string(out,",\n  \"archive_sha256\": ");string.write_string(out,json.quote(archive_hash));string.write_string(out,",\n  \"source_revision\": ");string.write_string(out,json.quote(revision));string.write_string(out,",\n  \"source_root\": ");string.write_string(out,json.quote(root));string.write_string(out,"\n}\n");kaesu string.builder_string(out);}
waza ci(root: string, seed: string, output: string, revision: string) -> unit {
 require(absolute_existing(".")==root,"run native CI from its source root");require(string.trim_space(string_of(read_file(path.join(root,"VERSION"))))=="2.0.0","source VERSION mismatch");kaku tag=os.getenv("GITHUB_REF_TYPE");moshi(tag=="tag"){require(os.getenv("GITHUB_REF_NAME")=="v2.0.0-dev","tag/version mismatch; no stable release is claimed");}
 kaku seed_bytes=read_file(seed);require(image_valid(seed_bytes),"trusted Native Seed architecture");require(revision!="","source revision must be explicit");kaku expected_revision=os.getenv("GITHUB_SHA");moshi(expected_revision!=""){require(revision==expected_revision,"CI revision mismatch");}kaku seed_hash=digest(seed_bytes);require(seed_hash=="4c3f7dcbea536d756c3c4a93c18a999412625184bd5c90123f1c16a0cd9e36da","trusted GF4 Seed pin mismatch");new_directory(output);progress("source-manifest","START");kaku core=core_manifest(root);kaku core_hash=digest(string.to_bytes(core));write_text(path.join(output,"compiler-source-manifest.json"),core);require(core_hash=="7f9a2718b3270a9fb40415c210cc232e8324177866b0127962a63057440bdfee",string.concat("frozen compiler source manifest mismatch: ",core_hash));kaku components=component_manifest(root);write_text(path.join(output,"compiler-source-manifest.json"),core);write_text(path.join(output,"ci-source-manifest.json"),components);verify_resources(root);progress("source-manifest","PASS");
 kaku mio=path.join(output,"mio");child(seed,[seed,"build",path.join(root,"selfhost/cli"),"--bunko-root",path.join(root,"bunko"),"-o",mio],"native-source-rebuild");kaku image=read_file(mio);verify_no_foreign_runtime(image);require(bytes.equal(image,seed_bytes),"complete source rebuild differs from pinned GF4 fixed point");progress("complete-self-bootstrap-fixed-point","PASS");
 child(mio,[mio,"test","selfhost/...","--bunko-root",path.join(root,"bunko"),"--format=json","--lang=en-US"],"native-selfhost-tests");child(mio,[mio,"test","bunko/kiso/...","--bunko-root",path.join(root,"bunko"),"--format=json","--lang=en-US"],"native-standard-library-tests");child(mio,[mio,"test","tools/native-ci","--bunko-root",path.join(root,"bunko"),"--format=json","--lang=en-US"],"native-archive-tests");
 runtime_audit(root,mio,output);kaku archive_hash=package_image(image,read_file(path.join(root,"LICENSE")),output);progress("native-package","PASS");kaku prefix=path.join(output,"install");install_image(read_file(path.join(output,artifact_name())),prefix,digest(image));kaku installed=path.join(prefix,"mio");kaku smoke=path.join(output,"smoke.mio");write_text(smoke,"yobu \"kiso/array\";yobu \"kiso/math\";kaku values=array.make[int64](3,7);chant(math.max(values[2],9));\n");kaku app=path.join(output,"smoke.native");child(installed,[installed,"build",smoke,"-o",app],"installed-embedded-source-build");child(app,[app],"standalone-native-application");require(core_manifest(root)==core && component_manifest(root)==components,"source changed during native CI");write_text(path.join(output,"release-provenance.json"),metadata(root,seed_hash,digest(image),archive_hash,core_hash,digest(string.to_bytes(components)),revision));write_text(path.join(output,"PASS"),"PURE_MIO_NATIVE_CI_LOCAL=PASS\n");progress("native-ci","PASS");
}
waza main() -> unit {
 kaku args=os.arguments();moshi(len(args)<2){kaesu;}kaku mode=args[1];
 moshi(mode=="ci"){require(len(args)==6,"ci <absolute-source-root> <trusted-native-seed> <new-absolute-output> <revision>");ci(absolute_existing(args[2]),absolute_existing(args[3]),output_path(args[4]),args[5]);kaesu;}
 moshi(mode=="package"){require(len(args)==5,"package <signed-mio> <license> <new-absolute-output>");kaku output=output_path(args[4]);new_directory(output);kaku hash=package_image(read_file(args[2]),read_file(args[3]),output);write_text(path.join(output,"scope.txt"),"Native packaging only; not a source-build/CI gate.\n");chant(hash);kaesu;}
 moshi(mode=="install"){require(len(args)==5,"install <archive> <new-absolute-prefix> <expected-mio-sha256>");install_image(read_file(args[2]),output_path(args[3]),args[4]);kaesu;}
 moshi(mode=="help"){chant("Native Mio CI/package/install source program; invoke with mio run tools/native-ci -- <mode> ...");kaesu;}fatal("unknown native-ci mode");
}main();
