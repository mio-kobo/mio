(version 1)
(allow default)
(deny network*)
(deny process-exec)
(allow process-exec (literal (param "SEED")))
(allow process-exec (subpath (param "OUT")))
(allow process-exec (regex #"^(/private)?/tmp/mio-run-[0-9]+/program$"))
(allow process-exec (regex #"^(/private)?/tmp/mio-test-[0-9]+/test-[0-9]+[.]native$"))
(allow process-exec (regex #"^(/private)?/tmp/mio-globals-[0-9]+/program$"))
(deny file-write* (subpath (param "SOURCE")))
