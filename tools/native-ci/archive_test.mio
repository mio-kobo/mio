yobu "kiso/testing";
waza test_crc32_standard_vectors() -> unit {testing.expect(crc32([])==0,"empty CRC32");testing.expect(crc32(string.to_bytes("123456789"))==3421780262,"IEEE CRC32 check vector");}
waza test_gzip_empty_exact_format() -> unit {kaku expected: []uint8=[31,139,8,0,0,0,0,0,0,255,1,0,0,255,255,0,0,0,0,0,0,0,0];testing.expect(bytes.equal(gzip_store([]),expected),"RFC1951 stored empty block and RFC1952 header/footer");kaku opened=gzip_open(expected);testing.expect(opened.error=="" && len(opened.files[0].data)==0,"empty member opens");}
waza test_gzip_multiple_blocks_and_corruption() -> unit {kaku input=array.make[uint8](131073,uint8(57));input[65535]=uint8(255);kaku packed=gzip_store(input);kaku result=gzip_open(packed);testing.expect(result.error=="" && bytes.equal(result.files[0].data,input),"65535-byte block boundaries");kaku corrupt=bytes.clone(packed);corrupt[len(corrupt)-8]=uint8(int64(corrupt[len(corrupt)-8])+1);testing.expect(gzip_open(corrupt).error!="","CRC corruption rejected");corrupt=bytes.clone(packed);corrupt[13]=uint8(1);testing.expect(gzip_open(corrupt).error!="","NLEN corruption rejected");testing.expect(gzip_open(slice(packed,0,len(packed)-1)).error!="","truncation rejected");}
waza test_ustar_roundtrip_and_paths() -> unit {kaku files: []Payload=[Payload {name:"mio",data:[1,2,3],mode:493},Payload {name:"LICENSE",data:string.to_bytes("license"),mode:420},Payload {name:"README.txt",data:string.to_bytes("native"),mode:420}];kaku packed=tar_store(files);kaku result=tar_open(packed);testing.expect(result.error=="" && len(result.files)==3 && bytes.equal(result.files[0].data,files[0].data),"ustar content/mode roundtrip");kaku duplicate: []Payload=[files[0],files[0]];testing.expect(tar_open(tar_store(duplicate)).error!="","duplicate rejected");testing.expect(tar_open(tar_store([Payload {name:"../mio",data:[],mode:493}])).error!="","path traversal rejected");packed[0]=uint8(120);testing.expect(tar_open(packed).error!="","header checksum corruption rejected");}

waza test_manifest_path_component_order() -> unit {kaku values: []string=["selfhost/frontend-driver/main.mio","selfhost/frontend/compiler.mio","selfhost/frontend/analysis_test.mio"];sort_paths(values);testing.expect(values[0]=="selfhost/frontend/analysis_test.mio" && values[1]=="selfhost/frontend/compiler.mio" && values[2]=="selfhost/frontend-driver/main.mio","frozen manifest path-component ordering");}
