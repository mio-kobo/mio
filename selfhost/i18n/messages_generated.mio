    string.write_string(output, "\nerr.help_args\thelp menerima paling banyak satu nama perintah\nerr.help_unknown\ttidak ada bantuan untuk perintah tidak dikenal: {0}\nerr.host_target\trun dan exec memerlukan target host {0}\nerr.invalid_color\tmode warna tidak valid: {0} (diharapkan auto, always, atau never)\nerr.invalid_format\tformat tidak valid: {0} (diharapkan human, short, atau json)\nerr.invalid_theme\ttema tidak valid: {0} (diharapkan auto, dark, atau light)\nerr.missing_value\tnilai untuk opsi {0} tidak ada\nerr.multiple_entries\thanya satu entri sumber yang boleh diberikan\nerr.observe\t--observe hanya berlaku untuk pembangunan native darwin-arm64 dari sumber\nerr.program_args\targumen program memerlukan run atau exec\nerr.protect_run_dir\ttidak dapat melindungi direktori eksekusi privat\nerr.read_mochi\ttidak dapat membaca masukan Mochi\nerr.run_output\trun dan exec mengelola keluaran native mereka sendiri\nerr.spawn\tprogram native tidak dapat dijalankan\nerr.symbols\t--emit-symbols hanya berlaku untuk pembangunan native darwin-arm64 dari sumber\nerr.target\ttarget tidak didukung: {0} (diharapkan darwin-arm64, linux-amd64, atau windows-amd64)\nerr.unknown_command\tperintah tidak dikenal: {0}\nerr.unknown_option\topsi tidak dikenal: {0}\nerr.version_args\tperintah version tidak menerima argumen\nerr.write_disasm\ttidak dapat menulis hasil pembongkaran");
    string.write_string(output, "\nerr.write_mochi\ttidak dapat menulis keluaran Mochi\nerr.write_native\ttidak dapat menulis keluaran native\nhelp.commands\tPerintah\nhelp.examples\tContoh\nhelp.group.compilation\tKompilasi\nhelp.group.diagnostics\tDiagnostik\nhelp.group.execution\tEksekusi\nhelp.group.general\tUmum\nhelp.group.testing\tPengujian\nhelp.group.tools\tAlat pengembangan\nhelp.more\tJalankan 'mio help <perintah>' untuk detail perintah.\nhelp.options\tOpsi\nhelp.tagline\tKompilator Native AOT dan rangkaian alat untuk bahasa Mio\nhelp.title\tMio {0}\nhelp.usage\tPenggunaan\nopt.bunko\tGunakan akar Bunko ini alih-alih bawaan\nopt.color\tKendalikan keluaran berwarna: auto, always, atau never\nopt.emit\tHasilkan bytecode Mochi alih-alih image native\nopt.format\tPilih format keluaran: human, short, atau json\nopt.gc_stress\tBangun dengan pemeriksaan tekanan pengumpul sampah yang agresif");
    string.write_string(output, "\nopt.help\tTampilkan bantuan\nopt.lang\tPilih bahasa keluaran dengan tag BCP 47, misalnya ja-JP\nopt.observe\tCatat pengamatan pembangunan native\nopt.output\tTulis keluaran ke jalur ini\nopt.program_args\tTeruskan argumen lainnya ke program\nopt.run_filter\tJalankan hanya pengujian yang namanya cocok dengan ekspresi reguler ini\nopt.stdio\tGunakan input dan output standar untuk server bahasa\nopt.symbols\tTulis informasi simbol native ke berkas ini\nopt.target\tBangun untuk darwin-arm64, linux-amd64, atau windows-amd64\nopt.theme\tPilih palet semantik: auto, dark, atau light\nopt.verbose\tSertakan detail diagnostik tambahan\nopt.version\tTampilkan informasi versi\ntest.assertion\tasersi gagal\ntest.bunko_empty\tjalur pengganti Bunko tidak boleh kosong\ntest.bunko_missing\tnilai untuk --bunko-root tidak ada\ntest.compile_failed\tkompilasi gagal\ntest.duration\tdurasi total\ntest.empty_filter\tfilter pengujian tidak boleh kosong\ntest.empty_lang\ttag bahasa tidak boleh kosong\ntest.fail\tGAGAL");
    string.write_string(output, "\ntest.filter_invalid\tfilter pengujian tidak valid: {0}\ntest.invalid_arg\targumen pengujian tidak valid: {0}\ntest.invalid_signature\tsignatur fungsi pengujian tidak valid\ntest.io_clean_dir\ttidak dapat membersihkan direktori pengujian privat\ntest.io_clean_image\ttidak dapat membersihkan image pengujian native\ntest.io_dir\ttidak dapat membuat direktori pengujian privat\ntest.io_protect\ttidak dapat melindungi direktori pengujian privat\ntest.missing_target\ttarget pengujian tidak ada\ntest.no_match\ttidak ada pengujian yang cocok dengan --run={0}\ntest.none\ttidak ada pengujian ditemukan\ntest.pass\tLULUS\ntest.resource\tbatas sumber daya terlampaui\ntest.runtime\tkesalahan runtime\ntest.skip\tDILEWATI\ntest.skipped\tPengujian dilewati: {0}\ntest.starting\tMemulai pengujian {0}\ntest.summary\tPengujian selesai: {0} lulus, {1} gagal");
    kaesu string.builder_string(output);
}

waza text_it_it() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tverifica superata\ncli.lsp_unknown\targomento lsp sconosciuto: {0}\ncmd.build\tCrea un eseguibile nativo o bytecode Mochi dai sorgenti Mio\ncmd.check\tAnalizza i sorgenti Mio senza produrre output\ncmd.disasm\tDisassembla un programma Mochi compilato\ncmd.exec\tEsegue un programma Mochi compilato\ncmd.help\tMostra la guida di Mio o di un singolo comando\ncmd.lsp\tAvvia il server linguistico Mio su input/output standard\ncmd.run\tCrea ed esegue un programma Mio dai sorgenti\ncmd.test\tIndividua ed esegue i pacchetti di test Mio\ncmd.version\tMostra le informazioni sulla versione\ndiag.cause\tcausa\nerr.analysis\tanalisi dei sorgenti non riuscita\nerr.bunko_empty\til percorso Bunko alternativo deve essere esplicito e non vuoto\nerr.chmod_native\timpossibile rendere eseguibile l'output nativo\nerr.cleanup\tpulizia dopo l'esecuzione non riuscita\nerr.create_run_dir\timpossibile creare una directory di esecuzione privata\nerr.emit_mochi\tquesto comando non può emettere bytecode Mochi\nerr.empty_paths\ti percorsi di origine e di output non possono essere vuoti\nerr.gc_stress\t--gc-stress si applica solo alle build native dai sorgenti");
    string.write_string(output, "\nerr.help_args\thelp accetta al massimo un nome di comando\nerr.help_unknown\tnessuna guida per il comando sconosciuto: {0}\nerr.host_target\trun ed exec richiedono la destinazione host {0}\nerr.invalid_color\tmodalità colore non valida: {0} (attesa auto, always o never)\nerr.invalid_format\tformato non valido: {0} (atteso human, short o json)\nerr.invalid_theme\ttema non valido: {0} (atteso auto, dark o light)\nerr.missing_value\tvalore mancante per l'opzione {0}\nerr.multiple_entries\tpuò essere indicata una sola voce sorgente\nerr.observe\t--observe si applica solo alle build native darwin-arm64 dai sorgenti\nerr.program_args\tgli argomenti del programma richiedono run o exec\nerr.protect_run_dir\timpossibile proteggere la directory di esecuzione privata\nerr.read_mochi\timpossibile leggere l'input Mochi\nerr.run_output\trun ed exec gestiscono il proprio output nativo\nerr.spawn\timpossibile avviare il programma nativo\nerr.symbols\t--emit-symbols si applica solo alle build native darwin-arm64 dai sorgenti\nerr.target\tdestinazione non supportata: {0} (attesa darwin-arm64, linux-amd64 o windows-amd64)\nerr.unknown_command\tcomando sconosciuto: {0}\nerr.unknown_option\topzione sconosciuta: {0}\nerr.version_args\til comando version non accetta argomenti\nerr.write_disasm\timpossibile scrivere il disassemblato");
    string.write_string(output, "\nerr.write_mochi\timpossibile scrivere l'output Mochi\nerr.write_native\timpossibile scrivere l'output nativo\nhelp.commands\tComandi\nhelp.examples\tEsempi\nhelp.group.compilation\tCompilazione\nhelp.group.diagnostics\tDiagnostica\nhelp.group.execution\tEsecuzione\nhelp.group.general\tGenerale\nhelp.group.testing\tTest\nhelp.group.tools\tStrumenti di sviluppo\nhelp.more\tEsegui 'mio help <comando>' per i dettagli di un comando.\nhelp.options\tOpzioni\nhelp.tagline\tCompilatore Native AOT e toolchain per il linguaggio Mio\nhelp.title\tMio {0}\nhelp.usage\tUtilizzo\nopt.bunko\tUsa questa radice Bunko invece di quella predefinita\nopt.color\tControlla l'output a colori: auto, always o never\nopt.emit\tEmette bytecode Mochi invece di un'immagine nativa\nopt.format\tSeleziona il formato di output: human, short o json\nopt.gc_stress\tCompila con controlli di stress aggressivi del garbage collector");
    string.write_string(output, "\nopt.help\tMostra la guida\nopt.lang\tSeleziona la lingua di output con un tag BCP 47, ad esempio ja-JP\nopt.observe\tRegistra osservazioni della compilazione nativa\nopt.output\tScrive l'output in questo percorso\nopt.program_args\tPassa gli argomenti rimanenti al programma\nopt.run_filter\tEsegue solo i test il cui nome corrisponde a questa espressione regolare\nopt.stdio\tUsa input e output standard per il server linguistico\nopt.symbols\tScrive le informazioni sui simboli nativi in questo file\nopt.target\tCompila per darwin-arm64, linux-amd64 o windows-amd64\nopt.theme\tSeleziona la palette semantica: auto, dark o light\nopt.verbose\tInclude dettagli diagnostici aggiuntivi\nopt.version\tMostra le informazioni sulla versione\ntest.assertion\tasserzione fallita\ntest.bunko_empty\til percorso Bunko alternativo non può essere vuoto\ntest.bunko_missing\tvalore mancante per --bunko-root\ntest.compile_failed\tcompilazione fallita\ntest.duration\tdurata totale\ntest.empty_filter\til filtro dei test non può essere vuoto\ntest.empty_lang\til tag della lingua non può essere vuoto\ntest.fail\tFALLITO");
    string.write_string(output, "\ntest.filter_invalid\tfiltro di test non valido: {0}\ntest.invalid_arg\targomento di test non valido: {0}\ntest.invalid_signature\tfirma della funzione di test non valida\ntest.io_clean_dir\timpossibile rimuovere la directory di test privata\ntest.io_clean_image\timpossibile rimuovere l'immagine di test nativa\ntest.io_dir\timpossibile creare una directory di test privata\ntest.io_protect\timpossibile proteggere la directory di test privata\ntest.missing_target\tdestinazione dei test mancante\ntest.no_match\tnessun test corrisponde a --run={0}\ntest.none\tnessun test trovato\ntest.pass\tSUPERATO\ntest.resource\tlimite di risorse superato\ntest.runtime\terrore di esecuzione\ntest.skip\tSALTATO\ntest.skipped\tTest saltati: {0}\ntest.starting\tAvvio dei test {0}\ntest.summary\tTest completati: {0} superati, {1} falliti");
    kaesu string.builder_string(output);
}

waza text_ja_jp() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tチェックに合格しました\ncli.lsp_unknown\t不明な lsp 引数: {0}\ncmd.build\tMio ソースからネイティブ実行ファイルまたは Mochi バイトコードをビルドします\ncmd.check\t出力を生成せずに Mio ソースを解析します\ncmd.disasm\tコンパイル済みの Mochi プログラムを逆アセンブルします\ncmd.exec\tコンパイル済みの Mochi プログラムを実行します\ncmd.help\tMio または単一コマンドのヘルプを表示します\ncmd.lsp\t標準入出力で Mio 言語サーバーを起動します\ncmd.run\tソースから Mio プログラムをビルドして実行します\ncmd.test\tMio テストパッケージを検出して実行します\ncmd.version\tバージョン情報を表示します\ndiag.cause\t原因\nerr.analysis\tソース解析に失敗しました\nerr.bunko_empty\tBunko の上書きパスは明示的かつ空でない必要があります\nerr.chmod_native\tネイティブ出力を実行可能にできません\nerr.cleanup\t実行後のクリーンアップに失敗しました\nerr.create_run_dir\t専用の実行ディレクトリを作成できません\nerr.emit_mochi\tこのコマンドは Mochi バイトコードを出力できません\nerr.empty_paths\tソースパスと出力パスは空にできません\nerr.gc_stress\t--gc-stress はソースからのネイティブビルドにのみ適用されます");
    string.write_string(output, "\nerr.help_args\thelp は最大 1 つのコマンド名を受け取ります\nerr.help_unknown\t不明なコマンドのヘルプはありません: {0}\nerr.host_target\trun と exec にはホストターゲット {0} が必要です\nerr.invalid_color\t無効な色モード: {0}（auto、always、never のいずれか）\nerr.invalid_format\t無効な形式: {0}（human、short、json のいずれか）\nerr.invalid_theme\t無効なテーマ: {0}（auto、dark、light のいずれか）\nerr.missing_value\tオプション {0} の値がありません\nerr.multiple_entries\tソースエントリーは 1 つだけ指定できます\nerr.observe\t--observe はソースからの darwin-arm64 ネイティブビルドにのみ適用されます\nerr.program_args\tプログラム引数は run または exec でのみ使用できます\nerr.protect_run_dir\t専用の実行ディレクトリを保護できません\nerr.read_mochi\tMochi 入力を読み取れません\nerr.run_output\trun と exec はネイティブ出力を自ら管理します\nerr.spawn\tネイティブプログラムを起動できませんでした\nerr.symbols\t--emit-symbols はソースからの darwin-arm64 ネイティブビルドにのみ適用されます\nerr.target\t未対応のターゲット: {0}（darwin-arm64、linux-amd64、windows-amd64 のいずれか）\nerr.unknown_command\t不明なコマンド: {0}\nerr.unknown_option\t不明なオプション: {0}\nerr.version_args\tversion コマンドは引数を受け取りません\nerr.write_disasm\t逆アセンブル結果を書き込めません");
    string.write_string(output, "\nerr.write_mochi\tMochi 出力を書き込めません\nerr.write_native\tネイティブ出力を書き込めません\nhelp.commands\tコマンド\nhelp.examples\t例\nhelp.group.compilation\tコンパイル\nhelp.group.diagnostics\t診断\nhelp.group.execution\t実行\nhelp.group.general\t一般\nhelp.group.testing\tテスト\nhelp.group.tools\t開発ツール\nhelp.more\tコマンドの詳細は 'mio help <コマンド>' を実行してください。\nhelp.options\tオプション\nhelp.tagline\tMio 言語の Native AOT コンパイラーとツールチェーン\nhelp.title\tMio {0}\nhelp.usage\t使用方法\nopt.bunko\t既定の代わりにこの Bunko ルートを使用します\nopt.color\t色出力を制御します: auto、always、never\nopt.emit\tネイティブイメージの代わりに Mochi バイトコードを出力します\nopt.format\t出力形式を選択します: human、short、json\nopt.gc_stress\t積極的なガベージコレクター負荷検査付きでビルドします");
    string.write_string(output, "\nopt.help\tヘルプを表示します\nopt.lang\tBCP 47 タグで出力言語を選択します（例: ja-JP）\nopt.observe\tネイティブビルドの観測データを記録します\nopt.output\t出力をこのパスに書き込みます\nopt.program_args\t残りの引数をプログラムに渡します\nopt.run_filter\t名前がこの正規表現に一致するテストだけを実行します\nopt.stdio\t言語サーバーに標準入出力を使用します\nopt.symbols\tネイティブシンボル情報をこのファイルに書き込みます\nopt.target\tdarwin-arm64、linux-amd64、windows-amd64 向けにビルドします\nopt.theme\t意味に基づく配色を選択します: auto、dark、light\nopt.verbose\t追加の診断詳細を出力します\nopt.version\tバージョン情報を表示します\ntest.assertion\tアサーション失敗\ntest.bunko_empty\tBunko の上書きパスは空にできません\ntest.bunko_missing\t--bunko-root の値がありません\ntest.compile_failed\tコンパイル失敗\ntest.duration\t合計実行時間\ntest.empty_filter\tテストフィルターは空にできません\ntest.empty_lang\t言語タグは空にできません\ntest.fail\t失敗");
    string.write_string(output, "\ntest.filter_invalid\t無効なテストフィルター: {0}\ntest.invalid_arg\t無効なテスト引数: {0}\ntest.invalid_signature\tテスト関数のシグネチャが無効です\ntest.io_clean_dir\t専用のテストディレクトリを削除できません\ntest.io_clean_image\tネイティブテストイメージを削除できません\ntest.io_dir\t専用のテストディレクトリを作成できません\ntest.io_protect\t専用のテストディレクトリを保護できません\ntest.missing_target\tテストターゲットがありません\ntest.no_match\t--run={0} に一致するテストがありません\ntest.none\tテストが見つかりません\ntest.pass\t成功\ntest.resource\tリソース制限を超えました\ntest.runtime\t実行時エラー\ntest.skip\tスキップ\ntest.skipped\tスキップしたテスト: {0}\ntest.starting\tテストを開始します {0}\ntest.summary\tテスト完了：{0} 件成功、{1} 件失敗");
    kaesu string.builder_string(output);
}

waza text_ko_kr() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\t검사 통과\ncli.lsp_unknown\t알 수 없는 lsp 인수: {0}\ncmd.build\tMio 소스에서 네이티브 실행 파일 또는 Mochi 바이트코드를 빌드합니다\ncmd.check\t출력 없이 Mio 소스를 분석합니다\ncmd.disasm\t컴파일된 Mochi 프로그램을 역어셈블합니다\ncmd.exec\t컴파일된 Mochi 프로그램을 실행합니다\ncmd.help\tMio 또는 단일 명령의 도움말을 표시합니다\ncmd.lsp\t표준 입출력으로 Mio 언어 서버를 시작합니다\ncmd.run\t소스에서 Mio 프로그램을 빌드하고 실행합니다\ncmd.test\tMio 테스트 패키지를 찾아 실행합니다\ncmd.version\t버전 정보를 표시합니다\ndiag.cause\t원인\nerr.analysis\t소스 분석에 실패했습니다\nerr.bunko_empty\tBunko 재정의 경로는 명시적이고 비어 있지 않아야 합니다\nerr.chmod_native\t네이티브 출력을 실행 가능하게 만들 수 없습니다\nerr.cleanup\t실행 정리에 실패했습니다\nerr.create_run_dir\t비공개 실행 디렉터리를 만들 수 없습니다\nerr.emit_mochi\t이 명령은 Mochi 바이트코드를 출력할 수 없습니다\nerr.empty_paths\t소스 경로와 출력 경로는 비어 있을 수 없습니다\nerr.gc_stress\t--gc-stress는 소스에서 네이티브 빌드에만 적용됩니다");
    string.write_string(output, "\nerr.help_args\thelp는 명령 이름을 최대 하나만 받습니다\nerr.help_unknown\t알 수 없는 명령의 도움말이 없습니다: {0}\nerr.host_target\trun과 exec에는 호스트 대상 {0}이(가) 필요합니다\nerr.invalid_color\t잘못된 색상 모드: {0} (auto, always, never 중 하나)\nerr.invalid_format\t잘못된 형식: {0} (human, short, json 중 하나)\nerr.invalid_theme\t잘못된 테마: {0} (auto, dark, light 중 하나)\nerr.missing_value\t옵션 {0}의 값이 없습니다\nerr.multiple_entries\t소스 항목은 하나만 지정할 수 있습니다\nerr.observe\t--observe는 소스에서 darwin-arm64 네이티브 빌드에만 적용됩니다\nerr.program_args\t프로그램 인수는 run 또는 exec에서만 사용할 수 있습니다\nerr.protect_run_dir\t비공개 실행 디렉터리를 보호할 수 없습니다\nerr.read_mochi\tMochi 입력을 읽을 수 없습니다\nerr.run_output\trun과 exec는 자체 네이티브 출력을 관리합니다\nerr.spawn\t네이티브 프로그램을 시작할 수 없습니다\nerr.symbols\t--emit-symbols는 소스에서 darwin-arm64 네이티브 빌드에만 적용됩니다\nerr.target\t지원되지 않는 대상: {0} (darwin-arm64, linux-amd64, windows-amd64 중 하나)\nerr.unknown_command\t알 수 없는 명령: {0}\nerr.unknown_option\t알 수 없는 옵션: {0}\nerr.version_args\tversion 명령은 인수를 받지 않습니다\nerr.write_disasm\t역어셈블 결과를 쓸 수 없습니다");
    string.write_string(output, "\nerr.write_mochi\tMochi 출력을 쓸 수 없습니다\nerr.write_native\t네이티브 출력을 쓸 수 없습니다\nhelp.commands\t명령\nhelp.examples\t예제\nhelp.group.compilation\t컴파일\nhelp.group.diagnostics\t진단\nhelp.group.execution\t실행\nhelp.group.general\t일반\nhelp.group.testing\t테스트\nhelp.group.tools\t개발 도구\nhelp.more\t명령의 세부 정보는 'mio help <명령>'을 실행하세요.\nhelp.options\t옵션\nhelp.tagline\tMio 언어용 Native AOT 컴파일러 및 도구 모음\nhelp.title\tMio {0}\nhelp.usage\t사용법\nopt.bunko\t기본값 대신 이 Bunko 루트를 사용합니다\nopt.color\t색상 출력을 제어합니다: auto, always, never\nopt.emit\t네이티브 이미지 대신 Mochi 바이트코드를 출력합니다\nopt.format\t출력 형식을 선택합니다: human, short, json\nopt.gc_stress\t적극적인 가비지 수집기 부하 검사와 함께 빌드합니다");
    string.write_string(output, "\nopt.help\t도움말을 표시합니다\nopt.lang\tBCP 47 태그로 출력 언어를 선택합니다(예: ja-JP)\nopt.observe\t네이티브 빌드 관측 데이터를 기록합니다\nopt.output\t출력을 이 경로에 씁니다\nopt.program_args\t나머지 인수를 프로그램에 전달합니다\nopt.run_filter\t이름이 이 정규식과 일치하는 테스트만 실행합니다\nopt.stdio\t언어 서버에 표준 입출력을 사용합니다\nopt.symbols\t네이티브 기호 정보를 이 파일에 씁니다\nopt.target\tdarwin-arm64, linux-amd64, windows-amd64용으로 빌드합니다\nopt.theme\t의미 기반 색상 구성을 선택합니다: auto, dark, light\nopt.verbose\t추가 진단 세부 정보를 표시합니다\nopt.version\t버전 정보를 표시합니다\ntest.assertion\t어설션 실패\ntest.bunko_empty\tBunko 재정의 경로는 비어 있을 수 없습니다\ntest.bunko_missing\t--bunko-root의 값이 없습니다\ntest.compile_failed\t컴파일 실패\ntest.duration\t총 실행 시간\ntest.empty_filter\t테스트 필터는 비어 있을 수 없습니다\ntest.empty_lang\t언어 태그는 비어 있을 수 없습니다\ntest.fail\t실패");
    string.write_string(output, "\ntest.filter_invalid\t잘못된 테스트 필터: {0}\ntest.invalid_arg\t잘못된 테스트 인수: {0}\ntest.invalid_signature\t테스트 함수 시그니처가 잘못되었습니다\ntest.io_clean_dir\t비공개 테스트 디렉터리를 정리할 수 없습니다\ntest.io_clean_image\t네이티브 테스트 이미지를 정리할 수 없습니다\ntest.io_dir\t비공개 테스트 디렉터리를 만들 수 없습니다\ntest.io_protect\t비공개 테스트 디렉터리를 보호할 수 없습니다\ntest.missing_target\t테스트 대상이 없습니다\ntest.no_match\t--run={0}과(와) 일치하는 테스트가 없습니다\ntest.none\t테스트를 찾을 수 없습니다\ntest.pass\t통과\ntest.resource\t리소스 한도 초과\ntest.runtime\t런타임 오류\ntest.skip\t건너뜀\ntest.skipped\t건너뛴 테스트: {0}\ntest.starting\t테스트 시작 {0}\ntest.summary\t테스트 완료: {0}개 통과, {1}개 실패");
    kaesu string.builder_string(output);
}

waza text_ms_my() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tsemakan lulus\ncli.lsp_unknown\thujah lsp tidak dikenali: {0}\ncmd.build\tBina fail boleh laku asli atau bait kod Mochi daripada sumber Mio\ncmd.check\tAnalisis sumber Mio tanpa menghasilkan output\ncmd.disasm\tNyahlaras program Mochi yang telah dikompil\ncmd.exec\tJalankan program Mochi yang telah dikompil\ncmd.help\tTunjukkan bantuan untuk Mio atau satu perintah\ncmd.lsp\tMulakan pelayan bahasa Mio melalui input/output piawai\ncmd.run\tBina dan jalankan program Mio daripada sumber\ncmd.test\tCari dan jalankan pakej ujian Mio\ncmd.version\tTunjukkan maklumat versi\ndiag.cause\tpunca\nerr.analysis\tanalisis sumber gagal\nerr.bunko_empty\tlaluan ganti Bunko mesti jelas dan tidak kosong\nerr.chmod_native\ttidak dapat menjadikan output asli boleh laku\nerr.cleanup\tpembersihan selepas pelaksanaan gagal\nerr.create_run_dir\ttidak dapat mencipta direktori pelaksanaan peribadi\nerr.emit_mochi\tperintah ini tidak boleh mengeluarkan bait kod Mochi\nerr.empty_paths\tlaluan sumber dan output tidak boleh kosong\nerr.gc_stress\t--gc-stress hanya terpakai pada binaan asli daripada sumber");
    string.write_string(output, "\nerr.help_args\thelp menerima paling banyak satu nama perintah\nerr.help_unknown\ttiada bantuan untuk perintah tidak dikenali: {0}\nerr.host_target\trun dan exec memerlukan sasaran hos {0}\nerr.invalid_color\tmod warna tidak sah: {0} (dijangka auto, always atau never)\nerr.invalid_format\tformat tidak sah: {0} (dijangka human, short atau json)\nerr.invalid_theme\ttema tidak sah: {0} (dijangka auto, dark atau light)\nerr.missing_value\tnilai untuk pilihan {0} tiada\nerr.multiple_entries\thanya satu entri sumber boleh diberikan\nerr.observe\t--observe hanya terpakai pada binaan asli darwin-arm64 daripada sumber\nerr.program_args\thujah program memerlukan run atau exec\nerr.protect_run_dir\ttidak dapat melindungi direktori pelaksanaan peribadi\nerr.read_mochi\ttidak dapat membaca input Mochi\nerr.run_output\trun dan exec menguruskan output asli mereka sendiri\nerr.spawn\tprogram asli tidak dapat dimulakan\nerr.symbols\t--emit-symbols hanya terpakai pada binaan asli darwin-arm64 daripada sumber\nerr.target\tsasaran tidak disokong: {0} (dijangka darwin-arm64, linux-amd64 atau windows-amd64)\nerr.unknown_command\tperintah tidak dikenali: {0}\nerr.unknown_option\tpilihan tidak dikenali: {0}\nerr.version_args\tperintah version tidak menerima hujah\nerr.write_disasm\ttidak dapat menulis nyahlaras");
    string.write_string(output, "\nerr.write_mochi\ttidak dapat menulis output Mochi\nerr.write_native\ttidak dapat menulis output asli\nhelp.commands\tPerintah\nhelp.examples\tContoh\nhelp.group.compilation\tPengkompilan\nhelp.group.diagnostics\tDiagnostik\nhelp.group.execution\tPelaksanaan\nhelp.group.general\tUmum\nhelp.group.testing\tUjian\nhelp.group.tools\tAlat pembangunan\nhelp.more\tJalankan 'mio help <perintah>' untuk butiran perintah.\nhelp.options\tPilihan\nhelp.tagline\tPengkompil Native AOT dan rangkaian alat untuk bahasa Mio\nhelp.title\tMio {0}\nhelp.usage\tPenggunaan\nopt.bunko\tGunakan akar Bunko ini dan bukan lalai\nopt.color\tKawal output berwarna: auto, always atau never\nopt.emit\tKeluarkan bait kod Mochi dan bukan imej asli\nopt.format\tPilih format output: human, short atau json\nopt.gc_stress\tBina dengan pemeriksaan tekanan pengumpul sampah yang agresif");
    string.write_string(output, "\nopt.help\tTunjukkan bantuan\nopt.lang\tPilih bahasa output dengan tag BCP 47, contohnya ja-JP\nopt.observe\tRekod pemerhatian pembinaan asli\nopt.output\tTulis output ke laluan ini\nopt.program_args\tHantar baki hujah kepada program\nopt.run_filter\tJalankan hanya ujian yang namanya sepadan dengan ungkapan biasa ini\nopt.stdio\tGunakan input dan output piawai untuk pelayan bahasa\nopt.symbols\tTulis maklumat simbol asli ke fail ini\nopt.target\tBina untuk darwin-arm64, linux-amd64 atau windows-amd64\nopt.theme\tPilih palet semantik: auto, dark atau light\nopt.verbose\tSertakan butiran diagnostik tambahan\nopt.version\tTunjukkan maklumat versi\ntest.assertion\tpenegasan gagal\ntest.bunko_empty\tlaluan ganti Bunko tidak boleh kosong\ntest.bunko_missing\tnilai untuk --bunko-root tiada\ntest.compile_failed\tpengkompilan gagal\ntest.duration\tjumlah tempoh\ntest.empty_filter\tpenapis ujian tidak boleh kosong\ntest.empty_lang\ttag bahasa tidak boleh kosong\ntest.fail\tGAGAL");
    string.write_string(output, "\ntest.filter_invalid\tpenapis ujian tidak sah: {0}\ntest.invalid_arg\thujah ujian tidak sah: {0}\ntest.invalid_signature\ttandatangan fungsi ujian tidak sah\ntest.io_clean_dir\ttidak dapat membersihkan direktori ujian peribadi\ntest.io_clean_image\ttidak dapat membersihkan imej ujian asli\ntest.io_dir\ttidak dapat mencipta direktori ujian peribadi\ntest.io_protect\ttidak dapat melindungi direktori ujian peribadi\ntest.missing_target\tsasaran ujian tiada\ntest.no_match\ttiada ujian sepadan dengan --run={0}\ntest.none\ttiada ujian ditemui\ntest.pass\tLULUS\ntest.resource\thad sumber dilampaui\ntest.runtime\tralat masa jalan\ntest.skip\tDILANGKAU\ntest.skipped\tUjian dilangkau: {0}\ntest.starting\tMemulakan ujian {0}\ntest.summary\tUjian selesai: {0} lulus, {1} gagal");
    kaesu string.builder_string(output);
}

waza text_nb_no() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tkontrollen bestått\ncli.lsp_unknown\tukjent lsp-argument: {0}\ncmd.build\tBygg en native kjørbar fil eller Mochi-bytekode fra Mio-kildekode\ncmd.check\tAnalyser Mio-kildekode uten å produsere utdata\ncmd.disasm\tDisassembler et kompilert Mochi-program\ncmd.exec\tKjør et kompilert Mochi-program\ncmd.help\tVis hjelp for Mio eller én kommando\ncmd.lsp\tStart Mio-språkserveren over standard inn- og utdata\ncmd.run\tBygg og kjør et Mio-program fra kildekode\ncmd.test\tFinn og kjør Mio-testpakker\ncmd.version\tVis versjonsinformasjon\ndiag.cause\tårsak\nerr.analysis\tkildeanalysen mislyktes\nerr.bunko_empty\tBunko-overstyringens bane må være eksplisitt og ikke tom\nerr.chmod_native\tkan ikke gjøre native utdata kjørbare\nerr.cleanup\toppryddingen etter kjøring mislyktes\nerr.create_run_dir\tkan ikke opprette en privat kjøringskatalog\nerr.emit_mochi\tdenne kommandoen kan ikke skrive Mochi-bytekode\nerr.empty_paths\tkilde- og utdatabanen kan ikke være tomme\nerr.gc_stress\t--gc-stress gjelder bare native bygg fra kildekode");
    string.write_string(output, "\nerr.help_args\thelp tar høyst ett kommandonavn\nerr.help_unknown\tingen hjelp for ukjent kommando: {0}\nerr.host_target\trun og exec krever vertsmålet {0}\nerr.invalid_color\tugyldig fargemodus: {0} (forventet auto, always eller never)\nerr.invalid_format\tugyldig format: {0} (forventet human, short eller json)\nerr.invalid_theme\tugyldig tema: {0} (forventet auto, dark eller light)\nerr.missing_value\tverdien mangler for alternativet {0}\nerr.multiple_entries\tbare én kildeoppføring kan angis\nerr.observe\t--observe gjelder bare native darwin-arm64-bygg fra kildekode\nerr.program_args\tprogramargumenter krever run eller exec\nerr.protect_run_dir\tkan ikke beskytte den private kjøringskatalogen\nerr.read_mochi\tkan ikke lese Mochi-inndata\nerr.run_output\trun og exec håndterer sin egen native utdata\nerr.spawn\tdet native programmet kunne ikke startes\nerr.symbols\t--emit-symbols gjelder bare native darwin-arm64-bygg fra kildekode\nerr.target\tmål som ikke støttes: {0} (forventet darwin-arm64, linux-amd64 eller windows-amd64)\nerr.unknown_command\tukjent kommando: {0}\nerr.unknown_option\tukjent alternativ: {0}\nerr.version_args\tkommandoen version tar ingen argumenter\nerr.write_disasm\tkan ikke skrive disassembleringen");
    string.write_string(output, "\nerr.write_mochi\tkan ikke skrive Mochi-utdata\nerr.write_native\tkan ikke skrive native utdata\nhelp.commands\tKommandoer\nhelp.examples\tEksempler\nhelp.group.compilation\tKompilering\nhelp.group.diagnostics\tDiagnostikk\nhelp.group.execution\tKjøring\nhelp.group.general\tGenerelt\nhelp.group.testing\tTester\nhelp.group.tools\tUtviklingsverktøy\nhelp.more\tKjør 'mio help <kommando>' for detaljer om en kommando.\nhelp.options\tAlternativer\nhelp.tagline\tNative AOT-kompilator og verktøykjede for språket Mio\nhelp.title\tMio {0}\nhelp.usage\tBruk\nopt.bunko\tBruk denne Bunko-roten i stedet for standarden\nopt.color\tStyr fargeutdata: auto, always eller never\nopt.emit\tSkriv Mochi-bytekode i stedet for et native bilde\nopt.format\tVelg utdataformat: human, short eller json\nopt.gc_stress\tBygg med aggressive stresstester for søppelsamleren");
    string.write_string(output, "\nopt.help\tVis hjelp\nopt.lang\tVelg utdataspråk med en BCP 47-tagg, for eksempel ja-JP\nopt.observe\tRegistrer observasjoner fra den native byggingen\nopt.output\tSkriv utdata til denne banen\nopt.program_args\tSend de resterende argumentene til programmet\nopt.run_filter\tKjør bare tester der navnet samsvarer med dette regulære uttrykket\nopt.stdio\tBruk standard inn- og utdata for språkserveren\nopt.symbols\tSkriv native symbolinformasjon til denne filen\nopt.target\tBygg for darwin-arm64, linux-amd64 eller windows-amd64\nopt.theme\tVelg en semantisk fargepalett: auto, dark eller light\nopt.verbose\tTa med flere diagnostiske detaljer\nopt.version\tVis versjonsinformasjon\ntest.assertion\tpåstanden mislyktes\ntest.bunko_empty\tBunko-overstyringens bane kan ikke være tom\ntest.bunko_missing\tverdien mangler for --bunko-root\ntest.compile_failed\tkompileringen mislyktes\ntest.duration\ttotal varighet\ntest.empty_filter\ttestfilteret kan ikke være tomt\ntest.empty_lang\tspråktaggen kan ikke være tom\ntest.fail\tMISLYKTES");
    string.write_string(output, "\ntest.filter_invalid\tugyldig testfilter: {0}\ntest.invalid_arg\tugyldig testargument: {0}\ntest.invalid_signature\tugyldig signatur for testfunksjon\ntest.io_clean_dir\tkan ikke rydde den private testkatalogen\ntest.io_clean_image\tkan ikke rydde det native testbildet\ntest.io_dir\tkan ikke opprette en privat testkatalog\ntest.io_protect\tkan ikke beskytte den private testkatalogen\ntest.missing_target\ttestmålet mangler\ntest.no_match\tingen tester samsvarer med --run={0}\ntest.none\tingen tester funnet\ntest.pass\tBESTÅTT\ntest.resource\tressursgrensen er overskredet\ntest.runtime\tkjøretidsfeil\ntest.skip\tHOPPET OVER\ntest.skipped\tOverhoppede tester: {0}\ntest.starting\tStarter tester {0}\ntest.summary\tTester fullført: {0} bestått, {1} mislyktes");
    kaesu string.builder_string(output);
}

waza text_nl_nl() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tcontrole geslaagd\ncli.lsp_unknown\tonbekend lsp-argument: {0}\ncmd.build\tBouw een native uitvoerbaar bestand of Mochi-bytecode uit Mio-broncode\ncmd.check\tAnalyseer Mio-broncode zonder uitvoer te produceren\ncmd.disasm\tDisassembleer een gecompileerd Mochi-programma\ncmd.exec\tVoer een gecompileerd Mochi-programma uit\ncmd.help\tToon hulp voor Mio of voor één opdracht\ncmd.lsp\tStart de Mio-taal server via standaard in- en uitvoer\ncmd.run\tBouw en voer een Mio-programma uit vanuit de broncode\ncmd.test\tVind en voer Mio-testpakketten uit\ncmd.version\tToon versie-informatie\ndiag.cause\toorzaak\nerr.analysis\tbronanalyse is mislukt\nerr.bunko_empty\thet vervangende Bunko-pad moet expliciet en niet leeg zijn\nerr.chmod_native\tkan de native uitvoer niet uitvoerbaar maken\nerr.cleanup\topruimen na uitvoering is mislukt\nerr.create_run_dir\tkan geen persoonlijke uitvoermap aanmaken\nerr.emit_mochi\tdeze opdracht kan geen Mochi-bytecode uitgeven\nerr.empty_paths\thet bron- en uitvoerpad mogen niet leeg zijn\nerr.gc_stress\t--gc-stress geldt alleen voor native builds uit broncode");
    string.write_string(output, "\nerr.help_args\thelp accepteert hoogstens één opdrachtnaam\nerr.help_unknown\tgeen hulp voor onbekende opdracht: {0}\nerr.host_target\trun en exec vereisen het hostdoel {0}\nerr.invalid_color\tongeldige kleurmodus: {0} (verwacht auto, always of never)\nerr.invalid_format\tongeldig formaat: {0} (verwacht human, short of json)\nerr.invalid_theme\tongeldig thema: {0} (verwacht auto, dark of light)\nerr.missing_value\twaarde ontbreekt voor optie {0}\nerr.multiple_entries\ter kan slechts één broningang worden opgegeven\nerr.observe\t--observe geldt alleen voor native darwin-arm64-builds uit broncode\nerr.program_args\tprogramma-argumenten vereisen run of exec\nerr.protect_run_dir\tkan de persoonlijke uitvoermap niet beveiligen\nerr.read_mochi\tkan de Mochi-invoer niet lezen\nerr.run_output\trun en exec beheren hun eigen native uitvoer\nerr.spawn\thet native programma kon niet worden gestart\nerr.symbols\t--emit-symbols geldt alleen voor native darwin-arm64-builds uit broncode\nerr.target\tniet-ondersteund doel: {0} (verwacht darwin-arm64, linux-amd64 of windows-amd64)\nerr.unknown_command\tonbekende opdracht: {0}\nerr.unknown_option\tonbekende optie: {0}\nerr.version_args\tde opdracht version accepteert geen argumenten\nerr.write_disasm\tkan de disassemblage niet schrijven");
    string.write_string(output, "\nerr.write_mochi\tkan de Mochi-uitvoer niet schrijven\nerr.write_native\tkan de native uitvoer niet schrijven\nhelp.commands\tOpdrachten\nhelp.examples\tVoorbeelden\nhelp.group.compilation\tCompilatie\nhelp.group.diagnostics\tDiagnostiek\nhelp.group.execution\tUitvoering\nhelp.group.general\tAlgemeen\nhelp.group.testing\tTests\nhelp.group.tools\tOntwikkelhulpmiddelen\nhelp.more\tVoer 'mio help <opdracht>' uit voor details over een opdracht.\nhelp.options\tOpties\nhelp.tagline\tNative AOT-compiler en hulpmiddelen voor de taal Mio\nhelp.title\tMio {0}\nhelp.usage\tGebruik\nopt.bunko\tGebruik deze Bunko-hoofdmap in plaats van de standaard\nopt.color\tBeheer kleuruitvoer: auto, always of never\nopt.emit\tGeef Mochi-bytecode uit in plaats van een native image\nopt.format\tKies het uitvoerformaat: human, short of json\nopt.gc_stress\tBouw met agressieve stresstests voor de garbage collector");
    string.write_string(output, "\nopt.help\tToon hulp\nopt.lang\tKies de uitvoertaal met een BCP 47-tag, bijvoorbeeld ja-JP\nopt.observe\tLeg waarnemingen van de native build vast\nopt.output\tSchrijf uitvoer naar dit pad\nopt.program_args\tGeef de resterende argumenten door aan het programma\nopt.run_filter\tVoer alleen tests uit waarvan de naam aan deze reguliere expressie voldoet\nopt.stdio\tGebruik standaard in- en uitvoer voor de taal server\nopt.symbols\tSchrijf native symboolinformatie naar dit bestand\nopt.target\tBouw voor darwin-arm64, linux-amd64 of windows-amd64\nopt.theme\tKies het semantische kleurenpalet: auto, dark of light\nopt.verbose\tToon extra diagnostische details\nopt.version\tToon versie-informatie\ntest.assertion\tassertie mislukt\ntest.bunko_empty\thet vervangende Bunko-pad mag niet leeg zijn\ntest.bunko_missing\twaarde ontbreekt voor --bunko-root\ntest.compile_failed\tcompilatie mislukt\ntest.duration\ttotale duur\ntest.empty_filter\thet testfilter mag niet leeg zijn\ntest.empty_lang\tde taaltag mag niet leeg zijn\ntest.fail\tMISLUKT");
    string.write_string(output, "\ntest.filter_invalid\tongeldig testfilter: {0}\ntest.invalid_arg\tongeldig testargument: {0}\ntest.invalid_signature\tongeldige signatuur van testfunctie\ntest.io_clean_dir\tkan de persoonlijke testmap niet opruimen\ntest.io_clean_image\tkan het native testimage niet opruimen\ntest.io_dir\tkan geen persoonlijke testmap aanmaken\ntest.io_protect\tkan de persoonlijke testmap niet beveiligen\ntest.missing_target\ttestdoel ontbreekt\ntest.no_match\tgeen tests komen overeen met --run={0}\ntest.none\tgeen tests gevonden\ntest.pass\tGESLAAGD\ntest.resource\tresourcelimiet overschreden\ntest.runtime\tuitvoeringsfout\ntest.skip\tOVERGESLAGEN\ntest.skipped\tOvergeslagen tests: {0}\ntest.starting\tTests starten {0}\ntest.summary\tTests voltooid: {0} geslaagd, {1} mislukt");
    kaesu string.builder_string(output);
}

waza text_pl_pl() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tsprawdzenie zakończone pomyślnie\ncli.lsp_unknown\tnieznany argument lsp: {0}\ncmd.build\tZbuduj natywny plik wykonywalny lub bajtkod Mochi ze źródeł Mio\ncmd.check\tAnalizuj źródła Mio bez tworzenia danych wyjściowych\ncmd.disasm\tZdeasembluj skompilowany program Mochi\ncmd.exec\tUruchom skompilowany program Mochi\ncmd.help\tPokaż pomoc dla Mio lub jednego polecenia\ncmd.lsp\tUruchom serwer języka Mio przez standardowe wejście i wyjście\ncmd.run\tZbuduj i uruchom program Mio ze źródeł\ncmd.test\tZnajdź i uruchom pakiety testów Mio\ncmd.version\tPokaż informacje o wersji\ndiag.cause\tprzyczyna\nerr.analysis\tanaliza źródeł nie powiodła się\nerr.bunko_empty\tzastępcza ścieżka Bunko musi być jawna i niepusta\nerr.chmod_native\tnie można uczynić wyjścia natywnego wykonywalnym\nerr.cleanup\tsprzątanie po uruchomieniu nie powiodło się\nerr.create_run_dir\tnie można utworzyć prywatnego katalogu uruchomienia\nerr.emit_mochi\tto polecenie nie może generować bajtkodu Mochi\nerr.empty_paths\tścieżki źródła i wyjścia nie mogą być puste\nerr.gc_stress\t--gc-stress dotyczy tylko natywnych kompilacji ze źródeł");
    string.write_string(output, "\nerr.help_args\thelp przyjmuje co najwyżej jedną nazwę polecenia\nerr.help_unknown\tbrak pomocy dla nieznanego polecenia: {0}\nerr.host_target\trun i exec wymagają celu hosta {0}\nerr.invalid_color\tnieprawidłowy tryb kolorów: {0} (oczekiwano auto, always lub never)\nerr.invalid_format\tnieprawidłowy format: {0} (oczekiwano human, short lub json)\nerr.invalid_theme\tnieprawidłowy motyw: {0} (oczekiwano auto, dark lub light)\nerr.missing_value\tbrak wartości opcji {0}\nerr.multiple_entries\tmożna podać tylko jeden wpis źródłowy\nerr.observe\t--observe dotyczy tylko natywnych kompilacji darwin-arm64 ze źródeł\nerr.program_args\targumenty programu wymagają run lub exec\nerr.protect_run_dir\tnie można zabezpieczyć prywatnego katalogu uruchomienia\nerr.read_mochi\tnie można odczytać wejścia Mochi\nerr.run_output\trun i exec samodzielnie zarządzają wyjściem natywnym\nerr.spawn\tnie można uruchomić programu natywnego\nerr.symbols\t--emit-symbols dotyczy tylko natywnych kompilacji darwin-arm64 ze źródeł\nerr.target\tnieobsługiwany cel: {0} (oczekiwano darwin-arm64, linux-amd64 lub windows-amd64)\nerr.unknown_command\tnieznane polecenie: {0}\nerr.unknown_option\tnieznana opcja: {0}\nerr.version_args\tpolecenie version nie przyjmuje argumentów\nerr.write_disasm\tnie można zapisać deasemblacji");
    string.write_string(output, "\nerr.write_mochi\tnie można zapisać wyjścia Mochi\nerr.write_native\tnie można zapisać wyjścia natywnego\nhelp.commands\tPolecenia\nhelp.examples\tPrzykłady\nhelp.group.compilation\tKompilacja\nhelp.group.diagnostics\tDiagnostyka\nhelp.group.execution\tWykonanie\nhelp.group.general\tOgólne\nhelp.group.testing\tTesty\nhelp.group.tools\tNarzędzia programistyczne\nhelp.more\tUruchom 'mio help <polecenie>', aby zobaczyć szczegóły polecenia.\nhelp.options\tOpcje\nhelp.tagline\tKompilator Native AOT i narzędzia dla języka Mio\nhelp.title\tMio {0}\nhelp.usage\tUżycie\nopt.bunko\tUżyj tego katalogu głównego Bunko zamiast domyślnego\nopt.color\tSteruj kolorowym wyjściem: auto, always lub never\nopt.emit\tWygeneruj bajtkod Mochi zamiast obrazu natywnego\nopt.format\tWybierz format wyjścia: human, short lub json\nopt.gc_stress\tZbuduj z agresywnymi testami obciążenia odśmiecacza pamięci");
    string.write_string(output, "\nopt.help\tPokaż pomoc\nopt.lang\tWybierz język wyjściowy według znacznika BCP 47, na przykład ja-JP\nopt.observe\tZapisuj obserwacje kompilacji natywnej\nopt.output\tZapisz wyjście w tej ścieżce\nopt.program_args\tPrzekaż pozostałe argumenty do programu\nopt.run_filter\tUruchamiaj tylko testy, których nazwy pasują do tego wyrażenia regularnego\nopt.stdio\tUżywaj standardowego wejścia i wyjścia dla serwera języka\nopt.symbols\tZapisz informacje o symbolach natywnych w tym pliku\nopt.target\tZbuduj dla darwin-arm64, linux-amd64 lub windows-amd64\nopt.theme\tWybierz paletę semantyczną: auto, dark lub light\nopt.verbose\tDołącz dodatkowe szczegóły diagnostyczne\nopt.version\tPokaż informacje o wersji\ntest.assertion\tniepowodzenie asercji\ntest.bunko_empty\tzastępcza ścieżka Bunko nie może być pusta\ntest.bunko_missing\tbrak wartości --bunko-root\ntest.compile_failed\tkompilacja nie powiodła się\ntest.duration\tłączny czas\ntest.empty_filter\tfiltr testów nie może być pusty\ntest.empty_lang\tznacznik języka nie może być pusty\ntest.fail\tNIEZALICZONY");
    string.write_string(output, "\ntest.filter_invalid\tnieprawidłowy filtr testów: {0}\ntest.invalid_arg\tnieprawidłowy argument testu: {0}\ntest.invalid_signature\tnieprawidłowa sygnatura funkcji testowej\ntest.io_clean_dir\tnie można usunąć prywatnego katalogu testów\ntest.io_clean_image\tnie można usunąć natywnego obrazu testowego\ntest.io_dir\tnie można utworzyć prywatnego katalogu testów\ntest.io_protect\tnie można zabezpieczyć prywatnego katalogu testów\ntest.missing_target\tbrak celu testów\ntest.no_match\tżaden test nie pasuje do --run={0}\ntest.none\tnie znaleziono testów\ntest.pass\tZALICZONY\ntest.resource\tprzekroczono limit zasobów\ntest.runtime\tbłąd wykonania\ntest.skip\tPOMINIĘTY\ntest.skipped\tPominięte testy: {0}\ntest.starting\tRozpoczynanie testów {0}\ntest.summary\tTesty zakończone: {0} zaliczonych, {1} niezaliczonych");
    kaesu string.builder_string(output);
}

waza text_pt_br() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tverificação aprovada\ncli.lsp_unknown\targumento lsp desconhecido: {0}\ncmd.build\tCriar um executável nativo ou bytecode Mochi a partir de fontes Mio\ncmd.check\tAnalisar fontes Mio sem produzir saída\ncmd.disasm\tDesmontar um programa Mochi compilado\ncmd.exec\tExecutar um programa Mochi compilado\ncmd.help\tMostrar a ajuda do Mio ou de um comando\ncmd.lsp\tIniciar o servidor de linguagem Mio na entrada/saída padrão\ncmd.run\tCriar e executar um programa Mio a partir de fontes\ncmd.test\tDescobrir e executar pacotes de teste Mio\ncmd.version\tMostrar as informações de versão\ndiag.cause\tcausa\nerr.analysis\ta análise do código-fonte falhou\nerr.bunko_empty\to caminho substituto do Bunko deve ser explícito e não vazio\nerr.chmod_native\tnão foi possível tornar a saída nativa executável\nerr.cleanup\ta limpeza após a execução falhou\nerr.create_run_dir\tnão foi possível criar um diretório de execução privado\nerr.emit_mochi\teste comando não pode emitir bytecode Mochi\nerr.empty_paths\tos caminhos de origem e saída não podem ser vazios\nerr.gc_stress\t--gc-stress aplica-se apenas a compilações nativas a partir de fontes");
