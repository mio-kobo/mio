koukai waza alias(language: string) -> string {
    moshi (language == "no") { kaesu "nb"; }
    moshi (language == "iw") { kaesu "he"; }
    moshi (language == "in") { kaesu "id"; }
    moshi (language == "tl") { kaesu "fil"; }
    moshi (language == "mo") { kaesu "ro"; }
    kaesu language;
}

koukai waza regional(tag: string) -> string {
    moshi (tag == "zh-MO") { kaesu "zh-HK"; }
    moshi (tag == "zh-SG") { kaesu "zh-CN"; }
    moshi (tag == "zh-MY") { kaesu "zh-CN"; }
    kaesu tag;
}

koukai waza script_default(tag: string) -> string {
    moshi (tag == "zh-Hans") { kaesu "zh-CN"; }
    moshi (tag == "zh-Hant") { kaesu "zh-TW"; }
    kaesu "";
}

waza table_slice(data: []uint8, first: int64, end: int64) -> string {
    kaku bytes: []uint8 = []; kaku at = first;
    aida (at < end) { array.push(bytes, data[at]); at = at + 1; }
    kaku value = string.from_utf8(bytes); moshi (value == mu) { kaesu ""; } kaesu value;
}

waza table_lookup(table: string, key: string) -> string {
    kaku needle = string.concat("\n", string.concat(key, "\t"));
    kaku position = string.index(table, needle);
    moshi (position < 0) { kaesu ""; }
    kaku data = string.to_bytes(table);
    kaku start = position + len(string.to_bytes(needle)); kaku end = start;
    aida (end < len(data) && data[end] != uint8(10)) { end = end + 1; }
    kaesu table_slice(data, start, end);
}

waza text_ar_sa() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tتعذّر تحميل الاعتماد: {0}\nbunko.missing\tBunko غير مثبّت. استخدم --bunko-root أو MIO_BUNKO لاستيراد {0}\nbunko.package_read\tتعذّرت قراءة الحزمة: {0}\nbunko.root_layout\tيجب أن يحتوي مجلد Bunko على kiso/: {0}\nbunko.root_resolve\tتعذّر تحديد المسار الفعلي للمجلد: {0}\ncheck.passed\tتم اجتياز الفحص\ncli.lsp_unknown\tوسيط lsp غير معروف: {0}\ncmd.build\tبناء ملف تنفيذي أصلي أو بايت كود Mochi من مصادر Mio\ncmd.check\tتحليل مصادر Mio دون إنتاج مخرجات\ncmd.disasm\tتفكيك برنامج Mochi المُترجم\ncmd.exec\tتشغيل برنامج Mochi مُترجم\ncmd.fmt\tنسّق ملفات مصدر Mio.\ncmd.help\tعرض المساعدة لـ Mio أو لأمر واحد\ncmd.lint\tافحص مصدر Mio بحثًا عن مشكلات شائعة.\ncmd.lsp\tبدء خادم لغة Mio عبر الإدخال والإخراج القياسيين\ncmd.run\tبناء برنامج Mio من المصادر وتشغيله\ncmd.test\tاكتشاف حزم اختبار Mio وتشغيلها\ncmd.version\tعرض معلومات الإصدار\ndiag.cause\tالسبب\ndiag.error\tخطأ");
    string.write_string(output, "\ndiag.expected_actual\tالمتوقع {0}، الفعلي {1}\ndiag.lexical\tنص مصدر غير معروف\ndiag.note\tملاحظة\ndiag.suggestion\tاقتراح\ndiag.warning\tتحذير\nerr.analysis\tفشل تحليل المصادر\nerr.bunko_empty\tيجب أن يكون مسار Bunko البديل صريحًا وغير فارغ\nerr.chmod_native\tتعذّر جعل المخرجات الأصلية قابلة للتنفيذ\nerr.cleanup\tفشل تنظيف ما بعد التشغيل\nerr.create_run_dir\tتعذّر إنشاء مجلد تشغيل خاص\nerr.emit_mochi\tلا يمكن لهذا الأمر إنتاج بايت كود Mochi\nerr.empty_paths\tلا يمكن أن يكون مسارا المصدر والإخراج فارغين\nerr.gc_stress\tينطبق --gc-stress على عمليات البناء الأصلية من المصادر فقط\nerr.help_args\tيقبل help اسم أمر واحدًا على الأكثر\nerr.help_unknown\tلا توجد مساعدة للأمر غير المعروف: {0}\nerr.host_target\tيتطلب run وexec هدف المضيف {0}\nerr.invalid_color\tوضع ألوان غير صالح: {0} (المتوقع auto أو always أو never)\nerr.invalid_format\tصيغة غير صالحة: {0} (المتوقع human أو short أو json)\nerr.invalid_theme\tسمة غير صالحة: {0} (المتوقع auto أو dark أو light)\nerr.missing_value\tقيمة مفقودة للخيار {0}");
    string.write_string(output, "\nerr.multiple_entries\tيمكن تقديم مصدر واحد فقط\nerr.observe\tينطبق --observe على عمليات بناء darwin-arm64 الأصلية من المصادر فقط\nerr.open_stream\tتعذّر فتح {0}\nerr.program_args\tتتطلب وسائط البرنامج الأمر run أو exec\nerr.protect_run_dir\tتعذّر حماية مجلد التشغيل الخاص\nerr.read_mochi\tتعذّرت قراءة إدخال Mochi\nerr.run_output\tيتولى run وexec إدارة مخرجاتهما الأصلية\nerr.spawn\tتعذّر بدء البرنامج الأصلي\nerr.symbols\tينطبق --emit-symbols على عمليات بناء darwin-arm64 الأصلية من المصادر فقط\nerr.target\tهدف غير مدعوم: {0} (المتوقع darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tأمر غير معروف: {0}\nerr.unknown_option\tخيار غير معروف: {0}\nerr.version_args\tلا يقبل الأمر version أي وسائط\nerr.write_disasm\tتعذّرت كتابة التفكيك\nerr.write_help\tتعذّرت كتابة المساعدة\nerr.write_mochi\tتعذّرت كتابة إخراج Mochi\nerr.write_native\tتعذّرت كتابة المخرجات الأصلية\nfmt.behavior\tيُبحث في المجلدات ومجلداتها الفرعية. استخدم --stdin للقراءة من الإدخال القياسي و--check للإبلاغ عن التغييرات دون كتابة.\nfmt.status\tحالة الخروج: 0 نجاح، 1 يلزم التنسيق في وضع --check، 2 خطأ في الاستخدام أو التحليل أو الإدخال والإخراج.\nhelp.commands\tالأوامر");
    string.write_string(output, "\nhelp.examples\tأمثلة\nhelp.group.compilation\tالترجمة\nhelp.group.diagnostics\tالتشخيص\nhelp.group.execution\tالتنفيذ\nhelp.group.general\tعام\nhelp.group.testing\tالاختبارات\nhelp.group.tools\tأدوات التطوير\nhelp.more\tنفّذ 'mio help <الأمر>' لعرض تفاصيل الأمر.\nhelp.options\tالخيارات\nhelp.tagline\tمترجم Native AOT وسلسلة أدوات للغة Mio\nhelp.title\tMio {0}\nhelp.usage\tالاستخدام\nlint.behavior\tاستخدم --list-rules لعرض القواعد و--deny-warnings لاعتبار التحذيرات سببًا للفشل. يجب أن يجتاز المصدر فحوص الترجمة أولًا.\nlint.constant_condition\tشرط صحيح دائمًا أو خاطئ دائمًا\nlint.finding_if\tشرط moshi يساوي {0} دائمًا\nlint.finding_import\tالاستيراد {0} (الحزمة {1}) غير مستخدم\nlint.finding_loop\tشرط aida يساوي iie دائمًا، لذا لا يُنفّذ جسم الحلقة\nlint.finding_unreachable\tتعليمة لا يمكن بلوغها بعد {0}\nlint.finding_variable\tالمتغير {0} مصرّح به لكنه غير مستخدم\nlint.status\tحالة الخروج: 0 نجاح، 1 تحذيرات مع --deny-warnings، 2 خطأ في الاستخدام أو الترجمة.");
    string.write_string(output, "\nlint.unreachable_code\tتعليمة بعد نقل غير مشروط للتحكم\nlint.unused_import\tاستيراد حزمة غير مستخدمة\nlint.unused_variable\tمتغير محلي غير مستخدم (باستثناء الأسماء التي تبدأ بـ _)\nopt.bunko\tاستخدام جذر Bunko هذا بدلًا من الجذر الافتراضي\nopt.color\tالتحكم في إخراج الألوان: auto أو always أو never\nopt.emit\tإنتاج بايت كود Mochi بدلًا من صورة أصلية\nopt.format\tاختيار صيغة الإخراج: human أو short أو json\nopt.gc_stress\tالبناء مع فحوص ضغط مكثفة جامع القمامة\nopt.help\tعرض المساعدة\nopt.lang\tاختيار لغة الإخراج بوسم BCP 47، مثل ja-JP\nopt.observe\tتسجيل ملاحظات البناء الأصلي\nopt.output\tكتابة الإخراج إلى هذا المسار\nopt.program_args\tتمرير الوسائط المتبقية إلى البرنامج\nopt.run_filter\tتشغيل الاختبارات التي تطابق أسماؤها هذا التعبير النمطي فقط\nopt.stdio\tاستخدام الإدخال والإخراج القياسيين لخادم اللغة\nopt.symbols\tكتابة معلومات الرموز الأصلية في هذا الملف\nopt.target\tالبناء لـ darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tاختيار لوحة الألوان الدلالية: auto أو dark أو light\nopt.verbose\tتضمين تفاصيل تشخيص إضافية\nopt.version\tعرض معلومات الإصدار");
    string.write_string(output, "\ntest.assertion\tفشل التحقق\ntest.bunko_empty\tلا يمكن أن يكون مسار Bunko البديل فارغًا\ntest.bunko_missing\tقيمة مفقودة لـ --bunko-root\ntest.compile_failed\tفشلت الترجمة\ntest.duration\tالمدة الإجمالية\ntest.empty_filter\tلا يمكن أن يكون مرشح الاختبار فارغًا\ntest.empty_lang\tلا يمكن أن يكون وسم اللغة فارغًا\ntest.fail\tفاشل\ntest.filter_invalid\tمرشح اختبار غير صالح: {0}\ntest.invalid_arg\tوسيط اختبار غير صالح: {0}\ntest.invalid_signature\tتوقيع دالة الاختبار غير صالح\ntest.io_clean_dir\tتعذّر تنظيف مجلد الاختبار الخاص\ntest.io_clean_image\tتعذّر تنظيف صورة الاختبار الأصلية\ntest.io_dir\tتعذّر إنشاء مجلد اختبار خاص\ntest.io_protect\tتعذّر حماية مجلد الاختبار الخاص\ntest.missing_target\tهدف الاختبار مفقود\ntest.no_match\tلا توجد اختبارات تطابق --run={0}\ntest.none\tلم يتم العثور على اختبارات\ntest.pass\tناجح\ntest.resource\tتم تجاوز حد الموارد");
    string.write_string(output, "\ntest.runtime\tخطأ في وقت التنفيذ\ntest.skip\tمتجاوز\ntest.skipped\tالاختبارات المتجاوزة: {0}\ntest.starting\tبدء الاختبارات {0}\ntest.summary\tاكتملت الاختبارات: {0} ناجح، {1} فاشل");
    kaesu string.builder_string(output);
}

waza text_bn_bd() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tনির্ভরতা লোড করা যায়নি: {0}\nbunko.missing\tBunko ইনস্টল করা নেই। {0} ইমপোর্ট করতে --bunko-root বা MIO_BUNKO ব্যবহার করুন।\nbunko.package_read\tপ্যাকেজ পড়া যায়নি: {0}\nbunko.root_layout\tBunko ডিরেক্টরিতে kiso/ থাকতে হবে: {0}\nbunko.root_resolve\tডিরেক্টরির প্রকৃত পথ নির্ধারণ করা যায়নি: {0}\ncheck.passed\tযাচাই উত্তীর্ণ\ncli.lsp_unknown\tঅজানা lsp আর্গুমেন্ট: {0}\ncmd.build\tMio সোর্স থেকে নেটিভ এক্সিকিউটেবল বা Mochi বাইটকোড তৈরি করুন\ncmd.check\tআউটপুট না বানিয়ে Mio সোর্স বিশ্লেষণ করুন\ncmd.disasm\tকম্পাইল করা Mochi প্রোগ্রাম ডিসঅ্যাসেম্বল করুন\ncmd.exec\tকম্পাইল করা Mochi প্রোগ্রাম চালান\ncmd.fmt\tMio সোর্স ফাইলের বিন্যাস ঠিক করুন।\ncmd.help\tMio বা একটি কমান্ডের সাহায্য দেখান\ncmd.lint\tMio সোর্সে সাধারণ সমস্যা খুঁজুন।\ncmd.lsp\tস্ট্যান্ডার্ড ইনপুট/আউটপুটে Mio ভাষা সার্ভার শুরু করুন\ncmd.run\tসোর্স থেকে Mio প্রোগ্রাম তৈরি ও চালান\ncmd.test\tMio পরীক্ষা প্যাকেজ খুঁজে চালান\ncmd.version\tসংস্করণ তথ্য দেখান\ndiag.cause\tকারণ\ndiag.error\tত্রুটি");
    string.write_string(output, "\ndiag.expected_actual\tপ্রত্যাশিত {0}, প্রাপ্ত {1}\ndiag.lexical\tসোর্স টেক্সট চেনা যায়নি\ndiag.note\tটীকা\ndiag.suggestion\tপরামর্শ\ndiag.warning\tসতর্কতা\nerr.analysis\tসোর্স বিশ্লেষণ ব্যর্থ হয়েছে\nerr.bunko_empty\tBunko ওভাররাইড পথ স্পষ্ট ও অখালি হতে হবে\nerr.chmod_native\tনেটিভ আউটপুট চালানোর যোগ্য করা যায়নি\nerr.cleanup\tচালানোর পরে পরিষ্কার করা যায়নি\nerr.create_run_dir\tব্যক্তিগত রান ডিরেক্টরি তৈরি করা যায়নি\nerr.emit_mochi\tএই কমান্ড Mochi বাইটকোড তৈরি করতে পারে না\nerr.empty_paths\tসোর্স ও আউটপুট পথ খালি হতে পারে না\nerr.gc_stress\t--gc-stress শুধু সোর্স থেকে নেটিভ বিল্ডে প্রযোজ্য\nerr.help_args\thelp সর্বাধিক একটি কমান্ড নাম নেয়\nerr.help_unknown\tঅজানা কমান্ডের জন্য সাহায্য নেই: {0}\nerr.host_target\trun ও exec-এর জন্য হোস্ট লক্ষ্য {0} দরকার\nerr.invalid_color\tঅবৈধ রঙ মোড: {0} (auto, always বা never প্রত্যাশিত)\nerr.invalid_format\tঅবৈধ ফরম্যাট: {0} (human, short বা json প্রত্যাশিত)\nerr.invalid_theme\tঅবৈধ থিম: {0} (auto, dark বা light প্রত্যাশিত)\nerr.missing_value\tবিকল্প {0}-এর মান নেই");
    string.write_string(output, "\nerr.multiple_entries\tশুধু একটি সোর্স এন্ট্রি দেওয়া যায়\nerr.observe\t--observe শুধু সোর্স থেকে darwin-arm64 নেটিভ বিল্ডে প্রযোজ্য\nerr.open_stream\t{0} খোলা যায়নি\nerr.program_args\tপ্রোগ্রাম আর্গুমেন্টের জন্য run বা exec দরকার\nerr.protect_run_dir\tব্যক্তিগত রান ডিরেক্টরি সুরক্ষিত করা যায়নি\nerr.read_mochi\tMochi ইনপুট পড়া যায়নি\nerr.run_output\trun ও exec নিজেদের নেটিভ আউটপুট পরিচালনা করে\nerr.spawn\tনেটিভ প্রোগ্রাম চালু করা যায়নি\nerr.symbols\t--emit-symbols শুধু সোর্স থেকে darwin-arm64 নেটিভ বিল্ডে প্রযোজ্য\nerr.target\tঅসমর্থিত লক্ষ্য: {0} (darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64 প্রত্যাশিত)\nerr.unknown_command\tঅজানা কমান্ড: {0}\nerr.unknown_option\tঅজানা বিকল্প: {0}\nerr.version_args\tversion কমান্ড কোনো আর্গুমেন্ট নেয় না\nerr.write_disasm\tডিসঅ্যাসেম্বলি লেখা যায়নি\nerr.write_help\tসহায়িকা লেখা যায়নি\nerr.write_mochi\tMochi আউটপুট লেখা যায়নি\nerr.write_native\tনেটিভ আউটপুট লেখা যায়নি\nfmt.behavior\tডিরেক্টরি ও তার উপডিরেক্টরিতে খোঁজা হয়। স্ট্যান্ডার্ড ইনপুট পড়তে --stdin এবং না লিখে পরিবর্তন জানাতে --check ব্যবহার করুন।\nfmt.status\tপ্রস্থান স্থিতি: ০ সফল, ১ --check মোডে পরিবর্তন প্রয়োজন, ২ ব্যবহার, পার্সিং বা ইনপুট/আউটপুট ত্রুটি।\nhelp.commands\tকমান্ড");
    string.write_string(output, "\nhelp.examples\tউদাহরণ\nhelp.group.compilation\tকম্পাইলেশন\nhelp.group.diagnostics\tনির্ণয়\nhelp.group.execution\tনির্বাহ\nhelp.group.general\tসাধারণ\nhelp.group.testing\tপরীক্ষা\nhelp.group.tools\tউন্নয়ন সরঞ্জাম\nhelp.more\tকোনো কমান্ডের বিস্তারিত দেখতে 'mio help <কমান্ড>' চালান।\nhelp.options\tবিকল্প\nhelp.tagline\tMio ভাষার জন্য Native AOT কম্পাইলার ও টুলচেইন\nhelp.title\tMio {0}\nhelp.usage\tব্যবহার\nlint.behavior\tনিয়ম দেখতে --list-rules এবং সতর্কতা থাকলে ব্যর্থ করতে --deny-warnings ব্যবহার করুন। সোর্সকে আগে কম্পাইলেশন পরীক্ষায় উত্তীর্ণ হতে হবে।\nlint.constant_condition\tসব সময় সত্য বা মিথ্যা এমন শর্ত\nlint.finding_if\tmoshi শর্তের মান সব সময় {0}\nlint.finding_import\tইমপোর্ট {0} (প্যাকেজ {1}) কখনও ব্যবহৃত হয় না\nlint.finding_loop\taida শর্তের মান সব সময় iie, তাই লুপের বডি কখনও চলে না\nlint.finding_unreachable\t{0}-এর পরের কোডে পৌঁছানো যায় না\nlint.finding_variable\tচলক {0} ঘোষণা করা হয়েছে, কিন্তু ব্যবহৃত হয়নি\nlint.status\tপ্রস্থান স্থিতি: ০ সফল, ১ --deny-warnings সহ সতর্কতা, ২ ব্যবহার বা কম্পাইলার ত্রুটি।");
    string.write_string(output, "\nlint.unreachable_code\tশর্তহীন নিয়ন্ত্রণ স্থানান্তরের পরের বিবৃতি\nlint.unused_import\tঅব্যবহৃত প্যাকেজ ইমপোর্ট\nlint.unused_variable\tঅব্যবহৃত স্থানীয় চলক (_ দিয়ে শুরু নাম বাদে)\nopt.bunko\tডিফল্টের বদলে এই Bunko রুট ব্যবহার করুন\nopt.color\tরঙিন আউটপুট নিয়ন্ত্রণ করুন: auto, always বা never\nopt.emit\tনেটিভ ইমেজের বদলে Mochi বাইটকোড তৈরি করুন\nopt.format\tআউটপুট ফরম্যাট বাছুন: human, short বা json\nopt.gc_stress\tতীব্র আবর্জনা সংগ্রাহক চাপ পরীক্ষাসহ তৈরি করুন\nopt.help\tসাহায্য দেখান\nopt.lang\tBCP 47 ট্যাগ দিয়ে আউটপুট ভাষা বাছুন, যেমন ja-JP\nopt.observe\tনেটিভ বিল্ডের পর্যবেক্ষণ রেকর্ড করুন\nopt.output\tআউটপুট এই পথে লিখুন\nopt.program_args\tবাকি আর্গুমেন্ট প্রোগ্রামে পাঠান\nopt.run_filter\tশুধু সেই পরীক্ষা চালান যাদের নাম এই রেগুলার এক্সপ্রেশনের সাথে মেলে\nopt.stdio\tভাষা সার্ভারের জন্য স্ট্যান্ডার্ড ইনপুট ও আউটপুট ব্যবহার করুন\nopt.symbols\tনেটিভ চিহ্নের তথ্য এই ফাইলে লিখুন\nopt.target\tdarwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64-এর জন্য তৈরি করুন\nopt.theme\tঅর্থবহ রঙের প্যালেট বাছুন: auto, dark বা light\nopt.verbose\tঅতিরিক্ত নির্ণয় বিবরণ দেখান\nopt.version\tসংস্করণ তথ্য দেখান");
    string.write_string(output, "\ntest.assertion\tজোরালো দাবি ব্যর্থ\ntest.bunko_empty\tBunko ওভাররাইড পথ খালি হতে পারে না\ntest.bunko_missing\t--bunko-root এর মান নেই\ntest.compile_failed\tকম্পাইলেশন ব্যর্থ\ntest.duration\tমোট সময়\ntest.empty_filter\tপরীক্ষা ফিল্টার খালি হতে পারে না\ntest.empty_lang\tভাষা ট্যাগ খালি হতে পারে না\ntest.fail\tব্যর্থ\ntest.filter_invalid\tঅবৈধ পরীক্ষা ফিল্টার: {0}\ntest.invalid_arg\tঅবৈধ পরীক্ষা আর্গুমেন্ট: {0}\ntest.invalid_signature\tপরীক্ষা ফাংশনের স্বাক্ষর অবৈধ\ntest.io_clean_dir\tব্যক্তিগত পরীক্ষা ডিরেক্টরি পরিষ্কার করা যায়নি\ntest.io_clean_image\tনেটিভ পরীক্ষা ইমেজ পরিষ্কার করা যায়নি\ntest.io_dir\tব্যক্তিগত পরীক্ষা ডিরেক্টরি তৈরি করা যায়নি\ntest.io_protect\tব্যক্তিগত পরীক্ষা ডিরেক্টরি সুরক্ষিত করা যায়নি\ntest.missing_target\tপরীক্ষার লক্ষ্য নেই\ntest.no_match\t--run={0}-এর সাথে কোনো পরীক্ষা মেলে না\ntest.none\tকোনো পরীক্ষা পাওয়া যায়নি\ntest.pass\tউত্তীর্ণ\ntest.resource\tসম্পদ সীমা ছাড়িয়েছে");
    string.write_string(output, "\ntest.runtime\tরানটাইম ত্রুটি\ntest.skip\tবাদ\ntest.skipped\tবাদ দেওয়া পরীক্ষা: {0}\ntest.starting\tপরীক্ষা শুরু {0}\ntest.summary\tপরীক্ষা সম্পন্ন: {0} উত্তীর্ণ, {1} ব্যর্থ");
    kaesu string.builder_string(output);
}

waza text_cs_cz() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tnelze načíst závislost: {0}\nbunko.missing\tBunko není nainstalováno. Pro import {0} použijte --bunko-root nebo MIO_BUNKO.\nbunko.package_read\tnelze přečíst balíček: {0}\nbunko.root_layout\točekáván adresář Bunko obsahující kiso/: {0}\nbunko.root_resolve\tnelze zjistit skutečnou cestu k adresáři: {0}\ncheck.passed\tkontrola prošla\ncli.lsp_unknown\tneznámý argument lsp: {0}\ncmd.build\tSestavit nativní spustitelný soubor nebo bytecode Mochi ze zdrojů Mio\ncmd.check\tAnalyzovat zdroje Mio bez vytváření výstupu\ncmd.disasm\tPřevést přeložený program Mochi na assembler\ncmd.exec\tSpustit přeložený program Mochi\ncmd.fmt\tFormátuje zdrojové soubory Mio.\ncmd.help\tZobrazit nápovědu k Mio nebo k jednomu příkazu\ncmd.lint\tHledá běžné problémy ve zdrojovém kódu Mio.\ncmd.lsp\tSpustit jazykový server Mio přes standardní vstup a výstup\ncmd.run\tSestavit a spustit program Mio ze zdrojů\ncmd.test\tNajít a spustit testovací balíčky Mio\ncmd.version\tZobrazit informace o verzi\ndiag.cause\tpříčina\ndiag.error\tchyba");
    string.write_string(output, "\ndiag.expected_actual\točekáváno {0}, nalezeno {1}\ndiag.lexical\tnerozpoznaný zdrojový text\ndiag.note\tpoznámka\ndiag.suggestion\tdoporučení\ndiag.warning\tvarování\nerr.analysis\tanalýza zdrojů selhala\nerr.bunko_empty\tcesta k náhradnímu Bunko musí být výslovná a nesmí být prázdná\nerr.chmod_native\tnelze nastavit nativní výstup jako spustitelný\nerr.cleanup\túklid po spuštění selhal\nerr.create_run_dir\tnelze vytvořit soukromý adresář spuštění\nerr.emit_mochi\ttento příkaz nemůže vytvořit bytecode Mochi\nerr.empty_paths\tcesty ke zdroji a výstupu nesmí být prázdné\nerr.gc_stress\t--gc-stress se vztahuje pouze na nativní sestavení ze zdrojů\nerr.help_args\thelp přijímá nejvýše jeden název příkazu\nerr.help_unknown\tpro neznámý příkaz není nápověda: {0}\nerr.host_target\trun a exec vyžadují cílový hostitel {0}\nerr.invalid_color\tneplatný barevný režim: {0} (očekáváno auto, always nebo never)\nerr.invalid_format\tneplatný formát: {0} (očekáváno human, short nebo json)\nerr.invalid_theme\tneplatné téma: {0} (očekáváno auto, dark nebo light)\nerr.missing_value\tchybí hodnota možnosti {0}");
    string.write_string(output, "\nerr.multiple_entries\tlze zadat pouze jednu zdrojovou položku\nerr.observe\t--observe se vztahuje pouze na nativní sestavení darwin-arm64 ze zdrojů\nerr.open_stream\tnelze otevřít {0}\nerr.program_args\targumenty programu vyžadují run nebo exec\nerr.protect_run_dir\tnelze chránit soukromý adresář spuštění\nerr.read_mochi\tnelze načíst vstup Mochi\nerr.run_output\trun a exec spravují svůj vlastní nativní výstup\nerr.spawn\tnativní program nelze spustit\nerr.symbols\t--emit-symbols se vztahuje pouze na nativní sestavení darwin-arm64 ze zdrojů\nerr.target\tnepodporovaný cíl: {0} (očekáváno darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tneznámý příkaz: {0}\nerr.unknown_option\tneznámá možnost: {0}\nerr.version_args\tpříkaz version nepřijímá argumenty\nerr.write_disasm\tnelze zapsat převod do assembleru\nerr.write_help\tnelze vypsat nápovědu\nerr.write_mochi\tnelze zapsat výstup Mochi\nerr.write_native\tnelze zapsat nativní výstup\nfmt.behavior\tAdresáře se prohledávají rekurzivně. Pomocí --stdin čtěte standardní vstup a pomocí --check vypište změny bez zápisu.\nfmt.status\tNávratový kód: 0 úspěch, 1 nutné změny v režimu --check, 2 chyba použití, analýzy nebo vstupu a výstupu.\nhelp.commands\tPříkazy");
    string.write_string(output, "\nhelp.examples\tPříklady\nhelp.group.compilation\tKompilace\nhelp.group.diagnostics\tDiagnostika\nhelp.group.execution\tSpuštění\nhelp.group.general\tObecné\nhelp.group.testing\tTesty\nhelp.group.tools\tVývojové nástroje\nhelp.more\tSpuštěním 'mio help <příkaz>' zobrazíte podrobnosti příkazu.\nhelp.options\tMožnosti\nhelp.tagline\tKompilátor Native AOT a sada nástrojů pro jazyk Mio\nhelp.title\tMio {0}\nhelp.usage\tPoužití\nlint.behavior\tVolba --list-rules vypíše pravidla, --deny-warnings považuje varování za neúspěch. Kód musí nejprve projít kontrolami překladače.\nlint.constant_condition\tPodmínka, která je vždy pravdivá nebo nepravdivá\nlint.finding_if\tpodmínka moshi má vždy hodnotu {0}\nlint.finding_import\timport {0} (balíček {1}) se nepoužívá\nlint.finding_loop\tpodmínka aida je vždy iie, tělo smyčky se nikdy neprovede\nlint.finding_unreachable\tnedosažitelný kód za {0}\nlint.finding_variable\tproměnná {0} je deklarována, ale nepoužívá se\nlint.status\tNávratový kód: 0 úspěch, 1 varování s --deny-warnings, 2 chyba použití nebo překladu.");
    string.write_string(output, "\nlint.unreachable_code\tPříkaz po nepodmíněném přenosu řízení\nlint.unused_import\tNepoužitý import balíčku\nlint.unused_variable\tNepoužitá lokální proměnná (kromě názvů začínajících _)\nopt.bunko\tPoužít tento kořen Bunko místo výchozího\nopt.color\tŘídit barevný výstup: auto, always nebo never\nopt.emit\tVytvořit bytecode Mochi místo nativního obrazu\nopt.format\tVybrat formát výstupu: human, short nebo json\nopt.gc_stress\tSestavit s agresivními zátěžovými kontrolami garbage collectoru\nopt.help\tZobrazit nápovědu\nopt.lang\tVybrat jazyk výstupu pomocí značky BCP 47, například ja-JP\nopt.observe\tZaznamenat pozorování nativního sestavení\nopt.output\tZapsat výstup do této cesty\nopt.program_args\tPředat zbývající argumenty programu\nopt.run_filter\tSpustit pouze testy, jejichž názvy odpovídají tomuto regulárnímu výrazu\nopt.stdio\tPoužít standardní vstup a výstup pro jazykový server\nopt.symbols\tZapsat informace o nativních symbolech do tohoto souboru\nopt.target\tSestavit pro darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tVybrat sémantickou paletu: auto, dark nebo light\nopt.verbose\tZahrnout další diagnostické podrobnosti\nopt.version\tZobrazit informace o verzi");
    string.write_string(output, "\ntest.assertion\tkontrolní tvrzení selhalo\ntest.bunko_empty\tcesta k náhradnímu Bunko nesmí být prázdná\ntest.bunko_missing\tchybí hodnota --bunko-root\ntest.compile_failed\tkompilace selhala\ntest.duration\tcelková doba\ntest.empty_filter\tfiltr testů nesmí být prázdný\ntest.empty_lang\tjazyková značka nesmí být prázdná\ntest.fail\tSELHÁNÍ\ntest.filter_invalid\tneplatný filtr testů: {0}\ntest.invalid_arg\tneplatný argument testu: {0}\ntest.invalid_signature\tneplatný podpis testovací funkce\ntest.io_clean_dir\tnelze uklidit soukromý adresář testů\ntest.io_clean_image\tnelze uklidit nativní testovací obraz\ntest.io_dir\tnelze vytvořit soukromý adresář testů\ntest.io_protect\tnelze chránit soukromý adresář testů\ntest.missing_target\tchybí cíl testů\ntest.no_match\tžádný test neodpovídá --run={0}\ntest.none\tnenalezeny žádné testy\ntest.pass\tÚSPĚCH\ntest.resource\tpřekročen limit prostředků");
    string.write_string(output, "\ntest.runtime\tchyba za běhu\ntest.skip\tPŘESKOČENO\ntest.skipped\tPřeskočené testy: {0}\ntest.starting\tSpouštění testů {0}\ntest.summary\tTesty dokončeny: {0} úspěšných, {1} selhaných");
    kaesu string.builder_string(output);
}

waza text_da_dk() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tkan ikke indlæse afhængighed: {0}\nbunko.missing\tBunko er ikke installeret. Brug --bunko-root eller MIO_BUNKO til at importere {0}.\nbunko.package_read\tkan ikke læse pakken: {0}\nbunko.root_layout\tforventede en Bunko-mappe med kiso/: {0}\nbunko.root_resolve\tkan ikke finde mappens faktiske sti: {0}\ncheck.passed\tkontrollen bestået\ncli.lsp_unknown\tukendt lsp-argument: {0}\ncmd.build\tByg en native eksekverbar fil eller Mochi-bytekode fra Mio-kildekode\ncmd.check\tAnalysér Mio-kildekode uden at producere output\ncmd.disasm\tDisassemblér et kompileret Mochi-program\ncmd.exec\tKør et kompileret Mochi-program\ncmd.fmt\tFormatér Mio-kildefiler.\ncmd.help\tVis hjælp til Mio eller en enkelt kommando\ncmd.lint\tKontrollér Mio-kildekode for almindelige problemer.\ncmd.lsp\tStart Mio-sprogserveren over standard input/output\ncmd.run\tByg og kør et Mio-program fra kildekode\ncmd.test\tFind og kør Mio-testpakker\ncmd.version\tVis versionsoplysninger\ndiag.cause\tårsag\ndiag.error\tfejl");
    string.write_string(output, "\ndiag.expected_actual\tforventede {0}, fik {1}\ndiag.lexical\tukendt kildetekst\ndiag.note\tbemærkning\ndiag.suggestion\tforslag\ndiag.warning\tadvarsel\nerr.analysis\tkildeanalysen mislykkedes\nerr.bunko_empty\tBunko-tilsidesættelsens sti skal være eksplicit og ikke tom\nerr.chmod_native\tkan ikke gøre native output eksekverbar\nerr.cleanup\toprydningen efter kørslen mislykkedes\nerr.create_run_dir\tkan ikke oprette en privat kørselsmappe\nerr.emit_mochi\tdenne kommando kan ikke udskrive Mochi-bytekode\nerr.empty_paths\tkilde- og outputstierne må ikke være tomme\nerr.gc_stress\t--gc-stress gælder kun for native builds fra kildekode\nerr.help_args\thelp tager højst ét kommandonavn\nerr.help_unknown\tingen hjælp til ukendt kommando: {0}\nerr.host_target\trun og exec kræver værtsmålet {0}\nerr.invalid_color\tugyldig farvetilstand: {0} (forventede auto, always eller never)\nerr.invalid_format\tugyldigt format: {0} (forventede human, short eller json)\nerr.invalid_theme\tugyldigt tema: {0} (forventede auto, dark eller light)\nerr.missing_value\tværdien mangler for valgmuligheden {0}");
    string.write_string(output, "\nerr.multiple_entries\tder kan kun angives én kildeindgang\nerr.observe\t--observe gælder kun for native darwin-arm64-builds fra kildekode\nerr.open_stream\tkan ikke åbne {0}\nerr.program_args\tprogramargumenter kræver run eller exec\nerr.protect_run_dir\tkan ikke beskytte den private kørselsmappe\nerr.read_mochi\tkan ikke læse Mochi-input\nerr.run_output\trun og exec styrer deres egen native output\nerr.spawn\tdet native program kunne ikke startes\nerr.symbols\t--emit-symbols gælder kun for native darwin-arm64-builds fra kildekode\nerr.target\tikke-understøttet mål: {0} (forventede darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tukendt kommando: {0}\nerr.unknown_option\tukendt valgmulighed: {0}\nerr.version_args\tkommandoen version tager ingen argumenter\nerr.write_disasm\tkan ikke skrive disassembleringen\nerr.write_help\tkan ikke skrive hjælpeteksten\nerr.write_mochi\tkan ikke skrive Mochi-output\nerr.write_native\tkan ikke skrive native output\nfmt.behavior\tMapper gennemsøges rekursivt. Brug --stdin til at læse standardinput og --check til at rapportere ændringer uden at skrive.\nfmt.status\tAfslutningskode: 0 succes, 1 ændringer kræves med --check, 2 fejl i brug, syntaksanalyse eller I/O.\nhelp.commands\tKommandoer");
    string.write_string(output, "\nhelp.examples\tEksempler\nhelp.group.compilation\tKompilering\nhelp.group.diagnostics\tDiagnostik\nhelp.group.execution\tKørsel\nhelp.group.general\tGenerelt\nhelp.group.testing\tTests\nhelp.group.tools\tUdviklingsværktøjer\nhelp.more\tKør 'mio help <kommando>' for detaljer om en kommando.\nhelp.options\tValgmuligheder\nhelp.tagline\tNative AOT-kompiler og værktøjskæde til sproget Mio\nhelp.title\tMio {0}\nhelp.usage\tBrug\nlint.behavior\tBrug --list-rules til at vise regler og --deny-warnings til at fejle ved advarsler. Kilden skal først bestå compilerens kontroller.\nlint.constant_condition\tBetingelse der altid er sand eller falsk\nlint.finding_if\tbetingelsen i moshi er altid {0}\nlint.finding_import\timporten {0} (pakken {1}) bruges aldrig\nlint.finding_loop\tbetingelsen i aida er altid iie, så løkkens krop køres aldrig\nlint.finding_unreachable\tkode efter {0} kan ikke nås\nlint.finding_variable\tvariablen {0} er erklæret, men bruges aldrig\nlint.status\tAfslutningskode: 0 succes, 1 advarsler med --deny-warnings, 2 fejl i brug eller kompilering.");
