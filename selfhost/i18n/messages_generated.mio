// Missing entries fall back to en-US and finally to the key itself.
koukai waza text(language: string, key: string) -> string {
    kaku value = localized(language, key);
    moshi (value != "") { kaesu value; }
    kaku fallback = table_lookup(text_en_us(), key);
    moshi (fallback != "") { kaesu fallback; }
    kaesu key;
}
