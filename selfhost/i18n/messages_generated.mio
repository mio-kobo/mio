waza text_th_th() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tไม่สามารถโหลดส่วนที่ต้องใช้: {0}\nbunko.missing\tยังไม่ได้ติดตั้ง Bunko ใช้ --bunko-root หรือ MIO_BUNKO เพื่อนำเข้า {0}\nbunko.package_read\tไม่สามารถอ่านแพ็กเกจ: {0}\nbunko.root_layout\tไดเรกทอรี Bunko ต้องมี kiso/: {0}\nbunko.root_resolve\tไม่สามารถระบุพาธจริงของไดเรกทอรี: {0}\ncheck.passed\tตรวจสอบผ่าน\ncli.lsp_unknown\tอาร์กิวเมนต์ lsp ที่ไม่รู้จัก: {0}\ncmd.build\tสร้างไฟล์เรียกทำงานเนทีฟหรือไบต์โค้ด Mochi จากซอร์ส Mio\ncmd.check\tวิเคราะห์ซอร์ส Mio โดยไม่สร้างเอาต์พุต\ncmd.disasm\tถอดรหัสโปรแกรม Mochi ที่คอมไพล์แล้ว\ncmd.exec\tเรียกใช้โปรแกรม Mochi ที่คอมไพล์แล้ว\ncmd.fmt\tจัดรูปแบบไฟล์ซอร์ส Mio\ncmd.help\tแสดงความช่วยเหลือสำหรับ Mio หรือคำสั่งเดียว\ncmd.lint\tตรวจหาปัญหาที่พบบ่อยในซอร์สโค้ด Mio\ncmd.lsp\tเริ่มเซิร์ฟเวอร์ภาษ Mio ผ่านอินพุต/เอาต์พุตมาตรฐาน\ncmd.run\tสร้างและเรียกใช้โปรแกรม Mio จากซอร์ส\ncmd.test\tค้นหาและเรียกใช้แพ็กเกจทดสอบ Mio\ncmd.version\tแสดงข้อมูลเวอร์ชัน\ndiag.cause\tสาเหตุ\ndiag.error\tข้อผิดพลาด");
    string.write_string(output, "\ndiag.expected_actual\tคาดว่าเป็น {0} แต่ได้ {1}\ndiag.lexical\tไม่รู้จักข้อความในซอร์สโค้ด\ndiag.note\tหมายเหตุ\ndiag.suggestion\tข้อเสนอแนะ\ndiag.warning\tคำเตือน\nerr.analysis\tการวิเคราะห์ซอร์สล้มเหลว\nerr.bunko_empty\tพาธทดแทน Bunko ต้องระบุชัดเจนและไม่ว่าง\nerr.chmod_native\tไม่สามารถทำให้เอาต์พุตเนทีฟเรียกทำงานได้\nerr.cleanup\tการล้างข้อมูลหลังเรียกใช้ล้มเหลว\nerr.create_run_dir\tไม่สามารถสร้างไดเรกทอรีเรียกใช้ส่วนตัว\nerr.emit_mochi\tคำสั่งนี้ไม่สามารถส่งออกไบต์โค้ด Mochi ได้\nerr.empty_paths\tพาธซอร์สและเอาต์พุตต้องไม่ว่าง\nerr.gc_stress\t--gc-stress ใช้ได้เฉพาะการสร้างเนทีฟจากซอร์ส\nerr.help_args\thelp รับชื่อคำสั่งได้ไม่เกินหนึ่งชื่อ\nerr.help_unknown\tไม่มีความช่วยเหลือสำหรับคำสั่งที่ไม่รู้จัก: {0}\nerr.host_target\trun และ exec ต้องใช้เป้าหมายโฮสต์ {0}\nerr.invalid_color\tโหมดสีไม่ถูกต้อง: {0} (คาดว่า auto, always หรือ never)\nerr.invalid_format\tรูปแบบไม่ถูกต้อง: {0} (คาดว่า human, short หรือ json)\nerr.invalid_theme\tธีมไม่ถูกต้อง: {0} (คาดว่า auto, dark หรือ light)\nerr.missing_value\tไม่มีค่าสำหรับตัวเลือก {0}");
    string.write_string(output, "\nerr.multiple_entries\tระบุซอร์สได้เพียงรายการเดียว\nerr.observe\t--observe ใช้ได้เฉพาะการสร้างเนทีฟ darwin-arm64 จากซอร์ส\nerr.open_stream\tไม่สามารถเปิด {0}\nerr.program_args\tอาร์กิวเมนต์ของโปรแกรมต้องใช้ run หรือ exec\nerr.protect_run_dir\tไม่สามารถป้องกันไดเรกทอรีเรียกใช้ส่วนตัว\nerr.read_mochi\tไม่สามารถอ่านอินพุต Mochi\nerr.run_output\trun และ exec จัดการเอาต์พุตเนทีฟของตนเอง\nerr.spawn\tไม่สามารถเริ่มโปรแกรมเนทีฟ\nerr.symbols\t--emit-symbols ใช้ได้เฉพาะการสร้างเนทีฟ darwin-arm64 จากซอร์ส\nerr.target\tไม่รองรับเป้าหมาย: {0} (คาดว่า darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tไม่รู้จักคำสั่ง: {0}\nerr.unknown_option\tไม่รู้จักตัวเลือก: {0}\nerr.version_args\tคำสั่ง version ไม่รับอาร์กิวเมนต์\nerr.write_disasm\tไม่สามารถเขียนผลถอดรหัส\nerr.write_help\tไม่สามารถแสดงวิธีใช้\nerr.write_mochi\tไม่สามารถเขียนเอาต์พุต Mochi\nerr.write_native\tไม่สามารถเขียนเอาต์พุตเนทีฟ\nfmt.behavior\tค้นหาทั้งในไดเรกทอรีและไดเรกทอรีย่อย ใช้ --stdin เพื่ออ่านอินพุตมาตรฐาน และ --check เพื่อรายงานการเปลี่ยนแปลงโดยไม่เขียนไฟล์\nfmt.status\tรหัสออก: 0 สำเร็จ, 1 ต้องแก้ไขในโหมด --check, 2 ข้อผิดพลาดในการใช้งาน การวิเคราะห์ไวยากรณ์ หรือ I/O\nhelp.commands\tคำสั่ง");
    string.write_string(output, "\nhelp.examples\tตัวอย่าง\nhelp.group.compilation\tการคอมไพล์\nhelp.group.diagnostics\tการวินิจฉัย\nhelp.group.execution\tการเรียกใช้\nhelp.group.general\tทั่วไป\nhelp.group.testing\tการทดสอบ\nhelp.group.tools\tเครื่องมือพัฒนา\nhelp.more\tเรียกใช้ 'mio help <คำสั่ง>' เพื่อดูรายละเอียดของคำสั่ง\nhelp.options\tตัวเลือก\nhelp.tagline\tคอมไพเลอร์ Native AOT และชุดเครื่องมือสำหรับภาษา Mio\nhelp.title\tMio {0}\nhelp.usage\tการใช้งาน\nlint.behavior\tใช้ --list-rules เพื่อแสดงกฎ และ --deny-warnings เพื่อให้คำเตือนถือเป็นความล้มเหลว ซอร์สโค้ดต้องผ่านการตรวจของคอมไพเลอร์ก่อน\nlint.constant_condition\tเงื่อนไขที่เป็นจริงเสมอหรือเท็จเสมอ\nlint.finding_if\tเงื่อนไข moshi มีค่าเป็น {0} เสมอ\nlint.finding_import\tไม่ได้ใช้การนำเข้า {0} (แพ็กเกจ {1})\nlint.finding_loop\tเงื่อนไข aida มีค่าเป็น iie เสมอ จึงไม่มีการทำงานในลูป\nlint.finding_unreachable\tโค้ดหลัง {0} ไม่สามารถเข้าถึงได้\nlint.finding_variable\tประกาศตัวแปร {0} ไว้แต่ไม่ได้ใช้\nlint.status\tรหัสออก: 0 สำเร็จ, 1 มีคำเตือนเมื่อใช้ --deny-warnings, 2 ข้อผิดพลาดในการใช้งานหรือคอมไพล์");
    string.write_string(output, "\nlint.unreachable_code\tคำสั่งหลังการโอนการควบคุมแบบไม่มีเงื่อนไข\nlint.unused_import\tการนำเข้าแพ็กเกจที่ไม่ได้ใช้\nlint.unused_variable\tตัวแปรเฉพาะที่ที่ไม่ได้ใช้ (ยกเว้นชื่อที่ขึ้นต้นด้วย _)\nopt.bunko\tใช้ราก Bunko นี้แทนค่าเริ่มต้น\nopt.color\tควบคุมเอาต์พุตสี: auto, always หรือ never\nopt.emit\tส่งออกไบต์โค้ด Mochi แทนอิมเมจเนทีฟ\nopt.format\tเลือกรูปแบบเอาต์พุต: human, short หรือ json\nopt.gc_stress\tสร้างพร้อมการตรวจสอบภาระตัวเก็บขยะแบบเข้มข้น\nopt.help\tแสดงความช่วยเหลือ\nopt.lang\tเลือกภาษาของเอาต์พุตด้วยแท็ก BCP 47 เช่น ja-JP\nopt.observe\tบันทึกการสังเกตการสร้างเนทีฟ\nopt.output\tเขียนเอาต์พุตไปยังพาธนี้\nopt.program_args\tส่งอาร์กิวเมนต์ที่เหลือไปยังโปรแกรม\nopt.run_filter\tเรียกใช้เฉพาะการทดสอบที่ชื่อตรงกับนิพจน์ปกตินี้\nopt.stdio\tใช้อินพุตและเอาต์พุตมาตรฐานสำหรับเซิร์ฟเวอร์ภาษา\nopt.symbols\tเขียนข้อมูลสัญลักษณ์เนทีฟลงในไฟล์นี้\nopt.target\tสร้างสำหรับ darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tเลือกชุดสีตามความหมาย: auto, dark หรือ light\nopt.verbose\tแสดงรายละเอียดการวินิจฉัยเพิ่มเติม\nopt.version\tแสดงข้อมูลเวอร์ชัน");
    string.write_string(output, "\ntest.assertion\tการยืนยันล้มเหลว\ntest.bunko_empty\tพาธทดแทน Bunko ต้องไม่ว่าง\ntest.bunko_missing\tไม่มีค่าสำหรับ --bunko-root\ntest.compile_failed\tการคอมไพล์ล้มเหลว\ntest.duration\tระยะเวลารวม\ntest.empty_filter\tตัวกรองการทดสอบต้องไม่ว่าง\ntest.empty_lang\tแท็กภาษาต้องไม่ว่าง\ntest.fail\tไม่ผ่าน\ntest.filter_invalid\tตัวกรองการทดสอบไม่ถูกต้อง: {0}\ntest.invalid_arg\tอาร์กิวเมนต์การทดสอบไม่ถูกต้อง: {0}\ntest.invalid_signature\tลายเซ็นฟังก์ชันทดสอบไม่ถูกต้อง\ntest.io_clean_dir\tไม่สามารถล้างไดเรกทอรีทดสอบส่วนตัว\ntest.io_clean_image\tไม่สามารถล้างอิมเมจทดสอบเนทีฟ\ntest.io_dir\tไม่สามารถสร้างไดเรกทอรีทดสอบส่วนตัว\ntest.io_protect\tไม่สามารถป้องกันไดเรกทอรีทดสอบส่วนตัว\ntest.missing_target\tไม่มีเป้าหมายการทดสอบ\ntest.no_match\tไม่มีการทดสอบที่ตรงกับ --run={0}\ntest.none\tไม่พบการทดสอบ\ntest.pass\tผ่าน\ntest.resource\tเกินขีดจำกัดทรัพยากร");
    string.write_string(output, "\ntest.runtime\tข้อผิดพลาดขณะเรียกใช้\ntest.skip\tข้าม\ntest.skipped\tการทดสอบที่ข้าม: {0}\ntest.starting\tเริ่มการทดสอบ {0}\ntest.summary\tการทดสอบเสร็จสิ้น: ผ่าน {0} รายการ ไม่ผ่าน {1} รายการ");
    kaesu string.builder_string(output);
}

waza text_tr_tr() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tbağımlılık yüklenemedi: {0}\nbunko.missing\tBunko kurulu değil. {0} içe aktarımı için --bunko-root veya MIO_BUNKO kullanın.\nbunko.package_read\tpaket okunamadı: {0}\nbunko.root_layout\tkiso/ içeren bir Bunko dizini bekleniyordu: {0}\nbunko.root_resolve\tdizinin gerçek yolu belirlenemedi: {0}\ncheck.passed\tdenetim başarılı\ncli.lsp_unknown\tbilinmeyen lsp bağımsız değişkeni: {0}\ncmd.build\tMio kaynağından yerel yürütülebilir dosya veya Mochi bayt kodu oluştur\ncmd.check\tÇıktı üretmeden Mio kaynağını çözümle\ncmd.disasm\tDerlenmiş bir Mochi programını disassemble et\ncmd.exec\tDerlenmiş bir Mochi programını çalıştır\ncmd.fmt\tMio kaynak dosyalarını biçimlendir.\ncmd.help\tMio veya tek bir komut için yardım göster\ncmd.lint\tMio kaynak kodunda yaygın sorunları denetle.\ncmd.lsp\tMio dil sunucusunu standart giriş/çıkış üzerinden başlat\ncmd.run\tMio programını kaynaktan oluşturup çalıştır\ncmd.test\tMio test paketlerini bul ve çalıştır\ncmd.version\tSürüm bilgilerini göster\ndiag.cause\tneden\ndiag.error\thata");
    string.write_string(output, "\ndiag.expected_actual\tbeklenen {0}, alınan {1}\ndiag.lexical\ttanınmayan kaynak metni\ndiag.note\tnot\ndiag.suggestion\töneri\ndiag.warning\tuyarı\nerr.analysis\tkaynak çözümlemesi başarısız oldu\nerr.bunko_empty\tBunko geçersiz kılma yolu açık ve boş olmamalıdır\nerr.chmod_native\tyerel çıktı yürütülebilir yapılamıyor\nerr.cleanup\tçalıştırma sonrası temizlik başarısız oldu\nerr.create_run_dir\tözel çalıştırma dizini oluşturulamıyor\nerr.emit_mochi\tbu komut Mochi bayt kodu üretemez\nerr.empty_paths\tkaynak ve çıktı yolları boş olamaz\nerr.gc_stress\t--gc-stress yalnızca kaynaktan yerel derlemeler için geçerlidir\nerr.help_args\thelp en fazla bir komut adı alır\nerr.help_unknown\tbilinmeyen komut için yardım yok: {0}\nerr.host_target\trun ve exec {0} ana bilgisayar hedefini gerektirir\nerr.invalid_color\tgeçersiz renk modu: {0} (auto, always veya never bekleniyor)\nerr.invalid_format\tgeçersiz biçim: {0} (human, short veya json bekleniyor)\nerr.invalid_theme\tgeçersiz tema: {0} (auto, dark veya light bekleniyor)\nerr.missing_value\t{0} seçeneği için değer eksik");
    string.write_string(output, "\nerr.multiple_entries\tyalnızca bir kaynak girdisi verilebilir\nerr.observe\t--observe yalnızca kaynaktan darwin-arm64 yerel derlemeleri için geçerlidir\nerr.open_stream\t{0} açılamadı\nerr.program_args\tprogram bağımsız değişkenleri run veya exec gerektirir\nerr.protect_run_dir\tözel çalıştırma dizini korunamıyor\nerr.read_mochi\tMochi girdisi okunamıyor\nerr.run_output\trun ve exec kendi yerel çıktılarını yönetir\nerr.spawn\tyerel program başlatılamadı\nerr.symbols\t--emit-symbols yalnızca kaynaktan darwin-arm64 yerel derlemeleri için geçerlidir\nerr.target\tdesteklenmeyen hedef: {0} (darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64 bekleniyor)\nerr.unknown_command\tbilinmeyen komut: {0}\nerr.unknown_option\tbilinmeyen seçenek: {0}\nerr.version_args\tversion komutu bağımsız değişken almaz\nerr.write_disasm\tdisassembly yazılamıyor\nerr.write_help\tyardım yazılamadı\nerr.write_mochi\tMochi çıktısı yazılamıyor\nerr.write_native\tyerel çıktı yazılamıyor\nfmt.behavior\tDizinler ve alt dizinleri taranır. Standart girdiyi okumak için --stdin, yazmadan değişiklikleri bildirmek için --check kullanın.\nfmt.status\tÇıkış kodu: 0 başarılı, 1 --check kipinde değişiklik gerekli, 2 kullanım, ayrıştırma veya G/Ç hatası.\nhelp.commands\tKomutlar");
    string.write_string(output, "\nhelp.examples\tÖrnekler\nhelp.group.compilation\tDerleme\nhelp.group.diagnostics\tTanılama\nhelp.group.execution\tYürütme\nhelp.group.general\tGenel\nhelp.group.testing\tTestler\nhelp.group.tools\tGeliştirme araçları\nhelp.more\tBir komutun ayrıntıları için 'mio help <komut>' çalıştırın.\nhelp.options\tSeçenekler\nhelp.tagline\tMio dili için Native AOT derleyicisi ve araç zinciri\nhelp.title\tMio {0}\nhelp.usage\tKullanım\nlint.behavior\tKuralları göstermek için --list-rules, uyarı varsa başarısız olmak için --deny-warnings kullanın. Kaynak önce derleyici denetimlerinden geçmelidir.\nlint.constant_condition\tHer zaman doğru veya her zaman yanlış koşul\nlint.finding_if\tmoshi koşulu her zaman {0} değerindedir\nlint.finding_import\t{0} içe aktarımı ({1} paketi) hiç kullanılmıyor\nlint.finding_loop\taida koşulu her zaman iie değerindedir, bu yüzden döngü gövdesi hiç çalışmaz\nlint.finding_unreachable\t{0} sonrasındaki koda ulaşılamaz\nlint.finding_variable\t{0} değişkeni bildirildi ancak hiç kullanılmıyor\nlint.status\tÇıkış kodu: 0 başarılı, 1 --deny-warnings ile uyarı, 2 kullanım veya derleme hatası.");
    string.write_string(output, "\nlint.unreachable_code\tKoşulsuz denetim aktarımından sonraki deyim\nlint.unused_import\tKullanılmayan paket içe aktarımı\nlint.unused_variable\tKullanılmayan yerel değişken (_ ile başlayan adlar hariç)\nopt.bunko\tVarsayılan yerine bu Bunko kökünü kullan\nopt.color\tRenkli çıktıyı denetle: auto, always veya never\nopt.emit\tYerel görüntü yerine Mochi bayt kodu üret\nopt.format\tÇıktı biçimini seç: human, short veya json\nopt.gc_stress\tAgresif çöp toplayıcı yük denetimleriyle derle\nopt.help\tYardımı göster\nopt.lang\tÇıktı dilini BCP 47 etiketiyle seç, örneğin ja-JP\nopt.observe\tYerel derleme gözlemlerini kaydet\nopt.output\tÇıktıyı bu yola yaz\nopt.program_args\tKalan bağımsız değişkenleri programa ilet\nopt.run_filter\tYalnızca adı bu düzenli ifadeyle eşleşen testleri çalıştır\nopt.stdio\tDil sunucusu için standart giriş ve çıkışı kullan\nopt.symbols\tYerel simge bilgilerini bu dosyaya yaz\nopt.target\tdarwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64 için derle\nopt.theme\tAnlamsal renk paletini seç: auto, dark veya light\nopt.verbose\tEk tanılama ayrıntılarını göster\nopt.version\tSürüm bilgilerini göster");
    string.write_string(output, "\ntest.assertion\tdoğrulama başarısız\ntest.bunko_empty\tBunko geçersiz kılma yolu boş olamaz\ntest.bunko_missing\t--bunko-root için değer eksik\ntest.compile_failed\tderleme başarısız\ntest.duration\ttoplam süre\ntest.empty_filter\ttest filtresi boş olamaz\ntest.empty_lang\tdil etiketi boş olamaz\ntest.fail\tBAŞARISIZ\ntest.filter_invalid\tgeçersiz test filtresi: {0}\ntest.invalid_arg\tgeçersiz test bağımsız değişkeni: {0}\ntest.invalid_signature\tgeçersiz test işlevi imzası\ntest.io_clean_dir\tözel test dizini temizlenemiyor\ntest.io_clean_image\tyerel test görüntüsü temizlenemiyor\ntest.io_dir\tözel test dizini oluşturulamıyor\ntest.io_protect\tözel test dizini korunamıyor\ntest.missing_target\ttest hedefi eksik\ntest.no_match\t--run={0} ile eşleşen test yok\ntest.none\ttest bulunamadı\ntest.pass\tBAŞARILI\ntest.resource\tkaynak sınırı aşıldı");
    string.write_string(output, "\ntest.runtime\tçalışma zamanı hatası\ntest.skip\tATLANDI\ntest.skipped\tAtlanan testler: {0}\ntest.starting\tTestler başlıyor {0}\ntest.summary\tTestler tamamlandı: {0} başarılı, {1} başarısız");
    kaesu string.builder_string(output);
}

waza text_uk_ua() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tне вдалося завантажити залежність: {0}\nbunko.missing\tBunko не встановлено. Для імпорту {0} скористайтеся --bunko-root або MIO_BUNKO.\nbunko.package_read\tне вдалося прочитати пакунок: {0}\nbunko.root_layout\tочікувався каталог Bunko з підкаталогом kiso/: {0}\nbunko.root_resolve\tне вдалося визначити фактичний шлях до каталогу: {0}\ncheck.passed\tперевірку пройдено\ncli.lsp_unknown\tневідомий аргумент lsp: {0}\ncmd.build\tЗібрати нативний виконуваний файл або байт-код Mochi з джерел Mio\ncmd.check\tПроаналізувати джерела Mio без створення виводу\ncmd.disasm\tДизасемблювати скомпільовану програму Mochi\ncmd.exec\tЗапустити скомпільовану програму Mochi\ncmd.fmt\tФорматування вихідних файлів Mio.\ncmd.help\tПоказати довідку про Mio або одну команду\ncmd.lint\tПошук типових проблем у вихідному коді Mio.\ncmd.lsp\tЗапустити мовний сервер Mio через стандартний ввід-вивід\ncmd.run\tЗібрати й запустити програму Mio з джерел\ncmd.test\tЗнайти й запустити тестові пакети Mio\ncmd.version\tПоказати відомості про версію\ndiag.cause\tпричина\ndiag.error\tпомилка");
    string.write_string(output, "\ndiag.expected_actual\tочікувалося {0}, отримано {1}\ndiag.lexical\tнерозпізнаний вихідний текст\ndiag.note\tпримітка\ndiag.suggestion\tпорада\ndiag.warning\tпопередження\nerr.analysis\tне вдалося проаналізувати джерела\nerr.bunko_empty\tперевизначений шлях Bunko має бути явним і непорожнім\nerr.chmod_native\tне вдалося зробити нативний вивід виконуваним\nerr.cleanup\tне вдалося очистити тимчасові файли після запуску\nerr.create_run_dir\tне вдалося створити приватний каталог запуску\nerr.emit_mochi\tця команда не може видавати байт-код Mochi\nerr.empty_paths\tшляхи джерела й виводу не можуть бути порожніми\nerr.gc_stress\t--gc-stress застосовується лише до нативних збірок з джерел\nerr.help_args\thelp приймає щонайбільше одну назву команди\nerr.help_unknown\tнемає довідки для невідомої команди: {0}\nerr.host_target\trun і exec потребують цілі хоста {0}\nerr.invalid_color\tнеприпустимий режим кольору: {0} (очікується auto, always або never)\nerr.invalid_format\tнеприпустимий формат: {0} (очікується human, short або json)\nerr.invalid_theme\tнеприпустима тема: {0} (очікується auto, dark або light)\nerr.missing_value\tвідсутнє значення параметра {0}");
    string.write_string(output, "\nerr.multiple_entries\tможна вказати лише одне джерело\nerr.observe\t--observe застосовується лише до нативних збірок darwin-arm64 з джерел\nerr.open_stream\tне вдалося відкрити {0}\nerr.program_args\tаргументи програми потребують run або exec\nerr.protect_run_dir\tне вдалося захистити приватний каталог запуску\nerr.read_mochi\tне вдалося прочитати вхід Mochi\nerr.run_output\trun і exec самостійно керують нативним виводом\nerr.spawn\tне вдалося запустити нативну програму\nerr.symbols\t--emit-symbols застосовується лише до нативних збірок darwin-arm64 з джерел\nerr.target\tнепідтримувана ціль: {0} (очікується darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tневідома команда: {0}\nerr.unknown_option\tневідомий параметр: {0}\nerr.version_args\tкоманда version не приймає аргументів\nerr.write_disasm\tне вдалося записати дизасемблер\nerr.write_help\tне вдалося вивести довідку\nerr.write_mochi\tне вдалося записати вивід Mochi\nerr.write_native\tне вдалося записати нативний вивід\nfmt.behavior\tКаталоги переглядаються рекурсивно. Параметр --stdin читає стандартне введення, а --check повідомляє про зміни без запису.\nfmt.status\tКод завершення: 0 успіх, 1 потрібні зміни в режимі --check, 2 помилка використання, синтаксичного аналізу або введення-виведення.\nhelp.commands\tКоманди");
    string.write_string(output, "\nhelp.examples\tПриклади\nhelp.group.compilation\tКомпіляція\nhelp.group.diagnostics\tДіагностика\nhelp.group.execution\tВиконання\nhelp.group.general\tЗагальні\nhelp.group.testing\tТести\nhelp.group.tools\tІнструменти розробки\nhelp.more\tВиконайте 'mio help <команда>', щоб переглянути відомості про команду.\nhelp.options\tПараметри\nhelp.tagline\tКомпілятор Native AOT та інструменти для мови Mio\nhelp.title\tMio {0}\nhelp.usage\tВикористання\nlint.behavior\tПараметр --list-rules показує правила, а --deny-warnings вважає попередження помилками. Код спочатку має пройти перевірки компілятора.\nlint.constant_condition\tЗавжди істинна або завжди хибна умова\nlint.finding_if\tумова moshi завжди дорівнює {0}\nlint.finding_import\tімпорт {0} (пакунок {1}) не використовується\nlint.finding_loop\tумова aida завжди дорівнює iie, тому тіло циклу ніколи не виконується\nlint.finding_unreachable\tнедосяжний код після {0}\nlint.finding_variable\tзмінну {0} оголошено, але не використано\nlint.status\tКод завершення: 0 успіх, 1 попередження з --deny-warnings, 2 помилка використання або компіляції.");
    string.write_string(output, "\nlint.unreachable_code\tІнструкція після безумовного передавання керування\nlint.unused_import\tНевикористаний імпорт пакунка\nlint.unused_variable\tНевикористана локальна змінна (крім імен, що починаються з _)\nopt.bunko\tВикористовувати цей корінь Bunko замість типового\nopt.color\tКерувати кольоровим виводом: auto, always або never\nopt.emit\tВидати байт-код Mochi замість нативного образу\nopt.format\tВибрати формат виводу: human, short або json\nopt.gc_stress\tЗібрати з посиленими перевірками навантаження збирача сміття\nopt.help\tПоказати довідку\nopt.lang\tВибрати мову виводу за тегом BCP 47, наприклад ja-JP\nopt.observe\tЗаписувати спостереження нативної збірки\nopt.output\tЗаписати вивід за цим шляхом\nopt.program_args\tПередати решту аргументів програмі\nopt.run_filter\tЗапускати лише тести, назви яких відповідають цьому регулярному виразу\nopt.stdio\tВикористовувати стандартний ввід і вивід для мовного сервера\nopt.symbols\tЗаписати відомості про нативні символи в цей файл\nopt.target\tЗібрати для darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tВибрати смислову палітру: auto, dark або light\nopt.verbose\tПоказувати додаткові відомості діагностики\nopt.version\tПоказати відомості про версію");
    string.write_string(output, "\ntest.assertion\tпомилка перевірки\ntest.bunko_empty\tперевизначений шлях Bunko не може бути порожнім\ntest.bunko_missing\tвідсутнє значення --bunko-root\ntest.compile_failed\tпомилка компіляції\ntest.duration\tзагальна тривалість\ntest.empty_filter\tфільтр тестів не може бути порожнім\ntest.empty_lang\tмовний тег не може бути порожнім\ntest.fail\tЗБІЙ\ntest.filter_invalid\tнеприпустимий фільтр тестів: {0}\ntest.invalid_arg\tнеприпустимий аргумент тесту: {0}\ntest.invalid_signature\tнеприпустима сигнатура тестової функції\ntest.io_clean_dir\tне вдалося видалити приватний каталог тестів\ntest.io_clean_image\tне вдалося видалити нативний тестовий образ\ntest.io_dir\tне вдалося створити приватний каталог тестів\ntest.io_protect\tне вдалося захистити приватний каталог тестів\ntest.missing_target\tне вказано ціль тестування\ntest.no_match\tнемає тестів, що відповідають --run={0}\ntest.none\tтестів не знайдено\ntest.pass\tУСПІХ\ntest.resource\tперевищено ліміт ресурсів");
    string.write_string(output, "\ntest.runtime\tпомилка виконання\ntest.skip\tПРОПУЩЕНО\ntest.skipped\tПропущено тестів: {0}\ntest.starting\tПочаток тестів {0}\ntest.summary\tТести завершено: успішно {0}, з помилками {1}");
    kaesu string.builder_string(output);
}

waza text_vi_vn() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tkhông tải được phần phụ thuộc: {0}\nbunko.missing\tChưa cài đặt Bunko. Dùng --bunko-root hoặc MIO_BUNKO để nhập {0}.\nbunko.package_read\tkhông đọc được gói: {0}\nbunko.root_layout\tcần thư mục Bunko chứa kiso/: {0}\nbunko.root_resolve\tkhông xác định được đường dẫn thực của thư mục: {0}\ncheck.passed\tkiểm tra đạt\ncli.lsp_unknown\tđối số lsp không xác định: {0}\ncmd.build\tTạo tệp thực thi gốc hoặc mã byte Mochi từ mã nguồn Mio\ncmd.check\tPhân tích mã nguồn Mio mà không tạo đầu ra\ncmd.disasm\tDịch ngược chương trình Mochi đã biên dịch\ncmd.exec\tChạy chương trình Mochi đã biên dịch\ncmd.fmt\tĐịnh dạng tệp mã nguồn Mio.\ncmd.help\tHiển thị trợ giúp cho Mio hoặc một lệnh\ncmd.lint\tKiểm tra các vấn đề thường gặp trong mã nguồn Mio.\ncmd.lsp\tKhởi động máy chủ ngôn ngữ Mio qua đầu vào/đầu ra chuẩn\ncmd.run\tTạo và chạy chương trình Mio từ mã nguồn\ncmd.test\tTìm và chạy các gói kiểm thử Mio\ncmd.version\tHiển thị thông tin phiên bản\ndiag.cause\tnguyên nhân\ndiag.error\tlỗi");
    string.write_string(output, "\ndiag.expected_actual\tmong đợi {0}, nhận được {1}\ndiag.lexical\tkhông nhận ra văn bản nguồn\ndiag.note\tghi chú\ndiag.suggestion\tgợi ý\ndiag.warning\tcảnh báo\nerr.analysis\tphân tích mã nguồn thất bại\nerr.bunko_empty\tđường dẫn Bunko thay thế phải rõ ràng và không rỗng\nerr.chmod_native\tkhông thể làm cho đầu ra gốc có thể thực thi\nerr.cleanup\tdọn dẹp sau khi chạy thất bại\nerr.create_run_dir\tkhông thể tạo thư mục chạy riêng\nerr.emit_mochi\tlệnh này không thể phát mã byte Mochi\nerr.empty_paths\tđường dẫn nguồn và đầu ra không được rỗng\nerr.gc_stress\t--gc-stress chỉ áp dụng cho bản dựng gốc từ mã nguồn\nerr.help_args\thelp nhận tối đa một tên lệnh\nerr.help_unknown\tkhông có trợ giúp cho lệnh không xác định: {0}\nerr.host_target\trun và exec yêu cầu đích máy chủ {0}\nerr.invalid_color\tchế độ màu không hợp lệ: {0} (mong đợi auto, always hoặc never)\nerr.invalid_format\tđịnh dạng không hợp lệ: {0} (mong đợi human, short hoặc json)\nerr.invalid_theme\tchủ đề không hợp lệ: {0} (mong đợi auto, dark hoặc light)\nerr.missing_value\tthiếu giá trị cho tùy chọn {0}");
    string.write_string(output, "\nerr.multiple_entries\tchỉ có thể cung cấp một mục mã nguồn\nerr.observe\t--observe chỉ áp dụng cho bản dựng gốc darwin-arm64 từ mã nguồn\nerr.open_stream\tkhông thể mở {0}\nerr.program_args\tđối số chương trình yêu cầu run hoặc exec\nerr.protect_run_dir\tkhông thể bảo vệ thư mục chạy riêng\nerr.read_mochi\tkhông thể đọc đầu vào Mochi\nerr.run_output\trun và exec tự quản lý đầu ra gốc của chúng\nerr.spawn\tkhông thể khởi chạy chương trình gốc\nerr.symbols\t--emit-symbols chỉ áp dụng cho bản dựng gốc darwin-arm64 từ mã nguồn\nerr.target\tđích không được hỗ trợ: {0} (mong đợi darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tlệnh không xác định: {0}\nerr.unknown_option\ttùy chọn không xác định: {0}\nerr.version_args\tlệnh version không nhận đối số\nerr.write_disasm\tkhông thể ghi bản dịch ngược\nerr.write_help\tkhông thể hiển thị trợ giúp\nerr.write_mochi\tkhông thể ghi đầu ra Mochi\nerr.write_native\tkhông thể ghi đầu ra gốc\nfmt.behavior\tThư mục được duyệt đệ quy. Dùng --stdin để đọc đầu vào chuẩn và --check để báo thay đổi mà không ghi tệp.\nfmt.status\tMã thoát: 0 thành công, 1 cần thay đổi ở chế độ --check, 2 lỗi sử dụng, phân tích cú pháp hoặc vào/ra.\nhelp.commands\tLệnh");
    string.write_string(output, "\nhelp.examples\tVí dụ\nhelp.group.compilation\tBiên dịch\nhelp.group.diagnostics\tChẩn đoán\nhelp.group.execution\tThực thi\nhelp.group.general\tChung\nhelp.group.testing\tKiểm thử\nhelp.group.tools\tCông cụ phát triển\nhelp.more\tChạy 'mio help <lệnh>' để xem chi tiết của một lệnh.\nhelp.options\tTùy chọn\nhelp.tagline\tTrình biên dịch Native AOT và bộ công cụ cho ngôn ngữ Mio\nhelp.title\tMio {0}\nhelp.usage\tCách dùng\nlint.behavior\tDùng --list-rules để xem quy tắc và --deny-warnings để báo thất bại khi có cảnh báo. Mã nguồn phải vượt qua các bước kiểm tra của trình biên dịch trước.\nlint.constant_condition\tĐiều kiện luôn đúng hoặc luôn sai\nlint.finding_if\tđiều kiện moshi luôn có giá trị {0}\nlint.finding_import\tlệnh nhập {0} (gói {1}) không được dùng\nlint.finding_loop\tđiều kiện aida luôn có giá trị iie nên thân vòng lặp không bao giờ chạy\nlint.finding_unreachable\tkhông thể chạy đến mã sau {0}\nlint.finding_variable\tbiến {0} được khai báo nhưng không được dùng\nlint.status\tMã thoát: 0 thành công, 1 có cảnh báo khi dùng --deny-warnings, 2 lỗi sử dụng hoặc biên dịch.");
    string.write_string(output, "\nlint.unreachable_code\tCâu lệnh sau khi chuyển điều khiển vô điều kiện\nlint.unused_import\tLệnh nhập gói không được dùng\nlint.unused_variable\tBiến cục bộ không được dùng (trừ tên bắt đầu bằng _)\nopt.bunko\tDùng gốc Bunko này thay cho mặc định\nopt.color\tĐiều khiển đầu ra màu: auto, always hoặc never\nopt.emit\tPhát mã byte Mochi thay cho ảnh gốc\nopt.format\tChọn định dạng đầu ra: human, short hoặc json\nopt.gc_stress\tXây dựng với kiểm tra áp lực bộ thu gom rác mạnh\nopt.help\tHiển thị trợ giúp\nopt.lang\tChọn ngôn ngữ đầu ra bằng thẻ BCP 47, ví dụ ja-JP\nopt.observe\tGhi lại quan sát quá trình xây dựng gốc\nopt.output\tGhi đầu ra vào đường dẫn này\nopt.program_args\tChuyển các đối số còn lại cho chương trình\nopt.run_filter\tChỉ chạy các kiểm thử có tên khớp với biểu thức chính quy này\nopt.stdio\tDùng đầu vào và đầu ra chuẩn cho máy chủ ngôn ngữ\nopt.symbols\tGhi thông tin ký hiệu gốc vào tệp này\nopt.target\tXây dựng cho darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tChọn bảng màu ngữ nghĩa: auto, dark hoặc light\nopt.verbose\tBao gồm chi tiết chẩn đoán bổ sung\nopt.version\tHiển thị thông tin phiên bản");
    string.write_string(output, "\ntest.assertion\txác nhận thất bại\ntest.bunko_empty\tđường dẫn Bunko thay thế không được rỗng\ntest.bunko_missing\tthiếu giá trị cho --bunko-root\ntest.compile_failed\tbiên dịch thất bại\ntest.duration\ttổng thời lượng\ntest.empty_filter\tbộ lọc kiểm thử không được rỗng\ntest.empty_lang\tthẻ ngôn ngữ không được rỗng\ntest.fail\tKHÔNG ĐẠT\ntest.filter_invalid\tbộ lọc kiểm thử không hợp lệ: {0}\ntest.invalid_arg\tđối số kiểm thử không hợp lệ: {0}\ntest.invalid_signature\tchữ ký hàm kiểm thử không hợp lệ\ntest.io_clean_dir\tkhông thể dọn thư mục kiểm thử riêng\ntest.io_clean_image\tkhông thể dọn ảnh kiểm thử gốc\ntest.io_dir\tkhông thể tạo thư mục kiểm thử riêng\ntest.io_protect\tkhông thể bảo vệ thư mục kiểm thử riêng\ntest.missing_target\tthiếu đích kiểm thử\ntest.no_match\tkhông có kiểm thử nào khớp với --run={0}\ntest.none\tkhông tìm thấy kiểm thử\ntest.pass\tĐẠT\ntest.resource\tvượt giới hạn tài nguyên");
    string.write_string(output, "\ntest.runtime\tlỗi thời gian chạy\ntest.skip\tBỎ QUA\ntest.skipped\tKiểm thử bỏ qua: {0}\ntest.starting\tBắt đầu kiểm thử {0}\ntest.summary\tKiểm thử hoàn tất: {0} đạt, {1} không đạt");
    kaesu string.builder_string(output);
}

waza text_zh_cn() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\t无法加载依赖：{0}\nbunko.missing\t未安装 Bunko。请使用 --bunko-root 或 MIO_BUNKO 导入 {0}。\nbunko.package_read\t无法读取包：{0}\nbunko.root_layout\t需要包含 kiso/ 的 Bunko 目录：{0}\nbunko.root_resolve\t无法解析目录的实际路径：{0}\ncheck.passed\t检查通过\ncli.lsp_unknown\t未知的 lsp 参数：{0}\ncmd.build\t从 Mio 源码构建原生可执行文件或 Mochi 字节码\ncmd.check\t分析 Mio 源码但不产生输出\ncmd.disasm\t反汇编已编译的 Mochi 程序\ncmd.exec\t运行已编译的 Mochi 程序\ncmd.fmt\t格式化 Mio 源文件。\ncmd.help\t显示 Mio 或某个命令的帮助\ncmd.lint\t检查 Mio 源代码中的常见问题。\ncmd.lsp\t通过标准输入输出启动 Mio 语言服务器\ncmd.run\t从源码构建并运行 Mio 程序\ncmd.test\t发现并运行 Mio 测试包\ncmd.version\t显示版本信息\ndiag.cause\t原因\ndiag.error\t错误");
    string.write_string(output, "\ndiag.expected_actual\t期望 {0}，实际 {1}\ndiag.lexical\t无法识别的源文本\ndiag.note\t说明\ndiag.suggestion\t建议\ndiag.warning\t警告\nerr.analysis\t源码分析失败\nerr.bunko_empty\tBunko 覆盖路径必须明确且非空\nerr.chmod_native\t无法将原生输出设为可执行\nerr.cleanup\t运行清理失败\nerr.create_run_dir\t无法创建私有运行目录\nerr.emit_mochi\t此命令无法输出 Mochi 字节码\nerr.empty_paths\t源码路径和输出路径不能为空\nerr.gc_stress\t--gc-stress 仅适用于从源码进行原生构建\nerr.help_args\thelp 最多接受一个命令名\nerr.help_unknown\t未知命令没有帮助：{0}\nerr.host_target\trun 和 exec 需要主机目标 {0}\nerr.invalid_color\t无效颜色模式：{0}（应为 auto、always 或 never）\nerr.invalid_format\t无效格式：{0}（应为 human、short 或 json）\nerr.invalid_theme\t无效主题：{0}（应为 auto、dark 或 light）\nerr.missing_value\t选项 {0} 缺少值");
    string.write_string(output, "\nerr.multiple_entries\t只能提供一个源码条目\nerr.observe\t--observe 仅适用于从源码构建 darwin-arm64 原生映像\nerr.open_stream\t无法打开 {0}\nerr.program_args\t程序参数只能用于 run 或 exec\nerr.protect_run_dir\t无法保护私有运行目录\nerr.read_mochi\t无法读取 Mochi 输入\nerr.run_output\trun 和 exec 会自行管理原生输出\nerr.spawn\t无法启动原生程序\nerr.symbols\t--emit-symbols 仅适用于从源码构建 darwin-arm64 原生映像\nerr.target\t不支持的目标：{0}（应为 darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64）\nerr.unknown_command\t未知命令：{0}\nerr.unknown_option\t未知选项：{0}\nerr.version_args\tversion 命令不接受参数\nerr.write_disasm\t无法写入反汇编结果\nerr.write_help\t无法输出帮助\nerr.write_mochi\t无法写入 Mochi 输出\nerr.write_native\t无法写入原生输出\nfmt.behavior\t递归搜索目录。用 --stdin 读取标准输入，用 --check 报告需要格式化的文件而不写入。\nfmt.status\t退出码：0 成功，1 表示 --check 模式下需要格式化，2 表示用法、语法解析或输入输出错误。\nhelp.commands\t命令");
    string.write_string(output, "\nhelp.examples\t示例\nhelp.group.compilation\t编译\nhelp.group.diagnostics\t诊断\nhelp.group.execution\t执行\nhelp.group.general\t常规\nhelp.group.testing\t测试\nhelp.group.tools\t开发工具\nhelp.more\t运行 'mio help <命令>' 查看命令详情。\nhelp.options\t选项\nhelp.tagline\tMio 语言的 Native AOT 编译器与工具链\nhelp.title\tMio {0}\nhelp.usage\t用法\nlint.behavior\t用 --list-rules 显示规则，用 --deny-warnings 在有警告时返回失败。源代码必须先通过编译器检查。\nlint.constant_condition\t恒真或恒假的条件\nlint.finding_if\tmoshi 条件始终为 {0}\nlint.finding_import\t导入的 {0}（包 {1}）从未使用\nlint.finding_loop\taida 条件始终为 iie，循环体不会执行\nlint.finding_unreachable\t{0} 之后的代码不可达\nlint.finding_variable\t变量 {0} 已声明，但从未使用\nlint.status\t退出码：0 成功，1 表示启用 --deny-warnings 时有警告，2 表示用法或编译错误。");
    string.write_string(output, "\nlint.unreachable_code\t无条件转移控制流之后的语句\nlint.unused_import\t未使用的包导入\nlint.unused_variable\t未使用的局部变量（以 _ 开头的名称除外）\nopt.bunko\t使用指定的 Bunko 根目录而不是默认目录\nopt.color\t控制颜色输出：auto、always 或 never\nopt.emit\t输出 Mochi 字节码而不是原生映像\nopt.format\t选择输出格式：human、short 或 json\nopt.gc_stress\t构建时启用激进的垃圾回收压力检查\nopt.help\t显示帮助\nopt.lang\t按 BCP 47 标签选择输出语言，例如 ja-JP\nopt.observe\t记录原生构建观测数据\nopt.output\t将输出写入此路径\nopt.program_args\t将剩余参数传递给程序\nopt.run_filter\t只运行名称匹配此正则表达式的测试\nopt.stdio\t为语言服务器使用标准输入输出\nopt.symbols\t将原生符号信息写入此文件\nopt.target\t为 darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64 构建\nopt.theme\t选择语义配色方案：auto、dark 或 light\nopt.verbose\t输出额外的诊断细节\nopt.version\t显示版本信息");
    string.write_string(output, "\ntest.assertion\t断言失败\ntest.bunko_empty\tBunko 覆盖路径不能为空\ntest.bunko_missing\t--bunko-root 缺少值\ntest.compile_failed\t编译失败\ntest.duration\t总执行时间\ntest.empty_filter\t测试过滤器不能为空\ntest.empty_lang\t语言标签不能为空\ntest.fail\t失败\ntest.filter_invalid\t无效的测试过滤器：{0}\ntest.invalid_arg\t无效的测试参数：{0}\ntest.invalid_signature\t测试函数签名无效\ntest.io_clean_dir\t无法清理私有测试目录\ntest.io_clean_image\t无法清理原生测试映像\ntest.io_dir\t无法创建私有测试目录\ntest.io_protect\t无法保护私有测试目录\ntest.missing_target\t缺少测试目标\ntest.no_match\t没有匹配 --run={0} 的测试\ntest.none\t没有发现测试\ntest.pass\t通过\ntest.resource\t超出资源限制");
    string.write_string(output, "\ntest.runtime\t运行时错误\ntest.skip\t跳过\ntest.skipped\t跳过的测试：{0}\ntest.starting\t开始测试 {0}\ntest.summary\t测试完成：{0} 个通过，{1} 个失败");
    kaesu string.builder_string(output);
}

waza text_zh_hk() -> string {
