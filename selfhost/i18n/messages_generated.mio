    string.write_string(output, "\nbunko.dependency\t無法載入相依項目：{0}\nbunko.missing\t未安裝 Bunko。請使用 --bunko-root 或 MIO_BUNKO 匯入 {0}。\nbunko.package_read\t無法讀取套件：{0}\nbunko.root_layout\t需要包含 kiso/ 的 Bunko 目錄：{0}\nbunko.root_resolve\t無法解析目錄的實際路徑：{0}\ncheck.passed\t檢查通過\ncli.lsp_unknown\t未知的 lsp 參數：{0}\ncmd.build\t從 Mio 原始碼建立原生執行檔或 Mochi 位元組碼\ncmd.check\t分析 Mio 原始碼但不產生輸出\ncmd.disasm\t反組譯已編譯的 Mochi 程式\ncmd.exec\t執行已編譯的 Mochi 程式\ncmd.fmt\t格式化 Mio 原始碼檔案。\ncmd.help\t顯示 Mio 或單一指令的說明\ncmd.lint\t檢查 Mio 原始碼的常見問題。\ncmd.lsp\t透過標準輸入輸出啟動 Mio 語言伺服器\ncmd.run\t從原始碼建立並執行 Mio 程式\ncmd.test\t探索並執行 Mio 測試套件\ncmd.version\t顯示版本資料\ndiag.cause\t原因\ndiag.error\t錯誤");
    string.write_string(output, "\ndiag.expected_actual\t預期 {0}，實際為 {1}\ndiag.lexical\t無法識別的原始文字\ndiag.note\t說明\ndiag.suggestion\t建議\ndiag.warning\t警告\nerr.analysis\t原始碼分析失敗\nerr.bunko_empty\tBunko 覆寫路徑必須明確且非空\nerr.chmod_native\t無法將原生輸出設為可執行\nerr.cleanup\t執行清理失敗\nerr.create_run_dir\t無法建立私有執行目錄\nerr.emit_mochi\t此指令無法輸出 Mochi 位元組碼\nerr.empty_paths\t原始碼路徑和輸出路徑不能為空\nerr.gc_stress\t--gc-stress 僅適用於從原始碼進行原生建立\nerr.help_args\thelp 最多接受一個指令名稱\nerr.help_unknown\t未知指令沒有說明：{0}\nerr.host_target\trun 和 exec 需要主機目標 {0}\nerr.invalid_color\t無效顏色模式：{0}（應為 auto、always 或 never）\nerr.invalid_format\t無效格式：{0}（應為 human、short 或 json）\nerr.invalid_theme\t無效主題：{0}（應為 auto、dark 或 light）\nerr.missing_value\t選項 {0} 缺少值");
    string.write_string(output, "\nerr.multiple_entries\t只能提供一個原始碼項目\nerr.observe\t--observe 僅適用於從原始碼建立 darwin-arm64 原生映像\nerr.open_stream\t無法開啟 {0}\nerr.program_args\t程式參數只能用於 run 或 exec\nerr.protect_run_dir\t無法保護私有執行目錄\nerr.read_mochi\t無法讀取 Mochi 輸入\nerr.run_output\trun 和 exec 會自行管理原生輸出\nerr.spawn\t無法啟動原生程式\nerr.symbols\t--emit-symbols 僅適用於從原始碼建立 darwin-arm64 原生映像\nerr.target\t不支援的目標：{0}（應為 darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64）\nerr.unknown_command\t未知指令：{0}\nerr.unknown_option\t未知選項：{0}\nerr.version_args\tversion 指令不接受參數\nerr.write_disasm\t無法寫入反組譯結果\nerr.write_help\t無法輸出說明\nerr.write_mochi\t無法寫入 Mochi 輸出\nerr.write_native\t無法寫入原生輸出\nfmt.behavior\t遞迴搜尋目錄。用 --stdin 讀取標準輸入，用 --check 回報需要格式化的檔案而不寫入。\nfmt.status\t結束碼：0 成功，1 表示 --check 模式下需要格式化，2 表示用法、語法分析或輸入輸出錯誤。\nhelp.commands\t指令");
    string.write_string(output, "\nhelp.examples\t例子\nhelp.group.compilation\t編譯\nhelp.group.diagnostics\t診斷\nhelp.group.execution\t執行\nhelp.group.general\t一般\nhelp.group.testing\t測試\nhelp.group.tools\t開發工具\nhelp.more\t執行 'mio help <指令>' 以查看指令詳情。\nhelp.options\t選項\nhelp.tagline\tMio 語言的 Native AOT 編譯器與工具鏈\nhelp.title\tMio {0}\nhelp.usage\t用法\nlint.behavior\t用 --list-rules 顯示規則，用 --deny-warnings 在有警告時回傳失敗。原始碼必須先通過編譯器檢查。\nlint.constant_condition\t恆真或恆假的條件\nlint.finding_if\tmoshi 條件恆為 {0}\nlint.finding_import\t匯入的 {0}（套件 {1}）從未使用\nlint.finding_loop\taida 條件恆為 iie，迴圈本體不會執行\nlint.finding_unreachable\t無法到達 {0} 之後的程式碼\nlint.finding_variable\t變數 {0} 已宣告，但從未使用\nlint.status\t結束碼：0 成功，1 表示使用 --deny-warnings 時有警告，2 表示用法或編譯錯誤。");
    string.write_string(output, "\nlint.unreachable_code\t無條件轉移控制流程後的陳述式\nlint.unused_import\t未使用的套件匯入\nlint.unused_variable\t未使用的區域變數（以 _ 開頭的名稱除外）\nopt.bunko\t使用指定的 Bunko 根目錄而非預設目錄\nopt.color\t控制顏色輸出：auto、always 或 never\nopt.emit\t輸出 Mochi 位元組碼而非原生映像\nopt.format\t選擇輸出格式：human、short 或 json\nopt.gc_stress\t建立時啟用積極的垃圾回收壓力檢查\nopt.help\t顯示說明\nopt.lang\t按 BCP 47 標籤選擇輸出語言，例如 ja-JP\nopt.observe\t記錄原生建立觀測資料\nopt.output\t將輸出寫入此路徑\nopt.program_args\t將其餘參數傳遞給程式\nopt.run_filter\t只執行名稱符合此正規表示式的測試\nopt.stdio\t為語言伺服器使用標準輸入輸出\nopt.symbols\t將原生符號資料寫入此檔案\nopt.target\t為 darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64 建立\nopt.theme\t選擇語意配色：auto、dark 或 light\nopt.verbose\t輸出額外的診斷細節\nopt.version\t顯示版本資料");
    string.write_string(output, "\ntest.assertion\t斷言失敗\ntest.bunko_empty\tBunko 覆寫路徑不能為空\ntest.bunko_missing\t--bunko-root 缺少值\ntest.compile_failed\t編譯失敗\ntest.duration\t總執行時間\ntest.empty_filter\t測試篩選器不能為空\ntest.empty_lang\t語言標籤不能為空\ntest.fail\t失敗\ntest.filter_invalid\t無效的測試篩選器：{0}\ntest.invalid_arg\t無效的測試參數：{0}\ntest.invalid_signature\t測試函式簽章無效\ntest.io_clean_dir\t無法清理私有測試目錄\ntest.io_clean_image\t無法清理原生測試映像\ntest.io_dir\t無法建立私有測試目錄\ntest.io_protect\t無法保護私有測試目錄\ntest.missing_target\t缺少測試目標\ntest.no_match\t沒有符合 --run={0} 的測試\ntest.none\t找不到測試\ntest.pass\t通過\ntest.resource\t超出資源限制");
    string.write_string(output, "\ntest.runtime\t執行階段錯誤\ntest.skip\t略過\ntest.skipped\t略過的測試：{0}\ntest.starting\t開始測試 {0}\ntest.summary\t測試完成：{0} 個通過，{1} 個失敗");
    kaesu string.builder_string(output);
}

waza text_zh_tw() -> string {
    kaku output = string.new_builder();
