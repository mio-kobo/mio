    string.write_string(output, "\ntest.assertion\tassertie mislukt\ntest.bunko_empty\thet vervangende Bunko-pad mag niet leeg zijn\ntest.bunko_missing\twaarde ontbreekt voor --bunko-root\ntest.compile_failed\tcompilatie mislukt\ntest.duration\ttotale duur\ntest.empty_filter\thet testfilter mag niet leeg zijn\ntest.empty_lang\tde taaltag mag niet leeg zijn\ntest.fail\tMISLUKT\ntest.filter_invalid\tongeldig testfilter: {0}\ntest.invalid_arg\tongeldig testargument: {0}\ntest.invalid_signature\tongeldige signatuur van testfunctie\ntest.io_clean_dir\tkan de persoonlijke testmap niet opruimen\ntest.io_clean_image\tkan het native testimage niet opruimen\ntest.io_dir\tkan geen persoonlijke testmap aanmaken\ntest.io_protect\tkan de persoonlijke testmap niet beveiligen\ntest.missing_target\ttestdoel ontbreekt\ntest.no_match\tgeen tests komen overeen met --run={0}\ntest.none\tgeen tests gevonden\ntest.pass\tGESLAAGD\ntest.resource\tresourcelimiet overschreden");
