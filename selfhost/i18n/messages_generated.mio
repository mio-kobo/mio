    string.write_string(output, "\ntest.assertion\tasersi gagal\ntest.bunko_empty\tjalur pengganti Bunko tidak boleh kosong\ntest.bunko_missing\tnilai untuk --bunko-root tidak ada\ntest.compile_failed\tkompilasi gagal\ntest.duration\tdurasi total\ntest.empty_filter\tfilter pengujian tidak boleh kosong\ntest.empty_lang\ttag bahasa tidak boleh kosong\ntest.fail\tGAGAL\ntest.filter_invalid\tfilter pengujian tidak valid: {0}\ntest.invalid_arg\targumen pengujian tidak valid: {0}\ntest.invalid_signature\tsignatur fungsi pengujian tidak valid\ntest.io_clean_dir\ttidak dapat membersihkan direktori pengujian privat\ntest.io_clean_image\ttidak dapat membersihkan image pengujian native\ntest.io_dir\ttidak dapat membuat direktori pengujian privat\ntest.io_protect\ttidak dapat melindungi direktori pengujian privat\ntest.missing_target\ttarget pengujian tidak ada\ntest.no_match\ttidak ada pengujian yang cocok dengan --run={0}\ntest.none\ttidak ada pengujian ditemukan\ntest.pass\tLULUS\ntest.resource\tbatas sumber daya terlampaui");
