waza text_el_gr() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tαδυναμία φόρτωσης εξάρτησης: {0}\nbunko.missing\tΤο Bunko δεν είναι εγκατεστημένο. Χρησιμοποιήστε --bunko-root ή MIO_BUNKO για εισαγωγή του {0}.\nbunko.package_read\tαδυναμία ανάγνωσης πακέτου: {0}\nbunko.root_layout\tαναμενόταν κατάλογος Bunko που να περιέχει kiso/: {0}\nbunko.root_resolve\tδεν βρέθηκε η πραγματική διαδρομή του καταλόγου: {0}\ncheck.passed\tο έλεγχος πέρασε\ncli.lsp_unknown\tάγνωστο όρισμα lsp: {0}\ncmd.build\tΔημιουργία εγγενούς εκτελέσιμου ή bytecode Mochi από πηγαίο κώδικα Mio\ncmd.check\tΑνάλυση πηγαίου κώδικα Mio χωρίς παραγωγή εξόδου\ncmd.disasm\tΑποσυμβολισμός μεταγλωττισμένου προγράμματος Mochi\ncmd.exec\tΕκτέλεση μεταγλωττισμένου προγράμματος Mochi\ncmd.fmt\tΜορφοποιεί αρχεία πηγαίου κώδικα Mio.\ncmd.help\tΕμφάνιση βοήθειας για το Mio ή για μία εντολή\ncmd.lint\tΕλέγχει τον πηγαίο κώδικα Mio για συνηθισμένα προβλήματα.\ncmd.lsp\tΕκκίνηση διακομιστή γλώσσας Mio μέσω τυπικής εισόδου/εξόδου\ncmd.run\tΔημιουργία και εκτέλεση προγράμματος Mio από τον πηγαίο κώδικα\ncmd.test\tΕύρεση και εκτέλεση πακέτων δοκιμών Mio\ncmd.version\tΕμφάνιση πληροφοριών έκδοσης\ndiag.cause\tαιτία\ndiag.error\tσφάλμα");
    string.write_string(output, "\ndiag.expected_actual\tαναμενόταν {0}, βρέθηκε {1}\ndiag.lexical\tμη αναγνωρίσιμο κείμενο πηγαίου κώδικα\ndiag.note\tσημείωση\ndiag.suggestion\tπρόταση\ndiag.warning\tπροειδοποίηση\nerr.analysis\tη ανάλυση του πηγαίου κώδικα απέτυχε\nerr.bunko_empty\tη διαδρομή παράκαμψης Bunko πρέπει να είναι ρητή και μη κενή\nerr.chmod_native\tδεν είναι δυνατή η μετατροπή της εγγενούς εξόδου σε εκτελέσιμη\nerr.cleanup\tο καθαρισμός μετά την εκτέλεση απέτυχε\nerr.create_run_dir\tδεν είναι δυνατή η δημιουργία ιδιωτικού καταλόγου εκτέλεσης\nerr.emit_mochi\tαυτή η εντολή δεν μπορεί να παράγει bytecode Mochi\nerr.empty_paths\tοι διαδρομές πηγής και εξόδου δεν μπορούν να είναι κενές\nerr.gc_stress\tτο --gc-stress ισχύει μόνο για εγγενείς δημιουργίες από πηγαίο κώδικα\nerr.help_args\tη help δέχεται το πολύ ένα όνομα εντολής\nerr.help_unknown\tδεν υπάρχει βοήθεια για άγνωστη εντολή: {0}\nerr.host_target\tτα run και exec απαιτούν τον στόχο υπολογιστή {0}\nerr.invalid_color\tμη έγκυρη λειτουργία χρώματος: {0} (αναμένεται auto, always ή never)\nerr.invalid_format\tμη έγκυρη μορφή: {0} (αναμένεται human, short ή json)\nerr.invalid_theme\tμη έγκυρο θέμα: {0} (αναμένεται auto, dark ή light)\nerr.missing_value\tλείπει τιμή για την επιλογή {0}");
    string.write_string(output, "\nerr.multiple_entries\tμπορεί να δοθεί μόνο μία καταχώριση πηγής\nerr.observe\tτο --observe ισχύει μόνο για εγγενείς δημιουργίες darwin-arm64 από πηγαίο κώδικα\nerr.open_stream\tαδυναμία ανοίγματος του {0}\nerr.program_args\tτα ορίσματα προγράμματος απαιτούν run ή exec\nerr.protect_run_dir\tδεν είναι δυνατή η προστασία του ιδιωτικού καταλόγου εκτέλεσης\nerr.read_mochi\tδεν είναι δυνατή η ανάγνωση της εισόδου Mochi\nerr.run_output\tτα run και exec διαχειρίζονται τη δική τους εγγενή έξοδο\nerr.spawn\tδεν ήταν δυνατή η εκκίνηση του εγγενούς προγράμματος\nerr.symbols\tτο --emit-symbols ισχύει μόνο για εγγενείς δημιουργίες darwin-arm64 από πηγαίο κώδικα\nerr.target\tμη υποστηριζόμενος στόχος: {0} (αναμένεται darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tάγνωστη εντολή: {0}\nerr.unknown_option\tάγνωστη επιλογή: {0}\nerr.version_args\tη εντολή version δεν δέχεται ορίσματα\nerr.write_disasm\tδεν είναι δυνατή η εγγραφή του αποσυμβολισμού\nerr.write_help\tαδυναμία εγγραφής της βοήθειας\nerr.write_mochi\tδεν είναι δυνατή η εγγραφή της εξόδου Mochi\nerr.write_native\tδεν είναι δυνατή η εγγραφή της εγγενούς εξόδου\nfmt.behavior\tΟι κατάλογοι ελέγχονται αναδρομικά. Με --stdin διαβάζεται η τυπική είσοδος και με --check αναφέρονται αλλαγές χωρίς εγγραφή.\nfmt.status\tΚωδικός εξόδου: 0 επιτυχία, 1 απαιτούνται αλλαγές με --check, 2 σφάλμα χρήσης, ανάλυσης ή εισόδου/εξόδου.\nhelp.commands\tΕντολές");
    string.write_string(output, "\nhelp.examples\tΠαραδείγματα\nhelp.group.compilation\tΜεταγλώττιση\nhelp.group.diagnostics\tΔιάγνωση\nhelp.group.execution\tΕκτέλεση\nhelp.group.general\tΓενικά\nhelp.group.testing\tΔοκιμές\nhelp.group.tools\tΕργαλεία ανάπτυξης\nhelp.more\tΕκτελέστε 'mio help <εντολή>' για λεπτομέρειες μιας εντολής.\nhelp.options\tΕπιλογές\nhelp.tagline\tΜεταγλωττιστής Native AOT και εργαλειοθήκη για τη γλώσσα Mio\nhelp.title\tMio {0}\nhelp.usage\tΧρήση\nlint.behavior\tΜε --list-rules εμφανίζονται οι κανόνες και με --deny-warnings οι προειδοποιήσεις προκαλούν αποτυχία. Ο κώδικας πρέπει πρώτα να περάσει τους ελέγχους του μεταγλωττιστή.\nlint.constant_condition\tΣυνθήκη πάντα αληθής ή πάντα ψευδής\nlint.finding_if\tη συνθήκη moshi έχει πάντα τιμή {0}\nlint.finding_import\tη εισαγωγή {0} (πακέτο {1}) δεν χρησιμοποιείται ποτέ\nlint.finding_loop\tη συνθήκη aida είναι πάντα iie, οπότε το σώμα του βρόχου δεν εκτελείται ποτέ\nlint.finding_unreachable\tμη προσβάσιμος κώδικας μετά το {0}\nlint.finding_variable\tη μεταβλητή {0} δηλώνεται αλλά δεν χρησιμοποιείται ποτέ\nlint.status\tΚωδικός εξόδου: 0 επιτυχία, 1 προειδοποιήσεις με --deny-warnings, 2 σφάλμα χρήσης ή μεταγλώττισης.");
    string.write_string(output, "\nlint.unreachable_code\tΕντολή μετά από μεταφορά ελέγχου χωρίς συνθήκη\nlint.unused_import\tΑχρησιμοποίητη εισαγωγή πακέτου\nlint.unused_variable\tΑχρησιμοποίητη τοπική μεταβλητή (εκτός από ονόματα που αρχίζουν με _)\nopt.bunko\tΧρήση αυτής της ρίζας Bunko αντί της προεπιλεγμένης\nopt.color\tΈλεγχος έγχρωμης εξόδου: auto, always ή never\nopt.emit\tΠαραγωγή bytecode Mochi αντί για εγγενή εικόνα\nopt.format\tΕπιλογή μορφής εξόδου: human, short ή json\nopt.gc_stress\tΔημιουργία με έντονους ελέγχους φόρτου του συλλέκτη απορριμμάτων\nopt.help\tΕμφάνιση βοήθειας\nopt.lang\tΕπιλογή γλώσσας εξόδου με ετικέτα BCP 47, για παράδειγμα ja-JP\nopt.observe\tΚαταγραφή παρατηρήσεων της εγγενούς δημιουργίας\nopt.output\tΕγγραφή εξόδου σε αυτή τη διαδρομή\nopt.program_args\tΜεταβίβαση των υπόλοιπων ορισμάτων στο πρόγραμμα\nopt.run_filter\tΕκτέλεση μόνο δοκιμών των οποίων το όνομα ταιριάζει με αυτή την κανονική έκφραση\nopt.stdio\tΧρήση τυπικής εισόδου και εξόδου για τον διακομιστή γλώσσας\nopt.symbols\tΕγγραφή πληροφοριών εγγενών συμβόλων σε αυτό το αρχείο\nopt.target\tΔημιουργία για darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tΕπιλογή σημασιολογικής παλέτας: auto, dark ή light\nopt.verbose\tΣυμπερίληψη πρόσθετων λεπτομερειών διάγνωσης\nopt.version\tΕμφάνιση πληροφοριών έκδοσης");
    string.write_string(output, "\ntest.assertion\tη επαλήθευση απέτυχε\ntest.bunko_empty\tη διαδρομή παράκαμψης Bunko δεν μπορεί να είναι κενή\ntest.bunko_missing\tλείπει τιμή για το --bunko-root\ntest.compile_failed\tη μεταγλώττιση απέτυχε\ntest.duration\tσυνολική διάρκεια\ntest.empty_filter\tτο φίλτρο δοκιμών δεν μπορεί να είναι κενό\ntest.empty_lang\tη ετικέτα γλώσσας δεν μπορεί να είναι κενή\ntest.fail\tΑΠΟΤΥΧΙΑ\ntest.filter_invalid\tμη έγκυρο φίλτρο δοκιμών: {0}\ntest.invalid_arg\tμη έγκυρο όρισμα δοκιμής: {0}\ntest.invalid_signature\tμη έγκυρη υπογραφή συνάρτησης δοκιμής\ntest.io_clean_dir\tδεν είναι δυνατός ο καθαρισμός του ιδιωτικού καταλόγου δοκιμών\ntest.io_clean_image\tδεν είναι δυνατός ο καθαρισμός της εγγενούς εικόνας δοκιμής\ntest.io_dir\tδεν είναι δυνατή η δημιουργία ιδιωτικού καταλόγου δοκιμών\ntest.io_protect\tδεν είναι δυνατή η προστασία του ιδιωτικού καταλόγου δοκιμών\ntest.missing_target\tλείπει ο στόχος δοκιμών\ntest.no_match\tκαμία δοκιμή δεν ταιριάζει με --run={0}\ntest.none\tδεν βρέθηκαν δοκιμές\ntest.pass\tΕΠΙΤΥΧΙΑ\ntest.resource\tυπέρβαση ορίου πόρων");
    string.write_string(output, "\ntest.runtime\tσφάλμα χρόνου εκτέλεσης\ntest.skip\tΠΑΡΑΛΕΙΨΗ\ntest.skipped\tΠαραλειπόμενες δοκιμές: {0}\ntest.starting\tΈναρξη δοκιμών {0}\ntest.summary\tΟι δοκιμές ολοκληρώθηκαν: {0} επιτυχίες, {1} αποτυχίες");
    kaesu string.builder_string(output);
}

waza text_en_gb() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tcould not load dependency: {0}\nbunko.missing\tBunko is not installed; use --bunko-root or MIO_BUNKO to import {0}\nbunko.package_read\tread package: {0}\nbunko.root_layout\texpected a Bunko directory containing kiso/: {0}\nbunko.root_resolve\tcannot resolve directory: {0}\ncheck.passed\tcheck passed\ncli.lsp_unknown\tunknown lsp argument: {0}\ncmd.build\tBuild a native executable or Mochi bytecode from Mio source\ncmd.check\tAnalyse Mio source without producing output\ncmd.disasm\tDisassemble a compiled Mochi program\ncmd.exec\tRun a compiled Mochi program\ncmd.fmt\tFormat Mio source files.\ncmd.help\tShow help for Mio or for one command\ncmd.lint\tCheck Mio source for common problems.\ncmd.lsp\tStart the Mio language server over standard I/O\ncmd.run\tBuild and run a Mio program from source\ncmd.test\tDiscover and run Mio test packages\ncmd.version\tShow version information\ndiag.cause\tcause\ndiag.error\terror");
    string.write_string(output, "\ndiag.expected_actual\texpected {0}, got {1}\ndiag.lexical\tunrecognised source text\ndiag.note\tnote\ndiag.suggestion\tsuggestion\ndiag.warning\twarning\nerr.analysis\tsource analysis failed\nerr.bunko_empty\tthe Bunko override must be explicit and nonempty\nerr.chmod_native\tcannot make the native output executable\nerr.cleanup\trun cleanup failed\nerr.create_run_dir\tcannot create a private run directory\nerr.emit_mochi\tthis command cannot emit Mochi bytecode\nerr.empty_paths\tthe source and output paths must be nonempty\nerr.gc_stress\t--gc-stress applies only to native builds from source\nerr.help_args\thelp takes at most one command name\nerr.help_unknown\tno help for unknown command: {0}\nerr.host_target\trun and exec require the host target {0}\nerr.invalid_color\tinvalid colour mode: {0} (expected auto, always or never)\nerr.invalid_format\tinvalid format: {0} (expected human, short or json)\nerr.invalid_theme\tinvalid theme: {0} (expected auto, dark or light)\nerr.missing_value\tmissing value for option {0}");
    string.write_string(output, "\nerr.multiple_entries\tonly one source entry may be given\nerr.observe\t--observe applies only to darwin-arm64 native builds from source\nerr.open_stream\tcannot open {0}\nerr.program_args\tprogram arguments require run or exec\nerr.protect_run_dir\tcannot protect the private run directory\nerr.read_mochi\tcannot read the Mochi input\nerr.run_output\trun and exec manage their own native output\nerr.spawn\tthe native program could not be started\nerr.symbols\t--emit-symbols applies only to darwin-arm64 native builds from source\nerr.target\tunsupported target: {0} (expected darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tunknown command: {0}\nerr.unknown_option\tunknown option: {0}\nerr.version_args\tthe version command takes no arguments\nerr.write_disasm\tcannot write the disassembly\nerr.write_help\tcannot write help\nerr.write_mochi\tcannot write the Mochi output\nerr.write_native\tcannot write the native output\nfmt.behavior\tDirectories are searched recursively. Use --stdin to read standard input and --check to report changes without writing.\nfmt.status\tExit status: 0 success, 1 changes needed in --check mode, 2 usage, parsing or I/O error.\nhelp.commands\tCommands");
    string.write_string(output, "\nhelp.examples\tExamples\nhelp.group.compilation\tCompilation\nhelp.group.diagnostics\tDiagnostics\nhelp.group.execution\tExecution\nhelp.group.general\tGeneral\nhelp.group.testing\tTesting\nhelp.group.tools\tDevelopment tools\nhelp.more\tRun 'mio help <command>' for command details.\nhelp.options\tOptions\nhelp.tagline\tNative AOT compiler and toolchain for the Mio language\nhelp.title\tMio {0}\nhelp.usage\tUsage\nlint.behavior\tUse --list-rules to show rules and --deny-warnings to fail on warnings. The source must pass compilation checks first.\nlint.constant_condition\tCondition that is always true or false\nlint.finding_if\tmoshi condition is always {0}\nlint.finding_import\timport {0} (package {1}) is never used\nlint.finding_loop\taida condition is always iie; the loop body never runs\nlint.finding_unreachable\tunreachable code after {0}\nlint.finding_variable\tvariable {0} is declared but never used\nlint.status\tExit status: 0 success, 1 warnings with --deny-warnings, 2 usage or compiler error.");
    string.write_string(output, "\nlint.unreachable_code\tStatement after an unconditional transfer of control\nlint.unused_import\tUnused package import\nlint.unused_variable\tUnused local variable (except names starting with _)\nopt.bunko\tUse this Bunko root instead of the default\nopt.color\tControl colour output: auto, always or never\nopt.emit\tEmit Mochi bytecode instead of a native image\nopt.format\tSelect the output format: human, short or json\nopt.gc_stress\tBuild with aggressive garbage-collector stress checks\nopt.help\tShow help\nopt.lang\tSelect the output language by BCP 47 tag, for example ja-JP\nopt.observe\tRecord native build observations\nopt.output\tWrite output to this path\nopt.program_args\tPass the remaining arguments to the program\nopt.run_filter\tRun only tests whose names match this regular expression\nopt.stdio\tUse standard input and output for the language server\nopt.symbols\tWrite native symbol information to this file\nopt.target\tBuild for darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tSelect the semantic palette: auto, dark or light\nopt.verbose\tInclude additional diagnostic detail\nopt.version\tShow version information");
    string.write_string(output, "\ntest.assertion\tassertion failed\ntest.bunko_empty\tthe Bunko override must be nonempty\ntest.bunko_missing\tmissing value for --bunko-root\ntest.compile_failed\tcompilation failed\ntest.duration\ttotal duration\ntest.empty_filter\tthe test filter must be nonempty\ntest.empty_lang\tthe language tag must be nonempty\ntest.fail\tFAIL\ntest.filter_invalid\tinvalid test filter: {0}\ntest.invalid_arg\tinvalid test argument: {0}\ntest.invalid_signature\tinvalid test function signature\ntest.io_clean_dir\tcannot clean the private test directory\ntest.io_clean_image\tcannot clean the native test image\ntest.io_dir\tcannot create a private test directory\ntest.io_protect\tcannot protect the private test directory\ntest.missing_target\tmissing test target\ntest.no_match\tno tests matched --run={0}\ntest.none\tno tests found\ntest.pass\tPASS\ntest.resource\tresource limit exceeded");
    string.write_string(output, "\ntest.runtime\truntime error\ntest.skip\tSKIP\ntest.skipped\tTests skipped: {0}\ntest.starting\tStarting tests {0}\ntest.summary\tTests complete: {0} passed, {1} failed");
    kaesu string.builder_string(output);
}

