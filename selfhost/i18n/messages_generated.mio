    string.write_string(output, "\ntest.assertion\tpåstanden mislyktes\ntest.bunko_empty\tBunko-overstyringens bane kan ikke være tom\ntest.bunko_missing\tverdien mangler for --bunko-root\ntest.compile_failed\tkompileringen mislyktes\ntest.duration\ttotal varighet\ntest.empty_filter\ttestfilteret kan ikke være tomt\ntest.empty_lang\tspråktaggen kan ikke være tom\ntest.fail\tMISLYKTES\ntest.filter_invalid\tugyldig testfilter: {0}\ntest.invalid_arg\tugyldig testargument: {0}\ntest.invalid_signature\tugyldig signatur for testfunksjon\ntest.io_clean_dir\tkan ikke rydde den private testkatalogen\ntest.io_clean_image\tkan ikke rydde det native testbildet\ntest.io_dir\tkan ikke opprette en privat testkatalog\ntest.io_protect\tkan ikke beskytte den private testkatalogen\ntest.missing_target\ttestmålet mangler\ntest.no_match\tingen tester samsvarer med --run={0}\ntest.none\tingen tester funnet\ntest.pass\tBESTÅTT\ntest.resource\tressursgrensen er overskredet");
    string.write_string(output, "\ntest.runtime\tkjøretidsfeil\ntest.skip\tHOPPET OVER\ntest.skipped\tOverhoppede tester: {0}\ntest.starting\tStarter tester {0}\ntest.summary\tTester fullført: {0} bestått, {1} mislyktes");
    kaesu string.builder_string(output);
}

waza text_nl_nl() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tkan de afhankelijkheid niet laden: {0}\nbunko.missing\tBunko is niet geïnstalleerd. Gebruik --bunko-root of MIO_BUNKO om {0} te importeren.\nbunko.package_read\tkan het pakket niet lezen: {0}\nbunko.root_layout\teen Bunko-map met kiso/ werd verwacht: {0}\nbunko.root_resolve\tkan het werkelijke pad naar de map niet bepalen: {0}\ncheck.passed\tcontrole geslaagd\ncli.lsp_unknown\tonbekend lsp-argument: {0}\ncmd.build\tBouw een native uitvoerbaar bestand of Mochi-bytecode uit Mio-broncode\ncmd.check\tAnalyseer Mio-broncode zonder uitvoer te produceren\ncmd.disasm\tDisassembleer een gecompileerd Mochi-programma\ncmd.exec\tVoer een gecompileerd Mochi-programma uit\ncmd.fmt\tMaak Mio-bronbestanden op.\ncmd.help\tToon hulp voor Mio of voor één opdracht\ncmd.lint\tControleer Mio-broncode op veelvoorkomende problemen.\ncmd.lsp\tStart de Mio-taal server via standaard in- en uitvoer\ncmd.run\tBouw en voer een Mio-programma uit vanuit de broncode\ncmd.test\tVind en voer Mio-testpakketten uit\ncmd.version\tToon versie-informatie\ndiag.cause\toorzaak\ndiag.error\tfout");
