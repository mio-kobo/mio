waza text_fa_ir() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tبارگیری وابستگی ممکن نبود: {0}\nbunko.missing\tBunko نصب نشده است. برای درون‌ریزی {0} از --bunko-root یا MIO_BUNKO استفاده کنید.\nbunko.package_read\tخواندن بسته ممکن نبود: {0}\nbunko.root_layout\tپوشهٔ Bunko باید شامل kiso/ باشد: {0}\nbunko.root_resolve\tمسیر واقعی پوشه پیدا نشد: {0}\ncheck.passed\tبررسی موفق بود\ncli.lsp_unknown\tآرگومان lsp ناشناخته: {0}\ncmd.build\tساخت فایل اجرایی بومی یا بایت‌کد Mochi از کد Mio\ncmd.check\tتحلیل کد Mio بدون تولید خروجی\ncmd.disasm\tواسازی برنامه Mochi کامپایل‌شده\ncmd.exec\tاجرای برنامه Mochi کامپایل‌شده\ncmd.fmt\tپرونده‌های منبع Mio را قالب‌بندی کنید.\ncmd.help\tنمایش راهنما برای Mio یا یک دستور\ncmd.lint\tکد منبع Mio را برای مشکلات رایج بررسی کنید.\ncmd.lsp\tراه‌اندازی سرور زبان Mio روی ورودی/خروجی استاندارد\ncmd.run\tساخت و اجرای برنامه Mio از کد منبع\ncmd.test\tیافتن و اجرای بسته‌های آزمون Mio\ncmd.version\tنمایش اطلاعات نسخه\ndiag.cause\tعلت\ndiag.error\tخطا");
    string.write_string(output, "\ndiag.expected_actual\tمقدار مورد انتظار {0}، مقدار واقعی {1}\ndiag.lexical\tمتن منبع ناشناخته\ndiag.note\tیادداشت\ndiag.suggestion\tپیشنهاد\ndiag.warning\tهشدار\nerr.analysis\tتحلیل کد منبع ناموفق بود\nerr.bunko_empty\tمسیر جایگزین Bunko باید صریح و غیرخالی باشد\nerr.chmod_native\tاجرایی‌کردن خروجی بومی ممکن نیست\nerr.cleanup\tپاک‌سازی پس از اجرا ناموفق بود\nerr.create_run_dir\tساخت پوشه اجرای خصوصی ممکن نیست\nerr.emit_mochi\tاین دستور نمی‌تواند بایت‌کد Mochi تولید کند\nerr.empty_paths\tمسیرهای منبع و خروجی نباید خالی باشند\nerr.gc_stress\t--gc-stress فقط برای ساخت‌های بومی از کد منبع کاربرد دارد\nerr.help_args\thelp حداکثر یک نام دستور می‌پذیرد\nerr.help_unknown\tراهنمایی برای دستور ناشناخته وجود ندارد: {0}\nerr.host_target\trun و exec به هدف میزبان {0} نیاز دارند\nerr.invalid_color\tحالت رنگ نامعتبر: {0} (انتظار auto، always یا never)\nerr.invalid_format\tقالب نامعتبر: {0} (انتظار human، short یا json)\nerr.invalid_theme\tپوسته نامعتبر: {0} (انتظار auto، dark یا light)\nerr.missing_value\tمقدار گزینه {0} موجود نیست");
    string.write_string(output, "\nerr.multiple_entries\tفقط یک ورودی منبع می‌تواند داده شود\nerr.observe\t--observe فقط برای ساخت‌های بومی darwin-arm64 از کد منبع کاربرد دارد\nerr.open_stream\tباز کردن {0} ممکن نیست\nerr.program_args\tآرگومان‌های برنامه به run یا exec نیاز دارند\nerr.protect_run_dir\tمحافظت از پوشه اجرای خصوصی ممکن نیست\nerr.read_mochi\tخواندن ورودی Mochi ممکن نیست\nerr.run_output\trun و exec خروجی بومی خود را مدیریت می‌کنند\nerr.spawn\tبرنامه بومی راه‌اندازی نشد\nerr.symbols\t--emit-symbols فقط برای ساخت‌های بومی darwin-arm64 از کد منبع کاربرد دارد\nerr.target\tهدف پشتیبانی‌نشده: {0} (انتظار darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tدستور ناشناخته: {0}\nerr.unknown_option\tگزینه ناشناخته: {0}\nerr.version_args\tدستور version آرگومان نمی‌پذیرد\nerr.write_disasm\tنوشتن واسازی ممکن نیست\nerr.write_help\tنوشتن راهنما ممکن نیست\nerr.write_mochi\tنوشتن خروجی Mochi ممکن نیست\nerr.write_native\tنوشتن خروجی بومی ممکن نیست\nfmt.behavior\tپوشه‌ها به‌صورت بازگشتی جست‌وجو می‌شوند. برای خواندن ورودی استاندارد از --stdin و برای گزارش تغییرات بدون نوشتن از --check استفاده کنید.\nfmt.status\tوضعیت خروج: 0 موفقیت، 1 نیاز به تغییر در حالت --check، 2 خطای کاربرد، تجزیه یا ورودی و خروجی.\nhelp.commands\tدستورها");
    string.write_string(output, "\nhelp.examples\tمثال‌ها\nhelp.group.compilation\tکامپایل\nhelp.group.diagnostics\tعیب‌یابی\nhelp.group.execution\tاجرا\nhelp.group.general\tعمومی\nhelp.group.testing\tآزمون‌ها\nhelp.group.tools\tابزارهای توسعه\nhelp.more\tبرای جزئیات یک دستور 'mio help <دستور>' را اجرا کنید.\nhelp.options\tگزینه‌ها\nhelp.tagline\tکامپایلر Native AOT و زنجیره ابزار برای زبان Mio\nhelp.title\tMio {0}\nhelp.usage\tکاربرد\nlint.behavior\tبرای نمایش قواعد از --list-rules و برای شکست در صورت هشدار از --deny-warnings استفاده کنید. کد ابتدا باید بررسی‌های کامپایلر را بگذراند.\nlint.constant_condition\tشرط همیشه درست یا همیشه نادرست\nlint.finding_if\tشرط moshi همیشه {0} است\nlint.finding_import\tدرون‌ریزی {0} (بستهٔ {1}) هرگز استفاده نمی‌شود\nlint.finding_loop\tشرط aida همیشه iie است و بدنهٔ حلقه هرگز اجرا نمی‌شود\nlint.finding_unreachable\tکد پس از {0} دسترس‌ناپذیر است\nlint.finding_variable\tمتغیر {0} اعلان شده اما هرگز استفاده نمی‌شود\nlint.status\tوضعیت خروج: 0 موفقیت، 1 هشدار با --deny-warnings، 2 خطای کاربرد یا کامپایل.");
    string.write_string(output, "\nlint.unreachable_code\tدستور بعد از انتقال بی‌قیدوشرط کنترل\nlint.unused_import\tدرون‌ریزی بستهٔ استفاده‌نشده\nlint.unused_variable\tمتغیر محلی استفاده‌نشده (به‌جز نام‌هایی که با _ شروع می‌شوند)\nopt.bunko\tاستفاده از این ریشه Bunko به‌جای پیش‌فرض\nopt.color\tکنترل خروجی رنگی: auto، always یا never\nopt.emit\tتولید بایت‌کد Mochi به‌جای تصویر بومی\nopt.format\tانتخاب قالب خروجی: human، short یا json\nopt.gc_stress\tساخت با بررسی‌های فشار تهاجمی جمع‌کننده زباله\nopt.help\tنمایش راهنما\nopt.lang\tانتخاب زبان خروجی با برچسب BCP 47، مثلاً ja-JP\nopt.observe\tثبت مشاهدات ساخت بومی\nopt.output\tنوشتن خروجی در این مسیر\nopt.program_args\tانتقال آرگومان‌های باقی‌مانده به برنامه\nopt.run_filter\tفقط آزمون‌هایی را اجرا کن که نامشان با این عبارت باقاعده مطابقت دارد\nopt.stdio\tاستفاده از ورودی و خروجی استاندارد برای سرور زبان\nopt.symbols\tنوشتن اطلاعات نمادهای بومی در این فایل\nopt.target\tساخت برای darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tانتخاب پالت معنایی: auto، dark یا light\nopt.verbose\tنمایش جزئیات بیشتر عیب‌یابی\nopt.version\tنمایش اطلاعات نسخه");
    string.write_string(output, "\ntest.assertion\tشکست بررسی\ntest.bunko_empty\tمسیر جایگزین Bunko نباید خالی باشد\ntest.bunko_missing\tمقدار --bunko-root موجود نیست\ntest.compile_failed\tکامپایل ناموفق بود\ntest.duration\tمدت کل\ntest.empty_filter\tفیلتر آزمون نباید خالی باشد\ntest.empty_lang\tبرچسب زبان نباید خالی باشد\ntest.fail\tناموفق\ntest.filter_invalid\tفیلتر آزمون نامعتبر: {0}\ntest.invalid_arg\tآرگومان آزمون نامعتبر: {0}\ntest.invalid_signature\tامضای تابع آزمون نامعتبر است\ntest.io_clean_dir\tپاک‌سازی پوشه آزمون خصوصی ممکن نیست\ntest.io_clean_image\tپاک‌سازی تصویر آزمون بومی ممکن نیست\ntest.io_dir\tساخت پوشه آزمون خصوصی ممکن نیست\ntest.io_protect\tمحافظت از پوشه آزمون خصوصی ممکن نیست\ntest.missing_target\tهدف آزمون موجود نیست\ntest.no_match\tهیچ آزمونی با --run={0} مطابقت ندارد\ntest.none\tآزمونی یافت نشد\ntest.pass\tموفق\ntest.resource\tعبور از محدودیت منابع");
    string.write_string(output, "\ntest.runtime\tخطای زمان اجرا\ntest.skip\tردشده\ntest.skipped\tآزمون‌های ردشده: {0}\ntest.starting\tآغاز آزمون‌ها {0}\ntest.summary\tآزمون‌ها تمام شد: {0} موفق، {1} ناموفق");
    kaesu string.builder_string(output);
}

waza text_fi_fi() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\triippuvuutta ei voitu ladata: {0}\nbunko.missing\tBunko ei ole asennettuna. Tuo {0} valinnalla --bunko-root tai muuttujalla MIO_BUNKO.\nbunko.package_read\tpakettia ei voitu lukea: {0}\nbunko.root_layout\todotettiin Bunko-hakemistoa, jossa on kiso/: {0}\nbunko.root_resolve\thakemiston todellista polkua ei voi selvittää: {0}\ncheck.passed\ttarkistus hyväksytty\ncli.lsp_unknown\ttuntematon lsp-argumentti: {0}\ncmd.build\tRakenna natiivi suoritettava tiedosto tai Mochi-tavukoodi Mio-lähteestä\ncmd.check\tAnalysoi Mio-lähde tuottamatta tulostetta\ncmd.disasm\tPura käännetty Mochi-ohjelma\ncmd.exec\tSuorita käännetty Mochi-ohjelma\ncmd.fmt\tMuotoile Mio-lähdetiedostot.\ncmd.help\tNäytä Mion tai yhden komennon ohje\ncmd.lint\tEtsi Mio-lähdekoodista tavallisia ongelmia.\ncmd.lsp\tKäynnistä Mio-kielipalvelin vakio-syötön ja -tulosteen kautta\ncmd.run\tRakenna ja suorita Mio-ohjelma lähteestä\ncmd.test\tEtsi ja suorita Mio-testipaketit\ncmd.version\tNäytä versiotiedot\ndiag.cause\tsyy\ndiag.error\tvirhe");
    string.write_string(output, "\ndiag.expected_actual\todotettiin arvoa {0}, saatiin {1}\ndiag.lexical\tlähdetekstiä ei tunnistettu\ndiag.note\thuomautus\ndiag.suggestion\tehdotus\ndiag.warning\tvaroitus\nerr.analysis\tlähdeanalyysi epäonnistui\nerr.bunko_empty\tBunko-ohituksen polun on oltava selkeä eikä tyhjä\nerr.chmod_native\tnatiivista tulosteesta ei voi tehdä suoritettavaa\nerr.cleanup\tsuorituksen jälkeinen siivous epäonnistui\nerr.create_run_dir\tyksityistä suorituskansiota ei voi luoda\nerr.emit_mochi\ttämä komento ei voi tuottaa Mochi-tavukoodia\nerr.empty_paths\tlähde- ja tulostepolut eivät voi olla tyhjiä\nerr.gc_stress\t--gc-stress koskee vain lähteestä tehtäviä natiiveja käännöksiä\nerr.help_args\thelp hyväksyy enintään yhden komennon nimen\nerr.help_unknown\ttuntemattomalle komennolle ei ole ohjetta: {0}\nerr.host_target\trun ja exec vaativat isäntäkohteen {0}\nerr.invalid_color\tvirheellinen väritila: {0} (odotettiin auto, always tai never)\nerr.invalid_format\tvirheellinen muoto: {0} (odotettiin human, short tai json)\nerr.invalid_theme\tvirheellinen teema: {0} (odotettiin auto, dark tai light)\nerr.missing_value\tvalinnan {0} arvo puuttuu");
    string.write_string(output, "\nerr.multiple_entries\tvain yksi lähdemerkintä voidaan antaa\nerr.observe\t--observe koskee vain lähteestä tehtäviä natiiveja darwin-arm64-käännöksiä\nerr.open_stream\tkohdetta {0} ei voi avata\nerr.program_args\tohjelma-argumentit vaativat run- tai exec-komennon\nerr.protect_run_dir\tyksityistä suorituskansiota ei voi suojata\nerr.read_mochi\tMochi-syötettä ei voi lukea\nerr.run_output\trun ja exec hallinnoivat omaa natiivia tulostettaan\nerr.spawn\tnatiivia ohjelmaa ei voitu käynnistää\nerr.symbols\t--emit-symbols koskee vain lähteestä tehtäviä natiiveja darwin-arm64-käännöksiä\nerr.target\tkohdetta ei tueta: {0} (odotettiin darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\ttuntematon komento: {0}\nerr.unknown_option\ttuntematon valinta: {0}\nerr.version_args\tversion-komento ei hyväksy argumentteja\nerr.write_disasm\tpurkutulostetta ei voi kirjoittaa\nerr.write_help\tohjetta ei voi tulostaa\nerr.write_mochi\tMochi-tulostetta ei voi kirjoittaa\nerr.write_native\tnatiivia tulostetta ei voi kirjoittaa\nfmt.behavior\tHakemistot tutkitaan rekursiivisesti. --stdin lukee vakiosyötteestä ja --check ilmoittaa muutoksista kirjoittamatta niitä.\nfmt.status\tPoistumiskoodi: 0 onnistui, 1 muutoksia tarvitaan tilassa --check, 2 käyttö-, jäsennys- tai I/O-virhe.\nhelp.commands\tKomennot");
    string.write_string(output, "\nhelp.examples\tEsimerkit\nhelp.group.compilation\tKäännös\nhelp.group.diagnostics\tDiagnostiikka\nhelp.group.execution\tSuoritus\nhelp.group.general\tYleiset\nhelp.group.testing\tTestit\nhelp.group.tools\tKehitystyökalut\nhelp.more\tSuorita 'mio help <komento>' nähdäksesi komennon tiedot.\nhelp.options\tValinnat\nhelp.tagline\tNative AOT -kääntäjä ja työkaluketju Mio-kielelle\nhelp.title\tMio {0}\nhelp.usage\tKäyttö\nlint.behavior\t--list-rules näyttää säännöt ja --deny-warnings aiheuttaa epäonnistumisen varoituksista. Lähdekoodin on ensin läpäistävä kääntäjän tarkistukset.\nlint.constant_condition\tAina tosi tai aina epätosi ehto\nlint.finding_if\tmoshi-ehdon arvo on aina {0}\nlint.finding_import\ttuontia {0} (paketti {1}) ei käytetä\nlint.finding_loop\taida-ehdon arvo on aina iie, joten silmukan runkoa ei suoriteta\nlint.finding_unreachable\tkohdan {0} jälkeiseen koodiin ei päästä\nlint.finding_variable\tmuuttuja {0} on määritelty, mutta sitä ei käytetä\nlint.status\tPoistumiskoodi: 0 onnistui, 1 varoituksia tilassa --deny-warnings, 2 käyttö- tai käännösvirhe.");
    string.write_string(output, "\nlint.unreachable_code\tLause ehdottoman ohjauksensiirron jälkeen\nlint.unused_import\tKäyttämätön pakettituonti\nlint.unused_variable\tKäyttämätön paikallinen muuttuja (paitsi merkillä _ alkavat nimet)\nopt.bunko\tKäytä tätä Bunko-juurta oletuksen sijaan\nopt.color\tSäädä väritulostetta: auto, always tai never\nopt.emit\tTuota Mochi-tavukoodia natiivin kuvan sijaan\nopt.format\tValitse tulostemuoto: human, short tai json\nopt.gc_stress\tRakenna roskienkerääjän aggressiivisilla rasitustarkistuksilla\nopt.help\tNäytä ohje\nopt.lang\tValitse tulosteen kieli BCP 47 -tunnisteella, esimerkiksi ja-JP\nopt.observe\tTallenna natiivin käännöksen havainnot\nopt.output\tKirjoita tuloste tähän polkuun\nopt.program_args\tVälitä loput argumentit ohjelmalle\nopt.run_filter\tSuorita vain testit, joiden nimi vastaa tätä säännöllistä lauseketta\nopt.stdio\tKäytä vakiosyöttöä ja -tulostetta kielipalvelimelle\nopt.symbols\tKirjoita natiivit symbolitiedot tähän tiedostoon\nopt.target\tRakenna kohteelle darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tValitse semanttinen väripaletti: auto, dark tai light\nopt.verbose\tSisällytä lisää diagnostiikkatietoja\nopt.version\tNäytä versiotiedot");
    string.write_string(output, "\ntest.assertion\tväite epäonnistui\ntest.bunko_empty\tBunko-ohituksen polku ei voi olla tyhjä\ntest.bunko_missing\t--bunko-root: arvo puuttuu\ntest.compile_failed\tkäännös epäonnistui\ntest.duration\tkokonaiskesto\ntest.empty_filter\ttestisuodatin ei voi olla tyhjä\ntest.empty_lang\tkielitunniste ei voi olla tyhjä\ntest.fail\tEPÄONNISTUI\ntest.filter_invalid\tvirheellinen testisuodatin: {0}\ntest.invalid_arg\tvirheellinen testiargumentti: {0}\ntest.invalid_signature\ttestifunktion allekirjoitus on virheellinen\ntest.io_clean_dir\tyksityistä testikansiota ei voi siivota\ntest.io_clean_image\tnatiivia testikuvaa ei voi siivota\ntest.io_dir\tyksityistä testikansiota ei voi luoda\ntest.io_protect\tyksityistä testikansiota ei voi suojata\ntest.missing_target\ttestikohde puuttuu\ntest.no_match\tyksikään testi ei vastaa --run={0}\ntest.none\ttestejä ei löytynyt\ntest.pass\tHYVÄKSYTTY\ntest.resource\tresurssiraja ylittyi");
    string.write_string(output, "\ntest.runtime\tajonaikainen virhe\ntest.skip\tOHITETTU\ntest.skipped\tOhitetut testit: {0}\ntest.starting\tAloitetaan testit {0}\ntest.summary\tTestit valmiit: {0} hyväksytty, {1} epäonnistui");
    kaesu string.builder_string(output);
}

waza text_fil_ph() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\thindi ma-load ang dependency: {0}\nbunko.missing\tHindi naka-install ang Bunko. Gamitin ang --bunko-root o MIO_BUNKO para i-import ang {0}.\nbunko.package_read\thindi mabasa ang package: {0}\nbunko.root_layout\tdapat naglalaman ng kiso/ ang direktoryo ng Bunko: {0}\nbunko.root_resolve\thindi matukoy ang aktuwal na path ng direktoryo: {0}\ncheck.passed\tpumasa ang pagsusuri\ncli.lsp_unknown\thindi kilalang lsp argument: {0}\ncmd.build\tBumuo ng native executable o Mochi bytecode mula sa Mio source\ncmd.check\tSuriin ang Mio source nang walang output\ncmd.disasm\tI-disassemble ang naka-compile na Mochi program\ncmd.exec\tPatakbuhin ang naka-compile na Mochi program\ncmd.fmt\tAyusin ang pormat ng mga source file ng Mio.\ncmd.help\tIpakita ang tulong para sa Mio o sa isang utos\ncmd.lint\tSuriin ang source ng Mio para sa mga karaniwang problema.\ncmd.lsp\tSimulan ang Mio language server sa standard input/output\ncmd.run\tBumuo at patakbuhin ang Mio program mula sa source\ncmd.test\tHanapin at patakbuhin ang mga Mio test package\ncmd.version\tIpakita ang impormasyon ng bersyon\ndiag.cause\tsanhi\ndiag.error\tkamalian");
    string.write_string(output, "\ndiag.expected_actual\tinaasahan ang {0}, nakuha ang {1}\ndiag.lexical\thindi nakilalang source text\ndiag.note\ttala\ndiag.suggestion\tmungkahi\ndiag.warning\tbabala\nerr.analysis\tnabigo ang pagsusuri ng source\nerr.bunko_empty\tdapat tahasan at hindi walang laman ang Bunko override path\nerr.chmod_native\thindi magawang executable ang native output\nerr.cleanup\tnabigo ang paglilinis pagkatapos patakbuhin\nerr.create_run_dir\thindi makagawa ng pribadong run directory\nerr.emit_mochi\thindi makakapaglabas ng Mochi bytecode ang utos na ito\nerr.empty_paths\thindi maaaring walang laman ang source at output path\nerr.gc_stress\t--gc-stress ay para lamang sa native build mula sa source\nerr.help_args\ttumatanggap ng hindi hihigit sa isang pangalan ng utos ang help\nerr.help_unknown\twalang tulong para sa hindi kilalang utos: {0}\nerr.host_target\tkailangan ng run at exec ang host target na {0}\nerr.invalid_color\tdi-wastong color mode: {0} (inaasahan ang auto, always o never)\nerr.invalid_format\tdi-wastong format: {0} (inaasahan ang human, short o json)\nerr.invalid_theme\tdi-wastong tema: {0} (inaasahan ang auto, dark o light)\nerr.missing_value\tkulang ang halaga para sa opsyong {0}");
    string.write_string(output, "\nerr.multiple_entries\tisang source entry lamang ang maaaring ibigay\nerr.observe\t--observe ay para lamang sa native darwin-arm64 build mula sa source\nerr.open_stream\thindi mabuksan ang {0}\nerr.program_args\tkailangan ng run o exec ang mga argumento ng program\nerr.protect_run_dir\thindi maprotektahan ang pribadong run directory\nerr.read_mochi\thindi mabasa ang Mochi input\nerr.run_output\tpinamamahalaan ng run at exec ang sarili nilang native output\nerr.spawn\thindi masimulan ang native program\nerr.symbols\t--emit-symbols ay para lamang sa native darwin-arm64 build mula sa source\nerr.target\thindi suportadong target: {0} (inaasahan ang darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\thindi kilalang utos: {0}\nerr.unknown_option\thindi kilalang opsyon: {0}\nerr.version_args\thindi tumatanggap ng argumento ang utos na version\nerr.write_disasm\thindi maisulat ang disassembly\nerr.write_help\thindi maisulat ang tulong\nerr.write_mochi\thindi maisulat ang Mochi output\nerr.write_native\thindi maisulat ang native output\nfmt.behavior\tSinusuri ang mga direktoryo pati ang mga subdirectory. Gamitin ang --stdin para basahin ang standard input at --check para iulat ang pagbabago nang walang isinusulat.\nfmt.status\tExit status: 0 matagumpay, 1 may kailangang baguhin sa --check, 2 may problema sa paggamit, pag-parse o I/O.\nhelp.commands\tMga utos");
    string.write_string(output, "\nhelp.examples\tMga halimbawa\nhelp.group.compilation\tPag-compile\nhelp.group.diagnostics\tDiagnostics\nhelp.group.execution\tPagpapatupad\nhelp.group.general\tPangkalahatan\nhelp.group.testing\tPagsubok\nhelp.group.tools\tMga tool sa pag-develop\nhelp.more\tPatakbuhin ang 'mio help <utos>' para sa detalye ng isang utos.\nhelp.options\tMga opsyon\nhelp.tagline\tNative AOT compiler at toolchain para sa wikang Mio\nhelp.title\tMio {0}\nhelp.usage\tPaggamit\nlint.behavior\tGamitin ang --list-rules para makita ang mga panuntunan at --deny-warnings para ituring na kabiguan ang babala. Kailangang pumasa muna ang source sa mga pagsusuri ng compiler.\nlint.constant_condition\tKondisyong laging totoo o laging mali\nlint.finding_if\tlaging {0} ang kondisyon ng moshi\nlint.finding_import\thindi ginagamit ang import na {0} (package na {1})\nlint.finding_loop\tlaging iie ang kondisyon ng aida kaya hindi tumatakbo ang katawan ng loop\nlint.finding_unreachable\thindi maaabot ang code pagkatapos ng {0}\nlint.finding_variable\tidineklara ang variable na {0} pero hindi ito ginagamit\nlint.status\tExit status: 0 matagumpay, 1 may babala sa --deny-warnings, 2 may problema sa paggamit o compiler.");
    string.write_string(output, "\nlint.unreachable_code\tPahayag pagkatapos ng paglilipat ng kontrol na walang kondisyon\nlint.unused_import\tHindi ginagamit na pag-import ng package\nlint.unused_variable\tHindi ginagamit na lokal na variable (maliban sa pangalang nagsisimula sa _)\nopt.bunko\tGamitin ang Bunko root na ito sa halip na default\nopt.color\tKontrolin ang kulay ng output: auto, always o never\nopt.emit\tMaglabas ng Mochi bytecode sa halip na native image\nopt.format\tPiliin ang format ng output: human, short o json\nopt.gc_stress\tBumuo nang may agresibong garbage-collector stress check\nopt.help\tIpakita ang tulong\nopt.lang\tPiliin ang wikang output gamit ang BCP 47 tag, halimbawa ja-JP\nopt.observe\tItala ang mga obserbasyon sa native build\nopt.output\tIsulat ang output sa path na ito\nopt.program_args\tIpasa ang natitirang argumento sa program\nopt.run_filter\tPatakbuhin lamang ang mga test na tumutugma ang pangalan sa regular expression na ito\nopt.stdio\tGamitin ang standard input at output para sa language server\nopt.symbols\tIsulat ang native symbol information sa file na ito\nopt.target\tBumuo para sa darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tPiliin ang semantic palette: auto, dark o light\nopt.verbose\tIsama ang karagdagang detalye ng diagnostics\nopt.version\tIpakita ang impormasyon ng bersyon");
    string.write_string(output, "\ntest.assertion\tbigo ang assertion\ntest.bunko_empty\thindi maaaring walang laman ang Bunko override path\ntest.bunko_missing\tkulang ang halaga para sa --bunko-root\ntest.compile_failed\tnabigo ang pag-compile\ntest.duration\tkabuuang tagal\ntest.empty_filter\thindi maaaring walang laman ang test filter\ntest.empty_lang\thindi maaaring walang laman ang language tag\ntest.fail\tBIGO\ntest.filter_invalid\tdi-wastong test filter: {0}\ntest.invalid_arg\tdi-wastong test argument: {0}\ntest.invalid_signature\tdi-wastong signature ng test function\ntest.io_clean_dir\thindi malinis ang pribadong test directory\ntest.io_clean_image\thindi malinis ang native test image\ntest.io_dir\thindi makagawa ng pribadong test directory\ntest.io_protect\thindi maprotektahan ang pribadong test directory\ntest.missing_target\tkulang ang test target\ntest.no_match\twalang test na tumutugma sa --run={0}\ntest.none\twalang nakitang test\ntest.pass\tPASADO\ntest.resource\tlampas sa limitasyon ng resource");
    string.write_string(output, "\ntest.runtime\truntime error\ntest.skip\tLUMIPAS\ntest.skipped\tMga test na lumipas: {0}\ntest.starting\tSinisimulan ang mga test {0}\ntest.summary\tTapos na ang mga test: {0} pasado, {1} bigo");
    kaesu string.builder_string(output);
}

waza text_fr_fr() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\timpossible de charger la dépendance : {0}\nbunko.missing\tBunko n’est pas installé. Utilisez --bunko-root ou MIO_BUNKO pour importer {0}.\nbunko.package_read\timpossible de lire le paquet : {0}\nbunko.root_layout\tun répertoire Bunko contenant kiso/ était attendu : {0}\nbunko.root_resolve\timpossible de résoudre le chemin du répertoire : {0}\ncheck.passed\tvérification réussie\ncli.lsp_unknown\targument lsp inconnu : {0}\ncmd.build\tConstruire un exécutable natif ou du bytecode Mochi depuis les sources Mio\ncmd.check\tAnalyser les sources Mio sans produire de sortie\ncmd.disasm\tDésassembler un programme Mochi compilé\ncmd.exec\tExécuter un programme Mochi compilé\ncmd.fmt\tFormater les fichiers source Mio.\ncmd.help\tAfficher l'aide de Mio ou d'une commande\ncmd.lint\tRechercher les problèmes courants dans le code source Mio.\ncmd.lsp\tDémarrer le serveur de langage Mio sur l'entrée/sortie standard\ncmd.run\tConstruire et exécuter un programme Mio depuis les sources\ncmd.test\tDécouvrir et exécuter les paquets de tests Mio\ncmd.version\tAfficher les informations de version\ndiag.cause\tcause\ndiag.error\terreur");
    string.write_string(output, "\ndiag.expected_actual\t{0} attendu, {1} obtenu\ndiag.lexical\ttexte source non reconnu\ndiag.note\tnote\ndiag.suggestion\tsuggestion\ndiag.warning\tavertissement\nerr.analysis\tl'analyse des sources a échoué\nerr.bunko_empty\tle chemin Bunko de remplacement doit être explicite et non vide\nerr.chmod_native\timpossible de rendre la sortie native exécutable\nerr.cleanup\tle nettoyage après exécution a échoué\nerr.create_run_dir\timpossible de créer un répertoire d'exécution privé\nerr.emit_mochi\tcette commande ne peut pas produire de bytecode Mochi\nerr.empty_paths\tles chemins source et de sortie doivent être non vides\nerr.gc_stress\t--gc-stress ne s'applique qu'aux constructions natives depuis les sources\nerr.help_args\thelp accepte au plus un nom de commande\nerr.help_unknown\taucune aide pour la commande inconnue : {0}\nerr.host_target\trun et exec nécessitent la cible hôte {0}\nerr.invalid_color\tmode de couleur invalide : {0} (attendu : auto, always ou never)\nerr.invalid_format\tformat invalide : {0} (attendu : human, short ou json)\nerr.invalid_theme\tthème invalide : {0} (attendu : auto, dark ou light)\nerr.missing_value\tvaleur manquante pour l'option {0}");
    string.write_string(output, "\nerr.multiple_entries\tun seul point d'entrée source peut être fourni\nerr.observe\t--observe ne s'applique qu'aux constructions natives darwin-arm64 depuis les sources\nerr.open_stream\timpossible d’ouvrir {0}\nerr.program_args\tles arguments de programme nécessitent run ou exec\nerr.protect_run_dir\timpossible de protéger le répertoire d'exécution privé\nerr.read_mochi\timpossible de lire l'entrée Mochi\nerr.run_output\trun et exec gèrent leur propre sortie native\nerr.spawn\tle programme natif n'a pas pu être démarré\nerr.symbols\t--emit-symbols ne s'applique qu'aux constructions natives darwin-arm64 depuis les sources\nerr.target\tcible non prise en charge : {0} (attendu : darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tcommande inconnue : {0}\nerr.unknown_option\toption inconnue : {0}\nerr.version_args\tla commande version n'accepte aucun argument\nerr.write_disasm\timpossible d'écrire le désassemblage\nerr.write_help\timpossible d’afficher l’aide\nerr.write_mochi\timpossible d'écrire la sortie Mochi\nerr.write_native\timpossible d'écrire la sortie native\nfmt.behavior\tLes répertoires sont parcourus récursivement. Utilisez --stdin pour lire l’entrée standard et --check pour signaler les changements sans écrire.\nfmt.status\tCode de sortie : 0 succès, 1 changements nécessaires avec --check, 2 erreur d’utilisation, de syntaxe ou d’E/S.\nhelp.commands\tCommandes");
    string.write_string(output, "\nhelp.examples\tExemples\nhelp.group.compilation\tCompilation\nhelp.group.diagnostics\tDiagnostic\nhelp.group.execution\tExécution\nhelp.group.general\tGénéral\nhelp.group.testing\tTests\nhelp.group.tools\tOutils de développement\nhelp.more\tExécutez 'mio help <commande>' pour le détail d'une commande.\nhelp.options\tOptions\nhelp.tagline\tCompilateur Native AOT et chaîne d'outils pour le langage Mio\nhelp.title\tMio {0}\nhelp.usage\tUtilisation\nlint.behavior\tUtilisez --list-rules pour afficher les règles et --deny-warnings pour échouer en cas d’avertissement. Le code doit d’abord passer les vérifications du compilateur.\nlint.constant_condition\tCondition toujours vraie ou toujours fausse\nlint.finding_if\tla condition de moshi vaut toujours {0}\nlint.finding_import\tl’importation {0} (paquet {1}) n’est jamais utilisée\nlint.finding_loop\tla condition de aida vaut toujours iie, donc le corps de la boucle ne s’exécute jamais\nlint.finding_unreachable\tcode inaccessible après {0}\nlint.finding_variable\tla variable {0} est déclarée mais jamais utilisée\nlint.status\tCode de sortie : 0 succès, 1 avertissements avec --deny-warnings, 2 erreur d’utilisation ou de compilation.");
    string.write_string(output, "\nlint.unreachable_code\tInstruction après un transfert de contrôle inconditionnel\nlint.unused_import\tImportation de paquet inutilisée\nlint.unused_variable\tVariable locale inutilisée (sauf si son nom commence par _)\nopt.bunko\tUtiliser cette racine Bunko au lieu de celle par défaut\nopt.color\tContrôler la couleur : auto, always ou never\nopt.emit\tProduire du bytecode Mochi au lieu d'une image native\nopt.format\tChoisir le format de sortie : human, short ou json\nopt.gc_stress\tConstruire avec des contrôles de stress agressifs du ramasse-miettes\nopt.help\tAfficher l'aide\nopt.lang\tChoisir la langue de sortie par étiquette BCP 47, par exemple ja-JP\nopt.observe\tEnregistrer des observations de construction native\nopt.output\tÉcrire la sortie dans ce chemin\nopt.program_args\tTransmettre les arguments restants au programme\nopt.run_filter\tN'exécuter que les tests dont le nom correspond à cette expression régulière\nopt.stdio\tUtiliser l'entrée/sortie standard pour le serveur de langage\nopt.symbols\tÉcrire les informations de symboles natifs dans ce fichier\nopt.target\tConstruire pour darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tChoisir la palette sémantique : auto, dark ou light\nopt.verbose\tAfficher des détails de diagnostic supplémentaires\nopt.version\tAfficher les informations de version");
    string.write_string(output, "\ntest.assertion\téchec d'assertion\ntest.bunko_empty\tle chemin Bunko de remplacement doit être non vide\ntest.bunko_missing\tvaleur manquante pour --bunko-root\ntest.compile_failed\téchec de compilation\ntest.duration\tdurée totale\ntest.empty_filter\tle filtre de test doit être non vide\ntest.empty_lang\tl'étiquette de langue doit être non vide\ntest.fail\tÉCHEC\ntest.filter_invalid\tfiltre de test invalide : {0}\ntest.invalid_arg\targument de test invalide : {0}\ntest.invalid_signature\tsignature de fonction de test invalide\ntest.io_clean_dir\timpossible de nettoyer le répertoire de test privé\ntest.io_clean_image\timpossible de nettoyer l'image de test native\ntest.io_dir\timpossible de créer un répertoire de test privé\ntest.io_protect\timpossible de protéger le répertoire de test privé\ntest.missing_target\tcible de test manquante\ntest.no_match\taucun test ne correspond à --run={0}\ntest.none\taucun test trouvé\ntest.pass\tRÉUSSI\ntest.resource\tlimite de ressources dépassée");
    string.write_string(output, "\ntest.runtime\terreur d'exécution\ntest.skip\tIGNORÉ\ntest.skipped\tTests ignorés : {0}\ntest.starting\tDébut des tests {0}\ntest.summary\tTests terminés : {0} réussis, {1} échoués");
    kaesu string.builder_string(output);
}

waza text_he_il() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tלא ניתן לטעון את התלות: {0}\nbunko.missing\tBunko אינו מותקן. השתמשו ב־--bunko-root או ב־MIO_BUNKO כדי לייבא את {0}.\nbunko.package_read\tלא ניתן לקרוא את החבילה: {0}\nbunko.root_layout\tנדרשת תיקיית Bunko שמכילה את kiso/: {0}\nbunko.root_resolve\tלא ניתן למצוא את הנתיב בפועל של התיקייה: {0}\ncheck.passed\tהבדיקה עברה\ncli.lsp_unknown\tארגומנט lsp לא ידוע: {0}\ncmd.build\tבנה קובץ הרצה מקורי או בייט-קוד Mochi מקוד Mio\ncmd.check\tנתח קוד Mio בלי ליצור פלט\ncmd.disasm\tפרק תוכנית Mochi מהודרת\ncmd.exec\tהרץ תוכנית Mochi מהודרת\ncmd.fmt\tעיצוב קובצי המקור של Mio.\ncmd.help\tהצג עזרה עבור Mio או פקודה אחת\ncmd.lint\tבדיקת קוד המקור של Mio לאיתור בעיות נפוצות.\ncmd.lsp\tהפעל את שרת השפה של Mio דרך קלט ופלט תקניים\ncmd.run\tבנה והרץ תוכנית Mio מהמקור\ncmd.test\tמצא והרץ חבילות בדיקה של Mio\ncmd.version\tהצג מידע על הגרסה\ndiag.cause\tסיבה\ndiag.error\tשגיאה");
    string.write_string(output, "\ndiag.expected_actual\tציפינו ל־{0}, התקבל {1}\ndiag.lexical\tטקסט מקור בלתי מזוהה\ndiag.note\tהערה\ndiag.suggestion\tהצעה\ndiag.warning\tאזהרה\nerr.analysis\tניתוח המקור נכשל\nerr.bunko_empty\tנתיב Bunko החלופי חייב להיות מפורש ולא ריק\nerr.chmod_native\tלא ניתן להפוך את הפלט המקורי להרצה\nerr.cleanup\tהניקוי לאחר ההרצה נכשל\nerr.create_run_dir\tלא ניתן ליצור תיקיית הרצה פרטית\nerr.emit_mochi\tפקודה זו אינה יכולה לפלוט בייט-קוד Mochi\nerr.empty_paths\tנתיבי המקור והפלט חייבים להיות לא ריקים\nerr.gc_stress\t--gc-stress חל רק על בניות מקוריות מהמקור\nerr.help_args\thelp מקבלת לכל היותר שם פקודה אחד\nerr.help_unknown\tאין עזרה לפקודה לא ידועה: {0}\nerr.host_target\trun ו-exec דורשים את יעד המארח {0}\nerr.invalid_color\tמצב צבע לא חוקי: {0} (צפוי auto, always או never)\nerr.invalid_format\tתבנית לא חוקית: {0} (צפוי human, short או json)\nerr.invalid_theme\tערכת נושא לא חוקית: {0} (צפוי auto, dark או light)\nerr.missing_value\tחסר ערך לאפשרות {0}");
    string.write_string(output, "\nerr.multiple_entries\tאפשר לציין מקור אחד בלבד\nerr.observe\t--observe חל רק על בניות מקוריות darwin-arm64 מהמקור\nerr.open_stream\tלא ניתן לפתוח את {0}\nerr.program_args\tארגומנטים של תוכנית דורשים run או exec\nerr.protect_run_dir\tלא ניתן להגן על תיקיית ההרצה הפרטית\nerr.read_mochi\tלא ניתן לקרוא את קלט Mochi\nerr.run_output\trun ו-exec מנהלים את הפלט המקורי שלהם בעצמם\nerr.spawn\tלא ניתן היה להפעיל את התוכנית המקורית\nerr.symbols\t--emit-symbols חל רק על בניות מקוריות darwin-arm64 מהמקור\nerr.target\tיעד לא נתמך: {0} (צפוי darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tפקודה לא ידועה: {0}\nerr.unknown_option\tאפשרות לא ידועה: {0}\nerr.version_args\tהפקודה version אינה מקבלת ארגומנטים\nerr.write_disasm\tלא ניתן לכתוב את הפירוק\nerr.write_help\tלא ניתן להציג את העזרה\nerr.write_mochi\tלא ניתן לכתוב את פלט Mochi\nerr.write_native\tלא ניתן לכתוב את הפלט המקורי\nfmt.behavior\tהתיקיות נסרקות רקורסיבית. השתמשו ב־--stdin לקריאה מהקלט הסטנדרטי וב־--check לדיווח על שינויים ללא כתיבה.\nfmt.status\tקוד יציאה: 0 הצלחה, 1 נדרשים שינויים במצב --check, 2 שגיאת שימוש, ניתוח תחביר או קלט/פלט.\nhelp.commands\tפקודות");
    string.write_string(output, "\nhelp.examples\tדוגמאות\nhelp.group.compilation\tהידור\nhelp.group.diagnostics\tאבחון\nhelp.group.execution\tהרצה\nhelp.group.general\tכללי\nhelp.group.testing\tבדיקות\nhelp.group.tools\tכלי פיתוח\nhelp.more\tהרץ 'mio help <פקודה>' לפרטי הפקודה.\nhelp.options\tאפשרויות\nhelp.tagline\tמהדר Native AOT וחבילת כלים לשפת Mio\nhelp.title\tMio {0}\nhelp.usage\tשימוש\nlint.behavior\tהשתמשו ב־--list-rules להצגת הכללים וב־--deny-warnings כדי להיכשל אם נמצאו אזהרות. קוד המקור חייב לעבור תחילה את בדיקות המהדר.\nlint.constant_condition\tתנאי שתמיד מתקיים או שלעולם אינו מתקיים\nlint.finding_if\tערך התנאי של moshi הוא תמיד {0}\nlint.finding_import\tהייבוא {0} (חבילה {1}) אינו בשימוש\nlint.finding_loop\tערך התנאי של aida הוא תמיד iie, ולכן גוף הלולאה אינו מתבצע\nlint.finding_unreachable\tקוד בלתי נגיש אחרי {0}\nlint.finding_variable\tהמשתנה {0} הוצהר אך אינו בשימוש\nlint.status\tקוד יציאה: 0 הצלחה, 1 אזהרות עם --deny-warnings, 2 שגיאת שימוש או הידור.");
    string.write_string(output, "\nlint.unreachable_code\tפקודה אחרי העברת בקרה בלתי מותנית\nlint.unused_import\tייבוא חבילה שאינו בשימוש\nlint.unused_variable\tמשתנה מקומי שאינו בשימוש (למעט שמות שמתחילים ב־_)\nopt.bunko\tהשתמש בשורש Bunko הזה במקום ברירת המחדל\nopt.color\tשלוט בפלט צבעוני: auto, always או never\nopt.emit\tפלוט בייט-קוד Mochi במקום תמונת קוד מקורית\nopt.format\tבחר את תבנית הפלט: human, short או json\nopt.gc_stress\tבנה עם בדיקות מאמץ אגרסיביות של אוסף האשפה\nopt.help\tהצג עזרה\nopt.lang\tבחר את שפת הפלט לפי תג BCP 47, למשל ja-JP\nopt.observe\tרשום תצפיות בנייה מקורית\nopt.output\tכתוב את הפלט לנתיב הזה\nopt.program_args\tהעבר את שאר הארגומנטים לתוכנית\nopt.run_filter\tהרץ רק בדיקות ששמן תואם לביטוי הרגולרי הזה\nopt.stdio\tהשתמש בקלט ובפלט תקניים עבור שרת השפה\nopt.symbols\tכתוב מידע על סמלים מקוריים לקובץ הזה\nopt.target\tבנה עבור darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tבחר ערכת צבעים סמנטית: auto, dark או light\nopt.verbose\tכלול פרטי אבחון נוספים\nopt.version\tהצג מידע על הגרסה");
    string.write_string(output, "\ntest.assertion\tהבדיקה נכשלה\ntest.bunko_empty\tנתיב Bunko החלופי חייב להיות לא ריק\ntest.bunko_missing\tחסר ערך ל--bunko-root\ntest.compile_failed\tההידור נכשל\ntest.duration\tמשך כולל\ntest.empty_filter\tמסנן הבדיקות חייב להיות לא ריק\ntest.empty_lang\tתג השפה חייב להיות לא ריק\ntest.fail\tנכשל\ntest.filter_invalid\tמסנן בדיקות לא חוקי: {0}\ntest.invalid_arg\tארגומנט בדיקה לא חוקי: {0}\ntest.invalid_signature\tחתימת פונקציית בדיקה לא חוקית\ntest.io_clean_dir\tלא ניתן לנקות את תיקיית הבדיקה הפרטית\ntest.io_clean_image\tלא ניתן לנקות את תמונת הבדיקה המקורית\ntest.io_dir\tלא ניתן ליצור תיקיית בדיקה פרטית\ntest.io_protect\tלא ניתן להגן על תיקיית הבדיקה הפרטית\ntest.missing_target\tחסר יעד בדיקה\ntest.no_match\tאין בדיקות שתואמות ל--run={0}\ntest.none\tלא נמצאו בדיקות\ntest.pass\tעבר\ntest.resource\tחריגה ממגבלת משאבים");
    string.write_string(output, "\ntest.runtime\tשגיאת הרצה\ntest.skip\tדולג\ntest.skipped\tבדיקות שדולגו: {0}\ntest.starting\tמתחיל בדיקות {0}\ntest.summary\tהבדיקות הושלמו: {0} עברו, {1} נכשלו");
    kaesu string.builder_string(output);
}

waza text_hi_in() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tनिर्भरता लोड नहीं हो सकी: {0}\nbunko.missing\tBunko इंस्टॉल नहीं है। {0} आयात करने के लिए --bunko-root या MIO_BUNKO का उपयोग करें।\nbunko.package_read\tपैकेज पढ़ा नहीं जा सका: {0}\nbunko.root_layout\tBunko निर्देशिका में kiso/ होना चाहिए: {0}\nbunko.root_resolve\tनिर्देशिका का वास्तविक पथ नहीं मिला: {0}\ncheck.passed\tजाँच उत्तीर्ण\ncli.lsp_unknown\tअज्ञात lsp तर्क: {0}\ncmd.build\tMio स्रोत से नेटिव निष्पादन योग्य फ़ाइल या Mochi बाइटकोड बनाएँ\ncmd.check\tबिना आउटपुट बनाए Mio स्रोत का विश्लेषण करें\ncmd.disasm\tसंकलित Mochi प्रोग्राम को डिसअसेम्बल करें\ncmd.exec\tसंकलित Mochi प्रोग्राम चलाएँ\ncmd.fmt\tMio स्रोत फ़ाइलों को स्वरूपित करें।\ncmd.help\tMio या किसी एक कमांड के लिए सहायता दिखाएँ\ncmd.lint\tMio स्रोत कोड में सामान्य समस्याएँ जाँचें।\ncmd.lsp\tमानक इनपुट/आउटपुट पर Mio भाषा सर्वर शुरू करें\ncmd.run\tस्रोत से Mio प्रोग्राम बनाएँ और चलाएँ\ncmd.test\tMio परीक्षण पैकेज खोजें और चलाएँ\ncmd.version\tसंस्करण जानकारी दिखाएँ\ndiag.cause\tकारण\ndiag.error\tत्रुटि");
    string.write_string(output, "\ndiag.expected_actual\tअपेक्षित {0}, प्राप्त {1}\ndiag.lexical\tअज्ञात स्रोत पाठ\ndiag.note\tटिप्पणी\ndiag.suggestion\tसुझाव\ndiag.warning\tचेतावनी\nerr.analysis\tस्रोत विश्लेषण विफल रहा\nerr.bunko_empty\tBunko ओवरराइड पथ स्पष्ट और गैर-रिक्त होना चाहिए\nerr.chmod_native\tनेटिव आउटपुट को निष्पादन योग्य नहीं बनाया जा सका\nerr.cleanup\tनिष्पादन के बाद सफ़ाई विफल रही\nerr.create_run_dir\tनिजी निष्पादन निर्देशिका नहीं बनाई जा सकी\nerr.emit_mochi\tयह कमांड Mochi बाइटकोड उत्पन्न नहीं कर सकता\nerr.empty_paths\tस्रोत और आउटपुट पथ रिक्त नहीं हो सकते\nerr.gc_stress\t--gc-stress केवल स्रोत से नेटिव निर्माण पर लागू होता है\nerr.help_args\thelp अधिकतम एक कमांड नाम लेता है\nerr.help_unknown\tअज्ञात कमांड के लिए सहायता नहीं है: {0}\nerr.host_target\trun और exec के लिए होस्ट लक्ष्य {0} आवश्यक है\nerr.invalid_color\tअमान्य रंग मोड: {0} (auto, always या never अपेक्षित)\nerr.invalid_format\tअमान्य प्रारूप: {0} (human, short या json अपेक्षित)\nerr.invalid_theme\tअमान्य थीम: {0} (auto, dark या light अपेक्षित)\nerr.missing_value\tविकल्प {0} का मान गायब है");
    string.write_string(output, "\nerr.multiple_entries\tकेवल एक स्रोत प्रविष्टि दी जा सकती है\nerr.observe\t--observe केवल स्रोत से darwin-arm64 नेटिव निर्माण पर लागू होता है\nerr.open_stream\t{0} खोला नहीं जा सका\nerr.program_args\tप्रोग्राम तर्कों के लिए run या exec आवश्यक है\nerr.protect_run_dir\tनिजी निष्पादन निर्देशिका की सुरक्षा नहीं की जा सकी\nerr.read_mochi\tMochi इनपुट नहीं पढ़ा जा सका\nerr.run_output\trun और exec अपने नेटिव आउटपुट का प्रबंधन स्वयं करते हैं\nerr.spawn\tनेटिव प्रोग्राम शुरू नहीं हो सका\nerr.symbols\t--emit-symbols केवल स्रोत से darwin-arm64 नेटिव निर्माण पर लागू होता है\nerr.target\tअसमर्थित लक्ष्य: {0} (darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64 अपेक्षित)\nerr.unknown_command\tअज्ञात कमांड: {0}\nerr.unknown_option\tअज्ञात विकल्प: {0}\nerr.version_args\tversion कमांड कोई तर्क नहीं लेता\nerr.write_disasm\tडिसअसेम्बली नहीं लिखी जा सकी\nerr.write_help\tसहायता लिखी नहीं जा सकी\nerr.write_mochi\tMochi आउटपुट नहीं लिखा जा सका\nerr.write_native\tनेटिव आउटपुट नहीं लिखा जा सका\nfmt.behavior\tनिर्देशिकाओं और उनकी उपनिर्देशिकाओं में खोज की जाती है। मानक इनपुट पढ़ने के लिए --stdin और बिना लिखे बदलाव बताने के लिए --check का उपयोग करें।\nfmt.status\tनिकास कोड: 0 सफल, 1 --check मोड में बदलाव चाहिए, 2 उपयोग, पार्सिंग या इनपुट/आउटपुट त्रुटि।\nhelp.commands\tकमांड");
    string.write_string(output, "\nhelp.examples\tउदाहरण\nhelp.group.compilation\tकंपाइलेशन\nhelp.group.diagnostics\tनिदान\nhelp.group.execution\tनिष्पादन\nhelp.group.general\tसामान्य\nhelp.group.testing\tपरीक्षण\nhelp.group.tools\tविकास उपकरण\nhelp.more\tकिसी कमांड का विवरण देखने के लिए 'mio help <कमांड>' चलाएँ।\nhelp.options\tविकल्प\nhelp.tagline\tMio भाषा के लिए Native AOT कंपाइलर और टूलचेन\nhelp.title\tMio {0}\nhelp.usage\tउपयोग\nlint.behavior\tनियम दिखाने के लिए --list-rules और चेतावनियों पर विफल होने के लिए --deny-warnings का उपयोग करें। स्रोत को पहले कंपाइलर की जाँचों में सफल होना चाहिए।\nlint.constant_condition\tहमेशा सत्य या हमेशा असत्य शर्त\nlint.finding_if\tmoshi की शर्त हमेशा {0} है\nlint.finding_import\tआयात {0} (पैकेज {1}) कभी इस्तेमाल नहीं होता\nlint.finding_loop\taida की शर्त हमेशा iie है, इसलिए लूप का मुख्य भाग कभी नहीं चलता\nlint.finding_unreachable\t{0} के बाद का कोड पहुँच से बाहर है\nlint.finding_variable\tचर {0} घोषित है लेकिन इस्तेमाल नहीं होता\nlint.status\tनिकास कोड: 0 सफल, 1 --deny-warnings के साथ चेतावनियाँ, 2 उपयोग या कंपाइलर त्रुटि।");
    string.write_string(output, "\nlint.unreachable_code\tबिना शर्त नियंत्रण हस्तांतरण के बाद का कथन\nlint.unused_import\tअप्रयुक्त पैकेज आयात\nlint.unused_variable\tअप्रयुक्त स्थानीय चर (_ से शुरू होने वाले नामों को छोड़कर)\nopt.bunko\tडिफ़ॉल्ट के बजाय यह Bunko रूट उपयोग करें\nopt.color\tरंगीन आउटपुट नियंत्रित करें: auto, always या never\nopt.emit\tनेटिव इमेज के बजाय Mochi बाइटकोड उत्पन्न करें\nopt.format\tआउटपुट प्रारूप चुनें: human, short या json\nopt.gc_stress\tगहन कचरा संग्रहक तनाव जाँच के साथ बनाएँ\nopt.help\tसहायता दिखाएँ\nopt.lang\tBCP 47 टैग से आउटपुट भाषा चुनें, जैसे ja-JP\nopt.observe\tनेटिव निर्माण अवलोकन दर्ज करें\nopt.output\tआउटपुट इस पथ पर लिखें\nopt.program_args\tशेष तर्क प्रोग्राम को दें\nopt.run_filter\tकेवल वे परीक्षण चलाएँ जिनके नाम इस नियमित अभिव्यक्ति से मेल खाते हैं\nopt.stdio\tभाषा सर्वर के लिए मानक इनपुट और आउटपुट उपयोग करें\nopt.symbols\tनेटिव सिंबल जानकारी इस फ़ाइल में लिखें\nopt.target\tdarwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64 के लिए बनाएँ\nopt.theme\tअर्थपूर्ण रंग योजना चुनें: auto, dark या light\nopt.verbose\tअतिरिक्त निदान विवरण दिखाएँ\nopt.version\tसंस्करण जानकारी दिखाएँ");
    string.write_string(output, "\ntest.assertion\tअभिकथन विफल\ntest.bunko_empty\tBunko ओवरराइड पथ रिक्त नहीं हो सकता\ntest.bunko_missing\t--bunko-root का मान गायब है\ntest.compile_failed\tकंपाइलेशन विफल\ntest.duration\tकुल अवधि\ntest.empty_filter\tपरीक्षण फ़िल्टर रिक्त नहीं हो सकता\ntest.empty_lang\tभाषा टैग रिक्त नहीं हो सकता\ntest.fail\tविफल\ntest.filter_invalid\tअमान्य परीक्षण फ़िल्टर: {0}\ntest.invalid_arg\tअमान्य परीक्षण तर्क: {0}\ntest.invalid_signature\tपरीक्षण फ़ंक्शन हस्ताक्षर अमान्य है\ntest.io_clean_dir\tनिजी परीक्षण निर्देशिका साफ़ नहीं की जा सकी\ntest.io_clean_image\tनेटिव परीक्षण इमेज साफ़ नहीं की जा सकी\ntest.io_dir\tनिजी परीक्षण निर्देशिका नहीं बनाई जा सकी\ntest.io_protect\tनिजी परीक्षण निर्देशिका की सुरक्षा नहीं की जा सकी\ntest.missing_target\tपरीक्षण लक्ष्य गायब है\ntest.no_match\t--run={0} से कोई परीक्षण मेल नहीं खाता\ntest.none\tकोई परीक्षण नहीं मिला\ntest.pass\tउत्तीर्ण\ntest.resource\tसंसाधन सीमा पार");
    string.write_string(output, "\ntest.runtime\tरनटाइम त्रुटि\ntest.skip\tछोड़ा गया\ntest.skipped\tछोड़े गए परीक्षण: {0}\ntest.starting\tपरीक्षण प्रारंभ {0}\ntest.summary\tपरीक्षण पूर्ण: {0} उत्तीर्ण, {1} विफल");
