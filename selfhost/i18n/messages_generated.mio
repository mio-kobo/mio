waza text_fa_ir() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tبررسی موفق بود\ncli.lsp_unknown\tآرگومان lsp ناشناخته: {0}\ncmd.build\tساخت فایل اجرایی بومی یا بایت‌کد Mochi از کد Mio\ncmd.check\tتحلیل کد Mio بدون تولید خروجی\ncmd.disasm\tواسازی برنامه Mochi کامپایل‌شده\ncmd.exec\tاجرای برنامه Mochi کامپایل‌شده\ncmd.help\tنمایش راهنما برای Mio یا یک دستور\ncmd.lsp\tراه‌اندازی سرور زبان Mio روی ورودی/خروجی استاندارد\ncmd.run\tساخت و اجرای برنامه Mio از کد منبع\ncmd.test\tیافتن و اجرای بسته‌های آزمون Mio\ncmd.version\tنمایش اطلاعات نسخه\ndiag.cause\tعلت\nerr.analysis\tتحلیل کد منبع ناموفق بود\nerr.bunko_empty\tمسیر جایگزین Bunko باید صریح و غیرخالی باشد\nerr.chmod_native\tاجرایی‌کردن خروجی بومی ممکن نیست\nerr.cleanup\tپاک‌سازی پس از اجرا ناموفق بود\nerr.create_run_dir\tساخت پوشه اجرای خصوصی ممکن نیست\nerr.emit_mochi\tاین دستور نمی‌تواند بایت‌کد Mochi تولید کند\nerr.empty_paths\tمسیرهای منبع و خروجی نباید خالی باشند\nerr.gc_stress\t--gc-stress فقط برای ساخت‌های بومی از کد منبع کاربرد دارد");
    string.write_string(output, "\nerr.help_args\thelp حداکثر یک نام دستور می‌پذیرد\nerr.help_unknown\tراهنمایی برای دستور ناشناخته وجود ندارد: {0}\nerr.host_target\trun و exec به هدف میزبان {0} نیاز دارند\nerr.invalid_color\tحالت رنگ نامعتبر: {0} (انتظار auto، always یا never)\nerr.invalid_format\tقالب نامعتبر: {0} (انتظار human، short یا json)\nerr.invalid_theme\tپوسته نامعتبر: {0} (انتظار auto، dark یا light)\nerr.missing_value\tمقدار گزینه {0} موجود نیست\nerr.multiple_entries\tفقط یک ورودی منبع می‌تواند داده شود\nerr.observe\t--observe فقط برای ساخت‌های بومی darwin-arm64 از کد منبع کاربرد دارد\nerr.program_args\tآرگومان‌های برنامه به run یا exec نیاز دارند\nerr.protect_run_dir\tمحافظت از پوشه اجرای خصوصی ممکن نیست\nerr.read_mochi\tخواندن ورودی Mochi ممکن نیست\nerr.run_output\trun و exec خروجی بومی خود را مدیریت می‌کنند\nerr.spawn\tبرنامه بومی راه‌اندازی نشد\nerr.symbols\t--emit-symbols فقط برای ساخت‌های بومی darwin-arm64 از کد منبع کاربرد دارد\nerr.target\tهدف پشتیبانی‌نشده: {0} (انتظار darwin-arm64، linux-amd64 یا windows-amd64)\nerr.unknown_command\tدستور ناشناخته: {0}\nerr.unknown_option\tگزینه ناشناخته: {0}\nerr.version_args\tدستور version آرگومان نمی‌پذیرد\nerr.write_disasm\tنوشتن واسازی ممکن نیست");
    string.write_string(output, "\nerr.write_mochi\tنوشتن خروجی Mochi ممکن نیست\nerr.write_native\tنوشتن خروجی بومی ممکن نیست\nhelp.commands\tدستورها\nhelp.examples\tمثال‌ها\nhelp.group.compilation\tکامپایل\nhelp.group.diagnostics\tعیب‌یابی\nhelp.group.execution\tاجرا\nhelp.group.general\tعمومی\nhelp.group.testing\tآزمون‌ها\nhelp.group.tools\tابزارهای توسعه\nhelp.more\tبرای جزئیات یک دستور 'mio help <دستور>' را اجرا کنید.\nhelp.options\tگزینه‌ها\nhelp.tagline\tکامپایلر Native AOT و زنجیره ابزار برای زبان Mio\nhelp.title\tMio {0}\nhelp.usage\tکاربرد\nopt.bunko\tاستفاده از این ریشه Bunko به‌جای پیش‌فرض\nopt.color\tکنترل خروجی رنگی: auto، always یا never\nopt.emit\tتولید بایت‌کد Mochi به‌جای تصویر بومی\nopt.format\tانتخاب قالب خروجی: human، short یا json\nopt.gc_stress\tساخت با بررسی‌های فشار تهاجمی جمع‌کننده زباله");
    string.write_string(output, "\nopt.help\tنمایش راهنما\nopt.lang\tانتخاب زبان خروجی با برچسب BCP 47، مثلاً ja-JP\nopt.observe\tثبت مشاهدات ساخت بومی\nopt.output\tنوشتن خروجی در این مسیر\nopt.program_args\tانتقال آرگومان‌های باقی‌مانده به برنامه\nopt.run_filter\tفقط آزمون‌هایی را اجرا کن که نامشان با این عبارت باقاعده مطابقت دارد\nopt.stdio\tاستفاده از ورودی و خروجی استاندارد برای سرور زبان\nopt.symbols\tنوشتن اطلاعات نمادهای بومی در این فایل\nopt.target\tساخت برای darwin-arm64، linux-amd64 یا windows-amd64\nopt.theme\tانتخاب پالت معنایی: auto، dark یا light\nopt.verbose\tنمایش جزئیات بیشتر عیب‌یابی\nopt.version\tنمایش اطلاعات نسخه\ntest.assertion\tشکست بررسی\ntest.bunko_empty\tمسیر جایگزین Bunko نباید خالی باشد\ntest.bunko_missing\tمقدار --bunko-root موجود نیست\ntest.compile_failed\tکامپایل ناموفق بود\ntest.duration\tمدت کل\ntest.empty_filter\tفیلتر آزمون نباید خالی باشد\ntest.empty_lang\tبرچسب زبان نباید خالی باشد\ntest.fail\tناموفق");
    string.write_string(output, "\ntest.filter_invalid\tفیلتر آزمون نامعتبر: {0}\ntest.invalid_arg\tآرگومان آزمون نامعتبر: {0}\ntest.invalid_signature\tامضای تابع آزمون نامعتبر است\ntest.io_clean_dir\tپاک‌سازی پوشه آزمون خصوصی ممکن نیست\ntest.io_clean_image\tپاک‌سازی تصویر آزمون بومی ممکن نیست\ntest.io_dir\tساخت پوشه آزمون خصوصی ممکن نیست\ntest.io_protect\tمحافظت از پوشه آزمون خصوصی ممکن نیست\ntest.missing_target\tهدف آزمون موجود نیست\ntest.no_match\tهیچ آزمونی با --run={0} مطابقت ندارد\ntest.none\tآزمونی یافت نشد\ntest.pass\tموفق\ntest.resource\tعبور از محدودیت منابع\ntest.runtime\tخطای زمان اجرا\ntest.skip\tردشده\ntest.skipped\tآزمون‌های ردشده: {0}\ntest.starting\tآغاز آزمون‌ها {0}\ntest.summary\tآزمون‌ها تمام شد: {0} موفق، {1} ناموفق");
    kaesu string.builder_string(output);
}

waza text_fi_fi() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\ttarkistus hyväksytty\ncli.lsp_unknown\ttuntematon lsp-argumentti: {0}\ncmd.build\tRakenna natiivi suoritettava tiedosto tai Mochi-tavukoodi Mio-lähteestä\ncmd.check\tAnalysoi Mio-lähde tuottamatta tulostetta\ncmd.disasm\tPura käännetty Mochi-ohjelma\ncmd.exec\tSuorita käännetty Mochi-ohjelma\ncmd.help\tNäytä Mion tai yhden komennon ohje\ncmd.lsp\tKäynnistä Mio-kielipalvelin vakio-syötön ja -tulosteen kautta\ncmd.run\tRakenna ja suorita Mio-ohjelma lähteestä\ncmd.test\tEtsi ja suorita Mio-testipaketit\ncmd.version\tNäytä versiotiedot\ndiag.cause\tsyy\nerr.analysis\tlähdeanalyysi epäonnistui\nerr.bunko_empty\tBunko-ohituksen polun on oltava selkeä eikä tyhjä\nerr.chmod_native\tnatiivista tulosteesta ei voi tehdä suoritettavaa\nerr.cleanup\tsuorituksen jälkeinen siivous epäonnistui\nerr.create_run_dir\tyksityistä suorituskansiota ei voi luoda\nerr.emit_mochi\ttämä komento ei voi tuottaa Mochi-tavukoodia\nerr.empty_paths\tlähde- ja tulostepolut eivät voi olla tyhjiä\nerr.gc_stress\t--gc-stress koskee vain lähteestä tehtäviä natiiveja käännöksiä");
    string.write_string(output, "\nerr.help_args\thelp hyväksyy enintään yhden komennon nimen\nerr.help_unknown\ttuntemattomalle komennolle ei ole ohjetta: {0}\nerr.host_target\trun ja exec vaativat isäntäkohteen {0}\nerr.invalid_color\tvirheellinen väritila: {0} (odotettiin auto, always tai never)\nerr.invalid_format\tvirheellinen muoto: {0} (odotettiin human, short tai json)\nerr.invalid_theme\tvirheellinen teema: {0} (odotettiin auto, dark tai light)\nerr.missing_value\tvalinnan {0} arvo puuttuu\nerr.multiple_entries\tvain yksi lähdemerkintä voidaan antaa\nerr.observe\t--observe koskee vain lähteestä tehtäviä natiiveja darwin-arm64-käännöksiä\nerr.program_args\tohjelma-argumentit vaativat run- tai exec-komennon\nerr.protect_run_dir\tyksityistä suorituskansiota ei voi suojata\nerr.read_mochi\tMochi-syötettä ei voi lukea\nerr.run_output\trun ja exec hallinnoivat omaa natiivia tulostettaan\nerr.spawn\tnatiivia ohjelmaa ei voitu käynnistää\nerr.symbols\t--emit-symbols koskee vain lähteestä tehtäviä natiiveja darwin-arm64-käännöksiä\nerr.target\tkohdetta ei tueta: {0} (odotettiin darwin-arm64, linux-amd64 tai windows-amd64)\nerr.unknown_command\ttuntematon komento: {0}\nerr.unknown_option\ttuntematon valinta: {0}\nerr.version_args\tversion-komento ei hyväksy argumentteja\nerr.write_disasm\tpurkutulostetta ei voi kirjoittaa");
    string.write_string(output, "\nerr.write_mochi\tMochi-tulostetta ei voi kirjoittaa\nerr.write_native\tnatiivia tulostetta ei voi kirjoittaa\nhelp.commands\tKomennot\nhelp.examples\tEsimerkit\nhelp.group.compilation\tKäännös\nhelp.group.diagnostics\tDiagnostiikka\nhelp.group.execution\tSuoritus\nhelp.group.general\tYleiset\nhelp.group.testing\tTestit\nhelp.group.tools\tKehitystyökalut\nhelp.more\tSuorita 'mio help <komento>' nähdäksesi komennon tiedot.\nhelp.options\tValinnat\nhelp.tagline\tNative AOT -kääntäjä ja työkaluketju Mio-kielelle\nhelp.title\tMio {0}\nhelp.usage\tKäyttö\nopt.bunko\tKäytä tätä Bunko-juurta oletuksen sijaan\nopt.color\tSäädä väritulostetta: auto, always tai never\nopt.emit\tTuota Mochi-tavukoodia natiivin kuvan sijaan\nopt.format\tValitse tulostemuoto: human, short tai json\nopt.gc_stress\tRakenna roskienkerääjän aggressiivisilla rasitustarkistuksilla");
    string.write_string(output, "\nopt.help\tNäytä ohje\nopt.lang\tValitse tulosteen kieli BCP 47 -tunnisteella, esimerkiksi ja-JP\nopt.observe\tTallenna natiivin käännöksen havainnot\nopt.output\tKirjoita tuloste tähän polkuun\nopt.program_args\tVälitä loput argumentit ohjelmalle\nopt.run_filter\tSuorita vain testit, joiden nimi vastaa tätä säännöllistä lauseketta\nopt.stdio\tKäytä vakiosyöttöä ja -tulostetta kielipalvelimelle\nopt.symbols\tKirjoita natiivit symbolitiedot tähän tiedostoon\nopt.target\tRakenna kohteelle darwin-arm64, linux-amd64 tai windows-amd64\nopt.theme\tValitse semanttinen väripaletti: auto, dark tai light\nopt.verbose\tSisällytä lisää diagnostiikkatietoja\nopt.version\tNäytä versiotiedot\ntest.assertion\tväite epäonnistui\ntest.bunko_empty\tBunko-ohituksen polku ei voi olla tyhjä\ntest.bunko_missing\t--bunko-root: arvo puuttuu\ntest.compile_failed\tkäännös epäonnistui\ntest.duration\tkokonaiskesto\ntest.empty_filter\ttestisuodatin ei voi olla tyhjä\ntest.empty_lang\tkielitunniste ei voi olla tyhjä\ntest.fail\tEPÄONNISTUI");
    string.write_string(output, "\ntest.filter_invalid\tvirheellinen testisuodatin: {0}\ntest.invalid_arg\tvirheellinen testiargumentti: {0}\ntest.invalid_signature\ttestifunktion allekirjoitus on virheellinen\ntest.io_clean_dir\tyksityistä testikansiota ei voi siivota\ntest.io_clean_image\tnatiivia testikuvaa ei voi siivota\ntest.io_dir\tyksityistä testikansiota ei voi luoda\ntest.io_protect\tyksityistä testikansiota ei voi suojata\ntest.missing_target\ttestikohde puuttuu\ntest.no_match\tyksikään testi ei vastaa --run={0}\ntest.none\ttestejä ei löytynyt\ntest.pass\tHYVÄKSYTTY\ntest.resource\tresurssiraja ylittyi\ntest.runtime\tajonaikainen virhe\ntest.skip\tOHITETTU\ntest.skipped\tOhitetut testit: {0}\ntest.starting\tAloitetaan testit {0}\ntest.summary\tTestit valmiit: {0} hyväksytty, {1} epäonnistui");
    kaesu string.builder_string(output);
}

waza text_fil_ph() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tpumasa ang pagsusuri\ncli.lsp_unknown\thindi kilalang lsp argument: {0}\ncmd.build\tBumuo ng native executable o Mochi bytecode mula sa Mio source\ncmd.check\tSuriin ang Mio source nang walang output\ncmd.disasm\tI-disassemble ang naka-compile na Mochi program\ncmd.exec\tPatakbuhin ang naka-compile na Mochi program\ncmd.help\tIpakita ang tulong para sa Mio o sa isang utos\ncmd.lsp\tSimulan ang Mio language server sa standard input/output\ncmd.run\tBumuo at patakbuhin ang Mio program mula sa source\ncmd.test\tHanapin at patakbuhin ang mga Mio test package\ncmd.version\tIpakita ang impormasyon ng bersyon\ndiag.cause\tsanhi\nerr.analysis\tnabigo ang pagsusuri ng source\nerr.bunko_empty\tdapat tahasan at hindi walang laman ang Bunko override path\nerr.chmod_native\thindi magawang executable ang native output\nerr.cleanup\tnabigo ang paglilinis pagkatapos patakbuhin\nerr.create_run_dir\thindi makagawa ng pribadong run directory\nerr.emit_mochi\thindi makakapaglabas ng Mochi bytecode ang utos na ito\nerr.empty_paths\thindi maaaring walang laman ang source at output path\nerr.gc_stress\t--gc-stress ay para lamang sa native build mula sa source");
    string.write_string(output, "\nerr.help_args\ttumatanggap ng hindi hihigit sa isang pangalan ng utos ang help\nerr.help_unknown\twalang tulong para sa hindi kilalang utos: {0}\nerr.host_target\tkailangan ng run at exec ang host target na {0}\nerr.invalid_color\tdi-wastong color mode: {0} (inaasahan ang auto, always o never)\nerr.invalid_format\tdi-wastong format: {0} (inaasahan ang human, short o json)\nerr.invalid_theme\tdi-wastong tema: {0} (inaasahan ang auto, dark o light)\nerr.missing_value\tkulang ang halaga para sa opsyong {0}\nerr.multiple_entries\tisang source entry lamang ang maaaring ibigay\nerr.observe\t--observe ay para lamang sa native darwin-arm64 build mula sa source\nerr.program_args\tkailangan ng run o exec ang mga argumento ng program\nerr.protect_run_dir\thindi maprotektahan ang pribadong run directory\nerr.read_mochi\thindi mabasa ang Mochi input\nerr.run_output\tpinamamahalaan ng run at exec ang sarili nilang native output\nerr.spawn\thindi masimulan ang native program\nerr.symbols\t--emit-symbols ay para lamang sa native darwin-arm64 build mula sa source\nerr.target\thindi suportadong target: {0} (inaasahan ang darwin-arm64, linux-amd64 o windows-amd64)\nerr.unknown_command\thindi kilalang utos: {0}\nerr.unknown_option\thindi kilalang opsyon: {0}\nerr.version_args\thindi tumatanggap ng argumento ang utos na version\nerr.write_disasm\thindi maisulat ang disassembly");
    string.write_string(output, "\nerr.write_mochi\thindi maisulat ang Mochi output\nerr.write_native\thindi maisulat ang native output\nhelp.commands\tMga utos\nhelp.examples\tMga halimbawa\nhelp.group.compilation\tPag-compile\nhelp.group.diagnostics\tDiagnostics\nhelp.group.execution\tPagpapatupad\nhelp.group.general\tPangkalahatan\nhelp.group.testing\tPagsubok\nhelp.group.tools\tMga tool sa pag-develop\nhelp.more\tPatakbuhin ang 'mio help <utos>' para sa detalye ng isang utos.\nhelp.options\tMga opsyon\nhelp.tagline\tNative AOT compiler at toolchain para sa wikang Mio\nhelp.title\tMio {0}\nhelp.usage\tPaggamit\nopt.bunko\tGamitin ang Bunko root na ito sa halip na default\nopt.color\tKontrolin ang kulay ng output: auto, always o never\nopt.emit\tMaglabas ng Mochi bytecode sa halip na native image\nopt.format\tPiliin ang format ng output: human, short o json\nopt.gc_stress\tBumuo nang may agresibong garbage-collector stress check");
    string.write_string(output, "\nopt.help\tIpakita ang tulong\nopt.lang\tPiliin ang wikang output gamit ang BCP 47 tag, halimbawa ja-JP\nopt.observe\tItala ang mga obserbasyon sa native build\nopt.output\tIsulat ang output sa path na ito\nopt.program_args\tIpasa ang natitirang argumento sa program\nopt.run_filter\tPatakbuhin lamang ang mga test na tumutugma ang pangalan sa regular expression na ito\nopt.stdio\tGamitin ang standard input at output para sa language server\nopt.symbols\tIsulat ang native symbol information sa file na ito\nopt.target\tBumuo para sa darwin-arm64, linux-amd64 o windows-amd64\nopt.theme\tPiliin ang semantic palette: auto, dark o light\nopt.verbose\tIsama ang karagdagang detalye ng diagnostics\nopt.version\tIpakita ang impormasyon ng bersyon\ntest.assertion\tbigo ang assertion\ntest.bunko_empty\thindi maaaring walang laman ang Bunko override path\ntest.bunko_missing\tkulang ang halaga para sa --bunko-root\ntest.compile_failed\tnabigo ang pag-compile\ntest.duration\tkabuuang tagal\ntest.empty_filter\thindi maaaring walang laman ang test filter\ntest.empty_lang\thindi maaaring walang laman ang language tag\ntest.fail\tBIGO");
    string.write_string(output, "\ntest.filter_invalid\tdi-wastong test filter: {0}\ntest.invalid_arg\tdi-wastong test argument: {0}\ntest.invalid_signature\tdi-wastong signature ng test function\ntest.io_clean_dir\thindi malinis ang pribadong test directory\ntest.io_clean_image\thindi malinis ang native test image\ntest.io_dir\thindi makagawa ng pribadong test directory\ntest.io_protect\thindi maprotektahan ang pribadong test directory\ntest.missing_target\tkulang ang test target\ntest.no_match\twalang test na tumutugma sa --run={0}\ntest.none\twalang nakitang test\ntest.pass\tPASADO\ntest.resource\tlampas sa limitasyon ng resource\ntest.runtime\truntime error\ntest.skip\tLUMIPAS\ntest.skipped\tMga test na lumipas: {0}\ntest.starting\tSinisimulan ang mga test {0}\ntest.summary\tTapos na ang mga test: {0} pasado, {1} bigo");
    kaesu string.builder_string(output);
}

waza text_fr_fr() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tvérification réussie\ncli.lsp_unknown\targument lsp inconnu : {0}\ncmd.build\tConstruire un exécutable natif ou du bytecode Mochi depuis les sources Mio\ncmd.check\tAnalyser les sources Mio sans produire de sortie\ncmd.disasm\tDésassembler un programme Mochi compilé\ncmd.exec\tExécuter un programme Mochi compilé\ncmd.help\tAfficher l'aide de Mio ou d'une commande\ncmd.lsp\tDémarrer le serveur de langage Mio sur l'entrée/sortie standard\ncmd.run\tConstruire et exécuter un programme Mio depuis les sources\ncmd.test\tDécouvrir et exécuter les paquets de tests Mio\ncmd.version\tAfficher les informations de version\ndiag.cause\tcause\nerr.analysis\tl'analyse des sources a échoué\nerr.bunko_empty\tle chemin Bunko de remplacement doit être explicite et non vide\nerr.chmod_native\timpossible de rendre la sortie native exécutable\nerr.cleanup\tle nettoyage après exécution a échoué\nerr.create_run_dir\timpossible de créer un répertoire d'exécution privé\nerr.emit_mochi\tcette commande ne peut pas produire de bytecode Mochi\nerr.empty_paths\tles chemins source et de sortie doivent être non vides\nerr.gc_stress\t--gc-stress ne s'applique qu'aux constructions natives depuis les sources");
    string.write_string(output, "\nerr.help_args\thelp accepte au plus un nom de commande\nerr.help_unknown\taucune aide pour la commande inconnue : {0}\nerr.host_target\trun et exec nécessitent la cible hôte {0}\nerr.invalid_color\tmode de couleur invalide : {0} (attendu : auto, always ou never)\nerr.invalid_format\tformat invalide : {0} (attendu : human, short ou json)\nerr.invalid_theme\tthème invalide : {0} (attendu : auto, dark ou light)\nerr.missing_value\tvaleur manquante pour l'option {0}\nerr.multiple_entries\tun seul point d'entrée source peut être fourni\nerr.observe\t--observe ne s'applique qu'aux constructions natives darwin-arm64 depuis les sources\nerr.program_args\tles arguments de programme nécessitent run ou exec\nerr.protect_run_dir\timpossible de protéger le répertoire d'exécution privé\nerr.read_mochi\timpossible de lire l'entrée Mochi\nerr.run_output\trun et exec gèrent leur propre sortie native\nerr.spawn\tle programme natif n'a pas pu être démarré\nerr.symbols\t--emit-symbols ne s'applique qu'aux constructions natives darwin-arm64 depuis les sources\nerr.target\tcible non prise en charge : {0} (attendu : darwin-arm64, linux-amd64 ou windows-amd64)\nerr.unknown_command\tcommande inconnue : {0}\nerr.unknown_option\toption inconnue : {0}\nerr.version_args\tla commande version n'accepte aucun argument\nerr.write_disasm\timpossible d'écrire le désassemblage");
    string.write_string(output, "\nerr.write_mochi\timpossible d'écrire la sortie Mochi\nerr.write_native\timpossible d'écrire la sortie native\nhelp.commands\tCommandes\nhelp.examples\tExemples\nhelp.group.compilation\tCompilation\nhelp.group.diagnostics\tDiagnostic\nhelp.group.execution\tExécution\nhelp.group.general\tGénéral\nhelp.group.testing\tTests\nhelp.group.tools\tOutils de développement\nhelp.more\tExécutez 'mio help <commande>' pour le détail d'une commande.\nhelp.options\tOptions\nhelp.tagline\tCompilateur Native AOT et chaîne d'outils pour le langage Mio\nhelp.title\tMio {0}\nhelp.usage\tUtilisation\nopt.bunko\tUtiliser cette racine Bunko au lieu de celle par défaut\nopt.color\tContrôler la couleur : auto, always ou never\nopt.emit\tProduire du bytecode Mochi au lieu d'une image native\nopt.format\tChoisir le format de sortie : human, short ou json\nopt.gc_stress\tConstruire avec des contrôles de stress agressifs du ramasse-miettes");
    string.write_string(output, "\nopt.help\tAfficher l'aide\nopt.lang\tChoisir la langue de sortie par étiquette BCP 47, par exemple ja-JP\nopt.observe\tEnregistrer des observations de construction native\nopt.output\tÉcrire la sortie dans ce chemin\nopt.program_args\tTransmettre les arguments restants au programme\nopt.run_filter\tN'exécuter que les tests dont le nom correspond à cette expression régulière\nopt.stdio\tUtiliser l'entrée/sortie standard pour le serveur de langage\nopt.symbols\tÉcrire les informations de symboles natifs dans ce fichier\nopt.target\tConstruire pour darwin-arm64, linux-amd64 ou windows-amd64\nopt.theme\tChoisir la palette sémantique : auto, dark ou light\nopt.verbose\tAfficher des détails de diagnostic supplémentaires\nopt.version\tAfficher les informations de version\ntest.assertion\téchec d'assertion\ntest.bunko_empty\tle chemin Bunko de remplacement doit être non vide\ntest.bunko_missing\tvaleur manquante pour --bunko-root\ntest.compile_failed\téchec de compilation\ntest.duration\tdurée totale\ntest.empty_filter\tle filtre de test doit être non vide\ntest.empty_lang\tl'étiquette de langue doit être non vide\ntest.fail\tÉCHEC");
    string.write_string(output, "\ntest.filter_invalid\tfiltre de test invalide : {0}\ntest.invalid_arg\targument de test invalide : {0}\ntest.invalid_signature\tsignature de fonction de test invalide\ntest.io_clean_dir\timpossible de nettoyer le répertoire de test privé\ntest.io_clean_image\timpossible de nettoyer l'image de test native\ntest.io_dir\timpossible de créer un répertoire de test privé\ntest.io_protect\timpossible de protéger le répertoire de test privé\ntest.missing_target\tcible de test manquante\ntest.no_match\taucun test ne correspond à --run={0}\ntest.none\taucun test trouvé\ntest.pass\tRÉUSSI\ntest.resource\tlimite de ressources dépassée\ntest.runtime\terreur d'exécution\ntest.skip\tIGNORÉ\ntest.skipped\tTests ignorés : {0}\ntest.starting\tDébut des tests {0}\ntest.summary\tTests terminés : {0} réussis, {1} échoués");
    kaesu string.builder_string(output);
}

