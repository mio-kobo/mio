waza text_ro_ro() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tverificarea a reușit\ncli.lsp_unknown\targument lsp necunoscut: {0}\ncmd.build\tConstruiește un executabil nativ sau bytecode Mochi din sursele Mio\ncmd.check\tAnalizează sursele Mio fără a produce rezultate\ncmd.disasm\tDezasamblează un program Mochi compilat\ncmd.exec\tRulează un program Mochi compilat\ncmd.help\tAfișează ajutorul pentru Mio sau pentru o singură comandă\ncmd.lsp\tPornește serverul de limbaj Mio prin intrarea/ieșirea standard\ncmd.run\tConstruiește și rulează un program Mio din surse\ncmd.test\tDescoperă și rulează pachetele de teste Mio\ncmd.version\tAfișează informațiile despre versiune\ndiag.cause\tcauză\nerr.analysis\tanaliza surselor a eșuat\nerr.bunko_empty\tcalea de înlocuire Bunko trebuie să fie explicită și nevidă\nerr.chmod_native\tnu se poate face executabilă ieșirea nativă\nerr.cleanup\tcurățarea după execuție a eșuat\nerr.create_run_dir\tnu se poate crea un director privat de execuție\nerr.emit_mochi\taceastă comandă nu poate emite bytecode Mochi\nerr.empty_paths\tcăile sursă și de ieșire nu pot fi goale\nerr.gc_stress\t--gc-stress se aplică doar construirilor native din surse");
    string.write_string(output, "\nerr.help_args\thelp acceptă cel mult un nume de comandă\nerr.help_unknown\tnu există ajutor pentru comanda necunoscută: {0}\nerr.host_target\trun și exec necesită ținta gazdă {0}\nerr.invalid_color\tmod de culoare nevalid: {0} (se aștepta auto, always sau never)\nerr.invalid_format\tformat nevalid: {0} (se aștepta human, short sau json)\nerr.invalid_theme\ttemă nevalidă: {0} (se aștepta auto, dark sau light)\nerr.missing_value\tlipsește valoarea pentru opțiunea {0}\nerr.multiple_entries\tse poate indica o singură intrare sursă\nerr.observe\t--observe se aplică doar construirilor native darwin-arm64 din surse\nerr.program_args\targumentele de program necesită run sau exec\nerr.protect_run_dir\tnu se poate proteja directorul privat de execuție\nerr.read_mochi\tnu se poate citi intrarea Mochi\nerr.run_output\trun și exec își gestionează propria ieșire nativă\nerr.spawn\tprogramul nativ nu a putut fi pornit\nerr.symbols\t--emit-symbols se aplică doar construirilor native darwin-arm64 din surse\nerr.target\tțintă neacceptată: {0} (se aștepta darwin-arm64, linux-amd64 sau windows-amd64)\nerr.unknown_command\tcomandă necunoscută: {0}\nerr.unknown_option\topțiune necunoscută: {0}\nerr.version_args\tcomanda version nu acceptă argumente\nerr.write_disasm\tnu se poate scrie dezasamblarea");
    string.write_string(output, "\nerr.write_mochi\tnu se poate scrie ieșirea Mochi\nerr.write_native\tnu se poate scrie ieșirea nativă\nhelp.commands\tComenzi\nhelp.examples\tExemple\nhelp.group.compilation\tCompilare\nhelp.group.diagnostics\tDiagnosticare\nhelp.group.execution\tExecuție\nhelp.group.general\tGeneral\nhelp.group.testing\tTeste\nhelp.group.tools\tInstrumente de dezvoltare\nhelp.more\tRulați 'mio help <comandă>' pentru detalii despre o comandă.\nhelp.options\tOpțiuni\nhelp.tagline\tCompilator Native AOT și set de instrumente pentru limbajul Mio\nhelp.title\tMio {0}\nhelp.usage\tUtilizare\nopt.bunko\tFolosește această rădăcină Bunko în locul celei implicite\nopt.color\tControlează ieșirea colorată: auto, always sau never\nopt.emit\tEmite bytecode Mochi în locul unei imagini native\nopt.format\tAlege formatul rezultatelor: human, short sau json\nopt.gc_stress\tConstruiește cu verificări agresive de stres ale colectorului de gunoi");
    string.write_string(output, "\nopt.help\tAfișează ajutorul\nopt.lang\tAlege limba rezultatelor printr-o etichetă BCP 47, de exemplu ja-JP\nopt.observe\tÎnregistrează observații ale construirii native\nopt.output\tScrie rezultatele în această cale\nopt.program_args\tTransmite argumentele rămase programului\nopt.run_filter\tRulează doar testele ale căror nume corespund acestei expresii regulate\nopt.stdio\tFolosește intrarea și ieșirea standard pentru serverul de limbaj\nopt.symbols\tScrie informațiile despre simbolurile native în acest fișier\nopt.target\tConstruiește pentru darwin-arm64, linux-amd64 sau windows-amd64\nopt.theme\tAlege paleta semantică: auto, dark sau light\nopt.verbose\tInclude detalii suplimentare de diagnosticare\nopt.version\tAfișează informațiile despre versiune\ntest.assertion\taserțiunea a eșuat\ntest.bunko_empty\tcalea de înlocuire Bunko nu poate fi goală\ntest.bunko_missing\tlipsește valoarea pentru --bunko-root\ntest.compile_failed\tcompilarea a eșuat\ntest.duration\tdurata totală\ntest.empty_filter\tfiltrul de teste nu poate fi gol\ntest.empty_lang\teticheta de limbă nu poate fi goală\ntest.fail\tEȘUAT");
    string.write_string(output, "\ntest.filter_invalid\tfiltru de teste nevalid: {0}\ntest.invalid_arg\targument de test nevalid: {0}\ntest.invalid_signature\tsemnătură nevalidă a funcției de test\ntest.io_clean_dir\tnu se poate curăța directorul privat de teste\ntest.io_clean_image\tnu se poate curăța imaginea de test nativă\ntest.io_dir\tnu se poate crea un director privat de teste\ntest.io_protect\tnu se poate proteja directorul privat de teste\ntest.missing_target\tlipsește ținta testelor\ntest.no_match\tniciun test nu corespunde cu --run={0}\ntest.none\tnu s-au găsit teste\ntest.pass\tREUȘIT\ntest.resource\tlimita de resurse a fost depășită\ntest.runtime\teroare de execuție\ntest.skip\tOMIS\ntest.skipped\tTeste omise: {0}\ntest.starting\tSe încep testele {0}\ntest.summary\tTeste finalizate: {0} reușite, {1} eșuate");
    kaesu string.builder_string(output);
}

waza text_ru_ru() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tпроверка пройдена\ncli.lsp_unknown\tнеизвестный аргумент lsp: {0}\ncmd.build\tСобрать нативный исполняемый файл или байт-код Mochi из исходников Mio\ncmd.check\tПроанализировать исходники Mio без создания выходных файлов\ncmd.disasm\tДизассемблировать скомпилированную программу Mochi\ncmd.exec\tЗапустить скомпилированную программу Mochi\ncmd.help\tПоказать справку по Mio или по одной команде\ncmd.lsp\tЗапустить языковой сервер Mio через стандартный ввод-вывод\ncmd.run\tСобрать и запустить программу Mio из исходников\ncmd.test\tНайти и запустить тестовые пакеты Mio\ncmd.version\tПоказать сведения о версии\ndiag.cause\tпричина\nerr.analysis\tне удалось проанализировать исходники\nerr.bunko_empty\tпереопределённый путь Bunko должен быть явным и непустым\nerr.chmod_native\tне удалось сделать нативный вывод исполняемым\nerr.cleanup\tне удалось очистить временные файлы после запуска\nerr.create_run_dir\tне удалось создать закрытый каталог запуска\nerr.emit_mochi\tэта команда не может выдавать байт-код Mochi\nerr.empty_paths\tпути исходников и вывода не должны быть пустыми\nerr.gc_stress\t--gc-stress применяется только к нативным сборкам из исходников");
    string.write_string(output, "\nerr.help_args\thelp принимает не более одного имени команды\nerr.help_unknown\tнет справки для неизвестной команды: {0}\nerr.host_target\trun и exec требуют целевой платформы хоста {0}\nerr.invalid_color\tнедопустимый режим цвета: {0} (ожидается auto, always или never)\nerr.invalid_format\tнедопустимый формат: {0} (ожидается human, short или json)\nerr.invalid_theme\tнедопустимая тема: {0} (ожидается auto, dark или light)\nerr.missing_value\tотсутствует значение параметра {0}\nerr.multiple_entries\tможно указать только один исходный файл\nerr.observe\t--observe применяется только к нативным сборкам darwin-arm64 из исходников\nerr.program_args\tаргументы программы требуются только для run или exec\nerr.protect_run_dir\tне удалось защитить закрытый каталог запуска\nerr.read_mochi\tне удалось прочитать входные данные Mochi\nerr.run_output\trun и exec сами управляют нативным выводом\nerr.spawn\tне удалось запустить нативную программу\nerr.symbols\t--emit-symbols применяется только к нативным сборкам darwin-arm64 из исходников\nerr.target\tнеподдерживаемая цель: {0} (ожидается darwin-arm64, linux-amd64 или windows-amd64)\nerr.unknown_command\tнеизвестная команда: {0}\nerr.unknown_option\tнеизвестный параметр: {0}\nerr.version_args\tкоманда version не принимает аргументов\nerr.write_disasm\tне удалось записать дизассемблирование");
    string.write_string(output, "\nerr.write_mochi\tне удалось записать вывод Mochi\nerr.write_native\tне удалось записать нативный вывод\nhelp.commands\tКоманды\nhelp.examples\tПримеры\nhelp.group.compilation\tКомпиляция\nhelp.group.diagnostics\tДиагностика\nhelp.group.execution\tВыполнение\nhelp.group.general\tОбщие\nhelp.group.testing\tТесты\nhelp.group.tools\tИнструменты разработки\nhelp.more\tВыполните 'mio help <команда>', чтобы узнать подробности о команде.\nhelp.options\tПараметры\nhelp.tagline\tКомпилятор Native AOT и инструменты для языка Mio\nhelp.title\tMio {0}\nhelp.usage\tИспользование\nopt.bunko\tИспользовать этот корень Bunko вместо стандартного\nopt.color\tУправлять цветным выводом: auto, always или never\nopt.emit\tВыдать байт-код Mochi вместо нативного образа\nopt.format\tВыбрать формат вывода: human, short или json\nopt.gc_stress\tСобрать с усиленными проверками нагрузки сборщика мусора");
    string.write_string(output, "\nopt.help\tПоказать справку\nopt.lang\tВыбрать язык вывода по тегу BCP 47, например ja-JP\nopt.observe\tЗаписывать наблюдения за нативной сборкой\nopt.output\tЗаписать вывод по этому пути\nopt.program_args\tПередать оставшиеся аргументы программе\nopt.run_filter\tЗапускать только тесты, имена которых соответствуют этому регулярному выражению\nopt.stdio\tИспользовать стандартный ввод-вывод для языкового сервера\nopt.symbols\tЗаписать сведения о нативных символах в этот файл\nopt.target\tСобрать для darwin-arm64, linux-amd64 или windows-amd64\nopt.theme\tВыбрать смысловую палитру: auto, dark или light\nopt.verbose\tПоказывать дополнительные сведения диагностики\nopt.version\tПоказать сведения о версии\ntest.assertion\tошибка проверки\ntest.bunko_empty\tпереопределённый путь Bunko не должен быть пустым\ntest.bunko_missing\tотсутствует значение --bunko-root\ntest.compile_failed\tошибка компиляции\ntest.duration\tобщая длительность\ntest.empty_filter\tфильтр тестов не должен быть пустым\ntest.empty_lang\tязыковой тег не должен быть пустым\ntest.fail\tСБОЙ");
    string.write_string(output, "\ntest.filter_invalid\tнедопустимый фильтр тестов: {0}\ntest.invalid_arg\tнедопустимый аргумент теста: {0}\ntest.invalid_signature\tнедопустимая сигнатура тестовой функции\ntest.io_clean_dir\tне удалось удалить закрытый каталог тестов\ntest.io_clean_image\tне удалось удалить нативный тестовый образ\ntest.io_dir\tне удалось создать закрытый каталог тестов\ntest.io_protect\tне удалось защитить закрытый каталог тестов\ntest.missing_target\tне указана цель тестирования\ntest.no_match\tнет тестов, соответствующих --run={0}\ntest.none\tтесты не найдены\ntest.pass\tУСПЕХ\ntest.resource\tпревышен лимит ресурсов\ntest.runtime\tошибка выполнения\ntest.skip\tПРОПУЩЕН\ntest.skipped\tПропущено тестов: {0}\ntest.starting\tНачало тестов {0}\ntest.summary\tТесты завершены: успешно {0}, с ошибками {1}");
    kaesu string.builder_string(output);
}

waza text_sv_se() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tkontrollen godkändes\ncli.lsp_unknown\tokänt lsp-argument: {0}\ncmd.build\tBygg en inbyggd körbar fil eller Mochi-bytekod från Mio-källkod\ncmd.check\tAnalysera Mio-källkod utan att producera utdata\ncmd.disasm\tDisassemblera ett kompilerat Mochi-program\ncmd.exec\tKör ett kompilerat Mochi-program\ncmd.help\tVisa hjälp för Mio eller ett enskilt kommando\ncmd.lsp\tStarta Mio-språkservern över standard in- och utdata\ncmd.run\tBygg och kör ett Mio-program från källkod\ncmd.test\tHitta och kör Mio-testpaket\ncmd.version\tVisa versionsinformation\ndiag.cause\torsak\nerr.analysis\tkällkodsanalysen misslyckades\nerr.bunko_empty\tBunko-överstyrningens sökväg måste vara explicit och inte tom\nerr.chmod_native\tkan inte göra inbyggd utdata körbar\nerr.cleanup\tstädning efter körningen misslyckades\nerr.create_run_dir\tkan inte skapa en privat körningskatalog\nerr.emit_mochi\tdetta kommando kan inte skriva Mochi-bytekod\nerr.empty_paths\tkäll- och utdatasökvägarna får inte vara tomma\nerr.gc_stress\t--gc-stress gäller endast inbyggda byggen från källkod");
    string.write_string(output, "\nerr.help_args\thelp tar högst ett kommandonamn\nerr.help_unknown\tingen hjälp för okänt kommando: {0}\nerr.host_target\trun och exec kräver värdmålet {0}\nerr.invalid_color\togiltigt färgläge: {0} (förväntade auto, always eller never)\nerr.invalid_format\togiltigt format: {0} (förväntade human, short eller json)\nerr.invalid_theme\togiltigt tema: {0} (förväntade auto, dark eller light)\nerr.missing_value\tvärde saknas för alternativet {0}\nerr.multiple_entries\tendast en källpost får anges\nerr.observe\t--observe gäller endast inbyggda darwin-arm64-byggen från källkod\nerr.program_args\tprogramargument kräver run eller exec\nerr.protect_run_dir\tkan inte skydda den privata körningskatalogen\nerr.read_mochi\tkan inte läsa Mochi-indata\nerr.run_output\trun och exec hanterar sin egen native utdata\nerr.spawn\tdet inbyggda programmet kunde inte startas\nerr.symbols\t--emit-symbols gäller endast inbyggda darwin-arm64-byggen från källkod\nerr.target\tmål som inte stöds: {0} (förväntade darwin-arm64, linux-amd64 eller windows-amd64)\nerr.unknown_command\tokänt kommando: {0}\nerr.unknown_option\tokänt alternativ: {0}\nerr.version_args\tkommandot version tar inga argument\nerr.write_disasm\tkan inte skriva disassembleringen");
    string.write_string(output, "\nerr.write_mochi\tkan inte skriva Mochi-utdata\nerr.write_native\tkan inte skriva inbyggd utdata\nhelp.commands\tKommandon\nhelp.examples\tExempel\nhelp.group.compilation\tKompilering\nhelp.group.diagnostics\tDiagnostik\nhelp.group.execution\tKörning\nhelp.group.general\tAllmänt\nhelp.group.testing\tTester\nhelp.group.tools\tUtvecklingsverktyg\nhelp.more\tKör 'mio help <kommando>' för information om ett kommando.\nhelp.options\tAlternativ\nhelp.tagline\tNative AOT-kompilator och verktygskedja för språket Mio\nhelp.title\tMio {0}\nhelp.usage\tAnvändning\nopt.bunko\tAnvänd denna Bunko-rot i stället för standard\nopt.color\tStyr färgutdata: auto, always eller never\nopt.emit\tSkriv Mochi-bytekod i stället för en inbyggd avbildning\nopt.format\tVälj utdataformat: human, short eller json\nopt.gc_stress\tBygg med aggressiva stresstester för skräpsamlaren");
    string.write_string(output, "\nopt.help\tVisa hjälp\nopt.lang\tVälj utdataspråk med BCP 47-tagg, till exempel ja-JP\nopt.observe\tRegistrera observationer från den inbyggda byggprocessen\nopt.output\tSkriv utdata till denna sökväg\nopt.program_args\tSkicka resterande argument till programmet\nopt.run_filter\tKör endast tester vars namn matchar detta reguljära uttryck\nopt.stdio\tAnvänd standard in- och utdata för språkservern\nopt.symbols\tSkriv inbyggd symbolinformation till denna fil\nopt.target\tBygg för darwin-arm64, linux-amd64 eller windows-amd64\nopt.theme\tVälj semantiskt färgschema: auto, dark eller light\nopt.verbose\tVisa ytterligare diagnostikdetaljer\nopt.version\tVisa versionsinformation\ntest.assertion\tpåståendet misslyckades\ntest.bunko_empty\tBunko-överstyrningens sökväg får inte vara tom\ntest.bunko_missing\tvärde saknas för --bunko-root\ntest.compile_failed\tkompileringen misslyckades\ntest.duration\ttotal varaktighet\ntest.empty_filter\ttestfiltret får inte vara tomt\ntest.empty_lang\tspråktaggen får inte vara tom\ntest.fail\tMISSLYCKAD");
    string.write_string(output, "\ntest.filter_invalid\togiltigt testfilter: {0}\ntest.invalid_arg\togiltigt testargument: {0}\ntest.invalid_signature\togiltig signatur för testfunktion\ntest.io_clean_dir\tkan inte rensa den privata testkatalogen\ntest.io_clean_image\tkan inte rensa den inbyggda testavbildningen\ntest.io_dir\tkan inte skapa en privat testkatalog\ntest.io_protect\tkan inte skydda den privata testkatalogen\ntest.missing_target\ttestmål saknas\ntest.no_match\tinga tester matchar --run={0}\ntest.none\tinga tester hittades\ntest.pass\tGODKÄND\ntest.resource\tresursgränsen överskreds\ntest.runtime\tkörtidsfel\ntest.skip\tÖVERHOPPAD\ntest.skipped\tÖverhoppade tester: {0}\ntest.starting\tStartar tester {0}\ntest.summary\tTester klara: {0} godkända, {1} misslyckade");
    kaesu string.builder_string(output);
}

waza text_ta_in() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tசரிபார்ப்பு தேர்ச்சி\ncli.lsp_unknown\tஅறியப்படாத lsp வாதம்: {0}\ncmd.build\tMio மூலத்திலிருந்து நேட்டிவ் இயங்குநிரல் அல்லது Mochi பைட்கோடை உருவாக்கு\ncmd.check\tவெளியீடு இல்லாமல் Mio மூலத்தை பகுப்பாய்வு செய்\ncmd.disasm\tதொகுக்கப்பட்ட Mochi நிரலை பிரித்தெழுது\ncmd.exec\tதொகுக்கப்பட்ட Mochi நிரலை இயக்கு\ncmd.help\tMio அல்லது ஒரு கட்டளைக்கான உதவியைக் காட்டு\ncmd.lsp\tநிலையான உள்ளீடு/வெளியீட்டில் Mio மொழி சேவையகத்தைத் தொடங்கு\ncmd.run\tமூலத்திலிருந்து Mio நிரலை உருவாக்கி இயக்கு\ncmd.test\tMio சோதனைத் தொகுப்புகளைக் கண்டறிந்து இயக்கு\ncmd.version\tபதிப்புத் தகவலைக் காட்டு\ndiag.cause\tகாரணம்\nerr.analysis\tமூலப் பகுப்பாய்வு தோல்வியடைந்தது\nerr.bunko_empty\tBunko மேலெழுதல் பாதை வெளிப்படையாகவும் காலியாக இல்லாமலும் இருக்க வேண்டும்\nerr.chmod_native\tநேட்டிவ் வெளியீட்டை இயக்கக்கூடியதாக்க முடியவில்லை\nerr.cleanup\tஇயக்கத்திற்குப் பின் சுத்தம் செய்வது தோல்வியடைந்தது\nerr.create_run_dir\tதனிப்பட்ட இயக்க கோப்பகத்தை உருவாக்க முடியவில்லை\nerr.emit_mochi\tஇந்தக் கட்டளை Mochi பைட்கோடை வெளியிட முடியாது\nerr.empty_paths\tமூல மற்றும் வெளியீட்டு பாதைகள் காலியாக இருக்கக்கூடாது\nerr.gc_stress\t--gc-stress மூலத்திலிருந்து நேட்டிவ் உருவாக்கங்களுக்கு மட்டுமே பொருந்தும்");
    string.write_string(output, "\nerr.help_args\thelp அதிகபட்சம் ஒரு கட்டளைப் பெயரை ஏற்கும்\nerr.help_unknown\tஅறியப்படாத கட்டளைக்கு உதவி இல்லை: {0}\nerr.host_target\trun மற்றும் exec க்கு ஹோஸ்ட் இலக்கு {0} தேவை\nerr.invalid_color\tதவறான வண்ணப் பயன்முறை: {0} (auto, always அல்லது never எதிர்பார்க்கப்படுகிறது)\nerr.invalid_format\tதவறான வடிவம்: {0} (human, short அல்லது json எதிர்பார்க்கப்படுகிறது)\nerr.invalid_theme\tதவறான தீம்: {0} (auto, dark அல்லது light எதிர்பார்க்கப்படுகிறது)\nerr.missing_value\tவிருப்பம் {0} க்கு மதிப்பு இல்லை\nerr.multiple_entries\tஒரே ஒரு மூல உள்ளீட்டை மட்டும் தரலாம்\nerr.observe\t--observe மூலத்திலிருந்து darwin-arm64 நேட்டிவ் உருவாக்கங்களுக்கு மட்டுமே பொருந்தும்\nerr.program_args\tநிரல் வாதங்களுக்கு run அல்லது exec தேவை\nerr.protect_run_dir\tதனிப்பட்ட இயக்க கோப்பகத்தைப் பாதுகாக்க முடியவில்லை\nerr.read_mochi\tMochi உள்ளீட்டைப் படிக்க முடியவில்லை\nerr.run_output\trun மற்றும் exec தங்கள் சொந்த நேட்டிவ் வெளியீட்டை நிர்வகிக்கும்\nerr.spawn\tநேட்டிவ் நிரலைத் தொடங்க முடியவில்லை\nerr.symbols\t--emit-symbols மூலத்திலிருந்து darwin-arm64 நேட்டிவ் உருவாக்கங்களுக்கு மட்டுமே பொருந்தும்\nerr.target\tஆதரிக்கப்படாத இலக்கு: {0} (darwin-arm64, linux-amd64 அல்லது windows-amd64 எதிர்பார்க்கப்படுகிறது)\nerr.unknown_command\tஅறியப்படாத கட்டளை: {0}\nerr.unknown_option\tஅறியப்படாத விருப்பம்: {0}\nerr.version_args\tversion கட்டளை வாதங்களை ஏற்காது\nerr.write_disasm\tபிரித்தெழுதலை எழுத முடியவில்லை");
    string.write_string(output, "\nerr.write_mochi\tMochi வெளியீட்டை எழுத முடியவில்லை\nerr.write_native\tநேட்டிவ் வெளியீட்டை எழுத முடியவில்லை\nhelp.commands\tகட்டளைகள்\nhelp.examples\tஎடுத்துக்காட்டுகள்\nhelp.group.compilation\tதொகுப்பு\nhelp.group.diagnostics\tபரிசோதனை\nhelp.group.execution\tஇயக்கம்\nhelp.group.general\tபொது\nhelp.group.testing\tசோதனைகள்\nhelp.group.tools\tஉருவாக்கக் கருவிகள்\nhelp.more\tஒரு கட்டளையின் விவரங்களுக்கு 'mio help <கட்டளை>' இயக்கவும்.\nhelp.options\tவிருப்பங்கள்\nhelp.tagline\tMio மொழிக்கான Native AOT தொகுப்பி மற்றும் கருவித்தொகுப்பு\nhelp.title\tMio {0}\nhelp.usage\tபயன்பாடு\nopt.bunko\tஇயல்புநிலைக்குப் பதிலாக இந்த Bunko மூலத்தைப் பயன்படுத்து\nopt.color\tவண்ண வெளியீட்டைக் கட்டுப்படுத்து: auto, always அல்லது never\nopt.emit\tநேட்டிவ் படத்திற்குப் பதிலாக Mochi பைட்கோடை வெளியிடு\nopt.format\tவெளியீட்டு வடிவத்தைத் தேர்ந்தெடு: human, short அல்லது json\nopt.gc_stress\tதீவிர குப்பை சேகரிப்பு அழுத்தச் சோதனைகளுடன் உருவாக்கு");
    string.write_string(output, "\nopt.help\tஉதவியைக் காட்டு\nopt.lang\tBCP 47 குறிச்சொல் மூலம் வெளியீட்டு மொழியைத் தேர்ந்தெடு, எடுத்துக்காட்டாக ja-JP\nopt.observe\tநேட்டிவ் உருவாக்கக் கண்காணிப்புகளைப் பதிவு செய்\nopt.output\tவெளியீட்டை இந்த பாதையில் எழுது\nopt.program_args\tமீதமுள்ள வாதங்களை நிரலுக்கு அனுப்பு\nopt.run_filter\tஇந்த வழக்கமான வெளிப்பாட்டுடன் பெயர் பொருந்தும் சோதனைகளை மட்டும் இயக்கு\nopt.stdio\tமொழி சேவையகத்திற்கு நிலையான உள்ளீடு மற்றும் வெளியீட்டைப் பயன்படுத்து\nopt.symbols\tநேட்டிவ் குறியீட்டுத் தகவலை இந்தக் கோப்பில் எழுது\nopt.target\tdarwin-arm64, linux-amd64 அல்லது windows-amd64 க்காக உருவாக்கு\nopt.theme\tபொருள்சார் வண்ணத் தட்டைத் தேர்ந்தெடு: auto, dark அல்லது light\nopt.verbose\tகூடுதல் பரிசோதனை விவரங்களைச் சேர்\nopt.version\tபதிப்புத் தகவலைக் காட்டு\ntest.assertion\tஉறுதிப்படுத்தல் தோல்வி\ntest.bunko_empty\tBunko மேலெழுதல் பாதை காலியாக இருக்கக்கூடாது\ntest.bunko_missing\t--bunko-root க்கு மதிப்பு இல்லை\ntest.compile_failed\tதொகுப்பு தோல்வியடைந்தது\ntest.duration\tமொத்த காலம்\ntest.empty_filter\tசோதனை வடிகட்டி காலியாக இருக்கக்கூடாது\ntest.empty_lang\tமொழிக் குறிச்சொல் காலியாக இருக்கக்கூடாது\ntest.fail\tதோல்வி");
    string.write_string(output, "\ntest.filter_invalid\tதவறான சோதனை வடிகட்டி: {0}\ntest.invalid_arg\tதவறான சோதனை வாதம்: {0}\ntest.invalid_signature\tசோதனை சார்பு கையொப்பம் தவறானது\ntest.io_clean_dir\tதனிப்பட்ட சோதனை கோப்பகத்தைச் சுத்தம் செய்ய முடியவில்லை\ntest.io_clean_image\tநேட்டிவ் சோதனை படத்தைச் சுத்தம் செய்ய முடியவில்லை\ntest.io_dir\tதனிப்பட்ட சோதனை கோப்பகத்தை உருவாக்க முடியவில்லை\ntest.io_protect\tதனிப்பட்ட சோதனை கோப்பகத்தைப் பாதுகாக்க முடியவில்லை\ntest.missing_target\tசோதனை இலக்கு இல்லை\ntest.no_match\t--run={0} உடன் பொருந்தும் சோதனை இல்லை\ntest.none\tசோதனைகள் எதுவும் கிடைக்கவில்லை\ntest.pass\tதேர்ச்சி\ntest.resource\tவள வரம்பு மீறப்பட்டது\ntest.runtime\tஇயக்கநேர பிழை\ntest.skip\tதவிர்க்கப்பட்டது\ntest.skipped\tதவிர்க்கப்பட்ட சோதனைகள்: {0}\ntest.starting\tசோதனைகள் தொடங்குகின்றன {0}\ntest.summary\tசோதனைகள் முடிந்தன: {0} தேர்ச்சி, {1} தோல்வி");
    kaesu string.builder_string(output);
}

waza text_te_in() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tతనిఖీ ఉత్తీర్ణమైంది\ncli.lsp_unknown\tతెలియని lsp ఆర్గ్యుమెంట్: {0}\ncmd.build\tMio మూలం నుండి నేటివ్ ఎగ్జిక్యూటబుల్ లేదా Mochi బైట్‌కోడ్ నిర్మించు\ncmd.check\tఫలితం సృష్టించకుండా Mio మూలాన్ని విశ్లేషించు\ncmd.disasm\tకంపైల్ చేసిన Mochi ప్రోగ్రామ్‌ను డిస్‌అసెంబుల్ చేయు\ncmd.exec\tకంపైల్ చేసిన Mochi ప్రోగ్రామ్‌ను అమలు చేయు\ncmd.help\tMio లేదా ఒక ఆదేశం కోసం సహాయం చూపించు\ncmd.lsp\tప్రామాణిక ఇన్‌పుట్/అవుట్‌పుట్‌పై Mio భాషా సర్వర్ ప్రారంభించు\ncmd.run\tమూలం నుండి Mio ప్రోగ్రామ్‌ను నిర్మించి అమలు చేయు\ncmd.test\tMio పరీక్ష ప్యాకేజీలను కనుగొని అమలు చేయు\ncmd.version\tవెర్షన్ సమాచారం చూపించు\ndiag.cause\tకారణం\nerr.analysis\tమూల విశ్లేషణ విఫలమైంది\nerr.bunko_empty\tBunko ఓవర్‌రైడ్ మార్గం స్పష్టంగా మరియు ఖాళీగా లేకుండా ఉండాలి\nerr.chmod_native\tనేటివ్ అవుట్‌పుట్‌ను అమలు చేయగలిగేలా చేయలేకపోయాము\nerr.cleanup\tఅమలు తర్వాత శుభ్రత విఫలమైంది\nerr.create_run_dir\tప్రైవేట్ అమలు డైరెక్టరీ సృష్టించలేకపోయాము\nerr.emit_mochi\tఈ ఆదేశం Mochi బైట్‌కోడ్ ఇవ్వలేదు\nerr.empty_paths\tమూలం మరియు అవుట్‌పుట్ మార్గాలు ఖాళీగా ఉండకూడదు\nerr.gc_stress\t--gc-stress మూలం నుండి నేటివ్ నిర్మాణాలకు మాత్రమే వర్తిస్తుంది");
    string.write_string(output, "\nerr.help_args\thelp గరిష్ఠంగా ఒక ఆదేశ పేరు తీసుకుంటుంది\nerr.help_unknown\tతెలియని ఆదేశానికి సహాయం లేదు: {0}\nerr.host_target\trun మరియు exec కు హోస్ట్ లక్ష్యం {0} అవసరం\nerr.invalid_color\tచెల్లని రంగు మోడ్: {0} (auto, always లేదా never ఆశించబడింది)\nerr.invalid_format\tచెల్లని ఆకృతి: {0} (human, short లేదా json ఆశించబడింది)\nerr.invalid_theme\tచెల్లని థీమ్: {0} (auto, dark లేదా light ఆశించబడింది)\nerr.missing_value\tఎంపిక {0} కు విలువ లేదు\nerr.multiple_entries\tఒకే ఒక మూల ఎంట్రీ ఇవ్వవచ్చు\nerr.observe\t--observe మూలం నుండి darwin-arm64 నేటివ్ నిర్మాణాలకు మాత్రమే వర్తిస్తుంది\nerr.program_args\tప్రోగ్రామ్ ఆర్గ్యుమెంట్‌లకు run లేదా exec అవసరం\nerr.protect_run_dir\tప్రైవేట్ అమలు డైరెక్టరీని రక్షించలేకపోయాము\nerr.read_mochi\tMochi ఇన్‌పుట్ చదవలేకపోయాము\nerr.run_output\trun మరియు exec తమ స్వంత నేటివ్ అవుట్‌పుట్‌ను నిర్వహిస్తాయి\nerr.spawn\tనేటివ్ ప్రోగ్రామ్ ప్రారంభించలేకపోయాము\nerr.symbols\t--emit-symbols మూలం నుండి darwin-arm64 నేటివ్ నిర్మాణాలకు మాత్రమే వర్తిస్తుంది\nerr.target\tమద్దతు లేని లక్ష్యం: {0} (darwin-arm64, linux-amd64 లేదా windows-amd64 ఆశించబడింది)\nerr.unknown_command\tతెలియని ఆదేశం: {0}\nerr.unknown_option\tతెలియని ఎంపిక: {0}\nerr.version_args\tversion ఆదేశం ఆర్గ్యుమెంట్‌లు తీసుకోదు\nerr.write_disasm\tడిస్‌అసెంబ్లీ రాయలేకపోయాము");
    string.write_string(output, "\nerr.write_mochi\tMochi అవుట్‌పుట్ రాయలేకపోయాము\nerr.write_native\tనేటివ్ అవుట్‌పుట్ రాయలేకపోయాము\nhelp.commands\tఆదేశాలు\nhelp.examples\tఉదాహరణలు\nhelp.group.compilation\tకంపైలేషన్\nhelp.group.diagnostics\tనిర్ధారణ\nhelp.group.execution\tఅమలు\nhelp.group.general\tసాధారణం\nhelp.group.testing\tపరీక్షలు\nhelp.group.tools\tఅభివృద్ధి సాధనాలు\nhelp.more\tఆదేశ వివరాల కోసం 'mio help <ఆదేశం>' అమలు చేయండి.\nhelp.options\tఎంపికలు\nhelp.tagline\tMio భాష కోసం Native AOT కంపైలర్ మరియు సాధనాల సముదాయం\nhelp.title\tMio {0}\nhelp.usage\tవినియోగం\nopt.bunko\tడిఫాల్ట్‌కు బదులు ఈ Bunko మూలాన్ని ఉపయోగించు\nopt.color\tరంగు అవుట్‌పుట్‌ను నియంత్రించండి: auto, always లేదా never\nopt.emit\tనేటివ్ ఇమేజ్‌కు బదులు Mochi బైట్‌కోడ్ ఇవ్వు\nopt.format\tఅవుట్‌పుట్ ఆకృతిని ఎంచుకోండి: human, short లేదా json\nopt.gc_stress\tతీవ్ర చెత్త సేకరణ ఒత్తిడి పరీక్షలతో నిర్మించు");
    string.write_string(output, "\nopt.help\tసహాయం చూపించు\nopt.lang\tBCP 47 ట్యాగ్‌తో అవుట్‌పుట్ భాషను ఎంచుకోండి, ఉదా. ja-JP\nopt.observe\tనేటివ్ నిర్మాణ పరిశీలనలను నమోదు చేయు\nopt.output\tఅవుట్‌పుట్‌ను ఈ మార్గంలో రాయి\nopt.program_args\tమిగిలిన ఆర్గ్యుమెంట్‌లను ప్రోగ్రామ్‌కు పంపు\nopt.run_filter\tపేరు ఈ రెగ్యులర్ ఎక్స్‌ప్రెషన్‌కు సరిపోయే పరీక్షలను మాత్రమే అమలు చేయు\nopt.stdio\tభాషా సర్వర్ కోసం ప్రామాణిక ఇన్‌పుట్ మరియు అవుట్‌పుట్ ఉపయోగించు\nopt.symbols\tనేటివ్ చిహ్న సమాచారాన్ని ఈ ఫైల్‌లో రాయి\nopt.target\tdarwin-arm64, linux-amd64 లేదా windows-amd64 కోసం నిర్మించు\nopt.theme\tఅర్థపూర్ణ రంగు ప్యాలెట్‌ను ఎంచుకోండి: auto, dark లేదా light\nopt.verbose\tఅదనపు నిర్ధారణ వివరాలు చేర్చు\nopt.version\tవెర్షన్ సమాచారం చూపించు\ntest.assertion\tధృవీకరణ విఫలమైంది\ntest.bunko_empty\tBunko ఓవర్‌రైడ్ మార్గం ఖాళీగా ఉండకూడదు\ntest.bunko_missing\t--bunko-root కు విలువ లేదు\ntest.compile_failed\tకంపైలేషన్ విఫలమైంది\ntest.duration\tమొత్తం వ్యవధి\ntest.empty_filter\tపరీక్ష ఫిల్టర్ ఖాళీగా ఉండకూడదు\ntest.empty_lang\tభాషా ట్యాగ్ ఖాళీగా ఉండకూడదు\ntest.fail\tవిఫలం");
    string.write_string(output, "\ntest.filter_invalid\tచెల్లని పరీక్ష ఫిల్టర్: {0}\ntest.invalid_arg\tచెల్లని పరీక్ష ఆర్గ్యుమెంట్: {0}\ntest.invalid_signature\tపరీక్ష ఫంక్షన్ సంతకం చెల్లదు\ntest.io_clean_dir\tప్రైవేట్ పరీక్ష డైరెక్టరీని శుభ్రం చేయలేకపోయాము\ntest.io_clean_image\tనేటివ్ పరీక్ష ఇమేజ్‌ను శుభ్రం చేయలేకపోయాము\ntest.io_dir\tప్రైవేట్ పరీక్ష డైరెక్టరీ సృష్టించలేకపోయాము\ntest.io_protect\tప్రైవేట్ పరీక్ష డైరెక్టరీని రక్షించలేకపోయాము\ntest.missing_target\tపరీక్ష లక్ష్యం లేదు\ntest.no_match\t--run={0} తో సరిపోయే పరీక్షలు లేవు\ntest.none\tపరీక్షలు కనుగొనబడలేదు\ntest.pass\tఉత్తీర్ణం\ntest.resource\tవనరుల పరిమితి మించింది\ntest.runtime\tరన్‌టైమ్ లోపం\ntest.skip\tదాటవేయబడింది\ntest.skipped\tదాటవేసిన పరీక్షలు: {0}\ntest.starting\tపరీక్షలు ప్రారంభం {0}\ntest.summary\tపరీక్షలు పూర్తయ్యాయి: {0} ఉత్తీర్ణం, {1} విఫలం");
    kaesu string.builder_string(output);
}

waza text_th_th() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tตรวจสอบผ่าน\ncli.lsp_unknown\tอาร์กิวเมนต์ lsp ที่ไม่รู้จัก: {0}\ncmd.build\tสร้างไฟล์เรียกทำงานเนทีฟหรือไบต์โค้ด Mochi จากซอร์ส Mio\ncmd.check\tวิเคราะห์ซอร์ส Mio โดยไม่สร้างเอาต์พุต\ncmd.disasm\tถอดรหัสโปรแกรม Mochi ที่คอมไพล์แล้ว\ncmd.exec\tเรียกใช้โปรแกรม Mochi ที่คอมไพล์แล้ว\ncmd.help\tแสดงความช่วยเหลือสำหรับ Mio หรือคำสั่งเดียว\ncmd.lsp\tเริ่มเซิร์ฟเวอร์ภาษ Mio ผ่านอินพุต/เอาต์พุตมาตรฐาน\ncmd.run\tสร้างและเรียกใช้โปรแกรม Mio จากซอร์ส\ncmd.test\tค้นหาและเรียกใช้แพ็กเกจทดสอบ Mio\ncmd.version\tแสดงข้อมูลเวอร์ชัน\ndiag.cause\tสาเหตุ\nerr.analysis\tการวิเคราะห์ซอร์สล้มเหลว\nerr.bunko_empty\tพาธทดแทน Bunko ต้องระบุชัดเจนและไม่ว่าง\nerr.chmod_native\tไม่สามารถทำให้เอาต์พุตเนทีฟเรียกทำงานได้\nerr.cleanup\tการล้างข้อมูลหลังเรียกใช้ล้มเหลว\nerr.create_run_dir\tไม่สามารถสร้างไดเรกทอรีเรียกใช้ส่วนตัว\nerr.emit_mochi\tคำสั่งนี้ไม่สามารถส่งออกไบต์โค้ด Mochi ได้\nerr.empty_paths\tพาธซอร์สและเอาต์พุตต้องไม่ว่าง\nerr.gc_stress\t--gc-stress ใช้ได้เฉพาะการสร้างเนทีฟจากซอร์ส");
    string.write_string(output, "\nerr.help_args\thelp รับชื่อคำสั่งได้ไม่เกินหนึ่งชื่อ\nerr.help_unknown\tไม่มีความช่วยเหลือสำหรับคำสั่งที่ไม่รู้จัก: {0}\nerr.host_target\trun และ exec ต้องใช้เป้าหมายโฮสต์ {0}\nerr.invalid_color\tโหมดสีไม่ถูกต้อง: {0} (คาดว่า auto, always หรือ never)\nerr.invalid_format\tรูปแบบไม่ถูกต้อง: {0} (คาดว่า human, short หรือ json)\nerr.invalid_theme\tธีมไม่ถูกต้อง: {0} (คาดว่า auto, dark หรือ light)\nerr.missing_value\tไม่มีค่าสำหรับตัวเลือก {0}\nerr.multiple_entries\tระบุซอร์สได้เพียงรายการเดียว\nerr.observe\t--observe ใช้ได้เฉพาะการสร้างเนทีฟ darwin-arm64 จากซอร์ส\nerr.program_args\tอาร์กิวเมนต์ของโปรแกรมต้องใช้ run หรือ exec\nerr.protect_run_dir\tไม่สามารถป้องกันไดเรกทอรีเรียกใช้ส่วนตัว\nerr.read_mochi\tไม่สามารถอ่านอินพุต Mochi\nerr.run_output\trun และ exec จัดการเอาต์พุตเนทีฟของตนเอง\nerr.spawn\tไม่สามารถเริ่มโปรแกรมเนทีฟ\nerr.symbols\t--emit-symbols ใช้ได้เฉพาะการสร้างเนทีฟ darwin-arm64 จากซอร์ส\nerr.target\tไม่รองรับเป้าหมาย: {0} (คาดว่า darwin-arm64, linux-amd64 หรือ windows-amd64)\nerr.unknown_command\tไม่รู้จักคำสั่ง: {0}\nerr.unknown_option\tไม่รู้จักตัวเลือก: {0}\nerr.version_args\tคำสั่ง version ไม่รับอาร์กิวเมนต์\nerr.write_disasm\tไม่สามารถเขียนผลถอดรหัส");
    string.write_string(output, "\nerr.write_mochi\tไม่สามารถเขียนเอาต์พุต Mochi\nerr.write_native\tไม่สามารถเขียนเอาต์พุตเนทีฟ\nhelp.commands\tคำสั่ง\nhelp.examples\tตัวอย่าง\nhelp.group.compilation\tการคอมไพล์\nhelp.group.diagnostics\tการวินิจฉัย\nhelp.group.execution\tการเรียกใช้\nhelp.group.general\tทั่วไป\nhelp.group.testing\tการทดสอบ\nhelp.group.tools\tเครื่องมือพัฒนา\nhelp.more\tเรียกใช้ 'mio help <คำสั่ง>' เพื่อดูรายละเอียดของคำสั่ง\nhelp.options\tตัวเลือก\nhelp.tagline\tคอมไพเลอร์ Native AOT และชุดเครื่องมือสำหรับภาษา Mio\nhelp.title\tMio {0}\nhelp.usage\tการใช้งาน\nopt.bunko\tใช้ราก Bunko นี้แทนค่าเริ่มต้น\nopt.color\tควบคุมเอาต์พุตสี: auto, always หรือ never\nopt.emit\tส่งออกไบต์โค้ด Mochi แทนอิมเมจเนทีฟ\nopt.format\tเลือกรูปแบบเอาต์พุต: human, short หรือ json\nopt.gc_stress\tสร้างพร้อมการตรวจสอบภาระตัวเก็บขยะแบบเข้มข้น");
    string.write_string(output, "\nopt.help\tแสดงความช่วยเหลือ\nopt.lang\tเลือกภาษาของเอาต์พุตด้วยแท็ก BCP 47 เช่น ja-JP\nopt.observe\tบันทึกการสังเกตการสร้างเนทีฟ\nopt.output\tเขียนเอาต์พุตไปยังพาธนี้\nopt.program_args\tส่งอาร์กิวเมนต์ที่เหลือไปยังโปรแกรม\nopt.run_filter\tเรียกใช้เฉพาะการทดสอบที่ชื่อตรงกับนิพจน์ปกตินี้\nopt.stdio\tใช้อินพุตและเอาต์พุตมาตรฐานสำหรับเซิร์ฟเวอร์ภาษา\nopt.symbols\tเขียนข้อมูลสัญลักษณ์เนทีฟลงในไฟล์นี้\nopt.target\tสร้างสำหรับ darwin-arm64, linux-amd64 หรือ windows-amd64\nopt.theme\tเลือกชุดสีตามความหมาย: auto, dark หรือ light\nopt.verbose\tแสดงรายละเอียดการวินิจฉัยเพิ่มเติม\nopt.version\tแสดงข้อมูลเวอร์ชัน\ntest.assertion\tการยืนยันล้มเหลว\ntest.bunko_empty\tพาธทดแทน Bunko ต้องไม่ว่าง\ntest.bunko_missing\tไม่มีค่าสำหรับ --bunko-root\ntest.compile_failed\tการคอมไพล์ล้มเหลว\ntest.duration\tระยะเวลารวม\ntest.empty_filter\tตัวกรองการทดสอบต้องไม่ว่าง\ntest.empty_lang\tแท็กภาษาต้องไม่ว่าง\ntest.fail\tไม่ผ่าน");
    string.write_string(output, "\ntest.filter_invalid\tตัวกรองการทดสอบไม่ถูกต้อง: {0}\ntest.invalid_arg\tอาร์กิวเมนต์การทดสอบไม่ถูกต้อง: {0}\ntest.invalid_signature\tลายเซ็นฟังก์ชันทดสอบไม่ถูกต้อง\ntest.io_clean_dir\tไม่สามารถล้างไดเรกทอรีทดสอบส่วนตัว\ntest.io_clean_image\tไม่สามารถล้างอิมเมจทดสอบเนทีฟ\ntest.io_dir\tไม่สามารถสร้างไดเรกทอรีทดสอบส่วนตัว\ntest.io_protect\tไม่สามารถป้องกันไดเรกทอรีทดสอบส่วนตัว\ntest.missing_target\tไม่มีเป้าหมายการทดสอบ\ntest.no_match\tไม่มีการทดสอบที่ตรงกับ --run={0}\ntest.none\tไม่พบการทดสอบ\ntest.pass\tผ่าน\ntest.resource\tเกินขีดจำกัดทรัพยากร\ntest.runtime\tข้อผิดพลาดขณะเรียกใช้\ntest.skip\tข้าม\ntest.skipped\tการทดสอบที่ข้าม: {0}\ntest.starting\tเริ่มการทดสอบ {0}\ntest.summary\tการทดสอบเสร็จสิ้น: ผ่าน {0} รายการ ไม่ผ่าน {1} รายการ");
    kaesu string.builder_string(output);
}

waza text_tr_tr() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tdenetim başarılı\ncli.lsp_unknown\tbilinmeyen lsp bağımsız değişkeni: {0}\ncmd.build\tMio kaynağından yerel yürütülebilir dosya veya Mochi bayt kodu oluştur\ncmd.check\tÇıktı üretmeden Mio kaynağını çözümle\ncmd.disasm\tDerlenmiş bir Mochi programını disassemble et\ncmd.exec\tDerlenmiş bir Mochi programını çalıştır\ncmd.help\tMio veya tek bir komut için yardım göster\ncmd.lsp\tMio dil sunucusunu standart giriş/çıkış üzerinden başlat\ncmd.run\tMio programını kaynaktan oluşturup çalıştır\ncmd.test\tMio test paketlerini bul ve çalıştır\ncmd.version\tSürüm bilgilerini göster\ndiag.cause\tneden\nerr.analysis\tkaynak çözümlemesi başarısız oldu\nerr.bunko_empty\tBunko geçersiz kılma yolu açık ve boş olmamalıdır\nerr.chmod_native\tyerel çıktı yürütülebilir yapılamıyor\nerr.cleanup\tçalıştırma sonrası temizlik başarısız oldu\nerr.create_run_dir\tözel çalıştırma dizini oluşturulamıyor\nerr.emit_mochi\tbu komut Mochi bayt kodu üretemez\nerr.empty_paths\tkaynak ve çıktı yolları boş olamaz\nerr.gc_stress\t--gc-stress yalnızca kaynaktan yerel derlemeler için geçerlidir");
    string.write_string(output, "\nerr.help_args\thelp en fazla bir komut adı alır\nerr.help_unknown\tbilinmeyen komut için yardım yok: {0}\nerr.host_target\trun ve exec {0} ana bilgisayar hedefini gerektirir\nerr.invalid_color\tgeçersiz renk modu: {0} (auto, always veya never bekleniyor)\nerr.invalid_format\tgeçersiz biçim: {0} (human, short veya json bekleniyor)\nerr.invalid_theme\tgeçersiz tema: {0} (auto, dark veya light bekleniyor)\nerr.missing_value\t{0} seçeneği için değer eksik\nerr.multiple_entries\tyalnızca bir kaynak girdisi verilebilir\nerr.observe\t--observe yalnızca kaynaktan darwin-arm64 yerel derlemeleri için geçerlidir\nerr.program_args\tprogram bağımsız değişkenleri run veya exec gerektirir\nerr.protect_run_dir\tözel çalıştırma dizini korunamıyor\nerr.read_mochi\tMochi girdisi okunamıyor\nerr.run_output\trun ve exec kendi yerel çıktılarını yönetir\nerr.spawn\tyerel program başlatılamadı\nerr.symbols\t--emit-symbols yalnızca kaynaktan darwin-arm64 yerel derlemeleri için geçerlidir\nerr.target\tdesteklenmeyen hedef: {0} (darwin-arm64, linux-amd64 veya windows-amd64 bekleniyor)\nerr.unknown_command\tbilinmeyen komut: {0}\nerr.unknown_option\tbilinmeyen seçenek: {0}\nerr.version_args\tversion komutu bağımsız değişken almaz\nerr.write_disasm\tdisassembly yazılamıyor");
    string.write_string(output, "\nerr.write_mochi\tMochi çıktısı yazılamıyor\nerr.write_native\tyerel çıktı yazılamıyor\nhelp.commands\tKomutlar\nhelp.examples\tÖrnekler\nhelp.group.compilation\tDerleme\nhelp.group.diagnostics\tTanılama\nhelp.group.execution\tYürütme\nhelp.group.general\tGenel\nhelp.group.testing\tTestler\nhelp.group.tools\tGeliştirme araçları\nhelp.more\tBir komutun ayrıntıları için 'mio help <komut>' çalıştırın.\nhelp.options\tSeçenekler\nhelp.tagline\tMio dili için Native AOT derleyicisi ve araç zinciri\nhelp.title\tMio {0}\nhelp.usage\tKullanım\nopt.bunko\tVarsayılan yerine bu Bunko kökünü kullan\nopt.color\tRenkli çıktıyı denetle: auto, always veya never\nopt.emit\tYerel görüntü yerine Mochi bayt kodu üret\nopt.format\tÇıktı biçimini seç: human, short veya json\nopt.gc_stress\tAgresif çöp toplayıcı yük denetimleriyle derle");
    string.write_string(output, "\nopt.help\tYardımı göster\nopt.lang\tÇıktı dilini BCP 47 etiketiyle seç, örneğin ja-JP\nopt.observe\tYerel derleme gözlemlerini kaydet\nopt.output\tÇıktıyı bu yola yaz\nopt.program_args\tKalan bağımsız değişkenleri programa ilet\nopt.run_filter\tYalnızca adı bu düzenli ifadeyle eşleşen testleri çalıştır\nopt.stdio\tDil sunucusu için standart giriş ve çıkışı kullan\nopt.symbols\tYerel simge bilgilerini bu dosyaya yaz\nopt.target\tdarwin-arm64, linux-amd64 veya windows-amd64 için derle\nopt.theme\tAnlamsal renk paletini seç: auto, dark veya light\nopt.verbose\tEk tanılama ayrıntılarını göster\nopt.version\tSürüm bilgilerini göster\ntest.assertion\tdoğrulama başarısız\ntest.bunko_empty\tBunko geçersiz kılma yolu boş olamaz\ntest.bunko_missing\t--bunko-root için değer eksik\ntest.compile_failed\tderleme başarısız\ntest.duration\ttoplam süre\ntest.empty_filter\ttest filtresi boş olamaz\ntest.empty_lang\tdil etiketi boş olamaz\ntest.fail\tBAŞARISIZ");
    string.write_string(output, "\ntest.filter_invalid\tgeçersiz test filtresi: {0}\ntest.invalid_arg\tgeçersiz test bağımsız değişkeni: {0}\ntest.invalid_signature\tgeçersiz test işlevi imzası\ntest.io_clean_dir\tözel test dizini temizlenemiyor\ntest.io_clean_image\tyerel test görüntüsü temizlenemiyor\ntest.io_dir\tözel test dizini oluşturulamıyor\ntest.io_protect\tözel test dizini korunamıyor\ntest.missing_target\ttest hedefi eksik\ntest.no_match\t--run={0} ile eşleşen test yok\ntest.none\ttest bulunamadı\ntest.pass\tBAŞARILI\ntest.resource\tkaynak sınırı aşıldı\ntest.runtime\tçalışma zamanı hatası\ntest.skip\tATLANDI\ntest.skipped\tAtlanan testler: {0}\ntest.starting\tTestler başlıyor {0}\ntest.summary\tTestler tamamlandı: {0} başarılı, {1} başarısız");
    kaesu string.builder_string(output);
}

waza text_uk_ua() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tперевірку пройдено\ncli.lsp_unknown\tневідомий аргумент lsp: {0}\ncmd.build\tЗібрати нативний виконуваний файл або байт-код Mochi з джерел Mio\ncmd.check\tПроаналізувати джерела Mio без створення виводу\ncmd.disasm\tДизасемблювати скомпільовану програму Mochi\ncmd.exec\tЗапустити скомпільовану програму Mochi\ncmd.help\tПоказати довідку про Mio або одну команду\ncmd.lsp\tЗапустити мовний сервер Mio через стандартний ввід-вивід\ncmd.run\tЗібрати й запустити програму Mio з джерел\ncmd.test\tЗнайти й запустити тестові пакети Mio\ncmd.version\tПоказати відомості про версію\ndiag.cause\tпричина\nerr.analysis\tне вдалося проаналізувати джерела\nerr.bunko_empty\tперевизначений шлях Bunko має бути явним і непорожнім\nerr.chmod_native\tне вдалося зробити нативний вивід виконуваним\nerr.cleanup\tне вдалося очистити тимчасові файли після запуску\nerr.create_run_dir\tне вдалося створити приватний каталог запуску\nerr.emit_mochi\tця команда не може видавати байт-код Mochi\nerr.empty_paths\tшляхи джерела й виводу не можуть бути порожніми\nerr.gc_stress\t--gc-stress застосовується лише до нативних збірок з джерел");
    string.write_string(output, "\nerr.help_args\thelp приймає щонайбільше одну назву команди\nerr.help_unknown\tнемає довідки для невідомої команди: {0}\nerr.host_target\trun і exec потребують цілі хоста {0}\nerr.invalid_color\tнеприпустимий режим кольору: {0} (очікується auto, always або never)\nerr.invalid_format\tнеприпустимий формат: {0} (очікується human, short або json)\nerr.invalid_theme\tнеприпустима тема: {0} (очікується auto, dark або light)\nerr.missing_value\tвідсутнє значення параметра {0}\nerr.multiple_entries\tможна вказати лише одне джерело\nerr.observe\t--observe застосовується лише до нативних збірок darwin-arm64 з джерел\nerr.program_args\tаргументи програми потребують run або exec\nerr.protect_run_dir\tне вдалося захистити приватний каталог запуску\nerr.read_mochi\tне вдалося прочитати вхід Mochi\nerr.run_output\trun і exec самостійно керують нативним виводом\nerr.spawn\tне вдалося запустити нативну програму\nerr.symbols\t--emit-symbols застосовується лише до нативних збірок darwin-arm64 з джерел\nerr.target\tнепідтримувана ціль: {0} (очікується darwin-arm64, linux-amd64 або windows-amd64)\nerr.unknown_command\tневідома команда: {0}\nerr.unknown_option\tневідомий параметр: {0}\nerr.version_args\tкоманда version не приймає аргументів\nerr.write_disasm\tне вдалося записати дизасемблер");
    string.write_string(output, "\nerr.write_mochi\tне вдалося записати вивід Mochi\nerr.write_native\tне вдалося записати нативний вивід\nhelp.commands\tКоманди\nhelp.examples\tПриклади\nhelp.group.compilation\tКомпіляція\nhelp.group.diagnostics\tДіагностика\nhelp.group.execution\tВиконання\nhelp.group.general\tЗагальні\nhelp.group.testing\tТести\nhelp.group.tools\tІнструменти розробки\nhelp.more\tВиконайте 'mio help <команда>', щоб переглянути відомості про команду.\nhelp.options\tПараметри\nhelp.tagline\tКомпілятор Native AOT та інструменти для мови Mio\nhelp.title\tMio {0}\nhelp.usage\tВикористання\nopt.bunko\tВикористовувати цей корінь Bunko замість типового\nopt.color\tКерувати кольоровим виводом: auto, always або never\nopt.emit\tВидати байт-код Mochi замість нативного образу\nopt.format\tВибрати формат виводу: human, short або json\nopt.gc_stress\tЗібрати з посиленими перевірками навантаження збирача сміття");
    string.write_string(output, "\nopt.help\tПоказати довідку\nopt.lang\tВибрати мову виводу за тегом BCP 47, наприклад ja-JP\nopt.observe\tЗаписувати спостереження нативної збірки\nopt.output\tЗаписати вивід за цим шляхом\nopt.program_args\tПередати решту аргументів програмі\nopt.run_filter\tЗапускати лише тести, назви яких відповідають цьому регулярному виразу\nopt.stdio\tВикористовувати стандартний ввід і вивід для мовного сервера\nopt.symbols\tЗаписати відомості про нативні символи в цей файл\nopt.target\tЗібрати для darwin-arm64, linux-amd64 або windows-amd64\nopt.theme\tВибрати смислову палітру: auto, dark або light\nopt.verbose\tПоказувати додаткові відомості діагностики\nopt.version\tПоказати відомості про версію\ntest.assertion\tпомилка перевірки\ntest.bunko_empty\tперевизначений шлях Bunko не може бути порожнім\ntest.bunko_missing\tвідсутнє значення --bunko-root\ntest.compile_failed\tпомилка компіляції\ntest.duration\tзагальна тривалість\ntest.empty_filter\tфільтр тестів не може бути порожнім\ntest.empty_lang\tмовний тег не може бути порожнім\ntest.fail\tЗБІЙ");
    string.write_string(output, "\ntest.filter_invalid\tнеприпустимий фільтр тестів: {0}\ntest.invalid_arg\tнеприпустимий аргумент тесту: {0}\ntest.invalid_signature\tнеприпустима сигнатура тестової функції\ntest.io_clean_dir\tне вдалося видалити приватний каталог тестів\ntest.io_clean_image\tне вдалося видалити нативний тестовий образ\ntest.io_dir\tне вдалося створити приватний каталог тестів\ntest.io_protect\tне вдалося захистити приватний каталог тестів\ntest.missing_target\tне вказано ціль тестування\ntest.no_match\tнемає тестів, що відповідають --run={0}\ntest.none\tтестів не знайдено\ntest.pass\tУСПІХ\ntest.resource\tперевищено ліміт ресурсів\ntest.runtime\tпомилка виконання\ntest.skip\tПРОПУЩЕНО\ntest.skipped\tПропущено тестів: {0}\ntest.starting\tПочаток тестів {0}\ntest.summary\tТести завершено: успішно {0}, з помилками {1}");
    kaesu string.builder_string(output);
}

waza text_vi_vn() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tkiểm tra đạt\ncli.lsp_unknown\tđối số lsp không xác định: {0}\ncmd.build\tTạo tệp thực thi gốc hoặc mã byte Mochi từ mã nguồn Mio\ncmd.check\tPhân tích mã nguồn Mio mà không tạo đầu ra\ncmd.disasm\tDịch ngược chương trình Mochi đã biên dịch\ncmd.exec\tChạy chương trình Mochi đã biên dịch\ncmd.help\tHiển thị trợ giúp cho Mio hoặc một lệnh\ncmd.lsp\tKhởi động máy chủ ngôn ngữ Mio qua đầu vào/đầu ra chuẩn\ncmd.run\tTạo và chạy chương trình Mio từ mã nguồn\ncmd.test\tTìm và chạy các gói kiểm thử Mio\ncmd.version\tHiển thị thông tin phiên bản\ndiag.cause\tnguyên nhân\nerr.analysis\tphân tích mã nguồn thất bại\nerr.bunko_empty\tđường dẫn Bunko thay thế phải rõ ràng và không rỗng\nerr.chmod_native\tkhông thể làm cho đầu ra gốc có thể thực thi\nerr.cleanup\tdọn dẹp sau khi chạy thất bại\nerr.create_run_dir\tkhông thể tạo thư mục chạy riêng\nerr.emit_mochi\tlệnh này không thể phát mã byte Mochi\nerr.empty_paths\tđường dẫn nguồn và đầu ra không được rỗng\nerr.gc_stress\t--gc-stress chỉ áp dụng cho bản dựng gốc từ mã nguồn");
    string.write_string(output, "\nerr.help_args\thelp nhận tối đa một tên lệnh\nerr.help_unknown\tkhông có trợ giúp cho lệnh không xác định: {0}\nerr.host_target\trun và exec yêu cầu đích máy chủ {0}\nerr.invalid_color\tchế độ màu không hợp lệ: {0} (mong đợi auto, always hoặc never)\nerr.invalid_format\tđịnh dạng không hợp lệ: {0} (mong đợi human, short hoặc json)\nerr.invalid_theme\tchủ đề không hợp lệ: {0} (mong đợi auto, dark hoặc light)\nerr.missing_value\tthiếu giá trị cho tùy chọn {0}\nerr.multiple_entries\tchỉ có thể cung cấp một mục mã nguồn\nerr.observe\t--observe chỉ áp dụng cho bản dựng gốc darwin-arm64 từ mã nguồn\nerr.program_args\tđối số chương trình yêu cầu run hoặc exec\nerr.protect_run_dir\tkhông thể bảo vệ thư mục chạy riêng\nerr.read_mochi\tkhông thể đọc đầu vào Mochi\nerr.run_output\trun và exec tự quản lý đầu ra gốc của chúng\nerr.spawn\tkhông thể khởi chạy chương trình gốc\nerr.symbols\t--emit-symbols chỉ áp dụng cho bản dựng gốc darwin-arm64 từ mã nguồn\nerr.target\tđích không được hỗ trợ: {0} (mong đợi darwin-arm64, linux-amd64 hoặc windows-amd64)\nerr.unknown_command\tlệnh không xác định: {0}\nerr.unknown_option\ttùy chọn không xác định: {0}\nerr.version_args\tlệnh version không nhận đối số\nerr.write_disasm\tkhông thể ghi bản dịch ngược");
    string.write_string(output, "\nerr.write_mochi\tkhông thể ghi đầu ra Mochi\nerr.write_native\tkhông thể ghi đầu ra gốc\nhelp.commands\tLệnh\nhelp.examples\tVí dụ\nhelp.group.compilation\tBiên dịch\nhelp.group.diagnostics\tChẩn đoán\nhelp.group.execution\tThực thi\nhelp.group.general\tChung\nhelp.group.testing\tKiểm thử\nhelp.group.tools\tCông cụ phát triển\nhelp.more\tChạy 'mio help <lệnh>' để xem chi tiết của một lệnh.\nhelp.options\tTùy chọn\nhelp.tagline\tTrình biên dịch Native AOT và bộ công cụ cho ngôn ngữ Mio\nhelp.title\tMio {0}\nhelp.usage\tCách dùng\nopt.bunko\tDùng gốc Bunko này thay cho mặc định\nopt.color\tĐiều khiển đầu ra màu: auto, always hoặc never\nopt.emit\tPhát mã byte Mochi thay cho ảnh gốc\nopt.format\tChọn định dạng đầu ra: human, short hoặc json\nopt.gc_stress\tXây dựng với kiểm tra áp lực bộ thu gom rác mạnh");
    string.write_string(output, "\nopt.help\tHiển thị trợ giúp\nopt.lang\tChọn ngôn ngữ đầu ra bằng thẻ BCP 47, ví dụ ja-JP\nopt.observe\tGhi lại quan sát quá trình xây dựng gốc\nopt.output\tGhi đầu ra vào đường dẫn này\nopt.program_args\tChuyển các đối số còn lại cho chương trình\nopt.run_filter\tChỉ chạy các kiểm thử có tên khớp với biểu thức chính quy này\nopt.stdio\tDùng đầu vào và đầu ra chuẩn cho máy chủ ngôn ngữ\nopt.symbols\tGhi thông tin ký hiệu gốc vào tệp này\nopt.target\tXây dựng cho darwin-arm64, linux-amd64 hoặc windows-amd64\nopt.theme\tChọn bảng màu ngữ nghĩa: auto, dark hoặc light\nopt.verbose\tBao gồm chi tiết chẩn đoán bổ sung\nopt.version\tHiển thị thông tin phiên bản\ntest.assertion\txác nhận thất bại\ntest.bunko_empty\tđường dẫn Bunko thay thế không được rỗng\ntest.bunko_missing\tthiếu giá trị cho --bunko-root\ntest.compile_failed\tbiên dịch thất bại\ntest.duration\ttổng thời lượng\ntest.empty_filter\tbộ lọc kiểm thử không được rỗng\ntest.empty_lang\tthẻ ngôn ngữ không được rỗng\ntest.fail\tKHÔNG ĐẠT");
    string.write_string(output, "\ntest.filter_invalid\tbộ lọc kiểm thử không hợp lệ: {0}\ntest.invalid_arg\tđối số kiểm thử không hợp lệ: {0}\ntest.invalid_signature\tchữ ký hàm kiểm thử không hợp lệ\ntest.io_clean_dir\tkhông thể dọn thư mục kiểm thử riêng\ntest.io_clean_image\tkhông thể dọn ảnh kiểm thử gốc\ntest.io_dir\tkhông thể tạo thư mục kiểm thử riêng\ntest.io_protect\tkhông thể bảo vệ thư mục kiểm thử riêng\ntest.missing_target\tthiếu đích kiểm thử\ntest.no_match\tkhông có kiểm thử nào khớp với --run={0}\ntest.none\tkhông tìm thấy kiểm thử\ntest.pass\tĐẠT\ntest.resource\tvượt giới hạn tài nguyên\ntest.runtime\tlỗi thời gian chạy\ntest.skip\tBỎ QUA\ntest.skipped\tKiểm thử bỏ qua: {0}\ntest.starting\tBắt đầu kiểm thử {0}\ntest.summary\tKiểm thử hoàn tất: {0} đạt, {1} không đạt");
    kaesu string.builder_string(output);
}

waza text_zh_cn() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\t检查通过\ncli.lsp_unknown\t未知的 lsp 参数：{0}\ncmd.build\t从 Mio 源码构建原生可执行文件或 Mochi 字节码\ncmd.check\t分析 Mio 源码但不产生输出\ncmd.disasm\t反汇编已编译的 Mochi 程序\ncmd.exec\t运行已编译的 Mochi 程序\ncmd.help\t显示 Mio 或某个命令的帮助\ncmd.lsp\t通过标准输入输出启动 Mio 语言服务器\ncmd.run\t从源码构建并运行 Mio 程序\ncmd.test\t发现并运行 Mio 测试包\ncmd.version\t显示版本信息\ndiag.cause\t原因\nerr.analysis\t源码分析失败\nerr.bunko_empty\tBunko 覆盖路径必须明确且非空\nerr.chmod_native\t无法将原生输出设为可执行\nerr.cleanup\t运行清理失败\nerr.create_run_dir\t无法创建私有运行目录\nerr.emit_mochi\t此命令无法输出 Mochi 字节码\nerr.empty_paths\t源码路径和输出路径不能为空\nerr.gc_stress\t--gc-stress 仅适用于从源码进行原生构建");
    string.write_string(output, "\nerr.help_args\thelp 最多接受一个命令名\nerr.help_unknown\t未知命令没有帮助：{0}\nerr.host_target\trun 和 exec 需要主机目标 {0}\nerr.invalid_color\t无效颜色模式：{0}（应为 auto、always 或 never）\nerr.invalid_format\t无效格式：{0}（应为 human、short 或 json）\nerr.invalid_theme\t无效主题：{0}（应为 auto、dark 或 light）\nerr.missing_value\t选项 {0} 缺少值\nerr.multiple_entries\t只能提供一个源码条目\nerr.observe\t--observe 仅适用于从源码构建 darwin-arm64 原生映像\nerr.program_args\t程序参数只能用于 run 或 exec\nerr.protect_run_dir\t无法保护私有运行目录\nerr.read_mochi\t无法读取 Mochi 输入\nerr.run_output\trun 和 exec 会自行管理原生输出\nerr.spawn\t无法启动原生程序\nerr.symbols\t--emit-symbols 仅适用于从源码构建 darwin-arm64 原生映像\nerr.target\t不支持的目标：{0}（应为 darwin-arm64、linux-amd64 或 windows-amd64）\nerr.unknown_command\t未知命令：{0}\nerr.unknown_option\t未知选项：{0}\nerr.version_args\tversion 命令不接受参数\nerr.write_disasm\t无法写入反汇编结果");
    string.write_string(output, "\nerr.write_mochi\t无法写入 Mochi 输出\nerr.write_native\t无法写入原生输出\nhelp.commands\t命令\nhelp.examples\t示例\nhelp.group.compilation\t编译\nhelp.group.diagnostics\t诊断\nhelp.group.execution\t执行\nhelp.group.general\t常规\nhelp.group.testing\t测试\nhelp.group.tools\t开发工具\nhelp.more\t运行 'mio help <命令>' 查看命令详情。\nhelp.options\t选项\nhelp.tagline\tMio 语言的 Native AOT 编译器与工具链\nhelp.title\tMio {0}\nhelp.usage\t用法\nopt.bunko\t使用指定的 Bunko 根目录而不是默认目录\nopt.color\t控制颜色输出：auto、always 或 never\nopt.emit\t输出 Mochi 字节码而不是原生映像\nopt.format\t选择输出格式：human、short 或 json\nopt.gc_stress\t构建时启用激进的垃圾回收压力检查");
    string.write_string(output, "\nopt.help\t显示帮助\nopt.lang\t按 BCP 47 标签选择输出语言，例如 ja-JP\nopt.observe\t记录原生构建观测数据\nopt.output\t将输出写入此路径\nopt.program_args\t将剩余参数传递给程序\nopt.run_filter\t只运行名称匹配此正则表达式的测试\nopt.stdio\t为语言服务器使用标准输入输出\nopt.symbols\t将原生符号信息写入此文件\nopt.target\t为 darwin-arm64、linux-amd64 或 windows-amd64 构建\nopt.theme\t选择语义配色方案：auto、dark 或 light\nopt.verbose\t输出额外的诊断细节\nopt.version\t显示版本信息\ntest.assertion\t断言失败\ntest.bunko_empty\tBunko 覆盖路径不能为空\ntest.bunko_missing\t--bunko-root 缺少值\ntest.compile_failed\t编译失败\ntest.duration\t总执行时间\ntest.empty_filter\t测试过滤器不能为空\ntest.empty_lang\t语言标签不能为空\ntest.fail\t失败");
    string.write_string(output, "\ntest.filter_invalid\t无效的测试过滤器：{0}\ntest.invalid_arg\t无效的测试参数：{0}\ntest.invalid_signature\t测试函数签名无效\ntest.io_clean_dir\t无法清理私有测试目录\ntest.io_clean_image\t无法清理原生测试映像\ntest.io_dir\t无法创建私有测试目录\ntest.io_protect\t无法保护私有测试目录\ntest.missing_target\t缺少测试目标\ntest.no_match\t没有匹配 --run={0} 的测试\ntest.none\t没有发现测试\ntest.pass\t通过\ntest.resource\t超出资源限制\ntest.runtime\t运行时错误\ntest.skip\t跳过\ntest.skipped\t跳过的测试：{0}\ntest.starting\t开始测试 {0}\ntest.summary\t测试完成：{0} 个通过，{1} 个失败");
    kaesu string.builder_string(output);
}

waza text_zh_hk() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\t檢查通過\ncli.lsp_unknown\t未知的 lsp 參數：{0}\ncmd.build\t從 Mio 原始碼建立原生執行檔或 Mochi 位元組碼\ncmd.check\t分析 Mio 原始碼但不產生輸出\ncmd.disasm\t反組譯已編譯的 Mochi 程式\ncmd.exec\t執行已編譯的 Mochi 程式\ncmd.help\t顯示 Mio 或單一指令的說明\ncmd.lsp\t透過標準輸入輸出啟動 Mio 語言伺服器\ncmd.run\t從原始碼建立並執行 Mio 程式\ncmd.test\t探索並執行 Mio 測試套件\ncmd.version\t顯示版本資料\ndiag.cause\t原因\nerr.analysis\t原始碼分析失敗\nerr.bunko_empty\tBunko 覆寫路徑必須明確且非空\nerr.chmod_native\t無法將原生輸出設為可執行\nerr.cleanup\t執行清理失敗\nerr.create_run_dir\t無法建立私有執行目錄\nerr.emit_mochi\t此指令無法輸出 Mochi 位元組碼\nerr.empty_paths\t原始碼路徑和輸出路徑不能為空\nerr.gc_stress\t--gc-stress 僅適用於從原始碼進行原生建立");
    string.write_string(output, "\nerr.help_args\thelp 最多接受一個指令名稱\nerr.help_unknown\t未知指令沒有說明：{0}\nerr.host_target\trun 和 exec 需要主機目標 {0}\nerr.invalid_color\t無效顏色模式：{0}（應為 auto、always 或 never）\nerr.invalid_format\t無效格式：{0}（應為 human、short 或 json）\nerr.invalid_theme\t無效主題：{0}（應為 auto、dark 或 light）\nerr.missing_value\t選項 {0} 缺少值\nerr.multiple_entries\t只能提供一個原始碼項目\nerr.observe\t--observe 僅適用於從原始碼建立 darwin-arm64 原生映像\nerr.program_args\t程式參數只能用於 run 或 exec\nerr.protect_run_dir\t無法保護私有執行目錄\nerr.read_mochi\t無法讀取 Mochi 輸入\nerr.run_output\trun 和 exec 會自行管理原生輸出\nerr.spawn\t無法啟動原生程式\nerr.symbols\t--emit-symbols 僅適用於從原始碼建立 darwin-arm64 原生映像\nerr.target\t不支援的目標：{0}（應為 darwin-arm64、linux-amd64 或 windows-amd64）\nerr.unknown_command\t未知指令：{0}\nerr.unknown_option\t未知選項：{0}\nerr.version_args\tversion 指令不接受參數\nerr.write_disasm\t無法寫入反組譯結果");
    string.write_string(output, "\nerr.write_mochi\t無法寫入 Mochi 輸出\nerr.write_native\t無法寫入原生輸出\nhelp.commands\t指令\nhelp.examples\t例子\nhelp.group.compilation\t編譯\nhelp.group.diagnostics\t診斷\nhelp.group.execution\t執行\nhelp.group.general\t一般\nhelp.group.testing\t測試\nhelp.group.tools\t開發工具\nhelp.more\t執行 'mio help <指令>' 以查看指令詳情。\nhelp.options\t選項\nhelp.tagline\tMio 語言的 Native AOT 編譯器與工具鏈\nhelp.title\tMio {0}\nhelp.usage\t用法\nopt.bunko\t使用指定的 Bunko 根目錄而非預設目錄\nopt.color\t控制顏色輸出：auto、always 或 never\nopt.emit\t輸出 Mochi 位元組碼而非原生映像\nopt.format\t選擇輸出格式：human、short 或 json\nopt.gc_stress\t建立時啟用積極的垃圾回收壓力檢查");
    string.write_string(output, "\nopt.help\t顯示說明\nopt.lang\t按 BCP 47 標籤選擇輸出語言，例如 ja-JP\nopt.observe\t記錄原生建立觀測資料\nopt.output\t將輸出寫入此路徑\nopt.program_args\t將其餘參數傳遞給程式\nopt.run_filter\t只執行名稱符合此正規表示式的測試\nopt.stdio\t為語言伺服器使用標準輸入輸出\nopt.symbols\t將原生符號資料寫入此檔案\nopt.target\t為 darwin-arm64、linux-amd64 或 windows-amd64 建立\nopt.theme\t選擇語意配色：auto、dark 或 light\nopt.verbose\t輸出額外的診斷細節\nopt.version\t顯示版本資料\ntest.assertion\t斷言失敗\ntest.bunko_empty\tBunko 覆寫路徑不能為空\ntest.bunko_missing\t--bunko-root 缺少值\ntest.compile_failed\t編譯失敗\ntest.duration\t總執行時間\ntest.empty_filter\t測試篩選器不能為空\ntest.empty_lang\t語言標籤不能為空\ntest.fail\t失敗");
    string.write_string(output, "\ntest.filter_invalid\t無效的測試篩選器：{0}\ntest.invalid_arg\t無效的測試參數：{0}\ntest.invalid_signature\t測試函式簽章無效\ntest.io_clean_dir\t無法清理私有測試目錄\ntest.io_clean_image\t無法清理原生測試映像\ntest.io_dir\t無法建立私有測試目錄\ntest.io_protect\t無法保護私有測試目錄\ntest.missing_target\t缺少測試目標\ntest.no_match\t沒有符合 --run={0} 的測試\ntest.none\t找不到測試\ntest.pass\t通過\ntest.resource\t超出資源限制\ntest.runtime\t執行階段錯誤\ntest.skip\t略過\ntest.skipped\t略過的測試：{0}\ntest.starting\t開始測試 {0}\ntest.summary\t測試完成：{0} 個通過，{1} 個失敗");
    kaesu string.builder_string(output);
}

waza text_zh_tw() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\t檢查通過\ncli.lsp_unknown\t未知的 lsp 參數：{0}\ncmd.build\t從 Mio 原始碼建置原生執行檔或 Mochi 位元組碼\ncmd.check\t分析 Mio 原始碼但不產生輸出\ncmd.disasm\t反組譯已編譯的 Mochi 程式\ncmd.exec\t執行已編譯的 Mochi 程式\ncmd.help\t顯示 Mio 或單一指令的說明\ncmd.lsp\t透過標準輸入輸出啟動 Mio 語言伺服器\ncmd.run\t從原始碼建置並執行 Mio 程式\ncmd.test\t探索並執行 Mio 測試套件\ncmd.version\t顯示版本資訊\ndiag.cause\t原因\nerr.analysis\t原始碼分析失敗\nerr.bunko_empty\tBunko 覆寫路徑必須明確且非空\nerr.chmod_native\t無法將原生輸出設為可執行\nerr.cleanup\t執行清理失敗\nerr.create_run_dir\t無法建立私有執行目錄\nerr.emit_mochi\t此指令無法輸出 Mochi 位元組碼\nerr.empty_paths\t原始碼路徑和輸出路徑不能為空\nerr.gc_stress\t--gc-stress 僅適用於從原始碼進行原生建置");
    string.write_string(output, "\nerr.help_args\thelp 最多接受一個指令名稱\nerr.help_unknown\t未知指令沒有說明：{0}\nerr.host_target\trun 和 exec 需要主機目標 {0}\nerr.invalid_color\t無效顏色模式：{0}（應為 auto、always 或 never）\nerr.invalid_format\t無效格式：{0}（應為 human、short 或 json）\nerr.invalid_theme\t無效主題：{0}（應為 auto、dark 或 light）\nerr.missing_value\t選項 {0} 缺少值\nerr.multiple_entries\t只能提供一個原始碼項目\nerr.observe\t--observe 僅適用於從原始碼建置 darwin-arm64 原生映像\nerr.program_args\t程式參數只能用於 run 或 exec\nerr.protect_run_dir\t無法保護私有執行目錄\nerr.read_mochi\t無法讀取 Mochi 輸入\nerr.run_output\trun 和 exec 會自行管理原生輸出\nerr.spawn\t無法啟動原生程式\nerr.symbols\t--emit-symbols 僅適用於從原始碼建置 darwin-arm64 原生映像\nerr.target\t不支援的目標：{0}（應為 darwin-arm64、linux-amd64 或 windows-amd64）\nerr.unknown_command\t未知指令：{0}\nerr.unknown_option\t未知選項：{0}\nerr.version_args\tversion 指令不接受參數\nerr.write_disasm\t無法寫入反組譯結果");
    string.write_string(output, "\nerr.write_mochi\t無法寫入 Mochi 輸出\nerr.write_native\t無法寫入原生輸出\nhelp.commands\t指令\nhelp.examples\t範例\nhelp.group.compilation\t編譯\nhelp.group.diagnostics\t診斷\nhelp.group.execution\t執行\nhelp.group.general\t一般\nhelp.group.testing\t測試\nhelp.group.tools\t開發工具\nhelp.more\t執行 'mio help <指令>' 以查看指令詳細說明。\nhelp.options\t選項\nhelp.tagline\tMio 語言的 Native AOT 編譯器與工具鏈\nhelp.title\tMio {0}\nhelp.usage\t用法\nopt.bunko\t使用指定的 Bunko 根目錄而非預設目錄\nopt.color\t控制顏色輸出：auto、always 或 never\nopt.emit\t輸出 Mochi 位元組碼而非原生映像\nopt.format\t選擇輸出格式：human、short 或 json\nopt.gc_stress\t建置時啟用積極的垃圾回收壓力檢查");
    string.write_string(output, "\nopt.help\t顯示說明\nopt.lang\t依 BCP 47 標籤選擇輸出語言，例如 ja-JP\nopt.observe\t記錄原生建置觀測資料\nopt.output\t將輸出寫入此路徑\nopt.program_args\t將其餘參數傳遞給程式\nopt.run_filter\t只執行名稱符合此正規表示式的測試\nopt.stdio\t為語言伺服器使用標準輸入輸出\nopt.symbols\t將原生符號資訊寫入此檔案\nopt.target\t為 darwin-arm64、linux-amd64 或 windows-amd64 建置\nopt.theme\t選擇語意配色：auto、dark 或 light\nopt.verbose\t輸出額外的診斷細節\nopt.version\t顯示版本資訊\ntest.assertion\t斷言失敗\ntest.bunko_empty\tBunko 覆寫路徑不能為空\ntest.bunko_missing\t--bunko-root 缺少值\ntest.compile_failed\t編譯失敗\ntest.duration\t總執行時間\ntest.empty_filter\t測試篩選器不能為空\ntest.empty_lang\t語言標籤不能為空\ntest.fail\t失敗");
    string.write_string(output, "\ntest.filter_invalid\t無效的測試篩選器：{0}\ntest.invalid_arg\t無效的測試參數：{0}\ntest.invalid_signature\t測試函式簽章無效\ntest.io_clean_dir\t無法清理私有測試目錄\ntest.io_clean_image\t無法清理原生測試映像\ntest.io_dir\t無法建立私有測試目錄\ntest.io_protect\t無法保護私有測試目錄\ntest.missing_target\t缺少測試目標\ntest.no_match\t沒有符合 --run={0} 的測試\ntest.none\t找不到測試\ntest.pass\t通過\ntest.resource\t超出資源限制\ntest.runtime\t執行階段錯誤\ntest.skip\t略過\ntest.skipped\t略過的測試：{0}\ntest.starting\t開始測試 {0}\ntest.summary\t測試完成：{0} 個通過，{1} 個失敗");
    kaesu string.builder_string(output);
}

waza localized(language: string, key: string) -> string {
    moshi (language == "ar-SA") { kaesu table_lookup(text_ar_sa(), key); }
    moshi (language == "bn-BD") { kaesu table_lookup(text_bn_bd(), key); }
