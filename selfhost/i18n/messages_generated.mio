    kaesu language;
}

koukai waza regional(tag: string) -> string {
    moshi (tag == "zh-MO") { kaesu "zh-HK"; }
    moshi (tag == "zh-SG") { kaesu "zh-CN"; }
    moshi (tag == "zh-MY") { kaesu "zh-CN"; }
    kaesu tag;
}

koukai waza script_default(tag: string) -> string {
    moshi (tag == "zh-Hans") { kaesu "zh-CN"; }
    moshi (tag == "zh-Hant") { kaesu "zh-TW"; }
    kaesu "";
}

waza table_slice(data: []uint8, first: int64, end: int64) -> string {
    kaku bytes: []uint8 = []; kaku at = first;
    aida (at < end) { array.push(bytes, data[at]); at = at + 1; }
    kaku value = string.from_utf8(bytes); moshi (value == mu) { kaesu ""; } kaesu value;
}

waza table_lookup(table: string, key: string) -> string {
    kaku needle = string.concat("\n", string.concat(key, "\t"));
    kaku position = string.index(table, needle);
    moshi (position < 0) { kaesu ""; }
    kaku data = string.to_bytes(table);
    kaku start = position + len(string.to_bytes(needle)); kaku end = start;
    aida (end < len(data) && data[end] != uint8(10)) { end = end + 1; }
    kaesu table_slice(data, start, end);
}

waza text_ar_sa() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tتم اجتياز الفحص\ncli.lsp_unknown\tوسيط lsp غير معروف: {0}\ncmd.build\tبناء ملف تنفيذي أصلي أو بايت كود Mochi من مصادر Mio\ncmd.check\tتحليل مصادر Mio دون إنتاج مخرجات\ncmd.disasm\tتفكيك برنامج Mochi المُترجم\ncmd.exec\tتشغيل برنامج Mochi مُترجم\ncmd.help\tعرض المساعدة لـ Mio أو لأمر واحد\ncmd.lsp\tبدء خادم لغة Mio عبر الإدخال والإخراج القياسيين\ncmd.run\tبناء برنامج Mio من المصادر وتشغيله\ncmd.test\tاكتشاف حزم اختبار Mio وتشغيلها\ncmd.version\tعرض معلومات الإصدار\ndiag.cause\tالسبب\nerr.analysis\tفشل تحليل المصادر\nerr.bunko_empty\tيجب أن يكون مسار Bunko البديل صريحًا وغير فارغ\nerr.chmod_native\tتعذّر جعل المخرجات الأصلية قابلة للتنفيذ\nerr.cleanup\tفشل تنظيف ما بعد التشغيل\nerr.create_run_dir\tتعذّر إنشاء مجلد تشغيل خاص\nerr.emit_mochi\tلا يمكن لهذا الأمر إنتاج بايت كود Mochi\nerr.empty_paths\tلا يمكن أن يكون مسارا المصدر والإخراج فارغين\nerr.gc_stress\tينطبق --gc-stress على عمليات البناء الأصلية من المصادر فقط");
    string.write_string(output, "\nerr.help_args\tيقبل help اسم أمر واحدًا على الأكثر\nerr.help_unknown\tلا توجد مساعدة للأمر غير المعروف: {0}\nerr.host_target\tيتطلب run وexec هدف المضيف {0}\nerr.invalid_color\tوضع ألوان غير صالح: {0} (المتوقع auto أو always أو never)\nerr.invalid_format\tصيغة غير صالحة: {0} (المتوقع human أو short أو json)\nerr.invalid_theme\tسمة غير صالحة: {0} (المتوقع auto أو dark أو light)\nerr.missing_value\tقيمة مفقودة للخيار {0}\nerr.multiple_entries\tيمكن تقديم مصدر واحد فقط\nerr.observe\tينطبق --observe على عمليات بناء darwin-arm64 الأصلية من المصادر فقط\nerr.program_args\tتتطلب وسائط البرنامج الأمر run أو exec\nerr.protect_run_dir\tتعذّر حماية مجلد التشغيل الخاص\nerr.read_mochi\tتعذّرت قراءة إدخال Mochi\nerr.run_output\tيتولى run وexec إدارة مخرجاتهما الأصلية\nerr.spawn\tتعذّر بدء البرنامج الأصلي\nerr.symbols\tينطبق --emit-symbols على عمليات بناء darwin-arm64 الأصلية من المصادر فقط\nerr.target\tهدف غير مدعوم: {0} (المتوقع darwin-arm64 أو linux-amd64 أو windows-amd64)\nerr.unknown_command\tأمر غير معروف: {0}\nerr.unknown_option\tخيار غير معروف: {0}\nerr.version_args\tلا يقبل الأمر version أي وسائط\nerr.write_disasm\tتعذّرت كتابة التفكيك");
    string.write_string(output, "\nerr.write_mochi\tتعذّرت كتابة إخراج Mochi\nerr.write_native\tتعذّرت كتابة المخرجات الأصلية\nhelp.commands\tالأوامر\nhelp.examples\tأمثلة\nhelp.group.compilation\tالترجمة\nhelp.group.diagnostics\tالتشخيص\nhelp.group.execution\tالتنفيذ\nhelp.group.general\tعام\nhelp.group.testing\tالاختبارات\nhelp.group.tools\tأدوات التطوير\nhelp.more\tنفّذ 'mio help <الأمر>' لعرض تفاصيل الأمر.\nhelp.options\tالخيارات\nhelp.tagline\tمترجم Native AOT وسلسلة أدوات للغة Mio\nhelp.title\tMio {0}\nhelp.usage\tالاستخدام\nopt.bunko\tاستخدام جذر Bunko هذا بدلًا من الجذر الافتراضي\nopt.color\tالتحكم في إخراج الألوان: auto أو always أو never\nopt.emit\tإنتاج بايت كود Mochi بدلًا من صورة أصلية\nopt.format\tاختيار صيغة الإخراج: human أو short أو json\nopt.gc_stress\tالبناء مع فحوص ضغط مكثفة جامع القمامة");
    string.write_string(output, "\nopt.help\tعرض المساعدة\nopt.lang\tاختيار لغة الإخراج بوسم BCP 47، مثل ja-JP\nopt.observe\tتسجيل ملاحظات البناء الأصلي\nopt.output\tكتابة الإخراج إلى هذا المسار\nopt.program_args\tتمرير الوسائط المتبقية إلى البرنامج\nopt.run_filter\tتشغيل الاختبارات التي تطابق أسماؤها هذا التعبير النمطي فقط\nopt.stdio\tاستخدام الإدخال والإخراج القياسيين لخادم اللغة\nopt.symbols\tكتابة معلومات الرموز الأصلية في هذا الملف\nopt.target\tالبناء لـ darwin-arm64 أو linux-amd64 أو windows-amd64\nopt.theme\tاختيار لوحة الألوان الدلالية: auto أو dark أو light\nopt.verbose\tتضمين تفاصيل تشخيص إضافية\nopt.version\tعرض معلومات الإصدار\ntest.assertion\tفشل التحقق\ntest.bunko_empty\tلا يمكن أن يكون مسار Bunko البديل فارغًا\ntest.bunko_missing\tقيمة مفقودة لـ --bunko-root\ntest.compile_failed\tفشلت الترجمة\ntest.duration\tالمدة الإجمالية\ntest.empty_filter\tلا يمكن أن يكون مرشح الاختبار فارغًا\ntest.empty_lang\tلا يمكن أن يكون وسم اللغة فارغًا\ntest.fail\tفاشل");
    string.write_string(output, "\ntest.filter_invalid\tمرشح اختبار غير صالح: {0}\ntest.invalid_arg\tوسيط اختبار غير صالح: {0}\ntest.invalid_signature\tتوقيع دالة الاختبار غير صالح\ntest.io_clean_dir\tتعذّر تنظيف مجلد الاختبار الخاص\ntest.io_clean_image\tتعذّر تنظيف صورة الاختبار الأصلية\ntest.io_dir\tتعذّر إنشاء مجلد اختبار خاص\ntest.io_protect\tتعذّر حماية مجلد الاختبار الخاص\ntest.missing_target\tهدف الاختبار مفقود\ntest.no_match\tلا توجد اختبارات تطابق --run={0}\ntest.none\tلم يتم العثور على اختبارات\ntest.pass\tناجح\ntest.resource\tتم تجاوز حد الموارد\ntest.runtime\tخطأ في وقت التنفيذ\ntest.skip\tمتجاوز\ntest.skipped\tالاختبارات المتجاوزة: {0}\ntest.starting\tبدء الاختبارات {0}\ntest.summary\tاكتملت الاختبارات: {0} ناجح، {1} فاشل");
    kaesu string.builder_string(output);
}

waza text_bn_bd() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tযাচাই উত্তীর্ণ\ncli.lsp_unknown\tঅজানা lsp আর্গুমেন্ট: {0}\ncmd.build\tMio সোর্স থেকে নেটিভ এক্সিকিউটেবল বা Mochi বাইটকোড তৈরি করুন\ncmd.check\tআউটপুট না বানিয়ে Mio সোর্স বিশ্লেষণ করুন\ncmd.disasm\tকম্পাইল করা Mochi প্রোগ্রাম ডিসঅ্যাসেম্বল করুন\ncmd.exec\tকম্পাইল করা Mochi প্রোগ্রাম চালান\ncmd.help\tMio বা একটি কমান্ডের সাহায্য দেখান\ncmd.lsp\tস্ট্যান্ডার্ড ইনপুট/আউটপুটে Mio ভাষা সার্ভার শুরু করুন\ncmd.run\tসোর্স থেকে Mio প্রোগ্রাম তৈরি ও চালান\ncmd.test\tMio পরীক্ষা প্যাকেজ খুঁজে চালান\ncmd.version\tসংস্করণ তথ্য দেখান\ndiag.cause\tকারণ\nerr.analysis\tসোর্স বিশ্লেষণ ব্যর্থ হয়েছে\nerr.bunko_empty\tBunko ওভাররাইড পথ স্পষ্ট ও অখালি হতে হবে\nerr.chmod_native\tনেটিভ আউটপুট চালানোর যোগ্য করা যায়নি\nerr.cleanup\tচালানোর পরে পরিষ্কার করা যায়নি\nerr.create_run_dir\tব্যক্তিগত রান ডিরেক্টরি তৈরি করা যায়নি\nerr.emit_mochi\tএই কমান্ড Mochi বাইটকোড তৈরি করতে পারে না\nerr.empty_paths\tসোর্স ও আউটপুট পথ খালি হতে পারে না\nerr.gc_stress\t--gc-stress শুধু সোর্স থেকে নেটিভ বিল্ডে প্রযোজ্য");
    string.write_string(output, "\nerr.help_args\thelp সর্বাধিক একটি কমান্ড নাম নেয়\nerr.help_unknown\tঅজানা কমান্ডের জন্য সাহায্য নেই: {0}\nerr.host_target\trun ও exec-এর জন্য হোস্ট লক্ষ্য {0} দরকার\nerr.invalid_color\tঅবৈধ রঙ মোড: {0} (auto, always বা never প্রত্যাশিত)\nerr.invalid_format\tঅবৈধ ফরম্যাট: {0} (human, short বা json প্রত্যাশিত)\nerr.invalid_theme\tঅবৈধ থিম: {0} (auto, dark বা light প্রত্যাশিত)\nerr.missing_value\tবিকল্প {0}-এর মান নেই\nerr.multiple_entries\tশুধু একটি সোর্স এন্ট্রি দেওয়া যায়\nerr.observe\t--observe শুধু সোর্স থেকে darwin-arm64 নেটিভ বিল্ডে প্রযোজ্য\nerr.program_args\tপ্রোগ্রাম আর্গুমেন্টের জন্য run বা exec দরকার\nerr.protect_run_dir\tব্যক্তিগত রান ডিরেক্টরি সুরক্ষিত করা যায়নি\nerr.read_mochi\tMochi ইনপুট পড়া যায়নি\nerr.run_output\trun ও exec নিজেদের নেটিভ আউটপুট পরিচালনা করে\nerr.spawn\tনেটিভ প্রোগ্রাম চালু করা যায়নি\nerr.symbols\t--emit-symbols শুধু সোর্স থেকে darwin-arm64 নেটিভ বিল্ডে প্রযোজ্য\nerr.target\tঅসমর্থিত লক্ষ্য: {0} (darwin-arm64, linux-amd64 বা windows-amd64 প্রত্যাশিত)\nerr.unknown_command\tঅজানা কমান্ড: {0}\nerr.unknown_option\tঅজানা বিকল্প: {0}\nerr.version_args\tversion কমান্ড কোনো আর্গুমেন্ট নেয় না\nerr.write_disasm\tডিসঅ্যাসেম্বলি লেখা যায়নি");
    string.write_string(output, "\nerr.write_mochi\tMochi আউটপুট লেখা যায়নি\nerr.write_native\tনেটিভ আউটপুট লেখা যায়নি\nhelp.commands\tকমান্ড\nhelp.examples\tউদাহরণ\nhelp.group.compilation\tকম্পাইলেশন\nhelp.group.diagnostics\tনির্ণয়\nhelp.group.execution\tনির্বাহ\nhelp.group.general\tসাধারণ\nhelp.group.testing\tপরীক্ষা\nhelp.group.tools\tউন্নয়ন সরঞ্জাম\nhelp.more\tকোনো কমান্ডের বিস্তারিত দেখতে 'mio help <কমান্ড>' চালান।\nhelp.options\tবিকল্প\nhelp.tagline\tMio ভাষার জন্য Native AOT কম্পাইলার ও টুলচেইন\nhelp.title\tMio {0}\nhelp.usage\tব্যবহার\nopt.bunko\tডিফল্টের বদলে এই Bunko রুট ব্যবহার করুন\nopt.color\tরঙিন আউটপুট নিয়ন্ত্রণ করুন: auto, always বা never\nopt.emit\tনেটিভ ইমেজের বদলে Mochi বাইটকোড তৈরি করুন\nopt.format\tআউটপুট ফরম্যাট বাছুন: human, short বা json\nopt.gc_stress\tতীব্র আবর্জনা সংগ্রাহক চাপ পরীক্ষাসহ তৈরি করুন");
    string.write_string(output, "\nopt.help\tসাহায্য দেখান\nopt.lang\tBCP 47 ট্যাগ দিয়ে আউটপুট ভাষা বাছুন, যেমন ja-JP\nopt.observe\tনেটিভ বিল্ডের পর্যবেক্ষণ রেকর্ড করুন\nopt.output\tআউটপুট এই পথে লিখুন\nopt.program_args\tবাকি আর্গুমেন্ট প্রোগ্রামে পাঠান\nopt.run_filter\tশুধু সেই পরীক্ষা চালান যাদের নাম এই রেগুলার এক্সপ্রেশনের সাথে মেলে\nopt.stdio\tভাষা সার্ভারের জন্য স্ট্যান্ডার্ড ইনপুট ও আউটপুট ব্যবহার করুন\nopt.symbols\tনেটিভ চিহ্নের তথ্য এই ফাইলে লিখুন\nopt.target\tdarwin-arm64, linux-amd64 বা windows-amd64-এর জন্য তৈরি করুন\nopt.theme\tঅর্থবহ রঙের প্যালেট বাছুন: auto, dark বা light\nopt.verbose\tঅতিরিক্ত নির্ণয় বিবরণ দেখান\nopt.version\tসংস্করণ তথ্য দেখান\ntest.assertion\tজোরালো দাবি ব্যর্থ\ntest.bunko_empty\tBunko ওভাররাইড পথ খালি হতে পারে না\ntest.bunko_missing\t--bunko-root এর মান নেই\ntest.compile_failed\tকম্পাইলেশন ব্যর্থ\ntest.duration\tমোট সময়\ntest.empty_filter\tপরীক্ষা ফিল্টার খালি হতে পারে না\ntest.empty_lang\tভাষা ট্যাগ খালি হতে পারে না\ntest.fail\tব্যর্থ");
    string.write_string(output, "\ntest.filter_invalid\tঅবৈধ পরীক্ষা ফিল্টার: {0}\ntest.invalid_arg\tঅবৈধ পরীক্ষা আর্গুমেন্ট: {0}\ntest.invalid_signature\tপরীক্ষা ফাংশনের স্বাক্ষর অবৈধ\ntest.io_clean_dir\tব্যক্তিগত পরীক্ষা ডিরেক্টরি পরিষ্কার করা যায়নি\ntest.io_clean_image\tনেটিভ পরীক্ষা ইমেজ পরিষ্কার করা যায়নি\ntest.io_dir\tব্যক্তিগত পরীক্ষা ডিরেক্টরি তৈরি করা যায়নি\ntest.io_protect\tব্যক্তিগত পরীক্ষা ডিরেক্টরি সুরক্ষিত করা যায়নি\ntest.missing_target\tপরীক্ষার লক্ষ্য নেই\ntest.no_match\t--run={0}-এর সাথে কোনো পরীক্ষা মেলে না\ntest.none\tকোনো পরীক্ষা পাওয়া যায়নি\ntest.pass\tউত্তীর্ণ\ntest.resource\tসম্পদ সীমা ছাড়িয়েছে\ntest.runtime\tরানটাইম ত্রুটি\ntest.skip\tবাদ\ntest.skipped\tবাদ দেওয়া পরীক্ষা: {0}\ntest.starting\tপরীক্ষা শুরু {0}\ntest.summary\tপরীক্ষা সম্পন্ন: {0} উত্তীর্ণ, {1} ব্যর্থ");
    kaesu string.builder_string(output);
}

waza text_cs_cz() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tkontrola prošla\ncli.lsp_unknown\tneznámý argument lsp: {0}\ncmd.build\tSestavit nativní spustitelný soubor nebo bytecode Mochi ze zdrojů Mio\ncmd.check\tAnalyzovat zdroje Mio bez vytváření výstupu\ncmd.disasm\tPřevést přeložený program Mochi na assembler\ncmd.exec\tSpustit přeložený program Mochi\ncmd.help\tZobrazit nápovědu k Mio nebo k jednomu příkazu\ncmd.lsp\tSpustit jazykový server Mio přes standardní vstup a výstup\ncmd.run\tSestavit a spustit program Mio ze zdrojů\ncmd.test\tNajít a spustit testovací balíčky Mio\ncmd.version\tZobrazit informace o verzi\ndiag.cause\tpříčina\nerr.analysis\tanalýza zdrojů selhala\nerr.bunko_empty\tcesta k náhradnímu Bunko musí být výslovná a nesmí být prázdná\nerr.chmod_native\tnelze nastavit nativní výstup jako spustitelný\nerr.cleanup\túklid po spuštění selhal\nerr.create_run_dir\tnelze vytvořit soukromý adresář spuštění\nerr.emit_mochi\ttento příkaz nemůže vytvořit bytecode Mochi\nerr.empty_paths\tcesty ke zdroji a výstupu nesmí být prázdné\nerr.gc_stress\t--gc-stress se vztahuje pouze na nativní sestavení ze zdrojů");
    string.write_string(output, "\nerr.help_args\thelp přijímá nejvýše jeden název příkazu\nerr.help_unknown\tpro neznámý příkaz není nápověda: {0}\nerr.host_target\trun a exec vyžadují cílový hostitel {0}\nerr.invalid_color\tneplatný barevný režim: {0} (očekáváno auto, always nebo never)\nerr.invalid_format\tneplatný formát: {0} (očekáváno human, short nebo json)\nerr.invalid_theme\tneplatné téma: {0} (očekáváno auto, dark nebo light)\nerr.missing_value\tchybí hodnota možnosti {0}\nerr.multiple_entries\tlze zadat pouze jednu zdrojovou položku\nerr.observe\t--observe se vztahuje pouze na nativní sestavení darwin-arm64 ze zdrojů\nerr.program_args\targumenty programu vyžadují run nebo exec\nerr.protect_run_dir\tnelze chránit soukromý adresář spuštění\nerr.read_mochi\tnelze načíst vstup Mochi\nerr.run_output\trun a exec spravují svůj vlastní nativní výstup\nerr.spawn\tnativní program nelze spustit\nerr.symbols\t--emit-symbols se vztahuje pouze na nativní sestavení darwin-arm64 ze zdrojů\nerr.target\tnepodporovaný cíl: {0} (očekáváno darwin-arm64, linux-amd64 nebo windows-amd64)\nerr.unknown_command\tneznámý příkaz: {0}\nerr.unknown_option\tneznámá možnost: {0}\nerr.version_args\tpříkaz version nepřijímá argumenty\nerr.write_disasm\tnelze zapsat převod do assembleru");
    string.write_string(output, "\nerr.write_mochi\tnelze zapsat výstup Mochi\nerr.write_native\tnelze zapsat nativní výstup\nhelp.commands\tPříkazy\nhelp.examples\tPříklady\nhelp.group.compilation\tKompilace\nhelp.group.diagnostics\tDiagnostika\nhelp.group.execution\tSpuštění\nhelp.group.general\tObecné\nhelp.group.testing\tTesty\nhelp.group.tools\tVývojové nástroje\nhelp.more\tSpuštěním 'mio help <příkaz>' zobrazíte podrobnosti příkazu.\nhelp.options\tMožnosti\nhelp.tagline\tKompilátor Native AOT a sada nástrojů pro jazyk Mio\nhelp.title\tMio {0}\nhelp.usage\tPoužití\nopt.bunko\tPoužít tento kořen Bunko místo výchozího\nopt.color\tŘídit barevný výstup: auto, always nebo never\nopt.emit\tVytvořit bytecode Mochi místo nativního obrazu\nopt.format\tVybrat formát výstupu: human, short nebo json\nopt.gc_stress\tSestavit s agresivními zátěžovými kontrolami garbage collectoru");
    string.write_string(output, "\nopt.help\tZobrazit nápovědu\nopt.lang\tVybrat jazyk výstupu pomocí značky BCP 47, například ja-JP\nopt.observe\tZaznamenat pozorování nativního sestavení\nopt.output\tZapsat výstup do této cesty\nopt.program_args\tPředat zbývající argumenty programu\nopt.run_filter\tSpustit pouze testy, jejichž názvy odpovídají tomuto regulárnímu výrazu\nopt.stdio\tPoužít standardní vstup a výstup pro jazykový server\nopt.symbols\tZapsat informace o nativních symbolech do tohoto souboru\nopt.target\tSestavit pro darwin-arm64, linux-amd64 nebo windows-amd64\nopt.theme\tVybrat sémantickou paletu: auto, dark nebo light\nopt.verbose\tZahrnout další diagnostické podrobnosti\nopt.version\tZobrazit informace o verzi\ntest.assertion\tkontrolní tvrzení selhalo\ntest.bunko_empty\tcesta k náhradnímu Bunko nesmí být prázdná\ntest.bunko_missing\tchybí hodnota --bunko-root\ntest.compile_failed\tkompilace selhala\ntest.duration\tcelková doba\ntest.empty_filter\tfiltr testů nesmí být prázdný\ntest.empty_lang\tjazyková značka nesmí být prázdná\ntest.fail\tSELHÁNÍ");
    string.write_string(output, "\ntest.filter_invalid\tneplatný filtr testů: {0}\ntest.invalid_arg\tneplatný argument testu: {0}\ntest.invalid_signature\tneplatný podpis testovací funkce\ntest.io_clean_dir\tnelze uklidit soukromý adresář testů\ntest.io_clean_image\tnelze uklidit nativní testovací obraz\ntest.io_dir\tnelze vytvořit soukromý adresář testů\ntest.io_protect\tnelze chránit soukromý adresář testů\ntest.missing_target\tchybí cíl testů\ntest.no_match\tžádný test neodpovídá --run={0}\ntest.none\tnenalezeny žádné testy\ntest.pass\tÚSPĚCH\ntest.resource\tpřekročen limit prostředků\ntest.runtime\tchyba za běhu\ntest.skip\tPŘESKOČENO\ntest.skipped\tPřeskočené testy: {0}\ntest.starting\tSpouštění testů {0}\ntest.summary\tTesty dokončeny: {0} úspěšných, {1} selhaných");
    kaesu string.builder_string(output);
}

waza text_da_dk() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tkontrollen bestået\ncli.lsp_unknown\tukendt lsp-argument: {0}\ncmd.build\tByg en native eksekverbar fil eller Mochi-bytekode fra Mio-kildekode\ncmd.check\tAnalysér Mio-kildekode uden at producere output\ncmd.disasm\tDisassemblér et kompileret Mochi-program\ncmd.exec\tKør et kompileret Mochi-program\ncmd.help\tVis hjælp til Mio eller en enkelt kommando\ncmd.lsp\tStart Mio-sprogserveren over standard input/output\ncmd.run\tByg og kør et Mio-program fra kildekode\ncmd.test\tFind og kør Mio-testpakker\ncmd.version\tVis versionsoplysninger\ndiag.cause\tårsag\nerr.analysis\tkildeanalysen mislykkedes\nerr.bunko_empty\tBunko-tilsidesættelsens sti skal være eksplicit og ikke tom\nerr.chmod_native\tkan ikke gøre native output eksekverbar\nerr.cleanup\toprydningen efter kørslen mislykkedes\nerr.create_run_dir\tkan ikke oprette en privat kørselsmappe\nerr.emit_mochi\tdenne kommando kan ikke udskrive Mochi-bytekode\nerr.empty_paths\tkilde- og outputstierne må ikke være tomme\nerr.gc_stress\t--gc-stress gælder kun for native builds fra kildekode");
    string.write_string(output, "\nerr.help_args\thelp tager højst ét kommandonavn\nerr.help_unknown\tingen hjælp til ukendt kommando: {0}\nerr.host_target\trun og exec kræver værtsmålet {0}\nerr.invalid_color\tugyldig farvetilstand: {0} (forventede auto, always eller never)\nerr.invalid_format\tugyldigt format: {0} (forventede human, short eller json)\nerr.invalid_theme\tugyldigt tema: {0} (forventede auto, dark eller light)\nerr.missing_value\tværdien mangler for valgmuligheden {0}\nerr.multiple_entries\tder kan kun angives én kildeindgang\nerr.observe\t--observe gælder kun for native darwin-arm64-builds fra kildekode\nerr.program_args\tprogramargumenter kræver run eller exec\nerr.protect_run_dir\tkan ikke beskytte den private kørselsmappe\nerr.read_mochi\tkan ikke læse Mochi-input\nerr.run_output\trun og exec styrer deres egen native output\nerr.spawn\tdet native program kunne ikke startes\nerr.symbols\t--emit-symbols gælder kun for native darwin-arm64-builds fra kildekode\nerr.target\tikke-understøttet mål: {0} (forventede darwin-arm64, linux-amd64 eller windows-amd64)\nerr.unknown_command\tukendt kommando: {0}\nerr.unknown_option\tukendt valgmulighed: {0}\nerr.version_args\tkommandoen version tager ingen argumenter\nerr.write_disasm\tkan ikke skrive disassembleringen");
    string.write_string(output, "\nerr.write_mochi\tkan ikke skrive Mochi-output\nerr.write_native\tkan ikke skrive native output\nhelp.commands\tKommandoer\nhelp.examples\tEksempler\nhelp.group.compilation\tKompilering\nhelp.group.diagnostics\tDiagnostik\nhelp.group.execution\tKørsel\nhelp.group.general\tGenerelt\nhelp.group.testing\tTests\nhelp.group.tools\tUdviklingsværktøjer\nhelp.more\tKør 'mio help <kommando>' for detaljer om en kommando.\nhelp.options\tValgmuligheder\nhelp.tagline\tNative AOT-kompiler og værktøjskæde til sproget Mio\nhelp.title\tMio {0}\nhelp.usage\tBrug\nopt.bunko\tBrug denne Bunko-rod i stedet for standarden\nopt.color\tStyr farveoutput: auto, always eller never\nopt.emit\tUdskriv Mochi-bytekode i stedet for et native billede\nopt.format\tVælg outputformat: human, short eller json\nopt.gc_stress\tByg med aggressive stresstests af skraldesamleren");
    string.write_string(output, "\nopt.help\tVis hjælp\nopt.lang\tVælg outputsprog med et BCP 47-tag, for eksempel ja-JP\nopt.observe\tRegistrér observationer fra den native build\nopt.output\tSkriv output til denne sti\nopt.program_args\tVideregiv de resterende argumenter til programmet\nopt.run_filter\tKør kun tests, hvis navn matcher denne regulære udtryk\nopt.stdio\tBrug standard input og output til sprogserveren\nopt.symbols\tSkriv native symboloplysninger til denne fil\nopt.target\tByg til darwin-arm64, linux-amd64 eller windows-amd64\nopt.theme\tVælg en semantisk farvepalet: auto, dark eller light\nopt.verbose\tMedtag yderligere diagnostiske detaljer\nopt.version\tVis versionsoplysninger\ntest.assertion\tpåstanden mislykkedes\ntest.bunko_empty\tBunko-tilsidesættelsens sti må ikke være tom\ntest.bunko_missing\tværdien mangler for --bunko-root\ntest.compile_failed\tkompileringen mislykkedes\ntest.duration\tsamlet varighed\ntest.empty_filter\ttestfiltret må ikke være tomt\ntest.empty_lang\tsprogtagget må ikke være tomt\ntest.fail\tMISLYKKET");
    string.write_string(output, "\ntest.filter_invalid\tugyldigt testfilter: {0}\ntest.invalid_arg\tugyldigt testargument: {0}\ntest.invalid_signature\tugyldig signatur for testfunktion\ntest.io_clean_dir\tkan ikke rydde den private testmappe\ntest.io_clean_image\tkan ikke rydde det native testbillede\ntest.io_dir\tkan ikke oprette en privat testmappe\ntest.io_protect\tkan ikke beskytte den private testmappe\ntest.missing_target\ttestmålet mangler\ntest.no_match\tingen tests matcher --run={0}\ntest.none\tingen tests fundet\ntest.pass\tBESTÅET\ntest.resource\tressourcegrænsen er overskredet\ntest.runtime\tkørselsfejl\ntest.skip\tSPRINGET OVER\ntest.skipped\tOverprungne tests: {0}\ntest.starting\tStarter tests {0}\ntest.summary\tTests færdige: {0} bestået, {1} mislykket");
    kaesu string.builder_string(output);
}

waza text_de_de() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tPrüfung bestanden\ncli.lsp_unknown\tunbekanntes lsp-Argument: {0}\ncmd.build\tEine native ausführbare Datei oder Mochi-Bytecode aus Mio-Quellen bauen\ncmd.check\tMio-Quellen ohne Ausgabe analysieren\ncmd.disasm\tEin kompiliertes Mochi-Programm disassemblieren\ncmd.exec\tEin kompiliertes Mochi-Programm ausführen\ncmd.help\tHilfe für Mio oder einen einzelnen Befehl anzeigen\ncmd.lsp\tDen Mio-Sprachserver über Standard-Ein-/Ausgabe starten\ncmd.run\tEin Mio-Programm aus Quellen bauen und ausführen\ncmd.test\tMio-Testpakete ermitteln und ausführen\ncmd.version\tVersionsinformationen anzeigen\ndiag.cause\tUrsache\nerr.analysis\tQuellanalyse fehlgeschlagen\nerr.bunko_empty\tder Bunko-Ersatzpfad muss ausdrücklich angegeben und nicht leer sein\nerr.chmod_native\tnative Ausgabe kann nicht ausführbar gemacht werden\nerr.cleanup\tAufräumen nach der Ausführung fehlgeschlagen\nerr.create_run_dir\tprivates Ausführungsverzeichnis kann nicht erstellt werden\nerr.emit_mochi\tdieser Befehl kann keinen Mochi-Bytecode ausgeben\nerr.empty_paths\tQuell- und Ausgabepfad dürfen nicht leer sein\nerr.gc_stress\t--gc-stress gilt nur für native Builds aus Quellen");
    string.write_string(output, "\nerr.help_args\thelp akzeptiert höchstens einen Befehlsnamen\nerr.help_unknown\tkeine Hilfe für unbekannten Befehl: {0}\nerr.host_target\trun und exec benötigen das Hostziel {0}\nerr.invalid_color\tungültiger Farbmodus: {0} (erwartet: auto, always oder never)\nerr.invalid_format\tungültiges Format: {0} (erwartet: human, short oder json)\nerr.invalid_theme\tungültiges Design: {0} (erwartet: auto, dark oder light)\nerr.missing_value\tfehlender Wert für Option {0}\nerr.multiple_entries\tes darf nur ein Quelleintrag angegeben werden\nerr.observe\t--observe gilt nur für native darwin-arm64-Builds aus Quellen\nerr.program_args\tProgrammargumente erfordern run oder exec\nerr.protect_run_dir\tprivates Ausführungsverzeichnis kann nicht geschützt werden\nerr.read_mochi\tMochi-Eingabe kann nicht gelesen werden\nerr.run_output\trun und exec verwalten ihre native Ausgabe selbst\nerr.spawn\tdas native Programm konnte nicht gestartet werden\nerr.symbols\t--emit-symbols gilt nur für native darwin-arm64-Builds aus Quellen\nerr.target\tnicht unterstütztes Ziel: {0} (erwartet: darwin-arm64, linux-amd64 oder windows-amd64)\nerr.unknown_command\tunbekannter Befehl: {0}\nerr.unknown_option\tunbekannte Option: {0}\nerr.version_args\tder Befehl version akzeptiert keine Argumente\nerr.write_disasm\tDisassemblierung kann nicht geschrieben werden");
    string.write_string(output, "\nerr.write_mochi\tMochi-Ausgabe kann nicht geschrieben werden\nerr.write_native\tnative Ausgabe kann nicht geschrieben werden\nhelp.commands\tBefehle\nhelp.examples\tBeispiele\nhelp.group.compilation\tKompilierung\nhelp.group.diagnostics\tDiagnose\nhelp.group.execution\tAusführung\nhelp.group.general\tAllgemein\nhelp.group.testing\tTests\nhelp.group.tools\tEntwicklungswerkzeuge\nhelp.more\tFühren Sie 'mio help <Befehl>' für Details zu einem Befehl aus.\nhelp.options\tOptionen\nhelp.tagline\tNative-AOT-Compiler und Toolchain für die Sprache Mio\nhelp.title\tMio {0}\nhelp.usage\tVerwendung\nopt.bunko\tDieses Bunko-Stammverzeichnis statt des Standards verwenden\nopt.color\tFarbausgabe steuern: auto, always oder never\nopt.emit\tMochi-Bytecode statt eines nativen Images ausgeben\nopt.format\tAusgabeformat wählen: human, short oder json\nopt.gc_stress\tMit aggressiven Speicherbereinigungs-Stresstests bauen");
    string.write_string(output, "\nopt.help\tHilfe anzeigen\nopt.lang\tAusgabesprache über ein BCP-47-Tag wählen, zum Beispiel ja-JP\nopt.observe\tBeobachtungsdaten des nativen Baus aufzeichnen\nopt.output\tAusgabe in diesen Pfad schreiben\nopt.program_args\tDie übrigen Argumente an das Programm übergeben\nopt.run_filter\tNur Tests ausführen, deren Namen diesem regulären Ausdruck entsprechen\nopt.stdio\tStandard-Ein-/Ausgabe für den Sprachserver verwenden\nopt.symbols\tNative Symbolinformationen in diese Datei schreiben\nopt.target\tFür darwin-arm64, linux-amd64 oder windows-amd64 bauen\nopt.theme\tSemantische Farbpalette wählen: auto, dark oder light\nopt.verbose\tZusätzliche Diagnosedetails ausgeben\nopt.version\tVersionsinformationen anzeigen\ntest.assertion\tZusicherung fehlgeschlagen\ntest.bunko_empty\tder Bunko-Ersatzpfad darf nicht leer sein\ntest.bunko_missing\tfehlender Wert für --bunko-root\ntest.compile_failed\tKompilierung fehlgeschlagen\ntest.duration\tGesamtdauer\ntest.empty_filter\tder Testfilter darf nicht leer sein\ntest.empty_lang\tdas Sprach-Tag darf nicht leer sein\ntest.fail\tFEHLGESCHLAGEN");
    string.write_string(output, "\ntest.filter_invalid\tungültiger Testfilter: {0}\ntest.invalid_arg\tungültiges Testargument: {0}\ntest.invalid_signature\tungültige Signatur der Testfunktion\ntest.io_clean_dir\tprivates Testverzeichnis kann nicht bereinigt werden\ntest.io_clean_image\tnatives Testabbild kann nicht bereinigt werden\ntest.io_dir\tprivates Testverzeichnis kann nicht erstellt werden\ntest.io_protect\tprivates Testverzeichnis kann nicht geschützt werden\ntest.missing_target\tTestziel fehlt\ntest.no_match\tkeine Tests passen zu --run={0}\ntest.none\tkeine Tests gefunden\ntest.pass\tBESTANDEN\ntest.resource\tRessourcengrenze überschritten\ntest.runtime\tLaufzeitfehler\ntest.skip\tÜBERSPRUNGEN\ntest.skipped\tÜbersprungene Tests: {0}\ntest.starting\tTests werden gestartet {0}\ntest.summary\tTests abgeschlossen: {0} bestanden, {1} fehlgeschlagen");
    kaesu string.builder_string(output);
}

waza text_el_gr() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tο έλεγχος πέρασε\ncli.lsp_unknown\tάγνωστο όρισμα lsp: {0}\ncmd.build\tΔημιουργία εγγενούς εκτελέσιμου ή bytecode Mochi από πηγαίο κώδικα Mio\ncmd.check\tΑνάλυση πηγαίου κώδικα Mio χωρίς παραγωγή εξόδου\ncmd.disasm\tΑποσυμβολισμός μεταγλωττισμένου προγράμματος Mochi\ncmd.exec\tΕκτέλεση μεταγλωττισμένου προγράμματος Mochi\ncmd.help\tΕμφάνιση βοήθειας για το Mio ή για μία εντολή\ncmd.lsp\tΕκκίνηση διακομιστή γλώσσας Mio μέσω τυπικής εισόδου/εξόδου\ncmd.run\tΔημιουργία και εκτέλεση προγράμματος Mio από τον πηγαίο κώδικα\ncmd.test\tΕύρεση και εκτέλεση πακέτων δοκιμών Mio\ncmd.version\tΕμφάνιση πληροφοριών έκδοσης\ndiag.cause\tαιτία\nerr.analysis\tη ανάλυση του πηγαίου κώδικα απέτυχε\nerr.bunko_empty\tη διαδρομή παράκαμψης Bunko πρέπει να είναι ρητή και μη κενή\nerr.chmod_native\tδεν είναι δυνατή η μετατροπή της εγγενούς εξόδου σε εκτελέσιμη\nerr.cleanup\tο καθαρισμός μετά την εκτέλεση απέτυχε\nerr.create_run_dir\tδεν είναι δυνατή η δημιουργία ιδιωτικού καταλόγου εκτέλεσης\nerr.emit_mochi\tαυτή η εντολή δεν μπορεί να παράγει bytecode Mochi\nerr.empty_paths\tοι διαδρομές πηγής και εξόδου δεν μπορούν να είναι κενές\nerr.gc_stress\tτο --gc-stress ισχύει μόνο για εγγενείς δημιουργίες από πηγαίο κώδικα");
    string.write_string(output, "\nerr.help_args\tη help δέχεται το πολύ ένα όνομα εντολής\nerr.help_unknown\tδεν υπάρχει βοήθεια για άγνωστη εντολή: {0}\nerr.host_target\tτα run και exec απαιτούν τον στόχο υπολογιστή {0}\nerr.invalid_color\tμη έγκυρη λειτουργία χρώματος: {0} (αναμένεται auto, always ή never)\nerr.invalid_format\tμη έγκυρη μορφή: {0} (αναμένεται human, short ή json)\nerr.invalid_theme\tμη έγκυρο θέμα: {0} (αναμένεται auto, dark ή light)\nerr.missing_value\tλείπει τιμή για την επιλογή {0}\nerr.multiple_entries\tμπορεί να δοθεί μόνο μία καταχώριση πηγής\nerr.observe\tτο --observe ισχύει μόνο για εγγενείς δημιουργίες darwin-arm64 από πηγαίο κώδικα\nerr.program_args\tτα ορίσματα προγράμματος απαιτούν run ή exec\nerr.protect_run_dir\tδεν είναι δυνατή η προστασία του ιδιωτικού καταλόγου εκτέλεσης\nerr.read_mochi\tδεν είναι δυνατή η ανάγνωση της εισόδου Mochi\nerr.run_output\tτα run και exec διαχειρίζονται τη δική τους εγγενή έξοδο\nerr.spawn\tδεν ήταν δυνατή η εκκίνηση του εγγενούς προγράμματος\nerr.symbols\tτο --emit-symbols ισχύει μόνο για εγγενείς δημιουργίες darwin-arm64 από πηγαίο κώδικα\nerr.target\tμη υποστηριζόμενος στόχος: {0} (αναμένεται darwin-arm64, linux-amd64 ή windows-amd64)\nerr.unknown_command\tάγνωστη εντολή: {0}\nerr.unknown_option\tάγνωστη επιλογή: {0}\nerr.version_args\tη εντολή version δεν δέχεται ορίσματα\nerr.write_disasm\tδεν είναι δυνατή η εγγραφή του αποσυμβολισμού");
    string.write_string(output, "\nerr.write_mochi\tδεν είναι δυνατή η εγγραφή της εξόδου Mochi\nerr.write_native\tδεν είναι δυνατή η εγγραφή της εγγενούς εξόδου\nhelp.commands\tΕντολές\nhelp.examples\tΠαραδείγματα\nhelp.group.compilation\tΜεταγλώττιση\nhelp.group.diagnostics\tΔιάγνωση\nhelp.group.execution\tΕκτέλεση\nhelp.group.general\tΓενικά\nhelp.group.testing\tΔοκιμές\nhelp.group.tools\tΕργαλεία ανάπτυξης\nhelp.more\tΕκτελέστε 'mio help <εντολή>' για λεπτομέρειες μιας εντολής.\nhelp.options\tΕπιλογές\nhelp.tagline\tΜεταγλωττιστής Native AOT και εργαλειοθήκη για τη γλώσσα Mio\nhelp.title\tMio {0}\nhelp.usage\tΧρήση\nopt.bunko\tΧρήση αυτής της ρίζας Bunko αντί της προεπιλεγμένης\nopt.color\tΈλεγχος έγχρωμης εξόδου: auto, always ή never\nopt.emit\tΠαραγωγή bytecode Mochi αντί για εγγενή εικόνα\nopt.format\tΕπιλογή μορφής εξόδου: human, short ή json\nopt.gc_stress\tΔημιουργία με έντονους ελέγχους φόρτου του συλλέκτη απορριμμάτων");
    string.write_string(output, "\nopt.help\tΕμφάνιση βοήθειας\nopt.lang\tΕπιλογή γλώσσας εξόδου με ετικέτα BCP 47, για παράδειγμα ja-JP\nopt.observe\tΚαταγραφή παρατηρήσεων της εγγενούς δημιουργίας\nopt.output\tΕγγραφή εξόδου σε αυτή τη διαδρομή\nopt.program_args\tΜεταβίβαση των υπόλοιπων ορισμάτων στο πρόγραμμα\nopt.run_filter\tΕκτέλεση μόνο δοκιμών των οποίων το όνομα ταιριάζει με αυτή την κανονική έκφραση\nopt.stdio\tΧρήση τυπικής εισόδου και εξόδου για τον διακομιστή γλώσσας\nopt.symbols\tΕγγραφή πληροφοριών εγγενών συμβόλων σε αυτό το αρχείο\nopt.target\tΔημιουργία για darwin-arm64, linux-amd64 ή windows-amd64\nopt.theme\tΕπιλογή σημασιολογικής παλέτας: auto, dark ή light\nopt.verbose\tΣυμπερίληψη πρόσθετων λεπτομερειών διάγνωσης\nopt.version\tΕμφάνιση πληροφοριών έκδοσης\ntest.assertion\tη επαλήθευση απέτυχε\ntest.bunko_empty\tη διαδρομή παράκαμψης Bunko δεν μπορεί να είναι κενή\ntest.bunko_missing\tλείπει τιμή για το --bunko-root\ntest.compile_failed\tη μεταγλώττιση απέτυχε\ntest.duration\tσυνολική διάρκεια\ntest.empty_filter\tτο φίλτρο δοκιμών δεν μπορεί να είναι κενό\ntest.empty_lang\tη ετικέτα γλώσσας δεν μπορεί να είναι κενή\ntest.fail\tΑΠΟΤΥΧΙΑ");
    string.write_string(output, "\ntest.filter_invalid\tμη έγκυρο φίλτρο δοκιμών: {0}\ntest.invalid_arg\tμη έγκυρο όρισμα δοκιμής: {0}\ntest.invalid_signature\tμη έγκυρη υπογραφή συνάρτησης δοκιμής\ntest.io_clean_dir\tδεν είναι δυνατός ο καθαρισμός του ιδιωτικού καταλόγου δοκιμών\ntest.io_clean_image\tδεν είναι δυνατός ο καθαρισμός της εγγενούς εικόνας δοκιμής\ntest.io_dir\tδεν είναι δυνατή η δημιουργία ιδιωτικού καταλόγου δοκιμών\ntest.io_protect\tδεν είναι δυνατή η προστασία του ιδιωτικού καταλόγου δοκιμών\ntest.missing_target\tλείπει ο στόχος δοκιμών\ntest.no_match\tκαμία δοκιμή δεν ταιριάζει με --run={0}\ntest.none\tδεν βρέθηκαν δοκιμές\ntest.pass\tΕΠΙΤΥΧΙΑ\ntest.resource\tυπέρβαση ορίου πόρων\ntest.runtime\tσφάλμα χρόνου εκτέλεσης\ntest.skip\tΠΑΡΑΛΕΙΨΗ\ntest.skipped\tΠαραλειπόμενες δοκιμές: {0}\ntest.starting\tΈναρξη δοκιμών {0}\ntest.summary\tΟι δοκιμές ολοκληρώθηκαν: {0} επιτυχίες, {1} αποτυχίες");
    kaesu string.builder_string(output);
}

waza text_en_gb() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tcheck passed\ncli.lsp_unknown\tunknown lsp argument: {0}\ncmd.build\tBuild a native executable or Mochi bytecode from Mio source\ncmd.check\tAnalyse Mio source without producing output\ncmd.disasm\tDisassemble a compiled Mochi program\ncmd.exec\tRun a compiled Mochi program\ncmd.help\tShow help for Mio or for one command\ncmd.lsp\tStart the Mio language server over standard I/O\ncmd.run\tBuild and run a Mio program from source\ncmd.test\tDiscover and run Mio test packages\ncmd.version\tShow version information\ndiag.cause\tcause\nerr.analysis\tsource analysis failed\nerr.bunko_empty\tthe Bunko override must be explicit and nonempty\nerr.chmod_native\tcannot make the native output executable\nerr.cleanup\trun cleanup failed\nerr.create_run_dir\tcannot create a private run directory\nerr.emit_mochi\tthis command cannot emit Mochi bytecode\nerr.empty_paths\tthe source and output paths must be nonempty\nerr.gc_stress\t--gc-stress applies only to native builds from source");
    string.write_string(output, "\nerr.help_args\thelp takes at most one command name\nerr.help_unknown\tno help for unknown command: {0}\nerr.host_target\trun and exec require the host target {0}\nerr.invalid_color\tinvalid colour mode: {0} (expected auto, always or never)\nerr.invalid_format\tinvalid format: {0} (expected human, short or json)\nerr.invalid_theme\tinvalid theme: {0} (expected auto, dark or light)\nerr.missing_value\tmissing value for option {0}\nerr.multiple_entries\tonly one source entry may be given\nerr.observe\t--observe applies only to darwin-arm64 native builds from source\nerr.program_args\tprogram arguments require run or exec\nerr.protect_run_dir\tcannot protect the private run directory\nerr.read_mochi\tcannot read the Mochi input\nerr.run_output\trun and exec manage their own native output\nerr.spawn\tthe native program could not be started\nerr.symbols\t--emit-symbols applies only to darwin-arm64 native builds from source\nerr.target\tunsupported target: {0} (expected darwin-arm64, linux-amd64 or windows-amd64)\nerr.unknown_command\tunknown command: {0}\nerr.unknown_option\tunknown option: {0}\nerr.version_args\tthe version command takes no arguments\nerr.write_disasm\tcannot write the disassembly");
    string.write_string(output, "\nerr.write_mochi\tcannot write the Mochi output\nerr.write_native\tcannot write the native output\nhelp.commands\tCommands\nhelp.examples\tExamples\nhelp.group.compilation\tCompilation\nhelp.group.diagnostics\tDiagnostics\nhelp.group.execution\tExecution\nhelp.group.general\tGeneral\nhelp.group.testing\tTesting\nhelp.group.tools\tDevelopment tools\nhelp.more\tRun 'mio help <command>' for command details.\nhelp.options\tOptions\nhelp.tagline\tNative AOT compiler and toolchain for the Mio language\nhelp.title\tMio {0}\nhelp.usage\tUsage\nopt.bunko\tUse this Bunko root instead of the default\nopt.color\tControl colour output: auto, always or never\nopt.emit\tEmit Mochi bytecode instead of a native image\nopt.format\tSelect the output format: human, short or json\nopt.gc_stress\tBuild with aggressive garbage-collector stress checks");
    string.write_string(output, "\nopt.help\tShow help\nopt.lang\tSelect the output language by BCP 47 tag, for example ja-JP\nopt.observe\tRecord native build observations\nopt.output\tWrite output to this path\nopt.program_args\tPass the remaining arguments to the program\nopt.run_filter\tRun only tests whose names match this regular expression\nopt.stdio\tUse standard input and output for the language server\nopt.symbols\tWrite native symbol information to this file\nopt.target\tBuild for darwin-arm64, linux-amd64 or windows-amd64\nopt.theme\tSelect the semantic palette: auto, dark or light\nopt.verbose\tInclude additional diagnostic detail\nopt.version\tShow version information\ntest.assertion\tassertion failed\ntest.bunko_empty\tthe Bunko override must be nonempty\ntest.bunko_missing\tmissing value for --bunko-root\ntest.compile_failed\tcompilation failed\ntest.duration\ttotal duration\ntest.empty_filter\tthe test filter must be nonempty\ntest.empty_lang\tthe language tag must be nonempty\ntest.fail\tFAIL");
