waza text_pl_pl() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\nbunko.dependency\tnie można wczytać zależności: {0}\nbunko.missing\tBunko nie jest zainstalowane. Użyj --bunko-root lub MIO_BUNKO, aby zaimportować {0}.\nbunko.package_read\tnie można odczytać pakietu: {0}\nbunko.root_layout\toczekiwano katalogu Bunko zawierającego kiso/: {0}\nbunko.root_resolve\tnie można ustalić rzeczywistej ścieżki katalogu: {0}\ncheck.passed\tsprawdzenie zakończone pomyślnie\ncli.lsp_unknown\tnieznany argument lsp: {0}\ncmd.build\tZbuduj natywny plik wykonywalny lub bajtkod Mochi ze źródeł Mio\ncmd.check\tAnalizuj źródła Mio bez tworzenia danych wyjściowych\ncmd.disasm\tZdeasembluj skompilowany program Mochi\ncmd.exec\tUruchom skompilowany program Mochi\ncmd.fmt\tFormatuje pliki źródłowe Mio.\ncmd.help\tPokaż pomoc dla Mio lub jednego polecenia\ncmd.lint\tSprawdza kod źródłowy Mio pod kątem typowych problemów.\ncmd.lsp\tUruchom serwer języka Mio przez standardowe wejście i wyjście\ncmd.run\tZbuduj i uruchom program Mio ze źródeł\ncmd.test\tZnajdź i uruchom pakiety testów Mio\ncmd.version\tPokaż informacje o wersji\ndiag.cause\tprzyczyna\ndiag.error\tbłąd");
    string.write_string(output, "\ndiag.expected_actual\toczekiwano {0}, otrzymano {1}\ndiag.lexical\tnierozpoznany tekst źródłowy\ndiag.note\tuwaga\ndiag.suggestion\tsugestia\ndiag.warning\tostrzeżenie\nerr.analysis\tanaliza źródeł nie powiodła się\nerr.bunko_empty\tzastępcza ścieżka Bunko musi być jawna i niepusta\nerr.chmod_native\tnie można uczynić wyjścia natywnego wykonywalnym\nerr.cleanup\tsprzątanie po uruchomieniu nie powiodło się\nerr.create_run_dir\tnie można utworzyć prywatnego katalogu uruchomienia\nerr.emit_mochi\tto polecenie nie może generować bajtkodu Mochi\nerr.empty_paths\tścieżki źródła i wyjścia nie mogą być puste\nerr.gc_stress\t--gc-stress dotyczy tylko natywnych kompilacji ze źródeł\nerr.help_args\thelp przyjmuje co najwyżej jedną nazwę polecenia\nerr.help_unknown\tbrak pomocy dla nieznanego polecenia: {0}\nerr.host_target\trun i exec wymagają celu hosta {0}\nerr.invalid_color\tnieprawidłowy tryb kolorów: {0} (oczekiwano auto, always lub never)\nerr.invalid_format\tnieprawidłowy format: {0} (oczekiwano human, short lub json)\nerr.invalid_theme\tnieprawidłowy motyw: {0} (oczekiwano auto, dark lub light)\nerr.missing_value\tbrak wartości opcji {0}");
    string.write_string(output, "\nerr.multiple_entries\tmożna podać tylko jeden wpis źródłowy\nerr.observe\t--observe dotyczy tylko natywnych kompilacji darwin-arm64 ze źródeł\nerr.open_stream\tnie można otworzyć {0}\nerr.program_args\targumenty programu wymagają run lub exec\nerr.protect_run_dir\tnie można zabezpieczyć prywatnego katalogu uruchomienia\nerr.read_mochi\tnie można odczytać wejścia Mochi\nerr.run_output\trun i exec samodzielnie zarządzają wyjściem natywnym\nerr.spawn\tnie można uruchomić programu natywnego\nerr.symbols\t--emit-symbols dotyczy tylko natywnych kompilacji darwin-arm64 ze źródeł\nerr.target\tnieobsługiwany cel: {0} (oczekiwano darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64)\nerr.unknown_command\tnieznane polecenie: {0}\nerr.unknown_option\tnieznana opcja: {0}\nerr.version_args\tpolecenie version nie przyjmuje argumentów\nerr.write_disasm\tnie można zapisać deasemblacji\nerr.write_help\tnie można wyświetlić pomocy\nerr.write_mochi\tnie można zapisać wyjścia Mochi\nerr.write_native\tnie można zapisać wyjścia natywnego\nfmt.behavior\tKatalogi są przeszukiwane rekurencyjnie. Użyj --stdin, aby czytać ze standardowego wejścia, i --check, aby zgłosić zmiany bez zapisywania.\nfmt.status\tKod wyjścia: 0 powodzenie, 1 potrzebne zmiany w trybie --check, 2 błąd użycia, składni lub wejścia/wyjścia.\nhelp.commands\tPolecenia");
    string.write_string(output, "\nhelp.examples\tPrzykłady\nhelp.group.compilation\tKompilacja\nhelp.group.diagnostics\tDiagnostyka\nhelp.group.execution\tWykonanie\nhelp.group.general\tOgólne\nhelp.group.testing\tTesty\nhelp.group.tools\tNarzędzia programistyczne\nhelp.more\tUruchom 'mio help <polecenie>', aby zobaczyć szczegóły polecenia.\nhelp.options\tOpcje\nhelp.tagline\tKompilator Native AOT i narzędzia dla języka Mio\nhelp.title\tMio {0}\nhelp.usage\tUżycie\nlint.behavior\tUżyj --list-rules, aby wyświetlić reguły, i --deny-warnings, aby ostrzeżenia powodowały niepowodzenie. Kod musi najpierw przejść kontrole kompilatora.\nlint.constant_condition\tWarunek zawsze prawdziwy lub zawsze fałszywy\nlint.finding_if\twarunek moshi ma zawsze wartość {0}\nlint.finding_import\timport {0} (pakiet {1}) nie jest używany\nlint.finding_loop\twarunek aida ma zawsze wartość iie, więc ciało pętli nigdy się nie wykona\nlint.finding_unreachable\tnieosiągalny kod po {0}\nlint.finding_variable\tzmienna {0} została zadeklarowana, ale nie jest używana\nlint.status\tKod wyjścia: 0 powodzenie, 1 ostrzeżenia z --deny-warnings, 2 błąd użycia lub kompilacji.");
    string.write_string(output, "\nlint.unreachable_code\tInstrukcja po bezwarunkowym przekazaniu sterowania\nlint.unused_import\tNieużywany import pakietu\nlint.unused_variable\tNieużywana zmienna lokalna (oprócz nazw zaczynających się od _)\nopt.bunko\tUżyj tego katalogu głównego Bunko zamiast domyślnego\nopt.color\tSteruj kolorowym wyjściem: auto, always lub never\nopt.emit\tWygeneruj bajtkod Mochi zamiast obrazu natywnego\nopt.format\tWybierz format wyjścia: human, short lub json\nopt.gc_stress\tZbuduj z agresywnymi testami obciążenia odśmiecacza pamięci\nopt.help\tPokaż pomoc\nopt.lang\tWybierz język wyjściowy według znacznika BCP 47, na przykład ja-JP\nopt.observe\tZapisuj obserwacje kompilacji natywnej\nopt.output\tZapisz wyjście w tej ścieżce\nopt.program_args\tPrzekaż pozostałe argumenty do programu\nopt.run_filter\tUruchamiaj tylko testy, których nazwy pasują do tego wyrażenia regularnego\nopt.stdio\tUżywaj standardowego wejścia i wyjścia dla serwera języka\nopt.symbols\tZapisz informacje o symbolach natywnych w tym pliku\nopt.target\tZbuduj dla darwin-amd64, darwin-arm64, linux-amd64, linux-arm64, windows-amd64, windows-arm64\nopt.theme\tWybierz paletę semantyczną: auto, dark lub light\nopt.verbose\tDołącz dodatkowe szczegóły diagnostyczne\nopt.version\tPokaż informacje o wersji");
    string.write_string(output, "\ntest.assertion\tniepowodzenie asercji\ntest.bunko_empty\tzastępcza ścieżka Bunko nie może być pusta\ntest.bunko_missing\tbrak wartości --bunko-root\ntest.compile_failed\tkompilacja nie powiodła się\ntest.duration\tłączny czas\ntest.empty_filter\tfiltr testów nie może być pusty\ntest.empty_lang\tznacznik języka nie może być pusty\ntest.fail\tNIEZALICZONY\ntest.filter_invalid\tnieprawidłowy filtr testów: {0}\ntest.invalid_arg\tnieprawidłowy argument testu: {0}\ntest.invalid_signature\tnieprawidłowa sygnatura funkcji testowej\ntest.io_clean_dir\tnie można usunąć prywatnego katalogu testów\ntest.io_clean_image\tnie można usunąć natywnego obrazu testowego\ntest.io_dir\tnie można utworzyć prywatnego katalogu testów\ntest.io_protect\tnie można zabezpieczyć prywatnego katalogu testów\ntest.missing_target\tbrak celu testów\ntest.no_match\tżaden test nie pasuje do --run={0}\ntest.none\tnie znaleziono testów\ntest.pass\tZALICZONY\ntest.resource\tprzekroczono limit zasobów");
    string.write_string(output, "\ntest.runtime\tbłąd wykonania\ntest.skip\tPOMINIĘTY\ntest.skipped\tPominięte testy: {0}\ntest.starting\tRozpoczynanie testów {0}\ntest.summary\tTesty zakończone: {0} zaliczonych, {1} niezaliczonych");
    kaesu string.builder_string(output);
}

