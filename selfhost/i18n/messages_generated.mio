    string.write_string(output, "\nerr.help_args\thelp अधिकतम एक कमांड नाम लेता है\nerr.help_unknown\tअज्ञात कमांड के लिए सहायता नहीं है: {0}\nerr.host_target\trun और exec के लिए होस्ट लक्ष्य {0} आवश्यक है\nerr.invalid_color\tअमान्य रंग मोड: {0} (auto, always या never अपेक्षित)\nerr.invalid_format\tअमान्य प्रारूप: {0} (human, short या json अपेक्षित)\nerr.invalid_theme\tअमान्य थीम: {0} (auto, dark या light अपेक्षित)\nerr.missing_value\tविकल्प {0} का मान गायब है\nerr.multiple_entries\tकेवल एक स्रोत प्रविष्टि दी जा सकती है\nerr.observe\t--observe केवल स्रोत से darwin-arm64 नेटिव निर्माण पर लागू होता है\nerr.program_args\tप्रोग्राम तर्कों के लिए run या exec आवश्यक है\nerr.protect_run_dir\tनिजी निष्पादन निर्देशिका की सुरक्षा नहीं की जा सकी\nerr.read_mochi\tMochi इनपुट नहीं पढ़ा जा सका\nerr.run_output\trun और exec अपने नेटिव आउटपुट का प्रबंधन स्वयं करते हैं\nerr.spawn\tनेटिव प्रोग्राम शुरू नहीं हो सका\nerr.symbols\t--emit-symbols केवल स्रोत से darwin-arm64 नेटिव निर्माण पर लागू होता है\nerr.target\tअसमर्थित लक्ष्य: {0} (darwin-arm64, linux-amd64 या windows-amd64 अपेक्षित)\nerr.unknown_command\tअज्ञात कमांड: {0}\nerr.unknown_option\tअज्ञात विकल्प: {0}\nerr.version_args\tversion कमांड कोई तर्क नहीं लेता\nerr.write_disasm\tडिसअसेम्बली नहीं लिखी जा सकी");
    string.write_string(output, "\nerr.write_mochi\tMochi आउटपुट नहीं लिखा जा सका\nerr.write_native\tनेटिव आउटपुट नहीं लिखा जा सका\nhelp.commands\tकमांड\nhelp.examples\tउदाहरण\nhelp.group.compilation\tकंपाइलेशन\nhelp.group.diagnostics\tनिदान\nhelp.group.execution\tनिष्पादन\nhelp.group.general\tसामान्य\nhelp.group.testing\tपरीक्षण\nhelp.group.tools\tविकास उपकरण\nhelp.more\tकिसी कमांड का विवरण देखने के लिए 'mio help <कमांड>' चलाएँ।\nhelp.options\tविकल्प\nhelp.tagline\tMio भाषा के लिए Native AOT कंपाइलर और टूलचेन\nhelp.title\tMio {0}\nhelp.usage\tउपयोग\nopt.bunko\tडिफ़ॉल्ट के बजाय यह Bunko रूट उपयोग करें\nopt.color\tरंगीन आउटपुट नियंत्रित करें: auto, always या never\nopt.emit\tनेटिव इमेज के बजाय Mochi बाइटकोड उत्पन्न करें\nopt.format\tआउटपुट प्रारूप चुनें: human, short या json\nopt.gc_stress\tगहन कचरा संग्रहक तनाव जाँच के साथ बनाएँ");
    string.write_string(output, "\nopt.help\tसहायता दिखाएँ\nopt.lang\tBCP 47 टैग से आउटपुट भाषा चुनें, जैसे ja-JP\nopt.observe\tनेटिव निर्माण अवलोकन दर्ज करें\nopt.output\tआउटपुट इस पथ पर लिखें\nopt.program_args\tशेष तर्क प्रोग्राम को दें\nopt.run_filter\tकेवल वे परीक्षण चलाएँ जिनके नाम इस नियमित अभिव्यक्ति से मेल खाते हैं\nopt.stdio\tभाषा सर्वर के लिए मानक इनपुट और आउटपुट उपयोग करें\nopt.symbols\tनेटिव सिंबल जानकारी इस फ़ाइल में लिखें\nopt.target\tdarwin-arm64, linux-amd64 या windows-amd64 के लिए बनाएँ\nopt.theme\tअर्थपूर्ण रंग योजना चुनें: auto, dark या light\nopt.verbose\tअतिरिक्त निदान विवरण दिखाएँ\nopt.version\tसंस्करण जानकारी दिखाएँ\ntest.assertion\tअभिकथन विफल\ntest.bunko_empty\tBunko ओवरराइड पथ रिक्त नहीं हो सकता\ntest.bunko_missing\t--bunko-root का मान गायब है\ntest.compile_failed\tकंपाइलेशन विफल\ntest.duration\tकुल अवधि\ntest.empty_filter\tपरीक्षण फ़िल्टर रिक्त नहीं हो सकता\ntest.empty_lang\tभाषा टैग रिक्त नहीं हो सकता\ntest.fail\tविफल");
    string.write_string(output, "\ntest.filter_invalid\tअमान्य परीक्षण फ़िल्टर: {0}\ntest.invalid_arg\tअमान्य परीक्षण तर्क: {0}\ntest.invalid_signature\tपरीक्षण फ़ंक्शन हस्ताक्षर अमान्य है\ntest.io_clean_dir\tनिजी परीक्षण निर्देशिका साफ़ नहीं की जा सकी\ntest.io_clean_image\tनेटिव परीक्षण इमेज साफ़ नहीं की जा सकी\ntest.io_dir\tनिजी परीक्षण निर्देशिका नहीं बनाई जा सकी\ntest.io_protect\tनिजी परीक्षण निर्देशिका की सुरक्षा नहीं की जा सकी\ntest.missing_target\tपरीक्षण लक्ष्य गायब है\ntest.no_match\t--run={0} से कोई परीक्षण मेल नहीं खाता\ntest.none\tकोई परीक्षण नहीं मिला\ntest.pass\tउत्तीर्ण\ntest.resource\tसंसाधन सीमा पार\ntest.runtime\tरनटाइम त्रुटि\ntest.skip\tछोड़ा गया\ntest.skipped\tछोड़े गए परीक्षण: {0}\ntest.starting\tपरीक्षण प्रारंभ {0}\ntest.summary\tपरीक्षण पूर्ण: {0} उत्तीर्ण, {1} विफल");
    kaesu string.builder_string(output);
}

