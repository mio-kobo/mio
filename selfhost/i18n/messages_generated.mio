waza text_es_es() -> string {
    kaku output = string.new_builder();
    string.write_string(output, "\ncheck.passed\tcomprobación superada\ncli.lsp_unknown\targumento lsp desconocido: {0}\ncmd.build\tCrear un ejecutable nativo o bytecode Mochi desde fuentes Mio\ncmd.check\tAnalizar fuentes Mio sin producir salida\ncmd.disasm\tDesensamblar un programa Mochi compilado\ncmd.exec\tEjecutar un programa Mochi compilado\ncmd.help\tMostrar la ayuda de Mio o de un comando\ncmd.lsp\tIniciar el servidor de lenguaje Mio sobre la entrada/salida estándar\ncmd.run\tCrear y ejecutar un programa Mio desde fuentes\ncmd.test\tDescubrir y ejecutar paquetes de pruebas Mio\ncmd.version\tMostrar la información de versión\ndiag.cause\tcausa\nerr.analysis\tfalló el análisis del código fuente\nerr.bunko_empty\tla ruta de sustitución de Bunko debe ser explícita y no estar vacía\nerr.chmod_native\tno se puede hacer ejecutable la salida nativa\nerr.cleanup\tfalló la limpieza tras la ejecución\nerr.create_run_dir\tno se puede crear un directorio de ejecución privado\nerr.emit_mochi\teste comando no puede emitir bytecode Mochi\nerr.empty_paths\tlas rutas de origen y salida no pueden estar vacías\nerr.gc_stress\t--gc-stress solo se aplica a compilaciones nativas desde fuentes");
    string.write_string(output, "\nerr.help_args\thelp acepta como máximo un nombre de comando\nerr.help_unknown\tno hay ayuda para el comando desconocido: {0}\nerr.host_target\trun y exec requieren el destino del equipo anfitrión {0}\nerr.invalid_color\tmodo de color no válido: {0} (se esperaba auto, always o never)\nerr.invalid_format\tformato no válido: {0} (se esperaba human, short o json)\nerr.invalid_theme\ttema no válido: {0} (se esperaba auto, dark o light)\nerr.missing_value\tfalta el valor de la opción {0}\nerr.multiple_entries\tsolo se puede indicar una entrada de código fuente\nerr.observe\t--observe solo se aplica a compilaciones nativas darwin-arm64 desde fuentes\nerr.program_args\tlos argumentos de programa requieren run o exec\nerr.protect_run_dir\tno se puede proteger el directorio de ejecución privado\nerr.read_mochi\tno se puede leer la entrada Mochi\nerr.run_output\trun y exec gestionan su propia salida nativa\nerr.spawn\tno se pudo iniciar el programa nativo\nerr.symbols\t--emit-symbols solo se aplica a compilaciones nativas darwin-arm64 desde fuentes\nerr.target\tdestino no admitido: {0} (se esperaba darwin-arm64, linux-amd64 o windows-amd64)\nerr.unknown_command\tcomando desconocido: {0}\nerr.unknown_option\topción desconocida: {0}\nerr.version_args\tel comando version no acepta argumentos\nerr.write_disasm\tno se puede escribir el desensamblado");
    string.write_string(output, "\nerr.write_mochi\tno se puede escribir la salida Mochi\nerr.write_native\tno se puede escribir la salida nativa\nhelp.commands\tComandos\nhelp.examples\tEjemplos\nhelp.group.compilation\tCompilación\nhelp.group.diagnostics\tDiagnóstico\nhelp.group.execution\tEjecución\nhelp.group.general\tGeneral\nhelp.group.testing\tPruebas\nhelp.group.tools\tHerramientas de desarrollo\nhelp.more\tEjecute 'mio help <comando>' para ver los detalles de un comando.\nhelp.options\tOpciones\nhelp.tagline\tCompilador Native AOT y cadena de herramientas para el lenguaje Mio\nhelp.title\tMio {0}\nhelp.usage\tUso\nopt.bunko\tUsar esta raíz de Bunko en lugar de la predeterminada\nopt.color\tControlar la salida en color: auto, always o never\nopt.emit\tEmitir bytecode Mochi en lugar de una imagen nativa\nopt.format\tSeleccionar el formato de salida: human, short o json\nopt.gc_stress\tCompilar con comprobaciones agresivas de esfuerzo del recolector de basura");
    string.write_string(output, "\nopt.help\tMostrar la ayuda\nopt.lang\tSeleccionar el idioma de salida con una etiqueta BCP 47, por ejemplo ja-JP\nopt.observe\tRegistrar observaciones de la compilación nativa\nopt.output\tEscribir la salida en esta ruta\nopt.program_args\tPasar los argumentos restantes al programa\nopt.run_filter\tEjecutar solo las pruebas cuyo nombre coincida con esta expresión regular\nopt.stdio\tUsar la entrada y salida estándar para el servidor de lenguaje\nopt.symbols\tEscribir la información de símbolos nativos en este archivo\nopt.target\tCompilar para darwin-arm64, linux-amd64 o windows-amd64\nopt.theme\tSeleccionar la paleta semántica: auto, dark o light\nopt.verbose\tIncluir detalles de diagnóstico adicionales\nopt.version\tMostrar la información de versión\ntest.assertion\tfalló la aserción\ntest.bunko_empty\tla ruta de sustitución de Bunko no puede estar vacía\ntest.bunko_missing\tfalta el valor de --bunko-root\ntest.compile_failed\tfalló la compilación\ntest.duration\tduración total\ntest.empty_filter\tel filtro de pruebas no puede estar vacío\ntest.empty_lang\tla etiqueta de idioma no puede estar vacía\ntest.fail\tFALLIDA");
    string.write_string(output, "\ntest.filter_invalid\tfiltro de pruebas no válido: {0}\ntest.invalid_arg\targumento de prueba no válido: {0}\ntest.invalid_signature\tfirma de función de prueba no válida\ntest.io_clean_dir\tno se puede limpiar el directorio de pruebas privado\ntest.io_clean_image\tno se puede limpiar la imagen de prueba nativa\ntest.io_dir\tno se puede crear un directorio de pruebas privado\ntest.io_protect\tno se puede proteger el directorio de pruebas privado\ntest.missing_target\tfalta el destino de las pruebas\ntest.no_match\tninguna prueba coincide con --run={0}\ntest.none\tno se encontraron pruebas\ntest.pass\tCORRECTA\ntest.resource\tlímite de recursos superado\ntest.runtime\terror de ejecución\ntest.skip\tOMITIDA\ntest.skipped\tPruebas omitidas: {0}\ntest.starting\tIniciando pruebas {0}\ntest.summary\tPruebas completadas: {0} correctas, {1} fallidas");
    kaesu string.builder_string(output);
}

