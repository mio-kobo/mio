yobu "kiso/testing";
yobu "kiso/string";
yobu "selfhost/i18n";

waza test_normalize_bcp47_tags() -> unit {
    testing.expect(i18n.normalize("en-us") == "en-US", "lowercase language and region");
    testing.expect(i18n.normalize("zh_cn") == "zh-CN", "underscore separator");
    testing.expect(i18n.normalize("pt_br") == "pt-BR", "POSIX locale normalization");
    testing.expect(i18n.normalize("zh_Hant") == "zh-Hant", "script capitalization");
    testing.expect(i18n.normalize("en_US.UTF-8") == "en-US", "encoding suffix is dropped");
    testing.expect(i18n.normalize("ja_JP@euro") == "ja-JP", "modifier is dropped");
    testing.expect(i18n.normalize("C") == "", "POSIX C has no language");
    testing.expect(i18n.normalize("not a tag") == "", "malformed tags are rejected");
}

waza test_language_and_region_fallback() -> unit {
    testing.expect(i18n.resolve("fr-CA") == "fr-FR", "region falls back to language primary");
    testing.expect(i18n.resolve("de-AT") == "de-DE", "German region fallback");
    testing.expect(i18n.resolve("es-AR") == "es-ES", "Spanish region fallback");
    testing.expect(i18n.resolve("pt-PT") == "pt-PT", "exact regional locale wins");
    testing.expect(i18n.resolve("pt") == "pt-BR", "language-only primary");
    testing.expect(i18n.resolve("zh-HK") == "zh-HK", "Hong Kong Chinese is exact");
    testing.expect(i18n.resolve("zh-MO") == "zh-HK", "Macau maps to Hong Kong Chinese");
    testing.expect(i18n.resolve("zh-Hant") == "zh-TW", "traditional script default");
    testing.expect(i18n.resolve("zh-Hans") == "zh-CN", "simplified script default");
    testing.expect(i18n.resolve("no") == "nb-NO", "legacy Norwegian alias");
    testing.expect(i18n.resolve("iw-IL") == "he-IL", "legacy Hebrew alias");
    testing.expect(i18n.resolve("in-ID") == "id-ID", "legacy Indonesian alias");
    testing.expect(i18n.resolve("tl-PH") == "fil-PH", "legacy Filipino alias");
    testing.expect(i18n.resolve("en-AU") == "en-US", "unknown English region falls back");
    testing.expect(i18n.resolve("unknown") == "en-US", "unknown language falls back to en-US");
}

waza test_supported_locales_and_direction() -> unit {
    kaku tags = i18n.supported_tags();
    testing.expect(len(tags) == 39, "39 catalog locales are compiled in");
    kaku at = 0;
    aida (at < len(tags)) { testing.expect(i18n.supported_tag(tags[at]), "every supported tag resolves"); at = at + 1; }
    testing.expect(i18n.direction("ar-SA") == "rtl" && i18n.is_rtl("he-IL") && i18n.is_rtl("fa-IR"), "RTL locales");
    testing.expect(i18n.direction("en-US") == "ltr" && !i18n.is_rtl("ja-JP"), "LTR locales");
}

waza test_message_lookup_and_fallback() -> unit {
    testing.expect(i18n.text("en-US", i18n.key_test_pass) == "PASS", "English message");
    testing.expect(i18n.text("ja-JP", i18n.key_test_pass) == "成功", "Japanese message");
    testing.expect(i18n.text("zh-CN", i18n.key_test_pass) == "通过", "Chinese message");
    testing.expect(i18n.text("xx-YY", i18n.key_test_pass) == "PASS", "unknown locale falls back to en-US");
    testing.expect(i18n.text("ja-JP", "missing.key") == "missing.key", "unknown key is preserved");
    kaku ansi = string.from_utf8([uint8(27)]);
    moshi (ansi != mu) { testing.expect(!string.contains(i18n.text("ar-SA", i18n.key_help_tagline), ansi), "catalog text has no ANSI"); }
}

waza test_placeholder_formatting() -> unit {
    testing.expect(i18n.format("en-US", i18n.key_test_summary, ["2", "1"]) == "Tests complete: 2 passed, 1 failed", "English placeholders");
    testing.expect(i18n.format("ja-JP", i18n.key_test_summary, ["2", "1"]) == "テスト完了：2 件成功、1 件失敗", "Japanese placeholders");
    testing.expect(i18n.format("zh-CN", i18n.key_err_unknown_command, ["build"]) == "未知命令：build", "argument appears in translated order");
    testing.expect(i18n.format("en-US", i18n.key_check_passed, [""]) == "check passed", "no-argument messages are unchanged");
}

waza test_explicit_language_select() -> unit {
    testing.expect(i18n.select("ja-JP") == "ja-JP", "explicit language");
    testing.expect(i18n.select("pt_br") == "pt-BR", "explicit POSIX value");
    testing.expect(i18n.select("unknown") == "en-US", "invalid explicit value is safe");
}
