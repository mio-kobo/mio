yobu "kiso/aot/lowerwinrt";
yobu "kiso/array";
yobu "kiso/encoding/mochi";
yobu "kiso/fs";
yobu "kiso/math";
yobu "kiso/path";
yobu "kiso/string";
yobu "selfhost/parser";
yobu "selfhost/resolver";
yobu "selfhost/typecheck";
yobu "selfhost/codegen";

kata PackageState {
    paths: []string;
    resolved: []resolver.ResolvedPackage;
    checked: []typecheck.TypeCheckResult;
    visiting: []string;
    failed: []bool;
    diagnostic: []string;
}

waza contains(values: []string, value: string) -> bool {
    kaku index = 0;
    aida (index < len(values)) {
        moshi (values[index] == value) { kaesu hai; }
        index = index + 1;
    }
    kaesu iie;
}

waza path_less(left: string, right: string) -> bool {
    kaku a = string.to_bytes(left);
    kaku b = string.to_bytes(right);
    kaku count = len(a);
    moshi (len(b) < count) { count = len(b); }
    kaku index = 0;
    aida (index < count) {
        moshi (a[index] < b[index]) { kaesu hai; }
        moshi (a[index] > b[index]) { kaesu iie; }
        index = index + 1;
    }
    kaesu len(a) < len(b);
}

waza insert_sorted(values: []string, value: string) -> unit {
    array.push(values, value);
    kaku index = len(values) - 1;
    aida (index > 0 && path_less(values[index], values[index - 1])) {
        kaku previous = values[index - 1];
        values[index - 1] = values[index];
        values[index] = previous;
        index = index - 1;
    }
}

waza source_directory(root: string, package_path: string) -> string {
    moshi (string.has_prefix(package_path, "kiso/")) { kaesu path.join(root, path.join("bunko", package_path)); }
    kaesu path.join(root, package_path);
}

waza add_socket_layouts(result: []codegen.NativeFunctionLayout, packages: []resolver.ResolvedPackage) -> unit {
    kaku found = iie; kaku at = 0;
    aida (at < len(packages)) {
        kaku aliases = packages[at].aliases; kaku ai = 0;
        aida (ai < len(aliases)) { moshi (aliases[ai].package_path == "mio/sys/socket") { found = hai; } ai = ai + 1; }
        at = at + 1;
    }
    moshi (!found) { kaesu; }
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"open",binding_key:"$mma::mio/sys/socket::open::2bd390f6a00486b5badde861e398d7014c8e331b8946668924bd7048c8bd76d7",parameter_count:0,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"status",binding_key:"$mma::mio/sys/socket::status::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93",parameter_count:2,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"bind_ipv4",binding_key:"$mma::mio/sys/socket::bind_ipv4::f5e8d492393d1d5f642e3573af501663920a9be9788fbeda8b1f38deb28ffecd",parameter_count:4,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"connect_ipv4",binding_key:"$mma::mio/sys/socket::connect_ipv4::f5e8d492393d1d5f642e3573af501663920a9be9788fbeda8b1f38deb28ffecd",parameter_count:4,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"listen",binding_key:"$mma::mio/sys/socket::listen::0a2af19668a171e5f7f873b1d1a23a4d3ebe7ca1f73a074d7b75234419859515",parameter_count:3,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"accept",binding_key:"$mma::mio/sys/socket::accept::3a6d99e54aef1b988c4bc8780939e06e8558ca5116f17980850557fbe5abc4d4",parameter_count:1,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"read",binding_key:"$mma::mio/sys/socket::read::e8706d18fa932e83ff56c940a8552084a64d75a1d0629364439b5e079ca29430",parameter_count:5,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"write",binding_key:"$mma::mio/sys/socket::write::e8706d18fa932e83ff56c940a8552084a64d75a1d0629364439b5e079ca29430",parameter_count:5,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"close",binding_key:"$mma::mio/sys/socket::close::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93",parameter_count:2,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"set_nonblocking",binding_key:"$mma::mio/sys/socket::set_nonblocking::0a2af19668a171e5f7f873b1d1a23a4d3ebe7ca1f73a074d7b75234419859515",parameter_count:3,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"finish_connect",binding_key:"$mma::mio/sys/socket::finish_connect::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93",parameter_count:2,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"reactor_open",binding_key:"$mma::mio/sys/socket::reactor_open::e2a0babf4a727ca4f89523981320dd885733845cd378c09e6c21c159e1f42906",parameter_count:1,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"reactor_ctl",binding_key:"$mma::mio/sys/socket::reactor_ctl::192e86d1345326f3b7e75658a055233648ffd9a32cf67722240f4e14905712b7",parameter_count:4,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"reactor_wait",binding_key:"$mma::mio/sys/socket::reactor_wait::e8706d18fa932e83ff56c940a8552084a64d75a1d0629364439b5e079ca29430",parameter_count:5,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"reactor_signal",binding_key:"$mma::mio/sys/socket::reactor_signal::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93",parameter_count:2,returns_value:hai});
    array.push(result, codegen.NativeFunctionLayout {package_path:"mio/sys/socket",name:"reactor_ack",binding_key:"$mma::mio/sys/socket::reactor_ack::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93",parameter_count:2,returns_value:hai});
}

waza native_layouts() -> []codegen.NativeFunctionLayout {
    kaku result: []codegen.NativeFunctionLayout = [];
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "close", binding_key: "$mma::mio/fs/runtime::close::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_close", binding_key: "$mma::mio/fs/runtime::dir_close::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_is_dir", binding_key: "$mma::mio/fs/runtime::dir_is_dir::c9ff387755a05bfa435b60b204111ffc83a5f199b21f569f6673482e3a103ca6", parameter_count: 1, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_is_file", binding_key: "$mma::mio/fs/runtime::dir_is_file::c9ff387755a05bfa435b60b204111ffc83a5f199b21f569f6673482e3a103ca6", parameter_count: 1, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_name", binding_key: "$mma::mio/fs/runtime::dir_name::ca5c10cb23a1dc4f8d7120a05626b664f700151ff09870e6a2a9204b890efa7c", parameter_count: 1, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_next", binding_key: "$mma::mio/fs/runtime::dir_next::c9ff387755a05bfa435b60b204111ffc83a5f199b21f569f6673482e3a103ca6", parameter_count: 1, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_status", binding_key: "$mma::mio/fs/runtime::dir_status::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "file_status", binding_key: "$mma::mio/fs/runtime::file_status::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "mkdir", binding_key: "$mma::mio/fs/runtime::mkdir::6f2c95561ed64afe3034886f256d86934e0ad43ef1d605224b7f6d40167a9946", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "open", binding_key: "$mma::mio/fs/runtime::open::1192df94a5bdf48f4df10a0aa4b61147cfc2e6f2c2f8ea1248826e517f716633", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "open_dir", binding_key: "$mma::mio/fs/runtime::open_dir::7128dadd824bee38c385b052b0d86ff37b801ae61b35c36db664b2d310b6dbdf", parameter_count: 1, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "read", binding_key: "$mma::mio/fs/runtime::read::e8706d18fa932e83ff56c940a8552084a64d75a1d0629364439b5e079ca29430", parameter_count: 5, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "stat", binding_key: "$mma::mio/fs/runtime::stat::6f2c95561ed64afe3034886f256d86934e0ad43ef1d605224b7f6d40167a9946", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "write", binding_key: "$mma::mio/fs/runtime::write::e8706d18fa932e83ff56c940a8552084a64d75a1d0629364439b5e079ca29430", parameter_count: 5, returns_value: hai });
    kaesu result;
}

waza load_package(state: PackageState, root: string, package_path: string) -> unit {
    moshi (state.failed[0] || contains(state.paths, package_path)) { kaesu; }
    moshi (contains(state.visiting, package_path)) {
        state.failed[0] = hai;
        state.diagnostic[0] = string.concat("import cycle: ", package_path);
        kaesu;
    }
    array.push(state.visiting, package_path);
    kaku directory = source_directory(root, package_path);
    kaku listing = fs.read_dir(directory);
    moshi (listing.error != mu) { state.failed[0] = hai; state.diagnostic[0] = string.concat("read package: ", package_path); array.truncate(state.visiting, len(state.visiting) - 1); kaesu; }
    kaku names: []string = [];
    kaku entry = 0;
    aida (entry < len(listing.entries)) {
        kaku current = listing.entries[entry];
        moshi (current.is_file && string.has_suffix(current.name, ".mio") && !string.has_suffix(current.name, "_test.mio")) { insert_sorted(names, current.name); }
        entry = entry + 1;
    }
    moshi (len(names) == 0) { state.failed[0] = hai; state.diagnostic[0] = string.concat("empty package: ", package_path); array.truncate(state.visiting, len(state.visiting) - 1); kaesu; }
    kaku files: []resolver.SourceFile = [];
    kaku dependencies: []string = [];
    kaku index = 0;
    aida (index < len(names)) {
        kaku file_path = path.join(directory, names[index]);
        kaku source = fs.read_all(file_path);
        moshi (source.error != mu) { state.failed[0] = hai; state.diagnostic[0] = string.concat("read source: ", file_path); nukeru; }
        kaku parsed = parser.parse(source.data);
        moshi (len(parsed.errors) != 0) { state.failed[0] = hai; state.diagnostic[0] = string.concat("parse source: ", file_path); nukeru; }
        array.push(files, resolver.SourceFile { file_id: len(files), path: file_path, ast: parsed.ast, root: parsed.root });
        kaku root_node = parsed.ast.nodes[parsed.root];
        kaku child = 0;
        aida (child < len(root_node.children)) {
            kaku node = parsed.ast.nodes[root_node.children[child]];
            moshi (parser.node_kind_code(node.kind) == 1 && !string.has_prefix(node.text, "mio/") && !contains(dependencies, node.text)) { insert_sorted(dependencies, node.text); }
            child = child + 1;
        }
        index = index + 1;
    }
    index = 0;
    aida (index < len(dependencies)) { load_package(state, root, dependencies[index]); index = index + 1; }
    moshi (!state.failed[0]) {
        kaku resolved_dependencies: []resolver.ResolvedPackage = [];
        kaku checked_dependencies: []typecheck.TypeCheckResult = [];
        index = 0;
        aida (index < len(dependencies)) {
            kaku dependency = 0;
            aida (dependency < len(state.paths) && state.paths[dependency] != dependencies[index]) { dependency = dependency + 1; }
            moshi (dependency == len(state.paths)) { state.failed[0] = hai; state.diagnostic[0] = string.concat("missing dependency: ", dependencies[index]); nukeru; }
            array.push(resolved_dependencies, state.resolved[dependency]);
            array.push(checked_dependencies, state.checked[dependency]);
            index = index + 1;
        }
        moshi (!state.failed[0]) {
            kaku resolved = resolver.resolve_package(package_path, files, resolved_dependencies);
            kaku checked = typecheck.check_package(resolved, checked_dependencies);
            moshi (len(resolved.errors) != 0 || len(checked.errors) != 0) {
                state.failed[0] = hai; state.diagnostic[0] = string.concat("check package: ", package_path);
                kaku ei=0;
                aida(ei<len(resolved.errors)){state.diagnostic[0]=string.concat(state.diagnostic[0],string.concat("\nresolve: ",resolved.errors[ei].name));ei=ei+1;}
                ei=0;aida(ei<len(checked.errors)){state.diagnostic[0]=string.concat(state.diagnostic[0],string.concat("\n",string.concat(checked.errors[ei].code,string.concat(" ",checked.errors[ei].detail))));ei=ei+1;}
            }
            sore { array.push(state.paths, package_path); array.push(state.resolved, resolved); array.push(state.checked, checked); }
        }
    }
    array.truncate(state.visiting, len(state.visiting) - 1);
}

waza diagnostic(message: string) -> unit {
    fs.write_all("/dev/stderr", string.to_bytes(string.concat(message, "\n")));
}

waza lower_to_pe(bytes: []uint8, output: string) -> bool {
    kaku decoded = mochi.decode(bytes);
    kaku file = decoded.value;
    moshi (decoded.error != mu) { diagnostic("E_IR windows-compiler: codegen produced invalid Mochi"); kaesu iie; }
    moshi (file == mu) { diagnostic("E_IR windows-compiler: no module"); kaesu iie; }
    kaku lowered = lowerwinrt.compile(file);
    moshi (lowered.error != "") { diagnostic(string.concat("E_LOWER windows-compiler: ", lowered.error)); kaesu iie; }
    kaku written = fs.write_all(output, lowered.bytes);
    moshi (written.error != mu) { diagnostic("E_IO windows-compiler: cannot write the executable"); kaesu iie; }
    kaesu hai;
}

// Compiles the package `entry` (looked up below the current directory) to a Windows AMD64 PE32+ executable.
waza compile(entry: string, output: string) -> bool {
    kaku state = PackageState { paths: [], resolved: [], checked: [], visiting: [], failed: [iie], diagnostic: [""] };
    load_package(state, ".", entry);
    moshi (state.failed[0]) { diagnostic(string.concat("E_SOURCE windows-compiler: ", state.diagnostic[0])); kaesu iie; }
    kaku natives = native_layouts(); add_socket_layouts(natives, state.resolved);
    kaku os_runtime = iie; kaku package_index = 0;
    aida (package_index < len(state.resolved)) {
        kaku symbols = state.resolved[package_index].symbols; kaku symbol_index = 0;
        aida (symbol_index < len(symbols)) {
            moshi (symbols[symbol_index].package_path == "mio/os/runtime") { os_runtime = hai; }
            symbol_index = symbol_index + 1;
        }
        package_index = package_index + 1;
    }
    moshi (os_runtime) {
        array.push(natives, codegen.NativeFunctionLayout {package_path:"mio/os/runtime",name:"real_path",binding_key:"$mma::mio/os/runtime::real_path::a45d9b7aef28d85d1466309e6a9a98b654726a1bef371c90bca683b2ecf21318",parameter_count:2,returns_value:hai});
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "stdin_wait", binding_key: "$mma::mio/os/runtime::stdin_wait::ef54322c57791e5008c09839db29d0913e109a8d2c1ed9b499ed05a73016289c", parameter_count: 1, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "stdin_ready", binding_key: "$mma::mio/os/runtime::stdin_ready::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2", parameter_count: 0, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "env_size", binding_key: "$mma::mio/os/runtime::env_size::195aa2406eb132812cd197e0d54d8f0ef64515accac66d0fc6e2cfd3835d892b", parameter_count: 1, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "env_copy", binding_key: "$mma::mio/os/runtime::env_copy::a45d9b7aef28d85d1466309e6a9a98b654726a1bef371c90bca683b2ecf21318", parameter_count: 2, returns_value: hai });

        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "monotonic_ms", binding_key: "$mma::mio/os/runtime::monotonic_ms::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2", parameter_count: 0, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "spawn_test", binding_key: "$mma::mio/os/runtime::spawn_test::37cce6b035b8405afd5f3ab3e07963f5a23d78f9a2a2205d364e0f72c317b660", parameter_count: 6, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "rmdir", binding_key: "$mma::mio/os/runtime::rmdir::195aa2406eb132812cd197e0d54d8f0ef64515accac66d0fc6e2cfd3835d892b", parameter_count: 1, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "spawn", binding_key: "$mma::mio/os/runtime::spawn::555acc9cd6915c133a226b6aa37175af19e84fed7e725f4199a2dec2d98ab4eb", parameter_count: 2, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "exec", binding_key: "$mma::mio/os/runtime::exec::555acc9cd6915c133a226b6aa37175af19e84fed7e725f4199a2dec2d98ab4eb", parameter_count: 2, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "pid", binding_key: "$mma::mio/os/runtime::pid::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2", parameter_count: 0, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "remove", binding_key: "$mma::mio/os/runtime::remove::195aa2406eb132812cd197e0d54d8f0ef64515accac66d0fc6e2cfd3835d892b", parameter_count: 1, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "argc", binding_key: "$mma::mio/os/runtime::argc::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2", parameter_count: 0, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "arg_size", binding_key: "$mma::mio/os/runtime::arg_size::ef54322c57791e5008c09839db29d0913e109a8d2c1ed9b499ed05a73016289c", parameter_count: 1, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "arg_copy", binding_key: "$mma::mio/os/runtime::arg_copy::70ac3b361d4ba108aeefdd952d76d4590a62bb1ce0a04031189b6b1dc7419a6d", parameter_count: 2, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "chmod", binding_key: "$mma::mio/os/runtime::chmod::61215f13826fb0c45557e17ebf8aee362b6cfb0d3b2d7f437f7946c1a407f361", parameter_count: 2, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "exit", binding_key: "$mma::mio/os/runtime::exit::ef54322c57791e5008c09839db29d0913e109a8d2c1ed9b499ed05a73016289c", parameter_count: 1, returns_value: hai });
    }
    kaku result = codegen.compile_modules_with_natives(state.resolved, state.checked, natives);
    moshi (!result.success) {
        diagnostic("E_CODEGEN windows-compiler: codegen failed");
        kaku error_index = 0;
        aida (error_index < len(result.errors)) { diagnostic(result.errors[error_index].detail); error_index = error_index + 1; }
        kaesu iie;
    }
    moshi (!lower_to_pe(result.bytes, output)) { kaesu iie; }
    chant("windows-compiler: ok");
    kaesu hai;
}

// Request on stdin: two UTF-8 lines, the entry package and the output path.
waza run() -> bool {
    kaku request = fs.read_all("/dev/stdin");
    moshi (request.error != mu) { diagnostic("E_IO windows-compiler: cannot read the request"); kaesu iie; }
    kaku fields: []string = []; kaku field: []uint8 = []; kaku index = 0;
    aida (index < len(request.data)) {
        kaku value = request.data[index];
        moshi (value == uint8(10)) {
            kaku text = string.from_utf8(field);
            moshi (text == mu) { diagnostic("E_INPUT windows-compiler: request must be UTF-8"); kaesu iie; }
            array.push(fields, text); field = [];
        }
        moshi (value != uint8(10)) { array.push(field, value); }
        index = index + 1;
    }
    moshi (len(fields) != 2 || len(field) != 0) { diagnostic("E_INPUT windows-compiler: expected the entry package and the output path, one per line"); kaesu iie; }
    kaesu compile(fields[0], fields[1]);
}

moshi (!run()) { math.fail("windows-compiler failed"); }
