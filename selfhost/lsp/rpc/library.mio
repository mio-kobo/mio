yobu "kiso/array";
yobu "kiso/convert";
yobu "kiso/fs";
yobu "kiso/os";
yobu "kiso/path";
yobu "kiso/string";
yobu "selfhost/lsp";
yobu "selfhost/frontend";
yobu "selfhost/progress";

waza analysis_path(state: Session, uri: string) -> string {
    kaku at=0;aida(at<len(state.library)){moshi(state.library[at].uri==uri){kaesu state.library[at].path;}at=at+1;}
    kaesu frontend.source_file_identity(document_path(uri));
}
waza embedded_package(file: string) -> string {
    kaku source=string.to_bytes(file);kaku bytes: []uint8=[];kaku at=11;
    aida(at<len(source)){array.push(bytes,source[at]);at=at+1;}
    kaku text=string.from_utf8(bytes);moshi(text==mu){kaesu "";}kaesu path.dir(text);
}
waza library_directory(state: Session) -> bool {
    moshi(state.library_root[0]!=""){kaesu hai;}
    kaku base=string.concat("/tmp/mio-lsp-sources-",string.concat(convert.format_int(os.pid()),string.concat("-",convert.format_int(os.monotonic_ms()))));kaku at=0;
    aida(at<1024){
        kaku directory=string.concat(base,string.concat("-",convert.format_int(at)));
        moshi(fs.create_dir(directory).error==mu){
            moshi(os.chmod(directory,448)!=0){os.remove_dir(directory);kaesu iie;}
            state.library_root[0]=directory;kaesu hai;
        }
        at=at+1;
    }
    kaesu iie;
}
waza materialize_library(state: Session, file: string, bytes: []uint8) -> string {
    // Reuse a client-open library buffer under its original logical identity.
    kaku at=0;
    aida(at<len(state.documents.documents)){
        kaku document=state.documents.documents[at];
        moshi(analysis_path(state,document.uri)==file){kaesu document.uri;}at=at+1;
    }
    kaku hash=content_hash(bytes);at=len(state.library)-1;
    aida(at>=0){
        kaku mapping=state.library[at];
        moshi(mapping.path==file){kaku parsed=lsp.path_from_uri(mapping.uri);moshi(parsed.valid){kaku current=fs.read_all(parsed.path);moshi(current.error==mu && content_hash(current.data)==hash){kaesu mapping.uri;}}}
        at=at-1;
    }
    moshi(!library_directory(state)){kaesu "";}
    kaku base=path.join(state.library_root[0],string.concat(hash,string.concat("-",path.base(file))));at=0;
    aida(at<1024){
        kaku target=base;moshi(at>0){target=string.concat(base,string.concat(".",convert.format_int(at)));}
        moshi(!fs.exists(target)){
            moshi(fs.write_all(target,bytes).error!=mu){kaesu "";}
            moshi(os.chmod(target,292)!=0){os.remove(target);kaesu "";}
            kaku uri=lsp.file_uri(target);array.push(state.library,SourceURI {path:file,uri:uri});kaesu uri;
        }
        at=at+1;
    }
    kaesu "";
}
waza materialize_sources(state: Session, analysis: DocumentAnalysis) -> unit {
    kaku at=0;
    aida(at<len(analysis.index.analysis.sources)){
        moshi(!progress.checkpoint(state.work)){kaesu;}
        kaku source=analysis.index.analysis.sources[at];
        moshi(string.has_prefix(source.path,"<embedded>/")){
            kaku uri=materialize_library(state,source.path,source.bytes);
            moshi(uri!=""){
                // A client may modify a previously materialized file. Replace
                // stale URI preferences without overwriting that file.
                kaku pi=0;aida(pi<len(analysis.preferred)){
                    moshi(analysis.preferred[pi].path==source.path){kaku next=pi;aida(next+1<len(analysis.preferred)){analysis.preferred[next]=analysis.preferred[next+1];next=next+1;}array.truncate(analysis.preferred,len(analysis.preferred)-1);}
                    sore{pi=pi+1;}
                }
                array.push(analysis.preferred,SourceURI {path:source.path,uri:uri});
            }
        }
        at=at+1;
    }
}
