yobu "selfhost/progress";
yobu "kiso/array";
yobu "kiso/string";
yobu "selfhost/parser";
yobu "selfhost/resolver";

kata FlowFact {
    symbol_id: int64;
    type_id: int64;
    version: int64;
}

kata TypeEnvironment {
    work: progress.Context;
    resolved: resolver.ResolvedPackage;
    result: TypeCheckResult;
    current_file: []int64;
    return_types: []int64;
    constraints: []TypeParameter;
    facts: []FlowFact;
    versions: []int64;
    loop_depth: []int64;
    function_depth: []int64;
    constant_states: []int64;
    bindings: resolver.BindingTable;
    node_type_slots: []int64;
    symbol_type_slots: []int64;
    signature_slots: []int64;
    version_log: []int64;
}

waza empty_result(path: string) -> TypeCheckResult {
    kaesu TypeCheckResult {
        package_path: path,
        types: array.with_capacity[TypeInfo](64),
        node_types: array.with_capacity[NodeType](256),
        symbol_types: array.with_capacity[SymbolType](128),
        signatures: array.with_capacity[FunctionSignature](32),
        substitutions: array.with_capacity[TypeSubstitution](32),
        structs: array.with_capacity[StructDefinition](16),
        enums: array.with_capacity[EnumDefinition](16),
        constants: array.with_capacity[ConstantBinding](32),
        errors: array.with_capacity[TypeError](16),
        type_buckets: array.make[int64](type_bucket_count, -1),
        type_next: array.with_capacity[int64](64)
    };
}

waza new_environment(resolved: resolver.ResolvedPackage) -> TypeEnvironment {
    kaesu new_environment_with_progress(resolved, progress.context());
}
waza new_environment_with_progress(resolved: resolver.ResolvedPackage, work: progress.Context) -> TypeEnvironment {
    kaku result = empty_result(resolved.package_path);
    scalar_type(result, TypeKind.Invalid(), "invalid");
    scalar_type(result, TypeKind.Int8(), "int8");
    scalar_type(result, TypeKind.Int16(), "int16");
    scalar_type(result, TypeKind.Int32(), "int32");
    scalar_type(result, TypeKind.Int64(), "int64");
    scalar_type(result, TypeKind.Uint8(), "uint8");
    scalar_type(result, TypeKind.Uint16(), "uint16");
    scalar_type(result, TypeKind.Uint32(), "uint32");
    scalar_type(result, TypeKind.Float32(), "float32");
    scalar_type(result, TypeKind.Float64(), "float64");
    scalar_type(result, TypeKind.Bool(), "bool");
    scalar_type(result, TypeKind.String(), "string");
    scalar_type(result, TypeKind.Nil(), "mu");
    scalar_type(result, TypeKind.Unit(), "unit");
    scalar_type(result, TypeKind.Resource(), "resource");
    scalar_type(result, TypeKind.CPtr(), "cptr");
    scalar_type(result, TypeKind.Uint64(), "uint64");
    kaku versions = array.make[int64](len(resolved.symbols), 0);
    kaku bindings = resolver.build_binding_table(resolved);
    kaesu TypeEnvironment {
        work: work,
        resolved: resolved,
        result: result,
        current_file: [0],
        return_types: array.with_capacity[int64](8),
        constraints: array.with_capacity[TypeParameter](8),
        facts: array.with_capacity[FlowFact](16),
        versions: versions,
        loop_depth: [0],
        function_depth: [0],
        constant_states: array.make[int64](len(resolved.symbols), 0),
        bindings: bindings,
        node_type_slots: array.make[int64](bindings.nodes.total, -1),
        symbol_type_slots: array.make[int64](len(resolved.symbols), -1),
        signature_slots: array.make[int64](len(resolved.symbols), -1),
        version_log: array.with_capacity[int64](64)
    };
}

waza builtin_type(env: TypeEnvironment, name: string) -> int64 {
    kaku wanted = name;
    moshi (wanted == "rune") { wanted = "int32"; }
    kaku index = 0;
    aida (index < len(env.result.types)) {
        kaku info = env.result.types[index];
        moshi (info.name == wanted && (type_kind_code(info.kind) <= 14 || type_kind_code(info.kind) == 20 || type_kind_code(info.kind) == 21)) { kaesu index; }
        index = index + 1;
    }
    kaesu 0;
}

waza node_at(env: TypeEnvironment, file_id: int64, node_id: int64) -> parser.Node {
    kaesu env.resolved.files[file_id].ast.nodes[node_id];
}

waza binding_of(env: TypeEnvironment, file_id: int64, node_id: int64) -> int64 {
    kaesu resolver.lookup_binding(env.resolved, env.bindings, file_id, node_id);
}

// Position of the entry of `symbol_id` in result.symbol_types, or -1. set_symbol_type is the only writer, and it
// keeps symbol_type_slots exact for ids of this package's symbols; any other id is searched front to back.
waza symbol_type_position(env: TypeEnvironment, symbol_id: int64) -> int64 {
    moshi (symbol_id >= 0 && symbol_id < len(env.symbol_type_slots)) { kaesu env.symbol_type_slots[symbol_id]; }
    kaku index = 0;
    aida (index < len(env.result.symbol_types)) {
        moshi (env.result.symbol_types[index].symbol_id == symbol_id) { kaesu index; }
        index = index + 1;
    }
    kaesu -1;
}

waza symbol_type(env: TypeEnvironment, symbol_id: int64) -> int64 {
    kaku index = 0;
    aida (index < len(env.facts)) {
        moshi (env.facts[index].symbol_id == symbol_id && env.facts[index].version == env.versions[symbol_id]) {
            kaesu env.facts[index].type_id;
        }
        index = index + 1;
    }
    kaku position = symbol_type_position(env, symbol_id);
    moshi (position >= 0) { kaesu env.result.symbol_types[position].type_id; }
    kaesu 0;
}

waza declared_symbol_type(env: TypeEnvironment, symbol_id: int64) -> int64 {
    kaku position = symbol_type_position(env, symbol_id);
    moshi (position >= 0) { kaesu env.result.symbol_types[position].type_id; }
    kaesu 0;
}

waza set_symbol_type(env: TypeEnvironment, symbol_id: int64, type_id: int64) -> unit {
    kaku position = symbol_type_position(env, symbol_id);
    moshi (position >= 0) {
        kaku old = env.result.symbol_types[position];
        env.result.symbol_types[position] = SymbolType {
            symbol_id: symbol_id, name: old.name, package_path: old.package_path, symbol_kind: old.symbol_kind, type_id: type_id };
        kaesu;
    }
    kaku name = "";
    kaku package_path = "";
    kaku symbol_kind = -1;
    moshi (symbol_id >= 0 && symbol_id < len(env.resolved.symbols)) {
        kaku symbol = env.resolved.symbols[symbol_id];
        name = symbol.name;
        package_path = symbol.package_path;
        symbol_kind = resolver.symbol_kind_code(symbol.kind);
        env.symbol_type_slots[symbol_id] = len(env.result.symbol_types);
    }
    array.push(env.result.symbol_types, SymbolType {
            symbol_id: symbol_id, name: name, package_path: package_path, symbol_kind: symbol_kind, type_id: type_id });
}

waza set_node_type(env: TypeEnvironment, file_id: int64, node_id: int64, type_id: int64) -> int64 {
    // node_type_slots maps a node to its position in result.node_types (-1: not recorded yet). set_node_type is
    // the only writer of node_types, so the positions stay exact and each node still has at most one entry.
    kaku slot = resolver.node_slot(env.bindings.nodes, file_id, node_id);
    moshi (slot >= 0) {
        kaku position = env.node_type_slots[slot];
        moshi (position >= 0) {
            env.result.node_types[position] = NodeType { node: env.result.node_types[position].node, type_id: type_id };
            kaesu type_id;
        }
        env.node_type_slots[slot] = len(env.result.node_types);
        array.push(env.result.node_types, NodeType { node: resolver.NodeRef { file_id: file_id, node_id: node_id }, type_id: type_id });
        kaesu type_id;
    }
    kaku index = 0;
    aida (index < len(env.result.node_types)) {
        kaku item = env.result.node_types[index];
        moshi (item.node.file_id == file_id && item.node.node_id == node_id) {
            env.result.node_types[index] = NodeType {
                node: item.node, type_id: type_id };
            kaesu type_id;
        }
        index = index + 1;
    }
    array.push(env.result.node_types, NodeType { node: resolver.NodeRef { file_id: file_id, node_id: node_id }, type_id: type_id });
    kaesu type_id;
}

// Records a function signature. Every writer of result.signatures goes through here so that signature_slots
// (symbol id -> position of its first signature) stays exact.
waza add_signature(env: TypeEnvironment, signature: FunctionSignature) -> unit {
    kaku symbol_id = signature.symbol_id;
    moshi (symbol_id >= 0 && symbol_id < len(env.signature_slots) && env.signature_slots[symbol_id] < 0) {
        env.signature_slots[symbol_id] = len(env.result.signatures);
    }
    array.push(env.result.signatures, signature);
}

waza signature_of(env: TypeEnvironment, symbol_id: int64) -> int64 {
    moshi (symbol_id >= 0 && symbol_id < len(env.signature_slots)) { kaesu env.signature_slots[symbol_id]; }
    kaku index = 0;
    aida (index < len(env.result.signatures)) {
        moshi (env.result.signatures[index].symbol_id == symbol_id) { kaesu index; }
        index = index + 1;
    }
    kaesu -1;
}

waza struct_of(env: TypeEnvironment, symbol_id: int64) -> int64 {
    kaku index = 0;
    aida (index < len(env.result.structs)) {
        moshi (env.result.structs[index].symbol_id == symbol_id) { kaesu index; }
        index = index + 1;
    }
    kaesu -1;
}

waza struct_named(env: TypeEnvironment, name: string) -> int64 {
    kaku index = 0;
    aida (index < len(env.result.structs)) {
        moshi ((env.result.structs[index].package_path == env.resolved.package_path && env.result.structs[index].name == name) || qualified_name_matches(env.result.structs[index].package_path, env.result.structs[index].name, name)) {
            kaesu index;
        }
        index = index + 1;
    }
    kaesu -1;
}

waza enum_of(env: TypeEnvironment, symbol_id: int64) -> int64 {
    kaku index = 0;
    aida (index < len(env.result.enums)) {
        moshi (env.result.enums[index].symbol_id == symbol_id) { kaesu index; }
        index = index + 1;
    }
    kaesu -1;
}

waza enum_named(env: TypeEnvironment, name: string) -> int64 {
    kaku index = 0;
    aida (index < len(env.result.enums)) {
        moshi ((env.result.enums[index].package_path == env.resolved.package_path && env.result.enums[index].name == name) || qualified_name_matches(env.result.enums[index].package_path, env.result.enums[index].name, name)) {
            kaesu index;
        }
        index = index + 1;
    }
    kaesu -1;
}

waza add_type_error(env: TypeEnvironment, kind: TypeErrorKind, code: string, file_id: int64, node_id: int64, expected: int64, actual: int64, detail: string) -> unit {
    kaku span = node_at(env, file_id, node_id).span;
    array.push(env.result.errors, TypeError {
            kind: kind, code: code, node: resolver.NodeRef {
                file_id: file_id, node_id: node_id }, span: span, expected: expected, actual: actual, detail: detail });
}

waza add_fact(env: TypeEnvironment, symbol_id: int64, type_id: int64) -> unit {
    array.push(env.facts, FlowFact { symbol_id: symbol_id, type_id: type_id, version: env.versions[symbol_id] });
}

// invalidate_fact is the only writer of env.versions and logs every increment, so that a scope that must give back
// its flow state (restore_versions) undoes exactly its own increments instead of copying and rewriting the whole
// version array (one slot per symbol of the package) at every function and branch.
waza invalidate_fact(env: TypeEnvironment, symbol_id: int64) -> unit {
    env.versions[symbol_id] = env.versions[symbol_id] + 1;
    array.push(env.version_log, symbol_id);
}

waza restore_versions(env: TypeEnvironment, mark: int64) -> unit {
    kaku at = len(env.version_log);
    aida (at > mark) {
        at = at - 1;
        kaku symbol_id = env.version_log[at];
        env.versions[symbol_id] = env.versions[symbol_id] - 1;
    }
    array.truncate(env.version_log, mark);
}

waza invalidate_global_facts(env: TypeEnvironment) -> unit {
    kaku index = 0;
    aida (index < len(env.facts)) {
        kaku symbol_id = env.facts[index].symbol_id;
        moshi (resolver.symbol_kind_code(env.resolved.symbols[symbol_id].kind) == 2) { invalidate_fact(env, symbol_id); }
        index = index + 1;
    }
}

waza invalidate_all_facts(env: TypeEnvironment) -> unit {
    kaku index = 0;
    aida (index < len(env.facts)) {
        invalidate_fact(env, env.facts[index].symbol_id);
        index = index + 1;
    }
}

waza constraint_for(env: TypeEnvironment, name: string) -> string {
    kaku index = len(env.constraints) - 1;
    aida (index >= 0) {
        moshi (env.constraints[index].name == name) { kaesu env.constraints[index].constraint; }
        index = index - 1;
    }
    kaesu "";
}

waza numeric_type(env: TypeEnvironment, id: int64) -> bool {
    moshi (is_numeric(env.result, id)) {
        kaku info = env.result.types[id];
        moshi (type_kind_code(info.kind) != 19) { kaesu hai; }
        kaku constraint = constraint_for(env, info.name);
        kaesu constraint == "Number" || constraint == "Integer" || constraint == "Signed" || constraint == "Float";
    }
    kaesu iie;
}

waza signed_type(env: TypeEnvironment, id: int64) -> bool {
    moshi (is_signed(env.result, id)) { kaesu hai; }
    moshi (id >= 0 && type_kind_code(env.result.types[id].kind) == 19) {
        kaku constraint = constraint_for(env, env.result.types[id].name);
        kaesu constraint == "Signed" || constraint == "Float";
    }
    kaesu iie;
}

waza floating_type(env: TypeEnvironment, id: int64) -> bool {
    moshi (id < 0) { kaesu iie; }
    kaku code = type_kind_code(env.result.types[id].kind);
    moshi (code == 8 || code == 9) { kaesu hai; }
    kaesu code == 19 && constraint_for(env, env.result.types[id].name) == "Float";
}
