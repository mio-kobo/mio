yobu "kiso/array";
yobu "kiso/string";
yobu "kiso/testing";
yobu "selfhost/parser";
yobu "selfhost/resolver";

waza check_source(source: string) -> TypeCheckResult {
    kaku parsed = parser.parse(string.to_bytes(source));
    testing.expect(len(parsed.errors) == 0, "source parses");
    kaku resolved = resolver.resolve_program("test", parsed);
    testing.expect(len(resolved.errors) == 0, "source resolves");
    kaesu check_program(resolved);
}

waza test_basic_types_and_functions() -> unit {
    kaku result = check_source("waza add(a: int32, b: int32) -> int32 { kaesu a + b; } kaku value: int32 = add(1, 2);");
    testing.expect(len(result.errors) == 0, "basic program type checks");
    testing.expect(len(result.signatures) == 1, "function signature recorded");
    testing.expect(type_name(result, result.signatures[0].result) == "int32", "return type recorded");
}

waza test_numeric_mismatch_and_range() -> unit {
    kaku mismatch = check_source("kaku a: int32 = 1; kaku b: int64 = 2; chant(a < b);");
    testing.expect(len(mismatch.errors) > 0, "mixed numeric comparison rejected");
    moshi (len(mismatch.errors) > 0) { testing.expect(type_error_kind_code(mismatch.errors[0].kind) == 0, "mismatch error kind"); }
    kaku range = check_source("kaku value: uint8 = 256;");
    testing.expect(len(range.errors) > 0, "integer range checked");
}

waza test_generics_and_structs() -> unit {
    kaku result = check_source("kata Box<T> { value: T; } waza identity<T: Number>(value: T) -> T { kaesu value; } kaku box = Box[int64] { value: identity(1) };");
    testing.expect(len(result.errors) == 0, "generic function and struct type check");
    testing.expect(len(result.substitutions) == 1, "generic substitution recorded");
}

waza test_nullable_narrowing() -> unit {
    kaku result = check_source("waza use(value: int64?) -> int64 { moshi (value != mu) { kaesu value + 1; } kaesu 0; }");
    testing.expect(len(result.errors) == 0, "nullable value narrows in true branch");
    kaku invalid = check_source("waza use(value: int64?) -> int64 { kaesu value + 1; }");
    testing.expect(len(invalid.errors) > 0, "nullable value requires narrowing");
}

waza test_invalid_instantiated_container_types() -> unit {
    kaku arrays = check_source("waza empty<T>() -> []T { kaku values: []T=[]; kaesu values; } kaku values=empty[unit]();");
    testing.expect(len(arrays.errors)>0, "generic substitution cannot construct an array of unit");
    kaku resources = check_source("waza empty<T>() -> []T { kaku values: []T=[]; kaesu values; } kaku values=empty[resource]();");
    testing.expect(len(resources.errors)>0, "generic substitution cannot construct an array of resource");
    kaku nullable = check_source("waza none<T>() -> T? { kaesu mu; } kaku value=none[unit]();");
    testing.expect(len(nullable.errors)>0, "generic substitution cannot construct nullable unit");
    kaku nested = check_source("waza none<T>() -> T? { kaesu mu; } kaku value=none[int64?]();");
    testing.expect(len(nested.errors)>0, "generic substitution cannot construct nested nullable types");
    kaku valid = check_source("waza empty<T>() -> []T { kaku values: []T=[]; kaesu values; } kaku ints=empty[int64](); kaku strings=empty[string]();");
    testing.expect(len(valid.errors)==0, "valid value-free generic arrays retain their checked types");
}

waza test_enum_match_exhaustiveness() -> unit {
    kaku valid = check_source("sentaku Option<T> { Some(T); None; } waza read(value: Option<int64>) -> int64 { awase (value) { baai Some(item) { kaesu item; } baai None { kaesu 0; } } }");
    testing.expect(len(valid.errors) == 0, "exhaustive enum match checks");
    kaku invalid = check_source("sentaku Flag { On; Off; } waza read(value: Flag) -> int64 { awase (value) { baai On { kaesu 1; } } }");
    testing.expect(len(invalid.errors) > 0, "non-exhaustive enum match rejected");
}

waza test_constant_side_effect() -> unit {
    kaku result = check_source("waza make() -> int64 { kaesu 1; } teisu value = make();");
    testing.expect(len(result.errors) > 0, "constant call rejected");
    testing.expect(type_error_kind_code(result.errors[len(result.errors) - 1].kind) == 13, "constant error kind");
}

waza has_integer_constant(result: TypeCheckResult, value: int64) -> bool {
    kaku index = 0;
    aida (index < len(result.constants)) {
        kaku item = result.constants[index];
        moshi (item.declaration && constant_state_code(item.value.state) == 2 && constant_kind_code(item.value.kind) == 1 && item.value.integer == value) { kaesu hai; }
        index = index + 1;
    }
    kaesu iie;
}

waza test_constant_evaluator_dependencies() -> unit {
    kaku result = check_source("teisu first: int64 = second + 1; teisu second: int64 = third + 1; teisu third: int64 = 40;");
    testing.expect(len(result.errors) == 0, "constant dependency chain evaluates");
    testing.expect(has_integer_constant(result, 42), "constant final value recorded");
}

waza test_constant_evaluator_cycles() -> unit {
    kaku indirect = check_source("teisu first: int64 = second; teisu second: int64 = first;");
    testing.expect(len(indirect.errors) > 0, "indirect constant cycle rejected");
    kaku direct = check_source("teisu value: int64 = value;");
    testing.expect(len(direct.errors) > 0, "direct constant cycle rejected");
}

waza test_constant_integer_boundaries() -> unit {
    kaku minimum = check_source("teisu value: int64 = -9223372036854775808;");
    testing.expect(len(minimum.errors) == 0, "MinInt64 constant accepted");
    testing.expect(has_integer_constant(minimum, -9223372036854775807 - 1), "MinInt64 value recorded");
    kaku positive = check_source("teisu value: int64 = 9223372036854775808;");
    testing.expect(len(positive.errors) > 0, "positive overflow rejected");
    kaku below = check_source("teisu value: int64 = -9223372036854775809;");
    testing.expect(len(below.errors) > 0, "negative overflow rejected");
}

waza test_constant_conversion_and_division_errors() -> unit {
    kaku converted = check_source("teisu value: uint8 = uint8(int32(255));");
    testing.expect(len(converted.errors) == 0 && has_integer_constant(converted, 255), "constant conversion evaluates");
    kaku narrow = check_source("teisu value: uint8 = uint8(int32(256));");
    testing.expect(len(narrow.errors) > 0, "invalid narrowing rejected");
    kaku division = check_source("teisu value: int64 = 1 / 0;");
    testing.expect(len(division.errors) > 0, "constant division by zero rejected");
}

waza test_cross_file_and_package_constants() -> unit {
    kaku first = parser.parse(string.to_bytes("teisu answer: int64 = base + 2;"));
    kaku second = parser.parse(string.to_bytes("teisu base: int64 = 40;"));
    kaku files: []resolver.SourceFile = [];
    array.push(files, resolver.SourceFile { file_id: 0, path: "a.mio", ast: first.ast, root: first.root });
    array.push(files, resolver.SourceFile { file_id: 1, path: "b.mio", ast: second.ast, root: second.root });
    kaku no_resolved_dependencies: []resolver.ResolvedPackage = [];
    kaku no_checked_dependencies: []TypeCheckResult = [];
    kaku resolved = resolver.resolve_package("library", files, no_resolved_dependencies);
    kaku library = check_package(resolved, no_checked_dependencies);
    testing.expect(len(library.errors) == 0 && has_integer_constant(library, 42), "cross-file constant evaluates");

    kaku exported = parser.parse(string.to_bytes("koukai teisu value: int64 = 42;"));
    kaku library_files: []resolver.SourceFile = [];
    array.push(library_files, resolver.SourceFile { file_id: 0, path: "library.mio", ast: exported.ast, root: exported.root });
    kaku resolved_library = resolver.resolve_package("library", library_files, no_resolved_dependencies);
    library = check_package(resolved_library, no_checked_dependencies);
    kaku app_source = parser.parse(string.to_bytes("yobu \"library\"; teisu answer: int64 = library.value;"));
    kaku app_files: []resolver.SourceFile = [];
    array.push(app_files, resolver.SourceFile { file_id: 0, path: "app.mio", ast: app_source.ast, root: app_source.root });
    kaku resolved_dependencies: []resolver.ResolvedPackage = []; array.push(resolved_dependencies, resolved_library);
    kaku checked_dependencies: []TypeCheckResult = []; array.push(checked_dependencies, library);
    kaku app = check_package(resolver.resolve_package("app", app_files, resolved_dependencies), checked_dependencies);
    testing.expect(len(app.errors) == 0 && has_integer_constant(app, 42), "cross-package constant evaluates");
}

waza test_nullable_loop_narrowing() -> unit {
    kaku condition=check_source("waza main() -> unit { kaku x: int64? = mu; x = 1; aida (x > 0) { x = mu; } }");
    testing.expect(len(condition.errors)>0,"a loop condition cannot reuse a fact invalidated by the backedge");
    kaku body=check_source("waza main() -> unit { kaku x: int64? = 5; aida (x != mu) { kaku y: int64 = x; x = mu; } }");
    testing.expect(len(body.errors)==0,"aida condition proves a nullable non-nil inside the body");
    kaku killed=check_source("waza main() -> unit { kaku x: int64? = 5; aida (x != mu) { x = mu; kaku y: int64 = x; } }");
    testing.expect(len(killed.errors)>0,"assignment of mu inside the body invalidates the loop fact");
    kaku backedge=check_source("waza main() -> unit { kaku x: int64? = mu; x = 1; kaku n: int64 = 0; aida (n < 3) { kaku y: int64 = x; x = mu; n = n + 1; } }");
    testing.expect(len(backedge.errors)>0,"a fact proven before the loop does not survive a later mutation on the backedge");
    kaku after=check_source("waza main() -> unit { kaku x: int64? = 5; aida (x != mu) { x = mu; } kaku y: int64 = x; }");
    testing.expect(len(after.errors)>0,"the loop fact does not hold after the loop");
}

waza test_nullable_recheck_and_function_fact_isolation() -> unit {
    kaku repeated=check_source("waza main(value: int64?) -> int64 { moshi(value==mu){kaesu 0;} moshi(value==mu){kaesu 0;} kaesu value; }");
    testing.expect(len(repeated.errors)==0,"nullable declaration remains comparable to mu after narrowing");
    kaku nonnullable=check_source("kaku value: int64=1; chant(value==mu);");testing.expect(len(nonnullable.errors)>0,"non-nullable scalar cannot compare to mu");
    kaku closure=check_source("kaku value: int64?=mu; kaku setter=waza () -> unit { value=1; }; chant(value+1);");
    testing.expect(len(closure.errors)>0,"unexecuted closure assignment cannot prove an outer value non-nil");
    kaku function=check_source("kaku value: int64?=mu; waza setter() -> unit { value=1; } chant(value+1);");
    testing.expect(len(function.errors)>0,"unexecuted function assignment cannot leak a non-nil proof");
    kaku preserved_closure=check_source("waza f(value: int64?) -> int64 { moshi(value==mu){kaesu 0;} kaku setter=waza () -> unit {value=mu;}; kaesu value+1; }");
    testing.expect(len(preserved_closure.errors)==0,"closure definition preserves an existing outer non-nil proof");
    kaku preserved_function=check_source("kaku value: int64?=mu; value=1; waza setter() -> unit {value=mu;} chant(value+1);");
    testing.expect(len(preserved_function.errors)==0,"function definition preserves an existing outer non-nil proof");
    kaku delayed_closure=check_source("kaku value: int64?=mu; value=1; kaku getter=waza () -> int64 { kaesu value+1; };");
    testing.expect(len(delayed_closure.errors)>0,"delayed closure cannot inherit a temporary outer non-nil proof");
    kaku delayed_function=check_source("kaku value: int64?=mu; value=1; waza getter() -> int64 { kaesu value+1; }");
    testing.expect(len(delayed_function.errors)>0,"function body requires its own proof for captured nullable state");
    kaku guarded_closure=check_source("kaku value: int64?=mu; value=1; kaku getter=waza () -> int64 { moshi(value==mu){kaesu 0;} kaesu value+1; };");
    testing.expect(len(guarded_closure.errors)==0,"a closure may establish its own non-nil proof");
}
waza test_captured_record_replacement_and_recheck_typecheck() -> unit {
    kaku rechecked=check_source("kata Item { key: string; } waza apply(callback: () -> unit) -> unit { callback(); } waza test() -> unit { kaku item: Item?=Item {key: \"alive\"}; kaku clear=waza () -> unit {item=mu;}; moshi(item==mu){kaesu;} apply(clear); moshi(item==mu){kaesu;} chant(item.key); }");
    testing.expect(len(rechecked.errors)==0,"captured nullable record can be rechecked after a call");
    kaku replaced=check_source("kata Item { key: string; } waza apply(callback: () -> unit) -> unit { callback(); } waza test() -> unit { kaku item: Item?=Item {key: \"alive\"}; kaku replace=waza () -> unit {item=Item {key: \"changed\"};}; moshi(item==mu){kaesu;} apply(replace); chant(item.key); }");
    testing.expect(len(replaced.errors)==0,"checking a closure replacement cannot narrow the surrounding declaration");
}

waza linear_symbol_position(symbols: []resolver.Symbol, package_path: string, name: string, kind: int64) -> int64 {
    kaku at = 0;
    aida (at < len(symbols)) {
        kaku symbol = symbols[at];
        moshi (symbol.package_path == package_path && symbol.name == name && resolver.symbol_kind_code(symbol.kind) == kind) { kaesu at; }
        at = at + 1;
    }
    kaesu -1;
}

// The symbol index must answer exactly like a front-to-back scan: same position for every symbol (the first one
// when a triple repeats), -1 for absent names, wrong kinds and wrong packages.
waza test_symbol_index_matches_linear_scan() -> unit {
    kaku source = "kata Point { x: int64; } waza area(p: Point) -> int64 { kaku shadow = p.x; kaesu shadow; } waza shadow(a: int64) -> int64 { kaku shadow = a; kaesu shadow; } kaku value = area(Point { x: 1 }) + shadow(2);";
    kaku parsed = parser.parse(string.to_bytes(source));
    kaku resolved = resolver.resolve_program("test", parsed);
    testing.expect(len(resolved.symbols) > 8, "enough symbols to exercise the table");
    kaku index = build_symbol_index(resolved.symbols);
    kaku at = 0;
    kaku mismatches = 0;
    aida (at < len(resolved.symbols)) {
        kaku symbol = resolved.symbols[at];
        kaku kind = resolver.symbol_kind_code(symbol.kind);
        moshi (find_current_symbol(index, symbol.package_path, symbol.name, kind) != linear_symbol_position(resolved.symbols, symbol.package_path, symbol.name, kind)) { mismatches = mismatches + 1; }
        moshi (find_current_symbol(index, symbol.package_path, symbol.name, kind + 100) != -1) { mismatches = mismatches + 1; }
        moshi (find_current_symbol(index, "other/package", symbol.name, kind) != -1) { mismatches = mismatches + 1; }
        moshi (find_current_symbol(index, symbol.package_path, string.concat(symbol.name, "_missing"), kind) != -1) { mismatches = mismatches + 1; }
        at = at + 1;
    }
    testing.expect(mismatches == 0, "indexed lookup equals linear scan for hits and misses");
    kaku empty_symbols: []resolver.Symbol = [];
    testing.expect(find_current_symbol(build_symbol_index(empty_symbols), "test", "area", 4) == -1, "empty index finds nothing");
}

// set_node_type keeps one entry per node: a repeated call replaces the type in place, and the entry order is
// the order of first recording (what the linear scan produced).
waza test_set_node_type_updates_in_place() -> unit {
    kaku parsed = parser.parse(string.to_bytes("kaku a = 1; kaku b = 2;"));
    kaku resolved = resolver.resolve_program("test", parsed);
    kaku env = new_environment(resolved);
    testing.expect(set_node_type(env, 0, 2, 7) == 7, "first record returns the type");
    testing.expect(set_node_type(env, 0, 1, 8) == 8, "second node");
    testing.expect(set_node_type(env, 0, 2, 9) == 9, "update returns the new type");
    testing.expect(len(env.result.node_types) == 2, "one entry per node");
    testing.expect(env.result.node_types[0].node.node_id == 2 && env.result.node_types[0].type_id == 9, "updated in place at its first position");
    testing.expect(env.result.node_types[1].node.node_id == 1 && env.result.node_types[1].type_id == 8, "order of first recording kept");
    testing.expect(set_node_type(env, 3, 4000, 5) == 5 && set_node_type(env, 3, 4000, 6) == 6, "nodes outside the table use the scan");
    testing.expect(len(env.result.node_types) == 3 && env.result.node_types[2].type_id == 6, "foreign node recorded once");
}

waza test_qualified_name_matches_concatenation() -> unit {
    kaku packages = ["main", "kiso/array", "", "mio/os", "é"];
    kaku names = ["Point", "Box", "", "x", "名"];
    kaku wrong = 0;
    kaku p = 0;
    aida (p < len(packages)) {
        kaku n = 0;
        aida (n < len(names)) {
            kaku qualified = string.concat(string.concat(packages[p], "."), names[n]);
            moshi (!qualified_name_matches(packages[p], names[n], qualified)) { wrong = wrong + 1; }
            // every near miss must be rejected exactly like the string comparison rejects it
            moshi (qualified_name_matches(packages[p], names[n], string.concat(qualified, "x"))) { wrong = wrong + 1; }
            moshi (qualified_name_matches(packages[p], names[n], names[n])) { wrong = wrong + 1; }
            moshi (qualified_name_matches(packages[p], names[n], string.concat(string.concat(packages[p], ":"), names[n]))) { wrong = wrong + 1; }
            moshi (qualified_name_matches(string.concat(packages[p], "x"), names[n], qualified)) { wrong = wrong + 1; }
            moshi (qualified_name_matches(packages[p], string.concat("y", names[n]), qualified)) { wrong = wrong + 1; }
            n = n + 1;
        }
        p = p + 1;
    }
    testing.expect(wrong == 0, "qualified name comparison equals package + dot + name");
    testing.expect(qualified_name_matches("a", "bc", "a.bc") && !qualified_name_matches("ab", "c", "a.bc") && !qualified_name_matches("a", "bc", "a.bd"), "split point and last byte matter");
}

// ---- yuzuru: explicit ownership transfer (docs/concurrency.md). The Go reference reports the same codes.
waza first_code(result: TypeCheckResult) -> string {
    moshi (len(result.errors) == 0) { kaesu ""; }
    kaesu result.errors[0].code;
}

waza test_transfer_accepts_a_move_and_keeps_ordinary_assignment() -> unit {
    kaku moved = check_source("waza f() -> int64 { kaku a = [1, 2]; kaku b = yuzuru a; kaesu len(b); }");
    testing.expect(len(moved.errors) == 0, "a transferred graph is usable through its new owner");
    kaku revived = check_source("waza f() -> int64 { kaku a = [1]; kaku b = yuzuru a; a = [2, 3]; kaesu len(a) + len(b); }");
    testing.expect(len(revived.errors) == 0, "reassignment makes a moved variable usable again");
    kaku plain = check_source("waza f() -> int64 { kaku a = [1]; kaku b = a; a = [2]; kaesu len(a) + len(b); }");
    testing.expect(len(plain.errors) == 0, "ordinary assignment keeps both names usable");
    kaku unused_alias = check_source("waza f() -> int64 { kaku a = [1]; kaku b = a; kaku c = yuzuru a; kaesu len(c); }");
    testing.expect(len(unused_alias.errors) == 0, "an alias that is never used again is harmless");
}

waza test_transfer_rejects_use_after_transfer_and_double_transfer() -> unit {
    testing.expect(first_code(check_source("waza f() -> int64 { kaku a = [1]; kaku b = yuzuru a; kaesu len(a); }")) == "E0702", "use after transfer");
    testing.expect(first_code(check_source("waza f() -> int64 { kaku a = [1]; kaku b = yuzuru a; kaku c = yuzuru a; kaesu 0; }")) == "E0703", "double transfer");
    testing.expect(first_code(check_source("waza f(c: bool) -> int64 { kaku a = [1]; moshi (c) { kaku b = yuzuru a; } kaesu len(a); }")) == "E0702", "maybe moved on one branch");
    testing.expect(first_code(check_source("waza f() -> int64 { kaku a = [1]; kaku i = 0; aida (i < 2) { kaku b = yuzuru a; i = i + 1; } kaesu 0; }")) == "E0703", "a loop transfers twice");
}

waza test_transfer_rejects_live_aliases_and_invalid_operands() -> unit {
    testing.expect(first_code(check_source("waza f() -> int64 { kaku a = [1]; kaku b = a; kaku c = yuzuru a; kaesu len(b); }")) == "E0704", "alias used after transfer");
    testing.expect(first_code(check_source("waza f(p: []int64) -> int64 { kaku b = yuzuru p; kaesu 0; }")) == "E0701", "parameters cannot be transferred");
    testing.expect(first_code(check_source("waza f() -> int64 { kaku a = [1]; kaku g = waza() -> int64 { kaesu len(a); }; kaku b = yuzuru a; kaesu g(); }")) == "E0701", "closure-captured variables cannot be transferred");
    testing.expect(first_code(check_source("kaku a = [1];\nwaza peek() -> int64 { kaesu len(a); }\nkaku b = yuzuru a;")) == "E0701", "top-level variables reachable from functions cannot be transferred");
}
