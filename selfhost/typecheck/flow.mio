yobu "kiso/array";
yobu "selfhost/parser";
yobu "selfhost/resolver";

kata NarrowingCondition {
    symbol_id: int64;
    true_non_nil: bool;
    valid: bool;
}

waza unwrap_group(env: TypeEnvironment, file_id: int64, node_id: int64) -> int64 {
    kaku current = node_id;
    aida (parser.node_kind_code(node_at(env, file_id, current).kind) == 13) { current = node_at(env, file_id, current).children[0]; }
    kaesu current;
}

waza declared_nullable_operand(env: TypeEnvironment, file_id: int64, node_id: int64) -> bool {
    kaku id = unwrap_group(env, file_id, node_id);
    moshi (parser.node_kind_code(node_at(env, file_id, id).kind) != 4) { kaesu iie; }
    kaku symbol = binding_of(env, file_id, id);
    moshi (symbol < 0) {
        kaesu iie;
    }
    kaku declared = declared_symbol_type(env, symbol);
    kaesu declared > 0 && type_kind_code(env.result.types[declared].kind) == 16;
}

waza condition_narrowing(env: TypeEnvironment, file_id: int64, node_id: int64) -> NarrowingCondition {
    kaku invalid = NarrowingCondition { symbol_id: -1, true_non_nil: iie, valid: iie };
    kaku condition_id = unwrap_group(env, file_id, node_id);
    kaku condition = node_at(env, file_id, condition_id);
    moshi (parser.node_kind_code(condition.kind) != 11 || (condition.operator != 14 && condition.operator != 15)) { kaesu invalid; }
    kaku left_id = unwrap_group(env, file_id, condition.children[0]);
    kaku right_id = unwrap_group(env, file_id, condition.children[1]);
    kaku left = node_at(env, file_id, left_id);
    kaku right = node_at(env, file_id, right_id);
    kaku identifier_id = -1;
    moshi (parser.node_kind_code(left.kind) == 4 && parser.node_kind_code(right.kind) == 10) { identifier_id = left_id; }
    moshi (parser.node_kind_code(right.kind) == 4 && parser.node_kind_code(left.kind) == 10) { identifier_id = right_id; }
    moshi (identifier_id < 0) { kaesu invalid; }
    kaku symbol_id = binding_of(env, file_id, identifier_id);
    kaku declared = declared_symbol_type(env, symbol_id);
    moshi (declared == 0 || type_kind_code(env.result.types[declared].kind) != 16) { kaesu invalid; }
    kaesu NarrowingCondition { symbol_id: symbol_id, true_non_nil: condition.operator == 15, valid: hai };
}

waza check_block_with_fact(env: TypeEnvironment, file_id: int64, block_id: int64, condition: NarrowingCondition, apply: bool) -> unit {
    kaku saved = len(env.facts);
    moshi (condition.valid && apply) {
        kaku declared = declared_symbol_type(env, condition.symbol_id);
        moshi (type_kind_code(env.result.types[declared].kind) == 16) {
            add_fact(env, condition.symbol_id, env.result.types[declared].element);
        }
    }
    check_block(env, file_id, block_id);
    array.truncate(env.facts, saved);
}

kata LoopEffects {
    assignments: []int64;
    calls: []bool;
}

waza call_may_write(env: TypeEnvironment, file_id: int64, callee_id: int64) -> bool {
    kaku target = unwrap_group(env, file_id, callee_id);
    kaku callee = node_at(env, file_id, target);
    moshi (parser.node_kind_code(callee.kind) == 23) {
        target = unwrap_group(env, file_id, callee.children[0]);
        callee = node_at(env, file_id, target);
    }
    moshi (parser.node_kind_code(callee.kind) == 27) {
        kaku owner_id = callee.children[0];
        kaku owner = node_at(env, file_id, owner_id);
        moshi (parser.node_kind_code(owner.kind) == 23) { owner_id = owner.children[0]; }
        kaku owner_symbol = binding_of(env, file_id, owner_id);
        moshi (owner_symbol >= 0 && resolver.symbol_kind_code(env.resolved.symbols[owner_symbol].kind) == 7) { kaesu iie; }
    }
    kaku symbol = binding_of(env, file_id, target);
    moshi (symbol < 0) { kaesu hai; }
    kaku kind = resolver.symbol_kind_code(env.resolved.symbols[symbol].kind);
    kaesu kind != 8 && kind != 11 && kind != 12;
}

waza scan_loop_effects(env: TypeEnvironment, file_id: int64, node_id: int64, effects: LoopEffects) -> unit {
    kaku node = node_at(env, file_id, node_id);
    kaku kind = parser.node_kind_code(node.kind);
    moshi (kind == 15) {
        kaku symbol = binding_of(env, file_id, node_id);
        moshi (symbol >= 0) { array.push(effects.assignments, symbol); }
    }
    moshi (kind == 22 && !effects.calls[0] && call_may_write(env, file_id, node.children[0])) { effects.calls[0] = hai; }
    kaku index = 0;
    aida (index < len(node.children)) {
        scan_loop_effects(env, file_id, node.children[index], effects);
        index = index + 1;
    }
}

// A loop header must be valid on entry and after every backedge, including tsuzuku.
waza invalidate_loop_facts(env: TypeEnvironment, file_id: int64, loop_id: int64) -> unit {
    moshi (len(env.facts) == 0) { kaesu; }
    kaku effects = LoopEffects { assignments: array.with_capacity[int64](4), calls: [iie] };
    scan_loop_effects(env, file_id, loop_id, effects);
    kaku index = 0;
    aida (index < len(env.facts)) {
        kaku fact = env.facts[index];
        moshi (fact.version == env.versions[fact.symbol_id]) {
            kaku drop = effects.calls[0] && call_can_change(env, fact.symbol_id);
            kaku assigned = 0;
            aida (!drop && assigned < len(effects.assignments)) {
                drop = effects.assignments[assigned] == fact.symbol_id;
                assigned = assigned + 1;
            }
            moshi (drop) { invalidate_fact(env, fact.symbol_id); }
        }
        index = index + 1;
    }
}

waza block_always_returns(env: TypeEnvironment, file_id: int64, block_id: int64) -> bool {
    kaku block = node_at(env, file_id, block_id);
    kaku index = 0;
    aida (index < len(block.children)) {
        kaku statement = node_at(env, file_id, block.children[index]);
        kaku kind = parser.node_kind_code(statement.kind);
        moshi (kind == 31) { kaesu hai; }
        moshi (kind == 18 && len(statement.children) > 2 && block_always_returns(env, file_id, statement.children[1]) && block_always_returns(env, file_id, statement.children[2])) {
            kaesu hai;
        }
        moshi (kind == 38 && len(statement.children) > 1) {
            kaku all = hai;
            kaku arm = 1;
            aida (arm < len(statement.children)) {
                kaku arm_node = node_at(env, file_id, statement.children[arm]);
                moshi (!block_always_returns(env, file_id, arm_node.children[len(arm_node.children) - 1])) {
                    all = iie;
                }
                arm = arm + 1;
            }
            moshi (all) { kaesu hai; }
        }
        index = index + 1;
    }
    kaesu iie;
}
