yobu "kiso/testing";
yobu "kiso/string";

waza test_color_precedence() -> unit {
    testing.expect(color_enabled("always", "1", "dumb", "0", "", "1", iie), "explicit always wins");
    testing.expect(!color_enabled("never", "", "xterm-256color", "", "1", "", hai), "explicit never wins");
    testing.expect(!color_enabled("auto", "1", "xterm", "", "", "", hai), "NO_COLOR disables auto");
    testing.expect(!color_enabled("auto", "", "dumb", "", "", "", hai), "TERM=dumb disables");
    testing.expect(!color_enabled("auto", "", "xterm", "0", "", "", hai), "CLICOLOR=0 disables");
    testing.expect(color_enabled("auto", "", "xterm", "", "1", "1", iie), "CLICOLOR_FORCE enables");
    testing.expect(!color_enabled("auto", "", "xterm", "", "", "1", hai), "CI disables auto");
    testing.expect(color_enabled("auto", "", "xterm", "", "", "", hai), "TTY enables auto");
    testing.expect(!color_enabled("auto", "", "xterm", "", "", "", iie), "non-TTY disables auto");
}

waza test_palette_detection() -> unit {
    testing.expect(choose_palette("dark", "", "") == palette_dark, "explicit dark");
    testing.expect(choose_palette("light", "", "") == palette_light, "explicit light");
    testing.expect(choose_palette("auto", "dark", "") == palette_dark, "MIO_THEME dark");
    testing.expect(choose_palette("auto", "", "15;0") == palette_dark, "dark background hint");
    testing.expect(choose_palette("auto", "", "0;15") == palette_light, "light background hint");
    testing.expect(choose_palette("auto", "", "") == palette_neutral, "no hint stays neutral");
    testing.expect(choose_palette("auto", "", "garbage") == palette_neutral, "malformed hint stays neutral");
}

waza test_color_depth() -> unit {
    testing.expect(color_depth("truecolor", "xterm") == depth_truecolor, "COLORTERM truecolor");
    testing.expect(color_depth("24bit", "xterm") == depth_truecolor, "COLORTERM 24bit");
    testing.expect(color_depth("", "xterm-256color") == depth_256, "256-color TERM");
    testing.expect(color_depth("", "xterm") == depth_ansi, "ANSI fallback");
}

waza test_paint_roles_and_reset() -> unit {
    kaku off = Theme {enabled: iie, depth: depth_ansi, palette: palette_neutral};
    testing.expect(paint(off, "error", "boom") == "boom", "disabled paint is plain");
    kaku on = Theme {enabled: hai, depth: depth_ansi, palette: palette_neutral};
    kaku ansi = string.from_utf8([uint8(27)]);
    moshi (ansi != mu) {
        kaku painted = paint(on, "success", "PASS");
        testing.expect(string.contains(painted, "PASS") && string.contains(painted, ansi), "enabled paint inserts ANSI");
        testing.expect(string.has_suffix(painted, string.concat(ansi, "[0m")), "style is reset");
        testing.expect(paint(on, "unknown", "text") == "text", "unknown role stays plain");
    }
}
