yobu "kiso/testing";
yobu "kiso/array";

// Synthetic ELF64 images for verify_shared: header, three program headers (PT_LOAD, PT_DYNAMIC, PT_GNU_STACK) and a
// dynamic section at offset 64 + 3 * 56 = 232.
waza put(out: []uint8, value: int64, width: int64) -> unit {
    kaku x = value;
    kaku i = 0;
    aida (i < width) { array.push(out, uint8(x - (x / 256) * 256)); x = x / 256; i = i + 1; }
}

waza image(kind: int64, load_flags: int64, stack_flags: int64, with_stack: bool, dynamic: []int64) -> []uint8 {
    kaku out: []uint8 = [uint8(127), uint8(69), uint8(76), uint8(70), uint8(2), uint8(1), uint8(1), uint8(0)];
    put(out, 0, 8);
    put(out, kind, 2);
    put(out, 62, 2);
    put(out, 1, 4);
    put(out, 0, 8);
    put(out, 64, 8);
    put(out, 0, 8);
    put(out, 0, 4);
    put(out, 64, 2);
    put(out, 56, 2);
    kaku count = 2;
    moshi (with_stack) { count = 3; }
    put(out, count, 2);
    put(out, 64, 2);
    put(out, 0, 2);
    put(out, 0, 2);
    // PT_LOAD
    put(out, 1, 4); put(out, load_flags, 4); put(out, 0, 8); put(out, 0, 8); put(out, 0, 8); put(out, 4096, 8); put(out, 4096, 8); put(out, 4096, 8);
    // PT_DYNAMIC at file offset 232 (= 64 + 3 * 56), whether or not the third header exists
    put(out, 2, 4); put(out, 6, 4); put(out, 232, 8); put(out, 232, 8); put(out, 232, 8); put(out, len(dynamic) * 8, 8); put(out, len(dynamic) * 8, 8); put(out, 8, 8);
    moshi (with_stack) {
        put(out, 1685382481, 4); put(out, stack_flags, 4); put(out, 0, 8); put(out, 0, 8); put(out, 0, 8); put(out, 0, 8); put(out, 0, 8); put(out, 16, 8);
    }
    aida (len(out) < 232) { array.push(out, uint8(0)); }
    kaku i = 0;
    aida (i < len(dynamic)) { put(out, dynamic[i], 8); i = i + 1; }
    kaesu out;
}

waza good_dynamic() -> []int64 { kaesu [14, 1, 30, 8, 0, 0]; }

waza test_accepts_a_position_independent_non_executable_stack_object() -> unit {
    testing.expect(verify_shared(image(3, 5, 6, hai, good_dynamic()), "libx.so") == "", "valid ET_DYN accepted");
}

waza test_rejects_other_elf_types() -> unit {
    testing.expect(verify_shared(image(2, 5, 6, hai, good_dynamic()), "libx.so") == "E_SHARED_VERIFY not ET_DYN", "ET_EXEC rejected");
    testing.expect(verify_shared(image(1, 5, 6, hai, good_dynamic()), "libx.so") == "E_SHARED_VERIFY not ET_DYN", "ET_REL rejected");
    testing.expect(verify_shared([uint8(1), uint8(2)], "libx.so") == "E_SHARED_VERIFY file too small for an ELF header", "truncated");
    kaku wrong_machine = image(3, 5, 6, hai, good_dynamic());
    wrong_machine[18] = uint8(183);
    testing.expect(verify_shared(wrong_machine, "libx.so") == "E_SHARED_VERIFY not EM_X86_64", "AArch64 rejected");
}

waza test_rejects_writable_executable_segments_and_executable_stack() -> unit {
    testing.expect(verify_shared(image(3, 7, 6, hai, good_dynamic()), "libx.so") == "E_SHARED_VERIFY a PT_LOAD segment is writable and executable", "W+X PT_LOAD rejected");
    testing.expect(verify_shared(image(3, 5, 7, hai, good_dynamic()), "libx.so") == "E_SHARED_VERIFY the stack is executable (PT_GNU_STACK has PF_X)", "executable stack rejected");
    testing.expect(verify_shared(image(3, 5, 6, iie, good_dynamic()), "libx.so") == "E_SHARED_VERIFY missing PT_GNU_STACK (the loader would assume an executable stack)", "missing PT_GNU_STACK rejected");
}

waza test_rejects_text_relocations_and_missing_soname() -> unit {
    // DT_TEXTREL = 22; DT_FLAGS = 30 with DF_TEXTREL = 4
    testing.expect(verify_shared(image(3, 5, 6, hai, [14, 1, 22, 0, 0, 0]), "libx.so") == "E_SHARED_VERIFY text relocations (DT_TEXTREL): the code is not position independent", "DT_TEXTREL rejected");
    testing.expect(verify_shared(image(3, 5, 6, hai, [14, 1, 30, 4, 0, 0]), "libx.so") == "E_SHARED_VERIFY text relocations (DF_TEXTREL): the code is not position independent", "DF_TEXTREL rejected");
    testing.expect(verify_shared(image(3, 5, 6, hai, [30, 8, 0, 0]), "libx.so") == "E_SHARED_VERIFY missing DT_SONAME libx.so", "missing SONAME rejected");
    testing.expect(verify_shared(image(3, 5, 6, hai, [14, 1, 30, 8, 0, 0]), "libx.so") == "", "DF_BIND_NOW alone is fine");
}

waza test_linker_kind_and_argument_helpers() -> unit {
    testing.expect(raw_linker("/usr/bin/ld") && raw_linker("/usr/bin/ld.lld") && raw_linker("ld.bfd"), "ld, ld.lld and ld.bfd take raw arguments");
    testing.expect(!raw_linker("/usr/bin/cc") && !raw_linker("/usr/bin/gcc") && !raw_linker("clang"), "compiler drivers take driver arguments");
    testing.expect(base_name("/a/b/libx.so") == "libx.so" && base_name("libx.so") == "libx.so", "base_name");
    kaku raw = raw_link_arguments(["-L/opt/lib", "-lm", "-Xlinker", "-rpath", "-Xlinker", "$ORIGIN"]);
    testing.expect(len(raw) == 4 && raw[0] == "-L/opt/lib" && raw[1] == "-lm" && raw[2] == "-rpath" && raw[3] == "$ORIGIN", "driver -Xlinker pairs become raw arguments");
    testing.expect(render_command(["ld", "-o", "a b.so"]) == "ld -o 'a b.so'", "the logged command quotes what a shell would need quoted");
}
