yobu "kiso/aot/elfrel";
yobu "kiso/testing";
yobu "kiso/array";
yobu "kiso/string";

// ELF64 fixtures with four program headers, dynamic entries, and a file-backed string table.
waza put(out: []uint8, value: int64, width: int64) -> unit {
    kaku x = value;
    kaku i = 0;
    aida (i < width) { array.push(out, uint8(x - (x / 256) * 256)); x = x / 256; i = i + 1; }
}

waza image(kind: int64, load_flags: int64, stack_flags: int64, with_stack: bool, dynamic: []int64) -> []uint8 {
    kaku out: []uint8 = [uint8(127), uint8(69), uint8(76), uint8(70), uint8(2), uint8(1), uint8(1), uint8(0)];
    put(out, 0, 8);
    put(out, kind, 2);
    put(out, 62, 2);
    put(out, 1, 4);
    put(out, 0, 8);
    put(out, 64, 8);
    put(out, 0, 8);
    put(out, 0, 4);
    put(out, 64, 2);
    put(out, 56, 2);
    kaku count = 3;
    moshi (with_stack) { count = 4; }
    put(out, count, 2);
    put(out, 64, 2);
    put(out, 0, 2);
    put(out, 0, 2);
    kaku dynamic_offset = 288;
    kaku dynamic_size = (len(dynamic) + 6) * 8;
    kaku strings_offset = dynamic_offset + dynamic_size;
    // Map the entire image at virtual address 4096, distinct from the file offset.
    put(out, 1, 4); put(out, load_flags, 4); put(out, 0, 8); put(out, 4096, 8); put(out, 4096, 8);
    put(out, strings_offset + 9, 8); put(out, strings_offset + 9, 8); put(out, 4096, 8);
    put(out, 2, 4); put(out, 6, 4); put(out, dynamic_offset, 8);
    put(out, 4096 + dynamic_offset, 8); put(out, 4096 + dynamic_offset, 8);
    put(out, dynamic_size, 8); put(out, dynamic_size, 8); put(out, 8, 8);
    put(out, 1685382482, 4); put(out, 4, 4); put(out, dynamic_offset, 8);
    put(out, 4096 + dynamic_offset, 8); put(out, 4096 + dynamic_offset, 8);
    put(out, dynamic_size, 8); put(out, dynamic_size, 8); put(out, 1, 8);
    moshi (with_stack) {
        put(out, 1685382481, 4); put(out, stack_flags, 4); put(out, 0, 8); put(out, 0, 8); put(out, 0, 8);
        put(out, 0, 8); put(out, 0, 8); put(out, 16, 8);
    }
    aida (len(out) < dynamic_offset) { array.push(out, uint8(0)); }
    put(out, 5, 8); put(out, 4096 + strings_offset, 8);
    put(out, 10, 8); put(out, 9, 8);
    kaku i = 0;
    aida (i < len(dynamic)) { put(out, dynamic[i], 8); i = i + 1; }
    put(out, 0, 8); put(out, 0, 8);
    array.push(out, uint8(0));
    array.append_all(out, string.to_bytes("libx.so"));
    array.push(out, uint8(0));
    kaesu out;
}

waza good_dynamic() -> []int64 { kaesu [14, 1, 30, 8]; }

waza test_accepts_a_position_independent_non_executable_stack_object() -> unit {
    testing.expect(verify_shared(image(3, 5, 6, hai, good_dynamic()), "libx.so") == "", "valid ET_DYN accepted");
}

waza test_rejects_other_elf_types() -> unit {
    testing.expect(verify_shared(image(2, 5, 6, hai, good_dynamic()), "libx.so") == "E_SHARED_VERIFY not ET_DYN", "ET_EXEC rejected");
    testing.expect(verify_shared(image(1, 5, 6, hai, good_dynamic()), "libx.so") == "E_SHARED_VERIFY not ET_DYN", "ET_REL rejected");
    testing.expect(verify_shared([uint8(1), uint8(2)], "libx.so") == "E_SHARED_VERIFY file too small for an ELF header", "truncated");
    kaku wrong_machine = image(3, 5, 6, hai, good_dynamic());
    wrong_machine[18] = uint8(183);
    testing.expect(verify_shared(wrong_machine, "libx.so") == "E_SHARED_VERIFY not EM_X86_64", "AArch64 rejected");
}

waza test_rejects_writable_executable_segments_and_executable_stack() -> unit {
    testing.expect(verify_shared(image(3, 7, 6, hai, good_dynamic()), "libx.so") == "E_SHARED_VERIFY a PT_LOAD segment is writable and executable", "W+X PT_LOAD rejected");
    testing.expect(verify_shared(image(3, 5, 7, hai, good_dynamic()), "libx.so") == "E_SHARED_VERIFY the stack is executable (PT_GNU_STACK has PF_X)", "executable stack rejected");
    testing.expect(verify_shared(image(3, 5, 6, iie, good_dynamic()), "libx.so") == "E_SHARED_VERIFY missing PT_GNU_STACK (the loader would assume an executable stack)", "missing PT_GNU_STACK rejected");
}

waza test_rejects_text_relocations_and_missing_soname() -> unit {
    // DT_TEXTREL = 22; DT_FLAGS = 30 with DF_TEXTREL = 4
    testing.expect(verify_shared(image(3, 5, 6, hai, [14, 1, 22, 0]), "libx.so") == "E_SHARED_VERIFY text relocations (DT_TEXTREL): the code is not position independent", "DT_TEXTREL rejected");
    testing.expect(verify_shared(image(3, 5, 6, hai, [14, 1, 30, 4]), "libx.so") == "E_SHARED_VERIFY text relocations (DF_TEXTREL): the code is not position independent", "DF_TEXTREL rejected");
    testing.expect(verify_shared(image(3, 5, 6, hai, [30, 8]), "libx.so") == "E_SHARED_VERIFY missing DT_SONAME libx.so", "missing SONAME rejected");
    kaku valid = image(3, 5, 6, hai, good_dynamic());
    testing.expect(verify_shared(valid, "liby.so") == "E_SHARED_VERIFY unexpected DT_SONAME, expected liby.so", "SONAME must match");
    testing.expect(verify_shared(image(3, 5, 6, hai, [14, 9, 30, 8]), "libx.so") == "E_SHARED_VERIFY invalid DT_SONAME string", "string index must fit");
    valid[len(valid) - 1] = uint8(65);
    testing.expect(verify_shared(valid, "libx.so") == "E_SHARED_VERIFY unexpected DT_SONAME, expected libx.so", "SONAME needs a NUL terminator");
}

waza test_requires_relro_and_immediate_binding() -> unit {
    kaku no_relro = image(3, 5, 6, hai, good_dynamic());
    no_relro[176] = uint8(0);
    testing.expect(verify_shared(no_relro, "libx.so") == "E_SHARED_VERIFY missing PT_GNU_RELRO", "RELRO is required");
    testing.expect(verify_shared(image(3, 5, 6, hai, [14, 1]), "libx.so") == "E_SHARED_VERIFY missing BIND_NOW", "immediate binding is required");
    testing.expect(verify_shared(image(3, 5, 6, hai, [14, 1, 1879048187, 1]), "libx.so") == "", "DF_1_NOW");
    testing.expect(verify_shared(image(3, 5, 6, hai, [14, 1, 24, 0]), "libx.so") == "", "DT_BIND_NOW");
}

waza test_rejects_out_of_range_program_headers() -> unit {
    kaku bad = image(3, 5, 6, hai, good_dynamic());
    kaku at = 32;
    aida (at < 39) { bad[at] = uint8(255); at = at + 1; }
    bad[39] = uint8(127);
    testing.expect(verify_shared(bad, "libx.so") == "E_SHARED_VERIFY invalid program header table", "large program header offset");
}

waza test_linker_kind_and_argument_helpers() -> unit {
    testing.expect(raw_linker("/usr/bin/ld") && raw_linker("/usr/bin/ld.lld") && raw_linker("ld.bfd"), "ld, ld.lld and ld.bfd take raw arguments");
    testing.expect(!raw_linker("/usr/bin/cc") && !raw_linker("/usr/bin/gcc") && !raw_linker("clang"), "compiler drivers take driver arguments");
    testing.expect(base_name("/a/b/libx.so") == "libx.so" && base_name("libx.so") == "libx.so", "base_name");
    kaku raw = raw_link_arguments(["-L/opt/lib", "-lm", "-Xlinker", "-rpath", "-Xlinker", "$ORIGIN"]);
    testing.expect(len(raw) == 4 && raw[0] == "-L/opt/lib" && raw[1] == "-lm" && raw[2] == "-rpath" && raw[3] == "$ORIGIN", "driver -Xlinker pairs become raw arguments");
    testing.expect(render_command(["ld", "-o", "a b.so"]) == "ld -o 'a b.so'", "the logged command quotes what a shell would need quoted");
}

// --linker native: the Mio ET_DYN linker. Its output passes verify_shared; anything it cannot link is an explicit
// E_SHARED_LINKER error and never reaches a system linker.
waza native_spec(relocations: []elfrel.Relocation) -> elfrel.ObjectSpec {
    kaku code: []uint8 = [uint8(72), uint8(141), uint8(5), uint8(0), uint8(0), uint8(0), uint8(0), uint8(195)];
    kaku exports: []elfrel.ObjectExport = [elfrel.ObjectExport { symbol: "mio_native", offset: 0, size: 8 }];
    kaesu elfrel.ObjectSpec { code: code, bss_size: 16, exports: exports, locals: [], relocations: relocations };
}

waza native_options(link_options: []string) -> SharedOptions {
    kaesu SharedOptions { soname: "", linker: "native", link_options: link_options, verbose: iie, object_only: iie };
}

waza test_native_linker_output_and_refusals() -> unit {
    kaku data: []elfrel.Relocation = [elfrel.Relocation { at: 3, kind: elfrel.r_x86_64_pc32, symbol: "", addend: 4 }];
    kaku linked = link_native(native_spec(data), native_options([]), "/tmp/out/libnative.so");
    testing.expect(linked.error == "" && verify_shared(linked.bytes, "libnative.so") == "", "the native output passes verify_shared with the output's base name as SONAME");
    kaku external: []elfrel.Relocation = [elfrel.Relocation { at: 3, kind: elfrel.r_x86_64_plt32, symbol: "sqrt", addend: -4 }];
    kaku refused = link_native(native_spec(external), native_options([]), "libnative.so");
    testing.expect(string.has_prefix(refused.error, "E_SHARED_LINKER undefined symbol sqrt: not defined by the declared libraries (none)"), "an external C symbol without a declared library is undefined");
    testing.expect(string.has_prefix(link_native(native_spec(data), native_options(["-Wl,-z,lazy"]), "libnative.so").error, "E_SHARED_LINKER the native linker does not support the link option -Wl,-z,lazy"), "unsupported link options are refused");
    testing.expect(string.has_prefix(link_native(native_spec(data), native_options(["/nonexistent/helper.o"]), "libnative.so").error, "E_SHARED_LINKER the native linker links shared libraries only"), "object files are refused");
    testing.expect(string.has_prefix(link_native(native_spec(data), native_options(["/nonexistent/libnothing.so"]), "libnative.so").error, "E_SHARED_LINKER cannot read the declared library /nonexistent/libnothing.so"), "a missing library file is reported");
    testing.expect(link_native(native_spec(data), SharedOptions { soname: "-bad", linker: "native", link_options: [], verbose: iie, object_only: iie }, "x.so").error == "E_SHARED invalid SONAME", "an invalid SONAME is refused");
    testing.expect(string.has_prefix(link_shared([], [], native_options([]), "x.so").error, "E_SHARED_LINKER the Mio native linker takes the lowered module"), "the system-linker seam never accepts a native request");
}
