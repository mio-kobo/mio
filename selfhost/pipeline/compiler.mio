yobu "selfhost/frontend";
yobu "kiso/encoding/mochi";
yobu "kiso/aot/lower";
yobu "kiso/aot/macho";
yobu "kiso/aot/sign";
yobu "kiso/runtime/os/darwin";
yobu "kiso/convert";
yobu "kiso/array";
yobu "kiso/string";
yobu "kiso/fs";

koukai kata NativeBuildResult { bytes: []uint8; error: string; }

// Shared source-to-native core. The only IR handoff is this process's memory
// buffer; no intermediate file, VM, compiler subprocess or linker is involved.
// Ad-hoc signing is pure Mio; publication and process control are separate services.
koukai waza build_source(root: string, entry: string, bunko_root: string) -> NativeBuildResult {
    kaesu build_source_with_options(root, entry, bunko_root, 1073741824, iie);
}

koukai waza build_source_with_options(root: string, entry: string, bunko_root: string,
    heap_capacity: int64, gc_stress: bool) -> NativeBuildResult {
    kaku compiled = frontend.compile_source(root, entry, bunko_root);
    moshi (compiled.error != "") { kaesu NativeBuildResult { bytes: [], error: compiled.error }; }
    kaesu build_mochi_with_options(compiled.bytes, heap_capacity, gc_stress);
}

koukai waza build_mochi_with_options(data: []uint8, heap_capacity: int64, gc_stress: bool) -> NativeBuildResult {
    kaku decoded = mochi.decode(data); kaku file = decoded.value;
    moshi (decoded.error != mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend produced invalid Mochi" }; }
    moshi (file == mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend returned no module" }; }
    kaesu build_file(file, heap_capacity, gc_stress);
}

waza build_file(file: mochi.File, heap_capacity: int64, gc_stress: bool) -> NativeBuildResult {
    kaesu build_file_observed(file, heap_capacity, gc_stress, iie, "");
}

// Diagnostic symbol map for profilers: one line "<code word> <function name>" per emitted function.
waza write_symbols(path: string, file: mochi.File, lowered: lower.LowerResult) -> string {
    kaku output = string.new_builder(); kaku at = 0;
    aida (at < len(lowered.function_words) && at < len(file.functions)) {
        moshi (lowered.function_words[at] >= 0) {
            string.write_string(output, convert.format_int(lowered.function_words[at])); string.write_string(output, " ");
            string.write_string(output, file.functions[at].name); string.write_string(output, "\n");
        }
        at = at + 1;
    }
    // runtime routines: labels with plain names (block, function and generated labels contain numbers)
    at = 0;
    aida (at < len(lowered.labels)) {
        kaku name = lowered.labels[at].name; kaku bytes = string.to_bytes(name);
        kaku digits = iie; kaku bi = 0;
        aida (bi < len(bytes)) { moshi (bytes[bi] >= uint8(48) && bytes[bi] <= uint8(57)) { digits = hai; } bi = bi + 1; }
        moshi (len(bytes) > 0 && !digits) {
            string.write_string(output, convert.format_int(lowered.labels[at].word)); string.write_string(output, " rt:"); string.write_string(output, name); string.write_string(output, "\n");
        }
        at = at + 1;
    }
    kaku written = fs.write_all(path, string.to_bytes(string.builder_string(output)));
    moshi (written.error != mu) { kaesu "E_IO cannot write symbol map"; }
    kaesu "";
}

// observation: the image dumps its collector and memory counters to stderr at exit (diagnostics only; the program's
// own behaviour and output are unchanged).
waza build_file_observed(file: mochi.File, heap_capacity: int64, gc_stress: bool, observation: bool, symbols: string) -> NativeBuildResult {
    kaku lowered = lower.compile_with_heap(file, heap_capacity, gc_stress);
    moshi (observation) { lowered = lower.compile_with_observation(file, heap_capacity, gc_stress); }
    moshi (symbols != "" && lowered.error == mu) {
        kaku problem = write_symbols(symbols, file, lowered);
        moshi (problem != "") { kaesu NativeBuildResult { bytes: [], error: problem }; }
    }
    kaku problem = lowered.error;
    moshi (problem != mu) {
        kaku detail = string.concat(convert.format_int(lower.error_code(problem)), string.concat(" / ", convert.format_int(lower.error_detail(problem))));
        kaesu NativeBuildResult { bytes: [], error: string.concat("E_LOWER ", detail) };
    }
    kaku image = macho.executable(macho.ImageSpec { words: lowered.words, constants: lowered.constants,
        globals: lowered.globals, patches: lowered.patches });
    moshi (image.error != mu) { kaesu NativeBuildResult { bytes: [], error: "E_MACHO cannot encode native image" }; }
    kaesu NativeBuildResult { bytes: image.bytes, error: "" };
}

// GF3 callers receive a locally ad-hoc signed image; the unsigned API remains
// available for reproducible full-byte bootstrap comparisons and IR audits.
koukai waza build_signed_source(root: string, entry: string, bunko_root: string) -> NativeBuildResult {
    kaesu build_signed_source_with_options(root, entry, bunko_root, iie);
}

// gc_stress: the generational collector runs a collection at every allocation (lower.compile_with_heap).
koukai waza build_signed_source_with_options(root: string, entry: string, bunko_root: string, gc_stress: bool) -> NativeBuildResult {
    kaesu build_signed_source_observed(root, entry, bunko_root, gc_stress, iie);
}

koukai waza build_signed_source_observed(root: string, entry: string, bunko_root: string, gc_stress: bool, observation: bool) -> NativeBuildResult {
    kaesu build_signed_source_diagnostic(root, entry, bunko_root, gc_stress, observation, "");
}

koukai waza build_signed_source_diagnostic(root: string, entry: string, bunko_root: string, gc_stress: bool, observation: bool, symbols: string) -> NativeBuildResult {
    kaku checked = frontend.compile_source(root, entry, bunko_root);
    moshi (checked.error != "") { kaesu NativeBuildResult { bytes: [], error: checked.error }; }
    kaku decoded = mochi.decode(checked.bytes); kaku file = decoded.value;
    moshi (decoded.error != mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend produced invalid Mochi" }; }
    moshi (file == mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend returned no module" }; }
    kaku thread_start = -1; kaku thread_join = -1; kaku scan = 0;
    aida (scan < len(file.functions)) {
        kaku name = file.functions[scan].name;
        moshi (string.has_prefix(name, "$mma::mio/thread/runtime::start::")) { thread_start = scan; }
        sore { moshi (string.has_prefix(name, "$mma::mio/thread/runtime::join::")) { thread_join = scan; } }
        scan = scan + 1;
    }
    // Programs that reference the OS thread natives take the cooperative multi-mutator build (the Darwin worker bridge); every other
    // program takes the ordinary build below, byte for byte as before.
    // (Other thread natives, such as the word natives of kiso/thread, are declared too; one that the program really calls has no arm64
    // routine yet and the lowering rejects the build.)
    moshi (thread_start >= 0 || thread_join >= 0) {
        moshi (thread_start < 0 || thread_join < 0) { kaesu NativeBuildResult { bytes: [], error: "E_THREAD darwin-arm64 thread programs must declare start and join together" }; }
        kaesu build_signed_thread_image(file, 1073741824, gc_stress, thread_start, thread_join);
    }
    kaku compiled = build_file_observed(file, 1073741824, gc_stress, observation, symbols);
    moshi (compiled.error != "") { kaesu compiled; }
    kaku signed = sign.adhoc(compiled.bytes);
    moshi (signed.error != "") { kaesu NativeBuildResult { bytes: [], error: string.concat("E_SIGN ", signed.error) }; }
    kaesu NativeBuildResult { bytes: signed.bytes, error: "" };
}

// Darwin ARM64 image with the thread runtime: lowered by the worker bridge, linked against libSystem's pthread symbols and ad-hoc signed.
waza build_signed_thread_image(file: mochi.File, capacity: int64, gc_stress: bool, start_id: int64, join_id: int64) -> NativeBuildResult {
    kaku lowered = lower.compile_with_public_threads(file, capacity, gc_stress, start_id, join_id);
    kaku problem = lowered.error;
    moshi (problem != mu) {
        kaku detail = string.concat(convert.format_int(lower.error_code(problem)), string.concat(" / ", convert.format_int(lower.error_detail(problem))));
        kaesu NativeBuildResult { bytes: [], error: string.concat("E_LOWER ", detail) };
    }
    kaku linked = darwin.executable_appended(macho.ImageSpec { words: lowered.words, constants: lowered.constants, globals: lowered.globals, patches: lowered.patches },
        darwin.worker_symbols(), lower.worker_root_words);
    moshi (linked.error != "") { kaesu NativeBuildResult { bytes: [], error: string.concat("E_MACHO ", linked.error) }; }
    kaku signed = sign.adhoc_linked(linked.bytes);
    moshi (signed.error != "") { kaesu NativeBuildResult { bytes: [], error: string.concat("E_SIGN ", signed.error) }; }
    kaesu NativeBuildResult { bytes: signed.bytes, error: "" };
}

koukai waza build_signed_mochi(data: []uint8) -> NativeBuildResult {
    kaku compiled = build_mochi_with_options(data, 1073741824, iie);
    moshi (compiled.error != "") { kaesu compiled; }
    kaku signed = sign.adhoc(compiled.bytes);
    moshi (signed.error != "") { kaesu NativeBuildResult { bytes: [], error: string.concat("E_SIGN ", signed.error) }; }
    kaesu NativeBuildResult { bytes: signed.bytes, error: "" };
}

// Test images use a private, length-prefixed assertion channel plus a normal
// completion marker. Ordinary applications retain the standard report ABI.
koukai waza build_signed_test(data: []uint8) -> NativeBuildResult {
    kaku decoded = mochi.decode(data); kaku file = decoded.value;
    moshi (decoded.error != mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR invalid test module" }; }
    moshi (file == mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR missing test module" }; }
    kaku functions: []mochi.Function = []; kaku at = 0; kaku found = iie;
    kaku normal = "$mma::mio/testing/runtime::report::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967";
    kaku packet = "$mma::mio/testing/runtime::report_packet::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967";
    aida (at < len(file.functions)) {
        kaku fn = file.functions[at];
        moshi (fn.name == normal || fn.name == packet) {
            found = hai;
            fn = mochi.Function { id: fn.id, name: packet, name_bytes: string.to_bytes(packet), parameter_count: fn.parameter_count,
                local_count: fn.local_count, returns_value: fn.returns_value, captures: fn.captures, instructions: fn.instructions };
        }
        array.push(functions, fn); at = at + 1;
    }
    moshi (!found) {
        array.push(functions, mochi.Function { id: len(functions), name: packet, name_bytes: string.to_bytes(packet), parameter_count: 2,
            local_count: 2, returns_value: iie, captures: [], instructions: [] });
    }
    kaku linked = mochi.File { version: file.version, constants: file.constants, global_count: file.global_count,
        instructions: file.instructions, functions: functions };
    kaku compiled = build_file(linked, 1073741824, iie);
    moshi (compiled.error != "") { kaesu compiled; }
    kaku signed = sign.adhoc(compiled.bytes);
    moshi (signed.error != "") { kaesu NativeBuildResult { bytes: [], error: string.concat("E_SIGN ", signed.error) }; }
    kaesu NativeBuildResult { bytes: signed.bytes, error: "" };
}
