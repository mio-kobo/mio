yobu "kiso/fs";
yobu "kiso/os";

// Linux x86-64 counterpart of the native pipeline in compiler.mio: the same pure-Mio frontend, a different backend.
// Mochi stays in this process's memory; the result is a static ELF64 executable (no linker, no libc, no signing).
koukai waza build_linux_source(root: string, entry: string, bunko_root: string) -> NativeBuildResult {
    kaesu build_linux_source_with_options(root, entry, bunko_root, iie);
}
koukai waza build_linux_source_with_options(root: string, entry: string, bunko_root: string, gc_stress: bool) -> NativeBuildResult {
    kaku compiled = frontend.compile_source(root, entry, bunko_root);
    moshi (compiled.error != "") { kaesu NativeBuildResult { bytes: [], error: compiled.error }; }
    kaesu build_linux_mochi_with_options(compiled.bytes, gc_stress);
}

koukai waza build_linux_mochi(data: []uint8) -> NativeBuildResult { kaesu build_linux_mochi_with_options(data, iie); }
// gc_stress: the RA-1 stress threshold instead of the default 32 MiB, so collections run at almost every poll.
koukai waza build_linux_mochi_with_options(data: []uint8, gc_stress: bool) -> NativeBuildResult {
    kaku decoded = mochi.decode(data);
    kaku file = decoded.value;
    moshi (decoded.error != mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend produced invalid Mochi" }; }
    moshi (file == mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend returned no module" }; }
    kaku threshold = 33554432; moshi (gc_stress) { threshold = abi.gc_stress_threshold_bytes; }
    kaku lowered = lowerlinux.compile_with_gc_threshold(file, threshold);
    moshi (lowered.error != "") { kaesu NativeBuildResult { bytes: [], error: string.concat("E_LOWER ", lowered.error) }; }
    kaesu NativeBuildResult { bytes: lowered.bytes, error: "" };
}

koukai waza build_linux_test(data: []uint8) -> NativeBuildResult {
    kaku linked = link_test_packet(data);
    moshi (linked.error != "") { kaesu NativeBuildResult { bytes: [], error: linked.error }; }
    kaku file = linked.file; moshi (file == mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR missing test module" }; }
    kaku lowered = lowerlinux.compile(file);
    moshi (lowered.error != "") { kaesu NativeBuildResult { bytes: [], error: string.concat("E_LOWER ", lowered.error) }; }
    kaesu NativeBuildResult { bytes: lowered.bytes, error: "" };
}

koukai kata LinkedTest { file: mochi.File?; error: string; }

// The test image reports through the packet channel: every testing report call is bound to report_packet (added as a
// body-less function when the module has none). Shared by the Linux and Windows test images.
koukai waza link_test_packet(data: []uint8) -> LinkedTest {
    kaku decoded = mochi.decode(data); kaku file = decoded.value;
    moshi (decoded.error != mu) { kaesu LinkedTest { file: mu, error: "E_IR invalid test module" }; }
    moshi (file == mu) { kaesu LinkedTest { file: mu, error: "E_IR missing test module" }; }
    kaku functions: []mochi.Function = []; kaku at = 0; kaku found = iie;
    kaku normal = "$mma::mio/testing/runtime::report::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967";
    kaku packet = "$mma::mio/testing/runtime::report_packet::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967";
    aida (at < len(file.functions)) {
        kaku fn = file.functions[at];
        moshi (fn.name == normal || fn.name == packet) {
            found = hai;
            fn = mochi.Function { id: fn.id, name: packet, name_bytes: string.to_bytes(packet), parameter_count: fn.parameter_count,
                local_count: fn.local_count, returns_value: fn.returns_value, captures: fn.captures, instructions: fn.instructions };
        }
        array.push(functions, fn); at = at + 1;
    }
    moshi (!found) {
        array.push(functions, mochi.Function { id: len(functions), name: packet, name_bytes: string.to_bytes(packet), parameter_count: 2,
            local_count: 2, returns_value: iie, captures: [], instructions: [] });
    }
    kaku linked = mochi.File { version: file.version, constants: file.constants, global_count: file.global_count,
        instructions: file.instructions, functions: functions };
    kaesu LinkedTest { file: linked, error: "" };
}

// The host decides which native format a test image must have: /proc exists on Linux and not on macOS; Windows is
// recognised by its system directory (SystemRoot), which neither Unix host has.
waza contains_text(data: []uint8, needle: string) -> bool {
    kaku wanted = string.to_bytes(needle); kaku at = 0;
    aida (at + len(wanted) <= len(data)) {
        kaku i = 0;
        aida (i < len(wanted) && data[at + i] == wanted[i]) { i = i + 1; }
        moshi (i == len(wanted)) { kaesu hai; }
        at = at + 1;
    }
    kaesu iie;
}

koukai waza host_target() -> string {
    kaku probe = fs.stat("/proc/self");
    moshi (probe.error == mu && probe.is_dir) {
        // Linux: the CPU architecture decides the image format ("CPU architecture" appears in /proc/cpuinfo on AArch64 only).
        kaku cpu = fs.read_all("/proc/cpuinfo");
        moshi (cpu.error == mu) { moshi (contains_text(cpu.data, "CPU architecture")) { kaesu "linux-arm64"; } }
        kaesu "linux-amd64";
    }
    kaku system = os.environment("SystemRoot");
    moshi (system != mu) {
        moshi (system != "" && fs.is_dir(system)) {
            // The architecture of this very process, from its own PE header (an environment variable such as
            // PROCESSOR_ARCHITECTURE is inherited from the parent and says AMD64 under an emulated x64 parent).
            moshi (own_pe_machine() == 43620) { kaesu "windows-arm64"; }
            kaesu "windows-amd64";
        }
    }
    // macOS: Intel (CPU_TYPE_X86_64) or Apple silicon, from this binary's own Mach-O header
    moshi (own_cpu_type() == 16777223) { kaesu "darwin-amd64"; }
    kaesu "darwin-arm64";
}

// Parent directory for the private run/test directories: /tmp on Unix hosts; on Windows the user's TEMP (or TMP)
// directory, because "/tmp" is not a system directory there.
koukai waza temporary_root() -> string {
    kaku temp_host = host_target(); moshi (temp_host != "windows-amd64" && temp_host != "windows-arm64") { kaesu "/tmp"; }
    kaku names: []string = ["TEMP", "TMP"];
    kaku at = 0;
    aida (at < len(names)) {
        kaku value = os.environment(names[at]);
        moshi (value != mu) { moshi (value != "" && fs.is_dir(value)) { kaesu value; } }
        at = at + 1;
    }
    kaesu ".";
}

koukai waza build_host_test(data: []uint8) -> NativeBuildResult {
    kaku host = host_target();
    moshi (host == "linux-amd64") { kaesu build_linux_test(data); }
    moshi (host == "linux-arm64") { kaesu build_linux_arm64_test(data); }
    moshi (host == "darwin-amd64") { kaesu build_darwin_amd64_test(data); }
    moshi (host == "windows-amd64") { kaesu build_windows_test(data); }
    moshi (host == "windows-arm64") { kaesu build_windows_arm64_test(data); }
    kaesu build_signed_test(data);
}

// ---- Linux AArch64: the Darwin/AArch64 lowering with the Linux system-call adapter, packaged as a static ELF64.
koukai waza build_linux_arm64_source(root: string, entry: string, bunko_root: string, gc_stress: bool) -> NativeBuildResult {
    kaku compiled = frontend.compile_source(root, entry, bunko_root);
    moshi (compiled.error != "") { kaesu NativeBuildResult { bytes: [], error: compiled.error }; }
    kaesu build_linux_arm64_mochi(compiled.bytes, gc_stress);
}

koukai waza build_linux_arm64_mochi(data: []uint8, gc_stress: bool) -> NativeBuildResult {
    kaku decoded = mochi.decode(data); kaku file = decoded.value;
    moshi (decoded.error != mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend produced invalid Mochi" }; }
    moshi (file == mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend returned no module" }; }
    kaesu build_linux_arm64_file(file, gc_stress);
}

waza build_linux_arm64_file(file: mochi.File, gc_stress: bool) -> NativeBuildResult {
    // A program that declares the OS thread natives takes the cooperative multi-mutator build (the worker bridge on the Linux thread layer);
    // every other program takes the ordinary build below, byte for byte as before.
    kaku thread_start = -1; kaku thread_join = -1; kaku scan = 0;
    aida (scan < len(file.functions)) {
        kaku name = file.functions[scan].name;
        moshi (string.has_prefix(name, "$mma::mio/thread/runtime::start::")) { thread_start = scan; }
        sore { moshi (string.has_prefix(name, "$mma::mio/thread/runtime::join::")) { thread_join = scan; } }
        scan = scan + 1;
    }
    moshi (thread_start >= 0 || thread_join >= 0) {
        moshi (thread_start < 0 || thread_join < 0) { kaesu NativeBuildResult { bytes: [], error: "E_THREAD thread programs must declare start and join together" }; }
        kaku threaded = lower.compile_linux_arm64_threads(file, 1073741824, gc_stress, thread_start, thread_join);
        kaku threaded_problem = threaded.error;
        moshi (threaded_problem != mu) {
            kaku detail = string.concat(convert.format_int(lower.error_code(threaded_problem)), string.concat(" / ", convert.format_int(lower.error_detail(threaded_problem))));
            kaesu NativeBuildResult { bytes: [], error: string.concat("E_LOWER ", detail) };
        }
        // + 32: the import table (28 to 30 words) that the Darwin linker would add itself
        kaku threaded_image = linuxarm64.image_with_runtime(macho.ImageSpec { words: threaded.words, constants: threaded.constants, globals: threaded.globals, patches: threaded.patches }, lower.worker_root_words + 32);
        moshi (threaded_image.error != "") { kaesu NativeBuildResult { bytes: [], error: string.concat("E_ELF ", threaded_image.error) }; }
        kaesu NativeBuildResult { bytes: threaded_image.bytes, error: "" };
    }
    kaku lowered = lower.compile_linux_arm64(file, 1073741824, gc_stress);
    kaku problem = lowered.error;
    moshi (problem != mu) {
        kaku detail = string.concat(convert.format_int(lower.error_code(problem)), string.concat(" / ", convert.format_int(lower.error_detail(problem))));
        kaesu NativeBuildResult { bytes: [], error: string.concat("E_LOWER ", detail) };
    }
    kaku image = linuxarm64.image(macho.ImageSpec { words: lowered.words, constants: lowered.constants, globals: lowered.globals, patches: lowered.patches });
    moshi (image.error != "") { kaesu NativeBuildResult { bytes: [], error: string.concat("E_ELF ", image.error) }; }
    kaesu NativeBuildResult { bytes: image.bytes, error: "" };
}

koukai waza build_linux_arm64_test(data: []uint8) -> NativeBuildResult {
    kaku linked = link_test_packet(data);
    moshi (linked.error != "") { kaesu NativeBuildResult { bytes: [], error: linked.error }; }
    kaku file = linked.file; moshi (file == mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR missing test module" }; }
    kaesu build_linux_arm64_file(file, iie);
}

// ---- macOS x86-64: the Linux x86-64 lowering with the Darwin system-call adapter, packaged as a Mach-O executable.
koukai waza build_darwin_amd64_source(root: string, entry: string, bunko_root: string, gc_stress: bool) -> NativeBuildResult {
    kaku compiled = frontend.compile_source(root, entry, bunko_root);
    moshi (compiled.error != "") { kaesu NativeBuildResult { bytes: [], error: compiled.error }; }
    kaesu build_darwin_amd64_mochi(compiled.bytes, gc_stress);
}

koukai waza build_darwin_amd64_mochi(data: []uint8, gc_stress: bool) -> NativeBuildResult {
    kaku decoded = mochi.decode(data); kaku file = decoded.value;
    moshi (decoded.error != mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend produced invalid Mochi" }; }
    moshi (file == mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend returned no module" }; }
    kaesu build_darwin_amd64_file(file, gc_stress);
}

waza build_darwin_amd64_file(file: mochi.File, gc_stress: bool) -> NativeBuildResult {
    kaku threshold = 33554432; moshi (gc_stress) { threshold = abi.gc_stress_threshold_bytes; }
    kaku lowered = lowerlinux.compile_darwin_amd64(file, threshold);
    moshi (lowered.error != "") { kaesu NativeBuildResult { bytes: [], error: string.concat("E_LOWER ", lowered.error) }; }
    kaesu NativeBuildResult { bytes: lowered.bytes, error: "" };
}

koukai waza build_darwin_amd64_test(data: []uint8) -> NativeBuildResult {
    kaku linked = link_test_packet(data);
    moshi (linked.error != "") { kaesu NativeBuildResult { bytes: [], error: linked.error }; }
    kaku file = linked.file; moshi (file == mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR missing test module" }; }
    kaesu build_darwin_amd64_file(file, iie);
}

// COFF machine field of this process's own PE header (0xAA64 ARM64, 0x8664 AMD64); 0 when it cannot be read.
waza own_pe_machine() -> int64 {
    kaku exe = os.executable_path();
    moshi (exe == mu) { kaesu 0; }
    kaku opened = fs.open_read(exe);
    moshi (opened.error != mu) { kaesu 0; }
    kaku file = opened.file;
    moshi (file == mu) { kaesu 0; }
    kaku header: []uint8 = array.make[uint8](1024, uint8(0));
    kaku read = fs.read(file, header, 0, 1024);
    fs.close(file);
    moshi (read.error != mu || read.count < 128) { kaesu 0; }
    kaku pe = int64(header[60]) + int64(header[61]) * 256 + int64(header[62]) * 65536;
    moshi (pe < 64 || pe + 6 > read.count) { kaesu 0; }
    moshi (header[pe] != uint8(80) || header[pe + 1] != uint8(69) || header[pe + 2] != uint8(0) || header[pe + 3] != uint8(0)) { kaesu 0; }
    kaesu int64(header[pe + 4]) + int64(header[pe + 5]) * 256;
}

// CPU type field of this process's own Mach-O header (little-endian bytes 4..7): 0x01000007 x86-64, 0x0100000C ARM64.
// Returns 0 when it cannot be read.
waza own_cpu_type() -> int64 {
    kaku exe = os.executable_path();
    moshi (exe == mu) { kaesu 0; }
    kaku opened = fs.open_read(exe);
    moshi (opened.error != mu) { kaesu 0; }
    kaku file = opened.file;
    moshi (file == mu) { kaesu 0; }
    kaku header: []uint8 = [uint8(0), uint8(0), uint8(0), uint8(0), uint8(0), uint8(0), uint8(0), uint8(0)];
    kaku read = fs.read(file, header, 0, 8);
    fs.close(file);
    moshi (read.error != mu || read.count < 8) { kaesu 0; }
    kaesu int64(header[4]) + int64(header[5]) * 256 + int64(header[6]) * 65536 + int64(header[7]) * 16777216;
}

// ---- Windows ARM64: the Darwin/AArch64 lowering with the Win32 adapter, packaged as a PE32+ (ARM64) console image.
koukai waza build_windows_arm64_source(root: string, entry: string, bunko_root: string, gc_stress: bool) -> NativeBuildResult {
    kaku compiled = frontend.compile_source(root, entry, bunko_root);
    moshi (compiled.error != "") { kaesu NativeBuildResult { bytes: [], error: compiled.error }; }
    kaesu build_windows_arm64_mochi(compiled.bytes, gc_stress);
}

koukai waza build_windows_arm64_mochi(data: []uint8, gc_stress: bool) -> NativeBuildResult {
    kaku decoded = mochi.decode(data); kaku file = decoded.value;
    moshi (decoded.error != mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend produced invalid Mochi" }; }
    moshi (file == mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR frontend returned no module" }; }
    kaesu build_windows_arm64_file(file, gc_stress);
}

waza build_windows_arm64_file(file: mochi.File, gc_stress: bool) -> NativeBuildResult {
    kaku lowered = lower.compile_windows_arm64(file, 1073741824, gc_stress);
    kaku problem = lowered.error;
    moshi (problem != mu) {
        kaku detail = string.concat(convert.format_int(lower.error_code(problem)), string.concat(" / ", convert.format_int(lower.error_detail(problem))));
        kaesu NativeBuildResult { bytes: [], error: string.concat("E_LOWER ", detail) };
    }
    kaku entry = winarm64.start_word(lowered.labels);
    moshi (entry < 0) { kaesu NativeBuildResult { bytes: [], error: "E_PE missing the Windows entry routine" }; }
    kaku image = winarm64.image(macho.ImageSpec { words: lowered.words, constants: lowered.constants, globals: lowered.globals, patches: lowered.patches }, entry, lower.windows_imports());
    moshi (image.error != "") { kaesu NativeBuildResult { bytes: [], error: string.concat("E_PE ", image.error) }; }
    kaesu NativeBuildResult { bytes: image.bytes, error: "" };
}

koukai waza build_windows_arm64_test(data: []uint8) -> NativeBuildResult {
    kaku linked = link_test_packet(data);
    moshi (linked.error != "") { kaesu NativeBuildResult { bytes: [], error: linked.error }; }
    kaku file = linked.file; moshi (file == mu) { kaesu NativeBuildResult { bytes: [], error: "E_IR missing test module" }; }
    kaesu build_windows_arm64_file(file, iie);
}
