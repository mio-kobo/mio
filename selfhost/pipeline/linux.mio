yobu "selfhost/frontend";
yobu "kiso/encoding/mochi";
yobu "kiso/aot/lowerlinux";
yobu "kiso/aot/lower";
yobu "kiso/aot/arm64";
yobu "kiso/aot/linuxarm64";
yobu "kiso/aot/macho";
yobu "kiso/aot/machox64";
yobu "kiso/aot/winarm64";
yobu "kiso/runtime/abi";
yobu "kiso/convert";
yobu "kiso/string";
