yobu "kiso/testing";
yobu "kiso/encoding/mochi";
yobu "kiso/encoding/binary";
yobu "kiso/array";
yobu "kiso/fs";
yobu "kiso/os";
yobu "kiso/string";
yobu "kiso/convert";

waza operand(code: []uint8, op: int64, value: int64) -> unit {
    array.push(code,uint8(op));array.push(code,uint8(value/256));array.push(code,uint8(value-(value/256)*256));
}
// The AArch64 backend's image for the host: a signed Mach-O image on macOS ARM64, an ELF image on Linux ARM64. Both come from
// the same lowering (private OS/testing state, 2048 user globals); only the container and the OS adapter differ.
waza build_boundary_image(host: string, data: []uint8) -> NativeBuildResult {
    moshi (host == "linux-arm64") { kaesu build_linux_arm64_test(data); }
    kaesu build_signed_test(data);
}
waza test_full_global_capacity_with_private_os_and_testing_state() -> unit {
    // This test builds and executes the host's AArch64 image (Mach-O on macOS ARM64, ELF on Linux ARM64). Other hosts cannot
    // execute either image; the x86-64 and Windows backends have their own coverage of the same properties.
    kaku host = host_target();
    moshi (host != "darwin-arm64" && host != "linux-arm64") { testing.skip("the AArch64 test image needs a macOS ARM64 or Linux ARM64 host"); kaesu; }
    kaku code: []uint8=[];kaku at=0;
    aida(at<2048){operand(code,1,0);operand(code,19,at);at=at+1;}
    operand(code,25,0);array.push(code,uint8(22));operand(code,20,2047);array.push(code,uint8(22));
    kaku key="$mma::mio/os/runtime::argc::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2";
    kaku functions: []mochi.Function=[mochi.Function { id:0,name:key,name_bytes:string.to_bytes(key),parameter_count:0,local_count:0,returns_value:hai,captures:[],instructions:[] }];
    kaku constants: []mochi.Constant=[mochi.Constant { tag:uint8(1),bits:binary.U64 {high:uint32(0),low:uint32(1)},data:[] }];
    kaku file=mochi.File {version:14,constants:constants,global_count:2048,instructions:code,functions:functions};
    kaku built=build_boundary_image(host,mochi.canonical_bytes(file));
    moshi(built.error!=""){testing.fail(built.error);kaesu;}
    kaku directory=string.concat("/tmp/mio-globals-",convert.format_int(os.pid()));kaku created=fs.create_dir(directory);
    moshi(created.error!=mu){testing.fail("create boundary directory");kaesu;}
    moshi(os.chmod(directory,448)!=0){os.remove_dir(directory);testing.fail("protect boundary directory");kaesu;}
    kaku image=string.concat(directory,"/program");kaku stdout=string.concat(directory,"/stdout");kaku stderr=string.concat(directory,"/stderr");kaku packets=string.concat(directory,"/records");
    kaku written=fs.write_all(image,built.bytes);kaku mode=os.chmod(image,448);
    moshi(written.error!=mu || mode!=0){os.remove(image);os.remove_dir(directory);testing.fail("prepare boundary image");kaesu;}
    kaku status=os.spawn_test(image,[image],stdout,stderr,packets,5);kaku output=fs.read_all(stdout);kaku errors=fs.read_all(stderr);kaku records=fs.read_all(packets);
    os.remove(image);os.remove(stdout);os.remove(stderr);os.remove(packets);os.remove_dir(directory);
    testing.expect(status==0 && output.error==mu && errors.error==mu && len(errors.data)==0,"all globals and private state execute normally");
    kaku text=string.from_utf8(output.data);moshi(text==mu){testing.fail("boundary stdout UTF8");}sore{testing.expect(text=="1\n1\n","OS argc and last user global do not overlap");}
    kaku complete=records.error==mu && len(records.data)==8;at=0;aida(at<len(records.data)){moshi(records.data[at]!=uint8(255)){complete=iie;}at=at+1;}
    testing.expect(complete,"private testing state emits intact completion marker");
    kaku overflow=mochi.File {version:14,constants:constants,global_count:2049,instructions:code,functions:functions};
    testing.expect(build_boundary_image(host,mochi.canonical_bytes(overflow)).error!="","user global limit still rejects 2049");
}
