yobu "kiso/aot/cabi";
yobu "kiso/aot/elfdso";
yobu "kiso/aot/elfdyn";
yobu "kiso/aot/elfrel";
yobu "kiso/aot/lowerlinux";
yobu "kiso/array";
yobu "kiso/convert";
yobu "kiso/encoding/mochi";
yobu "kiso/fs";
yobu "kiso/os";
yobu "kiso/runtime/abi";
yobu "kiso/string";
yobu "selfhost/frontend";

// Linux x86-64 shared-library build (`mio build --shared`).
//
// Mio does everything up to the object file: frontend, typed lowering in position-independent mode
// (lowerlinux.compile_shared), the ET_REL object (kiso/aot/elfrel). The system linker performs only the final ET_DYN
// link, with an argv vector (never a shell string); Mio then verifies the file it produced (verify_shared).
// A pure Mio module links with the raw linker (`ld`/`ld.lld`) and no CRT or libc; libraries are linked only when they
// are declared (`--link`, `-l`, `-L`, `--rpath`). The system linker is reached through `link_shared`. `--linker native`
// selects the Mio ELF64 linker (kiso/aot/elfdyn, `link_native`) instead; it links Mio modules and declared shared
// libraries and reports anything else as an error. An explicit native request never falls back to a system linker.

koukai kata SharedOptions {
    // DT_SONAME; empty = the base name of the output file.
    soname: string;
    // Explicit linker program (path or name found on PATH); empty = detect; "native" = the Mio linker (link_native).
    linker: string;
    // Driver-style library arguments from --link/-L/-l/--rpath, in the order given.
    link_options: []string;
    // Print the reproducible link command even on success.
    verbose: bool;
    // Return the relocatable object (ET_REL) instead of linking.
    object_only: bool;
}

waza shared_error(message: string) -> NativeBuildResult { kaesu NativeBuildResult { bytes: [], error: message }; }

koukai waza build_shared_source(root: string, entry: string, bunko_root: string, gc_stress: bool, options: SharedOptions, output: string) -> NativeBuildResult {
    kaku checked = frontend.compile_source_target(root, entry, bunko_root, hai);
    moshi (checked.error != "") { kaesu NativeBuildResult { bytes: [], error: checked.error }; }
    kaesu build_shared_mochi(checked.bytes, gc_stress, options, output);
}

koukai waza build_shared_mochi(data: []uint8, gc_stress: bool, options: SharedOptions, output: string) -> NativeBuildResult {
    kaku decoded = mochi.decode(data);
    kaku file = decoded.value;
    moshi (decoded.error != mu) { kaesu shared_error("E_IR frontend produced invalid Mochi"); }
    moshi (file == mu) { kaesu shared_error("E_IR frontend returned no module"); }
    moshi (host_target() != "linux-amd64") { kaesu shared_error("E_SHARED shared-library generation requires a linux-amd64 host: the linker and loader of the target are needed"); }
    kaku threshold = 33554432;
    moshi (gc_stress) { threshold = abi.gc_stress_threshold_bytes; }
    kaku lowered = lowerlinux.compile_shared(file, threshold);
    moshi (lowered.error != "") {
        moshi (string.has_prefix(lowered.error, "E_")) { kaesu shared_error(lowered.error); }
        kaesu shared_error(string.concat("E_LOWER ", lowered.error));
    }
    moshi (options.linker == "native" && !options.object_only) { kaesu link_native(shared_spec(lowered), options, output); }
    kaku object = shared_object(lowered);
    moshi (object.error != "") { kaesu shared_error(string.concat("E_ELF ", object.error)); }
    moshi (options.object_only) { kaesu NativeBuildResult { bytes: object.bytes, error: "" }; }
    kaesu link_shared(object.bytes, lowered.exports, options, output);
}

// `--linker native`: the Mio ELF64 ET_DYN linker (kiso/aot/elfdyn). Declared shared-library dependencies
// (--link file.so, -L, -l, --rpath) are read by kiso/aot/elfdso; every external C symbol the module calls must be a
// function defined by one of them. Object files, archives and anything outside the supported subset are
// E_SHARED_LINKER errors, never a fallback to the system linker.
koukai waza link_native(spec: elfrel.ObjectSpec, options: SharedOptions, output: string) -> NativeBuildResult {
    kaku soname = options.soname;
    moshi (soname == "") { soname = base_name(output); }
    moshi (soname == "" || string.contains(soname, ",") || string.has_prefix(soname, "-") || !elfdyn.valid_soname(soname)) { kaesu shared_error("E_SHARED invalid SONAME"); }
    kaku externals: []string = [];
    kaku at = 0;
    aida (at < len(spec.relocations)) {
        moshi (spec.relocations[at].kind == elfrel.r_x86_64_plt32 && !string_in(externals, spec.relocations[at].symbol)) { array.push(externals, spec.relocations[at].symbol); }
        at = at + 1;
    }
    kaku imports = native_imports(options.link_options, externals);
    moshi (imports.error != "") { kaesu shared_error(imports.error); }
    kaku linked = elfdyn.link_with(spec, soname, elfdyn.Imports { needed: imports.needed, runpath: imports.runpath, symbols: externals });
    moshi (linked.error != "") { kaesu shared_error(string.concat("E_SHARED_LINKER native link failed: ", linked.error)); }
    kaku problem = verify_shared(linked.bytes, soname);
    moshi (problem != "") { kaesu shared_error(problem); }
    moshi (options.verbose) {
        kaku line = "mio: link: native (Mio ELF64 ET_DYN linker, no external tool)";
        at = 0;
        aida (at < len(imports.needed)) { line = string.concat(line, string.concat(" NEEDED ", imports.needed[at])); at = at + 1; }
        moshi (imports.runpath != "") { line = string.concat(line, string.concat(" RUNPATH ", imports.runpath)); }
        write_log(line);
    }
    kaesu NativeBuildResult { bytes: linked.bytes, error: "" };
}

waza string_in(names: []string, name: string) -> bool {
    kaku at = 0;
    aida (at < len(names)) { moshi (names[at] == name) { kaesu hai; } at = at + 1; }
    kaesu iie;
}

koukai kata NativeImports {
    needed: []string;
    runpath: string;
    error: string;
}

kata NativeLibrary { path: string; name: string; object: elfdso.SharedObject; as_needed: bool; }

waza imports_error(message: string) -> NativeImports { kaesu NativeImports { needed: [], runpath: "", error: string.concat("E_SHARED_LINKER ", message) }; }

// The directories searched for -l after the -L directories, in order (Debian/Ubuntu multiarch, then the generic ones).
waza native_library_directories() -> []string {
    kaesu ["/lib/x86_64-linux-gnu", "/usr/lib/x86_64-linux-gnu", "/lib64", "/usr/lib64", "/lib", "/usr/lib", "/usr/local/lib"];
}

// Reads one declared dependency: an ELF shared object, or a GNU ld script whose inputs are shared objects.
waza add_native_library(libraries: []NativeLibrary, path: string, as_needed: bool, depth: int64) -> string {
    kaku read = fs.read_all(path);
    moshi (read.error != mu) { kaesu string.concat("cannot read the declared library ", path); }
    moshi (elfdso.is_elf(read.data)) {
        kaku object = elfdso.read_shared_object(read.data);
        moshi (object.error != "") { kaesu string.concat(path, string.concat(" is not a usable x86-64 shared object: ", object.error)); }
        kaku name = object.soname;
        moshi (name == "") { name = base_name(path); }
        array.push(libraries, NativeLibrary { path: path, name: name, object: object, as_needed: as_needed });
        kaesu "";
    }
    moshi (string.has_suffix(path, ".a")) { kaesu string.concat("the native linker does not link static archives: ", path); }
    moshi (depth > 0) { kaesu string.concat("a linker script refers to another linker script: ", path); }
    kaku script = elfdso.read_script(read.data);
    moshi (script.error != "") { kaesu string.concat(path, string.concat(" is neither an ELF shared object nor a supported linker script: ", script.error)); }
    kaku at = 0;
    aida (at < len(script.inputs)) {
        kaku input = script.inputs[at];
        // Archives in a script (libc_nonshared.a in glibc's libc.so) are skipped: their symbols are not linked.
        moshi (!string.has_suffix(input.path, ".a")) {
            kaku problem = add_native_library(libraries, input.path, as_needed || input.as_needed, depth + 1);
            moshi (problem != "") { kaesu problem; }
        }
        at = at + 1;
    }
    kaesu "";
}

// Resolves the library options and checks that every external symbol is a function of one of the libraries.
koukai waza native_imports(link_options: []string, externals: []string) -> NativeImports {
    kaku directories: []string = [];
    kaku requests: []string = [];
    kaku runpath = "";
    kaku at = 0;
    aida (at < len(link_options)) {
        kaku option = link_options[at];
        moshi (option == "-Xlinker" && at + 3 < len(link_options) && link_options[at + 1] == "-rpath" && link_options[at + 2] == "-Xlinker") {
            moshi (runpath != "") { runpath = string.concat(runpath, ":"); }
            runpath = string.concat(runpath, link_options[at + 3]);
            at = at + 4;
            tsuzuku;
        }
        moshi (string.has_prefix(option, "-L") && len(string.to_bytes(option)) > 2) {
            array.push(directories, tail_text(option, 2));
        } sore {
            moshi ((string.has_prefix(option, "-l") && len(string.to_bytes(option)) > 2) || string.has_prefix(option, "/")) {
                array.push(requests, option);
            } sore {
                kaesu imports_error(string.concat("the native linker does not support the link option ", option));
            }
        }
        at = at + 1;
    }
    kaku libraries: []NativeLibrary = [];
    at = 0;
    aida (at < len(requests)) {
        kaku request = requests[at];
        kaku path = request;
        moshi (string.has_prefix(request, "-l")) {
            kaku name = tail_text(request, 2);
            path = find_library(directories, name);
            moshi (path == "") { kaesu imports_error(string.concat("cannot find lib", string.concat(name, ".so in the -L directories or the system library directories"))); }
        } sore {
            moshi (string.has_suffix(request, ".o") || string.has_suffix(request, ".a")) {
                kaesu imports_error(string.concat("the native linker links shared libraries only, not object files or archives: ", request));
            }
        }
        kaku problem = add_native_library(libraries, path, iie, 0);
        moshi (problem != "") { kaesu imports_error(problem); }
        at = at + 1;
    }
    // Resolution: the first library (in declaration order) that defines the symbol provides it.
    kaku used: []bool = array.make[bool](len(libraries), iie);
    at = 0;
    aida (at < len(externals)) {
        kaku symbol = externals[at];
        kaku found = -1;
        kaku index = 0;
        aida (index < len(libraries) && found < 0) {
            kaku kind = elfdso.find(libraries[index].object, symbol);
            moshi (kind >= 0) {
                moshi (kind != 2 && kind != 10 && kind != 0) {
                    kaesu imports_error(string.concat(symbol, string.concat(" in ", string.concat(libraries[index].path, " is not a function"))));
                }
                found = index;
            }
            index = index + 1;
        }
        moshi (found < 0) {
            kaku names = "";
            index = 0;
            aida (index < len(libraries)) {
                moshi (names != "") { names = string.concat(names, ", "); }
                names = string.concat(names, libraries[index].name);
                index = index + 1;
            }
            moshi (names == "") { names = "none"; }
            kaesu imports_error(string.concat("undefined symbol ", string.concat(symbol, string.concat(": not defined by the declared libraries (",
                string.concat(names, "); transitive dependencies and archives are not searched")))));
        }
        used[found] = hai;
        at = at + 1;
    }
    kaku needed: []string = [];
    at = 0;
    aida (at < len(libraries)) {
        moshi ((!libraries[at].as_needed || used[at]) && !string_in(needed, libraries[at].name)) { array.push(needed, libraries[at].name); }
        at = at + 1;
    }
    kaesu NativeImports { needed: needed, runpath: runpath, error: "" };
}

waza tail_text(text: string, from: int64) -> string {
    kaku value = string.from_utf8(slice_bytes(string.to_bytes(text), from));
    moshi (value == mu) { kaesu ""; }
    kaesu value;
}

waza slice_bytes(bytes: []uint8, from: int64) -> []uint8 {
    kaku out: []uint8 = [];
    kaku at = from;
    aida (at < len(bytes)) { array.push(out, bytes[at]); at = at + 1; }
    kaesu out;
}

waza find_library(directories: []string, name: string) -> string {
    kaku all: []string = [];
    array.append_all(all, directories);
    array.append_all(all, native_library_directories());
    kaku at = 0;
    aida (at < len(all)) {
        kaku candidate = string.concat(all[at], string.concat("/lib", string.concat(name, ".so")));
        moshi (fs.is_file(candidate)) { kaesu candidate; }
        at = at + 1;
    }
    kaesu "";
}

// The ET_REL object of a lowered shared module: PC32 relocations against .bss for every data-area reference and PLT32
// against the undefined symbol for every declared external C call. Exports are the only global definitions.
koukai waza shared_object(lowered: lowerlinux.SharedLowerResult) -> elfrel.ObjectResult { kaesu elfrel.object(shared_spec(lowered)); }

// The linker input of a lowered module, shared by the ET_REL writer and the native linker.
koukai waza shared_spec(lowered: lowerlinux.SharedLowerResult) -> elfrel.ObjectSpec {
    kaku exports: []elfrel.ObjectExport = [];
    kaku at = 0;
    aida (at < len(lowered.exports)) {
        kaku entry = lowered.exports[at];
        array.push(exports, elfrel.ObjectExport { symbol: entry.symbol, offset: entry.offset, size: entry.size });
        at = at + 1;
    }
    kaku locals: []elfrel.ObjectExport = [];
    at = 0;
    aida (at < len(lowered.locals)) {
        kaku entry = lowered.locals[at];
        array.push(locals, elfrel.ObjectExport { symbol: entry.symbol, offset: entry.offset, size: entry.size });
        at = at + 1;
    }
    kaku relocations: []elfrel.Relocation = [];
    at = 0;
    aida (at < len(lowered.data_refs)) {
        kaku ref = lowered.data_refs[at];
        array.push(relocations, elfrel.Relocation { at: ref.at, kind: elfrel.r_x86_64_pc32, symbol: "", addend: ref.offset - 4 });
        at = at + 1;
    }
    at = 0;
    aida (at < len(lowered.externals)) {
        kaku call = lowered.externals[at];
        array.push(relocations, elfrel.Relocation { at: call.at, kind: elfrel.r_x86_64_plt32, symbol: call.symbol, addend: -4 });
        at = at + 1;
    }
    kaesu elfrel.ObjectSpec { code: lowered.bytes, bss_size: lowered.bss_size, exports: exports, locals: locals, relocations: relocations };
}

waza base_name(path: string) -> string {
    kaku bytes = string.to_bytes(path);
    kaku start = 0;
    kaku at = 0;
    aida (at < len(bytes)) {
        moshi (bytes[at] == uint8(47)) { start = at + 1; }
        at = at + 1;
    }
    kaku piece: []uint8 = [];
    at = start;
    aida (at < len(bytes)) { array.push(piece, bytes[at]); at = at + 1; }
    kaku name = string.from_utf8(piece);
    moshi (name == mu) { kaesu ""; }
    kaesu name;
}

// A linker that takes ld-style arguments (GNU ld, GNU gold, LLD) as opposed to a compiler driver (cc, gcc, clang).
waza raw_linker(path: string) -> bool {
    kaku name = base_name(path);
    kaesu string.has_prefix(name, "ld");
}

// A compiler driver supplies the system search paths for declared libraries.
waza find_shared_linker(requested: string, with_dependencies: bool) -> string {
    moshi (requested != "") {
        moshi (string.contains(requested, "/")) { moshi (fs.is_file(requested)) { kaesu requested; } kaesu ""; }
        kaesu search_path(requested);
    }
    kaku configured = os.getenv("MIO_LD");
    moshi (configured != "") {
        moshi (string.contains(configured, "/")) {
            moshi (fs.is_file(configured)) { kaesu configured; }
        } sore {
            kaku found = search_path(configured);
            moshi (found != "") { kaesu found; }
        }
    }
    kaku system = search_path("ld");
    kaku lld = search_path("ld.lld");
    moshi (!with_dependencies) {
        moshi (system != "") { kaesu system; }
        moshi (lld != "") { kaesu lld; }
    }
    kaku driver = find_c_driver();
    moshi (driver != "") { kaesu driver; }
    moshi (system != "") { kaesu system; }
    kaesu lld;
}

// Driver-style link options (`-Xlinker -rpath -Xlinker dir`, `-lname`, `-Ldir`, files) to raw-linker arguments.
waza raw_link_arguments(options: []string) -> []string {
    kaku out: []string = [];
    kaku at = 0;
    aida (at < len(options)) {
        moshi (options[at] == "-Xlinker") {
            moshi (at + 1 < len(options)) { array.push(out, options[at + 1]); }
            at = at + 2;
            tsuzuku;
        }
        array.push(out, options[at]);
        at = at + 1;
    }
    kaesu out;
}

// Reproducible rendering of the argument vector (POSIX shell quoting for display only; it is never run by a shell).
waza render_command(arguments: []string) -> string {
    kaku text = "";
    kaku at = 0;
    aida (at < len(arguments)) {
        kaku argument = arguments[at];
        kaku plain = len(string.to_bytes(argument)) > 0;
        kaku bytes = string.to_bytes(argument);
        kaku i = 0;
        aida (i < len(bytes)) {
            kaku b = int64(bytes[i]);
            moshi (!((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45 || b == 95 || b == 46 || b == 47 || b == 61 || b == 44 || b == 43 || b == 58)) { plain = iie; }
            i = i + 1;
        }
        moshi (!plain) { argument = string.concat("'", string.concat(argument, "'")); }
        moshi (at > 0) { text = string.concat(text, " "); }
        text = string.concat(text, argument);
        at = at + 1;
    }
    kaesu text;
}

// A successful verbose link can also emit warnings. Open the log after
// the linker completes and append without truncating its diagnostics.
waza write_log(text: string) -> unit {
    kaku opened = fs.open_append("/dev/stderr");
    kaku file = opened.file;
    moshi (file == mu) { kaesu; }
    kaku bytes = string.to_bytes(string.concat(text, "\n"));
    kaku at = 0;
    aida (at < len(bytes)) {
        kaku result = fs.write(file, bytes, at, len(bytes) - at);
        moshi (result.error != mu || result.count <= 0) { nukeru; }
        at = at + result.count;
    }
    fs.close(file);
}

// The system-linker seam. `--linker native` never reaches it (build_shared_mochi calls link_native); refusing it here
// keeps a native request from ever being handed to a system linker.
koukai waza link_shared(object: []uint8, exports: []lowerlinux.SharedExport, options: SharedOptions, output: string) -> NativeBuildResult {
    moshi (options.linker == "native") {
        kaesu shared_error("E_SHARED_LINKER the Mio native linker takes the lowered module, not an object file; this is an internal error");
    }
    kaku linker = find_shared_linker(options.linker, len(options.link_options) > 0);
    moshi (linker == "") {
        moshi (options.linker != "") { kaesu shared_error(string.concat("E_SHARED_LINKER linker not found: ", options.linker)); }
        kaesu shared_error("E_SHARED_LINKER no linker found: install binutils (ld), lld or a C compiler driver, or pass --linker <path> or set MIO_LD");
    }
    kaku directory = string.concat(temporary_root(), string.concat("/mio-shared-", convert.format_int(os.pid())));
    kaku created = fs.create_dir(directory);
    moshi (created.error != mu) { kaesu shared_error("E_SHARED cannot create a private link directory"); }
    moshi (os.chmod(directory, 448) != 0) { os.remove_dir(directory); kaesu shared_error("E_SHARED cannot protect the link directory"); }
    kaku result = link_in_directory(object, exports, options, output, linker, directory);
    os.remove(string.concat(directory, "/module.o"));
    os.remove(string.concat(directory, "/library.so"));
    os.remove(string.concat(directory, "/exports.map"));
    os.remove_dir(directory);
    kaesu result;
}

// Linked C objects and archives can define globals of their own. Only the
// identifiers validated by the Mio export pass belong in the dynamic scope.
waza shared_export_map(exports: []lowerlinux.SharedExport) -> []uint8 {
    kaku script = string.new_builder();
    string.write_string(script, "{ global:\n");
    kaku at = 0;
    aida (at < len(exports)) {
        string.write_string(script, exports[at].symbol);
        string.write_string(script, ";\n");
        at = at + 1;
    }
    string.write_string(script, "local: *; };\n");
    kaesu string.to_bytes(string.builder_string(script));
}

waza link_in_directory(object: []uint8, exports: []lowerlinux.SharedExport, options: SharedOptions, output: string, linker: string, directory: string) -> NativeBuildResult {
    kaku object_path = string.concat(directory, "/module.o");
    kaku library_path = string.concat(directory, "/library.so");
    kaku written = fs.write_all(object_path, object);
    moshi (written.error != mu) { kaesu shared_error("E_SHARED cannot write the linker input"); }
    kaku soname = options.soname;
    moshi (soname == "") { soname = base_name(output); }
    moshi (soname == "" || string.contains(soname, ",") || string.has_prefix(soname, "-")) { kaesu shared_error("E_SHARED invalid SONAME"); }
    kaku export_map = string.concat(directory, "/exports.map");
    kaku restrict_exports = len(options.link_options) > 0;
    moshi (restrict_exports && fs.write_all(export_map, shared_export_map(exports)).error != mu) {
        kaesu shared_error("E_SHARED cannot write the linker export map");
    }
    kaku arguments: []string = [];
    moshi (raw_linker(linker)) {
        // No CRT, no libc: a pure Mio module has no startup code and no dependency. -z defs / --no-undefined makes any
        // unresolved symbol a link error, -z text forbids text relocations, -z noexecstack keeps the stack non-executable.
        array.append_all(arguments, [linker, "-shared", "-soname", soname, "-z", "noexecstack", "-z", "relro", "-z", "now", "-z", "text",
            "--no-undefined", "--hash-style=gnu", "-o", library_path, object_path]);
        moshi (restrict_exports) { array.append_all(arguments, ["--version-script", export_map]); }
        array.append_all(arguments, raw_link_arguments(options.link_options));
    } sore {
        // -nostdlib: the driver adds neither CRT files nor libc, only what is declared.
        array.append_all(arguments, [linker, "-shared", "-nostdlib", string.concat("-Wl,-soname,", soname), "-Wl,-z,noexecstack",
            "-Wl,-z,relro", "-Wl,-z,now", "-Wl,-z,text", "-Wl,--no-undefined", "-Wl,--hash-style=gnu", "-o", library_path, object_path]);
        moshi (restrict_exports) { array.append_all(arguments, ["-Xlinker", "--version-script", "-Xlinker", export_map]); }
        array.append_all(arguments, options.link_options);
    }
    // The linker inherits stderr. On failure the CLI writes the resulting
    // diagnostic to the same descriptor, including the command.
    kaku status = os.spawn(linker, arguments);
    moshi (status != 0) {
        kaku detail = string.concat("E_SHARED_LINK linker ", string.concat(linker, string.concat(" failed with status ", convert.format_int(status))));
        kaesu shared_error(string.concat(detail, string.concat("\nmio: link command: ", render_command(arguments))));
    }
    kaku linked = fs.read_all(library_path);
    moshi (linked.error != mu || len(linked.data) == 0) { kaesu shared_error("E_SHARED_LINK cannot read the linked shared object"); }
    kaku problem = verify_shared(linked.data, soname);
    moshi (problem != "") { kaesu shared_error(problem); }
    moshi (options.verbose) { write_log(string.concat("mio: link: ", render_command(arguments))); }
    kaesu NativeBuildResult { bytes: linked.data, error: "" };
}

// ---- Verification of the linked file (the part of "mio verifies what it produced" that needs no external tool).

waza word_at(data: []uint8, at: int64, width: int64) -> int64 {
    kaku value = 0;
    kaku scale = 1;
    kaku i = 0;
    aida (i < width) {
        value = value + int64(data[at + i]) * scale;
        scale = scale * 256;
        i = i + 1;
    }
    kaesu value;
}

// Translate a dynamic virtual address through a file-backed PT_LOAD mapping.
waza shared_file_offset(data: []uint8, phoff: int64, phnum: int64, address: int64, size: int64) -> int64 {
    kaku at = 0;
    aida (at < phnum) {
        kaku header = phoff + at * 56;
        moshi (word_at(data, header, 4) == 1) {
            kaku offset = word_at(data, header + 8, 8);
            kaku virtual_address = word_at(data, header + 16, 8);
            kaku file_size = word_at(data, header + 32, 8);
            moshi (virtual_address >= 0 && address >= virtual_address &&
                   size <= file_size && address - virtual_address <= file_size - size) {
                kaesu offset + (address - virtual_address);
            }
        }
        at = at + 1;
    }
    kaesu -1;
}

// Validate the loader-visible program headers and dynamic tags before returning the image.
koukai waza verify_shared(data: []uint8, soname: string) -> string {
    moshi (len(data) < 64) { kaesu "E_SHARED_VERIFY file too small for an ELF header"; }
    moshi (data[0] != uint8(127) || data[1] != uint8(69) || data[2] != uint8(76) || data[3] != uint8(70)) { kaesu "E_SHARED_VERIFY not an ELF file"; }
    moshi (data[4] != uint8(2) || data[5] != uint8(1) || data[6] != uint8(1) || word_at(data, 20, 4) != 1) {
        kaesu "E_SHARED_VERIFY not ELFCLASS64 little-endian version 1";
    }
    moshi (word_at(data, 16, 2) != 3) { kaesu "E_SHARED_VERIFY not ET_DYN"; }
    moshi (word_at(data, 18, 2) != 62) { kaesu "E_SHARED_VERIFY not EM_X86_64"; }
    kaku phoff = word_at(data, 32, 8);
    kaku phnum = word_at(data, 56, 2);
    moshi (word_at(data, 54, 2) != 56 || phnum == 0 || phoff < 64 || phoff > len(data) - phnum * 56) {
        kaesu "E_SHARED_VERIFY invalid program header table";
    }
    kaku dynamic_offset = -1;
    kaku dynamic_size = 0;
    kaku load_seen = iie;
    kaku stack_seen = iie;
    kaku relro_seen = iie;
    kaku at = 0;
    aida (at < phnum) {
        kaku header = phoff + at * 56;
        kaku kind = word_at(data, header, 4);
        kaku flags = word_at(data, header + 4, 4);
        moshi (kind == 1) {
            load_seen = hai;
            // PF_X = 1, PF_W = 2
            moshi (flags - (flags / 4) * 4 == 3) { kaesu "E_SHARED_VERIFY a PT_LOAD segment is writable and executable"; }
            kaku offset = word_at(data, header + 8, 8);
            kaku file_size = word_at(data, header + 32, 8);
            kaku memory_size = word_at(data, header + 40, 8);
            moshi (offset < 0 || file_size < 0 || file_size > memory_size || offset > len(data) - file_size) {
                kaesu "E_SHARED_VERIFY invalid PT_LOAD file span";
            }
        }
        moshi (kind == 2) { dynamic_offset = word_at(data, header + 8, 8); dynamic_size = word_at(data, header + 32, 8); }
        moshi (kind == 1685382481) {
            stack_seen = hai;
            moshi (flags - (flags / 2) * 2 == 1) { kaesu "E_SHARED_VERIFY the stack is executable (PT_GNU_STACK has PF_X)"; }
        }
        moshi (kind == 1685382482) { relro_seen = hai; }
        at = at + 1;
    }
    moshi (!load_seen) { kaesu "E_SHARED_VERIFY missing PT_LOAD"; }
    moshi (!stack_seen) { kaesu "E_SHARED_VERIFY missing PT_GNU_STACK (the loader would assume an executable stack)"; }
    moshi (!relro_seen) { kaesu "E_SHARED_VERIFY missing PT_GNU_RELRO"; }
    moshi (dynamic_offset < 0 || dynamic_size < 16 || dynamic_offset > len(data) - dynamic_size) {
        kaesu "E_SHARED_VERIFY missing or invalid PT_DYNAMIC";
    }
    kaku soname_index = -1;
    kaku strtab_address = -1;
    kaku strtab_size = 0;
    kaku bind_now = iie;
    kaku terminated = iie;
    at = 0;
    aida (at <= dynamic_size - 16) {
        kaku tag = word_at(data, dynamic_offset + at, 8);
        kaku value = word_at(data, dynamic_offset + at + 8, 8);
        moshi (tag == 0) { terminated = hai; nukeru; }
        moshi (tag == 22) { kaesu "E_SHARED_VERIFY text relocations (DT_TEXTREL): the code is not position independent"; }
        // DT_FLAGS = 30 (DF_TEXTREL = 4, DF_BIND_NOW = 8); DT_FLAGS_1 = 0x6ffffffb (DF_1_NOW = 1).
        moshi (tag == 30 && (value / 4) - ((value / 4) / 2) * 2 == 1) { kaesu "E_SHARED_VERIFY text relocations (DF_TEXTREL): the code is not position independent"; }
        moshi (tag == 24 || (tag == 30 && (value / 8) - ((value / 8) / 2) * 2 == 1) ||
               (tag == 1879048187 && value - (value / 2) * 2 == 1)) { bind_now = hai; }
        moshi (tag == 5) { strtab_address = value; }
        moshi (tag == 10) { strtab_size = value; }
        moshi (tag == 14) { soname_index = value; }
        at = at + 16;
    }
    moshi (!terminated) { kaesu "E_SHARED_VERIFY unterminated PT_DYNAMIC"; }
    moshi (soname_index < 0) { kaesu string.concat("E_SHARED_VERIFY missing DT_SONAME ", soname); }
    moshi (!bind_now) { kaesu "E_SHARED_VERIFY missing BIND_NOW"; }
    kaku expected = string.to_bytes(soname);
    moshi (strtab_address < 0 || strtab_size <= len(expected) || soname_index >= strtab_size - len(expected)) {
        kaesu "E_SHARED_VERIFY invalid DT_SONAME string";
    }
    kaku offset = shared_file_offset(data, phoff, phnum, strtab_address, strtab_size);
    moshi (offset < 0) { kaesu "E_SHARED_VERIFY unmapped dynamic string table"; }
    kaku name_at = offset + soname_index;
    at = 0;
    aida (at < len(expected) && data[name_at + at] == expected[at]) { at = at + 1; }
    moshi (at != len(expected) || data[name_at + at] != uint8(0)) {
        kaesu string.concat("E_SHARED_VERIFY unexpected DT_SONAME, expected ", soname);
    }
    kaesu "";
}
