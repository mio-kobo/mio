yobu "kiso/aot/arm64";
yobu "kiso/aot/cabi";
yobu "kiso/aot/lower";
yobu "kiso/aot/macho";
yobu "kiso/aot/sign";
yobu "kiso/array";
yobu "kiso/encoding/mochi";
yobu "kiso/runtime/os/darwin";
yobu "kiso/string";

// Complete validated prototypes for the loader's OS calls. These are bound
// by our Mach-O writer, even on a machine without Xcode or a visible PATH.
waza loader_system_symbols() -> []string {
    kaesu ["$cabi::dlopen:kke", "$cabi::dlsym:kkk", "$cabi::dlclose:ek",
        "$cabi::dlerror:k", "$cabi::malloc:kh", "$cabi::free:vk", "$cabi::dladdr:ekk",
        "$cabi::getsectiondata:kkkkk", "$cabi::calloc:khh", "$cabi::posix_memalign:ekhh",
        "$cabi::memmove:kkkh", "$cabi::memset:kkeh",
        "$cabi::os_unfair_lock_lock:vk", "$cabi::os_unfair_lock_unlock:vk"];
}

waza loader_intrinsics() -> []string {
    kaesu ["$cabi::mio_ffi_store_byte:vkhb", "$cabi::mio_ffi_load_byte:bkh",
        "$cabi::mio_ffi_call_g:gk", "$cabi::mio_ffi_call_gg:gkg",
        "$cabi::mio_ffi_call_ggg:gkgg", "$cabi::mio_ffi_call_jj:jkj",
        "$cabi::mio_ffi_call_jgg:jkgg", "$cabi::mio_ffi_call_lg:lkg",
        "$cabi::mio_ffi_load_pointer:kkh", "$cabi::mio_ffi_pointer_offset:gkk", "$cabi::mio_ffi_load_word:gk",
        "$cabi::mio_ffi_darwin_call:vkkh",
        "$cabi::mio_ffi_darwin_store_u16:vkhd", "$cabi::mio_ffi_darwin_store_u32:vkhf",
        "$cabi::mio_ffi_darwin_store_u64:vkhh", "$cabi::mio_ffi_darwin_store_pointer:vkhk",
        "$cabi::mio_ffi_darwin_store_f32:vkhi", "$cabi::mio_ffi_darwin_store_f64:vkhj",
        "$cabi::mio_ffi_darwin_load_f32:ikh", "$cabi::mio_ffi_darwin_load_f64:jkh",
        "$cabi::mio_ffi_darwin_advance:kkh", "$cabi::mio_ffi_darwin_load_u16:dkh",
        "$cabi::mio_ffi_darwin_load_u32:fkh"];
}

waza index_of_prototype(names: []string, value: string) -> int64 {
    kaku at = 0;
    aida (at < len(names)) {
        moshi (names[at] == value) { kaesu at; }
        at = at + 1;
    }
    kaesu -1;
}

waza has_loader_calls(file: mochi.File) -> bool {
    kaku intrinsics = loader_intrinsics();
    kaku at = 0;
    aida (at < len(file.functions)) {
        moshi (index_of_prototype(intrinsics, file.functions[at].name) >= 0) { kaesu hai; }
        at = at + 1;
    }
    kaesu iie;
}

// x0 is the checked target, x1 the native frame, x2 the aligned stack size.
waza dynamic_call_words() -> arm64.AssembleResult {
    kaku code = arm64.assembler();
    arm64.assembler_emit(code, arm64.stp_pre_x(29, 30, 31, -16));
    arm64.assembler_emit(code, arm64.add_imm_x(29, 31, 0, iie));
    arm64.assembler_emit(code, arm64.stp_pre_x(19, 20, 31, -16));
    arm64.assembler_emit(code, arm64.add_imm_x(19, 1, 0, iie));
    arm64.assembler_emit(code, arm64.add_imm_x(20, 2, 0, iie));
    arm64.assembler_emit(code, arm64.add_imm_x(16, 0, 0, iie));
    arm64.assembler_cbz_x(code, 2, "registers");
    arm64.assembler_emit(code, arm64.add_imm_x(9, 31, 0, iie));
    arm64.assembler_emit(code, arm64.sub_x(9, 9, 2));
    arm64.assembler_emit(code, arm64.add_imm_x(31, 9, 0, iie));
    arm64.assembler_emit(code, arm64.add_imm_x(10, 1, 128, iie));
    arm64.assembler_label(code, "copy_stack");
    arm64.assembler_emit(code, arm64.ldp_post_x(11, 12, 10, 16));
    arm64.assembler_emit(code, arm64.stp_x(11, 12, 9, 0));
    arm64.assembler_emit(code, arm64.add_imm_x(9, 9, 16, iie));
    arm64.assembler_emit(code, arm64.sub_imm_x(2, 2, 16, iie));
    arm64.assembler_cbnz_x(code, 2, "copy_stack");
    arm64.assembler_label(code, "registers");
    kaku reg = 0;
    aida (reg < 8) {
        arm64.assembler_emit(code, arm64.ldr_x(reg, 19, reg * 8));
        // LDR Dn, [x19, #64 + n * 8], preserving the low bits for float.
        arm64.assembler_emit(code, arm64.Instruction {
            word: uint32(4248829952 + (8 + reg) * 1024 + 19 * 32 + reg), error: mu });
        reg = reg + 1;
    }
    arm64.assembler_emit(code, arm64.blr_x(16));
    arm64.assembler_emit(code, arm64.str_x(0, 19, 0));
    // STR D0, [x19, #64].
    arm64.assembler_emit(code, arm64.Instruction { word: uint32(4244635648 + 8 * 1024 + 19 * 32), error: mu });
    arm64.assembler_emit(code, arm64.add_imm_x(9, 31, 0, iie));
    arm64.assembler_emit(code, arm64.add_x(9, 9, 20));
    arm64.assembler_emit(code, arm64.add_imm_x(31, 9, 0, iie));
    arm64.assembler_emit(code, arm64.ldp_post_x(19, 20, 31, 16));
    arm64.assembler_emit(code, arm64.ldp_post_x(29, 30, 31, 16));
    arm64.assembler_emit(code, arm64.ret());
    kaesu arm64.assembler_assemble(code);
}

waza append_loader_intrinsic(words: []uint32, kind: int64) -> unit {
    moshi (kind == 0 || kind == 1) {
        array.push(words, arm64.add_x(9, 0, 1).word);
        moshi (kind == 0) { array.push(words, arm64.strb_w(2, 9, 0).word); }
        sore { array.push(words, arm64.ldrb_w(0, 9, 0).word); }
        array.push(words, arm64.ret().word);
        kaesu;
    }
    moshi (kind == 8) {
        array.push(words, arm64.add_x(9, 0, 1).word);
        array.push(words, arm64.ldr_x(0, 9, 0).word);
        array.push(words, arm64.ret().word);
        kaesu;
    }
    moshi (kind == 9 || kind == 10) {
        moshi (kind == 9) { array.push(words, arm64.sub_x(0, 0, 1).word); }
        sore { array.push(words, arm64.ldr_x(0, 0, 0).word); }
        array.push(words, arm64.ret().word);
        kaesu;
    }
    moshi (kind == 20) {
        array.push(words, arm64.add_x(0, 0, 1).word);
        array.push(words, arm64.ret().word);
        kaesu;
    }
    moshi (kind >= 12) {
        array.push(words, arm64.add_x(9, 0, 1).word);
        moshi (kind == 12) { array.push(words, arm64.strh_w(2, 9, 0).word); }
        moshi (kind == 13) { array.push(words, arm64.str_w(2, 9, 0).word); }
        moshi (kind == 14 || kind == 15) { array.push(words, arm64.str_x(2, 9, 0).word); }
        // STR S0/D0 or LDR S0/D0, [x9].
        moshi (kind == 16) { array.push(words, uint32(3170894112)); }
        moshi (kind == 17) { array.push(words, uint32(4244635936)); }
        moshi (kind == 18) { array.push(words, uint32(3175088416)); }
        moshi (kind == 19) { array.push(words, uint32(4248830240)); }
        moshi (kind == 21) { array.push(words, arm64.ldrh_w(0, 9, 0).word); }
        moshi (kind == 22) { array.push(words, arm64.ldr_w(0, 9, 0).word); }
        array.push(words, arm64.ret().word);
        kaesu;
    }
    // The first GP slot carries the resolved address. FP slots already have
    // their target ABI positions. Tail branch preserves the C caller's LR.
    array.push(words, arm64.add_imm_x(16, 0, 0, iie).word);
    moshi (kind == 3 || kind == 4 || kind == 6 || kind == 7) {
        array.push(words, arm64.add_imm_x(0, 1, 0, iie).word);
    }
    moshi (kind == 4 || kind == 6) { array.push(words, arm64.add_imm_x(1, 2, 0, iie).word); }
    array.push(words, arm64.br_x(16).word);
}

waza append_loader_entries(words: []uint32, count: int64) -> []int64 {
    kaku entries: []int64 = [];
    kaku at = 0;
    aida (at < count) {
        array.push(entries, len(words));
        moshi (at == 11) {
            kaku bridge = dynamic_call_words();
            moshi (bridge.error != mu) { kaesu []; }
            array.append_all(words, bridge.words);
        } sore { append_loader_intrinsic(words, at); }
        at = at + 1;
    }
    kaesu entries;
}

waza c_label_function(label: string) -> int64 {
    kaku id = 0;
    kaku at = 10;
    kaku digits = string.to_bytes(label);
    aida (at < len(digits)) {
        id = id * 10 + int64(digits[at]) - 48;
        at = at + 1;
    }
    kaesu id;
}

waza link_loader_image(file: mochi.File, lowered: lower.LowerResult, workers: bool,
    options: []string, intrinsics: []string, entries: []int64) -> NativeBuildResult {
    kaku labels: []arm64.Label = [];
    kaku words = lowered.words;
    kaku at = 0;
    aida (at < len(lowered.labels)) {
        kaku label = lowered.labels[at];
        kaku intrinsic = -1;
        moshi (string.has_prefix(label.name, "cabi_call_")) {
            kaku id = c_label_function(label.name);
            intrinsic = index_of_prototype(intrinsics, file.functions[id].name);
        }
        moshi (intrinsic < 0) { array.push(labels, label); }
        sore {
            kaku branch = arm64.bl(entries[intrinsic] - label.word);
            moshi (branch.error != mu) { kaesu dylib_build_error("E_FFI call stub out of range"); }
            words[label.word] = branch.word;
        }
        at = at + 1;
    }
    kaesu link_c_image(file, lower.LowerResult { words: words, constants: lowered.constants,
        globals: lowered.globals, patches: lowered.patches, error: mu,
        function_words: lowered.function_words, labels: labels }, workers, options);
}

waza build_loader_image(file: mochi.File, lowered: lower.LowerResult, workers: bool, options: []string) -> NativeBuildResult {
    kaku system = loader_system_symbols();
    kaku intrinsics = loader_intrinsics();
    kaku requires_linker = workers || len(options) != 0;
    kaku at = 0;
    aida (at < len(file.functions)) {
        kaku name = file.functions[at].name;
        moshi (cabi.is_external(name) && index_of_prototype(system, name) < 0 && index_of_prototype(intrinsics, name) < 0) {
            requires_linker = hai;
        }
        at = at + 1;
    }
    kaku words = lowered.words;
    kaku patches = lowered.patches;
    kaku entries = append_loader_entries(words, len(intrinsics));
    moshi (len(entries) != len(intrinsics)) { kaesu dylib_build_error("E_FFI cannot encode dynamic call bridge"); }
    moshi (requires_linker) { kaesu link_loader_image(file, lowered, workers, options, intrinsics, entries); }
    kaku symbols: []string = ["_exit", "_dlopen", "_dlsym", "_dlclose", "_dlerror", "_malloc", "_free",
        "_dladdr", "_getsectiondata", "_calloc", "_posix_memalign", "_memmove", "_memset",
        "_os_unfair_lock_lock", "_os_unfair_lock_unlock"];
    kaku stubs: []int64 = [];
    at = 0;
    aida (at < len(symbols)) {
        kaku word = len(words);
        array.push(stubs, word);
        array.push(words, uint32(0));
        array.push(words, uint32(0));
        array.push(words, arm64.ldr_x(16, 16, 0).word);
        array.push(words, arm64.br_x(16).word);
        array.push(patches, macho.AddressPatch { at_word: word, add_at_word: word + 1,
            target: macho.data_target(), target_offset: (lowered.globals + at) * 8, register: 16 });
        at = at + 1;
    }

    // C bridges still pack arguments and unpack results using the existing
    // Darwin C ABI lowerer. Resolve its fixed-width call sites to local stubs.
    at = 0;
    aida (at < len(lowered.labels)) {
        kaku label = lowered.labels[at];
        moshi (label.name == "cabi_process_exit") {
            kaku jump = arm64.b(stubs[0] - label.word);
            moshi (jump.error != mu) { kaesu dylib_build_error("E_FFI exit stub out of range"); }
            words[label.word] = jump.word;
        }
        moshi (string.has_prefix(label.name, "cabi_call_")) {
            kaku id = c_label_function(label.name);
            kaku name = file.functions[id].name;
            kaku intrinsic = index_of_prototype(intrinsics, name);
            kaku target = 0;
            moshi (intrinsic >= 0) { target = entries[intrinsic]; }
            sore { target = stubs[1 + index_of_prototype(system, name)]; }
            kaku call = arm64.bl(target - label.word);
            moshi (call.error != mu) { kaesu dylib_build_error("E_FFI call stub out of range"); }
            words[label.word] = call.word;
        }
        at = at + 1;
    }
    kaku linked = darwin.executable_appended(macho.ImageSpec { words: words, constants: lowered.constants,
        globals: lowered.globals, patches: patches }, symbols, 0);
    moshi (linked.error != "") { kaesu dylib_build_error(string.concat("E_MACHO ", linked.error)); }
    kaku signed = sign.adhoc_linked(linked.bytes);
    moshi (signed.error != "") { kaesu dylib_build_error(string.concat("E_SIGN ", signed.error)); }
    kaesu NativeBuildResult { bytes: signed.bytes, error: "" };
}
