koukai teisu OP_ARRAY_TRUNCATE: int64 = 63;
koukai teisu OP_ARRAY_APPEND_ALL: int64 = 64;
koukai teisu OP_DATA_CONVERT: int64 = 65;

koukai waza operand_count(opcode: int64) -> int64 {
    moshi (opcode == OP_MATH) { kaesu 2; }
    moshi (opcode == OP_ENUM) { kaesu 2; }
    moshi (opcode == OP_ARRAY_TYPED) { kaesu 2; }
    moshi (opcode == OP_CONSTANT || opcode == OP_JUMP || opcode == OP_JUMP_IF_FALSE ||
        opcode == OP_SET_GLOBAL || opcode == OP_GET_GLOBAL || opcode == OP_SET_LOCAL ||
        opcode == OP_GET_LOCAL || opcode == OP_CALL || opcode == OP_ARRAY || opcode == OP_STRUCT ||
        opcode == OP_GET_FIELD || opcode == OP_GET_ENUM_VALUE || opcode == OP_FUNCTION ||
        opcode == OP_CALL_VALUE || opcode == OP_CLOSURE || opcode == OP_GET_UPVALUE ||
        opcode == OP_SET_UPVALUE || opcode == OP_DEFINE_LOCAL) { kaesu 1; }
    moshi (opcode == OP_INTEGER_CONVERT || opcode == OP_ARRAY_MAKE ||
        opcode == OP_ARRAY_WITH_CAPACITY || opcode == OP_DATA_CONVERT) { kaesu 1; }
    kaesu 0;
}
