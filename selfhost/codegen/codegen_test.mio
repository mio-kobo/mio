yobu "kiso/array";
yobu "kiso/string";
yobu "kiso/testing";
yobu "selfhost/parser";
yobu "selfhost/resolver";
yobu "selfhost/typecheck";

waza compile_source(source: string) -> CompileResult {
    kaku parsed = parser.parse(string.to_bytes(source));
    kaku resolved = resolver.resolve_program("test", parsed);
    kaku checked = typecheck.check_program(resolved);
    kaesu compile_program(resolved, checked);
}

waza test_opcode_table() -> unit {
    testing.expect(OP_CONSTANT == 1, "constant opcode");
    testing.expect(OP_CLOSURE == 46, "closure opcode");
    testing.expect(OP_DATA_CONVERT == 65, "data convert opcode");
    testing.expect(OP_TYPE_CONSTRAINT == 66 && operand_count(OP_TYPE_CONSTRAINT) == 1, "typed IR constraint operand");
    testing.expect(operand_count(OP_MATH) == 2, "math operands");
}

waza test_emitter_fixups() -> unit {
    kaku emitter = new_emitter();
    kaku end = new_label(emitter);
    emit_jump(emitter, OP_JUMP, end);
    emit0(emitter, OP_TRUE);
    mark_label(emitter, end);
    emit0(emitter, OP_POP);
    testing.expect(patch_labels(emitter), "patch labels");
    testing.expect(len(emitter.bytes) == 5, "emitter length");
    testing.expect(emitter.bytes[0] == uint8(17) && emitter.bytes[1] == uint8(0) && emitter.bytes[2] == uint8(4), "jump target");
}

waza test_constant_pool() -> unit {
    kaku layout = empty_layout();
    kaku first = add_constant(layout, integer_constant(1, 42));
    kaku duplicate = add_constant(layout, integer_constant(1, 42));
    kaku negative_zero = add_constant(layout, float64_constant(-0.0));
    kaku positive_zero = add_constant(layout, float64_constant(0.0));
    testing.expect(first == duplicate && len(layout.constants) == 3, "constant deduplication and signed zero");
    testing.expect(negative_zero != positive_zero, "signed zero constants differ");
}

waza test_encoder_header_and_float_bits() -> unit {
    kaku layout = empty_layout();
    add_constant(layout, integer_constant(1, -1));
    add_constant(layout, float32_constant(float32(1.0)));
    add_constant(layout, float64_constant(-0.0));
    array.push(layout.instructions, uint8(OP_TRUE));
    array.push(layout.instructions, uint8(OP_POP));
    kaku encoded = encode_layout(layout);
    testing.expect(len(encoded) == 48, "encoded size");
    testing.expect(encoded[0] == uint8(77) && encoded[4] == uint8(73), "mochi signature");
    testing.expect(encoded[5] == uint8(0) && encoded[6] == uint8(14), "mochi version");
    testing.expect(encoded[7] == uint8(0) && encoded[10] == uint8(3), "constant count");
    testing.expect(encoded[21] == uint8(63) && encoded[22] == uint8(128), "float32 bits");
    testing.expect(encoded[26] == uint8(128) && encoded[27] == uint8(0), "float64 negative zero bits");
}

waza test_compile_basic_program() -> unit {
    kaku result = compile_source("kaku x: int64 = 1; moshi (x < 2) { chant(x + 2); } sore { chant(0); }");
    testing.expect(result.success, "basic program compiles");
    testing.expect(result.layout.global_count == 1, "global slot count");
    testing.expect(len(result.layout.constants) == 3, "basic constants");
    testing.expect(len(result.layout.instructions) > 20, "basic instructions");
    testing.expect(len(result.bytes) > len(result.layout.instructions), "mochi envelope");
}

waza test_compile_function_and_loop() -> unit {
    kaku source = "waza sum(n: int64) -> int64 { kaku total: int64 = 0; kaku i: int64 = 0; aida (i < n) { total = total + i; i = i + 1; } kaesu total; } chant(sum(5));";
    kaku result = compile_source(source);
    testing.expect(result.success, "function program compiles");
    testing.expect(len(result.layout.functions) == 1, "function table");
    testing.expect(result.layout.functions[0].parameter_count == 1, "parameter count");
    testing.expect(result.layout.functions[0].local_count == 3, "local slot count");
    testing.expect(len(result.layout.functions[0].instructions) > 20, "function instructions");
}

waza test_compile_short_circuit_and_minimum() -> unit {
    kaku source = "kaku called: bool = iie; waza side() -> bool { called = hai; kaesu hai; } kaku value: int64 = -9223372036854775808; chant(iie && side()); chant(hai || side()); chant(value);";
    kaku result = compile_source(source);
    testing.expect(result.success, "short circuit and minimum compile");
    kaku found_minimum = iie;
    kaku index = 0;
    aida (index < len(result.layout.constants)) {
        moshi (result.layout.constants[index].kind == 1 && result.layout.constants[index].integer == -9223372036854775807 - 1) {
            found_minimum = hai;
        }
        index = index + 1;
    }
    testing.expect(found_minimum, "minimum int64 constant");
}

waza test_compile_modules() -> unit {
    kaku library_parsed = parser.parse(string.to_bytes("koukai waza twice(value: int64) -> int64 { kaesu value * 2; }"));
    kaku library = resolver.resolve_program("sample/lib", library_parsed);
    kaku library_types = typecheck.check_program(library);
    kaku app_parsed = parser.parse(string.to_bytes("yobu \"sample/lib\"; chant(lib.twice(6));"));
    kaku app_files: []resolver.SourceFile = [resolver.SourceFile { file_id: 0, path: "app", ast: app_parsed.ast, root: app_parsed.root }];
    kaku resolved_dependencies: []resolver.ResolvedPackage = [library];
    kaku app = resolver.resolve_package("sample/app", app_files, resolved_dependencies);
    kaku type_dependencies: []typecheck.TypeCheckResult = [library_types];
    kaku app_types = typecheck.check_package(app, type_dependencies);
    kaku packages: []resolver.ResolvedPackage = [library, app];
    kaku checks: []typecheck.TypeCheckResult = [library_types, app_types];
    kaku result = compile_modules(packages, checks);
    testing.expect(result.success, "multi-package program compiles");
    testing.expect(len(result.layout.functions) == 1, "dependency function linked once");
}

waza native_source(source: string) -> CompileResult {
    kaku parsed = parser.parse(string.to_bytes(source));
    kaku resolved = resolver.resolve_program("test", parsed);
    kaku checked = typecheck.check_program(resolved);
    kaku packages: []resolver.ResolvedPackage = [resolved];
    kaku checks: []typecheck.TypeCheckResult = [checked];
    kaku natives: []NativeFunctionLayout = [];
    kaesu compile_native_modules(packages, checks, natives, iie);
}

waza instance_count(result: CompileResult) -> int64 {
    kaku count = 0;
    kaku at = 0;
    aida (at<len(result.layout.functions)) {
        moshi (string.has_prefix(result.layout.functions[at].name, "$instance::")) {
            count = count + 1;
            testing.expect(len(result.layout.functions[at].instructions)>0, "every reserved instance has an emitted body");
        }
        at = at + 1;
    }
    kaesu count;
}

waza test_native_value_free_generic_instances() -> unit {
    kaku result = native_source("waza empty<T>() -> []T {kaku values: []T=[];kaesu values;} kaku ints=empty[int64](); kaku strings=empty[string](); kaku again=empty[int64]();");
    testing.expect(result.success, "value-free generic functions compile in native mode");
    testing.expect(instance_count(result) == 2, "concrete types select distinct instances and identical calls reuse one");
    testing.expect(result.bytes[6] == uint8(16), "native generic code uses checked native IR");
    result = native_source("waza size<T>(n: int64) -> int64 {kaku values: []T=[]; moshi(n>0){kaesu size[T](n-1);}kaesu len(values);} chant(size[uint8](2));");
    testing.expect(result.success, "recursive value-free generic instance compiles");
    testing.expect(instance_count(result) == 1, "recursive instantiation reuses its reserved function identity");
    result = native_source("waza make<T>(value: T) -> () -> T {kaesu waza () -> T {kaesu value;};} kaku number=make[int64](7); kaku text=make[string](\"mio\");chant(number());chant(text());");
    testing.expect(result.success, "generic closure captures concrete runtime values without capturing type parameters");
    testing.expect(instance_count(result) == 2, "returned closures are emitted under both concrete type contexts");
}

waza test_native_cross_package_generic_instances() -> unit {
    kaku parsed = parser.parse(string.to_bytes("koukai waza empty<T>() -> []T {kaku values: []T=[];kaesu values;}"));
    kaku library = resolver.resolve_program("sample/lib", parsed);
    kaku library_types = typecheck.check_program(library);
    parsed = parser.parse(string.to_bytes("yobu \"sample/lib\"; kata Item {value: int64;} kaku records=lib.empty[Item](); kaku ints=lib.empty[int64]();"));
    kaku files: []resolver.SourceFile = [resolver.SourceFile { file_id: 0, path: "app", ast: parsed.ast, root: parsed.root }];
    kaku dependencies: []resolver.ResolvedPackage = [library];
    kaku app = resolver.resolve_package("sample/app", files, dependencies);
    kaku type_dependencies: []typecheck.TypeCheckResult = [library_types];
    kaku app_types = typecheck.check_package(app, type_dependencies);
    kaku packages: []resolver.ResolvedPackage = [library, app];
    kaku checks: []typecheck.TypeCheckResult = [library_types, app_types];
    kaku natives: []NativeFunctionLayout = [];
    kaku result = compile_native_modules(packages, checks, natives, iie);
    testing.expect(result.success, "generic bodies copy caller-owned concrete types into their declaration package");
    testing.expect(instance_count(result) == 2, "cross-package instances retain both concrete identities");
}

waza compile_in_package(package_path: string, source: string) -> CompileResult {
    kaku parsed = parser.parse(string.to_bytes(source));
    kaku resolved = resolver.resolve_program(package_path, parsed);
    kaku checked = typecheck.check_program(resolved);
    kaku packages: []resolver.ResolvedPackage = [resolved];
    kaku checks: []typecheck.TypeCheckResult = [checked];
    kaku natives: []NativeFunctionLayout = [];
    kaesu compile_native_modules(packages, checks, natives, iie);
}

waza has_compile_error(result: CompileResult, text: string) -> bool {
    kaku at = 0;
    aida (at < len(result.errors)) {
        moshi (result.errors[at].detail == text) { kaesu hai; }
        at = at + 1;
    }
    kaesu iie;
}

waza test_ffi_reserved_symbol_policy() -> unit {
    kaku allowed = compile_in_package("sample/app",
        "waza ver() -> uint32 = c \"mio_ffi_abi_version\"; waza ind(f: cptr, x: int32) -> int32 = c \"mio_ffi_indirect\"; waza ord(x: int64) -> int64 = c \"mio_ordinary_symbol\"; chant(ver()); chant(ind(cptr(0), int32(1))); chant(ord(1));");
    testing.expect(allowed.success, "mio_ffi_abi_version, mio_ffi_indirect, and ordinary mio_* C declarations are permitted");

    kaku darwin_ok = compile_in_package("kiso/ffi/darwin",
        "waza p(x: cptr, o: uint64) -> cptr = c \"mio_ffi_load_pointer\"; waza o(a: cptr, b: cptr) -> int64 = c \"mio_ffi_pointer_offset\"; waza w(x: cptr) -> int64 = c \"mio_ffi_load_word\"; waza sb(x: cptr, o: uint64, v: uint8) -> unit = c \"mio_ffi_store_byte\"; waza lb(x: cptr, o: uint64) -> uint8 = c \"mio_ffi_load_byte\"; waza cg(x: cptr) -> int64 = c \"mio_ffi_call_g\"; waza cgg(x: cptr, a: int64) -> int64 = c \"mio_ffi_call_gg\"; waza cggg(x: cptr, a: int64, b: int64) -> int64 = c \"mio_ffi_call_ggg\"; waza cjj(x: cptr, a: float64) -> float64 = c \"mio_ffi_call_jj\"; waza cjgg(x: cptr, a: int64, b: int64) -> float64 = c \"mio_ffi_call_jgg\"; waza clg(x: cptr, a: int64) -> bool = c \"mio_ffi_call_lg\"; chant(w(cptr(0)));");
    testing.expect(darwin_ok.success, "kiso/ffi/darwin is permitted to declare loader intrinsics");

    kaku blocked_intrinsic = compile_in_package("sample/app",
        "waza w(x: cptr) -> int64 = c \"mio_ffi_load_word\"; chant(w(cptr(0)));");
    testing.expect(!blocked_intrinsic.success && has_compile_error(blocked_intrinsic, "reserved Mio FFI runtime symbol"),
        "user packages cannot declare private loader intrinsics");

    kaku blocked_call = compile_in_package("sample/app",
        "waza cg(x: cptr) -> int64 = c \"mio_ffi_call_g\"; chant(cg(cptr(0)));");
    testing.expect(!blocked_call.success && has_compile_error(blocked_call, "reserved Mio FFI runtime symbol"),
        "user packages cannot declare mio_ffi_call_g");

    kaku blocked_alias_user = compile_in_package("sample/app",
        "waza a() -> int64 = c \"mio_ffi_v1_g_foo\"; chant(a());");
    testing.expect(!blocked_alias_user.success && has_compile_error(blocked_alias_user, "reserved Mio FFI runtime symbol"),
        "user packages cannot declare mio_ffi_v1_ signature aliases");

    kaku blocked_alias_darwin = compile_in_package("kiso/ffi/darwin",
        "waza a() -> int64 = c \"mio_ffi_v1_g_foo\"; chant(a());");
    testing.expect(!blocked_alias_darwin.success && has_compile_error(blocked_alias_darwin, "reserved Mio FFI runtime symbol"),
        "mio_ffi_v1_ signature aliases remain reserved even inside kiso/ffi/darwin");
}
