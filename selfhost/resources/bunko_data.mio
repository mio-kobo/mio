e directory is opened O_RDONLY|O_DIRECTORY and gets a 32 KiB entry buffer.\nwaza emit_fs_open_dir(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.fs_open_dir\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 16);\n    x86_64.call(code, \"rt.fs_cpath\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_open_dir.badpath\");\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 65536);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_eax_imm(code, 2);\n    x86_64.syscall(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.fs_open_dir.errno\");\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 1);\n    x86_64.call(code, \"rt.fs_alloc\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_open_dir.done\");\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);\n    x86_64.call(code, \"rt.fs_dir_slot\");\n    // slot i of the directory table owns the static buffer directory_buffers() + i * 32768\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rcx, dir_table_base());\n    x86_64.sub_rr(code, x86_64.rdx, x86_64.rcx);\n    x86_64.shl_ri(code, x86_64.rdx, 10);\n    x86_64.mov_ri(code, x86_64.rcx, directory_buffers());\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store(code, x86_64.rax, 8, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rdx);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -8);\n    x86_64.jmp(code, \"rt.fs_open_dir.done\");\n    x86_64.label(code, \"rt.fs_open_dir.errno\");\n   