11d5cb81abc2a8540289381e974014b9673e90fde86ab68e0b5a0\") { kaesu 41; }\n    moshi (name == \"$mma::mio/thread/runtime::join::b15568a4df58d4355f98d16e65c34ee8bcb7acdc6bee95cdfc64e1fa36946600\") { kaesu 42; }\n    moshi (name == \"$mma::mio/thread/runtime::words_new::2d442928cf15b11422d9812e734deb33200ebfa5553356bb4c38613afb3e0a40\") { kaesu 43; }\n    moshi (name == \"$mma::mio/thread/runtime::words_free::ac68c7c9ef3695b7255576336208b6f56ce093398520340f92bb07d61895a659\") { kaesu 44; }\n    moshi (name == \"$mma::mio/thread/runtime::word_get::8af87688970e58bad000d36e06ba1f0227af3a16c04b0fc00772057c70b14682\") { kaesu 45; }\n    moshi (name == \"$mma::mio/thread/runtime::word_set::1f324e2e20def45450776395bd16a6c6669ffcc6a6ef60b5c01751bf33819306\") { kaesu 46; }\n    moshi (name == \"$mma::mio/thread/runtime::word_cas::0419470a865f4221eba43d76ec966762d3f528dcef2399c7000a7081eabb9b1d\") { kaesu 47; }\n    moshi (name == \"$mma::mio/thread/runtime::word_add::a14dc46a52f2e8c25a4b9717b59aecfec1ab1cbe884534026f3cfa6db6d1f1b7\") { kaesu 48; }\n    moshi (name == \"$mma::mio/thread/runtime::word_wait::6d1cd1973e5e31558f21d3f6310709fe58b6445a223a33a7023e93693a2f8a42\") { kaesu 49; }\n    moshi (name == \"$mma::mio/thread/runtime::word_wake::aa512d8bd82f76f25c5bf4771fb6b8bc4947685a189c054081f100547eb0ecb6\") { kaesu 50; }\n    moshi (name == \"$mma::mio/thread/runtime::join_status::e1e7f17901b77414d6ee92dad5ab45a52e52ca578aa8d3ad9b67008198a23c07\") { kaesu 51; }\n    kaesu op_none;\n}\n\n// Socket-module operations: 32..40 are the blocking primitives. 41..50 belong to OS threads and channels. 60 and up are the\n// nonblocking and reactor primitives (implemented on linux-amd64; fail-closed stubs elsewhere).\nkoukai waza is_socket_operation(op: int64) -> bool { kaesu (op >= 32 && op <= 40) || (op >= 60 && op <= 70); }\n\nkoukai waza parameter_count(op: int64) -> int64 {\n    moshi (op == 32) { kaesu 0; }\n    moshi (op == 33) { kaesu 2; }\n    moshi (op == 34) { kaesu 4; }\n    moshi (op == 35) { kaesu 4; }\n    moshi (op == 36) { kaesu 3; }\n    moshi (op == 37) { kaesu 1; }\n    moshi (op == 38) { kaesu 5; }\n    moshi (op == 39) { kaesu 5; }\n    moshi (op == 40) { kaesu 2; }\n    moshi (op == 41 || op == 42) { kaesu 1; }\n    moshi (op == 51) { kaesu 0; }\n    moshi (op == 43) { kaesu 1; }\n    moshi (op == 44) { kaesu 2; }\n    moshi (op == 45) { kaesu 2; }\n    moshi (op == 46) { kaesu 3; }\n    moshi (op == 47) { kaesu 4; }\n    moshi (op == 48) { kaesu 3; }\n    moshi (op == 49) { kaesu 3; }\n    moshi (op == 50) { kaesu 3; }\n    moshi (op == 60) { kaesu 3; }\n    moshi (op == 61) { kaesu 2; }\n    moshi (op == 62) { kaesu 1; }\n    moshi (op == 63) { kaesu 4; }\n    moshi (op == 64) { kaesu 5; }\n    moshi (op == 65 || op == 66) { kaesu 2; }\n\n    moshi (op == 31) { kaesu 2; }\n    moshi (op == 30) { kaesu 1; }\n    moshi (op == 29) { kaesu 0; }\n    moshi (op == 27) { kaesu 1; }\n    moshi (op == 28) { kaesu 2; }\n    moshi (op == 26) { kaesu 0; }\n    moshi (op == 25) { kaesu 6; }\n    moshi (op == 24) { kaesu 1; }\n    moshi (op == 20) { kaesu 2; }\n    moshi (op == 21) { kaesu 2; }\n    moshi (op == 22) { kaesu 0; }\n    moshi (op == 23) { kaesu 1; }\n\n    moshi (op == 15) { kaesu 0; }\n    moshi (op == 16) { kaesu 1; }\n    moshi (op == 17) { kaesu 2; }\n    moshi (op == 18) { kaesu 2; }\n    moshi (op == 19) { kaesu 1; }\n\n    moshi (op == op_dir_is_dir || op == op_dir_is_file || op == op_dir_name || op == op_dir_next || op == op_open_dir) { kaesu 1; }\n    moshi (op == op_read || op == op_write) { kaesu 5; }\n    moshi (op != op_none) { kaesu 2; }\n    kaesu -1;\n}\n\n// Exact managed-reference arguments for the NativeFS ABI. Resource tokens and\n// integer offsets are deliberately excluded from the Shadow Frame.\nkoukai waza parameter_is_root(op: int64, index: int64) -> bool {\n    moshi (is_socket_operation(op)) {\n        moshi (op == 33 || op == 40 || op == 61 || op == 65 || op == 66) { kaesu index == 1; }\n        moshi (op == 60) { kaesu index == 2; }\n        moshi (op == 63) { kaesu index == 3; }\n        moshi (op == 64) { kaesu index == 1 || index == 4; }\n        moshi (op == 34 || op == 35) { kaesu index == 1 || index == 3; }\n        moshi (op == 36) { kaesu index == 2; }\n        moshi (op == 38 || op == 39) { kaesu index == 1 || index == 4; }\n        kaesu iie;\n    }\n\n    moshi (op == 27 || op == 28 || op == 31) { kaesu hai; }\n    moshi (op == 25) { kaesu index < 5; }\n    moshi (op == 20 || op == 21 || op == 23 || op == 24) { kaesu hai; }\n    moshi (op == 17) { kaesu index == 1; }\n    moshi (op == 18) { kaesu index == 0; }\n    moshi (op == op_open || op == op_open_dir) { kaesu index == 0; }\n    moshi (op == op_stat || op == op_mkdir) { kaesu index == 0 || index == 1; }\n    moshi (op == op_close || op == op_dir_close || op == op_file_status || op == op_dir_status) { kaesu index == 1; }\n    moshi (op == op_read || op == op_write) { kaesu index == 1 || index == 4; }\n    kaesu iie;\n}\n\nkoukai waza returns_reference(op: int64) -> bool {\n    moshi (is_socket_operation(op)) { kaesu op != 32 && op != 37 && op != 62; }\n    kaesu op == op_close || op == op_dir_close || op == op_dir_name || op == op_dir_status ||\n    op == op_file_status || op == op_mkdir || op == op_read || op == op_stat || op == op_write;\n}\n\nkoukai waza entry_label(op: int64) -> string {\n    moshi (op == 51) { kaesu \"native_join_status\"; }\n    moshi (op == 43) { kaesu \"native_words_new\"; }\n    moshi (op == 44) { kaesu \"native_words_free\"; }\n    moshi (op == 45) { kaesu \"native_word_get\"; }\n    moshi (op == 46) { kaesu \"native_word_set\"; }\n    moshi (op == 47) { kaesu \"native_word_cas\"; }\n    moshi (op == 48) { kaesu \"native_word_add\"; }\n    moshi (op == 49) { kaesu \"native_word_wait\"; }\n    moshi (op == 50) { kaesu \"native_word_wake\"; }\n    moshi (op == 32) { kaesu \"native_socket_open\"; }\n    moshi (op == 33) { kaesu \"native_socket_status\"; }\n    moshi (op == 34) { kaesu \"native_socket_bind_ipv4\"; }\n    moshi (op == 35) { kaesu \"native_socket_connect_ipv4\"; }\n    moshi (op == 36) { kaesu \"native_socket_listen\"; }\n    moshi (op == 37) { kaesu \"native_socket_accept\"; }\n    moshi (op == 38) { kaesu \"native_socket_read\"; }\n    moshi (op == 39) { kaesu \"native_socket_write\"; }\n    moshi (op == 60) { kaesu \"native_socket_set_nonblocking\"; }\n    moshi (op == 61) { kaesu \"native_socket_finish_connect\"; }\n    moshi (op == 62) { kaesu \"native_reactor_open\"; }\n    moshi (op == 63) { kaesu \"native_reactor_ctl\"; }\n    moshi (op == 64) { kaesu \"native_reactor_wait\"; }\n    moshi (op == 65) { kaesu \"native_reactor_signal\"; }\n    moshi (op == 66) { kaesu \"native_reactor_ack\"; }\n    moshi (op == 40) { kaesu \"native_socket_close\"; }\n\n    moshi (op == 31) { kaesu \"nativeos_real_path\"; }\n    moshi (op == 30) { kaesu \"nativeos_stdin_wait\"; }\n    moshi (op == 29) { kaesu \"nativeos_stdin_ready\"; }\n    moshi (op == 27) { kaesu \"nativeos_env_size\"; }\n    moshi (op == 28) { kaesu \"nativeos_env_copy\"; }\n    moshi (op == 26) { kaesu \"nativeos_monotonic_ms\"; }\n    moshi (op == 25) { kaesu \"nativeos_spawn_test\"; }\n    moshi (op == 24) { kaesu \"nativeos_rmdir\"; }\n    moshi (op == 20) { kaesu \"nativeos_spawn\"; }\n    moshi (op == 21) { kaesu \"nativeos_exec\"; }\n    moshi (op == 22) { kaesu \"nativeos_pid\"; }\n    moshi (op == 23) { kaesu \"nativeos_remove\"; }\n\n    moshi (op == 15) { kaesu \"nativeos_argc\"; }\n    moshi (op == 16) { kaesu \"nativeos_arg_size\"; }\n    moshi (op == 17) { kaesu \"nativeos_arg_copy\"; }\n    moshi (op == 18) { kaesu \"nativeos_chmod\"; }\n    moshi (op == 19) { kaesu \"nativeos_exit\"; }\n\n    moshi (op == op_close) { kaesu \"nativefs_close\"; }\n    moshi (op == op_dir_close) { kaesu \"nativefs_dir_close\"; }\n    moshi (op == op_dir_is_dir) { kaesu \"nativefs_dir_is_dir\"; }\n    moshi (op == op_dir_is_file) { kaesu \"nativefs_dir_is_file\"; }\n    moshi (op == op_dir_name) { kaesu \"nativefs_dir_name\"; }\n    moshi (op == op_dir_next) { kaesu \"nativefs_dir_next\"; }\n    moshi (op == op_dir_status) { kaesu \"nativefs_dir_status\"; }\n    moshi (op == op_file_status) { kaesu \"nativefs_file_status\"; }\n    moshi (op == op_mkdir) { kaesu \"nativefs_mkdir\"; }\n    moshi (op == op_open) { kaesu \"nativefs_open\"; }\n    moshi (op == op_open_dir) { kaesu \"nativefs_open_dir\"; }\n    moshi (op == op_read) { kaesu \"nativefs_read\"; }\n    moshi (op == op_stat) { kaesu \"nativefs_stat\"; }\n    kaesu \"nativefs_write\";\n}\n\nwaza emit(code: arm64.Assembler, value: arm64.Instruction) -> unit {\n    kaku managed = arm64.assembler_label_word(code, \"worker_roots_enabled\") >= 0;\n    moshi (managed && value.error == mu && value.word == arm64.svc(128).word) {\n        // Pin compiler/native exact frames only for the actual OS boundary,\n        // never for a whole adapter body that may allocate or initialize data.\n        // Leaf syscall wrappers need their original LR preserved as well.\n        arm64.assembler_emit(code, arm64.sub_imm_x(31, 31, 16, iie));\n        arm64.assembler_emit(code, arm64.str_x(30, 31, 0));\n        arm64.assembler_bl(code, \"attached_native_enter\");\n        arm64.assembler_emit(code, value);\n        arm64.assembler_bl(code, \"attached_native_leave\");\n        arm64.assembler_emit(code, arm64.ldr_x(30, 31, 0));\n        arm64.assembler_emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    } sore { arm64.assembler_emit(code, value); }\n}\nwaza mov(code: arm64.Assembler, destination: int64, source: int64) -> unit { emit(code, arm64.orr_x(destination, 31, source)); }\nwaza bits(code: arm64.Assembler, reg: int64, value: int64) -> unit {\n    emit(code, arm64.movz_x(reg, value - (value / 65536) * 65536, 0));\n    kaku rest = value / 65536;\n    kaku shift = 1;\n    aida (rest > 0) {\n        emit(code, arm64.movk_x(reg, rest - (rest / 65536) * 65536, shift));\n        rest = rest / 65536;\n        shift = shift + 1;\n    }\n}\nwaza enter(code: arm64.Assembler) -> unit {\n    emit(code, arm64.stp_pre_x(29, 30, 31, -16));\n    emit(code, arm64.add_imm_x(29, 31, 0, iie));\n}\nwaza leave(code: arm64.Assembler) -> unit {\n    emit(code, arm64.add_imm_x(31, 29, 0, iie));\n    emit(code, arm64.ldp_post_x(29, 30, 31, 16));\n    emit(code, arm64.ret());\n}\nwaza empty_return(code: arm64.Assembler, empty_tagged: int64) -> unit {\n    bits(code, 0, empty_tagged);\n    leave(code);\n}\n\nwaza emit_pointer_helpers(code: arm64.Assembler) -> unit {\n    // string.ptr(x0) -> x0=bytes,x1=len. Tagged IDs address __const via x28;\n    // dynamic strings share the byte-array descriptor representation.\n    arm64.assembler_label(code, \"nativefs_string_ptr\");\n    emit(code, arm64.movz_x(9, 1, 0));\n    emit(code, arm64.and_x(9, 0, 9));\n    emit(code, arm64.cmp_imm_x(9, 0, iie));\n    arm64.assembler_b_cond(code, 0, \"nativefs_string_dynamic\");\n    emit(code, arm64.lsr_x(9, 0, 1));\n    emit(code, arm64.lsl_x(10, 9, 3));\n    emit(code, arm64.add_x(10, 28, 10));\n    emit(code, arm64.ldr_x(9, 10, 0));\n    bits(code, 11, 4294967295);\n    emit(code, arm64.and_x(0, 9, 11));\n    emit(code, arm64.add_x(0, 28, 0));\n    emit(code, arm64.lsr_x(1, 9, 32));\n    emit(code, arm64.ret());\n    arm64.assembler_label(code, \"nativefs_string_dynamic\");\n    emit(code, arm64.ldr_x(1, 0, 8));\n    emit(code, arm64.ldr_x(0, 0, 40));\n    emit(code, arm64.add_imm_x(0, 0, 32, iie));\n    emit(code, arm64.ret());\n    arm64.assembler_label(code, \"nativefs_array_ptr\");\n    emit(code, arm64.ldr_x(1, 0, 8));\n    emit(code, arm64.ldr_x(0, 0, 40));\n    emit(code, arm64.add_imm_x(0, 0, 32, iie));\n    emit(code, arm64.ret());\n}\n\nwaza emit_table_helpers(code: arm64.Assembler) -> unit {\n    arm64.assembler_label(code, \"nativefs_table_ensure\");\n    mov(code, 9, 27);\n    emit(code, arm64.cmp_imm_x(9, 0, iie));\n    arm64.assembler_b_cond(code, 1, \"nativefs_table_have\");\n    emit(code, arm64.movz_x(0, 0, 0));\n    bits(code, 1, 524288);\n    emit(code, arm64.movz_x(2, 3, 0));\n    emit(code, arm64.movz_x(3, 4098, 0));\n    emit(code, arm64.movn_x(4, 0, 0));\n    emit(code, arm64.movz_x(5, 0, 0));\n    emit(code, arm64.movz_x(16, 197, 0));\n    emit(code, arm64.svc(128));\n    arm64.assembler_b_cond(code, 2, \"nativefs_table_fail\");\n    mov(code, 27, 0);\n    emit(code, arm64.ret());\n    arm64.assembler_label(code, \"nativefs_table_have\");\n    mov(code, 0, 9);\n    emit(code, arm64.ret());\n    arm64.assembler_label(code, \"nativefs_table_fail\");\n    emit(code, arm64.movz_x(0, 0, 0));\n    emit(code, arm64.ret());\n\n    // alloc(kind,fd,errno): 4096 x 128-byte entries (a 512 KiB lazily mapped table; it was 32 entries); +0 fd,+8 generation,\n    // +16 kind,+24 errno. Mio only receives a generation-checked token.\n    arm64.assembler_label(code, \"nativefs_handle_alloc\");\n    enter(code);\n    emit(code, arm64.sub_imm_x(31, 31, 32, iie));\n    emit(code, arm64.str_x(0, 31, 0));\n    emit(code, arm64.str_x(1, 31, 8));\n    emit(code, arm64.str_x(2, 31, 16));\n    arm64.assembler_bl(code, \"nativefs_table_ensure\");\n    arm64.assembler_cbz_x(code, 0, \"nativefs_handle_alloc_fail\");\n    mov(code, 9, 0);\n    emit(code, arm64.movz_x(10, 0, 0));\n    bits(code, 13, 4096);\n    arm64.assembler_label(code, \"nativefs_handle_alloc_scan\");\n    emit(code, arm64.lsl_x(11, 10, 7));\n    emit(code, arm64.add_x(11, 9, 11));\n    emit(code, arm64.ldr_x(12, 11, 16));\n    emit(code, arm64.cmp_imm_x(12, 0, iie));\n    arm64.assembler_b_cond(code, 0, \"nativefs_handle_alloc_found\");\n    emit(code, arm64.add_imm_x(10, 10, 1, iie));\n    emit(code, arm64.cmp_x(10, 13));\n    arm64.assembler_b_cond(code, 3, \"nativefs_handle_alloc_scan\");\n    arm64.assembler_label(code, \"nativefs_handle_alloc_fail\");\n    emit(code, arm64.add_imm_x(31, 31, 32, iie));\n    emit(code, arm64.movz_x(0, 0, 0));\n    leave(code);\n    arm64.assembler_labe