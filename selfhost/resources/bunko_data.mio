t.reactor_signal\"; }\n    moshi (name == \"reactor_ack\") { kaesu \"rt.reactor_ack\"; }\n    kaesu \"\";\n}\n" }; }
waza data_47() -> File { kaesu File { path: "kiso/aot/lowerlinux/runtime_testing.mio", version: "Bunko-v2.1.1", length: 4104, sha256: "d800d233c1018a11a441a2718aba14b8d2f5c3222a70e52db8b921a46a427029", source: "yobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/encoding/mochi\";\n\n// Test images (kiso/testing report channel), Linux side. The failure counter lives at gc_state() + 80.\n// rt.testing_report: rdi = condition, rsi = message string, rdx = 1 for the packet channel.\n// A failed expectation is counted, written to stderr with a newline and, in packet mode, to fd 3 as an\n// 8-byte little-endian length followed by the bytes. It returns normally so that every failure is recorded.\nwaza testing_counter() -> int64 { kaesu gc_state() + 80; }\n\nwaza uses_testing(file: mochi.File) -> bool {\n    kaku at = 0;\n    aida (at < len(file.functions)) {\n        moshi (types.is_testing_report(file.functions[at].name) || types.is_testing_packet(file.functions[at].name)) { kaesu hai; }\n        at = at + 1;\n    }\n    kaesu iie;\n}\n\nwaza uses_testing_packet(file: mochi.File) -> bool {\n    kaku at = 0;\n    aida (at < len(file.functions)) {\n        moshi (types.is_testing_packet(file.functions[at].name)) {\n            kaesu hai;\n        }\n        at = at + 1;\n    }\n    kaesu iie;\n}\n\nwaza emit_testing_runtime(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.testing_report\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.testing_report.done\");\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 32);\n    x86_64.mov_data(code, x86_64.rcx, testing_counter());\n    x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 0);\n    x86_64.add_ri(code, x86_64.rax, 1);\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rsi);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.testing_report.stderr\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsi, 16);\n    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdi, 3);\n    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -16);\n    x86_64.mov_ri(code, x86_64.rdx, 8);\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.syscall(code);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsi, 16);\n    x86_64.add_ri(code, x86_64.rsi, 24);\n    x86_64.mov_ri(code, x86_64.rdi, 3);\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.syscall(code);\n    x86_64.label(code, \"rt.testing_report.stderr\");\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsi, 16);\n    x86_64.add_ri(code, x86_64.rsi, 24);\n    x86_64.mov_ri(code, x86_64.rdi, 2);\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.syscall(code);\n    emit_write_literal(code, \"rt.text.newline\", 1, 2);\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.label(code, \"rt.testing_report.done\");\n    x86_64.ret(code);\n\n    // rt.testing_finish: rdi = 1 when the packet channel is open. Writes the completion marker (all ones) to fd 3 and\n    // exits with status 1 when any expectation failed, else 0.\n    x86_64.label(code, \"rt.testing_finish\");\n    x86_64.sub_ri(code, x86_64.rsp, 16);\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.testing_finish.status\");\n    x86_64.mov_ri(code, x86_64.rax, -1);\n    x86_64.mov_store(code, x86_64.rsp, 0, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdi, 3);\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rsp);\n    x86_64.mov_ri(code, x86_64.rdx, 8);\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.syscall(code);\n    x86_64.label(code, \"rt.testing_finish.status\");\n    x86_64.mov_data(code, x86_64.rcx, testing_counter());\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rcx, 0);\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.mov_ri(code, x86_64.rdi, 0);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.testing_finish.exit\");\n    x86_64.mov_ri(code, x86_64.rdi, 1);\n    x86_64.label(code, \"rt.testing_finish.exit\");\n    x86_64.mov_eax_imm(code, 231);\n    x86_64.syscall(code);\n}\n" }; }
waza data_48() -> File { kaesu File { path: "kiso/aot/lowerlinux/shared.mio", version: "Bunko-v2.1.1", length: 13349, sha256: "9e6021f0907a6e5e06c6ed8c70a6c3b681b896e51b9856606e8bdcbdaa3dd897", source: "yobu \"kiso/aot/cabi\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// Linux x86-64 shared-library lowering (ET_DYN through a linker; this file produces the position-independent code).\n//\n// The program is lowered with the same typed lowering and runtime as a static executable, with three differences:\n//   * the label \"pic\" makes every data-area address a rip-relative `lea` plus a recorded DataRef (x86_64.mov_data),\n//     so the code contains no absolute address and no load-address dependence;\n//   * there is no process entry: every `koukai waza ... export \"symbol\"` function gets a System V AMD64 entry point\n//     (trampoline) that converts register/stack arguments to the Mio calling convention, runs the one-time runtime\n//     initialisation (heap reservation and the module's top-level code) on its first call, and converts the result back;\n//   * the runtime installs no signal handlers and never touches the host's libc.\n// Each shared object owns a private Mio heap and collector state (its zero-filled data area, which is not exported).\n\nkoukai kata SharedExport {\n    symbol: string;\n    offset: int64;\n    size: int64;\n}\n\nkoukai kata SharedLowerResult {\n    bytes: []uint8;\n    error: string;\n    exports: []SharedExport;\n    // Local (non-exported) function symbols for debuggers and profilers: they live in .symtab only, never in .dynsym.\n    locals: []SharedExport;\n    data_refs: []x86_64.DataRef;\n    externals: []x86_64.ExternalCall;\n    bss_size: int64;\n}\n\nwaza shared_failed(message: string) -> SharedLowerResult {\n    kaesu SharedLowerResult { bytes: [], error: message, exports: [], locals: [], data_refs: [], externals: [], bss_size: 0 };\n}\n\n// Exported functions in function-id order, with their validated prototypes. Returns the first problem or \"\".\nwaza shared_check_exports(file: mochi.File) -> string {\n    kaku seen: []string = [];\n    kaku count = 0;\n    kaku index = 0;\n    aida (index < len(file.functions)) {\n        kaku function = file.functions[index];\n        moshi (cabi.is_export(function.name)) {\n            kaku declaration = cabi.export_signature(function.name, function.parameter_count, function.returns_value);\n            moshi (!declaration.valid) { kaesu string.concat(\"E_SHARED_EXPORT invalid export prototype \", function.name); }\n            kaku layout = classify(declaration);\n            moshi (len(function.instructions) == 0) { kaesu string.concat(\"E_SHARED_EXPORT exported function has no body: \", declaration.symbol); }\n            kaku at = 0;\n            aida (at < len(seen)) {\n                moshi (seen[at] == declaration.symbol) { kaesu string.concat(\"E_SHARED_EXPORT duplicate exported symbol \", declaration.symbol); }\n                at = at + 1;\n            }\n            array.push(seen, declaration.symbol);\n            count = count + 1;\n            moshi (layout.stack_slots > 64) { kaesu string.concat(\"E_SHARED_EXPORT too many stack parameters in \", declaration.symbol); }\n        }\n        index = index + 1;\n    }\n    moshi (count == 0) { kaesu \"E_SHARED_EXPORT no exported function: declare one with `koukai waza name(...) -> type export \\\"symbol\\\" { ... }`\"; }\n    kaesu \"\";\n}\n\nwaza export_label(index: int64) -> string { kaesu string.concat(\"shared.export.\", convert.format_int(index)); }\nwaza export_end_label(index: int64) -> string { kaesu string.concat(\"shared.export_end.\", convert.format_int(index)); }\n\n// Bytes at the end of the data area: [0] = initialised flag, [8..32) = a fake initial stack (argc = 0, argv and envp\n// empty) that stands in for the kernel's process stack, which a library does not own.\nwaza shared_state_address(file: mochi.File) -> int64 { kaesu globals_base() + 8 * file.global_count; }\n\n// One System V AMD64 entry point. Entry: arguments in RDI.. / XMM0.. / stack, return address at [rsp].\nwaza emit_shared_export(code: x86_64.Assembler, file: mochi.File, analysis: types.TypeAnalysis, index: int64, declaration: cabi.Signature) -> unit {\n    kaku function = file.functions[index];\n    kaku layout = classify(declaration);\n    kaku registers = integer_registers();\n    x86_64.label(code, export_label(index));\n    // r11 = address of the first stack argument (the entry rsp + 8); no instruction below clobbers it before the spill.\n    x86_64.lea(code, x86_64.r11, x86_64.rsp, 8);\n    // Callee-saved registers of the C ABI. Mio code uses rbx and r12-r15 freely.\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.push_r(code, x86_64.rbx);\n    x86_64.push_r(code, x86_64.r12);\n    x86_64.push_r(code, x86_64.r13);\n    x86_64.push_r(code, x86_64.r14);\n    x86_64.push_r(code, x86_64.r15);\n    // A frame of its own whose saved rbp is 0: the collector's frame chain ends here, so it never walks the host's frames.\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.push_r(code, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    // Arguments, first parameter pushed first: the Mio calling convention. Narrow integers are extended to 64 bits\n    // (the caller only guarantees the low 32 bits), bool is normalised, float32 keeps its bit pattern in the low 32 bits.\n    kaku at = 0;\n    aida (at < len(declaration.parameters)) {\n        kaku place = layout.placements[at];\n        kaku kind = declaration.parameters[at];\n        moshi (place.class == class_memory) { x86_64.mov_load(code, x86_64.rax, x86_64.r11, place.index * 8); }\n        moshi (place.class == class_sse) {\n            moshi (kind == 105) { x86_64.movd_r_xmm(code, x86_64.rax, place.index); }\n            sore { x86_64.movq_r_xmm(code, x86_64.rax, place.index); }\n        }\n        moshi (place.class == class_integer) { x86_64.mov_rr(code, x86_64.rax, registers[place.index]); }\n        moshi (kind == 108) {\n            emit_extend(code, x86_64.rax, 15);\n            x86_64.cmp_ri(code, x86_64.rax, 0);\n            x86_64.setcc_rax(code, x86_64.cc_ne);\n        }\n        moshi (kind != 108 && !is_sse(kind)) { emit_extend(code, x86_64.rax, extension(kind)); }\n        x86_64.push_r(code, x86_64.rax);\n        at = at + 1;\n    }\n    x86_64.call(code, \"shared.init\");\n    // Type inference unifies a call argument with the callee's parameter, so a parameter that the module's own code\n    // treats as nullable (int64?) is a boxed scalar for every caller, this entry point included: box it here, after\n    // the runtime exists. Allocation does not collect, and the callee's frame descriptor roots the box.\n    kaku boxed = 0;\n    aida (boxed < function.parameter_count) {\n        moshi (nullable_scalar(analysis, analysis.locals[index][boxed])) {\n            kaku disp = 8 * (function.parameter_count - 1 - boxed);\n            x86_64.mov_load(code, x86_64.rax, x86_64.rsp, disp);\n            x86_64.call(code, \"rt.box_scalar\");\n            x86_64.mov_store(code, x86_64.rsp, disp, x86_64.rax);\n        }\n        boxed = boxed + 1;\n    }\n    x86_64.call(code, function_label(index));\n    // The collector reads a frame descriptor after every call: this frame holds no references.\n    kaku over = string.concat(\"shared.over.\", convert.format_int(index));\n    x86_64.jmp(code, over);\n    emit_word(code, 0);\n    x86_64.label(code, over);\n    moshi (function.parameter_count > 0) { x86_64.add_ri(code, x86_64.rsp, 8 * function.parameter_count); }\n    // A result the module treats as nullable comes back boxed; the prototype says it is a plain scalar.\n    moshi (function.returns_value) { unbox_node(code, analysis, analysis.returns[index], x86_64.rax); }\n    moshi (declaration.result == 105) { x86_64.movd_xmm_r(code, 0, x86_64.rax); }\n    moshi (declaration.result == 106) { x86_64.movq_xmm_r(code, 0, x86_64.rax); }\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.add_ri(code, x86_64.rsp, 8);\n    x86_64.pop_r(code, x86_64.r15);\n    x86_64.pop_r(code, x86_64.r14);\n    x86_64.pop_r(code, x86_64.r13);\n    x86_64.pop_r(code, x86_64.r12);\n    x86_64.pop_r(code, x86_64.rbx);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n    x86_64.label(code, export_end_label(index));\n}\n\n// shared.init: the first call initialises the runtime and runs the top-level code of every module once; later calls\n// return at once. Single-threaded: concurrent first calls from several threads are not supported.\nwaza emit_shared_init(code: x86_64.Assembler, file: mochi.File, analysis: types.TypeAnalysis, gc_threshold: int64) -> string {\n    x86_64.label(code, \"shared.init\");\n    x86_64.mov_data(code, x86_64.rax, shared_state_address(file));\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 0);\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_e, \"shared.init.first\");\n    x86_64.ret(code);\n    x86_64.label(code, \"shared.init.first\");\n    x86_64.mov_ri(code, x86_64.rcx, 1);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.lea(code, x86_64.rcx, x86_64.rax, 8);\n    x86_64.mov_data(code, x86_64.rdx, initial_sp_cell());\n    x86_64.mov_store(code, x86_64.rdx, 0, x86_64.rcx);\n    x86_64.call(code, \"rt.init\");\n    x86_64.mov_data(code, x86_64.rcx, gc_state());\n    x86_64.mov_ri(code, x86_64.rax, gc_threshold);\n    x86_64.mov_store(code, x86_64.rcx, 16, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rcx, 64, x86_64.rax);\n    // The module top-level code runs in a frame of its own (saved rbp 0), like the main program of an executable.\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.push_r(code, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    kaku problem = emit_block(code, file, analysis, file.instructions, \"main\", -1, 0);\n    moshi (problem != \"\") { kaesu problem; }\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.add_ri(code, x86_64.rsp, 8);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n    kaesu \"\";\n}\n\nkoukai waza compile_shared(file: mochi.File, gc_threshold: int64) -> SharedLowerResult {\n    moshi (mochi.has_win64_c(file)) { kaesu shared_failed(\"E_FFI_TARGET Windows AMD64 C ABI requires windows-amd64\"); }\n    moshi (gc_threshold < 4096) { kaesu shared_failed(\"INVALID_GC_THRESHOLD\"); }\n    moshi (uses_threads(file)) { kaesu shared_failed(\"E_SHARED_UNSUPPORTED OS threads cannot be used inside a shared library\"); }\n    kaku checked = shared_check_exports(file);\n    moshi (checked != \"\") { kaesu shared_failed(checked); }\n    kaku analysis = types.analyze_types(file);\n    kaku code = x86_64.assembler();\n    // Compile-time switches, the same label mechanism as cabi_sysv/darwin_abi: \"pic\" selects rip-relative data\n    // addressing, \"cabi_shared\" enables the Mio -> C bridge for declared C dependencies.\n    x86_64.label(code, \"pic\");\n    kaku has_c = iie;\n    kaku index = 0;\n    aida (index < len(file.functions)) {\n        moshi (cabi.is_external(file.functions[index].name)) { has_c = hai; }\n        index = index + 1;\n    }\n    moshi (has_c) { x86_64.label(code, \"cabi_shared\"); }\n    index = 0;\n    aida (index < len(file.functions)) {\n        kaku function = file.functions[index];\n        moshi (cabi.is_export(function.name)) {\n            emit_shared_export(code, file, analysis, index, cabi.export_signature(function.name, function.parameter_count, function.returns_value));\n        }\n        index = index + 1;\n    }\n    kaku problem = emit_shared_init(code, file, analysis, gc_threshold);\n    moshi (problem != \"\") { kaesu shared_failed(problem); }\n    kaku reached = types.reachable_functions(file);\n    index = 0;\n    aida (index < len(file.functions)) {\n        kaku problem = emit_function(code, file, analysis, index, reached[index]);\n        moshi (problem != \"\") { kaesu shared_failed(problem); }\n        index = index + 1;\n    }\n    x86_64.label(code, \"shared.functions_end\");\n    emit_runtime(code);\n    emit_globals_map(code, file, analysis);\n    emit_string_constants(code, file);\n    kaku assembled = x86_64.assemble_linked(code);\n    moshi (assembled.error != \"\") { kaesu shared_failed(assembled.error); }\n    kaku exports: []SharedExport = [];\n    index = 0;\n    aida (index < len(file.functions)) {\n        kaku function = file.functions[index];\n        moshi (cabi.is_export(function.name)) {\n            kaku declaration = cabi.export_signature(function.name, function.parameter_count, function.returns_value);\n            kaku start = x86_64.label_offset(code, export_label(index));\n            kaku end = x86_64.label_offset(code, export_end_label(index));\n            array.push(exports, SharedExport { symbol: declaration.symbol, offset: start, size: end - start });\n        }\n        index = index + 1;\n    }\n    kaku locals: []SharedExport = [];\n    kaku ends = x86_64.label_offset(code, \"shared.functions_end\");\n    index = 0;\n    aida (index < len(file.functions)) {\n        kaku start = x86_64.label_offset(code, function_label(index));\n        kaku end = ends;\n        moshi (index + 1 < len(file.functions)) { end = x86_64.label_offset(code, function_label(index + 1)); }\n        array.push(locals, SharedExport { symbol: file.functions[index].name, offset: start, size: end - start });\n        index = index + 1;\n    }\n    kaesu SharedLowerResult { bytes: assembled.bytes, error: \"\", exports: exports, locals: locals, data_refs: assembled.data_refs,\n        externals: assembled.externals, bss_size: 8192 + 2097152 + 98304 + 8 * file.global_count + 32 };\n}\n" }; }
waza data_49() -> File { kaesu File { path: "kiso/aot/lowerwin/lowerwin.mio", version: "Bunko-v2.1.1", length: 29041, sha256: "664c7dec3cd5dbecaa74e420f20e5cd41d44a27a16ac2107ed6c976911421db9", source: "yobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/pe\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/encoding/win64c\";\nyobu \"kiso/aot/win64abi\";\nyobu \"kiso/string\";\n\n// Pure Mio Mochi -> Windows AMD64 PE32+ lowering, scalar subset (no heap, no GC).\n//\n// Internal execution model (private to this backend, shared with kiso/aot/lowerlinux): the Mochi operand stack is the\n// native stack; each function has an rbp frame, arguments are pushed by the caller and popped by the caller.\n// The Win64 ABI applies at the Windows API boundary only (rt.write / rt.exit): RSP is realigned to 16 bytes, 32 bytes of\n// shadow space are reserved, the fifth argument has its own slot and only volatile registers carry values across calls.\n// Every emitted function (program functions, entry, runtime routines) is a frame-pointer function with matching\n// RUNTIME_FUNCTION / UNWIND_INFO: push rbp; mov rbp,rsp; [sub rsp,N]; epilogue = lea rsp,[rbp]; pop rbp; ret.\n// Anything outside the supported subset is a compile error: nothing is ignored and there is no VM fallback.\nkoukai kata LowerResult {\n    bytes: []uint8;\n    error: string;\n}\n\nkoukai teisu io_failure_exit = 111;\nwaza failed(message: string) -> LowerResult { kaesu LowerResult { bytes: [], error: message }; }\n\nwaza block_label(prefix: string, offset: int64) -> string {\n    kaesu string.concat(prefix, string.concat(\".\", convert.format_int(offset)));\n}\nwaza function_label(id: int64) -> string { kaesu string.concat(\"fn.\", convert.format_int(id)); }\nwaza string_label(index: int64) -> string { kaesu string.concat(\"str.\", convert.format_int(index)); }\nwaza operand_u16(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset + 1]) * 256 + int64(data[offset + 2]);\n}\n\nwaza constant_value(constant: mochi.Constant) -> int64 {\n    kaku high = int64(constant.bits.high);\n    kaku low = int64(constant.bits.low);\n    kaku tag = int64(constant.tag);\n    moshi (tag == 5) {\n        moshi (low >= 128) {\n            kaesu low - 256;\n        }\n        kaesu low;\n    }\n    moshi (tag == 6) {\n        moshi (low >= 32768) {\n            kaesu low - 65536;\n        }\n        kaesu low;\n    }\n    moshi (tag == 7) {\n        moshi (low >= 2147483648) {\n            kaesu low - 4294967296;\n        }\n        kaesu low;\n    }\n    moshi (tag >= 8) { kaesu low; }\n    moshi (high >= 2147483648) { high = high - 4294967296; }\n    kaesu high * 4294967296 + low;\n}\n\nwaza local_disp(parameters: int64, index: int64) -> int64 {\n    moshi (index < parameters) { kaesu 16 + 8 * (parameters - 1 - index); }\n    kaesu -8 * (index - parameters + 1);\n}\n\n// ---- frames -------------------------------------------------------------------------------------------------------\n\n// Emits label, `push rbp`, `mov rbp,rsp` and optionally `sub rsp,alloc`; returns the start offset.\nwaza open_frame(code: x86_64.Assembler, name: string, alloc: int64) -> int64 {\n    x86_64.label(code, name);\n    kaku begin = len(code.bytes);\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    moshi (alloc > 0) { x86_64.sub_ri(code, x86_64.rsp, alloc); }\n    kaesu begin;\n}\n\n// Prologue byte layout is fixed by the encoder: push rbp = 1, mov rbp,rsp = 3, sub rsp,imm32 = 7.\nwaza close_frame(code: x86_64.Assembler, frames: []pe.FrameFunction, begin: int64, alloc: int64) -> unit {\n    kaku alloc_offset = 0;\n    moshi (alloc > 0) { alloc_offset = 11; }\n    array.push(frames, pe.FrameFunction { begin: begin, end: len(code.bytes), push_offset: 1, set_offset: 4,\n            alloc_offset: alloc_offset, alloc_size: alloc });\n}\n\nwaza emit_epilogue(code: x86_64.Assembler) -> unit {\n    x86_64.lea(code, x86_64.rsp, x86_64.rbp, 0);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n}\n\n// mov r11, <IAT slot VA> ; call [r11]. The VA is patched by the PE writer and registered as a DIR64 relocation.\nwaza import_call(code: x86_64.Assembler, patches: []pe.Patch, index: int64) -> unit {\n    kaku at = len(code.bytes);\n    x86_64.mov_ri(code, x86_64.r11, 0);\n    array.push(patches, pe.Patch {\n            section: pe.text_section, offset: at + 2, kind: pe.va64, target: pe.import_section, target_offset: index });\n    x86_64.call_memory(code, x86_64.r11, 0);\n}\n\n// Address of the 64-bit global slot in rcx.\nwaza global_address(code: x86_64.Assembler, patches: []pe.Patch, slot: int64) -> unit {\n    kaku at = len(code.bytes);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    array.push(patches, pe.Patch {\n            section: pe.text_section, offset: at + 2, kind: pe.va64, target: pe.data_section, target_offset: slot * 8 });\n}\n\n// ---- runtime routines (Win64 boundary) -----------------------------------------------------------------------------\n\n// rt.exit: rcx = status. Never returns.\nwaza emit_exit(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction) -> unit {\n    kaku begin = open_frame(code, \"rt.exit\", 0);\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    x86_64.sub_ri(code, x86_64.rsp, 32);\n    import_call(code, patches, 2);\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 0);\n}\n\n// rt.write: rcx = fd (1 or 2), rdx = pointer, r8 = length. Writes all bytes to the inherited synchronous handle.\n// Any GetStdHandle / WriteFile failure, zero progress or oversized count exits with 111 (never succeeds silently).\n// Frame after realignment: [0,32) shadow, +32 fifth argument, +40 bytes written, +48 handle, +56 cursor, +64 remaining.\nwaza emit_write(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction) -> unit {\n    kaku begin = open_frame(code, \"rt.write\", 0);\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    x86_64.sub_ri(code, x86_64.rsp, 80);\n    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rsp, 64, x86_64.r8);\n    x86_64.cmp_ri(code, x86_64.rcx, 1);\n    x86_64.mov_ri(code, x86_64.rcx, 4294967285);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.handle\");\n    x86_64.mov_ri(code, x86_64.rcx, 4294967284);\n    x86_64.label(code, \"rt.write.handle\");\n    import_call(code, patches, 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.cmp_ri(code, x86_64.rax, -1);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.mov_store(code, x86_64.rsp, 48, x86_64.rax);\n    x86_64.label(code, \"rt.write.again\");\n    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 64);\n    x86_64.test_rr(code, x86_64.r8, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.done\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 48);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 56);\n    x86_64.lea(code, x86_64.r9, x86_64.rsp, 40);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rsp, 40, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rax);\n    import_call(code, patches, 1);\n    x86_64.zero_extend_eax(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 40);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 64);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.write.failure\");\n    x86_64.sub_rr(code, x86_64.r8, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 64, x86_64.r8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 56);\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rdx);\n    x86_64.jmp(code, \"rt.write.again\");\n    x86_64.label(code, \"rt.write.done\");\n    emit_epilogue(code);\n    x86_64.label(code, \"rt.write.failure\");\n    x86_64.mov_ri(code, x86_64.rcx, io_failure_exit);\n    x86_64.call(code, \"rt.exit\");\n    close_frame(code, frames, begin, 0);\n}\n\n// rt.print_int: value in rax; decimal text and \"\\n\" to stdout.\nwaza emit_print_int(code: x86_64.Assembler, frames: []pe.FrameFunction) -> unit {\n    kaku begin = open_frame(code, \"rt.print_int\", 64);\n    x86_64.mov_ri(code, x86_64.r9, 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ge, \"rt.print_int.positive\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.r9, 1);\n    x86_64.label(code, \"rt.print_int.positive\");\n    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -1);\n    x86_64.mov_ri(code, x86_64.rdx, 10);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.r8, 10);\n    x86_64.label(code, \"rt.print_int.digit\");\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.div_r(code, x86_64.r8);\n    x86_64.add_ri(code, x86_64.rdx, 48);\n    x86_64.sub_ri(code, x86_64.rsi, 1);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.print_int.digit\");\n    x86_64.test_rr(code, x86_64.r9, x86_64.r9);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.print_int.write\");\n    x86_64.mov_ri(code, x86_64.rdx, 45);\n    x86_64.sub_ri(code, x86_64.rsi, 1);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.label(code, \"rt.print_int.write\");\n    x86_64.lea(code, x86_64.r8, x86_64.rbp, 0);\n    x86_64.sub_rr(code, x86_64.r8, x86_64.rsi);\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rsi);\n    x86_64.mov_ri(code, x86_64.rcx, 1);\n    x86_64.call(code, \"rt.write\");\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 64);\n}\n\n// rt.write_text: rdx = label address, r8 = length -> stdout.\nwaza emit_write_literal(code: x86_64.Assembler, label: string, length: int64, fd: int64) -> unit {\n    x86_64.lea_label(code, x86_64.rdx, label);\n    x86_64.mov_ri(code, x86_64.r8, length);\n    x86_64.mov_ri(code, x86_64.rcx, fd);\n    x86_64.call(code, \"rt.write\");\n}\n\nwaza emit_print_bool(code: x86_64.Assembler, frames: []pe.FrameFunction) -> unit {\n    kaku begin = open_frame(code, \"rt.print_bool\", 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.print_bool.false\");\n    emit_write_literal(code, \"rt.text.true\", 4, 1);\n    emit_epilogue(code);\n    x86_64.label(code, \"rt.print_bool.false\");\n    emit_write_literal(code, \"rt.text.false\", 4, 1);\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 0);\n}\n\n// rt.print_string: rax = string object (header 16, length at 16, bytes at 24) -> text and \"\\n\" on stdout.\nwaza emit_print_string(code: x86_64.Assembler, frames: []pe.FrameFunction) -> unit {\n    kaku begin = open_frame(code, \"rt.print_string\", 0);\n    x86_64.mov_load(code, x86_64.r8, x86_64.rax, 16);\n    x86_64.lea(code, x86_64.rdx, x86_64.rax, 24);\n    x86_64.mov_ri(code, x86_64.rcx, 1);\n    x86_64.call(code, \"rt.write\");\n    emit_write_literal(code, \"rt.text.newline\", 1, 1);\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 0);\n}\n\nwaza emit_trap(code: x86_64.Assembler, frames: []pe.FrameFunction, label: string, text: string, length: int64) -> unit {\n    kaku begin = open_frame(code, label, 0);\n    emit_write_literal(code, text, length, 2);\n    x86_64.mov_ri(code, x86_64.rcx, 1);\n    x86_64.call(code, \"rt.exit\");\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 0);\n}\n\nwaza data_string(code: x86_64.Assembler, label: string, text: string) -> unit {\n    x86_64.label(code, label);\n    kaku bytes = string.to_bytes(text);\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        x86_64.byte(code, int64(bytes[at]));\n        at = at + 1;\n    }\n}\n\nwaza emit_runtime(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction) -> unit {\n    emit_exit(code, patches, frames);\n    emit_write(code, patches, frames);\n    emit_print_int(code, frames);\n    emit_print_bool(code, frames);\n    emit_print_string(code, frames);\n    emit_trap(code, frames, \"rt.trap.divide\", \"rt.text.divide\", 32);\n    emit_trap(code, frames, \"rt.trap.unreachable\", \"rt.text.unreachable\", 35);\n    data_string(code, \"rt.text.true\", \"hai\\n\");\n    data_string(code, \"rt.text.false\", \"iie\\n\");\n    data_string(code, \"rt.text.newline\", \"\\n\");\n    data_string(code, \"rt.text.divide\", \"runtime error: division by zero\\n\");\n    data_string(code, \"rt.text.unreachable\", \"runtime error: unreachable code\\n\");\n}\n\nwaza emit_word(code: x86_64.Assembler, value: int64) -> unit {\n    kaku rest = value;\n    kaku at = 0;\n    aida (at < 8) {\n        x86_64.byte(code, rest - (rest / 256) * 256);\n        rest = rest / 256;\n        at = at + 1;\n    }\n}\n\n// Constant strings are immutable string objects in .text (kind 6 | size << 8, gc word, length, bytes); no heap, no GC.\nwaza emit_string_constants(code: x86_64.Assembler, file: mochi.File) -> unit {\n    kaku index = 0;\n    aida (index < len(file.constants)) {\n        kaku constant = file.constants[index];\n        moshi (int64(constant.tag) == 2) {\n            x86_64.label(code, string_label(index));\n            emit_word(code, 6 + 256 * (24 + len(constant.data)));\n            emit_word(code, 0);\n            emit_word(code, len(constant.data));\n            kaku at = 0;\n            aida (at < len(constant.data)) {\n                x86_64.byte(code, int64(constant.data[at]));\n                at = at + 1;\n            }\n        }\n        index = index + 1;\n    }\n}\n\n// ---- instruction selection ------------------------------------------------------------------------------------------\n\nwaza condition_for(opcode: int64) -> int64 {\n    moshi (opcode == 11) { kaesu x86_64.cc_e; }\n    moshi (opcode == 12) { kaesu x86_64.cc_ne; }\n    moshi (opcode == 13) { kaesu x86_64.cc_l; }\n    moshi (opcode == 14) { kaesu x86_64.cc_le; }\n    moshi (opcode == 15) { kaesu x86_64.cc_g; }\n    kaesu x86_64.cc_ge;\n}\n\nwaza supported(opcode: int64) -> bool {\n    kaesu (opcode >= 1 && opcode <= 20) || opcode == 22 || opcode == 23 || opcode == 24 || opcode == 25 || opcode == 26 || opcode == 27 || opcode == 49;\n}\n\nwaza stack_node(analysis: types.TypeAnalysis, function_id: int64, offset: int64, depth: int64) -> int64 {\n    kaku entries = analysis.blocks[function_id + 1].entry[offset];\n    moshi (depth >= len(entries)) { kaesu -1; }\n    kaesu entries[len(entries) - 1 - depth];\n}\n\n// Integer/bool values are raw 64-bit slots. Nullable values would be boxed objects and floats need SSE: both are rejected.\nwaza scalar_operand(analysis: types.TypeAnalysis, node: int64, allow_bool: bool) -> string {\n    moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n    kaku kind = types.type_kind(analysis, node);\n    moshi (types.type_nullable(analysis, node)) { kaesu \"UNSUPPORTED_NULLABLE\"; }\n    moshi (kind == types.type_integer) { kaesu \"\"; }\n    moshi (kind == types.type_bool && allow_bool) { kaesu \"\"; }\n    kaesu string.concat(\"UNSUPPORTED_OPERAND_TYPE \", convert.format_int(kind));\n}\n\nwaza emit_normalize(code: x86_64.Assembler, descriptor: int64) -> unit {\n    moshi (descriptor < 12 || descriptor > 17) { kaesu; }\n    kaku width = 8;\n    moshi (descriptor == 13 || descriptor == 16) { width = 16; }\n    moshi (descriptor == 14 || descriptor == 17) { width = 32; }\n    x86_64.shl_ri(code, x86_64.rax, 64 - width);\n    moshi (descriptor <= 14) { x86_64.sar_ri(code, x86_64.rax, 64 - width); }\n    moshi (descriptor > 14) { x86_64.shr_ri(code, x86_64.rax, 64 - width); }\n}\n\n// \"$mma::mio/os/runtime::exit:...\" -> \"exit\"; \"\" for every other body-less function.\nwaza native_exit(name: string) -> bool {\n    kaku prefix = \"$mma::mio/os/runtime::exit\";\n    moshi (!string.has_prefix(name, prefix)) { kaesu iie; }\n    kaku bytes = string.to_bytes(name);\n    kaku at = string.byte_len(prefix);\n    kaesu at == len(bytes) || bytes[at] == uint8(58);\n}\n\nwaza emit_block(code: x86_64.Assembler, patches: []pe.Patch, file: mochi.File, analysis: types.TypeAnalysis, data: []uint8,\n    prefix: string, function_id: int64, parameters: int64) -> string {\n    kaku offset = 0;\n    aida (offset < len(data)) {\n        x86_64.label(code, block_label(prefix, offset));\n        kaku opcode = int64(data[offset]);\n        moshi (!supported(opcode)) { kaesu string.concat(\"UNSUPPORTED_OPCODE \", convert.format_int(opcode)); }\n        kaku step = types.type_instruction_width(opcode);\n        moshi (step == 0) { kaesu string.concat(\"UNSUPPORTED_OPCODE \", convert.format_int(opcode)); }\n        moshi (offset + step > len(data)) { kaesu \"TRUNCATED_INSTRUCTION\"; }\n        kaku operand = 0;\n        moshi (step >= 3) { operand = operand_u16(data, offset); }\n        moshi (offset >= len(analysis.blocks[function_id + 1].entry)) { kaesu \"MISSING_TYPE_INFO\"; }\n        moshi (opcode == 1) {\n            moshi (operand >= len(file.constants)) { kaesu \"INVALID_CONSTANT_INDEX\"; }\n            kaku constant = file.constants[operand];\n            kaku tag = int64(constant.tag);\n            moshi (tag == 2) { x86_64.lea_label(code, x86_64.rax, string_label(operand)); }\n            moshi (tag == 1 || (tag >= 5 && tag <= 10)) { x86_64.mov_ri(code, x86_64.rax, constant_value(constant)); }\n            moshi (tag != 1 && tag != 2 && !(tag >= 5 && tag <= 10)) {\n                kaesu string.concat(\"UNSUPPORTED_CONSTANT_TAG \", convert.format_int(tag));\n            }\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode == 2 || opcode == 4 || opcode == 5 || opcode == 6) {\n            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), iie);\n            moshi (bad == \"\") { bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 1), iie); }\n            moshi (bad != \"\") { kaesu bad; }\n            x86_64.pop_r(code, x86_64.rcx);\n            x86_64.pop_r(code, x86_64.rax);\n            moshi (opcode == 2) { x86_64.add_rr(code, x86_64.rax, x86_64.rcx); }\n            moshi (opcode == 4) { x86_64.sub_rr(code, x86_64.rax, x86_64.rcx); }\n            moshi (opcode == 5) { x86_64.imul_rr(code, x86_64.rax, x86_64.rcx); }\n            moshi (opcode == 6) {\n                kaku done = block_label(string.concat(prefix, \".div\"), offset);\n                kaku wrapped = block_label(string.concat(prefix, \".neg\"), offset);\n                x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n                x86_64.jcc(code, x86_64.cc_e, \"rt.trap.divide\");\n                x86_64.mov_ri(code, x86_64.rdx, -1);\n                x86_64.cmp_rr(code, x86_64.rcx, x86_64.rdx);\n                x86_64.jcc(code, x86_64.cc_e, wrapped);\n                x86_64.cqo(code);\n                x86_64.idiv_r(code, x86_64.rcx);\n                x86_64.jmp(code, done);\n                x86_64.label(code, wrapped);\n                x86_64.neg_r(code, x86_64.rax);\n                x86_64.label(code, done);\n            }\n            emit_normalize(code, types.integer_descriptor(analysis, stack_node(analysis, function_id, offset, 0)));\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode == 3) { x86_64.pop_r(code, x86_64.rax); }\n        moshi (opcode == 7) {\n            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), iie);\n            moshi (bad != \"\") { kaesu bad; }\n            x86_64.pop_r(code, x86_64.rax);\n            x86_64.neg_r(code, x86_64.rax);\n            emit_normalize(code, types.integer_descriptor(analysis, stack_node(analysis, function_id, offset, 0)));\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode == 8 || opcode == 9) {\n            x86_64.mov_ri(code, x86_64.rax, 9 - opcode);\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode == 10) {\n            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), hai);\n            moshi (bad != \"\") { kaesu bad; }\n            x86_64.pop_r(code, x86_64.rax);\n            x86_64.mov_ri(code, x86_64.rcx, 1);\n            x86_64.xor_rr(code, x86_64.rax, x86_64.rcx);\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode >= 11 && opcode <= 16) {\n            kaku equality = opcode <= 12;\n            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), equality);\n            moshi (bad == \"\") { bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 1), equality); }\n            moshi (bad != \"\") { kaesu bad; }\n            x86_64.pop_r(code, x86_64.rcx);\n            x86_64.pop_r(code, x86_64.rax);\n            x86_64.cmp_rr(code, x86_64.rax, x86_64.rcx);\n            x86_64.setcc_rax(code, condition_for(opcode));\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode == 17) { x86_64.jmp(code, block_label(prefix, operand)); }\n        moshi (opcode == 18) {\n            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), hai);\n            moshi (bad != \"\") { kaesu bad; }\n            x86_64.pop_r(code, x86_64.rax);\n            x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n            x86_64.jcc(code, x86_64.cc_e, block_label(prefix, operand));\n        }\n        moshi (opcode == 19 || opcode == 20) {\n            moshi (operand >= file.global_count) { kaesu \"INVALID_GLOBAL_INDEX\"; }\n            kaku node = analysis.globals[operand];\n            moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n            moshi (types.type_nullable(analysis, node)) { kaesu \"UNSUPPORTED_NULLABLE\"; }\n            kaku kind = types.type_kind(analysis, node);\n            moshi (kind != types.type_integer && kind != types.type_bool && kind != types.type_string_id) {\n                kaesu string.concat(\"UNSUPPORTED_GLOBAL_TYPE \", convert.format_int(kind));\n            }\n            global_address(code, patches, operand);\n            moshi (opcode == 19) {\n                x86_64.pop_r(code, x86_64.rax);\n                x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rax);\n            }\n            moshi (opcode == 20) {\n                x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 0);\n                x86_64.push_r(code, x86_64.rax);\n            }\n        }\n        moshi (opcode == 22) {\n            kaku node = stack_node(analysis, function_id, offset, 0);\n            moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n            kaku kind = types.type_kind(analysis, node);\n            moshi (types.type_nullable(analysis, node) || (kind != types.type_integer && kind != types.type_bool && kind != types.type_string_id)) {\n                kaesu string.concat(\"UNSUPPORTED_CHANT_TYPE \", convert.format_int(kind));\n            }\n            x86_64.pop_r(code, x86_64.rax);\n            moshi (kind == types.type_integer) { x86_64.call(code, \"rt.print_int\"); }\n            moshi (kind == types.type_bool) { x86_64.call(code, \"rt.print_bool\"); }\n            moshi (kind == types.type_string_id) { x86_64.call(code, \"rt.print_string\"); }\n        }\n        moshi (opcode == 23 || opcode == 24 || opcode == 49) {\n            moshi (function_id < 0) { kaesu \"LOCAL_OUTSIDE_FUNCTION\"; }\n            moshi (operand >= file.functions[function_id].local_count) { kaesu \"INVALID_LOCAL_INDEX\"; }\n            kaku node = analysis.locals[function_id][operand];\n            moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n            moshi (types.type_nullable(analysis, node)) { kaesu \"UNSUPPORTED_NULLABLE\"; }\n            kaku kind = types.type_kind(analysis, node);\n            moshi (kind != types.type_integer && kind != types.type_bool && kind != types.type_string_id) {\n                kaesu string.concat(\"UNSUPPORTED_LOCAL_TYPE \", convert.format_int(kind));\n            }\n            kaku disp = local_disp(parameters, operand);\n            moshi (opcode == 24) {\n                x86_64.mov_load(code, x86_64.rax, x86_64.rbp, disp);\n                x86_64.push_r(code, x86_64.rax);\n            }\n            moshi (opcode != 24) {\n                x86_64.pop_r(code, x86_64.rax);\n                x86_64.mov_store(code, x86_64.rbp, disp, x86_64.rax);\n            }\n        }\n        moshi (opcode == 25) {\n            moshi (operand >= len(file.functions)) { kaesu \"INVALID_FUNCTION_INDEX\"; }\n            kaku callee = file.functions[operand];\n            kaku argument = 0;\n            aida (argument < callee.parameter_count) {\n                kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, argument), hai);\n                moshi (bad != \"\" && types.type_kind(analysis, stack_node(analysis, function_id, offset, argument)) != types.type_string_id) {\n                    kaesu bad;\n                }\n                argument = argument + 1;\n            }\n            x86_64.call(code, function_label(operand));\n            moshi (callee.parameter_count > 0) { x86_64.add_ri(code, x86_64.rsp, 8 * callee.parameter_count); }\n            moshi (callee.returns_value) { x86_64.push_r(code, x86_64.rax); }\n        }\n        moshi (opcode == 26 || opcode == 27) {\n            moshi (function_id < 0) { kaesu \"RETURN_OUTSIDE_FUNCTION\"; }\n            moshi (opcode == 27) { x86_64.pop_r(code, x86_64.rax); }\n            emit_epilogue(code);\n        }\n        offset = offset + step;\n    }\n    x86_64.label(code, block_label(prefix, offset));\n    kaesu \"\";\n}\n\nwaza emit_function(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction, file: mochi.File,\n    analysis: types.TypeAnalysis, index: int64, reachable: bool, import_slot: int64) -> string {\n    kaku function = file.functions[index];\n    moshi (!reachable) {\n        kaku begin = open_frame(code, function_label(index), 0);\n        x86_64.call(code, \"rt.trap.unreachable\");\n        emit_epilogue(code);\n        close_frame(code, frames, begin, 0);\n        kaesu \"\";\n    }\n    moshi (len(function.captures) != 0) { kaesu string.concat(function.name, \": UNSUPPORTED_CLOSURE\"); }\n    moshi (win64c.is_external(function.name)) { win64abi.emit(code, patches, frames, function, function_label(index), import_slot); kaesu \"\"; }\n    moshi (len(function.instructions) == 0) {\n        moshi (!native_exit(function.name) || function.parameter_count != 1 || function.returns_value) {\n            kaesu string.concat(\"UNSUPPORTED_NATIVE_FUNCTION \", function.name);\n        }\n        kaku begin = open_frame(code, function_label(index), 0);\n        x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, local_disp(1, 0));\n        x86_64.call(code, \"rt.exit\");\n        emit_epilogue(code);\n        close_frame(code, frames, begin, 0);\n        kaesu \"\";\n    }\n    kaku locals = function.local_count - function.parameter_count;\n    moshi (locals < 0) { kaesu \"INVALID_LOCAL_COUNT\"; }\n    kaku cell = 0;\n    aida (cell < len(analysis.cells[index])) {\n        moshi (analysis.cells[index][cell]) { kaesu string.concat(function.name, \": UNSUPPORTED_CAPTURED_LOCAL\"); }\n        cell = cell + 1;\n    }\n    kaku alloc = 8 * locals;\n    kaku begin = open_frame(code, function_label(index), alloc);\n    moshi (locals > 0) {\n        x86_64.mov_ri(code, x86_64.rax, 0);\n        kaku slot = 0;\n        aida (slot < locals) {\n            x86_64.mov_store(code, x86_64.rbp, -8 * (slot + 1), x86_64.rax);\n            slot = slot + 1;\n        }\n    }\n    kaku body = emit_block(code, patches, file, analysis, function.instructions, string.concat(\"f\", convert.format_int(index)), index, function.parameter_count);\n    moshi (body != \"\") { kaesu string.concat(function.name, string.concat(\": \", body)); }\n    emit_epilogue(code);\n    close_frame(code, frames, begin, alloc);\n    kaesu \"\";\n}\n\nkoukai waza compile(file: mochi.File) -> LowerResult {\n    kaku reached = types.reachable_functions(file);\n    kaku plan = win64abi.imports(file, reached, [pe.ImportLibrary { name: \"KERNEL32.dll\", symbols: [\"GetStdHandle\", \"WriteFile\", \"ExitProcess\"] }]);\n    moshi (plan.error != \"\") { kaesu failed(plan.error); }\n    kaku analysis = types.analyze_types(file);\n    kaku code = x86_64.assembler();\n    kaku patches: []pe.Patch = [];\n    kaku frames: []pe.FrameFunction = [];\n    // Entry (PE AddressOfEntryPoint = 0): the loader enters with RSP = 8 mod 16; the program body is a framed function.\n    kaku begin = open_frame(code, \"start\", 0);\n    kaku problem = emit_block(code, patches, file, analysis, file.instructions, \"main\", -1, 0);\n    moshi (problem != \"\") { kaesu failed(string.concat(\"main: \", problem)); }\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.call(code, \"rt.exit\");\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 0);\n    kaku index = 0;\n    aida (index < len(file.functions)) {\n        kaku failure = emit_function(code, patches, frames, file, analysis, index, reached[index], plan.slots[index]);\n        moshi (failure != \"\") { kaesu failed(failure); }\n        index = index + 1;\n    }\n    emit_runtime(code, patches, frames);\n    emit_string_constants(code, file);\n    kaku assembled = x86_64.assemble(code);\n    moshi (assembled.error != \"\") { kaesu failed(assembled.error); }\n    win64abi.patch_imports(plan, patches);\n    kaku image = pe.executable_framed(pe.ImageSpec { text: assembled.bytes, rdata: [], data: [], zero_fill: 8 * file.global_count, entry: 0,\n            imports: plan.libraries,\n            patches: patches, unwind: [] }, frames);\n    moshi (image.error != mu) { kaesu failed(\"PE_IMAGE_ERROR\"); }\n    kaesu LowerResult { bytes: image.bytes, error: \"\" };\n}\n" }; }
waza data_50() -> File { kaesu File { path: "kiso/aot/lowerwinrt/gc.mio", version: "Bunko-v2.1.1", length: 26183, sha256: "e317a95fcee196fbc22a813f5cec19ae949be46b14c858b21c941cb4bb2f07e1", source: "yobu \"kiso/aot/pe\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// Runtime ABI RA-1 layout profile \"x64-marksweep-v1\" (kiso/runtime/abi, docs/runtime-abi.md): two-word header,\n// sizes rounded to 8-byte granules (so objects are 8-byte aligned), no generations, no large-object space.\nkoukai teisu object_layout_profile = 2;\nkoukai teisu object_header_bytes = 16;\nkoukai teisu object_size_granule = 8;\n\n// Precise, non-moving, stop-the-world mark & sweep collector for the single-threaded Linux backend.\n//\n// Object header: [0] = kind | total_bytes << 8 (kind 0 = free block), [8] = mark word.\n// Roots: Mochi globals (rt.globals_map) and every frame of the rbp chain. The collector runs only at poll\n// points (function entry, loop back-edges); each call/poll site is followed by `jmp over; descriptor; over:`\n// where the descriptor lists the rbp-relative slots of that frame that hold references, so a frame is scanned\n// from its return address alone. No collection happens inside runtime routines, so their temporaries need no roots.\n//\n// Data segment layout (offsets from data_base()):\n//   0 heap_next, 8 heap_end, 16..1552 unused, 1552.. directory table (64 x 32),\n//   3600.. collector and Win32 state (3704 Winsock started flag), 8192.. directory buffers (64 x 32 KiB), the scratch zone (131072),\n//   the NativeFS handle table (4096 x 24 = 98304), then the Mochi globals.\nwaza gc_state() -> int64 { kaesu data_base() + 3600; }\nkoukai waza directory_buffers() -> int64 { kaesu data_base() + 8192; }\nkoukai waza globals_base() -> int64 { kaesu data_base() + 8192 + 2097152 + 131072 + 98304; }\n// collector state words: +0 free list head, +8 bytes allocated since the last collection, +16 threshold,\n// +24 heap base, +32 mark stack top, +40 mark stack limit, +48 mark stack base, +56 collections, +64 minimum threshold\nwaza gc_base_register() -> int64 { kaesu x86_64.rcx; }\n\n// Free blocks live in segregated lists: one exact-size list per block size 16..512 (bins), and one list for larger\n// blocks (collector state +0). Both are singly linked through word +16 of the free block, pushed at the front.\nwaza bins_base() -> int64 { kaesu data_base() + 4096; }\n\n// rt.alloc: rax = byte size (multiple of 8, at least 16) -> rax = zeroed block. Clobbers rcx, rdx, r8 only.\n// Small requests pop an exact-size bin, or split the first non-empty bin of size >= need + 24; everything else\n// (and every request above 512 bytes) takes the first fitting block of the large list, then falls back to bump allocation.\nwaza emit_gc_alloc(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.alloc\");\n    x86_64.push_r(code, x86_64.r9);\n    x86_64.push_r(code, x86_64.r10);\n    x86_64.mov_ri(code, x86_64.rcx, gc_state());\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 8);\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rcx, 8, x86_64.rdx);\n    x86_64.cmp_ri(code, x86_64.rax, 512);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.alloc.large\");\n    x86_64.mov_ri(code, x86_64.r8, bins_base());\n    x86_64.add_rr(code, x86_64.r8, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.r8, 0);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.bigger\");\n    x86_64.mov_load(code, x86_64.r9, x86_64.rdx, 16);\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.r9);\n    x86_64.jmp(code, \"rt.alloc.zero\");\n    // a bigger bin: its block is split, the remainder (at least 24 bytes) goes back into its own bin\n    x86_64.label(code, \"rt.alloc.bigger\");\n    x86_64.lea(code, x86_64.r10, x86_64.rax, 24);\n    x86_64.label(code, \"rt.alloc.bigger_scan\");\n    x86_64.cmp_ri(code, x86_64.r10, 512);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.alloc.large\");\n    x86_64.mov_ri(code, x86_64.r8, bins_base());\n    x86_64.add_rr(code, x86_64.r8, x86_64.r10);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.r8, 0);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.alloc.bigger_found\");\n    x86_64.add_ri(code, x86_64.r10, 8);\n    x86_64.jmp(code, \"rt.alloc.bigger_scan\");\n    x86_64.label(code, \"rt.alloc.bigger_found\");\n    x86_64.mov_load(code, x86_64.r9, x86_64.rdx, 16);\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.r9);\n    x86_64.sub_rr(code, x86_64.r10, x86_64.rax);\n    x86_64.jmp(code, \"rt.alloc.remainder\");\n    // large list: first block with size == need or size >= need + 24, unlinked; remainder re-inserted\n    x86_64.label(code, \"rt.alloc.large\");\n    x86_64.mov_ri(code, x86_64.rcx, gc_state());\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 0);\n    x86_64.label(code, \"rt.alloc.large_scan\");\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.bump\");\n    x86_64.mov_load(code, x86_64.r10, x86_64.rdx, 0);\n    x86_64.shr_ri(code, x86_64.r10, 8);\n    x86_64.sub_rr(code, x86_64.r10, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.alloc.large_next\");\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.large_take\");\n    x86_64.cmp_ri(code, x86_64.r10, 24);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.alloc.large_next\");\n    x86_64.label(code, \"rt.alloc.large_take\");\n    x86_64.mov_load(code, x86_64.r9, x86_64.rdx, 16);\n    x86_64.cmp_rr(code, x86_64.r8, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.alloc.large_unlink\");\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.r9);\n    x86_64.jmp(code, \"rt.alloc.remainder\");\n    x86_64.label(code, \"rt.alloc.large_unlink\");\n    x86_64.mov_store(code, x86_64.r8, 16, x86_64.r9);\n    x86_64.jmp(code, \"rt.alloc.remainder\");\n    x86_64.label(code, \"rt.alloc.large_next\");\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rdx);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rdx, 16);\n    x86_64.jmp(code, \"rt.alloc.large_scan\");\n    // rdx = the block, r10 = remainder size (0 or >= 24): re-insert the remainder at rdx + need\n    x86_64.label(code, \"rt.alloc.remainder\");\n    x86_64.test_rr(code, x86_64.r10, x86_64.r10);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.zero\");\n    x86_64.lea(code, x86_64.r9, x86_64.rdx, 0);\n    x86_64.add_rr(code, x86_64.r9, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.r10);\n    x86_64.shl_ri(code, x86_64.rcx, 8);\n    x86_64.mov_store(code, x86_64.r9, 0, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.mov_store(code, x86_64.r9, 8, x86_64.rcx);\n    x86_64.cmp_ri(code, x86_64.r10, 512);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.alloc.remainder_large\");\n    x86_64.mov_ri(code, x86_64.r8, bins_base());\n    x86_64.add_rr(code, x86_64.r8, x86_64.r10);\n    x86_64.jmp(code, \"rt.alloc.remainder_push\");\n    x86_64.label(code, \"rt.alloc.remainder_large\");\n    x86_64.mov_ri(code, x86_64.r8, gc_state());\n    x86_64.label(code, \"rt.alloc.remainder_push\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.r8, 0);\n    x86_64.mov_store(code, x86_64.r9, 16, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.r9);\n    x86_64.label(code, \"rt.alloc.zero\");\n    x86_64.mov_rr(code, x86_64.r9, x86_64.rax);\n    x86_64.shr_ri(code, x86_64.r9, 3);\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.label(code, \"rt.alloc.zero_loop\");\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.rcx);\n    x86_64.add_ri(code, x86_64.r8, 8);\n    x86_64.sub_ri(code, x86_64.r9, 1);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.alloc.zero_loop\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.pop_r(code, x86_64.r10);\n    x86_64.pop_r(code, x86_64.r9);\n   