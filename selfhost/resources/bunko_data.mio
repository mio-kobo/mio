waza data_20() -> File { kaesu File { path: "kiso/aot/lower/nativefs/reactor.mio", version: "Bunko-v2.1.1", length: 18741, sha256: "def1b9ad03eef7214de9a63735c6e54b4210c2b254be6541bccb44ecc545a301", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// Darwin AArch64 reactor (group M): kqueue backend of the mio/sys/socket reactor primitives (kiso/reactor). Level-triggered\n// EVFILT_READ / EVFILT_WRITE (no EV_CLEAR). The wake-up descriptor (reactor_open kind 1) is a second kqueue registered with the poll\n// kqueue for EVFILT_READ (a kqueue is readable while it has pending events); reactor_signal triggers an EVFILT_USER event on it and\n// reactor_ack consumes that event. Kernel structure struct kevent (64-bit): ident 0, filter int16 8, flags uint16 10, fflags uint32 12,\n// data int64 16, udata 24 (32 bytes). Syscalls: kqueue 362, kevent 363. Status codes are the shared socket codes; errno values are Darwin's.\n// The same code is emitted for linux-arm64 and windows-arm64, where kqueue/kevent reach the adapters and fail with ENOSYS (status 11,\n// \"unsupported\"): those targets get their own backends in later increments.\n\nwaza rx(code: arm64.Assembler, value: arm64.Instruction) -> unit { emit(code, value); }\nwaza rb(code: arm64.Assembler, target: string) -> unit { arm64.assembler_b(code, target); }\nwaza rc(code: arm64.Assembler, condition: int64, target: string) -> unit { arm64.assembler_b_cond(code, condition, target); }\nwaza rz(code: arm64.Assembler, reg: int64, target: string) -> unit { arm64.assembler_cbz_x(code, reg, target); }\nwaza rnz(code: arm64.Assembler, reg: int64, target: string) -> unit { arm64.assembler_cbnz_x(code, reg, target); }\nwaza rl(code: arm64.Assembler, target: string) -> unit { arm64.assembler_bl(code, target); }\nwaza rlabel(code: arm64.Assembler, name: string) -> unit { arm64.assembler_label(code, name); }\n\n// Looks the token in register x0 up as a socket-table handle; leaves the descriptor in x9 or branches to `closed` (status EBADF).\nwaza lookup_fd(code: arm64.Assembler, closed: string) -> unit {\n    rx(code, arm64.movz_x(1, 3, 0));\n    rl(code, \"nativefs_handle_lookup\");\n    rz(code, 0, closed);\n    rx(code, arm64.ldr_x(9, 0, 0));\n    rx(code, arm64.cmp_imm_x(9, 0, iie));\n    rc(code, 11, closed);\n}\n\nwaza ctl_change(code: arm64.Assembler, filter: int64, subscription: bool) -> unit {\n    rx(code, arm64.ldr_x(0, 31, 24));\n    rx(code, arm64.ldr_x(1, 31, 32));\n    rx(code, arm64.movz_x(2, filter, 0));\n    moshi (subscription) { rx(code, arm64.ldr_x(4, 31, 40)); }\n    sore { rx(code, arm64.movz_x(4, 0, 0)); }\n    rl(code, \"native_reactor_change\");\n}\n\nkoukai waza emit_reactor_runtime(code: arm64.Assembler, empty: int64) -> unit {\n    // ---- reactor_open(kind x0): kind 0 poll kqueue, 1 wake kqueue; any other kind is an invalid argument. Returns a handle token.\n    rlabel(code, \"native_reactor_open\");\n    enter(code);\n    rx(code, arm64.sub_imm_x(31, 31, 32, iie));\n    rx(code, arm64.cmp_imm_x(0, 1, iie));\n    rc(code, 8, \"native_reactor_open_invalid\");\n    rx(code, arm64.movz_x(16, 362, 0));\n    rx(code, arm64.svc(128));\n    rc(code, 2, \"native_reactor_open_error\");\n    mov(code, 1, 0);\n    rx(code, arm64.movz_x(2, 0, 0));\n    rb(code, \"native_reactor_open_alloc\");\n    rlabel(code, \"native_reactor_open_error\");\n    mov(code, 2, 0);\n    rx(code, arm64.movn_x(1, 0, 0));\n    rb(code, \"native_reactor_open_alloc\");\n    rlabel(code, \"native_reactor_open_invalid\");\n    rx(code, arm64.movz_x(2, 22, 0));\n    rx(code, arm64.movn_x(1, 0, 0));\n    rlabel(code, \"native_reactor_open_alloc\");\n    rx(code, arm64.str_x(1, 31, 8));\n    rx(code, arm64.movz_x(0, 3, 0));\n    rl(code, \"nativefs_handle_alloc\");\n    rx(code, arm64.str_x(0, 31, 0));\n    rnz(code, 0, \"native_reactor_open_done\");\n    rx(code, arm64.ldr_x(0, 31, 8));\n    rx(code, arm64.cmp_imm_x(0, 0, iie));\n    rc(code, 11, \"native_reactor_open_done\");\n    rx(code, arm64.movz_x(16, 6, 0));\n    rx(code, arm64.svc(128));\n    rlabel(code, \"native_reactor_open_done\");\n    rx(code, arm64.ldr_x(0, 31, 0));\n    leave(code);\n\n    // ---- change(kq x0, ident x1, filter x2 (1 read, 2 write), flags x3, udata x4) -> errno in x0 (0 ok). A delete of an unregistered\n    // filter (ENOENT) is not an error.\n    rlabel(code, \"native_reactor_change\");\n    enter(code);\n    rx(code, arm64.sub_imm_x(31, 31, 64, iie));\n    rx(code, arm64.str_x(3, 31, 32));\n    rx(code, arm64.str_x(1, 31, 0));\n    rx(code, arm64.movz_x(9, 0, 0));\n    rx(code, arm64.sub_x(9, 9, 2));\n    bits(code, 10, 65535);\n    rx(code, arm64.and_x(9, 9, 10));\n    rx(code, arm64.lsl_x(10, 3, 16));\n    rx(code, arm64.orr_x(9, 9, 10));\n    rx(code, arm64.str_w(9, 31, 8));\n    rx(code, arm64.movz_x(10, 0, 0));\n    rx(code, arm64.str_w(10, 31, 12));\n    rx(code, arm64.str_x(10, 31, 16));\n    rx(code, arm64.str_x(4, 31, 24));\n    rx(code, arm64.add_imm_x(1, 31, 0, iie));\n    rx(code, arm64.movz_x(2, 1, 0));\n    rx(code, arm64.movz_x(3, 0, 0));\n    rx(code, arm64.movz_x(4, 0, 0));\n    rx(code, arm64.movz_x(5, 0, 0));\n    rx(code, arm64.movz_x(16, 363, 0));\n    rx(code, arm64.svc(128));\n    rc(code, 2, \"native_reactor_change_error\");\n    rx(code, arm64.movz_x(0, 0, 0));\n    rb(code, \"native_reactor_change_done\");\n    rlabel(code, \"native_reactor_change_error\");\n    rx(code, arm64.ldr_x(9, 31, 32));\n    rx(code, arm64.movz_x(10, 2, 0));\n    rx(code, arm64.and_x(9, 9, 10));\n    rz(code, 9, \"native_reactor_change_done\");\n    rx(code, arm64.cmp_imm_x(0, 2, iie));\n    rc(code, 1, \"native_reactor_change_done\");\n    rx(code, arm64.movz_x(0, 0, 0));\n    rlabel(code, \"native_reactor_change_done\");\n    leave(code);\n\n    // ---- reactor_ctl(reactor x0, target x1, packed x2 = op | interest << 8 | token << 16, status x3): op 1 add, 2 delete, 3 modify;\n    // interest bit 0 readable (EVFILT_READ), bit 1 writable (EVFILT_WRITE).\n    rlabel(code, \"native_reactor_ctl\");\n    enter(code);\n    rx(code, arm64.sub_imm_x(31, 31, 80, iie));\n    rx(code, arm64.str_x(3, 31, 0));\n    rx(code, arm64.str_x(2, 31, 8));\n    rx(code, arm64.str_x(1, 31, 16));\n    lookup_fd(code, \"native_reactor_ctl_closed\");\n    rx(code, arm64.str_x(9, 31, 24));\n    rx(code, arm64.ldr_x(0, 31, 16));\n    lookup_fd(code, \"native_reactor_ctl_closed\");\n    rx(code, arm64.str_x(9, 31, 32));\n    rx(code, arm64.ldr_x(9, 31, 8));\n    rx(code, arm64.cmp_imm_x(9, 0, iie));\n    rc(code, 11, \"native_reactor_ctl_invalid\");\n    bits(code, 11, 255);\n    rx(code, arm64.and_x(10, 9, 11));\n    rx(code, arm64.sub_imm_x(12, 10, 1, iie));\n    rx(code, arm64.cmp_imm_x(12, 2, iie));\n    rc(code, 8, \"native_reactor_ctl_invalid\");\n    rx(code, arm64.str_x(10, 31, 48));\n    rx(code, arm64.lsr_x(12, 9, 8));\n    rx(code, arm64.and_x(12, 12, 11));\n    rx(code, arm64.cmp_imm_x(12, 3, iie));\n    rc(code, 8, \"native_reactor_ctl_invalid\");\n    rx(code, arm64.str_x(12, 31, 56));\n    rx(code, arm64.lsr_x(13, 9, 16));\n    rx(code, arm64.str_x(13, 31, 40));\n    // Like epoll, one subscription owns both interests on a descriptor. A disabled,\n    // udata-specific read knote with udata 0 reserves the descriptor in this kqueue.\n    // Its key is distinct from delivery knotes and the kernel drops it on fd close.\n    // The Reactor owner serializes changes. Probe without adding or touching delivery knotes.\n    rx(code, arm64.cmp_imm_x(10, 1, iie));\n    rc(code, 1, \"native_reactor_ctl_filters\");\n    rx(code, arm64.movz_x(3, 264, 0)); // EV_DISABLE | EV_UDATA_SPECIFIC\n    ctl_change(code, 1, iie);\n    rz(code, 0, \"native_reactor_ctl_duplicate\");\n    rx(code, arm64.cmp_imm_x(0, 2, iie)); // ENOENT\n    rc(code, 1, \"native_reactor_ctl_status\");\n    rx(code, arm64.movz_x(3, 265, 0)); // EV_ADD | EV_DISABLE | EV_UDATA_SPECIFIC\n    ctl_change(code, 1, iie);\n    rnz(code, 0, \"native_reactor_ctl_status\");\n    rlabel(code, \"native_reactor_ctl_filters\");\n    kaku filter = 1;\n    aida (filter <= 2) {\n        kaku tag = string.concat(\"native_reactor_ctl_f\", convert.format_int(filter));\n        rx(code, arm64.ldr_x(10, 31, 48));\n        rx(code, arm64.cmp_imm_x(10, 2, iie));\n        rc(code, 0, string.concat(tag, \"_delete\"));\n        rx(code, arm64.ldr_x(12, 31, 56));\n        rx(code, arm64.movz_x(11, filter, 0));\n        rx(code, arm64.and_x(13, 12, 11));\n        rnz(code, 13, string.concat(tag, \"_add\"));\n        rx(code, arm64.cmp_imm_x(10, 3, iie));\n        rc(code, 0, string.concat(tag, \"_delete\"));\n        rb(code, string.concat(tag, \"_next\"));\n        rlabel(code, string.concat(tag, \"_add\"));\n        rx(code, arm64.movz_x(3, 5, 0));\n        rb(code, string.concat(tag, \"_call\"));\n        rlabel(code, string.concat(tag, \"_delete\"));\n        rx(code, arm64.movz_x(3, 2, 0));\n        rlabel(code, string.concat(tag, \"_call\"));\n        ctl_change(code, filter, hai);\n        rnz(code, 0, \"native_reactor_ctl_filter_error\");\n        rlabel(code, string.concat(tag, \"_next\"));\n        filter = filter + 1;\n    }\n    rx(code, arm64.ldr_x(10, 31, 48));\n    rx(code, arm64.cmp_imm_x(10, 2, iie));\n    rc(code, 1, \"native_reactor_ctl_ok\");\n    rx(code, arm64.movz_x(3, 258, 0)); // EV_DELETE | EV_UDATA_SPECIFIC\n    ctl_change(code, 1, iie);\n    rb(code, \"native_reactor_ctl_status\");\n    rlabel(code, \"native_reactor_ctl_filter_error\");\n    rx(code, arm64.ldr_x(10, 31, 48));\n    rx(code, arm64.cmp_imm_x(10, 1, iie));\n    rc(code, 1, \"native_reactor_ctl_status\");\n    // A failed ADD can have installed the first filter. Roll back before returning.\n    rx(code, arm64.str_x(0, 31, 64));\n    rx(code, arm64.movz_x(3, 2, 0));\n    ctl_change(code, 1, iie);\n    rx(code, arm64.movz_x(3, 258, 0));\n    ctl_change(code, 1, iie);\n    rx(code, arm64.ldr_x(0, 31, 64));\n    rb(code, \"native_reactor_ctl_status\");\n    rlabel(code, \"native_reactor_ctl_ok\");\n    rx(code, arm64.movz_x(0, 0, 0));\n    rb(code, \"native_reactor_ctl_status\");\n    rlabel(code, \"native_reactor_ctl_duplicate\");\n    rx(code, arm64.movz_x(0, 17, 0)); // EEXIST\n    rb(code, \"native_reactor_ctl_status\");\n    rlabel(code, \"native_reactor_ctl_closed\");\n    rx(code, arm64.movz_x(0, 9, 0));\n    rb(code, \"native_reactor_ctl_status\");\n    rlabel(code, \"native_reactor_ctl_invalid\");\n    rx(code, arm64.movz_x(0, 22, 0));\n    rlabel(code, \"native_reactor_ctl_status\");\n    socket_status_return(code, 0, empty);\n\n    // ---- reactor_wait(reactor x0, events x1, max x2 (1..64), timeout_ms x3 (-1 waits, 0 polls), status x4): 16-byte records\n    // (token, mask: 1 readable, 2 writable, 4 error, 8 hangup) into the events array; the count goes to the status array.\n    // EINTR reports zero events. Frame: 0..63 locals, 64 count, 128.. kernel kevent buffer (64 * 32 bytes).\n    rlabel(code, \"native_reactor_wait\");\n    enter(code);\n    rx(code, arm64.sub_imm_x(31, 31, 2208, iie));\n    rx(code, arm64.str_x(1, 31, 0));\n    rx(code, arm64.str_x(2, 31, 8));\n    rx(code, arm64.str_x(3, 31, 16));\n    rx(code, arm64.str_x(4, 31, 24));\n    lookup_fd(code, \"native_reactor_wait_closed\");\n    rx(code, arm64.str_x(9, 31, 32));\n    rx(code, arm64.ldr_x(9, 31, 8));\n    rx(code, arm64.sub_imm_x(10, 9, 1, iie));\n    rx(code, arm64.cmp_imm_x(10, 63, iie));\n    rc(code, 8, \"native_reactor_wait_invalid\");\n    rx(code, arm64.ldr_x(9, 31, 16));\n    rx(code, arm64.add_imm_x(10, 9, 1, iie));\n    rx(code, arm64.cmp_imm_x(10, 0, iie));\n    rc(code, 11, \"native_reactor_wait_invalid\");\n    bits(code, 11, 2147483647);\n    rx(code, arm64.cmp_x(9, 11));\n    rc(code, 12, \"native_reactor_wait_invalid\");\n    rx(code, arm64.ldr_x(0, 31, 0));\n    rz(code, 0, \"native_reactor_wait_invalid\");\n    rl(code, \"nativefs_array_ptr\");\n    rx(code, arm64.str_x(0, 31, 40));\n    rx(code, arm64.ldr_x(10, 31, 8));\n    rx(code, arm64.lsl_x(10, 10, 4));\n    rx(code, arm64.cmp_x(1, 10));\n    rc(code, 3, \"native_reactor_wait_invalid\");\n    rx(code, arm64.ldr_x(9, 31, 16));\n    rx(code, arm64.cmp_imm_x(9, 0, iie));\n    rc(code, 11, \"native_reactor_wait_infinite\");\n    rx(code, arm64.movz_x(10, 1000, 0));\n    rx(code, arm64.udiv_x(11, 9, 10));\n    rx(code, arm64.msub_x(12, 11, 10, 9));\n    bits(code, 13, 1000000);\n    rx(code, arm64.mul_x(12, 12, 13));\n    rx(code, arm64.str_x(11, 31, 48));\n    rx(code, arm64.str_x(12, 31, 56));\n    rx(code, arm64.add_imm_x(5, 31, 48, iie));\n    rb(code, \"native_reactor_wait_call\");\n    rlabel(code, \"native_reactor_wait_infinite\");\n    rx(code, arm64.movz_x(5, 0, 0));\n    rlabel(code, \"native_reactor_wait_call\");\n    rx(code, arm64.ldr_x(0, 31, 32));\n    rx(code, arm64.movz_x(1, 0, 0));\n    rx(code, arm64.movz_x(2, 0, 0));\n    rx(code, arm64.add_imm_x(3, 31, 128, iie));\n    rx(code, arm64.ldr_x(4, 31, 8));\n    rx(code, arm64.movz_x(16, 363, 0));\n    rx(code, arm64.svc(128));\n    rc(code, 2, \"native_reactor_wait_error\");\n    rx(code, arm64.str_x(0, 31, 64));\n    rx(code, arm64.ldr_x(9, 31, 40));\n    rx(code, arm64.movz_x(10, 0, 0));\n    rx(code, arm64.add_imm_x(11, 31, 128, iie));\n    rlabel(code, \"native_reactor_wait_copy\");\n    rx(code, arm64.ldr_x(12, 31, 64));\n    rx(code, arm64.cmp_x(10, 12));\n    rc(code, 2, \"native_reactor_wait_copied\");\n    rx(code, arm64.ldr_x(13, 11, 24));\n    rx(code, arm64.str_x(13, 9, 0));\n    rx(code, arm64.ldrh_w(14, 11, 8));\n    rx(code, arm64.ldrh_w(15, 11, 10));\n    rx(code, arm64.movz_x(13, 0, 0));\n    rx(code, arm64.movz_x(12, 65535, 0));\n    rx(code, arm64.cmp_x(14, 12));\n    rc(code, 1, \"native_reactor_wait_not_read\");\n    rx(code, arm64.movz_x(12, 1, 0));\n    rx(code, arm64.orr_x(13, 13, 12));\n    rlabel(code, \"native_reactor_wait_not_read\");\n    rx(code, arm64.movz_x(12, 65534, 0));\n    rx(code, arm64.cmp_x(14, 12));\n    rc(code, 1, \"native_reactor_wait_