_64.r9, x86_64.r8, 16);\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.label(code, \"rt.map_set.rehash_bucket\");\n    x86_64.cmp_rr(code, x86_64.rsi, x86_64.r9);\n    x86_64.jcc(code, x86_64.cc_ae, \"rt.map_set.rehash_done\");\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rsi);\n    x86_64.shl_ri(code, x86_64.rdi, 3);\n    x86_64.add_rr(code, x86_64.rdi, x86_64.r8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rdi, 24);\n    x86_64.label(code, \"rt.map_set.rehash_entry\");\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.map_set.rehash_next\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdx, 16);\n    x86_64.mov_store(code, x86_64.rbp, -64, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdx, 40);\n    x86_64.shr_ri(code, x86_64.rcx, 8);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -56);\n    x86_64.sub_ri(code, x86_64.rdi, 1);\n    x86_64.and_rr(code, x86_64.rcx, x86_64.rdi);\n    x86_64.shl_ri(code, x86_64.rcx, 3);\n    x86_64.add_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rcx, 24);\n    x86_64.mov_store(code, x86_64.rdx, 16, x86_64.rdi);\n    x86_64.mov_store(code, x86_64.rcx, 24, x86_64.rdx);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -64);\n    x86_64.jmp(code, \"rt.map_set.rehash_entry\");\n    x86_64.label(code, \"rt.map_set.rehash_next\");\n    x86_64.add_ri(code, x86_64.rsi, 1);\n    x86_64.jmp(code, \"rt.map_set.rehash_bucket\");\n    x86_64.label(code, \"rt.map_set.rehash_done\");\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);\n    x86_64.mov_store(code, x86_64.rdi, 16, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.label(code, \"rt.map_set.link\");\n    x86_64.mov_store(code, x86_64.rbp, -48, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rax, 48);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_ri(code, x86_64.rcx, 48 * 256 + 13);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -16);\n    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -24);\n    x86_64.mov_store(code, x86_64.rax, 32, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -40);\n    x86_64.shl_ri(code, x86_64.rdx, 8);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -32);\n    x86_64.or_rr(code, x86_64.rdx, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rax, 40, x86_64.rdx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -48);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 16);\n    x86_64.sub_ri(code, x86_64.rdx, 1);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -40);\n    x86_64.and_rr(code, x86_64.rdx, x86_64.rsi);\n    x86_64.shl_ri(code, x86_64.rdx, 3);\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rdx, 24);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rdx, 24, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 24);\n    x86_64.add_ri(code, x86_64.rcx, 1);\n    x86_64.mov_store(code, x86_64.rdi, 24, x86_64.rcx);\n    x86_64.label(code, \"rt.map_set.done\");\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n}\n\n// Opcodes 41 (new), 42 (get) and 43 (set). Returns an error name or \"\".\nwaza emit_map_op(code: x86_64.Assembler, analysis: types.TypeAnalysis, function_id: int64, offset: int64, step: int64, opcode: int64) -> string {\n    moshi (opcode == 41) {\n        x86_64.call(code, \"rt.map_new\");\n        push(code, x86_64.rax);\n        kaesu \"\";\n    }\n    kaku key_depth = 0;\n    moshi (opcode == 43) { key_depth = 1; }\n    kaku key_node = stack_node(analysis, function_id, offset, key_depth);\n    moshi (key_node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n    kaku key_kind = types.type_kind(analysis, key_node);\n    moshi (key_kind != types.type_integer && key_kind != types.type_bool && key_kind != types.type_string_id) {\n        kaesu \"UNSUPPORTED_MAP_KEY\";\n    }\n    kaku string_key = 0;\n    moshi (key_kind == types.type_string_id) { string_key = 1; }\n    moshi (opcode == 42) {\n        kaku result_node = stack_node(analysis, function_id, offset + step, 0);\n        kaku missing = block_label(\"map_missing\", len(code.bytes));\n        kaku finished = block_label(\"map_done\", len(code.bytes));\n        pop(code, x86_64.rsi);\n        unbox_node(code, analysis, key_node, x86_64.rsi);\n        pop(code, x86_64.rdi);\n        x86_64.mov_ri(code, x86_64.rdx, string_key);\n        x86_64.call(code, \"rt.map_find\");\n        x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n        x86_64.jcc(code, x86_64.cc_e, missing);\n        moshi (result_node >= 0 && nullable_scalar(analysis, result_node)) {\n            x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 40);\n            x86_64.mov_load(code, x86_64.rax, x86_64.rax, 32);\n            x86_64.and_ri(code, x86_64.rcx, 4);\n            x86_64.jcc(code, x86_64.cc_ne, finished);\n            x86_64.call(code, \"rt.box_scalar\");\n        }\n        sore { x86_64.mov_load(code, x86_64.rax, x86_64.rax, 32); }\n        x86_64.jmp(code, finished);\n        x86_64.label(code, missing);\n        x86_64.mov_ri(code, x86_64.rax, 0);\n        x86_64.label(code, finished);\n        push(code, x86_64.rax);\n        kaesu \"\";\n    }\n    kaku value_node = stack_node(analysis, function_id, offset, 0);\n    moshi (value_node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n    kaku flags = string_key;\n    moshi (is_reference_node(analysis, value_node) && !nullable_scalar(analysis, value_node)) { flags = flags + 2; }\n    kaku nil_literal = types.type_kind(analysis, value_node) == types.type_nil;\n    moshi (nil_literal) { flags = flags + 4; }\n    pop(code, x86_64.rdx);\n    pop(code, x86_64.rsi);\n    unbox_node(code, analysis, key_node, x86_64.rsi);\n    pop(code, x86_64.rdi);\n    x86_64.mov_ri(code, x86_64.rcx, flags);\n    moshi (nullable_scalar(analysis, value_node)) {\n        // A nil box stores raw 0 with the nil bit; a boxed value stores its payload.\n        kaku present = block_label(\"map_value_present\", len(code.bytes));\n        kaku stored = block_label(\"map_value_stored\", len(code.bytes));\n        x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n        x86_64.jcc(code, x86_64.cc_ne, present);\n        x86_64.mov_ri(code, x86_64.rcx, flags + 4);\n        x86_64.jmp(code, stored);\n        x86_64.label(code, present);\n        x86_64.mov_load(code, x86_64.rdx, x86_64.rdx, 16);\n        x86_64.label(code, stored);\n    }\n    x86_64.call(code, \"rt.map_set\");\n    kaesu \"\";\n}\n" }; }
waza data_53() -> File { kaesu File { path: "kiso/aot/lowerwinrt/runtime_fs.mio", version: "Bunko-v2.1.1", length: 38403, sha256: "4fb8914ab1b0ae4ffde011dd8f16d86f8901ab372c6e5f07b36ccc31eece27d6", source: "yobu \"kiso/aot/pe\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// Linux NativeFS bridge for the body-less \"mio/fs/runtime\" functions of kiso/fs.\n// Resource token = generation << 16 | (slot + 1). The 4096-slot handle table lives in the data segment, after the scratch zone (see gc.mio):\n// 3 words per slot: handle, state (0 free, 1 file open, 10 + code file failure, 20 and above socket), generation.\n// Status codes follow kiso/fs: 0 ok, 1 not found, 2 permission, 3 closed, 4 invalid argument, 5 I/O, 6 no space, 7 invalid path.\nwaza handle_table_base() -> int64 { kaesu data_base() + 8192 + 2097152 + 131072; }\nwaza handle_slots() -> int64 { kaesu 4096; }\n// Directory state (the directory table, the find-handle state and the buffers) exists for 64 entries, so directory handles live in slots 0..63.\nwaza directory_slots() -> int64 { kaesu 64; }\n\nwaza emit_string_object(code: x86_64.Assembler, label: string, text: string) -> unit {\n    x86_64.label(code, label);\n    kaku bytes = string.to_bytes(text);\n    kaku size = 24 + len(bytes);\n    size = size + 7 - ((size + 7) - ((size + 7) / 8) * 8);\n    emit_word(code, 256 * size + 6);\n    emit_word(code, 0);\n    emit_word(code, len(bytes));\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        x86_64.byte(code, int64(bytes[at]));\n        at = at + 1;\n    }\n}\n\nwaza message_for(code: int64) -> string {\n    moshi (code == 1) { kaesu \"no such file or directory\"; }\n    moshi (code == 2) { kaesu \"permission denied\"; }\n    moshi (code == 3) { kaesu \"file already closed\"; }\n    moshi (code == 4) { kaesu \"invalid argument\"; }\n    moshi (code == 6) { kaesu \"no space left on device\"; }\n    moshi (code == 7) { kaesu \"invalid path\"; }\n    kaesu \"input/output error\";\n}\n\nwaza message_label(code: int64) -> string { kaesu string.concat(\"rt.fs.message.\", convert.format_int(code)); }\n\nwaza leave_frame(code: x86_64.Assembler) -> unit {\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n}\n\nwaza emit_fs_support(code: x86_64.Assembler) -> unit {\n    // rt.fs_classify: rax = errno -> rax = status code\n    x86_64.label(code, \"rt.fs_classify\");\n    kaku errnos: []int64 = [2, 13, 1, 9, 28, 22];\n    kaku codes: []int64 = [1, 2, 2, 3, 6, 4];\n    kaku at = 0;\n    aida (at < len(errnos)) {\n        kaku next = string.concat(\"rt.fs_classify.next.\", convert.format_int(at));\n        x86_64.cmp_ri(code, x86_64.rax, errnos[at]);\n        x86_64.jcc(code, x86_64.cc_ne, next);\n        x86_64.mov_ri(code, x86_64.rax, codes[at]);\n        x86_64.ret(code);\n        x86_64.label(code, next);\n        at = at + 1;\n    }\n    x86_64.mov_ri(code, x86_64.rax, 5);\n    x86_64.ret(code);\n\n    // rt.fs_message: rax = status code -> rax = message string\n    x86_64.label(code, \"rt.fs_message\");\n    at = 0;\n    aida (at < 8) {\n        kaku next = string.concat(\"rt.fs_message.next.\", convert.format_int(at));\n        x86_64.cmp_ri(code, x86_64.rax, at);\n        x86_64.jcc(code, x86_64.cc_ne, next);\n        x86_64.lea_label(code, x86_64.rax, message_label(at));\n        x86_64.ret(code);\n        x86_64.label(code, next);\n        at = at + 1;\n    }\n    x86_64.lea_label(code, x86_64.rax, message_label(5));\n    x86_64.ret(code);\n\n    // rt.fs_alloc: rdi = fd, rsi = state -> rax = token (0 when the table is full)\n    x86_64.label(code, \"rt.fs_alloc\");\n    x86_64.mov_ri(code, x86_64.r10, handle_slots());\n    x86_64.jmp(code, \"rt.fs_alloc.start\");\n    // rt.fs_alloc_dir: same, but only slots 0..63 (the directory state has 64 entries)\n    x86_64.label(code, \"rt.fs_alloc_dir\");\n    x86_64.mov_ri(code, x86_64.r10, directory_slots());\