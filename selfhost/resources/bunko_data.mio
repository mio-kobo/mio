\n}\n\n// Build the graph in two stages: reachability establishes exact stack depths,\n// then each value-producing position receives a union node.  Successor stacks\n// are joined at bytecode boundaries, so loops and diamonds share the same\n// representation decision.\n// Only locals captured into shared Cells can be rebound by another call.\n// A normal by-value local keeps its non-nil fact across direct/indirect calls.\nwaza type_captured_locals(file: mochi.File, data: []uint8, count: int64) -> []bool {\n    kaku shared = array.make[bool](count, iie); kaku at = 0;\n    aida (at < len(data)) {\n        kaku opcode = int64(data[at]); kaku width = type_instruction_width(opcode);\n        moshi (width <= 0 || width > len(data) - at) { kaesu shared; }\n        moshi (opcode == 46) {\n            kaku target = type_u16(data, at);\n            moshi (target >= 0 && target < len(file.functions)) {\n                kaku captures = file.functions[target].captures; kaku ci = 0;\n                aida (ci < len(captures)) { kaku capture = captures[ci];\n                    moshi (capture.local && capture.index >= 0 && capture.index < count) { shared[capture.index] = hai; } ci = ci + 1;\n                }\n            }\n        }\n        at = at + width;\n    }\n    kaesu shared;\n}\n// Forward must-analysis intersects incoming paths. Stores invalidate their\n// local; calls and Cell writes invalidate potentially shared captured locals.\nwaza type_nonnil_entries(file: mochi.File, data: []uint8, count: int64) -> [][]bool {\n    kaku shared = type_captured_locals(file, data, count);\n    kaku facts = array.with_capacity[[]bool](len(data) + 1); kaku visited = array.make[bool](len(data) + 1, iie);\n    // Unvisited positions share one all-false placeholder: a position's facts are replaced by its own array on its\n    // first visit, and only visited positions are ever updated in place.\n    kaku none = array.make[bool](count, iie);\n    kaku at = 0; aida (at <= len(data)) { arr