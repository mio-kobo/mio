 int64, vn: int64, vm: int64) -> Instruction { kaesu float_binary(509614080, vd, vn, vm); }\nkoukai waza fcmp_d(vn: int64, vm: int64) -> Instruction { kaesu data_register(509616128, 0, vn, vm); }\nkoukai waza scvtf_d(vd: int64, rn: int64) -> Instruction { kaesu data_register(2657222656, vd, rn, 0); }\nkoukai waza fcvtzs_x(rd: int64, vn: int64) -> Instruction { kaesu data_register(2658664448, rd, vn, 0); }\n\nkoukai kata Label {\n    name: string;\n    word: int64;\n}\n// kind: 0=B, 1=BL, 2=B.cond, 3=CBZ, 4=CBNZ. Keeping the discriminator\n// separate from its operand also makes relocation records layout-stable when\n// stored in generic arrays by the current native self-hosted backend.\nkoukai kata Fixup {\n    at_word: int64;\n    target: string;\n    kind: int64;\n    operand: int64;\n}\nkoukai kata Assembler {\n    words: []uint32;\n    labels: []Label;\n    label_index: [][]int64;\n    fixups: []Fixup;\n    errors: []EncodeError;\n}\nkoukai kata AssembleResult {\n    words: []uint32;\n    error: EncodeError?;\n}\n\nkoukai waza assembler() -> Assembler {\n    kaesu Assembler {\n        words: array.with_capacity[uint32](32), labels: array.with_capacity[Label](8), label_index: [array.make[int64](32, 0)], fixups: array.with_capacity[Fixup](8), errors: array.with_capacity[EncodeError](1) };\n}\n\n// Windows ABI mode (label \"windows_abi\") works the same way with the routine windows_syscall (Win32 calls through the IAT).\n// Linux ABI mode (opt-in, chosen by defining the label \"linux_abi\" before any code is emitted): the Darwin system-call\n// instruction SVC #128 (number in x16) becomes `stp x30, xzr, [sp, #-16]!; bl linux_syscall; ldp x30, xzr, [sp], #16`.\n// linux_syscall is a runtime routine that translates the Darwin call into the Linux AArch64 call and restores the Darwin\n// result convention (carry flag set and a positive Darwin errno in x0 on failure). Without the label nothing changes, so\n// Darwin images stay byte-identical.\nkoukai waza assembler_emit(value: Assembler, encoded: Instruction) -> EncodeError? {\n    kaku failure = encoded.error;\n    moshi (failure != mu) {\n        array.push(value.errors, failure);\n        kaesu failure;\n    }\n    moshi (encoded.word == uint32(3556773889)) {\n        kaku adapter = \"\";\n        moshi (find_label(value, \"linux_abi\") >= 0) { adapter = \"linux_syscall\"; }\n        moshi (adapter == \"\" && find_label(value, \"windows_abi\") >= 0) { adapter = \"windows_syscall\"; }\n        moshi (adapter != \"\") {\n            array.push(value.words, stp_pre_x(30, 31, 31, -16).word);\n            kaku called = assembler_fixup(value, adapter, 1, 0);\n            array.push(value.words, ldp_post_x(30, 31, 31, 16).word);\n            kaesu called;\n        }\n    }\n    array.push(value.words, encoded.word);\n    kaesu mu;\n}\n\nwaza label_hash(name: string, capacity: int64) -> int64 {\n    kaku hash = 0;\n    kaku i = 0;\n    kaku data = string.to_bytes(name);\n    aida (i < len(data)) {\n        hash = hash * 131 + int64(data[i]);\n        hash = hash - (hash / capacity) * capacity;\n        i = i + 1;\n    }\n    kaesu hash;\n}\n\nwaza index_label(table: []int64, labels: []Label, index: int64) -> unit {\n    kaku slot = label_hash(labels[index].name, len(table));\n    aida (table[slot] != 0) {\n        slot = slot + 1;\n        moshi (slot == len(table)) {\n            slot = 0;\n        }\n    }\n    table[slot] = index + 1;\n}\n\nwaza find_label(value: Assembler, name: string) -> int64 {\n    kaku table = value.label_index[0];\n    kaku slot = label_hash(name, len(table));\n    kaku probes = 0;\n    aida (probes < len(table)) {\n        kaku index = table[slot] - 1;\n        moshi (index < 0) {\n            kaesu -1;\n        }\n        moshi (value.labels[index].name == name) { kaesu value.labels[index].word; }\n        slot = slot + 1;\n        moshi (slot == len(table)) {\n            slot = 0;\n        }\n        probes = probes + 1;\n    }\n    kaesu -1;\n}\n\nkoukai waza assembler_label(value: Assembler, name: string) -> EncodeError? {\n    moshi (find_label(value, name) >= 0) {\n        kaku failure = EncodeError.DuplicateLabel(name);\n        array.push(value.errors, failure);\n        kaesu failure;\n    }\n    kaku table = value.label_index[0];\n    moshi ((len(value.labels) + 1) * 2 >= len(table)) {\n        table = array.make[int64](len(table) * 2, 0);\n        kaku i = 0;\n        aida (i < len(value.labels)) {\n            index_label(table, value.labels, i);\n            i = i + 1;\n        }\n        value.label_index[0] = table;\n    }\n    array.push(value.labels, Label { name: name, word: len(value.words) });\n    index_label(table, value.labels, len(value.labels) - 1);\n    kaesu mu;\n}\n\nwaza assembler_fixup(value: Assembler, target: string, kind: int64, operand: int64) -> EncodeError? {\n    array.push(value.fixups, Fixup { at_word: len(value.words), target: target, kind: kind, operand: operand });\n    array.push(value.words, uint32(0));\n    // Reserve before any later label or AddressPatch captures a word index.\n    // Short branches retain their original encoding followed by NOP. Far\n    // branches use the inverted condition over B, without touching NZCV or GPRs.\n    moshi (kind >= 2 && kind <= 4) { array.push(value.words, uint32(3573751839)); }\n    kaesu mu;\n}\n\nkoukai waza assembler_b(value: Assembler, target: string) -> EncodeError? { kaesu assembler_fixup(value, target, 0, 0); }\nkoukai waza assembler_bl(value: Assembler, target: string) -> EncodeError? { kaesu assembler_fixup(value, target, 1, 0); }\nkoukai waza assembler_b_cond(value: Assembler, condition: int64, target: string) -> EncodeError? {\n    moshi (condition < 0 || condition > 15) {\n        kaku failure = EncodeError.InvalidCondition();\n        array.push(value.errors, failure);\n        kaesu failure;\n    }\n    kaesu assembler_fixup(value, target, 2, condition);\n}\nkoukai waza assembler_cbz_x(value: Assembler, reg: int64, target: string) -> EncodeError? {\n    kaku failure = register_error(reg);\n    moshi (failure != mu) {\n        array.push(value.errors, failure);\n        kaesu failure;\n    }\n    kaesu assembler_fixup(value, target, 3, reg);\n}\nkoukai waza assembler_cbnz_x(value: Assembler, reg: int64, target: string) -> EncodeError? {\n    kaku failure = register_error(reg);\n    moshi (failure != mu) {\n        array.push(value.errors, failure);\n        kaesu failure;\n    }\n    kaesu assembler_fixup(value, target, 4, reg);\n}\n\nkoukai waza assembler_assemble(value: Assembler) -> AssembleResult {\n    moshi (len(value.errors) > 0) { kaesu AssembleResult { words: [], error: value.errors[0] }; }\n    kaku output = array.clone(value.words);\n    kaku index = 0;\n    aida (index < len(value.fixups)) {\n        kaku fix = value.fixups[index];\n        kaku target = find_label(value, fix.target);\n        moshi (target < 0) { kaesu AssembleResult { words: [], error: EncodeError.UndefinedLabel(fix.target) }; }\n        kaku delta = target - fix.at_word;\n        kaku encoded = b(delta);\n        moshi (fix.kind == 1) { encoded = bl(delta); }\n        moshi (fix.kind == 2) { encoded = b_cond(fix.operand, delta); }\n        moshi (fix.kind == 3) { encoded = cbz_x(fix.operand, delta); }\n        moshi (fix.kind == 4) { encoded = cbnz_x(fix.operand, delta); }\n        moshi (fix.kind < 0 || fix.kind > 4) { kaesu AssembleResult { words: [], error: EncodeError.InvalidPatch() }; }\n        moshi (fix.kind >= 2 && (delta < -262144 || delta > 262143)) {\n            // AL and NV both mean always for B.cond; they are not inverses.\n            moshi (fix.kind == 2 && fix.operand >= 14) { encoded = b(delta); }\n            sore {\n                kaku inverse = fix.operand + 1;\n                moshi (fix.operand - (fix.operand / 2) * 2 == 1) { inverse = fix.operand - 1; }\n                kaku skip = b_cond(inverse, 2);\n                moshi (fix.kind == 3) { skip = cbnz_x(fix.operand, 2); }\n                moshi (fix.kind == 4) { skip = cbz_x(fix.operand, 2); }\n                moshi (skip.error != mu) { kaesu AssembleResult { words: [], error: skip.error }; }\n                // B's PC is the second word, not the conditional branch's PC.\n                kaku jump = b(delta - 1);\n                moshi (jump.error != mu) { kaesu AssembleResult { words: [], error: jump.error }; }\n                output[fix.at_word + 1] = jump.word;\n                encoded = skip;\n            }\n        }\n        kaku failure = encoded.error;\n        moshi (failure != mu) { kaesu AssembleResult { words: [], error: failure }; }\n        output[fix.at_word] = encoded.word;\n        index = index + 1;\n    }\n    kaesu AssembleResult { words: output, error: mu };\n}\n\n// Resolve a label through the assembler index for lowering diagnostics/patches.\nkoukai waza assembler_label_word(value: Assembler, name: string) -> int64 { kaesu find_label(value, name); }\n" }; }
waza data_1() -> File { kaesu File { path: "kiso/aot/arm64/atomic.mio", version: "Bunko-v2.1.1", length: 2783, sha256: "c99410e86b8f4b2734df2b08a4527f4f4b3fa3562c7cf75fc0ced63869945a58", source: "// A64 atomics. Callers of optional LSE instructions must ensure target support.\n// LDAR/STLR provide acquire/release. LL/SC loops live in the CPU adapter.\n// Encodings follow Arm A64 ISA (load/store exclusive and barrier classes).\nkoukai waza read_nzcv(rt: int64) -> Instruction {\n    kaku error = register_error(rt);\n    moshi (error != mu) {\n        kaesu Instruction {\n            word: uint32(0), error: error };\n    }\n    kaesu instruction(3577430528 + rt);\n}\nkoukai waza write_nzcv(rt: int64) -> Instruction {\n    kaku error = register_error(rt);\n    moshi (error != mu) {\n        kaesu Instruction {\n            word: uint32(0), error: error };\n    }\n    kaesu instruction(3575333376 + rt);\n}\nkoukai waza ldar_x(rt: int64, rn: int64) -> Instruction {\n    kaku error = register_error(rt);\n    moshi (error == mu) {\n        error = register_error(rn);\n    }\n    moshi (error != mu) { kaesu Instruction { word: uint32(0), error: error }; }\n    kaesu instruction(3370122240 + rn * 32 + rt);\n}\nkoukai waza stlr_x(rt: int64, rn: int64) -> Instruction {\n    kaku error = register_error(rt);\n    moshi (error == mu) {\n        error = register_error(rn);\n    }\n    moshi (error != mu) { kaesu Instruction { word: uint32(0), error: error }; }\n    kaesu instruction(3365927936 + rn * 32 + rt);\n}\nkoukai waza ldxr_x(rt: int64, rn: int64, acquire: bool) -> Instruction {\n    kaku error = register_error(rt);\n    moshi (error == mu) {\n        error = register_error(rn);\n    }\n    moshi (error != mu) { kaesu Instruction { word: uint32(0), error: error }; }\n    kaku base = 3361700864;\n    moshi (acquire) {\n        base = base + 32768;\n    }\n    kaesu instruction(base + rn * 32 + rt);\n}\nkoukai waza stxr_x(status: int64, rt: int64, rn: int64, release: bool) -> Instruction {\n    kaku error = three_registers(status, rt, rn);\n    // Status may not alias source/base (architecturally unpredictable).\n    moshi (error != mu) { kaesu Instruction { word: uint32(0), error: error }; }\n    moshi (status == rt || (status == rn && rn != 31)) { kaesu Instruction { word: uint32(0), error: EncodeError.InvalidRegister() }; }\n    kaku base = 3355474944;\n    moshi (release) {\n        base = base + 32768;\n    }\n    kaesu instruction(base + status * 65536 + rn * 32 + rt);\n}\nkoukai waza dmb_ish() -> Instruction { kaesu instruction(3573758911); }\nkoukai waza clrex() -> Instruction { kaesu instruction(3573759839); }\n\n// FEAT_LSE exchange with release ordering. Rs may be XZR. Rn is the address\n// (31 denotes SP), and Rt receives the old value.\nkoukai waza swpl_x(rs:int64, rt:int64, rn:int64) -> Instruction {\n    kaku error = three_registers(rs, rt, rn);\n    moshi (error != mu) { kaesu Instruction {word:uint32(0),error:error}; }\n    kaesu instruction(4167073792 + rs * 65536 + rn * 32 + rt);\n}\n" }; }
waza data_2() -> File { kaesu File { path: "kiso/aot/cabi/dynamic.mio", version: "Bunko-v2.1.1", length: 835, sha256: "d26e9642b9c85df8feba4f74b145ee15fc5fd381723ef2aca8cdc56575ba9f01", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// An alias at the same text address describes a compiler-emitted C entry.\n// The symbol name is last so different signatures cannot share a prefix.\nkoukai waza dylib_marker(symbol: string, result: string, parameters: string) -> string {\n    kaesu string.concat(\"mio_ffi_v1_\", string.concat(result, string.concat(parameters, string.concat(\"_\", symbol))));\n}\n\nkoukai waza dylib_signature_marker(signature: Signature) -> string {\n    kaku kinds: []uint8 = [];\n    array.push(kinds, uint8(signature.result));\n    kaku at = 0;\n    aida (at < len(signature.parameters)) {\n        array.push(kinds, uint8(signature.parameters[at]));\n        at = at + 1;\n    }\n    kaku encoded = string.from_utf8(kinds);\n    moshi (encoded == mu) { kaesu \"\"; }\n    kaesu dylib_marker(signature.symbol, encoded, \"\");\n}\n" }; }
waza data_3() -> File { kaesu File { path: "kiso/aot/cabi/signature.mio", version: "Bunko-v2.1.1", length: 5218, sha256: "afca48d508d04c5c52c01ca1dd5c0d5ef8a44d07498e754105d241aa840936bd", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// 空指令体是原生声明在 Mochi 中的既有表示。专用前缀携带固定原型，\n// 普通 Mio 和 MMA 函数都不能使用这一命名空间。\nkoukai teisu prefix = \"$cabi::\";\n// 间接调用的保留符号：第一个参数是目标函数指针（cptr，通常来自 dlsym），其余参数是 C 参数。\nkoukai teisu indirect_symbol = \"mio_ffi_indirect\";\n// 保留 \"require native darwin-arm64\" 这一段措辞：Darwin 回归测试按它匹配跨目标构建的拒绝诊断。\nkoukai teisu target_error = \"E_CABI C ABI declarations require native darwin-arm64 or linux-amd64 on a matching host\";\n\n// 唯一带有 C ABI 后端的目标。其余目标（linux-arm64、darwin-amd64、windows-*）一律在编译期拒绝，\n// 不会退回 Mio 内部调用约定。\nkoukai waza supports_target(target: string) -> bool { kaesu target == \"darwin-arm64\" || target == \"linux-amd64\"; }\n\nkoukai waza is_external(name: string) -> bool { kaesu string.has_prefix(name, prefix); }\n\nkoukai waza valid_symbol(name: string) -> bool {\n    kaku bytes = string.to_bytes(name);\n    moshi (name == \"main\" || len(bytes) == 0 || len(bytes) > 1024) { kaesu iie; }\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        kaku b = int64(bytes[at]);\n        moshi (!(b == 95 || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (at > 0 && b >= 48 && b <= 57))) { kaesu iie; }\n        at = at + 1;\n    }\n    kaesu hai;\n}\n\nkoukai waza valid_export_symbol(name: string) -> bool {\n    kaesu valid_symbol(name) && !string.has_prefix(name, \"mio_ffi_v1_\");\n}\n\nkoukai waza type_code(name: string) -> string {\n    moshi (name == \"unit\") { kaesu \"v\"; }\n    moshi (name == \"int8\") { kaesu \"a\"; }\n    moshi (name == \"uint8\") { kaesu \"b\"; }\n    moshi (name == \"int16\") { kaesu \"c\"; }\n    moshi (name == \"uint16\") { kaesu \"d\"; }\n    moshi (name == \"int32\") { kaesu \"e\"; }\n    moshi (name == \"uint32\") { kaesu \"f\"; }\n    moshi (name == \"int64\") { kaesu \"g\"; }\n    moshi (name == \"uint64\") { kaesu \"h\"; }\n    moshi (name == \"float32\") { kaesu \"i\"; }\n    moshi (name == \"float64\") { kaesu \"j\"; }\n    moshi (name == \"cptr\") { kaesu \"k\"; }\n    moshi (name == \"bool\") { kaesu \"l\"; }\n    kaesu \"\";\n}\n\n// 参数专用代码：[]uint8 传递数据首地址（\"m\"），数组仍归 Mio 所有，指针只在调用期间有效。\nkoukai waza param_code(name: string, element: string) -> string {\n    moshi (name == \"[]\") { moshi (element == \"uint8\") { kaesu \"m\"; } kaesu \"\"; }\n    moshi (element != \"\") { kaesu \"\"; }\n    kaesu type_code(name);\n}\n\nkoukai kata Signature { symbol: string; result: int64; parameters: []int64; valid: bool; indirect: bool; }\n\nkoukai waza signature(name: string, count: int64, returns_value: bool) -> Signature {\n    kaku invalid = Signature { symbol: \"\", result: 0, parameters: [], valid: iie, indirect: iie };\n    moshi (!is_external(name)) { kaesu invalid; }\n    kaesu parse_signature(name, count, returns_value, 7, hai);\n}\n\n// Functions that a Linux AMD64 shared library exports through the C ABI keep their Mio body and carry the same\n// fixed prototype in their name: \"$export::<symbol>:<result><parameters>\" (type codes as in type_code). Only\n// `koukai waza ... export \"symbol\"` declarations produce it; the name is a label, call sites use function ids.\nkoukai teisu export_prefix = \"$export::\";\nkoukai waza is_export(name: string) -> bool { kaesu string.has_prefix(name, export_prefix); }\nkoukai waza export_signature(name: string, count: int64, returns_value: bool) -> Signature {\n    kaku invalid = Signature { symbol: \"\", result: 0, parameters: [], valid: iie, indirect: iie };\n    moshi (!is_export(name)) { kaesu invalid; }\n    kaesu parse_signature(name, count, returns_value, 9, iie);\n}\n\nwaza parse_signature(name: string, count: int64, returns_value: bool, start: int64, external: bool) -> Signature {\n    kaku invalid = Signature { symbol: \"\", result: 0, parameters: [], valid: iie, indirect: iie };\n    moshi (count < 0 || count > 256) { kaesu invalid; }\n    kaku bytes = string.to_bytes(name);\n    kaku at = start;\n    kaku symbol_bytes: []uint8 = [];\n    aida (at < len(bytes) && bytes[at] != uint8(58)) { array.push(symbol_bytes, bytes[at]); at = at + 1; }\n    kaku symbol = string.from_utf8(symbol_bytes);\n    moshi (symbol == mu) { kaesu invalid; }\n    moshi ((external && !valid_symbol(symbol)) || (!external && !valid_export_symbol(symbol)) || len(bytes) != at + 2 + count || bytes[at] != uint8(58)) { kaesu invalid; }\n    kaku result = int64(bytes[at + 1]);\n    moshi ((result != 118 && (result < 97 || result > 108)) || returns_value != (result != 118)) { kaesu invalid; }\n    kaku parameters = array.with_capacity[int64](count);\n    at = at + 2;\n    aida (at < len(bytes)) {\n        kaku parameter = int64(bytes[at]);\n        moshi (parameter < 97 || parameter > 109 || (parameter == 109 && !external)) { kaesu invalid; }\n        array.push(parameters, parameter);\n        at = at + 1;\n    }\n    kaku indirect = external && symbol == indirect_symbol;\n    moshi (indirect && (len(parameters) == 0 || parameters[0] != 107)) { kaesu invalid; }\n    kaesu Signature { symbol: symbol, result: result, parameters: parameters, valid: hai, indirect: indirect };\n}\n" }; }
waza data_4() -> File { kaesu File { path: "kiso/aot/elf/elf.mio", version: "Bunko-v2.1.1", length: 5979, sha256: "d71212bc46171802a2abb5b53b6bd10ed20269724572d9683634be8311b6105f", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// Pure Mio Linux x86-64 ELF64 (ET_EXEC) writer. Layout:\n//   0x0000 ELF header + program headers (inside the RX segment)\n//   0x1000 code; entry = image_base + 0x1000 + entry_offset\n//   after  .shstrtab + section headers (.text/.bss/.shstrtab), not loaded\n//   data   one RW PT_LOAD at the fixed address data_base with filesz 0 (zero-filled bss);\n//          it is omitted when bss_size is 0 (a zero-length PT_LOAD is pointless and\n//          loaders are not required to accept it)\n//   PT_GNU_STACK is RW and non-executable.\nkoukai kata ImageSpec {\n    code: []uint8;\n    entry_offset: int64;\n    bss_size: int64;\n}\nkoukai kata ImageResult {\n    bytes: []uint8;\n    error: string;\n}\n\nkoukai teisu image_base = 4194304;\nkoukai teisu code_offset = 4096;\nkoukai teisu data_base = 268435456;\nteisu header_size = 64;\nteisu program_header_size = 56;\nteisu section_header_size = 64;\nteisu maximum_bss_size = 268435456;\n// The RX segment maps file bytes [0, text_end) at image_base, so it ends at image_base + text_end.\n// The RW segment starts at data_base. To keep the two mappings from overlapping, text_end must satisfy\n// image_base + text_end <= data_base, i.e. text_end <= data_base - image_base (252 MiB).\nteisu maximum_text_end = 264241152;\n\nkoukai waza put(out: []uint8, value: int64, width: int64) -> unit {\n    kaku x = value;\n    kaku i = 0;\n    aida (i < width) {\n        array.push(out, uint8(x - (x / 256) * 256));\n        x = x / 256;\n        i = i + 1;\n    }\n}\nkoukai waza align(value: int64, boundary: int64) -> int64 {\n    kaku r = value - (value / boundary) * boundary;\n    moshi (r == 0) { kaesu value; }\n    kaesu value + boundary - r;\n}\nwaza program_header(out: []uint8, kind: int64, flags: int64, offset: int64, address: int64, file_size: int64, memory_size: int64, alignment: int64) -> unit {\n    put(out, kind, 4);\n    put(out, flags, 4);\n    put(out, offset, 8);\n    put(out, address, 8);\n    put(out, address, 8);\n    put(out, file_size, 8);\n    put(out, memory_size, 8);\n    put(out, alignment, 8);\n}\nwaza section_header(out: []uint8, name: int64, kind: int64, flags: int64, address: int64, offset: int64, size: int64, alignment: int64) -> unit {\n    put(out, name, 4);\n    put(out, kind, 4);\n    put(out, flags, 8);\n    put(out, address, 8);\n    put(out, offset, 8);\n    put(out, size, 8);\n    put(out, 0, 4);\n    put(out, 0, 4);\n    put(out, alignment, 8);\n    put(out, 0, 8);\n}\n\n// e_machine values (ELF specification): EM_X86_64 and EM_AARCH64.\nkoukai teisu machine_x86_64 = 62;\nkoukai teisu machine_aarch64 = 183;\n\nkoukai waza executable(spec: ImageSpec) -> ImageResult { kaesu executable_for(spec, machine_x86_64); }\n\n// AArch64 Linux images use 64 KiB PT_LOAD alignment so they load on 4 KiB, 16 KiB and 64 KiB page kernels.\nkoukai waza executable_aarch64(spec: ImageSpec) -> ImageResult { kaesu executable_for(spec, machine_aarch64); }\n\n// Any other e_machine fails closed (UNSUPPORTED_MACHINE); no silent fallback to another architecture.\nkoukai waza executable_for(spec: ImageSpec, machine: int64) -> ImageResult {\n    moshi (machine != machine_x86_64 && machine != machine_aarch64) { kaesu ImageResult { bytes: [], error: \"UNSUPPORTED_MACHINE\" }; }\n    kaku load_align = 4096;\n    moshi (machine == machine_aarch64) {\n        load_align = 65536;\n    }\n    moshi (len(spec.code) == 0) { kaesu ImageResult { bytes: [], error: \"EMPTY_TEXT\" }; }\n    moshi (spec.entry_offset < 0 || spec.entry_offset >= len(spec.code)) { kaesu ImageResult { bytes: [], error: \"INVALID_ENTRY\" }; }\n    moshi (spec.bss_size < 0 || spec.bss_size > maximum_bss_size) { kaesu ImageResult { bytes: [], error: \"INVALID_BSS\" }; }\n    kaku phnum = 3;\n    moshi (spec.bss_size == 0) {\n        phnum = 2;\n    }\n    kaku text_end = code_offset + len(spec.code);\n    moshi (text_end > maximum_text_end) { kaesu ImageResult { bytes: [], error: \"IMAGE_TOO_LARGE\" }; }\n    // .shstrtab: \"\\0.text\\0.bss\\0.shstrtab\\0\"\n    kaku names: []uint8 = [uint8(0)];\n    array.append_all(names, string.to_bytes(\".text\"));\n    array.push(names, uint8(0));\n    array.append_all(names, string.to_bytes(\".bss\"));\n    array.push(names, uint8(0));\n    array.append_all(names, string.to_bytes(\".shstrtab\"));\n    array.push(names, uint8(0));\n    kaku names_offset = align(text_end, 8);\n    kaku sections_offset = align(names_offset + len(names), 8);\n    kaku out: []uint8 = array.with_capacity[uint8](sections_offset + 4 * section_header_size);\n    // ELF header\n    array.push(out, uint8(127));\n    array.push(out, uint8(69));\n    array.push(out, uint8(76));\n    array.push(out, uint8(70));\n    array.push(out, uint8(2));\n    array.push(out, uint8(1));\n    array.push(out, uint8(1));\n    array.push(out, uint8(0));\n    put(out, 0, 8);\n    put(out, 2, 2);\n    put(out, machine, 2);\n    put(out, 1, 4);\n    put(out, image_base + code_offset + spec.entry_offset, 8);\n    put(out, header_size, 8);\n    put(out, sections_offset, 8);\n    put(out, 0, 4);\n    put(out, header_size, 2);\n    put(out, program_header_size, 2);\n    put(out, phnum, 2);\n    put(out, section_header_size, 2);\n    put(out, 4, 2);\n    put(out, 3, 2);\n    program_header(out, 1, 5, 0, image_base, text_end, text_end, load_align);\n    moshi (spec.bss_size > 0) { program_header(out, 1, 6, 0, data_base, 0, spec.bss_size, load_align); }\n    program_header(out, 1685382481, 6, 0, 0, 0, 0, 16);\n    aida (len(out) < code_offset) { array.push(out, uint8(0)); }\n    array.append_all(out, spec.code);\n    aida (len(out) < names_offset) { array.push(out, uint8(0)); }\n    array.append_all(out, names);\n    aida (len(out) < sections_offset) { array.push(out, uint8(0)); }\n    section_header(out, 0, 0, 0, 0, 0, 0, 0);\n    section_header(out, 1, 1, 6, image_base + code_offset, code_offset, len(spec.code), 16);\n    section_header(out, 7, 8, 3, data_base, text_end, spec.bss_size, 8);\n    section_header(out, 12, 3, 0, 0, names_offset, len(names), 1);\n    kaesu ImageResult { bytes: out, error: \"\" };\n}\n" }; }
waza data_5() -> File { kaesu File { path: "kiso/aot/elfrel/elfrel.mio", version: "Bunko-v2.1.1", length: 10413, sha256: "f1484ee62c431cd9884c153ca2ac8c9078ee7f3e228eaaf10bf583ac89296929", source: "yobu \"kiso/aot/elf\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// Pure Mio Linux x86-64 ELF64 relocatable object (ET_REL) writer: the input of the system linker when Mio builds a\n// shared library. Sections:\n//   .text           the machine code, SHF_ALLOC|SHF_EXECINSTR, 16-byte aligned\n//   .rela.text      RELA entries (SHT_RELA, sh_link = .symtab, sh_info = .text)\n//   .bss            zero-filled data area (SHT_NOBITS, SHF_ALLOC|SHF_WRITE), addressed by the code through rip-relative PC32\n//   .note.GNU-stack empty, no SHF_EXECINSTR: the object asks for a non-executable stack\n//   .symtab/.strtab/.shstrtab\n// Symbols: null, the .text and .bss section symbols (local), then one GLOBAL FUNC symbol per exported entry point and\n// one undefined GLOBAL symbol per external dependency. Nothing else is global, so a link exports exactly `exports`.\n//\n// Relocation types the Mio code generator produces, and the only ones accepted (anything else fails closed):\n//   R_X86_64_PC32  (2)  rip-relative reference to the data area: S + A - P, S = .bss, A = offset - 4\n//   R_X86_64_PLT32 (4)  `call symbol@PLT` to a declared external C symbol: L + A - P, A = -4\nkoukai teisu r_x86_64_pc32 = 2;\nkoukai teisu r_x86_64_plt32 = 4;\n\nkoukai kata ObjectExport {\n    symbol: string;\n    offset: int64;\n    size: int64;\n}\n// A rel32 at `at` in .text. `symbol` empty = the .bss section symbol; otherwise an undefined global symbol.\nkoukai kata Relocation {\n    at: int64;\n    kind: int64;\n    symbol: string;\n    addend: int64;\n}\nkoukai kata ObjectSpec {\n    code: []uint8;\n    bss_size: int64;\n    exports: []ObjectExport;\n    // LOCAL FUNC symbols (debugging aid, .symtab only); the linker drops them from the dynamic symbol table.\n    locals: []ObjectExport;\n    relocations: []Relocation;\n}\nkoukai kata ObjectResult {\n    bytes: []uint8;\n    error: string;\n}\n\nteisu symbol_size = 24;\nteisu relocation_size = 24;\n\n// Two's-complement 64-bit little-endian (the addend of a RELA entry is signed).\nwaza put_signed(out: []uint8, value: int64) -> unit {\n    kaku negative = value < 0;\n    kaku x = value;\n    moshi (negative) { x = -(value + 1); }\n    kaku i = 0;\n    aida (i < 8) {\n        kaku b = x - (x / 256) * 256;\n        x = x / 256;\n        moshi (negative) { b = 255 - b; }\n        array.push(out, uint8(b));\n        i = i + 1;\n    }\n}\n\nwaza fail(message: string) -> ObjectResult { kaesu ObjectResult { bytes: [], error: message }; }\n\n// Appends a NUL-terminated name to a string table and returns its offset.\nwaza add_name(table: []uint8, name: string) -> int64 {\n    kaku at = len(table);\n    array.append_all(table, string.to_bytes(name));\n    array.push(table, uint8(0));\n    kaesu at;\n}\n\nwaza section(out: []uint8, name: int64, kind: int64, flags: int64, offset: int64, size: int64, link: int64, info: int64, alignment: int64, entry_size: int64) -> unit {\n    elf.put(out, name, 4);\n    elf.put(out, kind, 4);\n    elf.put(out, flags, 8);\n    elf.put(out, 0, 8);\n    elf.put(out, offset, 8);\n    elf.put(out, size, 8);\n    elf.put(out, link, 4);\n    elf.put(out, info, 4);\n    elf.put(out, alignment, 8);\n    elf.put(out, entry_size, 8);\n}\n\nwaza symbol(out: []uint8, name: int64, info: int64, section_index: int64, value: int64, size: int64) -> unit {\n    elf.put(out, name, 4);\n    elf.put(out, info, 1);\n    elf.put(out, 0, 1);\n    elf.put(out, section_index, 2);\n    elf.put(out, value, 8);\n    elf.put(out, size, 8);\n}\n\n// Index (in the undefined-symbol list) of `name`, appending it when new.\nwaza external_index(names: []string, name: string) -> int64 {\n    kaku at = 0;\n    aida (at < len(names)) {\n        moshi (names[at] == name) { kaesu at; }\n        at = at + 1;\n    }\n    array.push(names, name);\n    kaesu len(names) - 1;\n}\n\nkoukai waza object(spec: ObjectSpec) -> ObjectResult {\n    moshi (len(spec.code) == 0) { kaesu fail(\"EMPTY_TEXT\"); }\n    moshi (spec.bss_size < 0 || spec.bss_size > 1073741824) { kaesu fail(\"INVALID_BSS\"); }\n    kaku exports = len(spec.exports);\n    kaku at = 0;\n    aida (at < exports) {\n        kaku entry = spec.exports[at];\n        moshi (entry.symbol == \"\" || entry.offset < 0 || entry.size < 0 || entry.offset > len(spec.code) - entry.size) { kaesu fail(\"INVALID_EXPORT\"); }\n        kaku other = 0;\n        aida (other < at) {\n            moshi (spec.exports[other].symbol == entry.symbol) { kaesu fail(string.concat(\"DUPLICATE_EXPORT \", entry.symbol)); }\n            other = other + 1;\n        }\n        at = at + 1;\n    }\n    kaku undefined: []string = [];\n    at = 0;\n    aida (at < len(spec.relocations)) {\n        kaku reloc = spec.relocations[at];\n        moshi (reloc.kind != r_x86_64_pc32 && reloc.kind != r_x86_64_plt32) { kaesu fail(string.concat(\"UNSUPPORTED_RELOCATION type \", convert.format_int(reloc.kind))); }\n        moshi (reloc.at < 0 || reloc.at > len(spec.code) - 4) { kaesu fail(\"INVALID_RELOCATION_OFFSET\"); }\n        moshi (reloc.kind == r_x86_64_plt32 && reloc.symbol == \"\") { kaesu fail(\"INVALID_RELOCATION_SYMBOL\"); }\n        moshi (reloc.kind == r_x86_64_pc32 && reloc.symbol != \"\") { kaesu fail(\"INVALID_RELOCATION_SYMBOL\"); }\n        moshi ((reloc.kind == r_x86_64_plt32 && reloc.addend != -4) ||\n               (reloc.kind == r_x86_64_pc32 && (reloc.addend < -4 || reloc.addend > spec.bss_size - 4))) {\n            kaesu fail(\"INVALID_RELOCATION_ADDEND\");\n        }\n        moshi (reloc.symbol != \"\") {\n            kaku defined = iie;\n            kaku e = 0;\n            aida (e < exports) { moshi (spec.exports[e].symbol == reloc.symbol) { defined = hai; } e = e + 1; }\n            moshi (!defined) { external_index(undefined, reloc.symbol); }\n        }\n        at = at + 1;\n    }\n    // String tables.\n    kaku strtab: []uint8 = [uint8(0)];\n    kaku local_names: []int64 = [];\n    at = 0;\n    aida (at < len(spec.locals)) {\n        kaku entry = spec.locals[at];\n        moshi (entry.symbol == \"\" || entry.offset < 0 || entry.size < 0 || entry.offset > len(spec.code) - entry.size) { kaesu fail(\"INVALID_LOCAL\"); }\n        array.push(local_names, add_name(strtab, entry.symbol));\n        at = at + 1;\n    }\n    kaku export_names: []int64 = [];\n    at = 0;\n    aida (at < exports) { array.push(export_names, add_name(strtab, spec.exports[at].symbol)); at = at + 1; }\n    kaku undefined_names: []int64 = [];\n    at = 0;\n    aida (at < len(undefined)) { array.push(undefined_names, add_name(strtab, undefined[at])); at = at + 1; }\n    kaku shstrtab: []uint8 = [uint8(0)];\n    kaku n_text = add_name(shstrtab, \".text\");\n    kaku n_rela = add_name(shstrtab, \".rela.text\");\n    kaku n_bss = add_name(shstrtab, \".bss\");\n    kaku n_stack = add_name(shstrtab, \".note.GNU-stack\");\n    kaku n_symtab = add_name(shstrtab, \".symtab\");\n    kaku n_strtab = add_name(shstrtab, \".strtab\");\n    kaku n_shstrtab = add_name(shstrtab, \".shstrtab\");\n    // Symbol table: [0] null, [1] .text, [2] .bss, then the local functions, the exports, the undefined externals.\n    kaku symtab: []uint8 = [];\n    symbol(symtab, 0, 0, 0, 0, 0);\n    symbol(symtab, 0, 3, 1, 0, 0);\n    symbol(symtab, 0, 3, 3, 0, 0);\n    at = 0;\n    aida (at < len(spec.locals)) {\n        // st_info = STB_LOCAL << 4 | STT_FUNC\n        symbol(symtab, local_names[at], 2, 1, spec.locals[at].offset, spec.locals[at].size);\n        at = at + 1;\n    }\n    at = 0;\n    aida (at < exports) {\n        // st_info = STB_GLOBAL << 4 | STT_FUNC, st_other = STV_DEFAULT\n        symbol(symtab, export_names[at], 18, 1, spec.exports[at].offset, spec.exports[at].size);\n        at = at + 1;\n    }\n    at = 0;\n    aida (at < len(undefined)) { symbol(symtab, undefined_names[at], 16, 0, 0, 0); at = at + 1; }\n    // Relocations.\n    kaku first_global = 3 + len(spec.locals);\n    kaku rela: []uint8 = [];\n    at = 0;\n    aida (at < len(spec.relocations)) {\n        kaku reloc = spec.relocations[at];\n        kaku index = 2;\n        moshi (reloc.symbol != \"\") {\n            kaku found = iie;\n            kaku e = 0;\n            aida (e < exports) { moshi (spec.exports[e].symbol == reloc.symbol) { index = first_global + e; found = hai; } e = e + 1; }\n            moshi (!found) { index = first_global + exports + external_index(undefined, reloc.symbol); }\n        }\n        elf.put(rela, reloc.at, 8);\n        elf.put(rela, index * 4294967296 + reloc.kind, 8);\n        put_signed(rela, reloc.addend);\n        at = at + 1;\n    }\n    // Layout.\n    kaku text_offset = 64;\n    kaku rela_offset = elf.align(text_offset + len(spec.code), 8);\n    kaku symtab_offset = elf.align(rela_offset + len(rela), 8);\n    kaku strtab_offset = symtab_offset + len(symtab);\n    kaku shstrtab_offset = strtab_offset + len(strtab);\n    kaku sections_offset = elf.align(shstrtab_offset + len(shstrtab), 8);\n    kaku out: []uint8 = array.with_capacity[uint8](sections_offset + 8 * 64);\n    array.push(out, uint8(127));\n    array.push(out, uint8(69));\n    array.push(out, uint8(76));\n    array.push(out, uint8(70));\n    array.push(out, uint8(2));\n    array.push(out, uint8(1));\n    array.push(out, uint8(1));\n    array.push(out, uint8(0));\n    elf.put(out, 0, 8);\n    elf.put(out, 1, 2);\n    elf.put(out, 62, 2);\n    elf.put(out, 1, 4);\n    elf.put(out, 0, 8);\n    elf.put(out, 0, 8);\n    elf.put(out, sections_offset, 8);\n    elf.put(out, 0, 4);\n    elf.put(out, 64, 2);\n    elf.put(out, 0, 2);\n    elf.put(out, 0, 2);\n    elf.put(out, 64, 2);\n    elf.put(out, 8, 2);\n    elf.put(out, 7, 2);\n    array.append_all(out, spec.code);\n    aida (len(out) < rela_offset) { array.push(out, uint8(0)); }\n    array.append_all(out, rela);\n    aida (len(out) < symtab_offset) { array.push(out, uint8(0)); }\n    array.append_all(out, symtab);\n    array.append_all(out, strtab);\n    array.append_all(out, shstrtab);\n    aida (len(out) < sections_offset) { array.push(out, uint8(0)); }\n    section(out, 0, 0, 0, 0, 0, 0, 0, 0, 0);\n    section(out, n_text, 1, 6, text_offset, len(spec.code), 0, 0, 16, 0);\n    section(out, n_rela, 4, 64, rela_offset, len(rela), 5, 1, 8, relocation_size);\n    section(out, n_bss, 8, 3, symtab_offset, spec.bss_size, 0, 0, 4096, 0);\n    section(out, n_stack, 1, 0, symtab_offset, 0, 0, 0, 1, 0);\n    section(out, n_symtab, 2, 0, symtab_offset, len(symtab), 6, first_global, 8, symbol_size);\n    section(out, n_strtab, 3, 0, strtab_offset, len(strtab), 0, 0, 1, 0);\n    section(out, n_shstrtab, 3, 0, shstrtab_offset, len(shstrtab), 0, 0, 1, 0);\n    kaesu ObjectResult { bytes: out, error: \"\" };\n}\n" }; }
waza data_6() -> File { kaesu File { path: "kiso/aot/linuxarm64/linuxarm64.mio", version: "Bunko-v2.1.1", length: 6905, sha256: "5ef391755f46fdb3554a015aa4bd60896746cca62d03b1193c56fc128a299a8f", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/elf\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// Linux AArch64 (generic syscall table, AAPCS64 registers) static image builder. First backend slice: it emits the\n// smallest genuine native program (write + exit_group). There is no libc, no loader and no fallback to another CPU.\n// Syscall numbers are from the Linux generic table used by arm64 (not the x86-64 table): write=64, exit_group=94.\nkoukai teisu syscall_write = 64;\nkoukai teisu syscall_exit_group = 94;\n\nkoukai kata Program {\n    code: []uint8;\n    error: string;\n}\n\nwaza push_word(out: []uint8, word: uint32) -> unit {\n    kaku value = int64(word);\n    kaku i = 0;\n    aida (i < 4) {\n        array.push(out, uint8(value - (value / 256) * 256));\n        value = value / 256;\n        i = i + 1;\n    }\n}\n\n// write(1, message, len(message)); exit_group(status). The message bytes follow the code in the same RX segment and are\n// addressed PC-relative with ADR, so the image needs no relocation.\nkoukai waza hello_program(message: string, status: int64) -> Program {\n    kaku text = string.to_bytes(message);\n    moshi (len(text) == 0 || len(text) > 65535) { kaesu Program { code: [], error: \"INVALID_MESSAGE\" }; }\n    moshi (status < 0 || status > 255) { kaesu Program { code: [], error: \"INVALID_STATUS\" }; }\n    kaku c = arm64.assembler();\n    // eight instructions; ADR is instruction 1 (byte 4) and the message starts at byte 32\n    kaku failure = arm64.assembler_emit(c, arm64.movz_x(0, 1, 0));\n    arm64.assembler_emit(c, arm64.adr(1, 28));\n    arm64.assembler_emit(c, arm64.movz_x(2, len(text), 0));\n    arm64.assembler_emit(c, arm64.movz_x(8, syscall_write, 0));\n    arm64.assembler_emit(c, arm64.svc(0));\n    arm64.assembler_emit(c, arm64.movz_x(0, status, 0));\n    arm64.assembler_emit(c, arm64.movz_x(8, syscall_exit_group, 0));\n    arm64.assembler_emit(c, arm64.svc(0));\n    kaku assembled = arm64.assembler_assemble(c);\n    moshi (assembled.error != mu) { kaesu Program { code: [], error: \"ENCODE\" }; }\n    kaku code: []uint8 = [];\n    kaku i = 0;\n    aida (i < len(assembled.words)) {\n        push_word(code, assembled.words[i]);\n        i = i + 1;\n    }\n    array.append_all(code, text);\n    aida (len(code) - (len(code) / 4) * 4 != 0) { array.push(code, uint8(0)); }\n    kaesu Program { code: code, error: \"\" };\n}\n\n// A complete Linux AArch64 ELF64 executable for hello_program.\nkoukai waza hello_image(message: string, status: int64) -> elf.ImageResult {\n    kaku program = hello_program(message, status);\n    moshi (program.error != \"\") { kaesu elf.ImageResult { bytes: [], error: program.error }; }\n    kaesu elf.executable_aarch64(elf.ImageSpec { code: program.code, entry_offset: 0, bss_size: 0 });\n}\n\n// ---- Image for lowered Mochi programs (kiso/aot/lower, compile_linux_arm64)\n//\n// The lowered words use the Darwin entry convention main(argc, argv, envp) in x0-x2 and address constants and globals\n// through ADRP/ADD patches. This container lays the image out as: [words][pad to 8][constants][pad to 4][_start], and\n// reserves globals*8 bytes in the zero-filled data segment (elf.data_base). `_start` converts the Linux initial stack\n// (argc, argv[], NULL, envp[]) into x0-x2 and branches to word 0. Addresses are absolute, so ADRP page deltas are\n// computed from the real code and data addresses.\nteisu maximum_globals = 10244;\nteisu maximum_image_size = 67108864;\n\nwaza align(value: int64, boundary: int64) -> int64 {\n    kaku remainder = value - (value / boundary) * boundary;\n    moshi (remainder == 0) { kaesu value; }\n    kaesu value + boundary - remainder;\n}\n\nwaza image_failed(message: string) -> elf.ImageResult { kaesu elf.ImageResult { bytes: [], error: message }; }\n\nkoukai waza image(spec: macho.ImageSpec) -> elf.ImageResult {\n    moshi (len(spec.words) == 0) { kaesu image_failed(\"EMPTY_TEXT\"); }\n    moshi (spec.globals < 0 || spec.globals > maximum_globals) { kaesu image_failed(\"TOO_MANY_GLOBALS\"); }\n    moshi (len(spec.words) > maximum_image_size / 4 || len(spec.constants) > maximum_image_size) { kaesu image_failed(\"IMAGE_TOO_LARGE\"); }\n    kaku code_base = elf.image_base + elf.code_offset;\n    kaku const_offset = align(len(spec.words) * 4, 8);\n    kaku words = array.clone(spec.words);\n    kaku index = 0;\n    aida (index < len(spec.patches)) {\n        kaku patch = spec.patches[index];\n        moshi (patch.at_word < 0 || patch.at_word >= len(words) || patch.target_offset < 0 || patch.target.kind < 0 || patch.target.kind > 2) {\n            kaesu image_failed(\"INVALID_PATCH\");\n        }\n        kaku target = code_base + patch.target_offset;\n        moshi (patch.target.kind == 0 && patch.target_offset >= len(spec.words) * 4) { kaesu image_failed(\"INVALID_PATCH\"); }\n        moshi (patch.target.kind == 1) {\n            moshi (patch.target_offset >= len(spec.constants)) { kaesu image_failed(\"INVALID_PATCH\"); }\n            target = code_base + const_offset + patch.target_offset;\n        }\n        moshi (patch.target.kind == 2) {\n            moshi (patch.target_offset >= spec.globals * 8) { kaesu image_failed(\"INVALID_PATCH\"); }\n            target = elf.data_base + patch.target_offset;\n        }\n        kaku encoded = arm64.adrp_offset(patch.register, code_base + patch.at_word * 4, target);\n        moshi (encoded.error != mu) { kaesu image_failed(\"ENCODE\"); }\n        words[patch.at_word] = encoded.word;\n        moshi (patch.add_at_word >= 0) {\n            moshi (patch.add_at_word >= len(words) || patch.add_at_word == patch.at_word) { kaesu image_failed(\"INVALID_PATCH\"); }\n            kaku addition = arm64.add_imm_x(patch.register, patch.register, target - (target / 4096) * 4096, iie);\n            moshi (addition.error != mu) { kaesu image_failed(\"ENCODE\"); }\n            words[patch.add_at_word] = addition.word;\n        }\n        index = index + 1;\n    }\n    kaku code: []uint8 = array.with_capacity[uint8](len(spec.words) * 4 + len(spec.constants) + 64);\n    index = 0;\n    aida (index < len(words)) {\n        push_word(code, words[index]);\n        index = index + 1;\n    }\n    aida (len(code) < const_offset) { array.push(code, uint8(0)); }\n    array.append_all(code, spec.constants);\n    aida (len(code) - (len(code) / 4) * 4 != 0) { array.push(code, uint8(0)); }\n    kaku start = len(code);\n    // _start: x0 = argc, x1 = &argv[0], x2 = &envp[0] = argv + 8 * (argc + 1); then branch to word 0.\n    kaku sequence = [arm64.ldr_x(0, 31, 0), arm64.add_imm_x(1, 31, 8, iie), arm64.add_imm_x(3, 0, 1, iie), arm64.lsl_x(3, 3, 3),\n        arm64.add_x(2, 1, 3), arm64.b(-(start / 4) - 5)];\n    index = 0;\n    aida (index < len(sequence)) {\n        moshi (sequence[index].error != mu) { kaesu image_failed(\"ENCODE\"); }\n        push_word(code, sequence[index].word);\n        index = index + 1;\n    }\n    kaesu elf.executable_aarch64(elf.ImageSpec { code: code, entry_offset: start, bss_size: spec.globals * 8 });\n}\n" }; }
waza data_7() -> File { kaesu File { path: "kiso/aot/lower/attached_roots.mio", version: "Bunko-v2.1.1", length: 8130, sha256: "eca8bd55cec5a543a79466ed81af19f7cbc34c2ec1a2141585ac08c79df6c848", source: "yobu \"kiso/runtime/gc\";\nyobu \"kiso/runtime/ir\";\nyobu \"kiso/runtime/cpu/aarch64\";\nyobu \"kiso/runtime/os/darwin\";\n// Darwin/AArch64 compiler adapter. This internal opt-in path attaches main to\n// the real cooperative registry. Worker mode dispatches to worker_roots.mio;\n// public target precise_roots/concurrent flags stay false until full acceptance.\nkoukai teisu attached_root_words = 68;\nwaza attached_roots_enabled(code: arm64.Assembler) -> bool {\n    kaesu arm64.assembler_label_word(code, \"attached_roots_enabled\") >= 0;\n}\nwaza attached_data_address(code: arm64.Assembler, patches: []macho.AddressPatch, word: int64, r: int64) -> unit {\n    kaku at = len(code.words);\n    emit(code, arm64.Instruction {\n            word: uint32(0), error: mu });\n    emit(code, arm64.Instruction {\n            word: uint32(0), error: mu });\n    array.push(patches, macho.AddressPatch { at_word: at, add_at_word: at + 1, target: macho.data_target(), target_offset: word * 8, register: r });\n}\nwaza attached_save(code: arm64.Assembler, name: string) -> unit {\n    arm64.assembler_label(code, name);\n    // Poll/publication is transparent even to an allocation result in x0.\n    kaku r = 0;\n    aida (r<18) {\n        emit(code, arm64.stp_pre_x(r, r + 1, 31, -16));\n        r = r + 2;\n    }\n    // x18 is reserved by Darwin and is never used or restored by this bridge.\n    emit(code, arm64.sub_imm_x(31, 31, 16, iie));\n    emit(code, arm64.str_x(30, 31, 0));\n}\nwaza attached_restore(code: arm64.Assembler) -> unit {\n    emit(code, arm64.ldr_x(30, 31, 0));\n    emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    kaku r = 16;\n    aida (r >= 0) {\n        emit(code, arm64.ldp_post_x(r, r + 1, 31, 16));\n        r = r - 2;\n    }\n    emit(code, arm64.ret());\n}\nwaza emit_attached_root_runtime(code: arm64.Assembler, patches: []macho.AddressPatch, first: int64, queue_slots: int64) -> string {\n    moshi (worker_roots_enabled(code)) { kaesu emit_worker_root_runtime(code, patches, first, queue_slots); }\n    kaku context = first + darwin.thread_symbol_count;\n    attached_save(code, \"attached_roots_init\");\n    attached_data_address(code, patches, context, 0);\n    attached_data_address(code, patches, first, 7);\n    emit(code, arm64.str_x(7, 0, gc.thread_imports));\n    emit(code, arm64.movz_x(9, 3, 0));\n    emit(code, arm64.str_x(9, 0, gc.thread_version));\n    emit(code, arm64.add_imm_x(10, 0, 288, iie));\n    emit(code, arm64.str_x(10, 0, gc.thread_mutex));\n    emit(code, arm64.add_imm_x(10, 0, 352, iie));\n    emit(code, arm64.str_x(10, 0, gc.thread_condition));\n    emit(code, arm64.add_imm_x(10, 0, 400, iie));\n    emit(code, arm64.str_x(10, 0, gc.thread_registry));\n    emit(code, arm64.str_x(9, 10, 0));\n    arm64.assembler_bl(code, \"attached_thread_attach\");\n    arm64.assembler_cbnz_x(code, 0, \"runtime_error\");\n    attached_restore(code);\n    kaku names = [\"attached_roots_publish\", \"attached_roots_poll\", \"attached_roots_close\"];\n    kaku i = 0;\n    aida (i<len(names)) {\n        attached_save(code, names[i]);\n        attached_data_address(code, patches, context, 0);\n        attached_data_address(code, patches, first, 7);\n        // The actual executing thread must own the TLS attachment. Never\n        // silently use main's context from a foreign/unregistered thread.\n        emit(code, arm64.ldr_x(0, 0, gc.thread_key));\n        aarch64.emit_import_call(code, 7, 5, darwin.thread_symbol_count);\n        arm64.assembler_cbz_x(code, 0, \"runtime_error\");\n        attached_data_address(code, patches, context, 9);\n        emit(code, arm64.cmp_x(0, 9));\n        arm64.assembler_b_cond(code, 1, \"runtime_error\");\n        emit(code, arm64.add_imm_x(9, 0, gc.thread_shadow, iie));\n        emit(code, arm64.stlr_x(24, 9));\n        // Internal integration trace, outside heap/object ABI: polls,\n        // publications and maximum simultaneously linked precise frames.\n        attached_data_address(code, patches, context, 10);\n        emit(code, arm64.ldr_x(11, 10, 488));\n        emit(code, arm64.add_imm_x(11, 11, 1, iie));\n        emit(code, arm64.str_x(11, 10, 488));\n        moshi (i == 1) {\n            emit(code, arm64.ldr_x(11, 10, 480));\n            emit(code, arm64.add_imm_x(11, 11, 1, iie));\n            emit(code, arm64.str_x(11, 10, 480));\n            move_x(code, 11, 24);\n            emit(code, arm64.movz_x(12, 0, 0));\n            arm64.assembler_label(code, \"attached_count_frames\");\n            arm64.assembler_cbz_x(code, 11, \"attached_count_done\");\n            emit(code, arm64.add_imm_x(12, 12, 1, iie));\n            emit(code, arm64.movz_x(13, 8192, 0));\n            emit(code, arm64.cmp_x(12, 13));\n            arm64.assembler_b_cond(code, 2, \"runtime_error\");\n            emit(code, arm64.ldr_x(11, 11, 0));\n            arm64.assembler_b(code, \"attached_count_frames\");\n            arm64.assembler_label(code, \"attached_count_done\");\n            emit(code, arm64.ldr_x(13, 10, 496));\n            emit(code, arm64.cmp_x(12, 13));\n            arm64.assembler_b_cond(code, 9, \"attached_max_done\");\n            emit(code, arm64.str_x(12, 10, 496));\n            arm64.assembler_label(code, \"attached_max_done\");\n            move_x(code, 1, 24);\n            attached_data_address(code, patches, first, 7);\n            arm64.assembler_bl(code, \"attached_gc_poll\");\n            arm64.assembler_cbnz_x(code, 0, \"runtime_error\");\n        }\n        moshi (i == 2) {\n            attached_data_address(code, patches, first, 7);\n            arm64.assembler_bl(code, \"attached_thread_leave\");\n            arm64.assembler_cbnz_x(code, 0, \"runtime_error\");\n            attached_data_address(code, patches, context, 0);\n            attached_data_address(code, patches, first, 7);\n            arm64.assembler_bl(code, \"attached_thread_close\");\n            arm64.assembler_cbnz_x(code, 0, \"runtime_error\");\n            attached_data_address(code, patches, context, 10);\n            emit(code, arm64.ldr_x(11, 10, gc.thread_registrations));\n            emit(code, arm64.str_x(11, 10, 504));\n            emit(code, arm64.ldr_x(11, 10, gc.thread_exits));\n            emit(code, arm64.str_x(11, 10, 512));\n            emit(code, arm64.ldr_x(11, 10, gc.thread_acquisitions));\n            emit(code, arm64.str_x(11, 10, 520));\n            emit(code, arm64.ldr_x(12, 10, gc.thread_releases));\n            emit(code, arm64.str_x(12, 10, 528));\n            emit(code, arm64.cmp_x(11, 12));\n            arm64.assembler_b_cond(code, 1, \"runtime_error\");\n            emit(code, arm64.ldr_x(11, 10, gc.thread_member));\n            arm64.assembler_cbnz_x(code, 11, \"runtime_error\");\n            emit(code, arm64.ldr_x(11, 10, gc.thread_shadow));\n            arm64.assembler_cbnz_x(code, 11, \"runtime_error\");\n            arm64.assembler_cbz_x(code, 23, \"attached_no_heap\");\n            emit(code, arm64.ldr_x(11, 23, gc.minor_count));\n            emit(code, arm64.str_x(11, 10, 536));\n            arm64.assembler_label(code, \"attached_no_heap\");\n            // Diagnostic ABI for this explicitly selected integration builder:\n            // exactly eight little-endian counters to stderr after detach.\n            emit(code, arm64.movz_x(0, 2, 0));\n            emit(code, arm64.add_imm_x(1, 10, 480, iie));\n            emit(code, arm64.movz_x(2, 64, 0));\n            emit(code, arm64.movz_x(16, 4, 0));\n            emit(code, arm64.svc(128));\n            emit(code, arm64.cmp_imm_x(0, 64, iie));\n            arm64.assembler_b_cond(code, 1, \"runtime_error\");\n        }\n        attached_restore(code);\n        i = i + 1;\n    }\n    kaku functions = gc.cooperative_thread_program(iie);\n    array.append_all(functions, gc.safepoint_program(8192));\n    array.append_all(functions, darwin.thread_platform_program());\n    // Scan is not invoked by this single-mutator integration path. A stray\n    // invocation fails closed via public process exit, never a fake scan PASS.\n    kaku bindings = darwin.thread_bindings();\n    array.push(bindings, ir.Binding {\n            operation: gc.gc_visit_root_operation, slot: 7, arguments: [-2], result_bits: 64 });\n    kaesu aarch64.emit_program(code, functions, bindings, darwin.thread_symbol_count, \"attached\");\n}\n" }; }
waza data_8() -> File { kaesu File { path: "kiso/aot/lower/cabi_darwin.mio", version: "Bunko-v2.1.1", length: 5785, sha256: "73adfff515ef1fb03f78fe0fc5ea11d99c6d6ac382acf4dad643f7a82a09178b", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/cabi\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\nkoukai waza c_call_label(id: int64) -> string {\n    kaesu string.concat(\"cabi_call_\", convert.format_int(id));\n}\n\nwaza c_argument_size(kind: int64) -> int64 {\n    moshi (kind == 97 || kind == 98 || kind == 108) { kaesu 1; }\n    moshi (kind == 99 || kind == 100) { kaesu 2; }\n    moshi (kind == 101 || kind == 102 || kind == 105) { kaesu 4; }\n    kaesu 8;\n}\n\nwaza c_floating(kind: int64) -> bool { kaesu kind == 105 || kind == 106; }\n\nwaza c_align(value: int64, boundary: int64) -> int64 {\n    kaesu ((value + boundary - 1) / boundary) * boundary;\n}\n\n// Darwin 的窄整数寄存器参数由调用者扩展到 Wn。回到 Mio 时，\n// 有符号返回值扩展到整个 Xn，浮点返回值原样搬回整数寄存器。\nwaza c_normalize(code: arm64.Assembler, kind: int64, reg: int64, returned: bool) -> unit {\n    kaku word = 0;\n    moshi (kind == 97) { word = 318767104 + 7 * 1024; }\n    moshi (kind == 99) { word = 318767104 + 15 * 1024; }\n    moshi (returned && (kind == 97 || kind == 99 || kind == 101)) {\n        word = 2470445056 + (c_argument_size(kind) * 8 - 1) * 1024;\n    }\n    moshi (kind == 98 || kind == 100 || (returned && kind == 102)) {\n        word = 1392508928 + (c_argument_size(kind) * 8 - 1) * 1024;\n    }\n    moshi (kind == 108) { word = 1392508928; }\n    moshi (word != 0) { emit(code, arm64.Instruction { word: uint32(word + reg * 33), error: mu }); }\n}\n\nwaza c_store_stack(code: arm64.Assembler, size: int64, offset: int64) -> unit {\n    moshi (size == 1) { emit(code, arm64.strb_w(9, 31, offset)); }\n    moshi (size == 2) { emit(code, arm64.strh_w(9, 31, offset)); }\n    moshi (size == 4) { emit(code, arm64.str_w(9, 31, offset)); }\n    moshi (size == 8) { emit(code, arm64.str_x(9, 31, offset)); }\n}\n\nwaza c_stack_bytes(signature: cabi.Signature) -> int64 {\n    kaku gp = 0; kaku fp = 0; kaku bytes = 0; kaku at = 0;\n    aida (at < len(signature.parameters)) {\n        kaku kind = signature.parameters[at]; kaku size = c_argument_size(kind);\n        moshi ((c_floating(kind) && fp >= 8) || (!c_floating(kind) && gp >= 8)) { bytes = c_align(bytes, size) + size; }\n        moshi (c_floating(kind)) { fp = fp + 1; } sore { gp = gp + 1; }\n        at = at + 1;\n    }\n    kaesu c_align(bytes, 16);\n}\n\nwaza emit_c_body(code: arm64.Assembler, patches: []macho.AddressPatch, signature: cabi.Signature,\n    id: int64, data_base: int64) -> unit {\n    // Mio 的入口已经把参数保存在 x21 的机器字槽中。两组 C 参数寄存器\n    // 独立耗尽；溢出参数按原型顺序、自然对齐紧凑放在 Darwin 栈上。\n    kaku workers = worker_roots_enabled(code);\n    moshi (workers) { wr_poll(code, patches, data_base, \"gc_block_enter\"); }\n    kaku frame = c_stack_bytes(signature);\n    moshi (frame > 0) { emit(code, arm64.sub_imm_x(31, 31, frame, iie)); }\n    kaku gp = 0; kaku fp = 0; kaku offset = 0; kaku at = 0;\n    aida (at < len(signature.parameters)) {\n        kaku kind = signature.parameters[at]; kaku size = c_argument_size(kind);\n        moshi (c_floating(kind) && fp < 8) {\n            emit(code, arm64.ldr_x(9, 21, at * 8));\n            kaku bits = 505872384; moshi (kind == 106) { bits = 2657550336; }\n            emit(code, arm64.Instruction { word: uint32(bits + 9 * 32 + fp), error: mu });\n            fp = fp + 1;\n        } sore { moshi (!c_floating(kind) && gp < 8) {\n            emit(code, arm64.ldr_x(gp, 21, at * 8));\n            c_normalize(code, kind, gp, iie);\n            gp = gp + 1;\n        } sore {\n            offset = c_align(offset, size);\n            emit(code, arm64.ldr_x(9, 21, at * 8));\n            c_store_stack(code, size, offset);\n            offset = offset + size;\n        } }\n        at = at + 1;\n    }\n    arm64.assembler_label(code, c_call_label(id));\n    // Mach-O 的 ARM64_RELOC_BRANCH26 由系统汇编器从此槽产生。\n    emit(code, arm64.bl(0));\n    moshi (frame > 0) { emit(code, arm64.add_imm_x(31, 31, frame, iie)); }\n    moshi (signature.result == 105) { emit(code, arm64.Instruction { word: uint32(505806848), error: mu }); }\n    moshi (signature.result == 106) { emit(code, arm64.Instruction { word: uint32(2657484800), error: mu }); }\n    c_normalize(code, signature.result, 0, hai);\n    moshi (workers) {\n        // C 看不到 Mio 引用；已有调用帧的根继续由 GC 管理。进入阻塞区\n        // 释放当前 mutator，返回时用私有栈槽跨协议调用保留 C 结果。\n        emit(code, arm64.sub_imm_x(31, 31, 16, iie)); emit(code, arm64.str_x(0, 31, 0));\n        wr_current(code, patches, data_base); wr_call(code, \"gc_block_leave\");\n        emit(code, arm64.ldr_x(0, 31, 0)); emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    }\n}\n\n// 只有会解析 C 符号的 Mach-O 链接路径可以开启这个入口。\nkoukai waza compile_with_c(file: mochi.File, capacity: int64, gc_stress: bool,\n    observation: bool, start: int64, join: int64, retention: bool) -> LowerResult {\n    moshi (start < 0 && join < 0) {\n        kaesu compile_worker_target(file, gc_stress, capacity, observation, iie, iie, [],\n            iie, 32768, iie, iie, 0, hai, 0, hai);\n    }\n    moshi (start < 0 || start >= len(file.functions) || join < 0 || join >= len(file.functions) || start == join) {\n        kaesu failed(LowerError.InvalidFunction());\n    }\n    kaku s = file.functions[start]; kaku j = file.functions[join];\n    moshi (s.parameter_count != 1 || !s.returns_value || j.parameter_count != 1 || !j.returns_value) {\n        kaesu failed(LowerError.InvalidFunction());\n    }\n    kaesu compile_worker_target(file, gc_stress, capacity, observation, iie, hai, [start, join, -1, -1],\n        iie, 32768, iie, iie, 3, retention, 0, hai);\n}\n" }; }
waza data_9() -> File { kaesu File { path: "kiso/aot/lower/dylib.mio", version: "Bunko-v2.1.1", length: 7666, sha256: "4a26581fb74ba84a3e39e7c6fa9ae0c4e2c75f16f1ff7eceb9c028fec6e5e6bc", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/cabi\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/array\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\nkoukai kata DylibCode {\n    words: []uint32;\n    exports: []macho.DylibExport;\n    error: string;\n}\n\nwaza scalar_library_failure(error: string) -> DylibCode {\n    kaesu DylibCode { words: [], exports: [], error: error };\n}\n\nwaza library_scalar(analysis: types.TypeAnalysis, node: int64) -> bool {\n    kaku kind = types.type_kind(analysis, node);\n    kaesu !types.type_nullable(analysis, node) && (kind == types.type_integer || kind == types.type_bool ||\n        kind == types.type_float32 || kind == types.type_float64);\n}\n\nwaza scalar_library_body(analysis: types.TypeAnalysis, f: mochi.Function) -> bool {\n    moshi (len(f.captures) != 0 || len(f.instructions) == 0) { kaesu iie; }\n    kaku slots = analysis.locals[f.id];\n    kaku at = 0;\n    aida (at < len(slots)) {\n        moshi (!library_scalar(analysis, slots[at]) || analysis.cells[f.id][at]) { kaesu iie; }\n        at = at + 1;\n    }\n    moshi (f.returns_value && !library_scalar(analysis, analysis.returns[f.id])) { kaesu iie; }\n    kaku block = analysis.blocks[f.id + 1];\n    at = 0;\n    aida (at < len(f.instructions)) {\n        kaku op = int64(f.instructions[at]);\n        moshi (!block.reachable[at]) { kaesu iie; }\n        kaku entries = block.entry[at];\n        kaku pos = 0;\n        aida (pos < len(entries)) {\n            moshi (!library_scalar(analysis, entries[pos])) { kaesu iie; }\n            pos = pos + 1;\n        }\n        moshi (!((op >= 1 && op <= 18) || (op >= 23 && op <= 29) || (op >= 49 && op <= 55) || op == 66)) {\n            kaesu iie;\n        }\n        // Integer division can enter the process-wide runtime error path.\n        moshi (op == 6 && types.type_kind(analysis, entries[len(entries) - 1]) == types.type_integer) { kaesu iie; }\n        moshi (op == 54 && f.instructions[at + 1] == uint8(13)) { kaesu iie; }\n        at = at + width(op);\n    }\n    kaesu hai;\n}\n\n// Existing Mio function frames are roughly 6 KiB each. Cap the static\n// call chain so a host thread can call an export on a normal Darwin stack.\nwaza bounded_library_calls(file: mochi.File, reachable: []bool) -> bool {\n    kaku depths = array.make[int64](len(file.functions), 0);\n    kaku pass = 1;\n    aida (pass <= 32) {\n        kaku pending = iie;\n        kaku id = 0;\n        aida (id < len(file.functions)) {\n            moshi (reachable[id] && depths[id] == 0) {\n                kaku ready = hai;\n                kaku data = file.functions[id].instructions;\n                kaku at = 0;\n                aida (at < len(data)) {\n                    kaku op = int64(data[at]);\n                    moshi (op == 25) {\n                        kaku depth = depths[operand_u16(data, at)];\n                        moshi (depth == 0 || depth >= pass) { ready = iie; nukeru; }\n                    }\n                    at = at + width(op);\n                }\n                moshi (ready) { depths[id] = pass; }\n                sore { pending = hai; }\n            }\n            id = id + 1;\n        }\n        moshi (!pending) { kaesu hai; }\n        pass = pass + 1;\n    }\n    kaesu iie;\n}\n\nwaza emit_export_thunk(code: arm64.Assembler, entry: types.ScalarExport) -> unit {\n    kaku signature = entry.signature;\n    emit(code, arm64.stp_pre_x(29, 30, 31, -16));\n    emit(code, arm64.add_imm_x(29, 31, 0, iie));\n    // Stage incoming GP arguments before repacking the independent C register\n    // banks into Mio's sequential machine-word calling convention.\n    emit(code, arm64.sub_imm_x(31, 31, 64, iie));\n    kaku at = 0;\n    aida (at < len(signature.parameters)) { emit(code, arm64.str_x(at, 31, at * 8)); at = at + 1; }\n    kaku gp = 0; kaku fp = 0;\n    at = 0;\n    aida (at < len(signature.parameters)) {\n        kaku kind = signature.parameters[at];\n        moshi (c_floating(kind)) {\n            kaku fp_kind = types.type_float64; moshi (kind == 105) { fp_kind = types.type_float32; }\n            fp_to(code, fp_kind, at, fp);\n            fp = fp + 1;\n        } sore {\n            emit(code, arm64.ldr_x(at, 31, gp * 8));\n            c_normalize(code, kind, at, hai);\n            gp = gp + 1;\n        }\n        at = at + 1;\n    }\n    arm64.assembler_bl(code, function_label(entry.id));\n    moshi (signature.result == 105) { fp_from(code, types.type_float32, 0, 0); }\n    moshi (signature.result == 106) { fp_from(code, types.type_float64, 0, 0); }\n    emit(code, arm64.add_imm_x(31, 31, 64, iie));\n    emit(code, arm64.ldp_post_x(29, 30, 31, 16));\n    emit(code, arm64.ret());\n}\n\nkoukai waza compile_dylib(file: mochi.File, exports: []types.ScalarExport) -> DylibCode {\n    moshi (len(exports) == 0 || len(exports) > 63 || file.global_count != 0 || len(file.instructions) != 0 ||\n        instruction_error(file) != mu) { kaesu scalar_library_failure(\"E_DYLIB expected an export list and a module without top-level execution\"); }\n    kaku at = 0;\n    aida (at < len(exports)) {\n        kaku item = exports[at];\n        moshi (item.id < 0 || item.id >= len(file.functions) || !item.signature.valid ||\n            len(item.signature.parameters) > 8 || item.signature.result == 118 ||\n            file.functions[item.id].parameter_count != len(item.signature.parameters) ||\n            !file.functions[item.id].returns_value) { kaesu scalar_library_failure(\"E_DYLIB invalid export signature\"); }\n        at = at + 1;\n    }\n    kaku analysis = types.analyze_export_types(file, exports);\n    moshi (analysis.error_detail != 0) { kaesu scalar_library_failure(\"E_DYLIB failed to analyze export bodies\"); }\n    kaku reachable = types.reachable_from(file, exports);\n    moshi (!bounded_library_calls(file, reachable)) { kaesu scalar_library_failure(\"E_DYLIB recursive or too-deep export call chain\"); }\n    kaku code = arm64.assembler();\n    kaku patches: []macho.AddressPatch = [];\n    kaku ids = string_ids(file.constants);\n    at = 0;\n    aida (at < len(file.functions)) {\n        moshi (reachable[at]) {\n            kaku f = file.functions[at];\n            moshi (!scalar_library_body(analysis, f)) {\n                kaesu scalar_library_failure(string.concat(\"E_DYLIB unsupported scalar body in \", f.name));\n            }\n            arm64.assembler_label(code, function_label(at));\n            moshi (emit_function_prologue(code, f) != mu ||\n                emit_block(code, patches, file, analysis, ids, f.instructions, string.concat(function_label(at), \"_\"), at, hai) != mu) {\n                kaesu scalar_library_failure(string.concat(\"E_DYLIB cannot lower \", f.name));\n            }\n            emit_function_epilogue(code, at);\n        }\n        at = at + 1;\n    }\n    kaku symbols: []macho.DylibExport = [\n        macho.DylibExport { name: \"_mio_module_abi_version\", word: len(code.words) },\n        macho.DylibExport { name: \"_mio_ffi_v1_g_mio_module_abi_version\", word: len(code.words) }\n    ];\n    emit(code, arm64.movz_x(0, 1, 0));\n    emit(code, arm64.ret());\n    at = 0;\n    aida (at < len(exports)) {\n        kaku item = exports[at];\n        array.push(symbols, macho.DylibExport { name: string.concat(\"_\", item.signature.symbol), word: len(code.words) });\n        array.push(symbols, macho.DylibExport { name: string.concat(\"_\", cabi.dylib_signature_marker(item.signature)), word: len(code.words) });\n        emit_export_thunk(code, item);\n        at = at + 1;\n    }\n    kaku assembled = arm64.assembler_assemble(code);\n    moshi (assembled.error != mu || len(patches) != 0) {\n        kaesu scalar_library_failure(\"E_DYLIB unresolved ARM64 fixup\");\n    }\n    kaesu DylibCode { words: assembled.words, exports: symbols, error: \"\" };\n}\n" }; }
