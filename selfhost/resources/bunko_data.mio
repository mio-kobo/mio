waza data_12() -> File { kaesu File { path: "kiso/aot/lower/memory_runtime.mio", version: "Bunko-v2.1.1", length: 6732, sha256: "c1996d997fc579e46397649680d4a99435685983f92430f2e209d9ed2777a01e", source: "// Internal policy adapters. The policy block starts at byte 2600, matching Go.\n// Committed is a conservative managed working-page charge, not physical RSS.\n// It includes both arena and sparse side-metadata prefix high-water extents,\n// fixed mapping/page overhead, and the exact rounded lengths of LOS mappings.\nteisu memory_Goal = 2600;\nteisu memory_Limit = 2608;\nteisu memory_Committed = 2616;\nteisu memory_Reserved = 2624;\nteisu memory_Rate = 2632;\nteisu memory_Level = 2640;\nteisu memory_Reason = 2648;\nteisu memory_Sequence = 2656;\nteisu memory_GCActive = 2664;\nteisu memory_ObjectLimit = 2712;\nteisu memory_LOSCommitted = 2720;\nteisu memory_HighWater = 2784;\n// OS memory pressure (sysctl kern.memorystatus_vm_pressure_level) is queried by memory.update unless the system\n// pressure state word (2752) is 2, which the policy treats as \"available, use the cached level\" (2672). memory.update\n// runs several times per allocation (362 M updates for 91 M allocations in a CLI self-build), and on macos-15 each\n// sysctl costs about 0.1 ms of kernel time, so even one query per 256 updates spent more than half of a self-build\n// in the kernel. The adapter therefore re-queries only when 1/16 s (CNTVCT ticks) has passed since the last query\n// or a collection has run, and reuses the cached level in between. The state word is restored to 1 afterwards, so\n// observed values are unchanged.\n// 2880 is unused metadata (the policy block ends at 2816; nothing in 2824..3071 is addressed): the CNTVCT tick at or\n// after which the next query is due (0 = now).\nteisu memory_SystemNextQuery = 2880;\n// 2888 (also unused, zero at start): CNTFRQ_EL0, cached on first use.\nteisu memory_CounterFrequency = 2888;\nteisu memory_SystemState = 2752;\nwaza emit_memory_adapters(code: arm64.Assembler) -> unit {\n emit_memory_policy(code);\n arm64.assembler_label(code,\"memory_sample\");\n emit(code,arm64.sub_imm_x(31,31,32,iie)); emit(code,arm64.str_x(30,31,0)); emit(code,arm64.str_x(0,31,8));\n emit(code,arm64.ldr_x(9,23,0)); emit(code,arm64.add_imm_x(10,23,3072,iie)); emit(code,arm64.sub_x(9,9,10));\n emit(code,arm64.ldr_x(11,23,memory_HighWater)); emit(code,arm64.cmp_x(9,11)); arm64.assembler_b_cond(code,2,\"memory_highwater_store\"); move_x(code,9,11);\n arm64.assembler_label(code,\"memory_highwater_store\"); emit(code,arm64.str_x(9,23,memory_HighWater));\n emit(code,arm64.movz_x(10,16383,0)); emit(code,arm64.add_x(9,9,10)); emit(code,arm64.movn_x(10,16383,0)); emit(code,arm64.and_x(9,9,10)); emit(code,arm64.add_x(9,9,9)); move_bits(code,10,uint32(0),uint32(65536)); emit(code,arm64.add_x(9,9,10));\n emit(code,arm64.ldr_x(11,23,memory_LOSCommitted)); emit(code,arm64.add_x(9,9,11)); emit(code,arm64.str_x(9,23,memory_Committed));\n emit(code,arm64.ldr_x(3,23,8)); emit(code,arm64.add_imm_x(9,23,3072,iie)); emit(code,arm64.sub_x(3,3,9));\n emit(code,arm64.add_x(9,3,3)); emit(code,arm64.add_imm_x(9,9,3072,iie)); emit(code,arm64.add_x(9,9,11)); emit(code,arm64.str_x(9,23,memory_Reserved));\n emit(code,arm64.ldr_x(9,23,memory_Reserved)); emit(code,arm64.movz_x(10,16383,0)); emit(code,arm64.add_x(9,9,10)); emit(code,arm64.movn_x(10,16383,0)); emit(code,arm64.and_x(9,9,10)); emit(code,arm64.str_x(9,23,memory_Reserved)); emit(code,arm64.ldr_x(10,23,memory_Committed)); emit(code,arm64.cmp_x(10,9)); arm64.assembler_b_cond(code,9,\"memory_charge_bounded\"); emit(code,arm64.str_x(9,23,memory_Committed));\n arm64.assembler_label(code,\"memory_charge_bounded\");\n move_x(code,0,23); emit(code,arm64.ldr_x(1,23,304)); emit(code,arm64.ldr_x(2,23,296));\n // x4 = CNTFRQ_EL0, read once: the register is constant, but on virtualized macOS hosts the read traps (a sampled\n // macos-15 self-build spent 10% of its time on this instruction, executed twice per allocation).\n emit(code,arm64.ldr_x(4,23,memory_CounterFrequency)); arm64.assembler_cbnz_x(code,4,\"memory_frequency_ready\");\n observation_word(code,3577470980); emit(code,arm64.str_x(4,23,memory_CounterFrequency)); // MRS x4, CNTFRQ_EL0\n arm64.assembler_label(code,\"memory_frequency_ready\"); emit(code,arm64.ldr_x(5,23,872)); emit(code,arm64.ldr_x(6,23,2800));\n emit(code,arm64.ldr_x(9,23,memory_SystemState)); emit(code,arm64.cmp_imm_x(9,1,iie)); arm64.assembler_b_cond(code,1,\"memory_sample_update\");\n observation_word(code,3577471050); // MRS x10, CNTVCT_EL0\n emit(code,arm64.ldr_x(11,23,memory_SystemNextQuery)); emit(code,arm64.cmp_x(10,11)); arm64.assembler_b_cond(code,2,\"memory_sample_refresh\");\n emit(code,arm64.movz_x(9,2,0)); emit(code,arm64.str_x(9,23,memory_SystemState)); arm64.assembler_b(code,\"memory_sample_update\");\n arm64.assembler_label(code,\"memory_sample_refresh\");\n emit(code,arm64.ldr_x(11,23,memory_CounterFrequency)); // cached CNTFRQ_EL0 (set above)\n emit(code,arm64.lsr_x(11,11,4)); emit(code,arm64.add_x(11,10,11)); emit(code,arm64.str_x(11,23,memory_SystemNextQuery));\n arm64.assembler_label(code,\"memory_sample_update\");\n arm64.assembler_bl(code,\"memory.update\");\n emit(code,arm64.ldr_x(9,23,memory_SystemState)); emit(code,arm64.cmp_imm_x(9,2,iie)); arm64.assembler_b_cond(code,1,\"memory_sample_state\");\n emit(code,arm64.movz_x(9,1,0)); emit(code,arm64.str_x(9,23,memory_SystemState));\n arm64.assembler_label(code,\"memory_sample_state\");\n emit(code,arm64.ldr_x(9,23,memory_Goal)); arm64.assembler_cbnz_x(code,9,\"memory_sample_done\");\n move_x(code,0,23); emit(code,arm64.movz_x(1,0,0)); emit(code,arm64.movz_x(2,0,0)); arm64.assembler_bl(code,\"memory.goal\");\n arm64.assembler_label(code,\"memory_sample_done\"); emit(code,arm64.ldr_x(0,31,8)); emit(code,arm64.ldr_x(30,31,0)); emit(code,arm64.add_imm_x(31,31,32,iie)); emit(code,arm64.ret());\n arm64.assembler_label(code,\"memory_grow\"); // payload request in x0\n emit(code,arm64.sub_imm_x(31,31,32,iie)); emit(code,arm64.str_x(30,31,0)); emit(code,arm64.str_x(0,31,8));\n emit(code,arm64.add_imm_x(2,0,31,iie)); emit(code,arm64.movn_x(9,15,0)); emit(code,arm64.and_x(2,2,9)); emit(code,arm64.ldr_x(1,23,304)); move_x(code,0,23); arm64.assembler_bl(code,\"memory.goal\");\n emit(code,arm64.ldr_x(0,31,8)); emit(code,arm64.ldr_x(30,31,0)); emit(code,arm64.add_imm_x(31,31,32,iie)); emit(code,arm64.ret());\n arm64.assembler_label(code,\"memory_aftergc\");\n emit(code,arm64.sub_imm_x(31,31,32,iie)); emit(code,arm64.str_x(30,31,0)); emit(code,arm64.str_x(0,31,8)); emit(code,arm64.str_x(31,23,memory_GCActive));\n emit(code,arm64.str_x(31,23,memory_SystemNextQuery)); // a collection always refreshes the OS pressure level\n arm64.assembler_bl(code,\"memory_sample\");\n move_x(code,0,23); emit(code,arm64.ldr_x(1,23,304)); emit(code,arm64.movz_x(2,0,0)); arm64.assembler_bl(code,\"memory.goal\");\n emit(code,arm64.ldr_x(0,31,8)); emit(code,arm64.ldr_x(30,31,0)); emit(code,arm64.add_imm_x(31,31,32,iie)); emit(code,arm64.ret());\n}\n" }; }
waza data_13() -> File { kaesu File { path: "kiso/aot/lower/nativefs/nativefs.mio", version: "Bunko-v2.1.1", length: 53040, sha256: "f7a5c8c3fc8c0a6c140152515971369f1bb45bae3071eaab5b62b53724da5674", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/string\";\n\n// Pure-Mio Darwin/ARM64 bridge for the exact NativeFS MMA bindings emitted by\n// selfhost/bootstrap.  Recognition includes the signature fingerprint: a\n// body-less function with only a matching operation name is never accepted.\nkoukai teisu op_none = 0;\nkoukai teisu op_close = 1;\nkoukai teisu op_dir_close = 2;\nkoukai teisu op_dir_is_dir = 3;\nkoukai teisu op_dir_is_file = 4;\nkoukai teisu op_dir_name = 5;\nkoukai teisu op_dir_next = 6;\nkoukai teisu op_dir_status = 7;\nkoukai teisu op_file_status = 8;\nkoukai teisu op_mkdir = 9;\nkoukai teisu op_open = 10;\nkoukai teisu op_open_dir = 11;\nkoukai teisu op_read = 12;\nkoukai teisu op_stat = 13;\nkoukai teisu op_write = 14;\n\nkoukai waza operation(name: string) -> int64 {\n    moshi (name == \"$mma::mio/sys/socket::open::2bd390f6a00486b5badde861e398d7014c8e331b8946668924bd7048c8bd76d7\") { kaesu 32; }\n    moshi (name == \"$mma::mio/sys/socket::status::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93\") { kaesu 33; }\n    moshi (name == \"$mma::mio/sys/socket::bind_ipv4::f5e8d492393d1d5f642e3573af501663920a9be9788fbeda8b1f38deb28ffecd\") { kaesu 34; }\n    moshi (name == \"$mma::mio/sys/socket::connect_ipv4::f5e8d492393d1d5f642e3573af501663920a9be9788fbeda8b1f38deb28ffecd\") { kaesu 35; }\n    moshi (name == \"$mma::mio/sys/socket::listen::0a2af19668a171e5f7f873b1d1a23a4d3ebe7ca1f73a074d7b75234419859515\") { kaesu 36; }\n    moshi (name == \"$mma::mio/sys/socket::accept::3a6d99e54aef1b988c4bc8780939e06e8558ca5116f17980850557fbe5abc4d4\") { kaesu 37; }\n    moshi (name == \"$mma::mio/sys/socket::read::e8706d18fa932e83ff56c940a8552084a64d75a1d0629364439b5e079ca29430\") { kaesu 38; }\n    moshi (name == \"$mma::mio/sys/socket::write::e8706d18fa932e83ff56c940a8552084a64d75a1d0629364439b5e079ca29430\") { kaesu 39; }\n    moshi (name == \"$mma::mio/sys/socket::close::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93\") { kaesu 40; }\n    moshi (name == \"$mma::mio/fs/runtime::close::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93\") { kaesu op_close; }\n    moshi (name == \"$mma::mio/fs/runtime::dir_close::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93\") { kaesu op_dir_close; }\n    moshi (name == \"$mma::mio/fs/runtime::dir_is_dir::c9ff387755a05bfa435b60b204111ffc83a5f199b21f569f6673482e3a103ca6\") { kaesu op_dir_is_dir; }\n    moshi (name == \"$mma::mio/fs/runtime::dir_is_file::c9ff387755a05bfa435b60b204111ffc83a5f199b21f569f6673482e3a103ca6\") { kaesu op_dir_is_file; }\n    moshi (name == \"$mma::mio/fs/runtime::dir_name::ca5c10cb23a1dc4f8d7120a05626b664f700151ff09870e6a2a9204b890efa7c\") { kaesu op_dir_name; }\n    moshi (name == \"$mma::mio/fs/runtime::dir_next::c9ff387755a05bfa435b60b204111ffc83a5f199b21f569f6673482e3a103ca6\") { kaesu op_dir_next; }\n    moshi (name == \"$mma::mio/fs/runtime::dir_status::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93\") { kaesu op_dir_status; }\n    moshi (name == \"$mma::mio/fs/runtime::file_status::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93\") { kaesu op_file_status; }\n    moshi (name == \"$mma::mio/fs/runtime::mkdir::6f2c95561ed64afe3034886f256d86934e0ad43ef1d605224b7f6d40167a9946\") { kaesu op_mkdir; }\n    moshi (name == \"$mma::mio/fs/runtime::open::1192df94a5bdf48f4df10a0aa4b61147cfc2e6f2c2f8ea1248826e517f716633\") { kaesu op_open; }\n    moshi (name == \"$mma::mio/fs/runtime::open_dir::7128dadd824bee38c385b052b0d86ff37b801ae61b35c36db664b2d310b6dbdf\") { kaesu op_open_dir; }\n    moshi (name == \"$mma::mio/fs/runtime::read::e8706d18fa932e83ff56c940a8552084a64d75a1d0629364439b5e079ca29430\") { kaesu op_read; }\n    moshi (name == \"$mma::mio/fs/runtime::stat::6f2c95561ed64afe3034886f256d86934e0ad43ef1d605224b7f6d40167a9946\") { kaesu op_stat; }\n    moshi (name == \"$mma::mio/fs/runtime::write::e8706d18fa932e83ff56c940a8552084a64d75a1d0629364439b5e079ca29430\") { kaesu op_write; }\n    moshi (name == \"$mma::mio/os/runtime::argc::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2\") { kaesu 15; }\n    moshi (name == \"$mma::mio/os/runtime::arg_size::ef54322c57791e5008c09839db29d0913e109a8d2c1ed9b499ed05a73016289c\") { kaesu 16; }\n    moshi (name == \"$mma::mio/os/runtime::arg_copy::70ac3b361d4ba108aeefdd952d76d4590a62bb1ce0a04031189b6b1dc7419a6d\") { kaesu 17; }\n    moshi (name == \"$mma::mio/os/runtime::chmod::61215f13826fb0c45557e17ebf8aee362b6cfb0d3b2d7f437f7946c1a407f361\") { kaesu 18; }\n    moshi (name == \"$mma::mio/os/runtime::exit::ef54322c57791e5008c09839db29d0913e109a8d2c1ed9b499ed05a73016289c\") { kaesu 19; }\n    moshi (name == \"$mma::mio/os/runtime::spawn::555acc9cd6915c133a226b6aa37175af19e84fed7e725f4199a2dec2d98ab4eb\") { kaesu 20; }\n    moshi (name == \"$mma::mio/os/runtime::exec::555acc9cd6915c133a226b6aa37175af19e84fed7e725f4199a2dec2d98ab4eb\") { kaesu 21; }\n    moshi (name == \"$mma::mio/os/runtime::pid::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2\") { kaesu 22; }\n    moshi (name == \"$mma::mio/os/runtime::remove::195aa2406eb132812cd197e0d54d8f0ef64515accac66d0fc6e2cfd3835d892b\") { kaesu 23; }\n    moshi (name == \"$mma::mio/os/runtime::rmdir::195aa2406eb132812cd197e0d54d8f0ef64515accac66d0fc6e2cfd3835d892b\") { kaesu 24; }\n    moshi (name == \"$mma::mio/os/runtime::spawn_test::37cce6b035b8405afd5f3ab3e07963f5a23d78f9a2a2205d364e0f72c317b660\") { kaesu 25; }\n    moshi (name == \"$mma::mio/os/runtime::monotonic_ms::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2\") { kaesu 26; }\n    moshi (name == \"$mma::mio/os/runtime::env_size::195aa2406eb132812cd197e0d54d8f0ef64515accac66d0