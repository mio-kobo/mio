de, x86_64.r9, x86_64.rax);\n    x86_64.shr_ri(code, x86_64.r9, 3);\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.label(code, \"rt.alloc.zero_loop\");\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.rcx);\n    x86_64.add_ri(code, x86_64.r8, 8);\n    x86_64.sub_ri(code, x86_64.r9, 1);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.alloc.zero_loop\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.pop_r(code, x86_64.r10);\n    x86_64.pop_r(code, x86_64.r9);\n    x86_64.ret(code);\n    // bump allocation from untouched (already zero) memory\n    x86_64.label(code, \"rt.alloc.bump\");\n    x86_64.mov_data(code, x86_64.rcx, elf.data_base);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 0);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.mov_load(code, x86_64.r8, x86_64.rcx, 8);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.trap.memory\");\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.pop_r(code, x86_64.r10);\n    x86_64.pop_r(code, x86_64.r9);\n    x86_64.ret(code);\n}\n\n// rt.gc_mark: rdi = candidate pointer. Marks heap objects and queues them; ignores 0, constants and misaligned values.\n// Clobbers rax, rcx, rdx only.\nwaza emit_gc_mark(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.gc_mark\");\n    x86_64.mov_data(code, x86_64.rcx, gc_state());\n    x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 24);\n    x86_64.cmp_rr(code, x86_64.rdi, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.gc_mark.done\");\n    x86_64.mov_data(code, x86_64.rdx, elf.data_base);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rdx, 0);\n    x86_64.cmp_rr(code, x86_64.rdi, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_ae, \"rt.gc_mark.done\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rdi);\n    x86_64.and_ri(code, x86_64.rax, 7);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.gc_mark