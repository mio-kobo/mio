waza data_47() -> File { kaesu File { path: "kiso/aot/macho/macho.mio", version: "Bunko-v2.1.1", length: 18185, sha256: "c06776b1ab7acd871ee8bf93c876da9458b691013aeab7a7b665f27f0c7ecad3", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/array\";\nyobu \"kiso/encoding/binary\";\n\n// Pure Mio Darwin ARM64 Mach-O writer. The layout intentionally mirrors the\n// proven Go AOT writer; relocation records remain empty because every label and\n// image-address patch is resolved before the file is emitted.\nkoukai sentaku MachOError {\n    EmptyText;\n    TooManyGlobals;\n    ImageTooLarge;\n    LoadCommandsTooLarge;\n    InvalidPatch;\n    EncodeFailure;\n    WriteFailure;\n}\n\nkoukai kata AddressTarget { kind: int64; }\nkoukai waza text_target() -> AddressTarget { kaesu AddressTarget { kind: 0 }; }\nkoukai waza const_target() -> AddressTarget { kaesu AddressTarget { kind: 1 }; }\nkoukai waza data_target() -> AddressTarget { kaesu AddressTarget { kind: 2 }; }\nkoukai kata AddressPatch { at_word: int64; add_at_word: int64; target: AddressTarget; target_offset: int64; register: int64; }\nkoukai kata Section { segment: string; name: string; file_offset: int64; vm_offset: int64; size: int64; alignment: int64; }\nkoukai kata Symbol { name: string; section: int64; value: int64; }\nkoukai kata Relocation { section: int64; offset: int64; symbol: int64; pc_relative: bool; width: int64; }\nkoukai kata Layout { text_size: int64; const_offset: int64; data_offset: int64; linkedit_offset: int64; file_size: int64; sections: []Section; }\nkoukai kata ImageSpec { words: []uint32; constants: []uint8; globals: int64; patches: []AddressPatch; }\nkoukai kata ImageResult { bytes: []uint8; layout: Layout; error: MachOError?; }\n\nteisu page_size = 16384;\nteisu entry_offset = 768;\nteisu maximum_image_size = 67108864;\n\nwaza align(value: int64, boundary: int64) -> int64 {\n    kaku remainder = value - (value / boundary) * boundary;\n    moshi (remainder == 0) { kaesu value; }\n    kaesu value + boundary - remainder;\n}\n\nkoukai waza plan(code_size: int64, const_size: int64, globals: int64) -> Layout {\n    kaku const_offset = align(entry_offset + code_size, 8);\n    kaku text_end = entry_offset + code_size;\n    moshi (const_size > 0) { text_end = const_offset + const_size; }\n    kaku text_size = align(text_end, page_size);\n    kaku data_size = 0; moshi (globals > 0) { data_size = align(globals * 8, page_size); }\n    kaku sections = array.with_capacity[Section](3);\n    array.push(sections, Section { segment: \"__TEXT\", name: \"__text\", file_offset: entry_offset, vm_offset: entry_offset, size: code_size, alignment: 2 });\n    moshi (const_size > 0) { array.push(sections, Section { segment: \"__TEXT\", name: \"__const\", file_offset: const_offset, vm_offset: const_offset, size: const_size, alignment: 3 }); }\n    moshi (globals > 0) { array.push(sections, Section { segment: \"__DATA\", name: \"__data\", file_offset: text_size, vm_offset: text_size, size: globals * 8, alignment: 3 }); }\n    kaesu Layout { text_size: text_size, const_offset: const_offset, data_offset: text_size, linkedit_offset: text_size + data_size, file_size: text_size + data_size, sections: sections };\n}\n\nwaza binary_failure(problem: binary.BinaryError?) -> MachOError? {\n    moshi (problem != mu) { kaesu MachOError.WriteFailure(); }\n    kaesu mu;\n}\nwaza put32(output: binary.BinaryWriter, value: int64) -> MachOError? {\n    moshi (value < 0 || value > 4294967295) { kaesu MachOError.WriteFailure(); }\n    kaesu binary_failure(binary.writer_write_u32_le(output, uint32(value)));\n}\nwaza put64(output: binary.BinaryWriter, high: int64, low: int64) -> MachOError? {\n    moshi (high < 0 || high > 4294967295 || low < 0 || low > 4294967295) { kaesu MachOError.WriteFailure(); }\n    kaesu binary_failure(binary.writer_write_u64_le(output, binary.U64 { high: uint32(high), low: uint32(low) }));\n}\nwaza put_bytes(output: binary.BinaryWriter, value: []uint8) -> MachOError? { kaesu binary_failure(binary.writer_write_bytes(output, value)); }\nwaza zeros(output: binary.BinaryWriter, count: int64) -> MachOError? { kaesu binary_failure(binary.writer_reserve(output, count).error); }\n\nwaza name16(output: binary.BinaryWriter, value: []uint8) -> MachOError? {\n    moshi (len(value) > 16) { kaesu MachOError.WriteFailure(); }\n    kaku failure = put_bytes(output, value); moshi (failure != mu) { kaesu failure; }\n    kaesu zeros(output, 16 - len(value));\n}\n\nwaza segment(output: binary.BinaryWriter, name: []uint8, vm_high: int64, vm_low: int64, vm_size_high: int64, vm_size: int64,\n             file_offset: int64, file_size: int64, max_protection: int64, initial_protection: int64,\n             section_count: int64, command_size: int64) -> MachOError? {\n    kaku failure = put32(output, 25); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, command_size); moshi (failure != mu) { kaesu failure; }\n    failure = name16(output, name); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, vm_high, vm_low); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, vm_size_high, vm_size); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, 0, file_offset); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, 0, file_size); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, max_protection); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, initial_protection); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, section_count); moshi (failure != mu) { kaesu failure; }\n    kaesu put32(output, 0);\n}\n\nwaza section(output: binary.BinaryWriter, section_name: []uint8, segment_name: []uint8,\n             vm_low: int64, size: int64, file_offset: int64, alignment: int64, flags: int64) -> MachOError? {\n    kaku failure = name16(output, section_name); moshi (failure != mu) { kaesu failure; }\n    failure = name16(output, segment_name); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, 1, vm_low); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, 0, size); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, file_offset); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, alignment); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, flags); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu failure; }\n    kaesu put32(output, 0);\n}\n\nwaza target_is_const(value: AddressTarget) -> bool { kaesu value.kind == 1; }\nwaza target_is_data(value: AddressTarget) -> bool { kaesu value.kind == 2; }\nwaza target_is_text(value: AddressTarget) -> bool { kaesu value.kind == 0; }\n\nwaza patch_words(spec: ImageSpec, layout: Layout) -> ImageResult {\n    kaku words = array.clone(spec.words);\n    kaku index = 0;\n    aida (index < len(spec.patches)) {\n        kaku patch = spec.patches[index];\n        moshi (patch.at_word < 0 || patch.at_word >= len(words) || patch.target_offset < 0) {\n            kaesu ImageResult { bytes: [], layout: layout, error: MachOError.InvalidPatch() };\n        }\n        moshi (patch.target.kind < 0 || patch.target.kind > 2) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.InvalidPatch() }; }\n        kaku target = entry_offset + patch.target_offset;\n        moshi (target_is_const(patch.target)) { target = layout.const_offset + patch.target_offset; }\n        moshi (target_is_data(patch.target)) { target = layout.data_offset + patch.target_offset; }\n        moshi ((target_is_text(patch.target) && patch.target_offset >= len(spec.words) * 4) ||\n               (target_is_const(patch.target) && patch.target_offset >= len(spec.constants)) ||\n               (target_is_data(patch.target) && patch.target_offset >= spec.globals * 8)) {\n            kaesu ImageResult { bytes: [], layout: layout, error: MachOError.InvalidPatch() };\n        }\n        kaku encoded = arm64.adrp_offset(patch.register, entry_offset + patch.at_word * 4, target);\n        moshi (encoded.error != mu) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.EncodeFailure() }; }\n        words[patch.at_word] = encoded.word;\n        moshi (patch.add_at_word >= 0) {\n            moshi (patch.add_at_word >= len(words) || patch.add_at_word == patch.at_word) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.InvalidPatch() }; }\n            kaku low = target - (target / 4096) * 4096;\n            kaku addition = arm64.add_imm_x(patch.register, patch.register, low, iie);\n            moshi (addition.error != mu) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.EncodeFailure() }; }\n            words[patch.add_at_word] = addition.word;\n        }\n        index = index + 1;\n    }\n    // An internal helper result uses bytes as a little-endian word stream.\n    kaku temp = binary.writer(len(words) * 4);\n    index = 0;\n    aida (index < len(words)) {\n        moshi (binary.writer_write_u32_le(temp, words[index]) != mu) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.WriteFailure() }; }\n        index = index + 1;\n    }\n    kaesu ImageResult { bytes: binary.writer_bytes(temp), layout: layout, error: mu };\n}\n\nkoukai waza executable(spec: ImageSpec) -> ImageResult { kaesu executable_bounded(spec,2052); }\n// Keep the source-language/private ABI global envelope intact. A target runtime\n// may append separately owned words; it may not consume existing user slots.\nkoukai waza executable_with_runtime_data(spec: ImageSpec, runtime_words: int64) -> ImageResult {\n    moshi(spec.globals<0 || spec.globals>2052 || runtime_words<0 || runtime_words>8192){\n        kaesu ImageResult {bytes:[],layout:plan(0,0,0),error:MachOError.TooManyGlobals()};\n    }\n    kaesu executable_bounded(ImageSpec {words:spec.words,constants:spec.constants,\n        globals:spec.globals+runtime_words,patches:spec.patches},10244);\n}\nwaza executable_bounded(spec: ImageSpec, maximum_globals:int64) -> ImageResult {\n    kaku empty_layout = plan(0, 0, 0);\n    moshi (len(spec.words) == 0) { kaesu ImageResult { bytes: [], layout: empty_layout, error: MachOError.EmptyText() }; }\n    // The lowerer still enforces 2048 user globals. Four private ABI words\n    // preserve that capacity when assertion reporting and OS arguments coexist.\n    moshi (spec.globals < 0 || spec.globals > maximum_globals) { kaesu ImageResult { bytes: [], layout: empty_layout, error: MachOError.TooManyGlobals() }; }\n    moshi (len(spec.words) > (maximum_image_size - entry_offset) / 4 || len(spec.constants) > maximum_image_size) {\n        kaesu ImageResult { bytes: [], layout: empty_layout, error: MachOError.ImageTooLarge() };\n    }\n    kaku layout = plan(len(spec.words) * 4, len(spec.constants), spec.globals);\n    moshi (layout.file_size > maximum_image_size) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.ImageTooLarge() }; }\n    kaku patched = patch_words(spec, layout);\n    moshi (patched.error != mu) { kaesu patched; }\n\n    kaku has_const = len(spec.constants) > 0;\n    kaku has_data = spec.globals > 0;\n    kaku text_command_size = 152; moshi (has_const) { text_command_size = 232; }\n    kaku command_size = 72 + text_command_size + 72 + 32 + 24 + 24 + 80 + 24;\n    kaku command_count = 8;\n    moshi (has_data) { command_size = command_size + 152; command_count = 9; }\n    moshi (32 + command_size + 16 > entry_offset) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.LoadCommandsTooLarge() }; }\n\n    kaku output = binary.writer(layout.file_size);\n    kaku failure = put32(output, 4277009103); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 16777228); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 2); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, command_count); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, command_size); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 2097285); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    failure = segment(output, [95,95,80,65,71,69,90,69,82,79], 0, 0, 1, 0, 0, 0, 0, 0, 0, 72);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    kaku text_sections = 1; moshi (has_const) { text_sections = 2; }\n    failure = segment(output, [95,95,84,69,88,84], 1, 0, 0, layout.text_size, 0, layout.text_size, 5, 5, text_sections, text_command_size);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = section(output, [95,95,116,101,120,116], [95,95,84,69,88,84], entry_offset, len(spec.words) * 4, entry_offset, 2, 2147484672);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    moshi (has_const) {\n        failure = section(output, [95,95,99,111,110,115,116], [95,95,84,69,88,84], layout.const_offset, len(spec.constants), layout.const_offset, 3, 0);\n        moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    }\n    moshi (has_data) {\n        failure = segment(output, [95,95,68,65,84,65], 1, layout.data_offset, 0, layout.linkedit_offset - layout.data_offset, layout.data_offset, layout.linkedit_offset - layout.data_offset, 3, 3, 1, 152);\n        moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n        failure = section(output, [95,95,100,97,116,97], [95,95,68,65,84,65], layout.data_offset, spec.globals * 8, layout.data_offset, 3, 0);\n        moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    }\n    failure = segment(output, [95,95,76,73,78,75,69,68,73,84], 1, layout.linkedit_offset, 0, page_size, layout.linkedit_offset, 0, 1, 1, 0, 72);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    // LC_LOAD_DYLINKER, command size 32, path offset 12.\n    failure = put32(output, 14); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 32); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 12); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put_bytes(output, [47,117,115,114,47,108,105,98,47,100,121,108,100,0]); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = zeros(output, 6); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    // LC_BUILD_VERSION: macOS 11.0, no tool records.\n    failure = put32(output, 50); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 24); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 1); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 720896); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 720896); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    // Empty LC_SYMTAB and LC_DYSYMTAB. All pure-Mio fixups are already final.\n    failure = put32(output, 2); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 24); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = zeros(output, 16); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 11); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 80); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = zeros(output, 72); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    failure = put32(output, 2147483688); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 24); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put64(output, 0, entry_offset); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put64(output, 0, 0); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    failure = zeros(output, entry_offset - binary.writer_offset(output)); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put_bytes(output, patched.bytes); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = zeros(output, layout.const_offset - binary.writer_offset(output)); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    moshi (has_const) { failure = put_bytes(output, spec.constants); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; } }\n    failure = zeros(output, layout.file_size - binary.writer_offset(output)); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    kaesu ImageResult { bytes: binary.writer_bytes(output), layout: layout, error: mu };\n}\n" }; }
waza data_48() -> File { kaesu File { path: "kiso/aot/machox64/machox64.mio", version: "Bunko-v2.1.1", length: 6305, sha256: "f2e168460ff8bf9f38fd50ed38a22051821c15a8b60a4e440df6a6999b7aaea1", source: "yobu \"kiso/aot/elf\";\nyobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// Pure Mio macOS x86-64 Mach-O (MH_EXECUTE) writer for the Linux-convention x86-64 lowering (kiso/aot/lowerlinux).\n//\n// The image keeps the ELF writer's fixed, position-dependent addresses so the lowered code needs no relocation:\n//   __PAGEZERO  0x0 .. 0x400000                       (no access)\n//   __TEXT      vm 0x400000 (file 0): header, load commands and the code at file offset 0x1000   r-x\n//   __DATA      vm 0x10000000, zero-fill (no file bytes)                                          rw-\n//   __LINKEDIT  after __DATA (empty)\n// Load commands: LC_LOAD_DYLINKER /usr/lib/dyld, LC_BUILD_VERSION (macOS minos 11.0), empty LC_SYMTAB/LC_DYSYMTAB and\n// LC_MAIN. The header has no MH_PIE flag: x86-64 macOS runs fixed-address executables. cputype is CPU_TYPE_X86_64\n// (0x01000007) and cpusubtype CPU_SUBTYPE_X86_64_ALL (3). dyld enters at LC_MAIN's entryoff with the C calling\n// convention main(argc, argv, envp); the caller of this writer is responsible for the first instructions at the entry.\nkoukai teisu text_base = 4194304;\nkoukai teisu code_offset = 4096;\nkoukai teisu data_base = 268435456;\nteisu page_size = 4096;\nteisu maximum_text_size = 264241152;\nteisu maximum_bss_size = 268435456;\nteisu header_size = 32;\n\nkoukai kata ImageSpec { code: []uint8; entry_offset: int64; bss_size: int64; }\nkoukai kata ImageResult { bytes: []uint8; error: string; }\n\nwaza put(out: []uint8, value: int64, width: int64) -> unit {\n    kaku x = value; moshi (x < 0) { x = x + 4294967296; }\n    kaku i = 0;\n    aida (i < width) { array.push(out, uint8(x - (x / 256) * 256)); x = x / 256; i = i + 1; }\n}\n// 64-bit values below 2^62 as two halves\nwaza put64(out: []uint8, value: int64) -> unit { put(out, value - (value / 4294967296) * 4294967296, 4); put(out, value / 4294967296, 4); }\nwaza name16(out: []uint8, text: string) -> unit {\n    kaku bytes = string.to_bytes(text); array.append_all(out, bytes);\n    kaku n = len(bytes); aida (n < 16) { array.push(out, uint8(0)); n = n + 1; }\n}\nwaza align(value: int64, boundary: int64) -> int64 {\n    kaku r = value - (value / boundary) * boundary;\n    moshi (r == 0) { kaesu value; }\n    kaesu value + boundary - r;\n}\n// LC_SEGMENT_64: name, vmaddr, vmsize, fileoff, filesize, maxprot, initprot, nsects (command size 72 + 80 * nsects)\nwaza segment(out: []uint8, name: string, vmaddr: int64, vmsize: int64, fileoff: int64, filesize: int64, maxprot: int64, initprot: int64, sections: int64) -> unit {\n    put(out, 25, 4); put(out, 72 + 80 * sections, 4); name16(out, name); put64(out, vmaddr); put64(out, vmsize); put64(out, fileoff); put64(out, filesize);\n    put(out, maxprot, 4); put(out, initprot, 4); put(out, sections, 4); put(out, 0, 4);\n}\nwaza section(out: []uint8, name: string, segment_name: string, addr: int64, size: int64, offset: int64, alignment: int64, flags: int64) -> unit {\n    name16(out, name); name16(out, segment_name); put64(out, addr); put64(out, size); put(out, offset, 4); put(out, alignment, 4);\n    put(out, 0, 4); put(out, 0, 4); put(out, flags, 4); put(out, 0, 4); put(out, 0, 4); put(out, 0, 4);\n}\n\nkoukai waza executable(spec: ImageSpec) -> ImageResult {\n    moshi (len(spec.code) == 0) { kaesu ImageResult { bytes: [], error: \"EMPTY_TEXT\" }; }\n    moshi (spec.entry_offset < 0 || spec.entry_offset >= len(spec.code)) { kaesu ImageResult { bytes: [], error: \"INVALID_ENTRY\" }; }\n    moshi (spec.bss_size < 0 || spec.bss_size > maximum_bss_size) { kaesu ImageResult { bytes: [], error: \"INVALID_BSS\" }; }\n    kaku text_end = code_offset + len(spec.code);\n    moshi (text_end > maximum_text_size) { kaesu ImageResult { bytes: [], error: \"IMAGE_TOO_LARGE\" }; }\n    kaku file_size = align(text_end, page_size);\n    kaku has_data = spec.bss_size > 0;\n    kaku data_size = align(spec.bss_size, page_size);\n    kaku commands = 8;\n    moshi (has_data) { commands = commands + 1; }\n    // 8 commands without __DATA (PAGEZERO, TEXT, LINKEDIT, DYLINKER, BUILD_VERSION, SYMTAB, DYSYMTAB, MAIN), 9 with it.\n    // sizes: PAGEZERO 72, TEXT 72+80, DATA 72+80, LINKEDIT 72, DYLINKER 32, BUILD_VERSION 24, SYMTAB 24, DYSYMTAB 80, MAIN 24\n    kaku command_bytes = 72 + 152 + 72 + 32 + 24 + 24 + 80 + 24;\n    moshi (has_data) { command_bytes = command_bytes + 152; }\n    moshi (header_size + command_bytes > code_offset) { kaesu ImageResult { bytes: [], error: \"LOAD_COMMANDS_TOO_LARGE\" }; }\n    kaku out: []uint8 = array.with_capacity[uint8](file_size);\n    // mach_header_64\n    put(out, 4277009103, 4); put(out, 16777223, 4); put(out, 3, 4); put(out, 2, 4);\n    put(out, commands, 4); put(out, command_bytes, 4); put(out, 133, 4); put(out, 0, 4);\n    segment(out, \"__PAGEZERO\", 0, text_base, 0, 0, 0, 0, 0);\n    segment(out, \"__TEXT\", text_base, file_size, 0, file_size, 5, 5, 1);\n    section(out, \"__text\", \"__TEXT\", text_base + code_offset, len(spec.code), code_offset, 4, 2147484672);\n    kaku linkedit_vm = text_base + file_size;\n    moshi (has_data) {\n        segment(out, \"__DATA\", data_base, data_size, 0, 0, 3, 3, 1);\n        section(out, \"__bss\", \"__DATA\", data_base, spec.bss_size, 0, 3, 1);\n        linkedit_vm = data_base + data_size;\n    }\n    segment(out, \"__LINKEDIT\", linkedit_vm, page_size, file_size, 0, 1, 1, 0);\n    // LC_LOAD_DYLINKER \"/usr/lib/dyld\"\n    put(out, 14, 4); put(out, 32, 4); put(out, 12, 4); array.append_all(out, string.to_bytes(\"/usr/lib/dyld\"));\n    kaku pad = 0; aida (pad < 7) { array.push(out, uint8(0)); pad = pad + 1; }\n    // LC_BUILD_VERSION: platform macOS (1), minos 11.0, sdk 11.0, no tools\n    put(out, 50, 4); put(out, 24, 4); put(out, 1, 4); put(out, 720896, 4); put(out, 720896, 4); put(out, 0, 4);\n    // empty LC_SYMTAB and LC_DYSYMTAB\n    put(out, 2, 4); put(out, 24, 4); kaku z = 0; aida (z < 16) { array.push(out, uint8(0)); z = z + 1; }\n    put(out, 11, 4); put(out, 80, 4); z = 0; aida (z < 72) { array.push(out, uint8(0)); z = z + 1; }\n    // LC_MAIN: entryoff (file offset of the entry), stacksize 0\n    put(out, 2147483688, 4); put(out, 24, 4); put64(out, code_offset + spec.entry_offset); put64(out, 0);\n    aida (len(out) < code_offset) { array.push(out, uint8(0)); }\n    array.append_all(out, spec.code);\n    aida (len(out) < file_size) { array.push(out, uint8(0)); }\n    kaesu ImageResult { bytes: out, error: \"\" };\n}\n" }; }
waza data_49() -> File { kaesu File { path: "kiso/aot/pe/pe.mio", version: "Bunko-v2.1.1", length: 21352, sha256: "cc07719eba8f08004a4f60e636deab2e5b64e0bc6b5cead777ee44a9149d1997", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// PE32+ image writer only: no instruction selection, host I/O or linker process.\nkoukai teisu text_section = 1;\nkoukai teisu rdata_section = 2;\nkoukai teisu data_section = 3;\nkoukai teisu import_section = 4;\nkoukai teisu rva32 = 1;\nkoukai teisu rel32 = 2;\nkoukai teisu va64 = 3;\nkoukai teisu image_base = 5368709120;\nkoukai teisu file_alignment = 512;\nkoukai teisu section_alignment = 4096;\nkoukai teisu maximum_image_size = 67108864;\n\nkoukai sentaku PEError {\n    EmptyText; InvalidEntry; ImageTooLarge; InvalidImport; InvalidPatch; InvalidUnwind;\n}\nkoukai kata ImportLibrary { name:string; symbols:[]string; }\n// Source offsets are within initialized bytes. Target offsets are within the\n// virtual section; import_section instead uses a flattened zero-based IAT index.\nkoukai kata Patch { section:int64; offset:int64; kind:int64; target:int64; target_offset:int64; }\n// Bounded unwind model: no frame pointer, handlers or nonvolatile saves yet.\n// stack_offset is the offset AFTER the single stack allocation instruction.\nkoukai kata UnwindFunction { begin:int64; end:int64; prolog_size:int64; stack_size:int64; stack_offset:int64; }\n// Frame-pointer function: `push rbp` (offsets are AFTER each instruction), `mov rbp,rsp`, optional\n// `sub rsp,alloc_size`. alloc_size==0 means no allocation and alloc_offset must be 0.\n// Unwind recovers RSP from RBP (FrameOffset 0), so later dynamic pushes and `and rsp,-16` are covered.\nkoukai kata FrameFunction { begin:int64; end:int64; push_offset:int64; set_offset:int64; alloc_offset:int64; alloc_size:int64; }\nkoukai kata ImageSpec {\n    text:[]uint8; rdata:[]uint8; data:[]uint8; zero_fill:int64; entry:int64;\n    imports:[]ImportLibrary; patches:[]Patch; unwind:[]UnwindFunction;\n}\nkoukai kata Section { kind:int64; name:string; rva:int64; offset:int64; virtual_size:int64; raw_size:int64; flags:int64; }\nkoukai kata Layout { headers_size:int64; image_size:int64; file_size:int64; sections:[]Section; iat_rva:int64; iat_size:int64; }\nkoukai kata ImageResult { bytes:[]uint8; layout:Layout; error:PEError?; }\n\nkata LibraryLayout { lookup:int64; iat:int64; name:int64; hints:[]int64; }\nkata Imports { size:int64; iat:int64; iat_size:int64; libraries:[]LibraryLayout; slots:[]int64; }\n\nwaza align(value:int64, boundary:int64) -> int64 { kaesu ((value+boundary-1)/boundary)*boundary; }\nwaza empty_layout() -> Layout { kaesu Layout {headers_size:0,image_size:0,file_size:0,sections:[],iat_rva:0,iat_size:0}; }\nwaza failure(error:PEError) -> ImageResult { kaesu ImageResult {bytes:[],layout:empty_layout(),error:error}; }\nwaza put(bytes:[]uint8, at:int64, width:int64, value:int64) -> unit {\n    kaku i=0; kaku rest=value;\n    aida(i<width){bytes[at+i]=uint8(rest-(rest/256)*256);rest=rest/256;i=i+1;}\n}\nwaza copy_bytes(bytes:[]uint8, at:int64, source:[]uint8) -> unit {\n    kaku i=0;aida(i<len(source)){bytes[at+i]=source[i];i=i+1;}\n}\nwaza ascii_name(name:string) -> bool {\n    kaku bytes=string.to_bytes(name);\n    moshi(len(bytes)==0 || len(bytes)>255){kaesu iie;}\n    kaku i=0;aida(i<len(bytes)){moshi(bytes[i]<uint8(33) || bytes[i]>uint8(126)){kaesu iie;}i=i+1;}\n    kaesu hai;\n}\nwaza valid_imports(libraries:[]ImportLibrary) -> bool {\n    moshi(len(libraries)>256){kaesu iie;}\n    kaku total=0;kaku i=0;\n    aida(i<len(libraries)){\n        kaku lib=libraries[i];moshi(!ascii_name(lib.name) || len(lib.symbols)==0 || len(lib.symbols)>4096-total){kaesu iie;}\n        kaku j=0;aida(j<i){moshi(libraries[j].name==lib.name){kaesu iie;}j=j+1;}\n        j=0;aida(j<len(lib.symbols)){\n            moshi(!ascii_name(lib.symbols[j])){kaesu iie;}\n            kaku k=0;aida(k<j){moshi(lib.symbols[k]==lib.symbols[j]){kaesu iie;}k=k+1;}\n            j=j+1;\n        }total=total+len(lib.symbols);i=i+1;\n    }kaesu hai;\n}\nwaza plan_imports(libraries:[]ImportLibrary) -> Imports {\n    kaku result=Imports {size:0,iat:0,iat_size:0,libraries:[],slots:[]};\n    moshi(len(libraries)==0){kaesu result;}\n    kaku at=align((len(libraries)+1)*20,8);kaku i=0;\n    aida(i<len(libraries)){\n        array.push(result.libraries,LibraryLayout {lookup:at,iat:0,name:0,hints:[]});\n        at=at+(len(libraries[i].symbols)+1)*8;i=i+1;\n    }\n    kaku iat=at;i=0;\n    aida(i<len(libraries)){\n        kaku entry=result.libraries[i];result.libraries[i]=LibraryLayout {lookup:entry.lookup,iat:at,name:0,hints:[]};kaku j=0;\n        aida(j<len(libraries[i].symbols)){array.push(result.slots,at+j*8);j=j+1;}\n        at=at+(len(libraries[i].symbols)+1)*8;i=i+1;\n    }\n    kaku iat_size=at-iat;i=0;\n    aida(i<len(libraries)){\n        kaku entry=result.libraries[i];result.libraries[i]=LibraryLayout {lookup:entry.lookup,iat:entry.iat,name:at,hints:entry.hints};at=at+len(string.to_bytes(libraries[i].name))+1;kaku j=0;\n        aida(j<len(libraries[i].symbols)){\n            at=align(at,2);array.push(result.libraries[i].hints,at);\n            at=at+2+len(string.to_bytes(libraries[i].symbols[j]))+1;j=j+1;\n        }i=i+1;\n    }kaesu Imports {size:at,iat:iat,iat_size:iat_size,libraries:result.libraries,slots:result.slots};\n}\nwaza unwind_size(functions:[]UnwindFunction) -> int64 {\n    kaku size=0;kaku i=0;\n    aida(i<len(functions)){size=size+4;moshi(functions[i].stack_size>0){size=size+4;}i=i+1;}kaesu size;\n}\nwaza frame_slots(f:FrameFunction) -> int64 {\n    kaku slots=2;moshi(f.alloc_size>128){slots=4;}moshi(f.alloc_size>0 && f.alloc_size<=128){slots=3;}\n    moshi(slots==3){slots=4;}kaesu slots;\n}\nwaza frame_size(frames:[]FrameFunction) -> int64 {\n    kaku size=0;kaku i=0;aida(i<len(frames)){size=size+4+frame_slots(frames[i])*2;i=i+1;}kaesu size;\n}\nwaza valid_frames(frames:[]FrameFunction, text_size:int64) -> bool {\n    moshi(len(frames)>4096){kaesu iie;}kaku previous=0;kaku i=0;\n    aida(i<len(frames)){\n        kaku f=frames[i];\n        moshi(f.begin<previous || f.end<=f.begin || f.end>text_size){kaesu iie;}\n        moshi(f.push_offset<=0 || f.set_offset<=f.push_offset){kaesu iie;}\n        moshi(f.alloc_size<0 || f.alloc_size>524280 || f.alloc_size-(f.alloc_size/8)*8!=0){kaesu iie;}\n        moshi(f.alloc_size==0 && f.alloc_offset!=0){kaesu iie;}\n        moshi(f.alloc_size>0 && f.alloc_offset<=f.set_offset){kaesu iie;}\n        kaku prolog=f.set_offset;moshi(f.alloc_size>0){prolog=f.alloc_offset;}\n        moshi(prolog>255 || prolog>f.end-f.begin){kaesu iie;}\n        previous=f.end;i=i+1;\n    }kaesu hai;\n}\nwaza valid_unwind(functions:[]UnwindFunction, text_size:int64) -> bool {\n    moshi(len(functions)>4096){kaesu iie;}kaku previous=0;kaku i=0;\n    aida(i<len(functions)){\n        kaku f=functions[i];\n        moshi(f.begin<previous || f.end<=f.begin || f.end>text_size || f.prolog_size<0 || f.prolog_size>255 || f.prolog_size>f.end-f.begin){kaesu iie;}\n        moshi(f.stack_size<0 || f.stack_size>524280 || f.stack_size-(f.stack_size/8)*8!=0){kaesu iie;}\n        moshi(f.stack_size==0 && f.stack_offset!=0){kaesu iie;}\n        moshi(f.stack_size>0 && (f.stack_offset<=0 || f.stack_offset>f.prolog_size)){kaesu iie;}\n        previous=f.end;i=i+1;\n    }kaesu hai;\n}\nwaza add_section(layout:Layout, kind:int64, name:string, size:int64, virtual_size:int64, flags:int64) -> Layout {\n    kaku raw=align(size,file_alignment);kaku at=layout.file_size;moshi(size==0){at=0;}\n    array.push(layout.sections,Section {kind:kind,name:name,rva:layout.image_size,offset:at,virtual_size:virtual_size,raw_size:raw,flags:flags});\n    kaesu Layout {headers_size:layout.headers_size,file_size:layout.file_size+raw,image_size:align(layout.image_size+virtual_size,section_alignment),sections:layout.sections,iat_rva:layout.iat_rva,iat_size:layout.iat_size};\n}\nwaza section(layout:Layout, kind:int64) -> Section {\n    kaku i=0;aida(i<len(layout.sections)){moshi(layout.sections[i].kind==kind){kaesu layout.sections[i];}i=i+1;}\n    kaesu Section {kind:0,name:\"\",rva:0,offset:0,virtual_size:0,raw_size:0,flags:0};\n}\nwaza source_size(spec:ImageSpec, kind:int64) -> int64 {\n    moshi(kind==text_section){kaesu len(spec.text);}\n    moshi(kind==rdata_section){kaesu len(spec.rdata);}\n    moshi(kind==data_section){kaesu len(spec.data);}kaesu -1;\n}\nwaza patch_target(p:Patch, layout:Layout, imports:Imports) -> int64 {\n    kaku target=section(layout,p.target);\n    moshi(p.target==import_section){\n        moshi(p.target_offset<0 || p.target_offset>=len(imports.slots)){kaesu -1;}\n        kaesu target.rva+imports.slots[p.target_offset];\n    }\n    moshi(p.target<text_section || p.target>data_section || target.kind==0 || p.target_offset<0 || p.target_offset>=target.virtual_size){kaesu -1;}\n    kaesu target.rva+p.target_offset;\n}\nwaza valid_patches(spec:ImageSpec, layout:Layout, imports:Imports) -> bool {\n    kaku i=0;aida(i<len(spec.patches)){\n        kaku p=spec.patches[i];kaku width=4;moshi(p.kind==va64){width=8;}\n        kaku size=source_size(spec,p.section);\n        moshi(p.kind<rva32 || p.kind>va64 || p.offset<0 || p.offset>size || width>size-p.offset || patch_target(p,layout,imports)<0){kaesu iie;}\n        kaku j=0;aida(j<i){kaku q=spec.patches[j];kaku other=4;moshi(q.kind==va64){other=8;}\n            moshi(p.section==q.section && p.offset<q.offset+other && q.offset<p.offset+width){kaesu iie;}j=j+1;\n        }i=i+1;\n    }kaesu hai;\n}\n// Sort relocation RVAs independently of patch input order. Each page block has\n// a DWORD-sized header and an even number of WORDs, padded with ABSOLUTE (0).\nwaza relocation_bytes(spec:ImageSpec, layout:Layout) -> []uint8 {\n    kaku addresses:[]int64=[];kaku i=0;\n    aida(i<len(spec.patches)){\n        kaku p=spec.patches[i];moshi(p.kind==va64){array.push(addresses,section(layout,p.section).rva+p.offset);}\n        i=i+1;\n    }\n    i=1;aida(i<len(addresses)){kaku j=i;aida(j>0 && addresses[j]<addresses[j-1]){kaku value=addresses[j];addresses[j]=addresses[j-1];addresses[j-1]=value;j=j-1;}i=i+1;}\n    kaku bytes:[]uint8=[];i=0;\n    aida(i<len(addresses)){\n        kaku page=(addresses[i]/4096)*4096;kaku end=i;\n        aida(end<len(addresses) && (addresses[end]/4096)*4096==page){end=end+1;}\n        kaku size=align(8+(end-i)*2,4);kaku start=len(bytes);kaku n=0;\n        aida(n<size){array.push(bytes,uint8(0));n=n+1;}\n        put(bytes,start,4,page);put(bytes,start+4,4,size);n=0;\n        aida(i<end){put(bytes,start+8+n*2,2,40960+addresses[i]-page);n=n+1;i=i+1;}\n    }kaesu bytes;\n}\nwaza emit_imports(bytes:[]uint8, spec:ImageSpec, layout:Layout, imports:Imports) -> unit {\n    moshi(imports.size==0){kaesu;}kaku s=section(layout,import_section);kaku i=0;\n    aida(i<len(spec.imports)){\n        kaku lib=spec.imports[i];kaku entry=imports.libraries[i];kaku at=s.offset+i*20;\n        put(bytes,at,4,s.rva+entry.lookup);put(bytes,at+12,4,s.rva+entry.name);put(bytes,at+16,4,s.rva+entry.iat);\n        copy_bytes(bytes,s.offset+entry.name,string.to_bytes(lib.name));kaku j=0;\n        aida(j<len(lib.symbols)){\n            put(bytes,s.offset+entry.lookup+j*8,8,s.rva+entry.hints[j]);\n            put(bytes,s.offset+entry.iat+j*8,8,s.rva+entry.hints[j]);\n            copy_bytes(bytes,s.offset+entry.hints[j]+2,string.to_bytes(lib.symbols[j]));j=j+1;\n        }i=i+1;\n    }\n}\nwaza emit_unwind(bytes:[]uint8, spec:ImageSpec, layout:Layout) -> unit {\n    kaku pdata=section(layout,5);kaku xdata=section(layout,6);kaku text=section(layout,text_section);kaku offset=0;kaku i=0;\n    aida(i<len(spec.unwind)){\n        kaku f=spec.unwind[i];kaku at=xdata.offset+offset;\n        put(bytes,pdata.offset+i*12,4,text.rva+f.begin);put(bytes,pdata.offset+i*12+4,4,text.rva+f.end);put(bytes,pdata.offset+i*12+8,4,xdata.rva+offset);\n        put(bytes,at,1,1);put(bytes,at+1,1,f.prolog_size);offset=offset+4;\n        moshi(f.stack_size>0){\n            put(bytes,at+4,1,f.stack_offset);\n            moshi(f.stack_size<=128){put(bytes,at+2,1,1);put(bytes,at+5,1,2+((f.stack_size-8)/8)*16);}\n            sore{put(bytes,at+2,1,2);put(bytes,at+5,1,1);put(bytes,at+6,2,f.stack_size/8);}\n            offset=offset+4;\n        }i=i+1;\n    }\n}\nwaza emit_frames(bytes:[]uint8, spec:ImageSpec, frames:[]FrameFunction, layout:Layout) -> unit {\n    kaku pdata=section(layout,5);kaku xdata=section(layout,6);kaku text=section(layout,text_section);kaku offset=0;kaku i=0;\n    aida(i<len(frames)){\n        kaku f=frames[i];kaku at=xdata.offset+offset;kaku slots=frame_slots(f);\n        put(bytes,pdata.offset+i*12,4,text.rva+f.begin);put(bytes,pdata.offset+i*12+4,4,text.rva+f.end);put(bytes,pdata.offset+i*12+8,4,xdata.rva+offset);\n        kaku prolog=f.set_offset;kaku count=2;moshi(f.alloc_size>0){prolog=f.alloc_offset;count=3;}moshi(f.alloc_size>128){count=4;}\n        put(bytes,at,1,1);put(bytes,at+1,1,prolog);put(bytes,at+2,1,count);put(bytes,at+3,1,5);\n        kaku c=at+4;\n        moshi(f.alloc_size>0){\n            put(bytes,c,1,f.alloc_offset);\n            moshi(f.alloc_size<=128){put(bytes,c+1,1,2+((f.alloc_size-8)/8)*16);c=c+2;}\n            sore{put(bytes,c+1,1,1);put(bytes,c+2,2,f.alloc_size/8);c=c+4;}\n        }\n        put(bytes,c,1,f.set_offset);put(bytes,c+1,1,3);c=c+2;\n        put(bytes,c,1,f.push_offset);put(bytes,c+1,1,5*16);\n        offset=offset+4+slots*2;i=i+1;\n    }\n}\nwaza directory(bytes:[]uint8, index:int64, rva:int64, size:int64) -> unit {put(bytes,264+index*8,4,rva);put(bytes,268+index*8,4,size);}\n\nkoukai waza executable(spec:ImageSpec) -> ImageResult { kaesu executable_framed(spec,[]); }\n\n// Like executable, with unwind data for frame-pointer functions. A spec uses either spec.unwind or frames, not both.\nkoukai waza executable_framed(spec:ImageSpec, frames:[]FrameFunction) -> ImageResult { kaesu executable_sized(spec,frames,1048576); }\n\n// stack_reserve is the PE SizeOfStackReserve of the main thread (a multiple of 65536, at most 1 GiB).\nkoukai waza executable_sized(spec:ImageSpec, frames:[]FrameFunction, stack_reserve:int64) -> ImageResult { kaesu executable_placed(spec,frames,stack_reserve,0); }\n\n// data_rva > 0 places .data at that RVA (a multiple of 4096, not below the end of .text/.rdata), so generated code may\n// embed absolute data addresses (image_base + data_rva) as constants. 4096 is special: .data comes first, directly after the\n// headers, so there is no RVA gap and .text follows it. 0 keeps the sequential layout.\nkoukai waza executable_placed(spec:ImageSpec, frames:[]FrameFunction, stack_reserve:int64, data_rva:int64) -> ImageResult {\n    moshi(data_rva<0 || data_rva-(data_rva/4096)*4096!=0 || data_rva>maximum_image_size){kaesu failure(PEError.InvalidEntry());}\n    moshi(stack_reserve<65536 || stack_reserve>1073741824 || stack_reserve-(stack_reserve/65536)*65536!=0){kaesu failure(PEError.ImageTooLarge());}\n    moshi(len(frames)>0 && len(spec.unwind)>0){kaesu failure(PEError.InvalidUnwind());}\n    moshi(!valid_frames(frames,len(spec.text))){kaesu failure(PEError.InvalidUnwind());}\n    kaku unwind_count=len(spec.unwind)+len(frames);\n    moshi(len(spec.text)==0){kaesu failure(PEError.EmptyText());}\n    moshi(spec.entry<0 || spec.entry>=len(spec.text)){kaesu failure(PEError.InvalidEntry());}\n    // Validate bounds before addition/alignment/allocation. Every intermediate\n    // after these checks is far below both signed-int64 and PE DWORD limits.\n    moshi(len(spec.text)>maximum_image_size || len(spec.rdata)>maximum_image_size || len(spec.data)>maximum_image_size || spec.zero_fill<0 || spec.zero_fill>maximum_image_size-len(spec.data)){kaesu failure(PEError.ImageTooLarge());}\n    moshi(!valid_imports(spec.imports)){kaesu failure(PEError.InvalidImport());}\n    moshi(!valid_unwind(spec.unwind,len(spec.text))){kaesu failure(PEError.InvalidUnwind());}\n    moshi(len(spec.patches)>4096){kaesu failure(PEError.InvalidPatch());}\n    kaku imports=plan_imports(spec.imports);kaku count=1;kaku has_relocations=iie;kaku i=0;\n    moshi(len(spec.rdata)>0){count=count+1;}\n    moshi(len(spec.data)+spec.zero_fill>0){count=count+1;}\n    moshi(imports.size>0){count=count+1;}\n    moshi(unwind_count>0){count=count+2;}\n    aida(i<len(spec.patches)){moshi(spec.patches[i].kind==va64){has_relocations=hai;}i=i+1;}\n    moshi(has_relocations){count=count+1;}\n    kaku headers=align(392+count*40,file_alignment);\n    kaku layout=Layout {headers_size:headers,image_size:4096,file_size:headers,sections:[],iat_rva:0,iat_size:imports.iat_size};\n    // data_rva == 4096 puts .data FIRST (right after the headers, no RVA gap), so its address is a constant independent of code size.\n    kaku data_first=data_rva==4096;\n    moshi(data_first && len(spec.data)+spec.zero_fill>0){\n        kaku first_flags=3221225536;moshi(len(spec.data)==0){first_flags=3221225600;}\n        layout=add_section(layout,data_section,\".data\",len(spec.data),len(spec.data)+spec.zero_fill,first_flags);\n    }\n    layout=add_section(layout,text_section,\".text\",len(spec.text),len(spec.text),1610612768);\n    moshi(len(spec.rdata)>0){layout=add_section(layout,rdata_section,\".rdata\",len(spec.rdata),len(spec.rdata),1073741888);}\n    moshi(!data_first && len(spec.data)+spec.zero_fill>0){\n        moshi(data_rva>0 && data_rva<layout.image_size){kaesu failure(PEError.ImageTooLarge());}\n        moshi(data_rva>0){layout=Layout {headers_size:layout.headers_size,image_size:data_rva,file_size:layout.file_size,sections:layout.sections,iat_rva:layout.iat_rva,iat_size:layout.iat_size};}\n        kaku flags=3221225536;moshi(len(spec.data)==0){flags=3221225600;}\n        layout=add_section(layout,data_section,\".data\",len(spec.data),len(spec.data)+spec.zero_fill,flags);\n    }\n    moshi(imports.size>0){layout=add_section(layout,import_section,\".idata\",imports.size,imports.size,3221225536);layout=Layout {headers_size:layout.headers_size,image_size:layout.image_size,file_size:layout.file_size,sections:layout.sections,iat_rva:section(layout,import_section).rva+imports.iat,iat_size:imports.iat_size};}\n    moshi(unwind_count>0){\n        kaku xsize=unwind_size(spec.unwind)+frame_size(frames);\n        layout=add_section(layout,5,\".pdata\",unwind_count*12,unwind_count*12,1073741888);\n        layout=add_section(layout,6,\".xdata\",xsize,xsize,1073741888);\n    }\n    moshi(!valid_patches(spec,layout,imports)){kaesu failure(PEError.InvalidPatch());}\n    kaku relocations=relocation_bytes(spec,layout);\n    moshi(has_relocations){layout=add_section(layout,7,\".reloc\",len(relocations),len(relocations),1107296320);}\n    moshi(layout.file_size>maximum_image_size || layout.image_size>maximum_image_size){kaesu failure(PEError.ImageTooLarge());}\n    kaku bytes=array.make[uint8](layout.file_size,uint8(0));\n    // DOS header and a real DOS exit stub, PE signature, COFF header.\n    put(bytes,0,2,23117);put(bytes,2,2,128);put(bytes,4,2,1);put(bytes,8,2,4);\n    put(bytes,10,2,16);put(bytes,12,2,65535);put(bytes,16,2,256);put(bytes,24,2,64);put(bytes,60,4,128);\n    copy_bytes(bytes,64,[184,1,76,205,33]);\n    put(bytes,128,4,17744);put(bytes,132,2,34404);put(bytes,134,2,count);put(bytes,148,2,240);\n    kaku characteristics=35;moshi(has_relocations){characteristics=34;}put(bytes,150,2,characteristics);\n    kaku text=section(layout,text_section);kaku initialized=0;kaku uninitialized=0;i=0;\n    aida(i<len(layout.sections)){kaku s=layout.sections[i];moshi(s.kind!=text_section){initialized=initialized+s.raw_size;}\n        moshi(s.virtual_size>s.raw_size){uninitialized=uninitialized+s.virtual_size-s.raw_size;}i=i+1;\n    }\n    put(bytes,152,2,523);put(bytes,156,4,text.raw_size);put(bytes,160,4,initialized);put(bytes,164,4,uninitialized);\n    put(bytes,168,4,text.rva+spec.entry);put(bytes,172,4,text.rva);put(bytes,176,8,image_base);\n    put(bytes,184,4,section_alignment);put(bytes,188,4,file_alignment);\n    put(bytes,192,2,6);put(bytes,200,2,6);put(bytes,208,4,layout.image_size);put(bytes,212,4,headers);\n    put(bytes,220,2,3);kaku dll_flags=256;moshi(has_relocations){dll_flags=352;}put(bytes,222,2,dll_flags);\n    put(bytes,224,8,stack_reserve);put(bytes,232,8,4096);put(bytes,240,8,1048576);put(bytes,248,8,4096);put(bytes,260,4,16);\n    moshi(imports.size>0){directory(bytes,1,section(layout,import_section).rva,(len(spec.imports)+1)*20);directory(bytes,12,layout.iat_rva,layout.iat_size);}\n    moshi(unwind_count>0){directory(bytes,3,section(layout,5).rva,unwind_count*12);}\n    moshi(has_relocations){directory(bytes,5,section(layout,7).rva,len(relocations));}\n    i=0;aida(i<len(layout.sections)){\n        kaku s=layout.sections[i];kaku at=392+i*40;copy_bytes(bytes,at,string.to_bytes(s.name));\n        put(bytes,at+8,4,s.virtual_size);put(bytes,at+12,4,s.rva);put(bytes,at+16,4,s.raw_size);put(bytes,at+20,4,s.offset);put(bytes,at+36,4,s.flags);i=i+1;\n    }\n    copy_bytes(bytes,text.offset,spec.text);\n    moshi(len(spec.rdata)>0){copy_bytes(bytes,section(layout,rdata_section).offset,spec.rdata);}\n    moshi(len(spec.data)>0){copy_bytes(bytes,section(layout,data_section).offset,spec.data);}\n    emit_imports(bytes,spec,layout,imports);emit_unwind(bytes,spec,layout);emit_frames(bytes,spec,frames,layout);\n    moshi(has_relocations){copy_bytes(bytes,section(layout,7).offset,relocations);}\n    i=0;aida(i<len(spec.patches)){\n        kaku p=spec.patches[i];kaku source=section(layout,p.section);kaku value=patch_target(p,layout,imports);kaku width=4;\n        moshi(p.kind==va64){width=8;value=image_base+value;}\n        moshi(p.kind==rel32){value=value-(source.rva+p.offset+4);moshi(value<0){value=value+4294967296;}}\n        put(bytes,source.offset+p.offset,width,value);i=i+1;\n    }\n    kaesu ImageResult {bytes:bytes,layout:layout,error:mu};\n}\n" }; }
waza data_50() -> File { kaesu File { path: "kiso/aot/sign/sign.mio", version: "Bunko-v2.1.1", length: 5992, sha256: "9fcf6206c4f4e6ad49037257540d3a5ef0686437a506f62ba9e9765a4d7105aa", source: "yobu \"kiso/array\";\nyobu \"kiso/crypto/sha256\";\n\nkoukai kata SignResult { bytes: []uint8; error: string; }\nwaza failure(message: string) -> SignResult { kaesu SignResult { bytes: [], error: message }; }\nwaza read32(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset]) + int64(data[offset + 1]) * 256 + int64(data[offset + 2]) * 65536 + int64(data[offset + 3]) * 16777216;\n}\nwaza write32(data: []uint8, offset: int64, value: int64, big: bool) -> unit {\n    kaku left = value; kaku at = 0;\n    aida (at < 4) {\n        kaku position = offset + at; moshi (big) { position = offset + 3 - at; }\n        data[position] = uint8(left - (left / 256) * 256); left = left / 256; at = at + 1;\n    }\n}\nwaza align(value: int64, boundary: int64) -> int64 { kaesu ((value + boundary - 1) / boundary) * boundary; }\n\n// Deterministic local ad-hoc signature for our relocation-free ARM64 images.\n// No identity, certificate, entitlement or notarization is claimed. Every code\n// page hash covers the final header and final LC_CODE_SIGNATURE/__LINKEDIT.\nkoukai waza adhoc(image: []uint8) -> SignResult { kaesu sign_image(image, iie); }\n// Explicit dynamic-image path: preserves an existing dyld binding payload.\nkoukai waza adhoc_linked(image: []uint8) -> SignResult { kaesu sign_image(image, hai); }\nwaza sign_image(image: []uint8, linked: bool) -> SignResult {\n    moshi (len(image) < 768 || len(image) > 67108864 || len(image) != align(len(image), 16)) { kaesu failure(\"invalid unsigned image length\"); }\n    moshi (read32(image, 0) != 4277009103 || read32(image, 4) != 16777228 || read32(image, 12) != 2) { kaesu failure(\"expected ARM64 Mach-O executable\"); }\n    kaku count = read32(image, 16); kaku command_bytes = read32(image, 20);\n    moshi (count < 1 || count > 32 || command_bytes > 720 || 32 + command_bytes + 16 > 768) { kaesu failure(\"invalid load commands\"); }\n    kaku linkedit = -1; kaku payload_size = 0; kaku text_limit = 0; kaku at = 32; kaku index = 0;\n    aida (index < count) {\n        moshi (at + 8 > 32 + command_bytes) { kaesu failure(\"truncated load command\"); }\n        kaku command = read32(image, at); kaku size = read32(image, at + 4);\n        moshi (size < 8 || at + size > 32 + command_bytes || size != align(size, 8)) { kaesu failure(\"invalid load command size\"); }\n        moshi (command == 29) { kaesu failure(\"image is already signed\"); }\n        moshi (command == 25 && size >= 72) {\n            // Exact segment names, including the NUL padding.\n            kaku name: []uint8 = [95,95,76,73,78,75,69,68,73,84,0,0,0,0,0,0]; kaku equal = hai; kaku ni = 0;\n            aida (ni < 16) { moshi (image[at + 8 + ni] != name[ni]) { equal = iie; } ni = ni + 1; }\n            moshi (equal) {\n                kaku offset = read32(image, at + 40); kaku size = read32(image, at + 48);\n                moshi (linkedit >= 0 || read32(image, at + 44) != 0 || read32(image, at + 52) != 0 ||\n                    offset > len(image) || size != len(image) - offset || (!linked && size != 0)) { kaesu failure(\"unexpected LINKEDIT layout\"); }\n                payload_size = size; linkedit = at;\n            }\n            moshi (image[at + 8] == uint8(95) && image[at + 9] == uint8(95) && image[at + 10] == uint8(84) && image[at + 11] == uint8(69) && image[at + 12] == uint8(88) && image[at + 13] == uint8(84) && image[at + 14] == uint8(0)) {\n                text_limit = read32(image, at + 48);\n            }\n        }\n        at = at + size; index = index + 1;\n    }\n    moshi (at != 32 + command_bytes || linkedit < 0 || text_limit < 768 || text_limit > len(image)) { kaesu failure(\"missing canonical image segments\"); }\n    // SuperBlob(20), CodeDirectory v0x20400(88), identifier \"mio\\0\"(4),\n    // SHA256 code slots. No special slots or CMS are needed for ad-hoc.\n    kaku slots = (len(image) + 4095) / 4096;\n    kaku directory_size = 92 + slots * 32; kaku blob_size = 20 + directory_size; kaku signature_size = align(blob_size, 16);\n    kaku output = array.with_capacity[uint8](len(image) + signature_size);\n    array.append_all(output, image); kaku pad = 0;\n    aida (pad < signature_size) { array.push(output, uint8(0)); pad = pad + 1; }\n    write32(output, 16, count + 1, iie); write32(output, 20, command_bytes + 16, iie);\n    write32(output, at, 29, iie); write32(output, at + 4, 16, iie); write32(output, at + 8, len(image), iie); write32(output, at + 12, signature_size, iie);\n    write32(output, linkedit + 32, align(payload_size + signature_size, 16384), iie); write32(output, linkedit + 36, 0, iie);\n    write32(output, linkedit + 48, payload_size + signature_size, iie); write32(output, linkedit + 52, 0, iie);\n    kaku base = len(image);\n    write32(output, base, 4208856256, hai); write32(output, base + 4, blob_size, hai); write32(output, base + 8, 1, hai);\n    write32(output, base + 12, 0, hai); write32(output, base + 16, 20, hai);\n    kaku cd = base + 20;\n    write32(output, cd, 4208856066, hai); write32(output, cd + 4, directory_size, hai); write32(output, cd + 8, 132096, hai); write32(output, cd + 12, 2, hai);\n    write32(output, cd + 16, 92, hai); write32(output, cd + 20, 88, hai); write32(output, cd + 28, slots, hai); write32(output, cd + 32, len(image), hai);\n    output[cd + 36] = uint8(32); output[cd + 37] = uint8(2); output[cd + 39] = uint8(12);\n    write32(output, cd + 76, text_limit, hai); write32(output, cd + 84, 1, hai);\n    output[cd + 88] = uint8(109); output[cd + 89] = uint8(105); output[cd + 90] = uint8(111);\n    kaku ctx = sha256.context(); index = 0;\n    aida (index < slots) {\n        kaku length = 4096; moshi ((index + 1) * 4096 > len(image)) { length = len(image) - index * 4096; }\n        kaku hash = sha256.sum_range(ctx, output, index * 4096, length);\n        moshi (len(hash) != 32) { kaesu failure(\"page hashing failed\"); }\n        kaku hi = 0;\n        aida (hi < 32) { output[cd + 92 + index * 32 + hi] = hash[hi]; hi = hi + 1; }\n        index = index + 1;\n    }\n    kaesu SignResult { bytes: output, error: \"\" };\n}\n" }; }
waza data_51() -> File { kaesu File { path: "kiso/aot/winconsole/winconsole.mio", version: "Bunko-v2.1.1", length: 4930, sha256: "0e79667332a2efaca89c9a75c0c721455db55cf973647b12c9082ff6ddbf44e8", source: "yobu \"kiso/aot/x86_64\";\nyobu \"kiso/aot/pe\";\nyobu \"kiso/array\";\n\n// Bounded Windows console image generator, not source-language lowering.\nkoukai teisu io_failure_exit = 111;\nkoukai teisu maximum_message_size = 1048576;\nkoukai kata BuildResult { bytes:[]uint8; error:string; }\n\nwaza failure(message:string) -> BuildResult { kaesu BuildResult {bytes:[],error:message}; }\nwaza import_call(code:x86_64.Assembler, patches:[]pe.Patch, index:int64) -> unit {\n    kaku at=len(code.bytes);\n    x86_64.mov_ri(code,x86_64.r11,0);\n    array.push(patches,pe.Patch {section:pe.text_section,offset:at+2,kind:pe.va64,target:pe.import_section,target_offset:index});\n    x86_64.call_memory(code,x86_64.r11,0);\n}\nwaza finish(code:x86_64.Assembler, patches:[]pe.Patch, message:[]uint8, symbols:[]string, stack:int64, prolog:int64) -> BuildResult {\n    kaku assembled=x86_64.assemble(code);\n    moshi(assembled.error!=\"\"){kaesu failure(assembled.error);}\n    kaku image=pe.executable(pe.ImageSpec {text:assembled.bytes,rdata:message,data:[],zero_fill:0,entry:0,\n        imports:[pe.ImportLibrary {name:\"KERNEL32.dll\",symbols:symbols}],patches:patches,\n        unwind:[pe.UnwindFunction {begin:0,end:len(assembled.bytes),prolog_size:prolog,stack_size:stack,stack_offset:prolog}]});\n    moshi(image.error!=mu){kaesu failure(\"PE_IMAGE_ERROR\");}\n    kaesu BuildResult {bytes:image.bytes,error:\"\"};\n}\n\nkoukai waza exit_executable(exit_code:int64) -> BuildResult {\n    moshi(exit_code<0 || exit_code>255){kaesu failure(\"INVALID_EXIT_CODE\");}\n    kaku code=x86_64.assembler();kaku patches:[]pe.Patch=[];\n    // Entry RSP is 8 mod 16. 32-byte outgoing shadow space + alignment.\n    x86_64.sub_ri(code,x86_64.rsp,40);kaku prolog=len(code.bytes);\n    x86_64.mov_ri(code,x86_64.rcx,exit_code);import_call(code,patches,0);\n    // ExitProcess does not return; retain a valid epilog if it ever does.\n    x86_64.add_ri(code,x86_64.rsp,40);x86_64.ret(code);\n    kaesu finish(code,patches,[],[\"ExitProcess\"],40,prolog);\n}\n\n// Synchronous inherited stdout only; output is bytes, without encoding/newline conversion.\n// Uses volatile registers exclusively; state survives API calls in local stack slots.\nkoukai waza stdout_executable(message:[]uint8, exit_code:int64) -> BuildResult {\n    moshi(exit_code<0 || exit_code>255){kaesu failure(\"INVALID_EXIT_CODE\");}\n    moshi(len(message)>maximum_message_size){kaesu failure(\"MESSAGE_TOO_LARGE\");}\n    moshi(len(message)==0){kaesu exit_executable(exit_code);}\n    kaku code=x86_64.assembler();kaku patches:[]pe.Patch=[];\n    // [0,32) shadow space, +32 fifth argument, +40 zero-extended DWORD\n    // bytes-written, +48 handle, +56 cursor, +64 remaining. Total 72 aligns calls.\n    x86_64.sub_ri(code,x86_64.rsp,72);kaku prolog=len(code.bytes);\n    x86_64.mov_ri(code,x86_64.rcx,4294967285); // DWORD STD_OUTPUT_HANDLE (-11)\n    import_call(code,patches,0);\n    x86_64.test_rr(code,x86_64.rax,x86_64.rax);x86_64.jcc(code,x86_64.cc_e,\"failure\");\n    x86_64.cmp_ri(code,x86_64.rax,-1);x86_64.jcc(code,x86_64.cc_e,\"failure\");\n    x86_64.mov_store(code,x86_64.rsp,48,x86_64.rax);\n    kaku at=len(code.bytes);x86_64.mov_ri(code,x86_64.rdx,0);\n    array.push(patches,pe.Patch {section:pe.text_section,offset:at+2,kind:pe.va64,target:pe.rdata_section,target_offset:0});\n    x86_64.mov_store(code,x86_64.rsp,56,x86_64.rdx);\n    x86_64.mov_ri(code,x86_64.r8,len(message));x86_64.mov_store(code,x86_64.rsp,64,x86_64.r8);\n    x86_64.label(code,\"write\");\n    x86_64.mov_load(code,x86_64.rcx,x86_64.rsp,48);\n    x86_64.mov_load(code,x86_64.rdx,x86_64.rsp,56);\n    x86_64.mov_load(code,x86_64.r8,x86_64.rsp,64);\n    x86_64.lea(code,x86_64.r9,x86_64.rsp,40);\n    x86_64.mov_ri(code,x86_64.rax,0);\n    x86_64.mov_store(code,x86_64.rsp,40,x86_64.rax);\n    x86_64.mov_store(code,x86_64.rsp,32,x86_64.rax); // lpOverlapped = NULL\n    import_call(code,patches,1);\n    x86_64.zero_extend_eax(code);x86_64.test_rr(code,x86_64.rax,x86_64.rax);\n    x86_64.jcc(code,x86_64.cc_e,\"failure\");\n    x86_64.mov_load(code,x86_64.rax,x86_64.rsp,40);\n    x86_64.test_rr(code,x86_64.rax,x86_64.rax);x86_64.jcc(code,x86_64.cc_e,\"failure\");\n    x86_64.mov_load(code,x86_64.r8,x86_64.rsp,64);\n    x86_64.cmp_rr(code,x86_64.rax,x86_64.r8);x86_64.jcc(code,x86_64.cc_a,\"failure\");\n    x86_64.sub_rr(code,x86_64.r8,x86_64.rax);x86_64.mov_store(code,x86_64.rsp,64,x86_64.r8);\n    x86_64.mov_load(code,x86_64.rdx,x86_64.rsp,56);\n    x86_64.add_rr(code,x86_64.rdx,x86_64.rax);x86_64.mov_store(code,x86_64.rsp,56,x86_64.rdx);\n    x86_64.test_rr(code,x86_64.r8,x86_64.r8);x86_64.jcc(code,x86_64.cc_ne,\"write\");\n    x86_64.mov_ri(code,x86_64.rcx,exit_code);x86_64.jmp(code,\"exit\");\n    x86_64.label(code,\"failure\");x86_64.mov_ri(code,x86_64.rcx,io_failure_exit);\n    x86_64.label(code,\"exit\");import_call(code,patches,2);\n    x86_64.add_ri(code,x86_64.rsp,72);x86_64.ret(code);\n    kaesu finish(code,patches,message,[\"GetStdHandle\",\"WriteFile\",\"ExitProcess\"],72,prolog);\n}\n" }; }
waza data_52() -> File { kaesu File { path: "kiso/aot/x86_64/x86_64.mio", version: "Bunko-v2.1.1", length: 18845, sha256: "fda08ba5d93bacb9fcfa8d35d5350ec6a209eb61ea58f3ef62313510f497fb40", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// Pure Mio x86-64 (AMD64, 64-bit mode) encoder for the instruction subset that\n// will be used by the Linux runtime-IR lowering. The language has no bit operators, so every\n// field is composed with checked integer arithmetic. Registers are numbered as\n// in the ISA: rax=0 rcx=1 rdx=2 rbx=3 rsp=4 rbp=5 rsi=6 rdi=7 r8..r15=8..15.\n// Mutation is append-only through an Assembler; control flow uses 32-bit\n// relative fixups resolved by assemble(). Failures are recorded, never truncated.\nkoukai kata Label { name: string; offset: int64; }\nkoukai kata Fixup { at: int64; target: string; }\n// `table` holds one open-addressing hash table (label index + 1, 0 = empty) so that label lookup is O(1).\nkoukai kata Assembler { bytes: []uint8; labels: []Label; fixups: []Fixup; errors: []string; table: [][]int64; }\nkoukai kata AssembleResult { bytes: []uint8; error: string; }\n\nkoukai teisu rax = 0;\nkoukai teisu rcx = 1;\nkoukai teisu rdx = 2;\nkoukai teisu rbx = 3;\nkoukai teisu rsp = 4;\nkoukai teisu rbp = 5;\nkoukai teisu rsi = 6;\nkoukai teisu rdi = 7;\nkoukai teisu r8 = 8;\nkoukai teisu r9 = 9;\nkoukai teisu r10 = 10;\nkoukai teisu r11 = 11;\nkoukai teisu r12 = 12;\nkoukai teisu r13 = 13;\nkoukai teisu r14 = 14;\nkoukai teisu r15 = 15;\n// Condition codes (low nibble of Jcc/SETcc opcodes).\nkoukai teisu cc_b = 2;\nkoukai teisu cc_ae = 3;\nkoukai teisu cc_e = 4;\nkoukai teisu cc_ne = 5;\nkoukai teisu cc_be = 6;\nkoukai teisu cc_a = 7;\nkoukai teisu cc_l = 12;\nkoukai teisu cc_ge = 13;\nkoukai teisu cc_le = 14;\nkoukai teisu cc_g = 15;\n\nkoukai waza assembler() -> Assembler {\n    kaesu Assembler { bytes: array.with_capacity[uint8](256), labels: array.with_capacity[Label](16), fixups: array.with_capacity[Fixup](16), errors: array.with_capacity[string](1), table: [array.make[int64](256, 0)] };\n}\n\nwaza fail(a: Assembler, message: string) -> unit { array.push(a.errors, message); }\nwaza low3(x: int64) -> int64 { kaesu x - (x / 8) * 8; }\nwaza high(x: int64) -> int64 { moshi (x >= 8) { kaesu 1; } kaesu 0; }\nwaza valid_register(a: Assembler, r: int64) -> bool {\n    moshi (r < 0 || r > 15) { fail(a, \"INVALID_REGISTER\"); kaesu iie; }\n    kaesu hai;\n}\nkoukai waza byte(a: Assembler, value: int64) -> unit {\n    moshi (value < 0 || value > 255) { fail(a, \"INVALID_BYTE\"); kaesu; }\n    array.push(a.bytes, uint8(value));\n}\nwaza imm32(a: Assembler, value: int64) -> unit {\n    moshi (value < -2147483648 || value > 2147483647) { fail(a, \"INVALID_IMMEDIATE\"); kaesu; }\n    kaku x = value; moshi (x < 0) { x = x + 4294967296; }\n    kaku i = 0; aida (i < 4) { byte(a, x - (x / 256) * 256); x = x / 256; i = i + 1; }\n}\n// Two's-complement 64-bit little-endian; negative values use ~(-(v+1)).\nwaza imm64(a: Assembler, value: int64) -> unit {\n    kaku negative = value < 0; kaku x = value; moshi (negative) { x = -(value + 1); }\n    kaku i = 0;\n    aida (i < 8) {\n        kaku b = x - (x / 256) * 256; x = x / 256;\n        moshi (negative) { b = 255 - b; }\n        byte(a, b); i = i + 1;\n    }\n}\n// REX.W prefix with R (reg field) and B (rm/base field) extensions.\nwaza rex(a: Assembler, reg: int64, rm: int64) -> unit { byte(a, 72 + high(reg) * 4 + high(rm)); }\nwaza modrm(a: Assembler, mode: int64, reg: int64, rm: int64) -> unit { byte(a, mode * 64 + low3(reg) * 8 + low3(rm)); }\n// [base + disp32]; rsp/r12 bases require a SIB byte.\nwaza memory(a: Assembler, reg: int64, base: int64, disp: int64) -> unit {\n    modrm(a, 2, reg, base);\n    moshi (low3(base) == 4) { byte(a, 36); }\n    imm32(a, disp);\n}\nkoukai waza op_rr(a: Assembler, opcode: int64, rm: int64, reg: int64) -> unit {\n    moshi (!valid_register(a, rm) || !valid_register(a, reg)) { kaesu; }\n    rex(a, reg, rm); byte(a, opcode); modrm(a, 3, reg, rm);\n}\nkoukai waza mov_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 137, dst, src); }\nkoukai waza add_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 1, dst, src); }\nkoukai waza sub_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 41, dst, src); }\nkoukai waza and_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 33, dst, src); }\nkoukai waza or_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 9, dst, src); }\nkoukai waza xor_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 49, dst, src); }\nkoukai waza cmp_rr(a: Assembler, left: int64, right: int64) -> unit { op_rr(a, 57, left, right); }\nkoukai waza test_rr(a: Assembler, left: int64, right: int64) -> unit { op_rr(a, 133, left, right); }\nkoukai waza xchg_rr(a: Assembler, left: int64, right: int64) -> unit { op_rr(a, 135, left, right); }\nkoukai waza imul_rr(a: Assembler, dst: int64, src: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, src)) { kaesu; }\n    rex(a, dst, src); byte(a, 15); byte(a, 175); modrm(a, 3, dst, src);\n}\n// Unsigned divide rdx:rax by src (callers zero rdx).\nkoukai waza div_r(a: Assembler, src: int64) -> unit {\n    moshi (!valid_register(a, src)) { kaesu; }\n    rex(a, 0, src); byte(a, 247); modrm(a, 3, 6, src);\n}\n// Signed divide rdx:rax by src (callers run cqo first).\nkoukai waza idiv_r(a: Assembler, src: int64) -> unit {\n    moshi (!valid_register(a, src)) { kaesu; }\n    rex(a, 0, src); byte(a, 247); modrm(a, 3, 7, src);\n}\n// Sign-extend rax into rdx:rax.\nkoukai waza cqo(a: Assembler) -> unit { byte(a, 72); byte(a, 153); }\nkoukai waza neg_r(a: Assembler, dst: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst); byte(a, 247); modrm(a, 3, 3, dst);\n}\n// mov [base + disp32], low byte of src (a bare REX prefix selects sil/dil/spl/bpl).\nkoukai waza mov_store8(a: Assembler, base: int64, disp: int64, src: int64) -> unit {\n    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }\n    byte(a, 64 + high(src) * 4 + high(base)); byte(a, 136); memory(a, src, base, disp);\n}\n// movzx dst, byte [base + disp32]\nkoukai waza mov_load8(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }\n    rex(a, dst, base); byte(a, 15); byte(a, 182); memory(a, dst, base, disp);\n}\n// mov dst32, dword [base + disp32] (zero-extends into dst), mov dword [base + disp32], src32.\nkoukai waza mov_load32(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }\n    byte(a, 64 + high(dst) * 4 + high(base)); byte(a, 139); memory(a, dst, base, disp);\n}\nkoukai waza mov_store32(a: Assembler, base: int64, disp: int64, src: int64) -> unit {\n    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }\n    byte(a, 64 + high(src) * 4 + high(base)); byte(a, 137); memory(a, src, base, disp);\n}\n// movzx dst, word [base + disp32] and mov word [base + disp32], src16.\nkoukai waza mov_load16(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }\n    byte(a, 64 + high(dst) * 4 + high(base)); byte(a, 15); byte(a, 183); memory(a, dst, base, disp);\n}\nkoukai waza mov_store16(a: Assembler, base: int64, disp: int64, src: int64) -> unit {\n    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }\n    byte(a, 102); byte(a, 64 + high(src) * 4 + high(base)); byte(a, 137); memory(a, src, base, disp);\n}\nkoukai waza mov_ri(a: Assembler, dst: int64, value: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst); byte(a, 184 + low3(dst)); imm64(a, value);\n}\nkoukai waza mov_load(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }\n    rex(a, dst, base); byte(a, 139); memory(a, dst, base, disp);\n}\nkoukai waza mov_store(a: Assembler, base: int64, disp: int64, src: int64) -> unit {\n    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }\n    rex(a, src, base); byte(a, 137); memory(a, src, base, disp);\n}\nkoukai waza lea(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }\n    rex(a, dst, base); byte(a, 141); memory(a, dst, base, disp);\n}\nkoukai waza add_ri(a: Assembler, dst: int64, value: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst); byte(a, 129); modrm(a, 3, 0, dst); imm32(a, value);\n}\nkoukai waza sub_ri(a: Assembler, dst: int64, value: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst); byte(a, 129); modrm(a, 3, 5, dst); imm32(a, value);\n}\nkoukai waza and_ri(a: Assembler, dst: int64, value: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst); byte(a, 129); modrm(a, 3, 4, dst); imm32(a, value);\n}\nkoukai waza cmp_ri(a: Assembler, dst: int64, value: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst); byte(a, 129); modrm(a, 3, 7, dst); imm32(a, value);\n}\nwaza shift_ri(a: Assembler, dst: int64, extension: int64, count: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    moshi (count < 0 || count > 63) { fail(a, \"INVALID_SHIFT\"); kaesu; }\n    rex(a, 0, dst); byte(a, 193); modrm(a, 3, extension, dst); byte(a, count);\n}\nkoukai waza shl_ri(a: Assembler, dst: int64, count: int64) -> unit { shift_ri(a, dst, 4, count); }\nkoukai waza shr_ri(a: Assembler, dst: int64, count: int64) -> unit { shift_ri(a, dst, 5, count); }\nkoukai waza sar_ri(a: Assembler, dst: int64, count: int64) -> unit { shift_ri(a, dst, 7, count); }\n// rep movsb: copy rcx bytes from [rsi] to [rdi].\nkoukai waza rep_movsb(a: Assembler) -> unit { byte(a, 243); byte(a, 164); }\n// ---- SSE scalar floating point (xmm0..xmm15) ----------------------------------------------------------\n// prefix: 0 none, 102 (66), 242 (F2), 243 (F3); escape 1 = 0F xx, 2 = 0F 3A xx; `wide` adds REX.W.\n// `reg` goes in ModRM.reg, `rm` in ModRM.rm (both registers).\nwaza sse_rr(a: Assembler, prefix: int64, wide: bool, escape: int64, op: int64, reg: int64, rm: int64) -> unit {\n    moshi (!valid_register(a, reg) || !valid_register(a, rm)) { kaesu; }\n    moshi (prefix != 0) { byte(a, prefix); }\n    kaku rex_bits = high(reg) * 4 + high(rm);\n    moshi (wide) { rex_bits = rex_bits + 8; }\n    moshi (rex_bits != 0) { byte(a, 64 + rex_bits); }\n    byte(a, 15);\n    moshi (escape == 2) { byte(a, 58); }\n    byte(a, op);\n    modrm(a, 3, reg, rm);\n}\nkoukai waza movq_xmm_r(a: Assembler, xmm: int64, r: int64) -> unit { sse_rr(a, 102, hai, 1, 110, xmm, r); }\nkoukai waza movq_r_xmm(a: Assembler, r: int64, xmm: int64) -> unit { sse_rr(a, 102, hai, 1, 126, xmm, r); }\nkoukai waza movd_xmm_r(a: Assembler, xmm: int64, r: int64) -> unit { sse_rr(a, 102, iie, 1, 110, xmm, r); }\nkoukai waza movd_r_xmm(a: Assembler, r: int64, xmm: int64) -> unit { sse_rr(a, 102, iie, 1, 126, xmm, r); }\n// Arithmetic: double (F2) when `double`, single (F3) otherwise. op: 88 add, 92 sub, 89 mul, 94 div, 81 sqrt.\nkoukai waza sse_arith(a: Assembler, double: bool, op: int64, dst: int64, src: int64) -> unit {\n    kaku prefix = 243;\n    moshi (double) { prefix = 242; }\n    sse_rr(a, prefix, iie, 1, op, dst, src);\n}\nkoukai waza ucomis(a: Assembler, double: bool, left: int64, right: int64) -> unit {\n    kaku prefix = 0;\n    moshi (double) { prefix = 102; }\n    sse_rr(a, prefix, iie, 1, 46, left, right);\n}\nkoukai waza cvtsi2s(a: Assembler, double: bool, xmm: int64, r: int64) -> unit {\n    kaku prefix = 243;\n    moshi (double) { prefix = 242; }\n    sse_rr(a, prefix, hai, 1, 42, xmm, r);\n}\nkoukai waza cvtts2si(a: Assembler, double: bool, r: int64, xmm: int64) -> unit {\n    kaku prefix = 243;\n    moshi (double) { prefix = 242; }\n    sse_rr(a, prefix, hai, 1, 44, r, xmm);\n}\nkoukai waza cvtsd2ss(a: Assembler, dst: int64, src: int64) -> unit { sse_rr(a, 242, iie, 1, 90, dst, src); }\nkoukai waza cvtss2sd(a: Assembler, dst: int64, src: int64) -> unit { sse_rr(a, 243, iie, 1, 90, dst, src); }\n// roundsd/roundss dst, src, mode (8 nearest-even, 9 floor, 10 ceil, 11 truncate; SSE4.1).\nkoukai waza rounds(a: Assembler, double: bool, dst: int64, src: int64, mode: int64) -> unit {\n    kaku op = 10;\n    moshi (double) { op = 11; }\n    sse_rr(a, 102, iie, 2, op, dst, src);\n    byte(a, mode);\n}\n\nkoukai waza push_r(a: Assembler, r: int64) -> unit {\n    moshi (!valid_register(a, r)) { kaesu; }\n    moshi (r >= 8) { byte(a, 65); } byte(a, 80 + low3(r));\n}\nkoukai waza pop_r(a: Assembler, r: int64) -> unit {\n    moshi (!valid_register(a, r)) { kaesu; }\n    moshi (r >= 8) { byte(a, 65); } byte(a, 88 + low3(r));\n}\n// SETcc into the low byte of rax, zero-extended (the runtime IR's boolean).\nkoukai waza setcc_rax(a: Assembler, cc: int64) -> unit {\n    moshi (cc < 0 || cc > 15) { fail(a, \"INVALID_CONDITION\"); kaesu; }\n    byte(a, 15); byte(a, 144 + cc); byte(a, 192);\n    byte(a, 15); byte(a, 182); byte(a, 192);\n}\nkoukai waza ret(a: Assembler) -> unit { byte(a, 195); }\n// mov eax, imm32 (zero-extends into rax).\nkoukai waza mov_eax_imm(a: Assembler, value: int64) -> unit {\n    moshi (value < 0 || value > 2147483647) { fail(a, \"INVALID_IMMEDIATE\"); kaesu; }\n    byte(a, 184); imm32(a, value);\n}\n// mov eax,eax: zero-extends a 32-bit native result into rax.\nkoukai waza zero_extend_eax(a: Assembler) -> unit { byte(a, 137); byte(a, 192); }\n// The SYSCALL instruction itself (0F 05).\nkoukai waza syscall_raw(a: Assembler) -> unit { byte(a, 15); byte(a, 5); }\n// Darwin (macOS x86-64) mode, chosen by defining the label \"darwin_abi\" before any code is emitted: a Linux-convention\n// system call (number in eax, arguments in rdi rsi rdx r10 r8 r9, result or -errno in rax) becomes `call darwin_syscall`,\n// a runtime routine that performs the equivalent Darwin BSD call. Without the label this is the plain SYSCALL instruction,\n// so Linux images stay byte-identical.\nkoukai waza syscall(a: Assembler) -> unit {\n    moshi (find_label(a, \"darwin_abi\") >= 0) { call(a, \"darwin_syscall\"); kaesu; }\n    syscall_raw(a);\n}\nkoukai waza mfence(a: Assembler) -> unit { byte(a, 15); byte(a, 174); byte(a, 240); }\n// xchg [base], reg (implicitly locked): sequentially consistent store.\nkoukai waza xchg_store(a: Assembler, base: int64, reg: int64) -> unit {\n    moshi (!valid_register(a, reg) || !valid_register(a, base)) { kaesu; }\n    rex(a, reg, base); byte(a, 135); memory(a, reg, base, 0);\n}\n// SETcc into cl, zero-extended into rcx.\nkoukai waza setcc_rcx(a: Assembler, cc: int64) -> unit {\n    moshi (cc < 0 || cc > 15) { fail(a, \"INVALID_CONDITION\"); kaesu; }\n    byte(a, 15); byte(a, 144 + cc); byte(a, 193);\n    byte(a, 15); byte(a, 182); byte(a, 201);\n}\n// lock xadd [base], reg : reg receives the previous value.\nkoukai waza lock_xadd(a: Assembler, base: int64, reg: int64) -> unit {\n    moshi (!valid_register(a, reg) || !valid_register(a, base)) { kaesu; }\n    byte(a, 240); rex(a, reg, base); byte(a, 15); byte(a, 193); memory(a, reg, base, 0);\n}\n// lock cmpxchg [base], desired : compares with rax, ZF=1 on success, rax=observed.\nkoukai waza lock_cmpxchg(a: Assembler, base: int64, desired: int64) -> unit {\n    moshi (!valid_register(a, desired) || !valid_register(a, base)) { kaesu; }\n    byte(a, 240); rex(a, desired, base); byte(a, 15); byte(a, 177); memory(a, desired, base, 0);\n}\nkoukai waza call_r(a: Assembler, r: int64) -> unit {\n    moshi (!valid_register(a, r)) { kaesu; }\n    moshi (r >= 8) { byte(a, 65); } byte(a, 255); modrm(a, 3, 2, r);\n}\nkoukai waza call_memory(a: Assembler, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, base)) { kaesu; }\n    moshi (base >= 8) { byte(a, 65); } byte(a, 255); memory(a, 2, base, disp);\n}\n\nwaza label_hash(name: string) -> int64 {\n    kaku data = string.to_bytes(name);\n    kaku value = 5381;\n    kaku at = 0;\n    aida (at < len(data)) {\n        kaku next = value * 33 + int64(data[at]);\n        value = next - (next / 1073741789) * 1073741789;\n        at = at + 1;\n    }\n    kaesu value;\n}\n\nwaza find_label(a: Assembler, name: string) -> int64 {\n    kaku table = a.table[0];\n    kaku capacity = len(table);\n    kaku hash = label_hash(name);\n    kaku slot = hash - (hash / capacity) * capacity;\n    aida (table[slot] != 0) {\n        kaku entry = a.labels[table[slot] - 1];\n        moshi (entry.name == name) { kaesu entry.offset; }\n        slot = slot + 1;\n        moshi (slot == capacity) { slot = 0; }\n    }\n    kaesu -1;\n}\n\nwaza insert_label(table: []int64, labels: []Label, index: int64) -> unit {\n    kaku capacity = len(table);\n    kaku hash = label_hash(labels[index].name);\n    kaku slot = hash - (hash / capacity) * capacity;\n    aida (table[slot] != 0) { slot = slot + 1; moshi (slot == capacity) { slot = 0; } }\n    table[slot] = index + 1;\n}\n\nkoukai waza label(a: Assembler, name: string) -> unit {\n    moshi (find_label(a, name) >= 0) { fail(a, \"DUPLICATE_LABEL\"); kaesu; }\n    array.push(a.labels, Label { name: name, offset: len(a.bytes) });\n    kaku count = len(a.labels);\n    moshi (count * 2 > len(a.table[0])) {\n        kaku bigger = array.make[int64](len(a.table[0]) * 4, 0);\n        kaku index = 0;\n        aida (index < count) { insert_label(bigger, a.labels, index); index = index + 1; }\n        a.table[0] = bigger;\n    }\n    sore { insert_label(a.table[0], a.labels, count - 1); }\n}\nkoukai waza label_offset(a: Assembler, name: string) -> int64 { kaesu find_label(a, name); }\nwaza branch(a: Assembler, target: string) -> unit {\n    array.push(a.fixups, Fixup { at: len(a.bytes), target: target });\n    imm32(a, 0);\n}\nkoukai waza jmp(a: Assembler, target: string) -> unit { byte(a, 233); branch(a, target); }\nkoukai waza call(a: Assembler, target: string) -> unit { byte(a, 232); branch(a, target); }\nkoukai waza jcc(a: Assembler, cc: int64, target: string) -> unit {\n    moshi (cc < 0 || cc > 15) { fail(a, \"INVALID_CONDITION\"); kaesu; }\n    byte(a, 15); byte(a, 128 + cc); branch(a, target);\n}\n// lea dst, [rip + label]\nkoukai waza lea_label(a: Assembler, dst: int64, target: string) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, dst, 0); byte(a, 141); modrm(a, 0, dst, 5); branch(a, target);\n}\n\nkoukai waza assemble(a: Assembler) -> AssembleResult {\n    moshi (len(a.errors) > 0) { kaesu AssembleResult { bytes: [], error: a.errors[0] }; }\n    kaku output = array.clone(a.bytes);\n    kaku i = 0;\n    aida (i < len(a.fixups)) {\n        kaku f = a.fixups[i];\n        kaku target = find_label(a, f.target);\n        moshi (target < 0) { kaesu AssembleResult { bytes: [], error: \"UNDEFINED_LABEL\" }; }\n        kaku delta = target - (f.at + 4);\n        moshi (delta < -2147483648 || delta > 2147483647) { kaesu AssembleResult { bytes: [], error: \"BRANCH_OUT_OF_RANGE\" }; }\n        kaku x = delta; moshi (x < 0) { x = x + 4294967296; }\n        kaku k = 0;\n        aida (k < 4) { output[f.at + k] = uint8(x - (x / 256) * 256); x = x / 256; k = k + 1; }\n        i = i + 1;\n    }\n    kaesu AssembleResult { bytes: output, error: \"\" };\n}\n" }; }
waza data_53() -> File { kaesu File { path: "kiso/array/array.mio", version: "Bunko-v2.1.1", length: 790, sha256: "a2d7cbe2385873f015fc032ee1be309de7e93d813aaacbb69d279895e24e153f", source: "koukai waza make<T>(length: int64, initial: T) -> []T {\n    kaesu __array_make(length, initial);\n}\n\nkoukai waza with_capacity<T>(capacity: int64) -> []T {\n    kaesu __array_with_capacity(capacity);\n}\n\nkoukai waza push<T>(values: []T, value: T) -> unit {\n    __array_push(values, value);\n}\n\nkoukai waza capacity<T>(values: []T) -> int64 {\n    kaesu __array_capacity(values);\n}\n\nkoukai waza reserve<T>(values: []T, additional: int64) -> unit {\n    __array_reserve(values, additional);\n}\n\nkoukai waza clone<T>(values: []T) -> []T {\n    kaesu __array_clone(values);\n}\n\nkoukai waza truncate<T>(values: []T, new_length: int64) -> unit {\n    __array_truncate(values, new_length);\n}\n\nkoukai waza append_all<T>(destination: []T, source: []T) -> unit {\n    __array_append_all(destination, source);\n}\n" }; }
waza data_54() -> File { kaesu File { path: "kiso/bytes/bytes.mio", version: "Bunko-v2.1.1", length: 3321, sha256: "cca8c910bc492a3f39bd2872ef0923b55dc642b88bc0b5d810f9039e3e9e6c5f", source: "yobu \"kiso/array\";\n\nkoukai kata ByteBuffer { data: []uint8; }\n\nkoukai waza equal(left: []uint8, right: []uint8) -> bool {\n    moshi (len(left) != len(right)) { kaesu iie; }\n    kaku index = 0;\n    aida (index < len(left)) {\n        moshi (left[index] != right[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nkoukai waza compare(left: []uint8, right: []uint8) -> int64 {\n    kaku limit = len(left);\n    moshi (len(right) < limit) { limit = len(right); }\n    kaku index = 0;\n    aida (index < limit) {\n        moshi (left[index] < right[index]) { kaesu -1; }\n        moshi (left[index] > right[index]) { kaesu 1; }\n        index = index + 1;\n    }\n    moshi (len(left) < len(right)) { kaesu -1; }\n    moshi (len(left) > len(right)) { kaesu 1; }\n    kaesu 0;\n}\n\nkoukai waza index(values: []uint8, target: uint8) -> int64 {\n    kaku current = 0;\n    aida (current < len(values)) {\n        moshi (values[current] == target) { kaesu current; }\n        current = current + 1;\n    }\n    kaesu -1;\n}\n\nkoukai waza contains(values: []uint8, target: uint8) -> bool {\n    kaesu index(values, target) >= 0;\n}\n\nkoukai waza has_prefix(values: []uint8, prefix: []uint8) -> bool {\n    moshi (len(prefix) > len(values)) { kaesu iie; }\n    kaku index = 0;\n    aida (index < len(prefix)) {\n        moshi (values[index] != prefix[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nkoukai waza has_suffix(values: []uint8, suffix: []uint8) -> bool {\n    moshi (len(suffix) > len(values)) { kaesu iie; }\n    kaku offset = len(values) - len(suffix);\n    kaku index = 0;\n    aida (index < len(suffix)) {\n        moshi (values[offset + index] != suffix[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nkoukai waza copy(destination: []uint8, source: []uint8) -> int64 {\n    kaku count = len(destination);\n    moshi (len(source) < count) { count = len(source); }\n    kaku index = 0;\n    aida (index < count) {\n        destination[index] = source[index];\n        index = index + 1;\n    }\n    kaesu count;\n}\n\nkoukai waza fill(values: []uint8, value: uint8) -> unit {\n    kaku index = 0;\n    aida (index < len(values)) {\n        values[index] = value;\n        index = index + 1;\n    }\n    kaesu;\n}\n\nkoukai waza clone(values: []uint8) -> []uint8 {\n    kaesu array.clone(values);\n}\n\nkoukai waza new_buffer() -> ByteBuffer {\n    kaesu ByteBuffer { data: array.with_capacity[uint8](0) };\n}\n\nkoukai waza buffer_with_capacity(capacity: int64) -> ByteBuffer {\n    kaesu ByteBuffer { data: array.with_capacity[uint8](capacity) };\n}\n\nkoukai waza write_byte(buffer: ByteBuffer, value: uint8) -> unit {\n    array.push(buffer.data, value);\n}\n\nkoukai waza write(buffer: ByteBuffer, source: []uint8) -> int64 {\n    kaku count = len(source);\n    array.append_all(buffer.data, source);\n    kaesu count;\n}\n\nkoukai waza buffer_len(buffer: ByteBuffer) -> int64 {\n    kaesu len(buffer.data);\n}\n\nkoukai waza buffer_capacity(buffer: ByteBuffer) -> int64 {\n    kaesu array.capacity(buffer.data);\n}\n\nkoukai waza reset(buffer: ByteBuffer) -> unit {\n    array.truncate(buffer.data, 0);\n}\n\nkoukai waza buffer_clone(buffer: ByteBuffer) -> ByteBuffer {\n    kaesu ByteBuffer { data: array.clone(buffer.data) };\n}\n\nkoukai waza buffer_bytes(buffer: ByteBuffer) -> []uint8 {\n    kaesu array.clone(buffer.data);\n}\n" }; }
waza data_55() -> File { kaesu File { path: "kiso/convert/convert.mio", version: "Bunko-v2.1.1", length: 3103, sha256: "f802730285564dc17c44eaf860392e6b9df72e49a4b1163c0c29d0b8dd471b2d", source: "yobu \"kiso/bytes\";\nyobu \"kiso/string\";\n\nwaza parse_negative(data: []uint8, offset: int64, limit: int64) -> int64? {\n    kaku result: int64 = 0;\n    kaku cutoff = limit / 10;\n    kaku last_digit = -(limit - cutoff * 10);\n    kaku current_offset = offset;\n    aida (current_offset < len(data)) {\n        kaku current = data[current_offset];\n        moshi (current < 48 || current > 57) { kaesu mu; }\n        kaku digit = int64(current - 48);\n        moshi (result < cutoff || (result == cutoff && digit > last_digit)) { kaesu mu; }\n        result = result * 10 - digit;\n        current_offset = current_offset + 1;\n    }\n    kaesu result;\n}\n\nwaza format_negative(value: int64, negative: bool, capacity: int64) -> string {\n    kaku builder = string.builder_with_capacity(capacity);\n    kaku start: int64 = 0;\n    moshi (negative) {\n        bytes.write_byte(builder.buffer, uint8(45));\n        start = 1;\n    }\n    kaku current = value;\n    moshi (current == 0) {\n        bytes.write_byte(builder.buffer, uint8(48));\n    } sore {\n        aida (current != 0) {\n            kaku digit = -(current - (current / 10) * 10);\n            bytes.write_byte(builder.buffer, uint8(48 + digit));\n            current = current / 10;\n        }\n    }\n    kaku left = start;\n    kaku right = len(builder.buffer.data) - 1;\n    aida (left < right) {\n        kaku temporary = builder.buffer.data[left];\n        builder.buffer.data[left] = builder.buffer.data[right];\n        builder.buffer.data[right] = temporary;\n        left = left + 1;\n        right = right - 1;\n    }\n    kaesu string.builder_string(builder);\n}\n\nkoukai waza parse_int(value: string) -> int64? {\n    kaku data = string.to_bytes(value);\n    moshi (len(data) == 0) { kaesu mu; }\n    kaku offset: int64 = 0;\n    kaku negative = iie;\n    moshi (data[0] == 45) {\n        negative = hai;\n        offset = 1;\n    } sore {\n        moshi (data[0] == 43) { offset = 1; }\n    }\n    moshi (offset == len(data)) { kaesu mu; }\n    kaku limit: int64 = -9223372036854775807;\n    moshi (negative) { limit = limit - 1; }\n    kaku result = parse_negative(data, offset, limit);\n    moshi (result == mu) { kaesu mu; }\n    moshi (negative) { kaesu result; }\n    kaesu -result;\n}\n\nkoukai waza parse_uint(value: string) -> uint32? {\n    kaku data = string.to_bytes(value);\n    moshi (len(data) == 0) { kaesu mu; }\n    kaku offset: int64 = 0;\n    moshi (data[0] == 43) { offset = 1; }\n    moshi (offset == len(data)) { kaesu mu; }\n    kaku result = parse_negative(data, offset, -4294967295);\n    moshi (result == mu) { kaesu mu; }\n    kaesu uint32(-result);\n}\n\nkoukai waza format_int(value: int64) -> string {\n    moshi (value < 0) { kaesu format_negative(value, hai, 20); }\n    kaesu format_negative(-value, iie, 19);\n}\n\nkoukai waza format_uint(value: uint32) -> string {\n    kaesu format_negative(-int64(value), iie, 10);\n}\n\nkoukai waza parse_bool(value: string) -> bool? {\n    moshi (value == \"hai\") { kaesu hai; }\n    moshi (value == \"iie\") { kaesu iie; }\n    kaesu mu;\n}\n\nkoukai waza format_bool(value: bool) -> string {\n    moshi (value) { kaesu \"hai\"; }\n    kaesu \"iie\";\n}\n" }; }
waza data_56() -> File { kaesu File { path: "kiso/convert/float.mio", version: "Bunko-v2.1.1", length: 23219, sha256: "85b05cfd3ecc7e3eaa7dd56470f16c82970c2a753e9e4926b2cdde9a548a179c", source: "yobu \"kiso/array\";\nyobu \"kiso/bytes\";\nyobu \"kiso/math\";\nyobu \"kiso/string\";\n\nkata DecimalBig { limbs: []int64; }\n\nteisu decimal_base: int64 = 1000000000;\nteisu max_float_input_bytes: int64 = 10000;\n\nwaza big_zero() -> DecimalBig {\n    kaesu DecimalBig { limbs: array.with_capacity[int64](1) };\n}\n\nwaza big_one() -> DecimalBig {\n    kaku result = big_zero();\n    array.push(result.limbs, 1);\n    kaesu result;\n}\n\nwaza big_clone(value: DecimalBig) -> DecimalBig {\n    kaesu DecimalBig { limbs: array.clone(value.limbs) };\n}\n\nwaza big_normalize(value: DecimalBig) -> unit {\n    aida (len(value.limbs) > 0 && value.limbs[len(value.limbs) - 1] == 0) {\n        array.truncate(value.limbs, len(value.limbs) - 1);\n    }\n}\n\nwaza big_compare(left: DecimalBig, right: DecimalBig) -> int64 {\n    moshi (len(left.limbs) < len(right.limbs)) { kaesu -1; }\n    moshi (len(left.limbs) > len(right.limbs)) { kaesu 1; }\n    kaku index = len(left.limbs) - 1;\n    aida (index >= 0) {\n        moshi (left.limbs[index] < right.limbs[index]) { kaesu -1; }\n        moshi (left.limbs[index] > right.limbs[index]) { kaesu 1; }\n        index = index - 1;\n    }\n    kaesu 0;\n}\n\nwaza big_subtract(left: DecimalBig, right: DecimalBig) -> unit {\n    kaku borrow: int64 = 0;\n    kaku index: int64 = 0;\n    aida (index < len(left.limbs)) {\n        kaku subtrahend = borrow;\n        moshi (index < len(right.limbs)) { subtrahend = subtrahend + right.limbs[index]; }\n        kaku current = left.limbs[index] - subtrahend;\n        borrow = 0;\n        moshi (current < 0) {\n            current = current + decimal_base;\n            borrow = 1;\n        }\n        left.limbs[index] = current;\n        index = index + 1;\n    }\n    big_normalize(left);\n}\n\nwaza big_multiply_small(value: DecimalBig, factor: int64) -> unit {\n    moshi (factor == 0 || len(value.limbs) == 0) {\n        array.truncate(value.limbs, 0);\n        kaesu;\n    }\n    kaku carry: int64 = 0;\n    kaku index: int64 = 0;\n    aida (index < len(value.limbs)) {\n        kaku product = value.limbs[index] * factor + carry;\n        value.limbs[index] = product - (product / decimal_base) * decimal_base;\n        carry = product / decimal_base;\n        index = index + 1;\n    }\n    aida (carry != 0) {\n        array.push(value.limbs, carry - (carry / decimal_base) * decimal_base);\n        carry = carry / decimal_base;\n    }\n}\n\nwaza big_multiply_power(value: DecimalBig, factor: int64, exponent: int64) -> unit {\n    kaku remaining = exponent;\n    moshi (factor == 2) {\n        aida (remaining >= 29) {\n            big_multiply_small(value, 536870912);\n            remaining = remaining - 29;\n        }\n    }\n    moshi (factor == 5) {\n        aida (remaining >= 12) {\n            big_multiply_small(value, 244140625);\n            remaining = remaining - 12;\n        }\n    }\n    aida (remaining > 0) {\n        big_multiply_small(value, factor);\n        remaining = remaining - 1;\n    }\n}\n\nwaza big_divide_small(value: DecimalBig, divisor: int64) -> int64 {\n    kaku remainder: int64 = 0;\n    kaku index = len(value.limbs) - 1;\n    aida (index >= 0) {\n        kaku current = remainder * decimal_base + value.limbs[index];\n        value.limbs[index] = current / divisor;\n        remainder = current - value.limbs[index] * divisor;\n        index = index - 1;\n    }\n    big_normalize(value);\n    kaesu remainder;\n}\n\nwaza big_from_decimal(data: []uint8, start: int64, end: int64) -> DecimalBig {\n    kaku result = big_zero();\n    kaku right = end;\n    aida (right > start) {\n        kaku left = right - 9;\n        moshi (left < start) { left = start; }\n        kaku limb: int64 = 0;\n        kaku index = left;\n        aida (index < right) {\n            limb = limb * 10 + int64(data[index] - 48);\n            index = index + 1;\n        }\n        array.push(result.limbs, limb);\n        right = left;\n    }\n    big_normalize(result);\n    kaesu result;\n}\n\nwaza big_from_positive(value: int64) -> DecimalBig {\n    kaku result = big_zero();\n    kaku remaining = value;\n    aida (remaining != 0) {\n        kaku quotient = remaining / decimal_base;\n        array.push(result.limbs, remaining - quotient * decimal_base);\n        remaining = quotient;\n    }\n    kaesu result;\n}\n\nwaza append_positive_decimal(buffer: bytes.ByteBuffer, value: int64, width: int64) -> unit {\n    kaku temporary = array.with_capacity[uint8](20);\n    kaku remaining = value;\n    moshi (remaining == 0) { array.push(temporary, uint8(48)); }\n    aida (remaining != 0) {\n        kaku quotient = remaining / 10;\n        array.push(temporary, uint8(48 + remaining - quotient * 10));\n        remaining = quotient;\n    }\n    aida (len(temporary) < width) { array.push(temporary, uint8(48)); }\n    kaku index = len(temporary) - 1;\n    aida (index >= 0) {\n        bytes.write_byte(buffer, temporary[index]);\n        index = index - 1;\n    }\n}\n\nwaza big_decimal_bytes(value: DecimalBig) -> []uint8 {\n    kaku buffer = bytes.buffer_with_capacity(len(value.limbs) * 9);\n    kaku index = len(value.limbs) - 1;\n    moshi (index < 0) {\n        bytes.write_byte(buffer, uint8(48));\n        kaesu bytes.buffer_bytes(buffer);\n    }\n    append_positive_decimal(buffer, value.limbs[index], 1);\n    index = index - 1;\n    aida (index >= 0) {\n        append_positive_decimal(buffer, value.limbs[index], 9);\n        index = index - 1;\n    }\n    kaesu bytes.buffer_bytes(buffer);\n}\n\nwaza floor_divide(value: int64, divisor: int64) -> int64 {\n    kaku quotient = value / divisor;\n    moshi (value < 0 && value - quotient * divisor != 0) { quotient = quotient - 1; }\n    kaesu quotient;\n}\n\nwaza decimal_compare_power(significand: DecimalBig, exponent10: int64, exponent2: int64) -> int64 {\n    kaku left = big_clone(significand);\n    kaku right = big_one();\n    kaku shift: int64 = 0;\n    moshi (exponent10 >= 0) {\n        big_multiply_power(left, 5, exponent10);\n        shift = exponent2 - exponent10;\n    } sore {\n        big_multiply_power(right, 5, -exponent10);\n        shift = exponent2 - exponent10;\n    }\n    moshi (shift >= 0) {\n        big_multiply_power(right, 2, shift);\n    } sore {\n        big_multiply_power(left, 2, -shift);\n    }\n    kaesu big_compare(left, right);\n}\n\nwaza decimal_binary_exponent(significand: DecimalBig, decimal_digits: int64, exponent10: int64) -> int64 {\n    kaku adjusted = decimal_digits + exponent10 - 1;\n    kaku exponent2 = floor_divide(adjusted * 3322, 1000);\n    aida (decimal_compare_power(significand, exponent10, exponent2) < 0) {\n        exponent2 = exponent2 - 1;\n    }\n    aida (decimal_compare_power(significand, exponent10, exponent2 + 1) >= 0) {\n        exponent2 = exponent2 + 1;\n    }\n    kaesu exponent2;\n}\n\nwaza decimal_round_binary(significand: DecimalBig, exponent10: int64, scale2: int64, precision: int64) -> int64 {\n    kaku numerator = big_clone(significand);\n    kaku denominator = big_one();\n    moshi (exponent10 >= 0) {\n        big_multiply_power(numerator, 5, exponent10);\n    } sore {\n        big_multiply_power(denominator, 5, -exponent10);\n    }\n    kaku shift = exponent10 - scale2;\n    moshi (shift >= 0) {\n        big_multiply_power(numerator, 2, shift);\n    } sore {\n        big_multiply_power(denominator, 2, -shift);\n    }\n\n    kaku multiple = big_clone(denominator);\n    big_multiply_power(multiple, 2, precision);\n    kaku bit_value: int64 = 1;\n    kaku bit_index: int64 = 0;\n    aida (bit_index < precision) {\n        bit_value = bit_value * 2;\n        bit_index = bit_index + 1;\n    }\n    kaku quotient: int64 = 0;\n    kaku current = precision;\n    aida (current >= 0) {\n        moshi (big_compare(numerator, multiple) >= 0) {\n            big_subtract(numerator, multiple);\n            quotient = quotient + bit_value;\n        }\n        moshi (current > 0) { big_divide_small(multiple, 2); }\n        bit_value = bit_value / 2;\n        current = current - 1;\n    }\n\n    kaku doubled = big_clone(numerator);\n    big_multiply_small(doubled, 2);\n    kaku comparison = big_compare(doubled, denominator);\n    moshi (comparison > 0 || (comparison == 0 && quotient - (quotient / 2) * 2 != 0)) {\n        quotient = quotient + 1;\n    }\n    kaesu quotient;\n}\n\nkata ParsedDecimal {\n    negative: bool;\n    zero: bool;\n    significand: DecimalBig;\n    digits: int64;\n    exponent10: int64;\n}\n\nwaza parse_finite_decimal(data: []uint8) -> ParsedDecimal? {\n    moshi (len(data) == 0 || len(data) > max_float_input_bytes) { kaesu mu; }\n    kaku offset: int64 = 0;\n    kaku negative = iie;\n    moshi (data[0] == 45) {\n        negative = hai;\n        offset = 1;\n    } sore {\n        moshi (data[0] == 43) { offset = 1; }\n    }\n    moshi (offset == len(data)) { kaesu mu; }\n\n    kaku digits = array.with_capacity[uint8](len(data));\n    kaku fractional_digits: int64 = 0;\n    kaku saw_digit = iie;\n    kaku saw_point = iie;\n    aida (offset < len(data) && data[offset] != 101 && data[offset] != 69) {\n        kaku current = data[offset];\n        moshi (current == 46) {\n            moshi (saw_point) { kaesu mu; }\n            saw_point = hai;\n        } sore {\n            moshi (current < 48 || current > 57) { kaesu mu; }\n            saw_digit = hai;\n            array.push(digits, current);\n            moshi (saw_point) { fractional_digits = fractional_digits + 1; }\n        }\n        offset = offset + 1;\n    }\n    moshi (!saw_digit) { kaesu mu; }\n\n    kaku explicit_exponent: int64 = 0;\n    moshi (offset < len(data)) {\n        offset = offset + 1;\n        kaku exponent_negative = iie;\n        moshi (offset < len(data) && (data[offset] == 43 || data[offset] == 45)) {\n            exponent_negative = data[offset] == 45;\n            offset = offset + 1;\n        }\n        moshi (offset == len(data)) { kaesu mu; }\n        aida (offset < len(data)) {\n            kaku current = data[offset];\n            moshi (current < 48 || current > 57) { kaesu mu; }\n            moshi (explicit_exponent < 20000) {\n                explicit_exponent = explicit_exponent * 10 + int64(current - 48);\n                moshi (explicit_exponent > 20000) { explicit_exponent = 20000; }\n            }\n            offset = offset + 1;\n        }\n        moshi (exponent_negative) { explicit_exponent = -explicit_exponent; }\n    }\n\n    kaku first: int64 = 0;\n    aida (first < len(digits) && digits[first] == 48) { first = first + 1; }\n    moshi (first == len(digits)) {\n        kaesu ParsedDecimal { negative: negative, zero: hai, significand: big_zero(), digits: 1, exponent10: 0 };\n    }\n    kaku last = len(digits) - 1;\n    aida (last > first && digits[last] == 48) { last = last - 1; }\n    kaku trailing = len(digits) - 1 - last;\n    kaku count = last - first + 1;\n    kaesu ParsedDecimal {\n        negative: negative,\n        zero: iie,\n        significand: big_from_decimal(digits, first, last + 1),\n        digits: count,\n        exponent10: explicit_exponent - fractional_digits + trailing,\n    };\n}\n\nwaza scale_float64(value: int64, exponent2: int64) -> float64 {\n    kaku result = float64(value);\n    kaku remaining = exponent2;\n    aida (remaining > 0) {\n        result = result * 2.0;\n        remaining = remaining - 1;\n    }\n    aida (remaining < 0) {\n        result = result / 2.0;\n        remaining = remaining + 1;\n    }\n    kaesu result;\n}\n\nwaza scale_float32(value: int64, exponent2: int64) -> float32 {\n    kaku result = float32(value);\n    kaku remaining = exponent2;\n    aida (remaining > 0) {\n        result = result * float32(2.0);\n        remaining = remaining - 1;\n    }\n    aida (remaining < 0) {\n        result = result / float32(2.0);\n        remaining = remaining + 1;\n    }\n    kaesu result;\n}\n\nkoukai waza parse_float64(value: string) -> float64? {\n    moshi (value == \"NaN\") { kaesu 0.0 / 0.0; }\n    moshi (value == \"Infinity\" || value == \"+Infinity\") { kaesu 1.0 / 0.0; }\n    moshi (value == \"-Infinity\") { kaesu -1.0 / 0.0; }\n    kaku parsed = parse_finite_decimal(string.to_bytes(value));\n    moshi (parsed == mu) { kaesu mu; }\n    moshi (parsed.zero) {\n        moshi (parsed.negative) { kaesu -0.0; }\n        kaesu 0.0;\n    }\n    kaku adjusted = parsed.digits + parsed.exponent10 - 1;\n    moshi (adjusted > 308) { kaesu mu; }\n    moshi (adjusted < -324) {\n        moshi (parsed.negative) { kaesu -0.0; }\n        kaesu 0.0;\n    }\n    kaku exponent2 = decimal_binary_exponent(parsed.significand, parsed.digits, parsed.exponent10);\n    kaku scale2 = exponent2 - 52;\n    moshi (exponent2 < -1022) { scale2 = -1074; }\n    kaku significand = decimal_round_binary(parsed.significand, parsed.exponent10, scale2, 53);\n    moshi (significand == 9007199254740992 && exponent2 >= 1023) { kaesu mu; }\n    kaku result = scale_float64(significand, scale2);\n    moshi (math.is_inf(result)) { kaesu mu; }\n    moshi (parsed.negative) { result = -result; }\n    kaesu result;\n}\n\nkoukai waza parse_float32(value: string) -> float32? {\n    moshi (value == \"NaN\") { kaesu float32(0.0) / float32(0.0); }\n    moshi (value == \"Infinity\" || value == \"+Infinity\") { kaesu float32(1.0) / float32(0.0); }\n    moshi (value == \"-Infinity\") { kaesu -float32(1.0) / float32(0.0); }\n    kaku parsed = parse_finite_decimal(string.to_bytes(value));\n    moshi (parsed == mu) { kaesu mu; }\n    moshi (parsed.zero) {\n        moshi (parsed.negative) { kaesu -float32(0.0); }\n        kaesu float32(0.0);\n    }\n    kaku adjusted = parsed.digits + parsed.exponent10 - 1;\n    moshi (adjusted > 38) { kaesu mu; }\n    moshi (adjusted < -46) {\n        moshi (parsed.negative) { kaesu -float32(0.0); }\n        kaesu float32(0.0);\n    }\n    kaku exponent2 = decimal_binary_exponent(parsed.significand, parsed.digits, parsed.exponent10);\n    kaku scale2 = exponent2 - 23;\n    moshi (exponent2 < -126) { scale2 = -149; }\n    kaku significand = decimal_round_binary(parsed.significand, parsed.exponent10, scale2, 24);\n    moshi (significand == 16777216 && exponent2 >= 127) { kaesu mu; }\n    kaku result = scale_float32(significand, scale2);\n    moshi (math.is_inf(result)) { kaesu mu; }\n    moshi (parsed.negative) { result = -result; }\n    kaesu result;\n}\n\nwaza exact_decimal(significand: int64, exponent2: int64) -> ParsedDecimal {\n    kaku coefficient = big_from_positive(significand);\n    kaku exponent10: int64 = 0;\n    moshi (exponent2 >= 0) {\n        big_multiply_power(coefficient, 2, exponent2);\n    } sore {\n        big_multiply_power(coefficient, 5, -exponent2);\n        exponent10 = exponent2;\n    }\n    aida (len(coefficient.limbs) > 0) {\n        kaku copy = big_clone(coefficient);\n        moshi (big_divide_small(copy, 10) != 0) { nukeru; }\n        coefficient = copy;\n        exponent10 = exponent10 + 1;\n    }\n    kaku digits = big_decimal_bytes(coefficient);\n    kaesu ParsedDecimal { negative: iie, zero: iie, significand: coefficient, digits: len(digits), exponent10: exponent10 };\n}\n\nwaza rounded_decimal_coefficient(digits: []uint8, precision: int64) -> int64 {\n    kaku coefficient: int64 = 0;\n    kaku index: int64 = 0;\n    aida (index < precision && index < len(digits)) {\n        coefficient = coefficient * 10 + int64(digits[index] - 48);\n        index = index + 1;\n    }\n    moshi (precision < len(digits)) {\n        kaku next = digits[precision] - 48;\n        kaku sticky = iie;\n        index = precision + 1;\n        aida (index < len(digits)) {\n            moshi (digits[index] != 48) { sticky = hai; nukeru; }\n            index = index + 1;\n        }\n        moshi (next > 5 || (next == 5 && (sticky || coefficient - (coefficient / 2) * 2 != 0))) {\n            coefficient = coefficient + 1;\n        }\n    }\n    kaesu coefficient;\n}\n\nwaza decimal_candidate(coefficient_value: int64, exponent10_value: int64) -> string {\n    kaku coefficient = coefficient_value;\n    kaku exponent10 = exponent10_value;\n    aida (coefficient > 9 && coefficient - (coefficient / 10) * 10 == 0) {\n        coefficient = coefficient / 10;\n        exponent10 = exponent10 + 1;\n    }\n    kaku coefficient_bytes = string.to_bytes(format_int(coefficient));\n    kaku point = len(coefficient_bytes) + exponent10;\n\n    kaku fixed = bytes.buffer_with_capacity(len(coefficient_bytes) + 16);\n    moshi (point <= 0) {\n        bytes.write_byte(fixed, uint8(48));\n        bytes.write_byte(fixed, uint8(46));\n        kaku zeros = -point;\n        aida (zeros > 0) { bytes.write_byte(fixed, uint8(48)); zeros = zeros - 1; }\n        bytes.write(fixed, coefficient_bytes);\n    } sore {\n        moshi (point >= len(coefficient_bytes)) {\n            bytes.write(fixed, coefficient_bytes);\n            kaku zeros = point - len(coefficient_bytes);\n            aida (zeros > 0) { bytes.write_byte(fixed, uint8(48)); zeros = zeros - 1; }\n        } sore {\n            kaku index: int64 = 0;\n            aida (index < len(coefficient_bytes)) {\n                moshi (index == point) { bytes.write_byte(fixed, uint8(46)); }\n                bytes.write_byte(fixed, coefficient_bytes[index]);\n                index = index + 1;\n            }\n        }\n    }\n\n    kaku scientific = bytes.buffer_with_capacity(len(coefficient_bytes) + 16);\n    bytes.write_byte(scientific, coefficient_bytes[0]);\n    moshi (len(coefficient_bytes) > 1) {\n        bytes.write_byte(scientific, uint8(46));\n        kaku index: int64 = 1;\n        aida (index < len(coefficient_bytes)) {\n            bytes.write_byte(scientific, coefficient_bytes[index]);\n            index = index + 1;\n        }\n    }\n    kaku scientific_exponent = exponent10 + len(coefficient_bytes) - 1;\n    moshi (scientific_exponent != 0) {\n        bytes.write_byte(scientific, uint8(101));\n        moshi (scientific_exponent > 0) { bytes.write_byte(scientific, uint8(43)); }\n        bytes.write(scientific, string.to_bytes(format_int(scientific_exponent)));\n    }\n    kaku fixed_text = string.from_utf8(bytes.buffer_bytes(fixed));\n    kaku scientific_text = string.from_utf8(bytes.buffer_bytes(scientific));\n    moshi (fixed_text != mu) {\n        moshi (scientific_text != mu) {\n            moshi (string.byte_len(scientific_text) < string.byte_len(fixed_text)) { kaesu scientific_text; }\n            kaesu fixed_text;\n        }\n    }\n    kaesu \"\";\n}\n\nwaza roundtrip_candidate64(value: float64, coefficient: int64, exponent10: int64) -> string? {\n    kaku candidate = decimal_candidate(coefficient, exponent10);\n    kaku parsed = parse_float64(candidate);\n    moshi (parsed != mu) {\n        moshi (parsed == value) { kaesu candidate; }\n    }\n    kaesu mu;\n}\n\nwaza roundtrip_candidate32(value: float32, coefficient: int64, exponent10: int64) -> string? {\n    kaku candidate = decimal_candidate(coefficient, exponent10);\n    kaku parsed = parse_float32(candidate);\n    moshi (parsed != mu) {\n        moshi (parsed == value) { kaesu candidate; }\n    }\n    kaesu mu;\n}\n\nwaza shorter_candidate(current: string, candidate: string?) -> string {\n    moshi (candidate == mu) { kaesu current; }\n    moshi (current == \"\" || string.byte_len(candidate) < string.byte_len(current)) { kaesu candidate; }\n    kaesu current;\n}\n\nwaza format_finite_float64(value: float64) -> string {\n    kaku normalized = value;\n    kaku exponent2: int64 = 0;\n    aida (normalized >= 2.0) { normalized = normalized / 2.0; exponent2 = exponent2 + 1; }\n    aida (normalized < 1.0) { normalized = normalized * 2.0; exponent2 = exponent2 - 1; }\n    kaku factor: float64 = 1.0;\n    kaku count: int64 = 0;\n    aida (count < 52) { factor = factor * 2.0; count = count + 1; }\n    kaku significand = int64(normalized * factor);\n    exponent2 = exponent2 - 52;\n    aida (significand - (significand / 2) * 2 == 0) { significand = significand / 2; exponent2 = exponent2 + 1; }\n    kaku exact = exact_decimal(significand, exponent2);\n    kaku digits = big_decimal_bytes(exact.significand);\n    kaku lower: int64 = 1;\n    kaku upper: int64 = 17;\n    moshi (len(digits) < upper) { upper = len(digits); }\n    kaku best = \"\";\n    aida (lower <= upper) {\n        kaku precision = (lower + upper) / 2;\n        kaku coefficient = rounded_decimal_coefficient(digits, precision);\n        kaku exponent10 = exact.exponent10 + len(digits) - precision;\n        kaku current = roundtrip_candidate64(value, coefficient, exponent10);\n        kaku candidate = \"\";\n        moshi (current != mu) { candidate = current; }\n        moshi (coefficient > 0) {\n            candidate = shorter_candidate(candidate, roundtrip_candidate64(value, coefficient - 1, exponent10));\n        }\n        candidate = shorter_candidate(candidate, roundtrip_candidate64(value, coefficient + 1, exponent10));\n        moshi (candidate != \"\") {\n            best = candidate;\n            upper = precision - 1;\n        } sore {\n            lower = precision + 1;\n        }\n    }\n    kaesu best;\n}\n\nwaza format_finite_float32(value: float32) -> string {\n    kaku normalized = value;\n    kaku exponent2: int64 = 0;\n    aida (normalized >= float32(2.0)) { normalized = normalized / float32(2.0); exponent2 = exponent2 + 1; }\n    aida (normalized < float32(1.0)) { normalized = normalized * float32(2.0); exponent2 = exponent2 - 1; }\n    kaku factor: float32 = float32(1.0);\n    kaku count: int64 = 0;\n    aida (count < 23) { factor = factor * float32(2.0); count = count + 1; }\n    kaku significand = int64(normalized * factor);\n    exponent2 = exponent2 - 23;\n    aida (significand - (significand / 2) * 2 == 0) { significand = significand / 2; exponent2 = exponent2 + 1; }\n    kaku exact = exact_decimal(significand, exponent2);\n    kaku digits = big_decimal_bytes(exact.significand);\n    kaku lower: int64 = 1;\n    kaku upper: int64 = 9;\n    moshi (len(digits) < upper) { upper = len(digits); }\n    kaku best = \"\";\n    aida (lower <= upper) {\n        kaku precision = (lower + upper) / 2;\n        kaku coefficient = rounded_decimal_coefficient(digits, precision);\n        kaku exponent10 = exact.exponent10 + len(digits) - precision;\n        kaku current = roundtrip_candidate32(value, coefficient, exponent10);\n        kaku candidate = \"\";\n        moshi (current != mu) { candidate = current; }\n        moshi (coefficient > 0) {\n            candidate = shorter_candidate(candidate, roundtrip_candidate32(value, coefficient - 1, exponent10));\n        }\n        candidate = shorter_candidate(candidate, roundtrip_candidate32(value, coefficient + 1, exponent10));\n        moshi (candidate != \"\") {\n            best = candidate;\n            upper = precision - 1;\n        } sore {\n            lower = precision + 1;\n        }\n    }\n    kaesu best;\n}\n\nkoukai waza format_float64(value: float64) -> string {\n    moshi (math.is_nan(value)) { kaesu \"NaN\"; }\n    moshi (math.is_inf(value)) {\n        moshi (value < 0.0) { kaesu \"-Infinity\"; }\n        kaesu \"Infinity\";\n    }\n    moshi (value == 0.0) {\n        moshi (1.0 / value < 0.0) { kaesu \"-0\"; }\n        kaesu \"0\";\n    }\n    moshi (value < 0.0) { kaesu string.concat(\"-\", format_finite_float64(-value)); }\n    kaesu format_finite_float64(value);\n}\n\nkoukai waza format_float32(value: float32) -> string {\n    moshi (math.is_nan(value)) { kaesu \"NaN\"; }\n    moshi (math.is_inf(value)) {\n        moshi (value < float32(0.0)) { kaesu \"-Infinity\"; }\n        kaesu \"Infinity\";\n    }\n    moshi (value == float32(0.0)) {\n        moshi (float32(1.0) / value < float32(0.0)) { kaesu \"-0\"; }\n        kaesu \"0\";\n    }\n    moshi (value < float32(0.0)) { kaesu string.concat(\"-\", format_finite_float32(-value)); }\n    kaesu format_finite_float32(value);\n}\n" }; }
waza data_57() -> File { kaesu File { path: "kiso/crypto/sha256/sha256.mio", version: "Bunko-v2.1.1", length: 21396, sha256: "9baa9b77994d5b7bd05b7f14b0a5e68ea8e668d88bbf031ec5dacd818d8ce674", source: "yobu \"kiso/array\";\n\n// Immutable arithmetic lookup tables; no host crypto or foreign compiler is\n// involved. Values stay nonnegative int64 while sums wrap modulo 2^32.\nkoukai kata Context { xor_nibbles: []int64; powers: []int64; constants: []int64; byte_tables: []Tables; }\n\nkoukai waza context() -> Context {\n    kaku table: []int64 = []; kaku b = 0;\n    aida (b < 16) {\n        kaku a = 0;\n        aida (a < 16) {\n            kaku left = a; kaku right = b; kaku power = 1; kaku result = 0; kaku bit = 0;\n            aida (bit < 4) {\n                kaku x = left - (left / 2) * 2; kaku y = right - (right / 2) * 2;\n                moshi (x != y) { result = result + power; }\n                left = left / 2; right = right / 2; power = power * 2; bit = bit + 1;\n            }\n            array.push(table, result); a = a + 1;\n        }\n        b = b + 1;\n    }\n    kaku powers: []int64 = [1]; kaku at = 0;\n    aida (at < 32) { array.push(powers, powers[at] * 2); at = at + 1; }\n    kaku cache: []Tables = [];\n    kaesu Context { xor_nibbles: table, powers: powers, byte_tables: cache, constants: [\n        1116352408,1899447441,3049323471,3921009573,961987163,1508970993,2453635748,2870763221,\n        3624381080,310598401,607225278,1426881987,1925078388,2162078206,2614888103,3248222580,\n        3835390401,4022224774,264347078,604807628,770255983,1249150122,1555081692,1996064986,\n        2554220882,2821834349,2952996808,3210313671,3336571891,3584528711,113926993,338241895,\n        666307205,773529912,1294757372,1396182291,1695183700,1986661051,2177026350,2456956037,\n        2730485921,2820302411,3259730800,3345764771,3516065817,3600352804,4094571909,275423344,\n        430227734,506948616,659060556,883997877,958139571,1322822218,1537002063,1747873779,\n        1955562222,2024104815,2227730452,2361852424,2428436474,2756734187,3204031479,3329325298] };\n}\n\n\n// Byte-sliced SHA-256. Mio has no bitwise operators, so XOR/AND of two bytes are two lookups in the 16x16 nibble XOR\n// table (via 256-entry nibble-split tables) and shifts are lookups in 9x256 tables. A 32-bit word is split into its four bytes once (three divisions) and all\n// rotations, Sigma/sigma, Ch and Maj work on bytes; additions stay on int64 values and wrap by subtraction. The\n// tables are built on first use and cached in the context, so reusing one context (as signing does) builds them once.\nkoukai kata Tables { nib: []int64; nib16: []int64; low: []int64; low16: []int64; high: []int64; high16: []int64; shr: []int64; shl: []int64; }\n\nwaza tables(ctx: Context) -> Tables {\n    moshi (len(ctx.byte_tables) > 0) { kaesu ctx.byte_tables[0]; }\n    // low/high nibble of every byte value, pre-scaled for the 16x16 nibble XOR table\n    kaku low = array.make[int64](256, 0); kaku low16 = array.make[int64](256, 0);\n    kaku high = array.make[int64](256, 0); kaku high16 = array.make[int64](256, 0);\n    kaku v = 0;\n    aida (v < 256) { kaku h = v / 16; high[v] = h; high16[v] = h * 16; low[v] = v - h * 16; low16[v] = low[v] * 16; v = v + 1; }\n    kaku nib16 = array.make[int64](256, 0); v = 0;\n    aida (v < 256) { nib16[v] = ctx.xor_nibbles[v] * 16; v = v + 1; }\n    kaku shr = array.make[int64](9 * 256, 0); kaku shl = array.make[int64](9 * 256, 0);\n    kaku shift = 0;\n    aida (shift <= 8) {\n        v = 0;\n        aida (v < 256) {\n            shr[shift * 256 + v] = v / ctx.powers[shift];\n            kaku left = v * ctx.powers[shift]; shl[shift * 256 + v] = left - (left / 256) * 256;\n            v = v + 1;\n        }\n        shift = shift + 1;\n    }\n    kaku built = Tables { nib: ctx.xor_nibbles, nib16: nib16, low: low, low16: low16, high: high, high16: high16, shr: shr, shl: shl };\n    array.push(ctx.byte_tables, built);\n    kaesu built;\n}\n\n// XOR and AND of two bytes: two lookups in the 16x16 nibble XOR table.\nwaza bx(t: Tables, a: int64, b: int64) -> int64 { kaesu t.nib[t.low[a] + t.low16[b]] + t.nib16[t.high[a] + t.high16[b]]; }\nwaza band(t: Tables, a: int64, b: int64) -> int64 { kaesu (a + b - bx(t, a, b)) / 2; }\n\nwaza wrap_sum(value: int64) -> int64 {\n    kaku result = value;\n    aida (result >= 4294967296) { result = result - 4294967296; }\n    kaesu result;\n}\n\n// bytes[base .. base + 3] = value (big endian)\nwaza split(value: int64, bytes: []int64, base: int64) -> unit {\n    kaku b0 = value / 16777216; kaku rest = value - b0 * 16777216;\n    kaku b1 = rest / 65536; rest = rest - b1 * 65536;\n    kaku b2 = rest / 256;\n    bytes[base] = b0; bytes[base + 1] = b1; bytes[base + 2] = b2; bytes[base + 3] = rest - b2 * 256;\n}\n\n// Byte i of ROTR(word, 8q + s) (rotate) or SHR(word, 8q + s) (shift) of the big-endian word at bytes[base].\nwaza rot_byte(t: Tables, bytes: []int64, base: int64, i: int64, q: int64, s: int64, shift: bool) -> int64 {\n    kaku k = i - q; kaku high = 0; kaku low = 0;\n    moshi (shift) {\n        moshi (k >= 0) { high = bytes[base + k]; }\n        moshi (k >= 1) { low = bytes[base + k - 1]; }\n    } sore {\n        moshi (k < 0) { k = k + 4; }\n        high = bytes[base + k];\n        kaku previous = k - 1; moshi (previous < 0) { previous = previous + 4; }\n        low = bytes[base + previous];\n    }\n    kaku complement = 8 - s;\n    kaesu t.shr[s * 256 + high] + t.shl[complement * 256 + low];\n}\n\n// ROTR(n1) ^ ROTR(n2) ^ (ROTR or SHR)(n3) of the word at bytes[base], as an int64.\nwaza sigma_bytes(t: Tables, bytes: []int64, base: int64, n1: int64, n2: int64, n3: int64, small: bool) -> int64 {\n    kaku q1 = n1 / 8; kaku s1 = n1 - q1 * 8; kaku q2 = n2 / 8; kaku s2 = n2 - q2 * 8; kaku q3 = n3 / 8; kaku s3 = n3 - q3 * 8;\n    kaku value = 0; kaku i = 0;\n    aida (i < 4) {\n        kaku r1 = rot_byte(t, bytes, base, i, q1, s1, iie);\n        kaku r2 = rot_byte(t, bytes, base, i, q2, s2, iie);\n        kaku r3 = rot_byte(t, bytes, base, i, q3, s3, small);\n        value = value * 256 + bx(t, bx(t, r1, r2), r3);\n        i = i + 1;\n    }\n    kaesu value;\n}\n\n// Hash a range without allocating a copy of the input. Invalid ranges return an empty digest; callers must check the\n// 32-byte result.\nkoukai waza sum_range(ctx: Context, data: []uint8, start: int64, length: int64) -> []uint8 {\n    moshi (start < 0 || length < 0 || start > len(data) || length > len(data) - start) { kaesu []; }\n    moshi (length >= fast_threshold) { kaesu sum_range_fast(ctx, data, start, length); }\n    kaesu sum_range_small(ctx, data, start, length);\n}\n\nwaza sum_range_small(ctx: Context, data: []uint8, start: int64, length: int64) -> []uint8 {\n    kaku t = tables(ctx);\n    kaku state: []int64 = [1779033703,3144134277,1013904242,2773480762,1359893119,2600822924,528734635,1541459225];\n    kaku words = array.make[int64](64, 0); kaku wbytes = array.make[int64](256, 0);\n    // working variables a..h: values and their bytes (rotated by reference each round)\n    kaku vb = array.make[int64](32, 0);\n    kaku tail = array.make[int64](128, 0);\n    kaku full = length / 64; kaku blocks = (length + 9 + 63) / 64; kaku block = 0;\n    // the padded tail (last one or two blocks)\n    kaku tail_start = full * 64; kaku at = 0;\n    aida (at < length - tail_start) { tail[at] = int64(data[start + tail_start + at]); at = at + 1; }\n    tail[length - tail_start] = 128;\n    kaku bits = length * 8; kaku position = (blocks - full) * 64 - 1;\n    aida (bits > 0) { kaku high = bits / 256; tail[position] = bits - high * 256; bits = high; position = position - 1; }\n    aida (block < blocks) {\n        kaku at = 0;\n        aida (at < 16) {\n            kaku b0 = 0; kaku b1 = 0; kaku b2 = 0; kaku b3 = 0;\n            moshi (block < full) {\n                kaku offset = start + block * 64 + at * 4;\n                b0 = int64(data[offset]); b1 = int64(data[offset + 1]); b2 = int64(data[offset + 2]); b3 = int64(data[offset + 3]);\n            } sore {\n                kaku offset = (block - full) * 64 + at * 4;\n                b0 = tail[offset]; b1 = tail[offset + 1]; b2 = tail[offset + 2]; b3 = tail[offset + 3];\n            }\n            wbytes[at * 4] = b0; wbytes[at * 4 + 1] = b1; wbytes[at * 4 + 2] = b2; wbytes[at * 4 + 3] = b3;\n            words[at] = ((b0 * 256 + b1) * 256 + b2) * 256 + b3; at = at + 1;\n        }\n        aida (at < 64) {\n            kaku value = wrap_sum(sigma_bytes(t, wbytes, (at - 2) * 4, 17, 19, 10, hai) + words[at - 7] +\n                sigma_bytes(t, wbytes, (at - 15) * 4, 7, 18, 3, hai) + words[at - 16]);\n            words[at] = value; split(value, wbytes, at * 4); at = at + 1;\n        }\n        // vb holds the bytes of a, b, c, d, e, f, g, h at 0, 4, ..., 28; slot[] maps a variable to its 4-byte group so\n        // the per-round shuffle moves indices, not bytes.\n        kaku a = state[0]; kaku b = state[1]; kaku c = state[2]; kaku d = state[3];\n        kaku e = state[4]; kaku f = state[5]; kaku g = state[6]; kaku h = state[7];\n        kaku ia = 0; kaku ib = 4; kaku ic = 8; kaku id = 12; kaku ie = 16; kaku iff = 20; kaku ig = 24; kaku ih = 28;\n        split(a, vb, ia); split(b, vb, ib); split(c, vb, ic); split(d, vb, id);\n        split(e, vb, ie); split(f, vb, iff); split(g, vb, ig); split(h, vb, ih);\n        at = 0;\n        aida (at < 64) {\n            kaku choice = 0; kaku majority = 0; kaku i = 0;\n            aida (i < 4) {\n                kaku eb = vb[ie + i]; kaku fb = vb[iff + i]; kaku gb = vb[ig + i];\n                kaku ab = vb[ia + i]; kaku bb = vb[ib + i]; kaku cb = vb[ic + i];\n                choice = choice * 256 + bx(t, gb, band(t, eb, bx(t, fb, gb)));\n                kaku axb = bx(t, ab, bb);\n                majority = majority * 256 + bx(t, band(t, ab, bb), band(t, cb, axb));\n                i = i + 1;\n            }\n            kaku first = wrap_sum(h + sigma_bytes(t, vb, ie, 6, 11, 25, iie) + choice + ctx.constants[at] + words[at]);\n            kaku second = wrap_sum(sigma_bytes(t, vb, ia, 2, 13, 22, iie) + majority);\n            // h <- g <- f <- e <- d + first; d <- c <- b <- a <- first + second (reusing the byte groups of h and d)\n            kaku free_e = ih; kaku free_a = id;\n            h = g; ih = ig; g = f; ig = iff; f = e; iff = ie; e = wrap_sum(d + first); ie = free_e; split(e, vb, ie);\n            d = c; id = ic; c = b; ic = ib; b = a; ib = ia; a = wrap_sum(first + second); ia = free_a; split(a, vb, ia);\n            at = at + 1;\n        }\n        state[0] = wrap_sum(state[0] + a); state[1] = wrap_sum(state[1] + b); state[2] = wrap_sum(state[2] + c); state[3] = wrap_sum(state[3] + d);\n        state[4] = wrap_sum(state[4] + e); state[5] = wrap_sum(state[5] + f); state[6] = wrap_sum(state[6] + g); state[7] = wrap_sum(state[7] + h);\n        block = block + 1;\n    }\n    kaku output: []uint8 = []; kaku oat = 0; kaku digest = array.make[int64](4, 0);\n    aida (oat < 8) {\n        split(state[oat], digest, 0);\n        array.push(output, uint8(digest[0])); array.push(output, uint8(digest[1])); array.push(output, uint8(digest[2])); array.push(output, uint8(digest[3]));\n        oat = oat + 1;\n    }\n    kaesu output;\n}\n// Inputs of at least this many bytes (one code-signing page) use 256x256 byte tables built once per context and a\n// call-free compression loop; smaller inputs keep the light path above. Both compute the same digest.\nteisu fast_threshold = 4096;\n\nwaza fast_tables(ctx: Context) -> []int64 {\n    // [0, 65536) XOR, [65536, 131072) AND, then 9x256 SHR and 9x256 SHL rows\n    moshi (len(ctx.byte_tables) > 1) { kaesu ctx.byte_tables[1].shr; }\n    kaku t = tables(ctx);\n    kaku table = array.make[int64](sigma_base + 16384, 0);\n    kaku a = 0; kaku index = 0;\n    aida (a < 256) {\n        kaku la = t.low[a]; kaku ha = t.high[a]; kaku b = 0;\n        aida (b < 256) {\n            kaku x = t.nib[la + t.low16[b]] + t.nib16[ha + t.high16[b]];\n            table[index] = x; table[65536 + index] = (a + b - x) / 2; b = b + 1; index = index + 1;\n        }\n        a = a + 1;\n    }\n    kaku at = 0;\n    aida (at < 2304) { table[131072 + at] = t.shr[at]; table[131072 + 2304 + at] = t.shl[at]; at = at + 1; }\n    // Sigma tables: the four functions are XOR-linear, so f(w) = T[f][0][b0] ^ T[f][1][b1] ^ T[f][2][b2] ^ T[f][3][b3]\n    // for the bytes b0..b3 of w (b0 most significant); T[f][j][v] holds the four output bytes of f(v << 8 (3 - j)).\n    // f: 0 Sigma1 (6, 11, 25), 1 Sigma0 (2, 13, 22), 2 sigma0 (7, 18, >>3), 3 sigma1 (17, 19, >>10).\n    kaku amounts = [6, 11, 25, 2, 13, 22, 7, 18, 3, 17, 19, 10]; kaku f = 0;\n    aida (f < 4) {\n        kaku j = 0;\n        aida (j < 4) {\n            kaku v = 0;\n            aida (v < 256) {\n                kaku word = v * ctx.powers[8 * (3 - j)];\n                kaku r1 = rotr32(ctx, word, amounts[f * 3]); kaku r2 = rotr32(ctx, word, amounts[f * 3 + 1]);\n                kaku r3 = rotr32(ctx, word, amounts[f * 3 + 2]); moshi (f >= 2) { r3 = word / ctx.powers[amounts[f * 3 + 2]]; }\n                kaku bi = 0; kaku divisor = 16777216;\n                aida (bi < 4) {\n                    kaku y1 = (r1 / divisor) - (r1 / divisor / 256) * 256; kaku y2 = (r2 / divisor) - (r2 / divisor / 256) * 256;\n                    kaku y3 = (r3 / divisor) - (r3 / divisor / 256) * 256;\n                    kaku y12 = table[y1 * 256 + y2];\n                    table[sigma_base + ((f * 4 + j) * 256 + v) * 4 + bi] = table[y12 * 256 + y3];\n                    divisor = divisor / 256; bi = bi + 1;\n                }\n                v = v + 1;\n            }\n            j = j + 1;\n        }\n        f = f + 1;\n    }\n    array.push(ctx.byte_tables, Tables { nib: [], nib16: [], low: [], low16: [], high: [], high16: [], shr: table, shl: [] });\n    kaesu table;\n}\n\nteisu sigma_base = 131072 + 4608;\n\nwaza rotr32(ctx: Context, word: int64, count: int64) -> int64 {\n    kaku high = word * ctx.powers[32 - count]; kaku wrapped = high - (high / 4294967296) * 4294967296;\n    kaesu word / ctx.powers[count] + wrapped;\n}\n\n// Word layout in the fast path: 12 entries per word, [0, 0, 0, 0, b0, b1, b2, b3, b0, b1, b2, b3] (b0 most significant).\n// Byte i of ROTR(w, 8q + s) is SHR_s(e[8 + i - q]) + SHL_(8-s)(e[7 + i - q]); of SHR(w, 8q + s) it is\n// SHR_s(e[4 + i - q]) + SHL_(8-s)(e[3 + i - q]), the leading zeros supplying the shifted-in bits.\nwaza put_word(bytes: []int64, base: int64, value: int64) -> unit {\n    kaku b0 = value / 16777216; kaku rest = value - b0 * 16777216; kaku b1 = rest / 65536; rest = rest - b1 * 65536;\n    kaku b2 = rest / 256; kaku b3 = rest - b2 * 256;\n    bytes[base + 4] = b0; bytes[base + 5] = b1; bytes[base + 6] = b2; bytes[base + 7] = b3;\n    bytes[base + 8] = b0; bytes[base + 9] = b1; bytes[base + 10] = b2; bytes[base + 11] = b3;\n}\n\n// One SHA-256 compression: state[0..7] (32-bit values) absorbs the block whose words are words[0..15] and whose bytes are\n// laid out in bytes as described above; words[16..63] and bytes are scratch. The Darwin/ARM64 backend implements calls to\n// this exact function with the ARMv8 SHA-256 instructions (x and bytes are then unused); it must keep this signature.\nwaza sha256_compress_native_block(state: []int64, words: []int64, k: []int64, x: []int64, bytes: []int64) -> unit {\n    kaku at = 16;\n    aida (at < 64) {\n        kaku s1 = 0; kaku s0 = 0; kaku i = 0;\n        kaku p = (at - 2) * 12 + 4; kaku q = (at - 15) * 12 + 4;\n        kaku p0 = sigma_base + (3 * 1024 + bytes[p]) * 4; kaku p1 = sigma_base + (3 * 1024 + 256 + bytes[p + 1]) * 4;\n        kaku p2 = sigma_base + (3 * 1024 + 512 + bytes[p + 2]) * 4; kaku p3 = sigma_base + (3 * 1024 + 768 + bytes[p + 3]) * 4;\n        kaku q0 = sigma_base + (2 * 1024 + bytes[q]) * 4; kaku q1 = sigma_base + (2 * 1024 + 256 + bytes[q + 1]) * 4;\n        kaku q2 = sigma_base + (2 * 1024 + 512 + bytes[q + 2]) * 4; kaku q3 = sigma_base + (2 * 1024 + 768 + bytes[q + 3]) * 4;\n        aida (i < 4) {\n            kaku u01 = x[x[p0 + i] * 256 + x[p1 + i]]; kaku u23 = x[x[p2 + i] * 256 + x[p3 + i]];\n            s1 = s1 * 256 + x[u01 * 256 + u23];\n            kaku v01 = x[x[q0 + i] * 256 + x[q1 + i]]; kaku v23 = x[x[q2 + i] * 256 + x[q3 + i]];\n            s0 = s0 * 256 + x[v01 * 256 + v23];\n            i = i + 1;\n        }\n        kaku value = s1 + words[at - 7] + s0 + words[at - 16];\n        aida (value >= 4294967296) { value = value - 4294967296; }\n        words[at] = value; put_word(bytes, at * 12, value);\n        at = at + 1;\n    }\n    kaku a = state[0]; kaku b = state[1]; kaku c = state[2]; kaku d = state[3];\n    kaku e = state[4]; kaku f = state[5]; kaku g = state[6]; kaku h = state[7];\n    // byte groups of the working variables; the round shuffle permutes these offsets, not bytes\n    kaku sa = 768; kaku sb = 780; kaku sc = 792; kaku sd = 804; kaku se = 816; kaku sf = 828; kaku sg = 840; kaku sh = 852;\n    put_word(bytes, sa, a); put_word(bytes, sb, b); put_word(bytes, sc, c); put_word(bytes, sd, d);\n    put_word(bytes, se, e); put_word(bytes, sf, f); put_word(bytes, sg, g); put_word(bytes, sh, h);\n    at = 0;\n    aida (at < 64) {\n        kaku sigma1 = 0; kaku sigma0 = 0; kaku choice = 0; kaku majority = 0; kaku i = 0;\n        kaku e0 = sigma_base + bytes[se + 4] * 4; kaku e1 = sigma_base + (256 + bytes[se + 5]) * 4;\n        kaku e2 = sigma_base + (512 + bytes[se + 6]) * 4; kaku e3 = sigma_base + (768 + bytes[se + 7]) * 4;\n        kaku a0 = sigma_base + (1024 + bytes[sa + 4]) * 4; kaku a1 = sigma_base + (1280 + bytes[sa + 5]) * 4;\n        kaku a2 = sigma_base + (1536 + bytes[sa + 6]) * 4; kaku a3 = sigma_base + (1792 + bytes[sa + 7]) * 4;\n        aida (i < 4) {\n            kaku u01 = x[x[e0 + i] * 256 + x[e1 + i]]; kaku u23 = x[x[e2 + i] * 256 + x[e3 + i]];\n            sigma1 = sigma1 * 256 + x[u01 * 256 + u23];\n            kaku v01 = x[x[a0 + i] * 256 + x[a1 + i]]; kaku v23 = x[x[a2 + i] * 256 + x[a3 + i]];\n            sigma0 = sigma0 * 256 + x[v01 * 256 + v23];\n            kaku eb = bytes[se + 4 + i]; kaku fb = bytes[sf + 4 + i]; kaku gb = bytes[sg + 4 + i];\n            kaku ab = bytes[sa + 4 + i]; kaku bb = bytes[sb + 4 + i]; kaku cb = bytes[sc + 4 + i];\n            choice = choice * 256 + x[gb * 256 + x[65536 + eb * 256 + x[fb * 256 + gb]]];\n            majority = majority * 256 + x[x[65536 + ab * 256 + bb] * 256 + x[65536 + cb * 256 + x[ab * 256 + bb]]];\n            i = i + 1;\n        }\n        kaku first = h + sigma1 + choice + k[at] + words[at];\n        aida (first >= 4294967296) { first = first - 4294967296; }\n        kaku second = sigma0 + majority;\n        aida (second >= 4294967296) { second = second - 4294967296; }\n        kaku free_e = sh; kaku free_a = sd;\n        h = g; sh = sg; g = f; sg = sf; f = e; sf = se; e = d + first; aida (e >= 4294967296) { e = e - 4294967296; } se = free_e;\n        d = c; sd = sc; c = b; sc = sb; b = a; sb = sa; a = first + second; aida (a >= 4294967296) { a = a - 4294967296; } sa = free_a;\n        put_word(bytes, se, e); put_word(bytes, sa, a);\n        at = at + 1;\n    }\n    state[0] = wrap_sum(state[0] + a); state[1] = wrap_sum(state[1] + b); state[2] = wrap_sum(state[2] + c); state[3] = wrap_sum(state[3] + d);\n    state[4] = wrap_sum(state[4] + e); state[5] = wrap_sum(state[5] + f); state[6] = wrap_sum(state[6] + g); state[7] = wrap_sum(state[7] + h);\n}\n\nwaza sum_range_fast(ctx: Context, data: []uint8, start: int64, length: int64) -> []uint8 {\n    kaku x = fast_tables(ctx);\n    kaku state: []int64 = [1779033703,3144134277,1013904242,2773480762,1359893119,2600822924,528734635,1541459225];\n    kaku words = array.make[int64](64, 0);\n    // W[0..63] at 12t, working variables at 768 + 12v; the four leading entries of every word stay zero\n    kaku bytes = array.make[int64](768 + 96, 0);\n    kaku tail = array.make[int64](128, 0);\n    kaku full = length / 64; kaku blocks = (length + 9 + 63) / 64;\n    kaku tail_start = full * 64; kaku at = 0;\n    aida (at < length - tail_start) { tail[at] = int64(data[start + tail_start + at]); at = at + 1; }\n    tail[length - tail_start] = 128;\n    kaku bits = length * 8; kaku position = (blocks - full) * 64 - 1;\n    aida (bits > 0) { kaku high = bits / 256; tail[position] = bits - high * 256; bits = high; position = position - 1; }\n    kaku block = 0;\n    aida (block < blocks) {\n        at = 0;\n        aida (at < 16) {\n            kaku b0 = 0; kaku b1 = 0; kaku b2 = 0; kaku b3 = 0;\n            moshi (block < full) {\n                kaku offset = start + block * 64 + at * 4;\n                b0 = int64(data[offset]); b1 = int64(data[offset + 1]); b2 = int64(data[offset + 2]); b3 = int64(data[offset + 3]);\n            } sore {\n                kaku offset = (block - full) * 64 + at * 4;\n                b0 = tail[offset]; b1 = tail[offset + 1]; b2 = tail[offset + 2]; b3 = tail[offset + 3];\n            }\n            kaku base = at * 12;\n            bytes[base + 4] = b0; bytes[base + 5] = b1; bytes[base + 6] = b2; bytes[base + 7] = b3;\n            bytes[base + 8] = b0; bytes[base + 9] = b1; bytes[base + 10] = b2; bytes[base + 11] = b3;\n            words[at] = ((b0 * 256 + b1) * 256 + b2) * 256 + b3; at = at + 1;\n        }\n        sha256_compress_native_block(state, words, ctx.constants, x, bytes);\n        block = block + 1;\n    }\n    kaku output: []uint8 = []; kaku oat = 0; kaku digest = array.make[int64](4, 0);\n    aida (oat < 8) {\n        split(state[oat], digest, 0);\n        array.push(output, uint8(digest[0])); array.push(output, uint8(digest[1])); array.push(output, uint8(digest[2])); array.push(output, uint8(digest[3]));\n        oat = oat + 1;\n    }\n    kaesu output;\n}\n\nkoukai waza sum(data: []uint8) -> []uint8 { kaesu sum_range(context(), data, 0, len(data)); }\n" }; }
waza data_58() -> File { kaesu File { path: "kiso/encoding/binary/binary.mio", version: "Bunko-v2.1.1", length: 12931, sha256: "73f84eacaae6c6301b72150c24dbcc1748d76958a95258eb7bd014b610b38f0a", source: "yobu \"kiso/array\";\n\nkoukai sentaku BinaryError {\n    InvalidOffset;\n    InsufficientData;\n    Overflow;\n    MalformedVarint;\n}\n\nkoukai kata U8Result { value: uint8; error: BinaryError?; }\nkoukai kata U16Result { value: uint16; error: BinaryError?; }\nkoukai kata U32Result { value: uint32; error: BinaryError?; }\nkoukai kata I8Result { value: int8; error: BinaryError?; }\nkoukai kata I16Result { value: int16; error: BinaryError?; }\nkoukai kata I32Result { value: int32; error: BinaryError?; }\nkoukai kata I64Result { value: int64; error: BinaryError?; }\nkoukai kata BytesResult { data: []uint8; error: BinaryError?; }\nkoukai kata VarU32Result { value: uint32; count: int64; error: BinaryError?; }\nkoukai kata VarI64Result { value: int64; count: int64; error: BinaryError?; }\n\nwaza range_error(data: []uint8, offset: int64, width: int64) -> BinaryError? {\n    moshi (offset < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (offset > len(data) || width > len(data) - offset) { kaesu BinaryError.InsufficientData(); }\n    kaesu mu;\n}\n\nkoukai waza read_u8(data: []uint8, offset: int64) -> U8Result {\n    kaku failure = range_error(data, offset, 1);\n    moshi (failure != mu) { kaesu U8Result { value: uint8(0), error: failure }; }\n    kaesu U8Result { value: data[offset], error: mu };\n}\n\nkoukai waza read_u16_le(data: []uint8, offset: int64) -> U16Result {\n    kaku failure = range_error(data, offset, 2);\n    moshi (failure != mu) { kaesu U16Result { value: uint16(0), error: failure }; }\n    kaesu U16Result { value: uint16(int64(data[offset]) + int64(data[offset + 1]) * 256), error: mu };\n}\n\nkoukai waza read_u16_be(data: []uint8, offset: int64) -> U16Result {\n    kaku failure = range_error(data, offset, 2);\n    moshi (failure != mu) { kaesu U16Result { value: uint16(0), error: failure }; }\n    kaesu U16Result { value: uint16(int64(data[offset]) * 256 + int64(data[offset + 1])), error: mu };\n}\n\nkoukai waza read_u32_le(data: []uint8, offset: int64) -> U32Result {\n    kaku failure = range_error(data, offset, 4);\n    moshi (failure != mu) { kaesu U32Result { value: uint32(0), error: failure }; }\n    kaku value = int64(data[offset]) + int64(data[offset + 1]) * 256 + int64(data[offset + 2]) * 65536 + int64(data[offset + 3]) * 16777216;\n    kaesu U32Result { value: uint32(value), error: mu };\n}\n\nkoukai waza read_u32_be(data: []uint8, offset: int64) -> U32Result {\n    kaku failure = range_error(data, offset, 4);\n    moshi (failure != mu) { kaesu U32Result { value: uint32(0), error: failure }; }\n    kaku value = int64(data[offset]) * 16777216 + int64(data[offset + 1]) * 65536 + int64(data[offset + 2]) * 256 + int64(data[offset + 3]);\n    kaesu U32Result { value: uint32(value), error: mu };\n}\n\nkoukai waza read_i8(data: []uint8, offset: int64) -> I8Result {\n    kaku unsigned = read_u8(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I8Result { value: int8(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 128) { value = value - 256; }\n    kaesu I8Result { value: int8(value), error: mu };\n}\n\nkoukai waza read_i16_le(data: []uint8, offset: int64) -> I16Result {\n    kaku unsigned = read_u16_le(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I16Result { value: int16(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 32768) { value = value - 65536; }\n    kaesu I16Result { value: int16(value), error: mu };\n}\n\nkoukai waza read_i16_be(data: []uint8, offset: int64) -> I16Result {\n    kaku unsigned = read_u16_be(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I16Result { value: int16(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 32768) { value = value - 65536; }\n    kaesu I16Result { value: int16(value), error: mu };\n}\n\nkoukai waza read_i32_le(data: []uint8, offset: int64) -> I32Result {\n    kaku unsigned = read_u32_le(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I32Result { value: int32(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 2147483648) { value = value - 4294967296; }\n    kaesu I32Result { value: int32(value), error: mu };\n}\n\nkoukai waza read_i32_be(data: []uint8, offset: int64) -> I32Result {\n    kaku unsigned = read_u32_be(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I32Result { value: int32(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 2147483648) { value = value - 4294967296; }\n    kaesu I32Result { value: int32(value), error: mu };\n}\n\nwaza read_i64_order(data: []uint8, offset: int64, little: bool) -> I64Result {\n    kaku failure = range_error(data, offset, 8);\n    moshi (failure != mu) { kaesu I64Result { value: 0, error: failure }; }\n    kaku value = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 7) {\n        kaku byte_index = offset + index;\n        moshi (!little) { byte_index = offset + 7 - index; }\n        value = value + int64(data[byte_index]) * factor;\n        factor = factor * 256;\n        index = index + 1;\n    }\n    kaku top_index = offset + 7;\n    moshi (!little) { top_index = offset; }\n    value = value + (int64(data[top_index]) - 256) * factor;\n    moshi (data[top_index] < uint8(128)) { value = value + 256 * factor; }\n    kaesu I64Result { value: value, error: mu };\n}\n\nkoukai waza read_i64_le(data: []uint8, offset: int64) -> I64Result { kaesu read_i64_order(data, offset, hai); }\nkoukai waza read_i64_be(data: []uint8, offset: int64) -> I64Result { kaesu read_i64_order(data, offset, iie); }\n\nwaza write_unsigned(destination: []uint8, offset: int64, width: int64, value: int64, little: bool) -> BinaryError? {\n    kaku failure = range_error(destination, offset, width);\n    moshi (failure != mu) { kaesu failure; }\n    kaku remaining = value;\n    kaku index = 0;\n    aida (index < width) {\n        kaku byte_value = remaining - (remaining / 256) * 256;\n        kaku target = offset + index;\n        moshi (!little) { target = offset + width - 1 - index; }\n        destination[target] = uint8(byte_value);\n        remaining = remaining / 256;\n        index = index + 1;\n    }\n    kaesu mu;\n}\n\nwaza write_signed64(destination: []uint8, offset: int64, value: int64, little: bool) -> BinaryError? {\n    kaku failure = range_error(destination, offset, 8);\n    moshi (failure != mu) { kaesu failure; }\n    kaku remaining = value;\n    kaku index = 0;\n    aida (index < 8) {\n        kaku quotient = remaining / 256;\n        kaku remainder = remaining - quotient * 256;\n        moshi (remainder < 0) { remainder = remainder + 256; quotient = quotient - 1; }\n        kaku target = offset + index;\n        moshi (!little) { target = offset + 7 - index; }\n        destination[target] = uint8(remainder);\n        remaining = quotient;\n        index = index + 1;\n    }\n    kaesu mu;\n}\n\nkoukai waza write_u8(destination: []uint8, offset: int64, value: uint8) -> BinaryError? { kaesu write_unsigned(destination, offset, 1, int64(value), hai); }\nkoukai waza write_u16_le(destination: []uint8, offset: int64, value: uint16) -> BinaryError? { kaesu write_unsigned(destination, offset, 2, int64(value), hai); }\nkoukai waza write_u16_be(destination: []uint8, offset: int64, value: uint16) -> BinaryError? { kaesu write_unsigned(destination, offset, 2, int64(value), iie); }\nkoukai waza write_u32_le(destination: []uint8, offset: int64, value: uint32) -> BinaryError? { kaesu write_unsigned(destination, offset, 4, int64(value), hai); }\nkoukai waza write_u32_be(destination: []uint8, offset: int64, value: uint32) -> BinaryError? { kaesu write_unsigned(destination, offset, 4, int64(value), iie); }\nkoukai waza write_i8(destination: []uint8, offset: int64, value: int8) -> BinaryError? { kaesu write_unsigned(destination, offset, 1, int64(value) + 256, hai); }\nkoukai waza write_i16_le(destination: []uint8, offset: int64, value: int16) -> BinaryError? { kaesu write_unsigned(destination, offset, 2, int64(value) + 65536, hai); }\nkoukai waza write_i16_be(destination: []uint8, offset: int64, value: int16) -> BinaryError? { kaesu write_unsigned(destination, offset, 2, int64(value) + 65536, iie); }\nkoukai waza write_i32_le(destination: []uint8, offset: int64, value: int32) -> BinaryError? { kaesu write_unsigned(destination, offset, 4, int64(value) + 4294967296, hai); }\nkoukai waza write_i32_be(destination: []uint8, offset: int64, value: int32) -> BinaryError? { kaesu write_unsigned(destination, offset, 4, int64(value) + 4294967296, iie); }\nkoukai waza write_i64_le(destination: []uint8, offset: int64, value: int64) -> BinaryError? { kaesu write_signed64(destination, offset, value, hai); }\nkoukai waza write_i64_be(destination: []uint8, offset: int64, value: int64) -> BinaryError? { kaesu write_signed64(destination, offset, value, iie); }\n\nkoukai waza write_var_u32(value: uint32) -> BytesResult {\n    kaku output = array.with_capacity[uint8](5);\n    kaku remaining = int64(value);\n    aida (remaining >= 128) {\n        array.push(output, uint8(remaining - (remaining / 128) * 128 + 128));\n        remaining = remaining / 128;\n    }\n    array.push(output, uint8(remaining));\n    kaesu BytesResult { data: output, error: mu };\n}\n\nkoukai waza read_var_u32(data: []uint8, offset: int64) -> VarU32Result {\n    moshi (offset < 0) { kaesu VarU32Result { value: uint32(0), count: 0, error: BinaryError.InvalidOffset() }; }\n    kaku value = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 5) {\n        moshi (offset + index >= len(data)) { kaesu VarU32Result { value: uint32(0), count: index, error: BinaryError.InsufficientData() }; }\n        kaku current = int64(data[offset + index]);\n        kaku payload = current;\n        moshi (payload >= 128) { payload = payload - 128; }\n        moshi (index == 4 && payload > 15) { kaesu VarU32Result { value: uint32(0), count: 5, error: BinaryError.Overflow() }; }\n        value = value + payload * factor;\n        moshi (current < 128) {\n            kaku encoded = write_var_u32(uint32(value));\n            moshi (len(encoded.data) != index + 1) { kaesu VarU32Result { value: uint32(0), count: index + 1, error: BinaryError.MalformedVarint() }; }\n            kaesu VarU32Result { value: uint32(value), count: index + 1, error: mu };\n        }\n        factor = factor * 128;\n        index = index + 1;\n    }\n    kaesu VarU32Result { value: uint32(0), count: 5, error: BinaryError.MalformedVarint() };\n}\n\nkoukai waza write_var_i64(value: int64) -> BytesResult {\n    kaku output = array.with_capacity[uint8](10);\n    kaku remaining = value;\n    kaku done = iie;\n    aida (!done) {\n        kaku quotient = remaining / 128;\n        kaku payload = remaining - quotient * 128;\n        moshi (payload < 0) { payload = payload + 128; quotient = quotient - 1; }\n        done = (quotient == 0 && payload < 64) || (quotient == -1 && payload >= 64);\n        moshi (!done) { payload = payload + 128; }\n        array.push(output, uint8(payload));\n        remaining = quotient;\n    }\n    kaesu BytesResult { data: output, error: mu };\n}\n\nkoukai waza read_var_i64(data: []uint8, offset: int64) -> VarI64Result {\n    moshi (offset < 0) { kaesu VarI64Result { value: 0, count: 0, error: BinaryError.InvalidOffset() }; }\n    kaku value = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 10) {\n        moshi (offset + index >= len(data)) { kaesu VarI64Result { value: 0, count: index, error: BinaryError.InsufficientData() }; }\n        kaku current = int64(data[offset + index]);\n        kaku payload = current;\n        moshi (payload >= 128) { payload = payload - 128; }\n        moshi (index == 9) {\n            moshi (current != 0 && current != 127) { kaesu VarI64Result { value: 0, count: 10, error: BinaryError.Overflow() }; }\n            moshi (current == 127) { value = value - 9223372036854775807 - 1; }\n        } sore {\n            value = value + payload * factor;\n        }\n        moshi (current < 128) {\n            moshi (index < 9 && current >= 64) { value = value - factor * 128; }\n            kaku encoded = write_var_i64(value);\n            moshi (len(encoded.data) != index + 1) { kaesu VarI64Result { value: 0, count: index + 1, error: BinaryError.MalformedVarint() }; }\n            kaku compare = 0;\n            aida (compare < len(encoded.data)) {\n                moshi (encoded.data[compare] != data[offset + compare]) { kaesu VarI64Result { value: 0, count: index + 1, error: BinaryError.MalformedVarint() }; }\n                compare = compare + 1;\n            }\n            kaesu VarI64Result { value: value, count: index + 1, error: mu };\n        }\n        moshi (index == 9) { kaesu VarI64Result { value: 0, count: 10, error: BinaryError.MalformedVarint() }; }\n        factor = factor * 128;\n        index = index + 1;\n    }\n    kaesu VarI64Result { value: 0, count: 10, error: BinaryError.MalformedVarint() };\n}\n" }; }
waza data_59() -> File { kaesu File { path: "kiso/encoding/binary/stream.mio", version: "Bunko-v2.1.1", length: 9123, sha256: "74ad1f1ded30a44b604717e0221f09fb1d328b4a03ae8290a1676468f1dac0ce", source: "yobu \"kiso/array\";\n\n// U64 keeps the complete unsigned 64-bit bit pattern without adding uint64 to Mio.\nkoukai kata U64 { high: uint32; low: uint32; }\nkoukai kata U64Result { value: U64; error: BinaryError?; }\n\n// BinaryReader owns an immutable view of the caller's bytes and a private cursor cell.\n// Reads never modify data.  The single-element state array gives functions reference\n// semantics while keeping the public language free of pointers.\nkoukai kata BinaryReader { data: []uint8; state: []int64; }\n\nkoukai waza reader(data: []uint8) -> BinaryReader {\n    kaesu BinaryReader { data: data, state: [0] };\n}\n\nkoukai waza reader_offset(value: BinaryReader) -> int64 { kaesu value.state[0]; }\nkoukai waza reader_remaining(value: BinaryReader) -> int64 { kaesu len(value.data) - value.state[0]; }\nkoukai waza reader_eof(value: BinaryReader) -> bool { kaesu value.state[0] == len(value.data); }\n\nkoukai waza reader_seek(value: BinaryReader, offset: int64) -> BinaryError? {\n    moshi (offset < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (offset > len(value.data)) { kaesu BinaryError.InsufficientData(); }\n    value.state[0] = offset;\n    kaesu mu;\n}\n\nkoukai waza reader_skip(value: BinaryReader, count: int64) -> BinaryError? {\n    moshi (count < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (count > reader_remaining(value)) { kaesu BinaryError.InsufficientData(); }\n    value.state[0] = value.state[0] + count;\n    kaesu mu;\n}\n\nkoukai waza reader_read_u8(value: BinaryReader) -> U8Result {\n    kaku result = read_u8(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 1; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u16_le(value: BinaryReader) -> U16Result {\n    kaku result = read_u16_le(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 2; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u16_be(value: BinaryReader) -> U16Result {\n    kaku result = read_u16_be(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 2; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u32_le(value: BinaryReader) -> U32Result {\n    kaku result = read_u32_le(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 4; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u32_be(value: BinaryReader) -> U32Result {\n    kaku result = read_u32_be(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 4; }\n    kaesu result;\n}\n\nwaza read_u64_order(value: BinaryReader, little: bool) -> U64Result {\n    kaku failure = range_error(value.data, value.state[0], 8);\n    moshi (failure != mu) { kaesu U64Result { value: U64 { high: uint32(0), low: uint32(0) }, error: failure }; }\n    kaku high = read_u32_be(value.data, value.state[0]);\n    kaku low = read_u32_be(value.data, value.state[0] + 4);\n    moshi (little) {\n        low = read_u32_le(value.data, value.state[0]);\n        high = read_u32_le(value.data, value.state[0] + 4);\n    }\n    value.state[0] = value.state[0] + 8;\n    kaesu U64Result { value: U64 { high: high.value, low: low.value }, error: mu };\n}\n\nkoukai waza reader_read_u64_le(value: BinaryReader) -> U64Result { kaesu read_u64_order(value, hai); }\nkoukai waza reader_read_u64_be(value: BinaryReader) -> U64Result { kaesu read_u64_order(value, iie); }\n\nkoukai waza reader_read_bytes(value: BinaryReader, count: int64) -> BytesResult {\n    moshi (count < 0) { kaesu BytesResult { data: [], error: BinaryError.InvalidOffset() }; }\n    moshi (count > reader_remaining(value)) { kaesu BytesResult { data: [], error: BinaryError.InsufficientData() }; }\n    kaku output = array.with_capacity[uint8](count);\n    kaku index = 0;\n    aida (index < count) {\n        array.push(output, value.data[value.state[0] + index]);\n        index = index + 1;\n    }\n    value.state[0] = value.state[0] + count;\n    kaesu BytesResult { data: output, error: mu };\n}\n\n// max_length is a hard allocation ceiling. A negative limit is rejected.\nkoukai kata BinaryWriter { data: []uint8; max_length: int64; }\n\nkoukai waza writer(max_length: int64) -> BinaryWriter {\n    kaku limit = max_length;\n    moshi (limit < 0) { limit = 0; }\n    kaesu BinaryWriter { data: array.with_capacity[uint8](0), max_length: limit };\n}\n\nkoukai waza writer_offset(value: BinaryWriter) -> int64 { kaesu len(value.data); }\n\nwaza writer_grow(value: BinaryWriter, count: int64) -> BinaryError? {\n    moshi (count < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (len(value.data) > value.max_length || count > value.max_length - len(value.data)) { kaesu BinaryError.Overflow(); }\n    kaku target = len(value.data) + count;\n    array.reserve(value.data, count);\n    aida (len(value.data) < target) { array.push(value.data, uint8(0)); }\n    kaesu mu;\n}\n\nkoukai waza writer_reserve(value: BinaryWriter, count: int64) -> I64Result {\n    kaku offset = len(value.data);\n    kaku failure = writer_grow(value, count);\n    moshi (failure != mu) { kaesu I64Result { value: -1, error: failure }; }\n    kaesu I64Result { value: offset, error: mu };\n}\n\nkoukai waza writer_write_bytes(value: BinaryWriter, source: []uint8) -> BinaryError? {\n    kaku start = writer_reserve(value, len(source));\n    moshi (start.error != mu) { kaesu start.error; }\n    kaku index = 0;\n    aida (index < len(source)) { value.data[start.value + index] = source[index]; index = index + 1; }\n    kaesu mu;\n}\n\nkoukai waza writer_write_length_prefixed(value: BinaryWriter, source: []uint8) -> BinaryError? {\n    moshi (len(source) > 4294967295) { kaesu BinaryError.Overflow(); }\n    moshi (len(value.data) > value.max_length || value.max_length - len(value.data) < 4 ||\n        len(source) > value.max_length - len(value.data) - 4) { kaesu BinaryError.Overflow(); }\n    kaku failure = writer_write_u32_be(value, uint32(len(source)));\n    moshi (failure != mu) { kaesu failure; }\n    kaesu writer_write_bytes(value, source);\n}\n\nkoukai waza writer_write_u8(value: BinaryWriter, number: uint8) -> BinaryError? {\n    kaku start = writer_reserve(value, 1); moshi (start.error != mu) { kaesu start.error; }\n    kaesu write_u8(value.data, start.value, number);\n}\nkoukai waza writer_write_u16_le(value: BinaryWriter, number: uint16) -> BinaryError? {\n    kaku start = writer_reserve(value, 2); moshi (start.error != mu) { kaesu start.error; }\n    kaesu write_u16_le(value.data, start.value, number);\n}\nkoukai waza writer_write_u16_be(value: BinaryWriter, number: uint16) -> BinaryError? {\n    kaku start = writer_reserve(value, 2); moshi (start.error != mu) { kaesu start.error; }\n    kaesu write_u16_be(value.data, start.value, number);\n}\nkoukai waza writer_write_u32_le(value: BinaryWriter, number: uint32) -> BinaryError? {\n    kaku start = writer_reserve(value, 4); moshi (start.error != mu) { kaesu start.error; }\n    kaesu write_u32_le(value.data, start.value, number);\n}\nkoukai waza writer_write_u32_be(value: BinaryWriter, number: uint32) -> BinaryError? {\n    kaku start = writer_reserve(value, 4); moshi (start.error != mu) { kaesu start.error; }\n    kaesu write_u32_be(value.data, start.value, number);\n}\n\nwaza writer_write_u64_order(value: BinaryWriter, number: U64, little: bool) -> BinaryError? {\n    kaku start = writer_reserve(value, 8); moshi (start.error != mu) { kaesu start.error; }\n    moshi (little) {\n        write_u32_le(value.data, start.value, number.low);\n        kaesu write_u32_le(value.data, start.value + 4, number.high);\n    }\n    write_u32_be(value.data, start.value, number.high);\n    kaesu write_u32_be(value.data, start.value + 4, number.low);\n}\nkoukai waza writer_write_u64_le(value: BinaryWriter, number: U64) -> BinaryError? { kaesu writer_write_u64_order(value, number, hai); }\nkoukai waza writer_write_u64_be(value: BinaryWriter, number: U64) -> BinaryError? { kaesu writer_write_u64_order(value, number, iie); }\n\nkoukai waza writer_patch_u16_be(value: BinaryWriter, offset: int64, number: uint16) -> BinaryError? { kaesu write_u16_be(value.data, offset, number); }\nkoukai waza writer_patch_u16_le(value: BinaryWriter, offset: int64, number: uint16) -> BinaryError? { kaesu write_u16_le(value.data, offset, number); }\nkoukai waza writer_patch_u32_be(value: BinaryWriter, offset: int64, number: uint32) -> BinaryError? { kaesu write_u32_be(value.data, offset, number); }\nkoukai waza writer_patch_u32_le(value: BinaryWriter, offset: int64, number: uint32) -> BinaryError? { kaesu write_u32_le(value.data, offset, number); }\nkoukai waza writer_patch_u64_be(value: BinaryWriter, offset: int64, number: U64) -> BinaryError? {\n    kaku failure = write_u32_be(value.data, offset, number.high); moshi (failure != mu) { kaesu failure; }\n    kaesu write_u32_be(value.data, offset + 4, number.low);\n}\nkoukai waza writer_patch_u64_le(value: BinaryWriter, offset: int64, number: U64) -> BinaryError? {\n    kaku failure = write_u32_le(value.data, offset, number.low); moshi (failure != mu) { kaesu failure; }\n    kaesu write_u32_le(value.data, offset + 4, number.high);\n}\n\nkoukai waza writer_bytes(value: BinaryWriter) -> []uint8 { kaesu array.clone(value.data); }\n" }; }
waza data_60() -> File { kaesu File { path: "kiso/encoding/json/json.mio", version: "Bunko-v2.1.1", length: 10484, sha256: "bf01d6f6e3aa6e929290c17bfc912e9b64e838d21ab3e08ad4467459f9dba9fb", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\nyobu \"kiso/utf8\";\nyobu \"kiso/convert\";\n\n// Numbers retain their exact JSON token so request IDs never lose precision.\n// kind: null=0, bool=1, number=2, string=3, array=4, object=5.\nkoukai kata Value { kind: int64; text: string; children: []int64; keys: []string; }\nkoukai kata Document { values: []Value; root: int64; error: string; offset: int64; }\nkata State { data: []uint8; at: []int64; values: []Value; error: []string; }\nwaza byte(state: State) -> int64 { moshi (state.at[0] >= len(state.data)) { kaesu -1; } kaesu int64(state.data[state.at[0]]); }\nwaza fail(state: State, message: string) -> unit { moshi (state.error[0] == \"\") { state.error[0] = message; } }\nwaza whitespace(state: State) -> unit {\n    kaku value = byte(state);\n    aida (value == 32 || value == 9 || value == 10 || value == 13) { state.at[0] = state.at[0] + 1; value = byte(state); }\n}\nwaza text_range(data: []uint8, first: int64, end: int64) -> string {\n    kaku bytes: []uint8 = []; kaku at = first;\n    aida (at < end) { array.push(bytes, data[at]); at = at + 1; }\n    kaku text = string.from_utf8(bytes); moshi (text == mu) { kaesu \"\"; } kaesu text;\n}\nwaza hex(value: int64) -> int64 {\n    moshi (value >= 48 && value <= 57) { kaesu value - 48; }\n    moshi (value >= 65 && value <= 70) { kaesu value - 55; }\n    moshi (value >= 97 && value <= 102) { kaesu value - 87; } kaesu -1;\n}\nwaza hex4(data: []uint8, at: int64) -> int64 {\n    moshi (at < 0 || at + 4 > len(data)) { kaesu -1; }\n    kaku result = 0; kaku index = 0;\n    aida (index < 4) { kaku digit = hex(int64(data[at + index])); moshi (digit < 0) { kaesu -1; } result = result * 16 + digit; index = index + 1; }\n    kaesu result;\n}\nwaza parse_string(state: State) -> string {\n    moshi (byte(state) != 34) { fail(state, \"expected JSON string\"); kaesu \"\"; }\n    state.at[0] = state.at[0] + 1; kaku output: []uint8 = [];\n    aida (state.at[0] < len(state.data) && state.error[0] == \"\") {\n        kaku value = byte(state); state.at[0] = state.at[0] + 1;\n        moshi (value == 34) { kaku text = string.from_utf8(output); moshi (text == mu) { fail(state, \"invalid string UTF8\"); kaesu \"\"; } kaesu text; }\n        moshi (value < 32) { fail(state, \"unescaped string control byte\"); kaesu \"\"; }\n        moshi (value != 92) { array.push(output, uint8(value)); tsuzuku; }\n        kaku escaped = byte(state); state.at[0] = state.at[0] + 1;\n        moshi (escaped == 34 || escaped == 92 || escaped == 47) { array.push(output, uint8(escaped)); tsuzuku; }\n        kaku control = -1;\n        moshi (escaped == 98) { control = 8; } moshi (escaped == 102) { control = 12; } moshi (escaped == 110) { control = 10; }\n        moshi (escaped == 114) { control = 13; } moshi (escaped == 116) { control = 9; }\n        moshi (control >= 0) { array.push(output, uint8(control)); tsuzuku; }\n        moshi (escaped != 117) { fail(state, \"invalid JSON escape\"); kaesu \"\"; }\n        kaku scalar = hex4(state.data, state.at[0]);\n        moshi (scalar < 0) { fail(state, \"invalid Unicode escape\"); kaesu \"\"; }\n        state.at[0] = state.at[0] + 4;\n        moshi (scalar >= 55296 && scalar <= 56319) {\n            kaku low = -1;\n            moshi (state.at[0] + 6 <= len(state.data) && state.data[state.at[0]] == uint8(92) && state.data[state.at[0] + 1] == uint8(117)) { low = hex4(state.data, state.at[0] + 2); }\n            moshi (low >= 56320 && low <= 57343) { scalar = 65536 + (scalar - 55296) * 1024 + low - 56320; state.at[0] = state.at[0] + 6; }\n            sore { scalar = 65533; }\n        }\n        sore { moshi (scalar >= 56320 && scalar <= 57343) { scalar = 65533; } }\n        utf8.append_rune(output, rune(scalar));\n    }\n    fail(state, \"unterminated JSON string\"); kaesu \"\";\n}\nwaza push(state: State, kind: int64, text: string, children: []int64, keys: []string) -> int64 {\n    kaku id = len(state.values); array.push(state.values, Value { kind: kind, text: text, children: children, keys: keys }); kaesu id;\n}\nwaza keyword(state: State, expected: string, kind: int64) -> int64 {\n    kaku bytes = string.to_bytes(expected); kaku at = 0;\n    aida (at < len(bytes)) {\n        moshi (byte(state) != int64(bytes[at])) { fail(state, \"invalid JSON keyword\"); kaesu -1; }\n        state.at[0] = state.at[0] + 1; at = at + 1;\n    }\n    kaesu push(state, kind, expected, [], []);\n}\nwaza digit(value: int64) -> bool { kaesu value >= 48 && value <= 57; }\nwaza number(state: State) -> int64 {\n    kaku first = state.at[0]; moshi (byte(state) == 45) { state.at[0] = state.at[0] + 1; }\n    moshi (byte(state) == 48) { state.at[0] = state.at[0] + 1; }\n    sore { moshi (byte(state) < 49 || byte(state) > 57) { fail(state, \"invalid JSON number\"); kaesu -1; }\n        aida (digit(byte(state))) { state.at[0] = state.at[0] + 1; }\n    }\n    moshi (byte(state) == 46) {\n        state.at[0] = state.at[0] + 1; moshi (!digit(byte(state))) { fail(state, \"missing fraction digits\"); kaesu -1; }\n        aida (digit(byte(state))) { state.at[0] = state.at[0] + 1; }\n    }\n    moshi (byte(state) == 101 || byte(state) == 69) {\n        state.at[0] = state.at[0] + 1; moshi (byte(state) == 43 || byte(state) == 45) { state.at[0] = state.at[0] + 1; }\n        moshi (!digit(byte(state))) { fail(state, \"missing exponent digits\"); kaesu -1; }\n        aida (digit(byte(state))) { state.at[0] = state.at[0] + 1; }\n    }\n    kaesu push(state, 2, text_range(state.data, first, state.at[0]), [], []);\n}\nwaza value(state: State, depth: int64) -> int64 {\n    whitespace(state);\n    moshi (depth > 256 || len(state.values) >= 1000000) { fail(state, \"JSON structure limit exceeded\"); kaesu -1; }\n    kaku current = byte(state);\n    mosh