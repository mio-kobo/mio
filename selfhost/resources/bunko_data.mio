nativefs.op_none) {\n                moshi (!emit_native_body(code, patches, type_result, function, native_op)) { kaesu failed(LowerError.UnsupportedNative((id + 1) * 1000000)); }\n            }\n            sore {\n                problem = emit_block(code, patches, file, type_result, ids, function.instructions, string.concat(function_label(id), \"_\"), id);\n                moshi (problem != mu) { kaesu failed(problem); }\n            }\n            } emit_function_epilogue(code, id);\n        }\n        id = id + 1;\n    }\n    emit_print_int64(code);\n    emit_print_bool_nil(code);\n    emit_print_string(code);\n    emit_float_output_runtime(code);\n    moshi (managed) { emit_managed_runtime(code, gc_stress, metadata_bytes, observation); }\n    moshi (native_fs) { nativefs.emit_runtime(code, empty_string_id(file.constants, ids) * 2 + 1, patches, os_state); }\n    kaku pi = 0;\n    aida (pi < len(patches)) {\n        kaku patch = patches[pi];\n        moshi (patch.target_offset < 0) {\n            kaku target = arm64.assembler_label_word(code, function_label(-patch.target_offset - 1));\n            moshi (target < 0) { kaesu failed(LowerError.InvalidFunction()); }\n            patches[pi] = macho.AddressPatch { at_word: patch.at_word, add_at_word: patch.add_at_word, target: patch.target, target_offset: target * 4, register: patch.register };\n        }\n        pi = pi + 1;\n    }\n    kaku assembled = arm64.assembler_assemble(code);\n    moshi (assembled.error != mu) {\n        // All conditional fixups already own two words. Diagnose the actual\n        // remaining transfer (B/BL, or the B in a long conditional sequence).\n        moshi (len(code.errors) == 0) {\n            kaku i = 0;\n            aida (i < len(code.fixups)) {\n                kaku fix = code.fixups[i]; kaku target = arm64.assembler_label_word(code, fix.target);\n                kaku delta = target - fix.at_word;\n                moshi (fix.kind >= 2 && (delta < -262144 || delta > 262143) && !(fix.kind == 2 && fix.operand >= 14)) { delta = delta - 1; }\n                moshi (target >= 0 && (delta < -33554432 || delta > 33554431)) {\n                    kaesu failed(LowerError.BranchOutOfRange(fix.at_word));\n                }\n                i = i + 1;\n            }\n        }\n        kaesu failed(LowerError.EncodeFailure());\n    }\n    kaku data_words = file.global_count;\n    moshi (testing) { data_words = data_words + 1; }\n    moshi (os_state >= 0) { data_words = data_words + 3; }\n    kaesu LowerResult { words: assembled.words, constants: constant_image(file.constants, ids, native_fs), patches: patches, globals: data_words, error: mu };\n}\n" }; }
waza data_5() -> File { kaesu File { path: "kiso/aot/lower/map.mio", version: "Bunko-GF3-v0.2", length: 5018, sha256: "e4b100357dd6863896cd28041787d7d7d04208e859aebcb6a50b90069b47f3b4", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/string\";\n\n// Maps use ordinary exact-bitmap managed Struct objects, so the existing\n// non-moving collector, LOS and remembered-set protocol remain authoritative.\n// Descriptor: one reference field (head). Entry: next, key, nullable value.\n// Lookup is linear; replacing a key updates its entry without retaining history.\nwaza emit_map_header(code: arm64.Assembler, count: int64, bitmap: int64) -> unit {\n    emit(code, arm64.movz_x(9, 1, 0)); emit(code, arm64.str_x(9, 12, 0));\n    emit(code, arm64.movz_x(9, count, 0));\n    emit(code, arm64.str_x(9, 12, 8)); emit(code, arm64.str_x(9, 12, 16));\n    emit(code, arm64.movz_x(9, 1, 0)); emit(code, arm64.str_x(9, 12, 24));\n    emit(code, arm64.movz_x(9, bitmap, 0)); emit(code, arm64.str_x(9, 12, 32));\n}\n\nwaza emit_map(code: arm64.Assembler, patches: []macho.AddressPatch,\n    analysis: types.TypeAnalysis, function_id: int64, entries: []int64, opcode: int64) -> bool {\n    moshi (opcode == 41) {\n        kaku shadow = emit_shadow_push(code, patches, analysis, function_id, entries);\n        moshi (shadow < 0) { kaesu iie; }\n        move_bits(code, 0, uint32(0), uint32(48)); move_bits(code, 1, uint32(0), uint32(100));\n        arm64.assembler_bl(code, \"runtime_alloc\"); emit_shadow_pop(code, shadow);\n        arm64.assembler_cbz_x(code, 0, \"runtime_oom\"); move_x(code, 12, 0);\n        emit_map_header(code, 1, 1); emit(code, arm64.str_x(31, 12, 40)); push_register(code, 12);\n        kaesu hai;\n    }\n    kaku count = 2; moshi (opcode == 43) { count = 3; }\n    kaku first = len(entries) - count; moshi (first < 0) { kaesu iie; }\n    kaku key = entries[first + 1]; kaku kind = types.type_kind(analysis, key);\n    moshi (kind != types.type_integer && kind != types.type_bool && kind != types.type_string_id) { kaesu iie; }\n    kaku prefix = block_label(\"map_\", len(code.words));\n    kaku loop = string.concat(prefix, \"_loop\"); kaku missing = string.concat(prefix, \"_missing\");\n    kaku found = string.concat(prefix, \"_found\"); kaku done = string.concat(prefix, \"_done\");\n    // x22 is the Mio call-depth counter, not a disposable cursor register.\n    // Preserve it while searching; runtime allocation helpers preserve x22,\n    // and descriptor/entry operands remain in the exact Shadow Frame.\n    emit(code, arm64.sub_imm_x(31, 31, 16, iie)); emit(code, arm64.str_x(22, 31, 0));\n    emit(code, arm64.ldr_x(9, 19, first * 8)); arm64.assembler_cbz_x(code, 9, \"runtime_error\");\n    emit(code, arm64.ldr_x(22, 9, 40));\n    arm64.assembler_label(code, loop); arm64.assembler_cbz_x(code, 22, missing);\n    emit(code, arm64.ldr_x(9, 22, 48)); emit(code, arm64.ldr_x(10, 19, (first + 1) * 8));\n    moshi (kind == types.type_string_id) { emit_string_equal(code, 11); arm64.assembler_cbnz_x(code, 9, found); }\n    sore {\n        emit_unbox_register(code, analysis, key, 9); emit_unbox_register(code, analysis, key, 10);\n        emit(code, arm64.cmp_x(9, 10)); arm64.assembler_b_cond(code, 0, found);\n    }\n    emit(code, arm64.ldr_x(22, 22, 40)); arm64.assembler_b(code, loop);\n    arm64.assembler_label(code, found);\n    moshi (opcode == 42) {\n        emit(code, arm64.ldr_x(9, 22, 56)); emit(code, arm64.sub_imm_x(20, 20, 16, iie)); push_register(code, 9);\n    }\n    sore {\n        emit(code, arm64.ldr_x(9, 19, (first + 2) * 8)); emit(code, arm64.str_x(9, 22, 56));\n        emit_gen_remember(code, 22); emit(code, arm64.sub_imm_x(20, 20, 24, iie));\n    }\n    arm64.assembler_b(code, done); arm64.assembler_label(code, missing);\n    moshi (opcode == 42) {\n        emit(code, arm64.sub_imm_x(20, 20, 16, iie)); emit(code, arm64.movz_x(9, 0, 0)); push_register(code, 9);\n    }\n    sore {\n        kaku value = entries[first + 2]; moshi (!root_node_ok(analysis, value)) { kaesu iie; }\n        kaku bitmap = 1;\n        moshi (types.type_is_heap_reference(analysis, key)) { bitmap = bitmap + 2; }\n        moshi (types.type_is_heap_reference(analysis, value)) { bitmap = bitmap + 4; }\n        kaku shadow = emit_shadow_push(code, patches, analysis, function_id, entries);\n        moshi (shadow < 0) { kaesu iie; }\n        move_bits(code, 0, uint32(0), uint32(64)); move_bits(code, 1, uint32(0), uint32(100));\n        arm64.assembler_bl(code, \"runtime_alloc\"); emit_shadow_pop(code, shadow);\n        arm64.assembler_cbz_x(code, 0, \"runtime_oom\"); move_x(code, 12, 0);\n        emit_map_header(code, 3, bitmap);\n        emit(code, arm64.ldr_x(10, 19, first * 8)); emit(code, arm64.ldr_x(9, 10, 40)); emit(code, arm64.str_x(9, 12, 40));\n        emit(code, arm64.ldr_x(9, 19, (first + 1) * 8)); emit(code, arm64.str_x(9, 12, 48));\n        emit(code, arm64.ldr_x(9, 19, (first + 2) * 8)); emit(code, arm64.str_x(9, 12, 56));\n        emit(code, arm64.str_x(12, 10, 40)); emit_gen_remember(code, 10);\n        emit(code, arm64.sub_imm_x(20, 20, 24, iie));\n    }\n    arm64.assembler_label(code, done);\n    emit(code, arm64.ldr_x(22, 31, 0)); emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    kaesu hai;\n}\n" }; }
