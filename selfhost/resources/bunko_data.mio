waza data_14() -> File { kaesu File { path: "kiso/aot/macho/macho.mio", version: "Bunko-GF3-v0.2", length: 17454, sha256: "34b0a160b5af47334b901cf10be59f30b9bea5091c1c172e88e069e1a431631b", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/array\";\nyobu \"kiso/encoding/binary\";\n\n// Pure Mio Darwin ARM64 Mach-O writer. The layout intentionally mirrors the\n// proven Go AOT writer; relocation records remain empty because every label and\n// image-address patch is resolved before the file is emitted.\nkoukai sentaku MachOError {\n    EmptyText;\n    TooManyGlobals;\n    ImageTooLarge;\n    LoadCommandsTooLarge;\n    InvalidPatch;\n    EncodeFailure;\n    WriteFailure;\n}\n\nkoukai kata AddressTarget { kind: int64; }\nkoukai waza text_target() -> AddressTarget { kaesu AddressTarget { kind: 0 }; }\nkoukai waza const_target() -> AddressTarget { kaesu AddressTarget { kind: 1 }; }\nkoukai waza data_target() -> AddressTarget { kaesu AddressTarget { kind: 2 }; }\nkoukai kata AddressPatch { at_word: int64; add_at_word: int64; target: AddressTarget; target_offset: int64; register: int64; }\nkoukai kata Section { segment: string; name: string; file_offset: int64; vm_offset: int64; size: int64; alignment: int64; }\nkoukai kata Symbol { name: string; section: int64; value: int64; }\nkoukai kata Relocation { section: int64; offset: int64; symbol: int64; pc_relative: bool; width: int64; }\nkoukai kata Layout { text_size: int64; const_offset: int64; data_offset: int64; linkedit_offset: int64; file_size: int64; sections: []Section; }\nkoukai kata ImageSpec { words: []uint32; constants: []uint8; globals: int64; patches: []AddressPatch; }\nkoukai kata ImageResult { bytes: []uint8; layout: Layout; error: MachOError?; }\n\nteisu page_size = 16384;\nteisu entry_offset = 768;\nteisu maximum_image_size = 67108864;\n\nwaza align(value: int64, boundary: int64) -> int64 {\n    kaku remainder = value - (value / boundary) * boundary;\n    moshi (remainder == 0) { kaesu value; }\n    kaesu value + boundary - remainder;\n}\n\nkoukai waza plan(code_size: int64, const_size: int64, globals: int64) -> Layout {\n    kaku const_offset = align(entry_offset + code_size, 8);\n    kaku text_end = entry_offset + code_size;\n    moshi (const_size > 0) { text_end = const_offset + const_size; }\n    kaku text_size = align(text_end, page_size);\n    kaku data_size = 0; moshi (globals > 0) { data_size = align(globals * 8, page_size); }\n    kaku sections = array.with_capacity[Section](3);\n    array.push(sections, Section { segment: \"__TEXT\", name: \"__text\", file_offset: entry_offset, vm_offset: entry_offset, size: code_size, alignment: 2 });\n    moshi (const_size > 0) { array.push(sections, Section { segment: \"__TEXT\", name: \"__const\", file_offset: const_offset, vm_offset: const_offset, size: const_size, alignment: 3 }); }\n    moshi (globals > 0) { array.push(sections, Section { segment: \"__DATA\", name: \"__data\", file_offset: text_size, vm_offset: text_size, size: globals * 8, alignment: 3 }); }\n    kaesu Layout { text_size: text_size, const_offset: const_offset, data_offset: text_size, linkedit_offset: text_size + data_size, file_size: text_size + data_size, sections: sections };\n}\n\nwaza binary_failure(problem: binary.BinaryError?) -> MachOError? {\n    moshi (problem != mu) { kaesu MachOError.WriteFailure(); }\n    kaesu mu;\n}\nwaza put32(output: binary.BinaryWriter, value: int64) -> MachOError? {\n    moshi (value < 0 || value > 4294967295) { kaesu MachOError.WriteFailure(); }\n    kaesu binary_failure(binary.writer_write_u32_le(output, uint32(value)));\n}\nwaza put64(output: binary.BinaryWriter, high: int64, low: int64) -> MachOError? {\n    moshi (high < 0 || high > 4294967295 || low < 0 || low > 4294967295) { kaesu MachOError.WriteFailure(); }\n    kaesu binary_failure(binary.writer_write_u64_le(output, binary.U64 { high: uint32(high), low: uint32(low) }));\n}\nwaza put_bytes(output: binary.BinaryWriter, value: []uint8) -> MachOError? { kaesu binary_failure(binary.writer_write_bytes(output, value)); }\nwaza zeros(output: binary.BinaryWriter, count: int64) -> MachOError? { kaesu binary_failure(binary.writer_reserve(output, count).error); }\n\nwaza name16(output: binary.BinaryWriter, value: []uint8) -> MachOError? {\n    moshi (len(value) > 16) { kaesu MachOError.WriteFailure(); }\n    kaku failure = put_bytes(output, value); moshi (failure != mu) { kaesu failure; }\n    kaesu zeros(output, 16 - len(value));\n}\n\nwaza segment(output: binary.BinaryWriter, name: []uint8, vm_high: int64, vm_low: int64, vm_size_high: int64, vm_size: int64,\n             file_offset: int64, file_size: int64, max_protection: int64, initial_protection: int64,\n             section_count: int64, command_size: int64) -> MachOError? {\n    kaku failure = put32(output, 25); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, command_size); moshi (failure != mu) { kaesu failure; }\n    failure = name16(output, name); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, vm_high, vm_low); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, vm_size_high, vm_size); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, 0, file_offset); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, 0, file_size); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, max_protection); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, initial_protection); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, section_count); moshi (failure != mu) { kaesu failure; }\n    kaesu put32(output, 0);\n}\n\nwaza section(output: binary.BinaryWriter, section_name: []uint8, segment_name: []uint8,\n             vm_low: int64, size: int64, file_offset: int64, alignment: int64, flags: int64) -> MachOError? {\n    kaku failure = name16(output, section_name); moshi (failure != mu) { kaesu failure; }\n    failure = name16(output, segment_name); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, 1, vm_low); moshi (failure != mu) { kaesu failure; }\n    failure = put64(output, 0, size); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, file_offset); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, alignment); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, flags); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu failure; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu failure; }\n    kaesu put32(output, 0);\n}\n\nwaza target_is_const(value: AddressTarget) -> bool { kaesu value.kind == 1; }\nwaza target_is_data(value: AddressTarget) -> bool { kaesu value.kind == 2; }\nwaza target_is_text(value: AddressTarget) -> bool { kaesu value.kind == 0; }\n\nwaza patch_words(spec: ImageSpec, layout: Layout) -> ImageResult {\n    kaku words = array.clone(spec.words);\n    kaku index = 0;\n    aida (index < len(spec.patches)) {\n        kaku patch = spec.patches[index];\n        moshi (patch.at_word < 0 || patch.at_word >= len(words) || patch.target_offset < 0) {\n            kaesu ImageResult { bytes: [], layout: layout, error: MachOError.InvalidPatch() };\n        }\n        moshi (patch.target.kind < 0 || patch.target.kind > 2) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.InvalidPatch() }; }\n        kaku target = entry_offset + patch.target_offset;\n        moshi (target_is_const(patch.target)) { target = layout.const_offset + patch.target_offset; }\n        moshi (target_is_data(patch.target)) { target = layout.data_offset + patch.target_offset; }\n        moshi ((target_is_text(patch.target) && patch.target_offset >= len(spec.words) * 4) ||\n               (target_is_const(patch.target) && patch.target_offset >= len(spec.constants)) ||\n               (target_is_data(patch.target) && patch.target_offset >= spec.globals * 8)) {\n            kaesu ImageResult { bytes: [], layout: layout, error: MachOError.InvalidPatch() };\n        }\n        kaku encoded = arm64.adrp_offset(patch.register, entry_offset + patch.at_word * 4, target);\n        moshi (encoded.error != mu) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.EncodeFailure() }; }\n        words[patch.at_word] = encoded.word;\n        moshi (patch.add_at_word >= 0) {\n            moshi (patch.add_at_word >= len(words) || patch.add_at_word == patch.at_word) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.InvalidPatch() }; }\n            kaku low = target - (target / 4096) * 4096;\n            kaku addition = arm64.add_imm_x(patch.register, patch.register, low, iie);\n            moshi (addition.error != mu) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.EncodeFailure() }; }\n            words[patch.add_at_word] = addition.word;\n        }\n        index = index + 1;\n    }\n    // An internal helper result uses bytes as a little-endian word stream.\n    kaku temp = binary.writer(len(words) * 4);\n    index = 0;\n    aida (index < len(words)) {\n        moshi (binary.writer_write_u32_le(temp, words[index]) != mu) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.WriteFailure() }; }\n        index = index + 1;\n    }\n    kaesu ImageResult { bytes: binary.writer_bytes(temp), layout: layout, error: mu };\n}\n\nkoukai waza executable(spec: ImageSpec) -> ImageResult {\n    kaku empty_layout = plan(0, 0, 0);\n    moshi (len(spec.words) == 0) { kaesu ImageResult { bytes: [], layout: empty_layout, error: MachOError.EmptyText() }; }\n    // The lowerer still enforces 2048 user globals. Four private ABI words\n    // preserve that capacity when assertion reporting and OS arguments coexist.\n    moshi (spec.globals < 0 || spec.globals > 2052) { kaesu ImageResult { bytes: [], layout: empty_layout, error: MachOError.TooManyGlobals() }; }\n    moshi (len(spec.words) > (maximum_image_size - entry_offset) / 4 || len(spec.constants) > maximum_image_size) {\n        kaesu ImageResult { bytes: [], layout: empty_layout, error: MachOError.ImageTooLarge() };\n    }\n    kaku layout = plan(len(spec.words) * 4, len(spec.constants), spec.globals);\n    moshi (layout.file_size > maximum_image_size) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.ImageTooLarge() }; }\n    kaku patched = patch_words(spec, layout);\n    moshi (patched.error != mu) { kaesu patched; }\n\n    kaku has_const = len(spec.constants) > 0;\n    kaku has_data = spec.globals > 0;\n    kaku text_command_size = 152; moshi (has_const) { text_command_size = 232; }\n    kaku command_size = 72 + text_command_size + 72 + 32 + 24 + 24 + 80 + 24;\n    kaku command_count = 8;\n    moshi (has_data) { command_size = command_size + 152; command_count = 9; }\n    moshi (32 + command_size + 16 > entry_offset) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.LoadCommandsTooLarge() }; }\n\n    kaku output = binary.writer(layout.file_size);\n    kaku failure = put32(output, 4277009103); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 16777228); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 2); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, command_count); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, command_size); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 2097285); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    failure = segment(output, [95,95,80,65,71,69,90,69,82,79], 0, 0, 1, 0, 0, 0, 0, 0, 0, 72);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    kaku text_sections = 1; moshi (has_const) { text_sections = 2; }\n    failure = segment(output, [95,95,84,69,88,84], 1, 0, 0, layout.text_size, 0, layout.text_size, 5, 5, text_sections, text_command_size);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = section(output, [95,95,116,101,120,116], [95,95,84,69,88,84], entry_offset, len(spec.words) * 4, entry_offset, 2, 2147484672);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    moshi (has_const) {\n        failure = section(output, [95,95,99,111,110,115,116], [95,95,84,69,88,84], layout.const_offset, len(spec.constants), layout.const_offset, 3, 0);\n        moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    }\n    moshi (has_data) {\n        failure = segment(output, [95,95,68,65,84,65], 1, layout.data_offset, 0, layout.linkedit_offset - layout.data_offset, layout.data_offset, layout.linkedit_offset - layout.data_offset, 3, 3, 1, 152);\n        moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n        failure = section(output, [95,95,100,97,116,97], [95,95,68,65,84,65], layout.data_offset, spec.globals * 8, layout.data_offset, 3, 0);\n        moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    }\n    failure = segment(output, [95,95,76,73,78,75,69,68,73,84], 1, layout.linkedit_offset, 0, page_size, layout.linkedit_offset, 0, 1, 1, 0, 72);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    // LC_LOAD_DYLINKER, command size 32, path offset 12.\n    failure = put32(output, 14); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 32); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 12); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put_bytes(output, [47,117,115,114,47,108,105,98,47,100,121,108,100,0]); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = zeros(output, 6); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    // LC_BUILD_VERSION: macOS 11.0, no tool records.\n    failure = put32(output, 50); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 24); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 1); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 720896); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 720896); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 0); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    // Empty LC_SYMTAB and LC_DYSYMTAB. All pure-Mio fixups are already final.\n    failure = put32(output, 2); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 24); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = zeros(output, 16); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 11); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 80); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = zeros(output, 72); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    failure = put32(output, 2147483688); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put32(output, 24); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put64(output, 0, entry_offset); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put64(output, 0, 0); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    failure = zeros(output, entry_offset - binary.writer_offset(output)); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = put_bytes(output, patched.bytes); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = zeros(output, layout.const_offset - binary.writer_offset(output)); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    moshi (has_const) { failure = put_bytes(output, spec.constants); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; } }\n    failure = zeros(output, layout.file_size - binary.writer_offset(output)); moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    kaesu ImageResult { bytes: binary.writer_bytes(output), layout: layout, error: mu };\n}\n" }; }
waza data_15() -> File { kaesu File { path: "kiso/aot/sign/sign.mio", version: "Bunko-GF3-v0.2", length: 5540, sha256: "7e807ab2d5c444eaa975b42679d916afd7d82750dd70fb8bc3ae063c5e05785e", source: "yobu \"kiso/array\";\nyobu \"kiso/crypto/sha256\";\n\nkoukai kata SignResult { bytes: []uint8; error: string; }\nwaza failure(message: string) -> SignResult { kaesu SignResult { bytes: [], error: message }; }\nwaza read32(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset]) + int64(data[offset + 1]) * 256 + int64(data[offset + 2]) * 65536 + int64(data[offset + 3]) * 16777216;\n}\nwaza write32(data: []uint8, offset: int64, value: int64, big: bool) -> unit {\n    kaku left = value; kaku at = 0;\n    aida (at < 4) {\n        kaku position = offset + at; moshi (big) { position = offset + 3 - at; }\n        data[position] = uint8(left - (left / 256) * 256); left = left / 256; at = at + 1;\n    }\n}\nwaza align(value: int64, boundary: int64) -> int64 { kaesu ((value + boundary - 1) / boundary) * boundary; }\n\n// Deterministic local ad-hoc signature for our relocation-free ARM64 images.\n// No identity, certificate, entitlement or notarization is claimed. Every code\n// page hash covers the final header and final LC_CODE_SIGNATURE/__LINKEDIT.\nkoukai waza adhoc(image: []uint8) -> SignResult {\n    moshi (len(image) < 768 || len(image) > 67108864 || len(image) != align(len(image), 16)) { kaesu failure(\"invalid unsigned image length\"); }\n    moshi (read32(image, 0) != 4277009103 || read32(image, 4) != 16777228 || read32(image, 12) != 2) { kaesu failure(\"expected ARM64 Mach-O executable\"); }\n    kaku count = read32(image, 16); kaku command_bytes = read32(image, 20);\n    moshi (count < 1 || count > 32 || command_bytes > 720 || 32 + command_bytes + 16 > 768) { kaesu failure(\"invalid load commands\"); }\n    kaku linkedit = -1; kaku text_limit = 0; kaku at = 32; kaku index = 0;\n    aida (index < count) {\n        moshi (at + 8 > 32 + command_bytes) { kaesu failure(\"truncated load command\"); }\n        kaku command = read32(image, at); kaku size = read32(image, at + 4);\n        moshi (size < 8 || at + size > 32 + command_bytes || size != align(size, 8)) { kaesu failure(\"invalid load command size\"); }\n        moshi (command == 29) { kaesu failure(\"image is already signed\"); }\n        moshi (command == 25 && size >= 72) {\n            // Exact segment names, including the NUL padding.\n            kaku name: []uint8 = [95,95,76,73,78,75,69,68,73,84,0,0,0,0,0,0]; kaku equal = hai; kaku ni = 0;\n            aida (ni < 16) { moshi (image[at + 8 + ni] != name[ni]) { equal = iie; } ni = ni + 1; }\n            moshi (equal) {\n                moshi (linkedit >= 0 || read32(image, at + 40) != len(image) || read32(image, at + 44) != 0 || read32(image, at + 48) != 0 || read32(image, at + 52) != 0) { kaesu failure(\"unexpected LINKEDIT layout\"); }\n                linkedit = at;\n            }\n            moshi (image[at + 8] == uint8(95) && image[at + 9] == uint8(95) && image[at + 10] == uint8(84) && image[at + 11] == uint8(69) && image[at + 12] == uint8(88) && image[at + 13] == uint8(84) && image[at + 14] == uint8(0)) {\n                text_limit = read32(image, at + 48);\n            }\n        }\n        at = at + size; index = index + 1;\n    }\n    moshi (at != 32 + command_bytes || linkedit < 0 || text_limit < 768 || text_limit > len(image)) { kaesu failure(\"missing canonical image segments\"); }\n    // SuperBlob(20), CodeDirectory v0x20400(88), identifier \"mio\\0\"(4),\n    // SHA256 code slots. No special slots or CMS are needed for ad-hoc.\n    kaku slots = (len(image) + 4095) / 4096;\n    kaku directory_size = 92 + slots * 32; kaku blob_size = 20 + directory_size; kaku signature_size = align(blob_size, 16);\n    kaku output = array.with_capacity[uint8](len(image) + signature_size);\n    array.append_all(output, image); kaku pad = 0;\n    aida (pad < signature_size) { array.push(output, uint8(0)); pad = pad + 1; }\n    write32(output, 16, count + 1, iie); write32(output, 20, command_bytes + 16, iie);\n    write32(output, at, 29, iie); write32(output, at + 4, 16, iie); write32(output, at + 8, len(image), iie); write32(output, at + 12, signature_size, iie);\n    write32(output, linkedit + 32, align(signature_size, 16384), iie); write32(output, linkedit + 36, 0, iie);\n    write32(output, linkedit + 48, signature_size, iie); write32(output, linkedit + 52, 0, iie);\n    kaku base = len(image);\n    write32(output, base, 4208856256, hai); write32(output, base + 4, blob_size, hai); write32(output, base + 8, 1, hai);\n    write32(output, base + 12, 0, hai); write32(output, base + 16, 20, hai);\n    kaku cd = base + 20;\n    write32(output, cd, 4208856066, hai); write32(output, cd + 4, directory_size, hai); write32(output, cd + 8, 132096, hai); write32(output, cd + 12, 2, hai);\n    write32(output, cd + 16, 92, hai); write32(output, cd + 20, 88, hai); write32(output, cd + 28, slots, hai); write32(output, cd + 32, len(image), hai);\n    output[cd + 36] = uint8(32); output[cd + 37] = uint8(2); output[cd + 39] = uint8(12);\n    write32(output, cd + 76, text_limit, hai); write32(output, cd + 84, 1, hai);\n    output[cd + 88] = uint8(109); output[cd + 89] = uint8(105); output[cd + 90] = uint8(111);\n    kaku ctx = sha256.context(); index = 0;\n    aida (index < slots) {\n        kaku length = 4096; moshi ((index + 1) * 4096 > len(image)) { length = len(image) - index * 4096; }\n        kaku hash = sha256.sum_range(ctx, output, index * 4096, length);\n        moshi (len(hash) != 32) { kaesu failure(\"page hashing failed\"); }\n        kaku hi = 0;\n        aida (hi < 32) { output[cd + 92 + index * 32 + hi] = hash[hi]; hi = hi + 1; }\n        index = index + 1;\n    }\n    kaesu SignResult { bytes: output, error: \"\" };\n}\n" }; }
waza data_16() -> File { kaesu File { path: "kiso/array/array.mio", version: "Bunko-GF3-v0.2", length: 790, sha256: "a2d7cbe2385873f015fc032ee1be309de7e93d813aaacbb69d279895e24e153f", source: "koukai waza make<T>(length: int64, initial: T) -> []T {\n    kaesu __array_make(length, initial);\n}\n\nkoukai waza with_capacity<T>(capacity: int64) -> []T {\n    kaesu __array_with_capacity(capacity);\n}\n\nkoukai waza push<T>(values: []T, value: T) -> unit {\n    __array_push(values, value);\n}\n\nkoukai waza capacity<T>(values: []T) -> int64 {\n    kaesu __array_capacity(values);\n}\n\nkoukai waza reserve<T>(values: []T, additional: int64) -> unit {\n    __array_reserve(values, additional);\n}\n\nkoukai waza clone<T>(values: []T) -> []T {\n    kaesu __array_clone(values);\n}\n\nkoukai waza truncate<T>(values: []T, new_length: int64) -> unit {\n    __array_truncate(values, new_length);\n}\n\nkoukai waza append_all<T>(destination: []T, source: []T) -> unit {\n    __array_append_all(destination, source);\n}\n" }; }
waza data_17() -> File { kaesu File { path: "kiso/bytes/bytes.mio", version: "Bunko-GF3-v0.2", length: 3321, sha256: "cca8c910bc492a3f39bd2872ef0923b55dc642b88bc0b5d810f9039e3e9e6c5f", source: "yobu \"kiso/array\";\n\nkoukai kata ByteBuffer { data: []uint8; }\n\nkoukai waza equal(left: []uint8, right: []uint8) -> bool {\n    moshi (len(left) != len(right)) { kaesu iie; }\n    kaku index = 0;\n    aida (index < len(left)) {\n        moshi (left[index] != right[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nkoukai waza compare(left: []uint8, right: []uint8) -> int64 {\n    kaku limit = len(left);\n    moshi (len(right) < limit) { limit = len(right); }\n    kaku index = 0;\n    aida (index < limit) {\n        moshi (left[index] < right[index]) { kaesu -1; }\n        moshi (left[index] > right[index]) { kaesu 1; }\n        index = index + 1;\n    }\n    moshi (len(left) < len(right)) { kaesu -1; }\n    moshi (len(left) > len(right)) { kaesu 1; }\n    kaesu 0;\n}\n\nkoukai waza index(values: []uint8, target: uint8) -> int64 {\n    kaku current = 0;\n    aida (current < len(values)) {\n        moshi (values[current] == target) { kaesu current; }\n        current = current + 1;\n    }\n    kaesu -1;\n}\n\nkoukai waza contains(values: []uint8, target: uint8) -> bool {\n    kaesu index(values, target) >= 0;\n}\n\nkoukai waza has_prefix(values: []uint8, prefix: []uint8) -> bool {\n    moshi (len(prefix) > len(values)) { kaesu iie; }\n    kaku index = 0;\n    aida (index < len(prefix)) {\n        moshi (values[index] != prefix[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nkoukai waza has_suffix(values: []uint8, suffix: []uint8) -> bool {\n    moshi (len(suffix) > len(values)) { kaesu iie; }\n    kaku offset = len(values) - len(suffix);\n    kaku index = 0;\n    aida (index < len(suffix)) {\n        moshi (values[offset + index] != suffix[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nkoukai waza copy(destination: []uint8, source: []uint8) -> int64 {\n    kaku count = len(destination);\n    moshi (len(source) < count) { count = len(source); }\n    kaku index = 0;\n    aida (index < count) {\n        destination[index] = source[index];\n        index = index + 1;\n    }\n    kaesu count;\n}\n\nkoukai waza fill(values: []uint8, value: uint8) -> unit {\n    kaku index = 0;\n    aida (index < len(values)) {\n        values[index] = value;\n        index = index + 1;\n    }\n    kaesu;\n}\n\nkoukai waza clone(values: []uint8) -> []uint8 {\n    kaesu array.clone(values);\n}\n\nkoukai waza new_buffer() -> ByteBuffer {\n    kaesu ByteBuffer { data: array.with_capacity[uint8](0) };\n}\n\nkoukai waza buffer_with_capacity(capacity: int64) -> ByteBuffer {\n    kaesu ByteBuffer { data: array.with_capacity[uint8](capacity) };\n}\n\nkoukai waza write_byte(buffer: ByteBuffer, value: uint8) -> unit {\n    array.push(buffer.data, value);\n}\n\nkoukai waza write(buffer: ByteBuffer, source: []uint8) -> int64 {\n    kaku count = len(source);\n    array.append_all(buffer.data, source);\n    kaesu count;\n}\n\nkoukai waza buffer_len(buffer: ByteBuffer) -> int64 {\n    kaesu len(buffer.data);\n}\n\nkoukai waza buffer_capacity(buffer: ByteBuffer) -> int64 {\n    kaesu array.capacity(buffer.data);\n}\n\nkoukai waza reset(buffer: ByteBuffer) -> unit {\n    array.truncate(buffer.data, 0);\n}\n\nkoukai waza buffer_clone(buffer: ByteBuffer) -> ByteBuffer {\n    kaesu ByteBuffer { data: array.clone(buffer.data) };\n}\n\nkoukai waza buffer_bytes(buffer: ByteBuffer) -> []uint8 {\n    kaesu array.clone(buffer.data);\n}\n" }; }
waza data_18() -> File { kaesu File { path: "kiso/convert/convert.mio", version: "Bunko-GF3-v0.2", length: 3103, sha256: "f802730285564dc17c44eaf860392e6b9df72e49a4b1163c0c29d0b8dd471b2d", source: "yobu \"kiso/bytes\";\nyobu \"kiso/string\";\n\nwaza parse_negative(data: []uint8, offset: int64, limit: int64) -> int64? {\n    kaku result: int64 = 0;\n    kaku cutoff = limit / 10;\n    kaku last_digit = -(limit - cutoff * 10);\n    kaku current_offset = offset;\n    aida (current_offset < len(data)) {\n        kaku current = data[current_offset];\n        moshi (current < 48 || current > 57) { kaesu mu; }\n        kaku digit = int64(current - 48);\n        moshi (result < cutoff || (result == cutoff && digit > last_digit)) { kaesu mu; }\n        result = result * 10 - digit;\n        current_offset = current_offset + 1;\n    }\n    kaesu result;\n}\n\nwaza format_negative(value: int64, negative: bool, capacity: int64) -> string {\n    kaku builder = string.builder_with_capacity(capacity);\n    kaku start: int64 = 0;\n    moshi (negative) {\n        bytes.write_byte(builder.buffer, uint8(45));\n        start = 1;\n    }\n    kaku current = value;\n    moshi (current == 0) {\n        bytes.write_byte(builder.buffer, uint8(48));\n    } sore {\n        aida (current != 0) {\n            kaku digit = -(current - (current / 10) * 10);\n            bytes.write_byte(builder.buffer, uint8(48 + digit));\n            current = current / 10;\n        }\n    }\n    kaku left = start;\n    kaku right = len(builder.buffer.data) - 1;\n    aida (left < right) {\n        kaku temporary = builder.buffer.data[left];\n        builder.buffer.data[left] = builder.buffer.data[right];\n        builder.buffer.data[right] = temporary;\n        left = left + 1;\n        right = right - 1;\n    }\n    kaesu string.builder_string(builder);\n}\n\nkoukai waza parse_int(value: string) -> int64? {\n    kaku data = string.to_bytes(value);\n    moshi (len(data) == 0) { kaesu mu; }\n    kaku offset: int64 = 0;\n    kaku negative = iie;\n    moshi (data[0] == 45) {\n        negative = hai;\n        offset = 1;\n    } sore {\n        moshi (data[0] == 43) { offset = 1; }\n    }\n    moshi (offset == len(data)) { kaesu mu; }\n    kaku limit: int64 = -9223372036854775807;\n    moshi (negative) { limit = limit - 1; }\n    kaku result = parse_negative(data, offset, limit);\n    moshi (result == mu) { kaesu mu; }\n    moshi (negative) { kaesu result; }\n    kaesu -result;\n}\n\nkoukai waza parse_uint(value: string) -> uint32? {\n    kaku data = string.to_bytes(value);\n    moshi (len(data) == 0) { kaesu mu; }\n    kaku offset: int64 = 0;\n    moshi (data[0] == 43) { offset = 1; }\n    moshi (offset == len(data)) { kaesu mu; }\n    kaku result = parse_negative(data, offset, -4294967295);\n    moshi (result == mu) { kaesu mu; }\n    kaesu uint32(-result);\n}\n\nkoukai waza format_int(value: int64) -> string {\n    moshi (value < 0) { kaesu format_negative(value, hai, 20); }\n    kaesu format_negative(-value, iie, 19);\n}\n\nkoukai waza format_uint(value: uint32) -> string {\n    kaesu format_negative(-int64(value), iie, 10);\n}\n\nkoukai waza parse_bool(value: string) -> bool? {\n    moshi (value == \"hai\") { kaesu hai; }\n    moshi (value == \"iie\") { kaesu iie; }\n    kaesu mu;\n}\n\nkoukai waza format_bool(value: bool) -> string {\n    moshi (value) { kaesu \"hai\"; }\n    kaesu \"iie\";\n}\n" }; }
waza data_19() -> File { kaesu File { path: "kiso/convert/float.mio", version: "Bunko-GF3-v0.2", length: 23219, sha256: "85b05cfd3ecc7e3eaa7dd56470f16c82970c2a753e9e4926b2cdde9a548a179c", source: "yobu \"kiso/array\";\nyobu \"kiso/bytes\";\nyobu \"kiso/math\";\nyobu \"kiso/string\";\n\nkata DecimalBig { limbs: []int64; }\n\nteisu decimal_base: int64 = 1000000000;\nteisu max_float_input_bytes: int64 = 10000;\n\nwaza big_zero() -> DecimalBig {\n    kaesu DecimalBig { limbs: array.with_capacity[int64](1) };\n}\n\nwaza big_one() -> DecimalBig {\n    kaku result = big_zero();\n    array.push(result.limbs, 1);\n    kaesu result;\n}\n\nwaza big_clone(value: DecimalBig) -> DecimalBig {\n    kaesu DecimalBig { limbs: array.clone(value.limbs) };\n}\n\nwaza big_normalize(value: DecimalBig) -> unit {\n    aida (len(value.limbs) > 0 && value.limbs[len(value.limbs) - 1] == 0) {\n        array.truncate(value.limbs, len(value.limbs) - 1);\n    }\n}\n\nwaza big_compare(left: DecimalBig, right: DecimalBig) -> int64 {\n    moshi (len(left.limbs) < len(right.limbs)) { kaesu -1; }\n    moshi (len(left.limbs) > len(right.limbs)) { kaesu 1; }\n    kaku index = len(left.limbs) - 1;\n    aida (index >= 0) {\n        moshi (left.limbs[index] < right.limbs[index]) { kaesu -1; }\n        moshi (left.limbs[index] > right.limbs[index]) { kaesu 1; }\n        index = index - 1;\n    }\n    kaesu 0;\n}\n\nwaza big_subtract(left: DecimalBig, right: DecimalBig) -> unit {\n    kaku borrow: int64 = 0;\n    kaku index: int64 = 0;\n    aida (index < len(left.limbs)) {\n        kaku subtrahend = borrow;\n        moshi (index < len(right.limbs)) { subtrahend = subtrahend + right.limbs[index]; }\n        kaku current = left.limbs[index] - subtrahend;\n        borrow = 0;\n        moshi (current < 0) {\n            current = current + decimal_base;\n            borrow = 1;\n        }\n        left.limbs[index] = current;\n        index = index + 1;\n    }\n    big_normalize(left);\n}\n\nwaza big_multiply_small(value: DecimalBig, factor: int64) -> unit {\n    moshi (factor == 0 || len(value.limbs) == 0) {\n        array.truncate(value.limbs, 0);\n        kaesu;\n    }\n    kaku carry: int64 = 0;\n    kaku index: int64 = 0;\n    aida (index < len(value.limbs)) {\n        kaku product = value.limbs[index] * factor + carry;\n        value.limbs[index] = product - (product / decimal_base) * decimal_base;\n        carry = product / decimal_base;\n        index = index + 1;\n    }\n    aida (carry != 0) {\n        array.push(value.limbs, carry - (carry / decimal_base) * decimal_base);\n        carry = carry / decimal_base;\n    }\n}\n\nwaza big_multiply_power(value: DecimalBig, factor: int64, exponent: int64) -> unit {\n    kaku remaining = exponent;\n    moshi (factor == 2) {\n        aida (remaining >= 29) {\n            big_multiply_small(value, 536870912);\n            remaining = remaining - 29;\n        }\n    }\n    moshi (factor == 5) {\n        aida (remaining >= 12) {\n            big_multiply_small(value, 244140625);\n            remaining = remaining - 12;\n        }\n    }\n    aida (remaining > 0) {\n        big_multiply_small(value, factor);\n        remaining = remaining - 1;\n    }\n}\n\nwaza big_divide_small(value: DecimalBig, divisor: int64) -> int64 {\n    kaku remainder: int64 = 0;\n    kaku index = len(value.limbs) - 1;\n    aida (index >= 0) {\n        kaku current = remainder * decimal_base + value.limbs[index];\n        value.limbs[index] = current / divisor;\n        remainder = current - value.limbs[index] * divisor;\n        index = index - 1;\n    }\n    big_normalize(value);\n    kaesu remainder;\n}\n\nwaza big_from_decimal(data: []uint8, start: int64, end: int64) -> DecimalBig {\n    kaku result = big_zero();\n    kaku right = end;\n    aida (right > start) {\n        kaku left = right - 9;\n        moshi (left < start) { left = start; }\n        kaku limb: int64 = 0;\n        kaku index = left;\n        aida (index < right) {\n            limb = limb * 10 + int64(data[index] - 48);\n            index = index + 1;\n        }\n        array.push(result.limbs, limb);\n        right = left;\n    }\n    big_normalize(result);\n    kaesu result;\n}\n\nwaza big_from_positive(value: int64) -> DecimalBig {\n    kaku result = big_zero();\n    kaku remaining = value;\n    aida (remaining != 0) {\n        kaku quotient = remaining / decimal_base;\n        array.push(result.limbs, remaining - quotient * decimal_base);\n        remaining = quotient;\n    }\n    kaesu result;\n}\n\nwaza append_positive_decimal(buffer: bytes.ByteBuffer, value: int64, width: int64) -> unit {\n    kaku temporary = array.with_capacity[uint8](20);\n    kaku remaining = value;\n    moshi (remaining == 0) { array.push(temporary, uint8(48)); }\n    aida (remaining != 0) {\n        kaku quotient = remaining / 10;\n        array.push(temporary, uint8(48 + remaining - quotient * 10));\n        remaining = quotient;\n    }\n    aida (len(temporary) < width) { array.push(temporary, uint8(48)); }\n    kaku index = len(temporary) - 1;\n    aida (index >= 0) {\n        bytes.write_byte(buffer, temporary[index]);\n        index = index - 1;\n    }\n}\n\nwaza big_decimal_bytes(value: DecimalBig) -> []uint8 {\n    kaku buffer = bytes.buffer_with_capacity(len(value.limbs) * 9);\n    kaku index = len(value.limbs) - 1;\n    moshi (index < 0) {\n        bytes.write_byte(buffer, uint8(48));\n        kaesu bytes.buffer_bytes(buffer);\n    }\n    append_positive_decimal(buffer, value.limbs[index], 1);\n    index = index - 1;\n    aida (index >= 0) {\n        append_positive_decimal(buffer, value.limbs[index], 9);\n        index = index - 1;\n    }\n    kaesu bytes.buffer_bytes(buffer);\n}\n\nwaza floor_divide(value: int64, divisor: int64) -> int64 {\n    kaku quotient = value / divisor;\n    moshi (value < 0 && value - quotient * divisor != 0) { quotient = quotient - 1; }\n    kaesu quotient;\n}\n\nwaza decimal_compare_power(significand: DecimalBig, exponent10: int64, exponent2: int64) -> int64 {\n    kaku left = big_clone(significand);\n    kaku right = big_one();\n    kaku shift: int64 = 0;\n    moshi (exponent10 >= 0) {\n        big_multiply_power(left, 5, exponent10);\n        shift = exponent2 - exponent10;\n    } sore {\n        big_multiply_power(right, 5, -exponent10);\n        shift = exponent2 - exponent10;\n    }\n    moshi (shift >= 0) {\n        big_multiply_power(right, 2, shift);\n    } sore {\n        big_multiply_power(left, 2, -shift);\n    }\n    kaesu big_compare(left, right);\n}\n\nwaza decimal_binary_exponent(significand: DecimalBig, decimal_digits: int64, exponent10: int64) -> int64 {\n    kaku adjusted = decimal_digits + exponent10 - 1;\n    kaku exponent2 = floor_divide(adjusted * 3322, 1000);\n    aida (decimal_compare_power(significand, exponent10, exponent2) < 0) {\n        exponent2 = exponent2 - 1;\n    }\n    aida (decimal_compare_power(significand, exponent10, exponent2 + 1) >= 0) {\n        exponent2 = exponent2 + 1;\n    }\n    kaesu exponent2;\n}\n\nwaza decimal_round_binary(significand: DecimalBig, exponent10: int64, scale2: int64, precision: int64) -> int64 {\n    kaku numerator = big_clone(significand);\n    kaku denominator = big_one();\n    moshi (exponent10 >= 0) {\n        big_multiply_power(numerator, 5, exponent10);\n    } sore {\n        big_multiply_power(denominator, 5, -exponent10);\n    }\n    kaku shift = exponent10 - scale2;\n    moshi (shift >= 0) {\n        big_multiply_power(numerator, 2, shift);\n    } sore {\n        big_multiply_power(denominator, 2, -shift);\n    }\n\n    kaku multiple = big_clone(denominator);\n    big_multiply_power(multiple, 2, precision);\n    kaku bit_value: int64 = 1;\n    kaku bit_index: int64 = 0;\n    aida (bit_index < precision) {\n        bit_value = bit_value * 2;\n        bit_index = bit_index + 1;\n    }\n    kaku quotient: int64 = 0;\n    kaku current = precision;\n    aida (current >= 0) {\n        moshi (big_compare(numerator, multiple) >= 0) {\n            big_subtract(numerator, multiple);\n            quotient = quotient + bit_value;\n        }\n        moshi (current > 0) { big_divide_small(multiple, 2); }\n        bit_value = bit_value / 2;\n        current = current - 1;\n    }\n\n    kaku doubled = big_clone(numerator);\n    big_multiply_small(doubled, 2);\n    kaku comparison = big_compare(doubled, denominator);\n    moshi (comparison > 0 || (comparison == 0 && quotient - (quotient / 2) * 2 != 0)) {\n        quotient = quotient + 1;\n    }\n    kaesu quotient;\n}\n\nkata ParsedDecimal {\n    negative: bool;\n    zero: bool;\n    significand: DecimalBig;\n    digits: int64;\n    exponent10: int64;\n}\n\nwaza parse_finite_decimal(data: []uint8) -> ParsedDecimal? {\n    moshi (len(data) == 0 || len(data) > max_float_input_bytes) { kaesu mu; }\n    kaku offset: int64 = 0;\n    kaku negative = iie;\n    moshi (data[0] == 45) {\n        negative = hai;\n        offset = 1;\n    } sore {\n        moshi (data[0] == 43) { offset = 1; }\n    }\n    moshi (offset == len(data)) { kaesu mu; }\n\n    kaku digits = array.with_capacity[uint8](len(data));\n    kaku fractional_digits: int64 = 0;\n    kaku saw_digit = iie;\n    kaku saw_point = iie;\n    aida (offset < len(data) && data[offset] != 101 && data[offset] != 69) {\n        kaku current = data[offset];\n        moshi (current == 46) {\n            moshi (saw_point) { kaesu mu; }\n            saw_point = hai;\n        } sore {\n            moshi (current < 48 || current > 57) { kaesu mu; }\n            saw_digit = hai;\n            array.push(digits, current);\n            moshi (saw_point) { fractional_digits = fractional_digits + 1; }\n        }\n        offset = offset + 1;\n    }\n    moshi (!saw_digit) { kaesu mu; }\n\n    kaku explicit_exponent: int64 = 0;\n    moshi (offset < len(data)) {\n        offset = offset + 1;\n        kaku exponent_negative = iie;\n        moshi (offset < len(data) && (data[offset] == 43 || data[offset] == 45)) {\n            exponent_negative = data[offset] == 45;\n            offset = offset + 1;\n        }\n        moshi (offset == len(data)) { kaesu mu; }\n        aida (offset < len(data)) {\n            kaku current = data[offset];\n            moshi (current < 48 || current > 57) { kaesu mu; }\n            moshi (explicit_exponent < 20000) {\n                explicit_exponent = explicit_exponent * 10 + int64(current - 48);\n                moshi (explicit_exponent > 20000) { explicit_exponent = 20000; }\n            }\n            offset = offset + 1;\n        }\n        moshi (exponent_negative) { explicit_exponent = -explicit_exponent; }\n    }\n\n    kaku first: int64 = 0;\n    aida (first < len(digits) && digits[first] == 48) { first = first + 1; }\n    moshi (first == len(digits)) {\n        kaesu ParsedDecimal { negative: negative, zero: hai, significand: big_zero(), digits: 1, exponent10: 0 };\n    }\n    kaku last = len(digits) - 1;\n    aida (last > first && digits[last] == 48) { last = last - 1; }\n    kaku trailing = len(digits) - 1 - last;\n    kaku count = last - first + 1;\n    kaesu ParsedDecimal {\n        negative: negative,\n        zero: iie,\n        significand: big_from_decimal(digits, first, last + 1),\n        digits: count,\n        exponent10: explicit_exponent - fractional_digits + trailing,\n    };\n}\n\nwaza scale_float64(value: int64, exponent2: int64) -> float64 {\n    kaku result = float64(value);\n    kaku remaining = exponent2;\n    aida (remaining > 0) {\n        result = result * 2.0;\n        remaining = remaining - 1;\n    }\n    aida (remaining < 0) {\n        result = result / 2.0;\n        remaining = remaining + 1;\n    }\n    kaesu result;\n}\n\nwaza scale_float32(value: int64, exponent2: int64) -> float32 {\n    kaku result = float32(value);\n    kaku remaining = exponent2;\n    aida (remaining > 0) {\n        result = result * float32(2.0);\n        remaining = remaining - 1;\n    }\n    aida (remaining < 0) {\n        result = result / float32(2.0);\n        remaining = remaining + 1;\n    }\n    kaesu result;\n}\n\nkoukai waza parse_float64(value: string) -> float64? {\n    moshi (value == \"NaN\") { kaesu 0.0 / 0.0; }\n    moshi (value == \"Infinity\" || value == \"+Infinity\") { kaesu 1.0 / 0.0; }\n    moshi (value == \"-Infinity\") { kaesu -1.0 / 0.0; }\n    kaku parsed = parse_finite_decimal(string.to_bytes(value));\n    moshi (parsed == mu) { kaesu mu; }\n    moshi (parsed.zero) {\n        moshi (parsed.negative) { kaesu -0.0; }\n        kaesu 0.0;\n    }\n    kaku adjusted = parsed.digits + parsed.exponent10 - 1;\n    moshi (adjusted > 308) { kaesu mu; }\n    moshi (adjusted < -324) {\n        moshi (parsed.negative) { kaesu -0.0; }\n        kaesu 0.0;\n    }\n    kaku exponent2 = decimal_binary_exponent(parsed.significand, parsed.digits, parsed.exponent10);\n    kaku scale2 = exponent2 - 52;\n    moshi (exponent2 < -1022) { scale2 = -1074; }\n    kaku significand = decimal_round_binary(parsed.significand, parsed.exponent10, scale2, 53);\n    moshi (significand == 9007199254740992 && exponent2 >= 1023) { kaesu mu; }\n    kaku result = scale_float64(significand, scale2);\n    moshi (math.is_inf(result)) { kaesu mu; }\n    moshi (parsed.negative) { result = -result; }\n    kaesu result;\n}\n\nkoukai waza parse_float32(value: string) -> float32? {\n    moshi (value == \"NaN\") { kaesu float32(0.0) / float32(0.0); }\n    moshi (value == \"Infinity\" || value == \"+Infinity\") { kaesu float32(1.0) / float32(0.0); }\n    moshi (value == \"-Infinity\") { kaesu -float32(1.0) / float32(0.0); }\n    kaku parsed = parse_finite_decimal(string.to_bytes(value));\n    moshi (parsed == mu) { kaesu mu; }\n    moshi (parsed.zero) {\n        moshi (parsed.negative) { kaesu -float32(0.0); }\n        kaesu float32(0.0);\n    }\n    kaku adjusted = parsed.digits + parsed.exponent10 - 1;\n    moshi (adjusted > 38) { kaesu mu; }\n    moshi (adjusted < -46) {\n        moshi (parsed.negative) { kaesu -float32(0.0); }\n        kaesu float32(0.0);\n    }\n    kaku exponent2 = decimal_binary_exponent(parsed.significand, parsed.digits, parsed.exponent10);\n    kaku scale2 = exponent2 - 23;\n    moshi (exponent2 < -126) { scale2 = -149; }\n    kaku significand = decimal_round_binary(parsed.significand, parsed.exponent10, scale2, 24);\n    moshi (significand == 16777216 && exponent2 >= 127) { kaesu mu; }\n    kaku result = scale_float32(significand, scale2);\n    moshi (math.is_inf(result)) { kaesu mu; }\n    moshi (parsed.negative) { result = -result; }\n    kaesu result;\n}\n\nwaza exact_decimal(significand: int64, exponent2: int64) -> ParsedDecimal {\n    kaku coefficient = big_from_positive(significand);\n    kaku exponent10: int64 = 0;\n    moshi (exponent2 >= 0) {\n        big_multiply_power(coefficient, 2, exponent2);\n    } sore {\n        big_multiply_power(coefficient, 5, -exponent2);\n        exponent10 = exponent2;\n    }\n    aida (len(coefficient.limbs) > 0) {\n        kaku copy = big_clone(coefficient);\n        moshi (big_divide_small(copy, 10) != 0) { nukeru; }\n        coefficient = copy;\n        exponent10 = exponent10 + 1;\n    }\n    kaku digits = big_decimal_bytes(coefficient);\n    kaesu ParsedDecimal { negative: iie, zero: iie, significand: coefficient, digits: len(digits), exponent10: exponent10 };\n}\n\nwaza rounded_decimal_coefficient(digits: []uint8, precision: int64) -> int64 {\n    kaku coefficient: int64 = 0;\n    kaku index: int64 = 0;\n    aida (index < precision && index < len(digits)) {\n        coefficient = coefficient * 10 + int64(digits[index] - 48);\n        index = index + 1;\n    }\n    moshi (precision < len(digits)) {\n        kaku next = digits[precision] - 48;\n        kaku sticky = iie;\n        index = precision + 1;\n        aida (index < len(digits)) {\n            moshi (digits[index] != 48) { sticky = hai; nukeru; }\n            index = index + 1;\n        }\n        moshi (next > 5 || (next == 5 && (sticky || coefficient - (coefficient / 2) * 2 != 0))) {\n            coefficient = coefficient + 1;\n        }\n    }\n    kaesu coefficient;\n}\n\nwaza decimal_candidate(coefficient_value: int64, exponent10_value: int64) -> string {\n    kaku coefficient = coefficient_value;\n    kaku exponent10 = exponent10_value;\n    aida (coefficient > 9 && coefficient - (coefficient / 10) * 10 == 0) {\n        coefficient = coefficient / 10;\n        exponent10 = exponent10 + 1;\n    }\n    kaku coefficient_bytes = string.to_bytes(format_int(coefficient));\n    kaku point = len(coefficient_bytes) + exponent10;\n\n    kaku fixed = bytes.buffer_with_capacity(len(coefficient_bytes) + 16);\n    moshi (point <= 0) {\n        bytes.write_byte(fixed, uint8(48));\n        bytes.write_byte(fixed, uint8(46));\n        kaku zeros = -point;\n        aida (zeros > 0) { bytes.write_byte(fixed, uint8(48)); zeros = zeros - 1; }\n        bytes.write(fixed, coefficient_bytes);\n    } sore {\n        moshi (point >= len(coefficient_bytes)) {\n            bytes.write(fixed, coefficient_bytes);\n            kaku zeros = point - len(coefficient_bytes);\n            aida (zeros > 0) { bytes.write_byte(fixed, uint8(48)); zeros = zeros - 1; }\n        } sore {\n            kaku index: int64 = 0;\n            aida (index < len(coefficient_bytes)) {\n                moshi (index == point) { bytes.write_byte(fixed, uint8(46)); }\n                bytes.write_byte(fixed, coefficient_bytes[index]);\n                index = index + 1;\n            }\n        }\n    }\n\n    kaku scientific = bytes.buffer_with_capacity(len(coefficient_bytes) + 16);\n    bytes.write_byte(scientific, coefficient_bytes[0]);\n    moshi (len(coefficient_bytes) > 1) {\n        bytes.write_byte(scientific, uint8(46));\n        kaku index: int64 = 1;\n        aida (index < len(coefficient_bytes)) {\n            bytes.write_byte(scientific, coefficient_bytes[index]);\n            index = index + 1;\n        }\n    }\n    kaku scientific_exponent = exponent10 + len(coefficient_bytes) - 1;\n    moshi (scientific_exponent != 0) {\n        bytes.write_byte(scientific, uint8(101));\n        moshi (scientific_exponent > 0) { bytes.write_byte(scientific, uint8(43)); }\n        bytes.write(scientific, string.to_bytes(format_int(scientific_exponent)));\n    }\n    kaku fixed_text = string.from_utf8(bytes.buffer_bytes(fixed));\n    kaku scientific_text = string.from_utf8(bytes.buffer_bytes(scientific));\n    moshi (fixed_text != mu) {\n        moshi (scientific_text != mu) {\n            moshi (string.byte_len(scientific_text) < string.byte_len(fixed_text)) { kaesu scientific_text; }\n            kaesu fixed_text;\n        }\n    }\n    kaesu \"\";\n}\n\nwaza roundtrip_candidate64(value: float64, coefficient: int64, exponent10: int64) -> string? {\n    kaku candidate = decimal_candidate(coefficient, exponent10);\n    kaku parsed = parse_float64(candidate);\n    moshi (parsed != mu) {\n        moshi (parsed == value) { kaesu candidate; }\n    }\n    kaesu mu;\n}\n\nwaza roundtrip_candidate32(value: float32, coefficient: int64, exponent10: int64) -> string? {\n    kaku candidate = decimal_candidate(coefficient, exponent10);\n    kaku parsed = parse_float32(candidate);\n    moshi (parsed != mu) {\n        moshi (parsed == value) { kaesu candidate; }\n    }\n    kaesu mu;\n}\n\nwaza shorter_candidate(current: string, candidate: string?) -> string {\n    moshi (candidate == mu) { kaesu current; }\n    moshi (current == \"\" || string.byte_len(candidate) < string.byte_len(current)) { kaesu candidate; }\n    kaesu current;\n}\n\nwaza format_finite_float64(value: float64) -> string {\n    kaku normalized = value;\n    kaku exponent2: int64 = 0;\n    aida (normalized >= 2.0) { normalized = normalized / 2.0; exponent2 = exponent2 + 1; }\n    aida (normalized < 1.0) { normalized = normalized * 2.0; exponent2 = exponent2 - 1; }\n    kaku factor: float64 = 1.0;\n    kaku count: int64 = 0;\n    aida (count < 52) { factor = factor * 2.0; count = count + 1; }\n    kaku significand = int64(normalized * factor);\n    exponent2 = exponent2 - 52;\n    aida (significand - (significand / 2) * 2 == 0) { significand = significand / 2; exponent2 = exponent2 + 1; }\n    kaku exact = exact_decimal(significand, exponent2);\n    kaku digits = big_decimal_bytes(exact.significand);\n    kaku lower: int64 = 1;\n    kaku upper: int64 = 17;\n    moshi (len(digits) < upper) { upper = len(digits); }\n    kaku best = \"\";\n    aida (lower <= upper) {\n        kaku precision = (lower + upper) / 2;\n        kaku coefficient = rounded_decimal_coefficient(digits, precision);\n        kaku exponent10 = exact.exponent10 + len(digits) - precision;\n        kaku current = roundtrip_candidate64(value, coefficient, exponent10);\n        kaku candidate = \"\";\n        moshi (current != mu) { candidate = current; }\n        moshi (coefficient > 0) {\n            candidate = shorter_candidate(candidate, roundtrip_candidate64(value, coefficient - 1, exponent10));\n        }\n        candidate = shorter_candidate(candidate, roundtrip_candidate64(value, coefficient + 1, exponent10));\n        moshi (candidate != \"\") {\n            best = candidate;\n            upper = precision - 1;\n        } sore {\n            lower = precision + 1;\n        }\n    }\n    kaesu best;\n}\n\nwaza format_finite_float32(value: float32) -> string {\n    kaku normalized = value;\n    kaku exponent2: int64 = 0;\n    aida (normalized >= float32(2.0)) { normalized = normalized / float32(2.0); exponent2 = exponent2 + 1; }\n    aida (normalized < float32(1.0)) { normalized = normalized * float32(2.0); exponent2 = exponent2 - 1; }\n    kaku factor: float32 = float32(1.0);\n    kaku count: int64 = 0;\n    aida (count < 23) { factor = factor * float32(2.0); count = count + 1; }\n    kaku significand = int64(normalized * factor);\n    exponent2 = exponent2 - 23;\n    aida (significand - (significand / 2) * 2 == 0) { significand = significand / 2; exponent2 = exponent2 + 1; }\n    kaku exact = exact_decimal(significand, exponent2);\n    kaku digits = big_decimal_bytes(exact.significand);\n    kaku lower: int64 = 1;\n    kaku upper: int64 = 9;\n    moshi (len(digits) < upper) { upper = len(digits); }\n    kaku best = \"\";\n    aida (lower <= upper) {\n        kaku precision = (lower + upper) / 2;\n        kaku coefficient = rounded_decimal_coefficient(digits, precision);\n        kaku exponent10 = exact.exponent10 + len(digits) - precision;\n        kaku current = roundtrip_candidate32(value, coefficient, exponent10);\n        kaku candidate = \"\";\n        moshi (current != mu) { candidate = current; }\n        moshi (coefficient > 0) {\n            candidate = shorter_candidate(candidate, roundtrip_candidate32(value, coefficient - 1, exponent10));\n        }\n        candidate = shorter_candidate(candidate, roundtrip_candidate32(value, coefficient + 1, exponent10));\n        moshi (candidate != \"\") {\n            best = candidate;\n            upper = precision - 1;\n        } sore {\n            lower = precision + 1;\n        }\n    }\n    kaesu best;\n}\n\nkoukai waza format_float64(value: float64) -> string {\n    moshi (math.is_nan(value)) { kaesu \"NaN\"; }\n    moshi (math.is_inf(value)) {\n        moshi (value < 0.0) { kaesu \"-Infinity\"; }\n        kaesu \"Infinity\";\n    }\n    moshi (value == 0.0) {\n        moshi (1.0 / value < 0.0) { kaesu \"-0\"; }\n        kaesu \"0\";\n    }\n    moshi (value < 0.0) { kaesu string.concat(\"-\", format_finite_float64(-value)); }\n    kaesu format_finite_float64(value);\n}\n\nkoukai waza format_float32(value: float32) -> string {\n    moshi (math.is_nan(value)) { kaesu \"NaN\"; }\n    moshi (math.is_inf(value)) {\n        moshi (value < float32(0.0)) { kaesu \"-Infinity\"; }\n        kaesu \"Infinity\";\n    }\n    moshi (value == float32(0.0)) {\n        moshi (float32(1.0) / value < float32(0.0)) { kaesu \"-0\"; }\n        kaesu \"0\";\n    }\n    moshi (value < float32(0.0)) { kaesu string.concat(\"-\", format_finite_float32(-value)); }\n    kaesu format_finite_float32(value);\n}\n" }; }
waza data_20() -> File { kaesu File { path: "kiso/crypto/sha256/sha256.mio", version: "Bunko-GF3-v0.2", length: 6095, sha256: "95320339434a4e7cef35359da98acd7bbdda8b7b472b7719fc1d4b2d3f572529", source: "yobu \"kiso/array\";\n\n// Immutable arithmetic lookup tables; no host crypto or foreign compiler is\n// involved. Values stay nonnegative int64 while sums wrap modulo 2^32.\nkoukai kata Context { xor_nibbles: []int64; powers: []int64; constants: []int64; }\n\nkoukai waza context() -> Context {\n    kaku table: []int64 = []; kaku b = 0;\n    aida (b < 16) {\n        kaku a = 0;\n        aida (a < 16) {\n            kaku left = a; kaku right = b; kaku power = 1; kaku result = 0; kaku bit = 0;\n            aida (bit < 4) {\n                kaku x = left - (left / 2) * 2; kaku y = right - (right / 2) * 2;\n                moshi (x != y) { result = result + power; }\n                left = left / 2; right = right / 2; power = power * 2; bit = bit + 1;\n            }\n            array.push(table, result); a = a + 1;\n        }\n        b = b + 1;\n    }\n    kaku powers: []int64 = [1]; kaku at = 0;\n    aida (at < 32) { array.push(powers, powers[at] * 2); at = at + 1; }\n    kaesu Context { xor_nibbles: table, powers: powers, constants: [\n        1116352408,1899447441,3049323471,3921009573,961987163,1508970993,2453635748,2870763221,\n        3624381080,310598401,607225278,1426881987,1925078388,2162078206,2614888103,3248222580,\n        3835390401,4022224774,264347078,604807628,770255983,1249150122,1555081692,1996064986,\n        2554220882,2821834349,2952996808,3210313671,3336571891,3584528711,113926993,338241895,\n        666307205,773529912,1294757372,1396182291,1695183700,1986661051,2177026350,2456956037,\n        2730485921,2820302411,3259730800,3345764771,3516065817,3600352804,4094571909,275423344,\n        430227734,506948616,659060556,883997877,958139571,1322822218,1537002063,1747873779,\n        1955562222,2024104815,2227730452,2361852424,2428436474,2756734187,3204031479,3329325298] };\n}\n\nwaza wrap(value: int64) -> int64 { kaesu value - (value / 4294967296) * 4294967296; }\nwaza xor32(ctx: Context, a: int64, b: int64) -> int64 {\n    kaku left = a; kaku right = b; kaku value = 0; kaku scale = 1; kaku at = 0;\n    aida (at < 8) {\n        kaku x = left - (left / 16) * 16; kaku y = right - (right / 16) * 16;\n        value = value + ctx.xor_nibbles[x + y * 16] * scale;\n        left = left / 16; right = right / 16; scale = scale * 16; at = at + 1;\n    }\n    kaesu value;\n}\nwaza and32(ctx: Context, a: int64, b: int64) -> int64 { kaesu (a + b - xor32(ctx, a, b)) / 2; }\nwaza rotate(ctx: Context, value: int64, count: int64) -> int64 {\n    kaku divisor = ctx.powers[count];\n    kaesu value / divisor + (value - (value / divisor) * divisor) * ctx.powers[32 - count];\n}\nwaza sigma(ctx: Context, value: int64, a: int64, b: int64, c: int64, small: bool) -> int64 {\n    kaku third = rotate(ctx, value, c); moshi (small) { third = value / ctx.powers[c]; }\n    kaesu xor32(ctx, xor32(ctx, rotate(ctx, value, a), rotate(ctx, value, b)), third);\n}\n\n// Hash a range without allocating a copy of the input or its padding.\n// Invalid ranges return an empty digest; callers must check the 32-byte result.\nkoukai waza sum_range(ctx: Context, data: []uint8, start: int64, length: int64) -> []uint8 {\n    moshi (start < 0 || length < 0 || start > len(data) || length > len(data) - start) { kaesu []; }\n    kaku state: []int64 = [1779033703,3144134277,1013904242,2773480762,1359893119,2600822924,528734635,1541459225];\n    kaku words = array.make[int64](64, 0); kaku blocks = (length + 9 + 63) / 64; kaku block = 0;\n    aida (block < blocks) {\n        kaku at = 0;\n        aida (at < 16) {\n            kaku value = 0; kaku byte = 0;\n            aida (byte < 4) {\n                kaku position = block * 64 + at * 4 + byte; kaku octet = 0;\n                moshi (position < length) { octet = int64(data[start + position]); }\n                sore { moshi (position == length) { octet = 128; }\n                    sore { moshi (position >= blocks * 64 - 8) {\n                        kaku shift = (blocks * 64 - 1 - position) * 8;\n                        kaku bits = length * 8;\n                        // Input arrays are bounded below 2^32 bytes. The high\n                        // length word is still encoded for the complete ABI.\n                        kaku divisor = 1; kaku bit = 0;\n                        aida (bit < shift) { divisor = divisor * 2; bit = bit + 1; }\n                        octet = bits / divisor; octet = octet - (octet / 256) * 256;\n                    } }\n                }\n                value = value * 256 + octet; byte = byte + 1;\n            }\n            words[at] = value; at = at + 1;\n        }\n        aida (at < 64) {\n            words[at] = wrap(sigma(ctx, words[at - 2], 17, 19, 10, hai) + words[at - 7] + sigma(ctx, words[at - 15], 7, 18, 3, hai) + words[at - 16]); at = at + 1;\n        }\n        kaku a = state[0]; kaku b = state[1]; kaku c = state[2]; kaku d = state[3];\n        kaku e = state[4]; kaku f = state[5]; kaku g = state[6]; kaku h = state[7]; at = 0;\n        aida (at < 64) {\n            kaku choice = xor32(ctx, g, and32(ctx, e, xor32(ctx, f, g)));\n            kaku majority = xor32(ctx, and32(ctx, a, b), and32(ctx, c, xor32(ctx, a, b)));\n            kaku first = wrap(h + sigma(ctx, e, 6, 11, 25, iie) + choice + ctx.constants[at] + words[at]);\n            kaku second = wrap(sigma(ctx, a, 2, 13, 22, iie) + majority);\n            h = g; g = f; f = e; e = wrap(d + first); d = c; c = b; b = a; a = wrap(first + second); at = at + 1;\n        }\n        state[0] = wrap(state[0] + a); state[1] = wrap(state[1] + b); state[2] = wrap(state[2] + c); state[3] = wrap(state[3] + d);\n        state[4] = wrap(state[4] + e); state[5] = wrap(state[5] + f); state[6] = wrap(state[6] + g); state[7] = wrap(state[7] + h);\n        block = block + 1;\n    }\n    kaku output: []uint8 = []; kaku at = 0;\n    aida (at < 8) {\n        kaku divisor = 16777216; kaku byte = 0;\n        aida (byte < 4) { kaku value = state[at] / divisor; array.push(output, uint8(value - (value / 256) * 256)); divisor = divisor / 256; byte = byte + 1; }\n        at = at + 1;\n    }\n    kaesu output;\n}\nkoukai waza sum(data: []uint8) -> []uint8 { kaesu sum_range(context(), data, 0, len(data)); }\n" }; }
waza data_21() -> File { kaesu File { path: "kiso/encoding/binary/binary.mio", version: "Bunko-GF3-v0.2", length: 12931, sha256: "73f84eacaae6c6301b72150c24dbcc1748d76958a95258eb7bd014b610b38f0a", source: "yobu \"kiso/array\";\n\nkoukai sentaku BinaryError {\n    InvalidOffset;\n    InsufficientData;\n    Overflow;\n    MalformedVarint;\n}\n\nkoukai kata U8Result { value: uint8; error: BinaryError?; }\nkoukai kata U16Result { value: uint16; error: BinaryError?; }\nkoukai kata U32Result { value: uint32; error: BinaryError?; }\nkoukai kata I8Result { value: int8; error: BinaryError?; }\nkoukai kata I16Result { value: int16; error: BinaryError?; }\nkoukai kata I32Result { value: int32; error: BinaryError?; }\nkoukai kata I64Result { value: int64; error: BinaryError?; }\nkoukai kata BytesResult { data: []uint8; error: BinaryError?; }\nkoukai kata VarU32Result { value: uint32; count: int64; error: BinaryError?; }\nkoukai kata VarI64Result { value: int64; count: int64; error: BinaryError?; }\n\nwaza range_error(data: []uint8, offset: int64, width: int64) -> BinaryError? {\n    moshi (offset < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (offset > len(data) || width > len(data) - offset) { kaesu BinaryError.InsufficientData(); }\n    kaesu mu;\n}\n\nkoukai waza read_u8(data: []uint8, offset: int64) -> U8Result {\n    kaku failure = range_error(data, offset, 1);\n    moshi (failure != mu) { kaesu U8Result { value: uint8(0), error: failure }; }\n    kaesu U8Result { value: data[offset], error: mu };\n}\n\nkoukai waza read_u16_le(data: []uint8, offset: int64) -> U16Result {\n    kaku failure = range_error(data, offset, 2);\n    moshi (failure != mu) { kaesu U16Result { value: uint16(0), error: failure }; }\n    kaesu U16Result { value: uint16(int64(data[offset]) + int64(data[offset + 1]) * 256), error: mu };\n}\n\nkoukai waza read_u16_be(data: []uint8, offset: int64) -> U16Result {\n    kaku failure = range_error(data, offset, 2);\n    moshi (failure != mu) { kaesu U16Result { value: uint16(0), error: failure }; }\n    kaesu U16Result { value: uint16(int64(data[offset]) * 256 + int64(data[offset + 1])), error: mu };\n}\n\nkoukai waza read_u32_le(data: []uint8, offset: int64) -> U32Result {\n    kaku failure = range_error(data, offset, 4);\n    moshi (failure != mu) { kaesu U32Result { value: uint32(0), error: failure }; }\n    kaku value = int64(data[offset]) + int64(data[offset + 1]) * 256 + int64(data[offset + 2]) * 65536 + int64(data[offset + 3]) * 16777216;\n    kaesu U32Result { value: uint32(value), error: mu };\n}\n\nkoukai waza read_u32_be(data: []uint8, offset: int64) -> U32Result {\n    kaku failure = range_error(data, offset, 4);\n    moshi (failure != mu) { kaesu U32Result { value: uint32(0), error: failure }; }\n    kaku value = int64(data[offset]) * 16777216 + int64(data[offset + 1]) * 65536 + int64(data[offset + 2]) * 256 + int64(data[offset + 3]);\n    kaesu U32Result { value: uint32(value), error: mu };\n}\n\nkoukai waza read_i8(data: []uint8, offset: int64) -> I8Result {\n    kaku unsigned = read_u8(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I8Result { value: int8(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 128) { value = value - 256; }\n    kaesu I8Result { value: int8(value), error: mu };\n}\n\nkoukai waza read_i16_le(data: []uint8, offset: int64) -> I16Result {\n    kaku unsigned = read_u16_le(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I16Result { value: int16(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 32768) { value = value - 65536; }\n    kaesu I16Result { value: int16(value), error: mu };\n}\n\nkoukai waza read_i16_be(data: []uint8, offset: int64) -> I16Result {\n    kaku unsigned = read_u16_be(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I16Result { value: int16(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 32768) { value = value - 65536; }\n    kaesu I16Result { value: int16(value), error: mu };\n}\n\nkoukai waza read_i32_le(data: []uint8, offset: int64) -> I32Result {\n    kaku unsigned = read_u32_le(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I32Result { value: int32(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 2147483648) { value = value - 4294967296; }\n    kaesu I32Result { value: int32(value), error: mu };\n}\n\nkoukai waza read_i32_be(data: []uint8, offset: int64) -> I32Result {\n    kaku unsigned = read_u32_be(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I32Result { value: int32(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 2147483648) { value = value - 4294967296; }\n    kaesu I32Result { value: int32(value), error: mu };\n}\n\nwaza read_i64_order(data: []uint8, offset: int64, little: bool) -> I64Result {\n    kaku failure = range_error(data, offset, 8);\n    moshi (failure != mu) { kaesu I64Result { value: 0, error: failure }; }\n    kaku value = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 7) {\n        kaku byte_index = offset + index;\n        moshi (!little) { byte_index = offset + 7 - index; }\n        value = value + int64(data[byte_index]) * factor;\n        factor = factor * 256;\n        index = index + 1;\n    }\n    kaku top_index = offset + 7;\n    moshi (!little) { top_index = offset; }\n    value = value + (int64(data[top_index]) - 256) * factor;\n    moshi (data[top_index] < uint8(128)) { value = value + 256 * factor; }\n    kaesu I64Result { value: value, error: mu };\n}\n\nkoukai waza read_i64_le(data: []uint8, offset: int64) -> I64Result { kaesu read_i64_order(data, offset, hai); }\nkoukai waza read_i64_be(data: []uint8, offset: int64) -> I64Result { kaesu read_i64_order(data, offset, iie); }\n\nwaza write_unsigned(destination: []uint8, offset: int64, width: int64, value: int64, little: bool) -> BinaryError? {\n    kaku failure = range_error(destination, offset, width);\n    moshi (failure != mu) { kaesu failure; }\n    kaku remaining = value;\n    kaku index = 0;\n    aida (index < width) {\n        kaku byte_value = remaining - (remaining / 256) * 256;\n        kaku target = offset + index;\n        moshi (!little) { target = offset + width - 1 - index; }\n        destination[target] = uint8(byte_value);\n        remaining = remaining / 256;\n        index = index + 1;\n    }\n    kaesu mu;\n}\n\nwaza write_signed64(destination: []uint8, offset: int64, value: int64, little: bool) -> BinaryError? {\n    kaku failure = range_error(destination, offset, 8);\n    moshi (failure != mu) { kaesu failure; }\n    kaku remaining = value;\n    kaku index = 0;\n    aida (index < 8) {\n        kaku quotient = remaining / 256;\n        kaku remainder = remaining - quotient * 256;\n        moshi (remainder < 0) { remainder = remainder + 256; quotient = quotient - 1; }\n        kaku target = offset + index;\n        moshi (!little) { target = offset + 7 - index; }\n        destination[target] = uint8(remainder);\n        remaining = quotient;\n        index = index + 1;\n    }\n    kaesu mu;\n}\n\nkoukai waza write_u8(destination: []uint8, offset: int64, value: uint8) -> BinaryError? { kaesu write_unsigned(destination, offset, 1, int64(value), hai); }\nkoukai waza write_u16_le(destination: []uint8, offset: int64, value: uint16) -> BinaryError? { kaesu write_unsigned(destination, offset, 2, int64(value), hai); }\nkoukai waza write_u16_be(destination: []uint8, offset: int64, value: uint16) -> BinaryError? { kaesu write_unsigned(destination, offset, 2, int64(value), iie); }\nkoukai waza write_u32_le(destination: []uint8, offset: int64, value: uint32) -> BinaryError? { kaesu write_unsigned(destination, offset, 4, int64(value), hai); }\nkoukai waza write_u32_be(destination: []uint8, offset: int64, value: uint32) -> BinaryError? { kaesu write_unsigned(destination, offset, 4, int64(value), iie); }\nkoukai waza write_i8(destination: []uint8, offset: int64, value: int8) -> BinaryError? { kaesu write_unsigned(destination, offset, 1, int64(value) + 256, hai); }\nkoukai waza write_i16_le(destination: []uint8, offset: int64, value: int16) -> BinaryError? { kaesu write_unsigned(destination, offset, 2, int64(value) + 65536, hai); }\nkoukai waza write_i16_be(destination: []uint8, offset: int64, value: int16) -> BinaryError? { kaesu write_unsigned(destination, offset, 2, int64(value) + 65536, iie); }\nkoukai waza write_i32_le(destination: []uint8, offset: int64, value: int32) -> BinaryError? { kaesu write_unsigned(destination, offset, 4, int64(value) + 4294967296, hai); }\nkoukai waza write_i32_be(destination: []uint8, offset: int64, value: int32) -> BinaryError? { kaesu write_unsigned(destination, offset, 4, int64(value) + 4294967296, iie); }\nkoukai waza write_i64_le(destination: []uint8, offset: int64, value: int64) -> BinaryError? { kaesu write_signed64(destination, offset, value, hai); }\nkoukai waza write_i64_be(destination: []uint8, offset: int64, value: int64) -> BinaryError? { kaesu write_signed64(destination, offset, value, iie); }\n\nkoukai waza write_var_u32(value: uint32) -> BytesResult {\n    kaku output = array.with_capacity[uint8](5);\n    kaku remaining = int64(value);\n    aida (remaining >= 128) {\n        array.push(output, uint8(remaining - (remaining / 128) * 128 + 128));\n        remaining = remaining / 128;\n    }\n    array.push(output, uint8(remaining));\n    kaesu BytesResult { data: output, error: mu };\n}\n\nkoukai waza read_var_u32(data: []uint8, offset: int64) -> VarU32Result {\n    moshi (offset < 0) { kaesu VarU32Result { value: uint32(0), count: 0, error: BinaryError.InvalidOffset() }; }\n    kaku value = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 5) {\n        moshi (offset + index >= len(data)) { kaesu VarU32Result { value: uint32(0), count: index, error: BinaryError.InsufficientData() }; }\n        kaku current = int64(data[offset + index]);\n        kaku payload = current;\n        moshi (payload >= 128) { payload = payload - 128; }\n        moshi (index == 4 && payload > 15) { kaesu VarU32Result { value: uint32(0), count: 5, error: BinaryError.Overflow() }; }\n        value = value + payload * factor;\n        moshi (current < 128) {\n            kaku encoded = write_var_u32(uint32(value));\n            moshi (len(encoded.data) != index + 1) { kaesu VarU32Result { value: uint32(0), count: index + 1, error: BinaryError.MalformedVarint() }; }\n            kaesu VarU32Result { value: uint32(value), count: index + 1, error: mu };\n        }\n        factor = factor * 128;\n        index = index + 1;\n    }\n    kaesu VarU32Result { value: uint32(0), count: 5, error: BinaryError.MalformedVarint() };\n}\n\nkoukai waza write_var_i64(value: int64) -> BytesResult {\n    kaku output = array.with_capacity[uint8](10);\n    kaku remaining = value;\n    kaku done = iie;\n    aida (!done) {\n        kaku quotient = remaining / 128;\n        kaku payload = remaining - quotient * 128;\n        moshi (payload < 0) { payload = payload + 128; quotient = quotient - 1; }\n        done = (quotient == 0 && payload < 64) || (quotient == -1 && payload >= 64);\n        moshi (!done) { payload = payload + 128; }\n        array.push(output, uint8(payload));\n        remaining = quotient;\n    }\n    kaesu BytesResult { data: output, error: mu };\n}\n\nkoukai waza read_var_i64(data: []uint8, offset: int64) -> VarI64Result {\n    moshi (offset < 0) { kaesu VarI64Result { value: 0, count: 0, error: BinaryError.InvalidOffset() }; }\n    kaku value = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 10) {\n        moshi (offset + index >= len(data)) { kaesu VarI64Result { value: 0, count: index, error: BinaryError.InsufficientData() }; }\n        kaku current = int64(data[offset + index]);\n        kaku payload = current;\n        moshi (payload >= 128) { payload = payload - 128; }\n        moshi (index == 9) {\n            moshi (current != 0 && current != 127) { kaesu VarI64Result { value: 0, count: 10, error: BinaryError.Overflow() }; }\n            moshi (current == 127) { value = value - 9223372036854775807 - 1; }\n        } sore {\n            value = value + payload * factor;\n        }\n        moshi (current < 128) {\n            moshi (index < 9 && current >= 64) { value = value - factor * 128; }\n            kaku encoded = write_var_i64(value);\n            moshi (len(encoded.data) != index + 1) { kaesu VarI64Result { value: 0, count: index + 1, error: BinaryError.MalformedVarint() }; }\n            kaku compare = 0;\n            aida (compare < len(encoded.data)) {\n                moshi (encoded.data[compare] != data[offset + compare]) { kaesu VarI64Result { value: 0, count: index + 1, error: BinaryError.MalformedVarint() }; }\n                compare = compare + 1;\n            }\n            kaesu VarI64Result { value: value, count: index + 1, error: mu };\n        }\n        moshi (index == 9) { kaesu VarI64Result { value: 0, count: 10, error: BinaryError.MalformedVarint() }; }\n        factor = factor * 128;\n        index = index + 1;\n    }\n    kaesu VarI64Result { value: 0, count: 10, error: BinaryError.MalformedVarint() };\n}\n" }; }
waza data_22() -> File { kaesu File { path: "kiso/encoding/binary/stream.mio", version: "Bunko-GF3-v0.2", length: 9123, sha256: "74ad1f1ded30a44b604717e0221f09fb1d328b4a03ae8290a1676468f1dac0ce", source: "yobu \"kiso/array\";\n\n// U64 keeps the complete unsigned 64-bit bit pattern without adding uint64 to Mio.\nkoukai kata U64 { high: uint32; low: uint32; }\nkoukai kata U64Result { value: U64; error: BinaryError?; }\n\n// BinaryReader owns an immutable view of the caller's bytes and a private cursor cell.\n// Reads never modify data.  The single-element state array gives functions reference\n// semantics while keeping the public language free of pointers.\nkoukai kata BinaryReader { data: []uint8; state: []int64; }\n\nkoukai waza reader(data: []uint8) -> BinaryReader {\n    kaesu BinaryReader { data: data, state: [0] };\n}\n\nkoukai waza reader_offset(value: BinaryReader) -> int64 { kaesu value.state[0]; }\nkoukai waza reader_remaining(value: BinaryReader) -> int64 { kaesu len(value.data) - value.state[0]; }\nkoukai waza reader_eof(value: BinaryReader) -> bool { kaesu value.state[0] == len(value.data); }\n\nkoukai waza reader_seek(value: BinaryReader, offset: int64) -> BinaryError? {\n    moshi (offset < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (offset > len(value.data)) { kaesu BinaryError.InsufficientData(); }\n    value.state[0] = offset;\n    kaesu mu;\n}\n\nkoukai waza reader_skip(value: BinaryReader, count: int64) -> BinaryError? {\n    moshi (count < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (count > reader_remaining(value)) { kaesu BinaryError.InsufficientData(); }\n    value.state[0] = value.state[0] + count;\n    kaesu mu;\n}\n\nkoukai waza reader_read_u8(value: BinaryReader) -> U8Result {\n    kaku result = read_u8(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 1; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u16_le(value: BinaryReader) -> U16Result {\n    kaku result = read_u16_le(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 2; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u16_be(value: BinaryReader) -> U16Result {\n    kaku result = read_u16_be(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 2; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u32_le(value: BinaryReader) -> U32Result {\n    kaku result = read_u32_le(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 4; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u32_be(value: BinaryReader) -> U32Result {\n    kaku result = read_u32_be(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 4; }\n    kaesu result;\n}\n\nwaza read_u64_order(value: BinaryReader, little: bool) -> U64Result {\n    kaku failure = range_error(value.data, value.state[0], 8);\n    moshi (failure != mu) { kaesu U64Result { value: U64 { high: uint32(0), low: uint32(0) }, error: failure }; }\n    kaku high = read_u32_be(value.data, value.state[0]);\n    kaku low = read_u32_be(value.data, value.state[0] + 4);\n    moshi (little) {\n        low = read_u32_le(value.data, value.state[0]);\n        high = read_u32_le(value.data, value.state[0] + 4);\n    }\n    value.state[0] = value.state[0] + 8;\n    kaesu U64Result { value: U64 { high: high.value, low: low.value }, error: mu };\n}\n\nkoukai waza reader_read_u64_le(value: BinaryReader) -> U64Result { kaesu read_u64_order(value, hai); }\nkoukai waza reader_read_u64_be(value: BinaryReader) -> U64Result { kaesu read_u64_order(value, iie); }\n\nkoukai waza reader_read_bytes(value: BinaryReader, count: int64) -> BytesResult {\n    moshi (count < 0) { kaesu BytesResult { data: [], error: BinaryError.InvalidOffset() }; }\n    moshi (count > reader_remaining(value)) { kaesu BytesResult { data: [], error: BinaryError.InsufficientData() }; }\n    kaku output = array.with_capacity[uint8](count);\n    kaku index = 0;\n    aida (index < count) {\n        array.push(output, value.data[value.state[0] + index]);\n        index = index + 1;\n    }\n    value.state[0] = value.state[0] + count;\n    kaesu BytesResult { data: output, error: mu };\n}\n\n// max_length is a hard allocation ceiling. A negative limit is rejected.\nkoukai kata BinaryWriter { data: []uint8; max_length: int64; }\n\nkoukai waza writer(max_length: int64) -> BinaryWriter {\n    kaku limit = max_length;\n    moshi (limit < 0) { limit = 0; }\n    kaesu BinaryWriter { data: array.with_capacity[uint8](0), max_length: limit };\n}\n\nkoukai waza writer_offset(value: BinaryWriter) -> int64 { kaesu len(value.data); }\n\nwaza writer_grow(value: BinaryWriter, count: int64) -> BinaryError? {\n    moshi (count < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (len(value.data) > value.max_length || count > value.max_length - len(value.data)) { kaesu BinaryError.Overflow(); }\n    kaku target = len(value.data) + count;\n    array.reserve(value.data, count);\n    aida (len(value.data) < target) { array.push(value.data, uint8(0)); }\n    kaesu mu;\n}\n\nkoukai waza writer_reserve(value: BinaryWriter, count: int64) -> I64Result {\n    kaku offset = len(value.data);\n    kaku failure = writer_grow(value, count);\n    moshi (failure != mu) { kaesu I64Result { value: -1, error: failure }; }\n    kaesu I64Result { value: offset, error: mu };\n}\n\nkoukai waza writer_write_bytes(value: BinaryWriter, source: []uint8) -> BinaryError? {\n    kaku start = writer_reserve(value, len(source));\n    moshi (start.error != mu) { kaesu start.error; }\n    kaku index = 0;\n    aida (index < len(source)) { value.data[start.value + index] = source[index]; index = index + 1; }\n    kaesu mu;\n}\n\nkoukai waza writer_write_length_prefixed(value: BinaryWriter, source: []uint8) -> BinaryError? {\n    moshi (len(source) > 4294967295) { kaesu BinaryError.Overflow(); }\n    moshi (len(value.data) > value.max_length || value.max_length - len(value.data) < 4 ||\n        len(source) > value.max_length - len(value.data) - 4) { kaesu BinaryError.Overflow(); }\n    kaku failure = writer_write_u32_be(value, uint32(len(source)));\n    moshi (failure != mu) { kaesu failure; }\n    kaesu writer_write_bytes(value, source);\n}\n\nkoukai waza writer_write_u8(value: BinaryWriter, number: uint8) -> BinaryError? {\n    kaku start = writer_reserve(value, 1); moshi (start.error != mu) { kaesu start.error; }\n    kaesu write_u8(value.data, start.value, number);\n}\nkoukai waza writer_write_u16_le(value: BinaryWriter, number: uint16) -> BinaryError? {\n    kaku start = writer_reserve(value, 2); moshi (start.error != mu) { kaesu start.error; }\n    kaesu write_u16_le(value.data, start.value, number);\n}\nkoukai waza writer_write_u16_be(value: BinaryWriter, number: uint16) -> BinaryError? {\n    kaku start = writer_reserve(value, 2); moshi (start.error != mu) { kaesu start.error; }\n    kaesu write_u16_be(value.data, start.value, number);\n}\nkoukai waza writer_write_u32_le(value: BinaryWriter, number: uint32) -> BinaryError? {\n    kaku start = writer_reserve(value, 4); moshi (start.error != mu) { kaesu start.error; }\n    kaesu write_u32_le(value.data, start.value, number);\n}\nkoukai waza writer_write_u32_be(value: BinaryWriter, number: uint32) -> BinaryError? {\n    kaku start = writer_reserve(value, 4); moshi (start.error != mu) { kaesu start.error; }\n    kaesu write_u32_be(value.data, start.value, number);\n}\n\nwaza writer_write_u64_order(value: BinaryWriter, number: U64, little: bool) -> BinaryError? {\n    kaku start = writer_reserve(value, 8); moshi (start.error != mu) { kaesu start.error; }\n    moshi (little) {\n        write_u32_le(value.data, start.value, number.low);\n        kaesu write_u32_le(value.data, start.value + 4, number.high);\n    }\n    write_u32_be(value.data, start.value, number.high);\n    kaesu write_u32_be(value.data, start.value + 4, number.low);\n}\nkoukai waza writer_write_u64_le(value: BinaryWriter, number: U64) -> BinaryError? { kaesu writer_write_u64_order(value, number, hai); }\nkoukai waza writer_write_u64_be(value: BinaryWriter, number: U64) -> BinaryError? { kaesu writer_write_u64_order(value, number, iie); }\n\nkoukai waza writer_patch_u16_be(value: BinaryWriter, offset: int64, number: uint16) -> BinaryError? { kaesu write_u16_be(value.data, offset, number); }\nkoukai waza writer_patch_u16_le(value: BinaryWriter, offset: int64, number: uint16) -> BinaryError? { kaesu write_u16_le(value.data, offset, number); }\nkoukai waza writer_patch_u32_be(value: BinaryWriter, offset: int64, number: uint32) -> BinaryError? { kaesu write_u32_be(value.data, offset, number); }\nkoukai waza writer_patch_u32_le(value: BinaryWriter, offset: int64, number: uint32) -> BinaryError? { kaesu write_u32_le(value.data, offset, number); }\nkoukai waza writer_patch_u64_be(value: BinaryWriter, offset: int64, number: U64) -> BinaryError? {\n    kaku failure = write_u32_be(value.data, offset, number.high); moshi (failure != mu) { kaesu failure; }\n    kaesu write_u32_be(value.data, offset + 4, number.low);\n}\nkoukai waza writer_patch_u64_le(value: BinaryWriter, offset: int64, number: U64) -> BinaryError? {\n    kaku failure = write_u32_le(value.data, offset, number.low); moshi (failure != mu) { kaesu failure; }\n    kaesu write_u32_le(value.data, offset + 4, number.high);\n}\n\nkoukai waza writer_bytes(value: BinaryWriter) -> []uint8 { kaesu array.clone(value.data); }\n" }; }
waza data_23() -> File { kaesu File { path: "kiso/encoding/json/json.mio", version: "Bunko-GF3-v0.2", length: 10484, sha256: "bf01d6f6e3aa6e929290c17bfc912e9b64e838d21ab3e08ad4467459f9dba9fb", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\nyobu \"kiso/utf8\";\nyobu \"kiso/convert\";\n\n// Numbers retain their exact JSON token so request IDs never lose precision.\n// kind: null=0, bool=1, number=2, string=3, array=4, object=5.\nkoukai kata Value { kind: int64; text: string; children: []int64; keys: []string; }\nkoukai kata Document { values: []Value; root: int64; error: string; offset: int64; }\nkata State { data: []uint8; at: []int64; values: []Value; error: []string; }\nwaza byte(state: State) -> int64 { moshi (state.at[0] >= len(state.data)) { kaesu -1; } kaesu int64(state.data[state.at[0]]); }\nwaza fail(state: State, message: string) -> unit { moshi (state.error[0] == \"\") { state.error[0] = message; } }\nwaza whitespace(state: State) -> unit {\n    kaku value = byte(state);\n    aida (value == 32 || value == 9 || value == 10 || value == 13) { state.at[0] = state.at[0] + 1; value = byte(state); }\n}\nwaza text_range(data: []uint8, first: int64, end: int64) -> string {\n    kaku bytes: []uint8 = []; kaku at = first;\n    aida (at < end) { array.push(bytes, data[at]); at = at + 1; }\n    kaku text = string.from_utf8(bytes); moshi (text == mu) { kaesu \"\"; } kaesu text;\n}\nwaza hex(value: int64) -> int64 {\n    moshi (value >= 48 && value <= 57) { kaesu value - 48; }\n    moshi (value >= 65 && value <= 70) { kaesu value - 55; }\n    moshi (value >= 97 && value <= 102) { kaesu value - 87; } kaesu -1;\n}\nwaza hex4(data: []uint8, at: int64) -> int64 {\n    moshi (at < 0 || at + 4 > len(data)) { kaesu -1; }\n    kaku result = 0; kaku index = 0;\n    aida (index < 4) { kaku digit = hex(int64(data[at + index])); moshi (digit < 0) { kaesu -1; } result = result * 16 + digit; index = index + 1; }\n    kaesu result;\n}\nwaza parse_string(state: State) -> string {\n    moshi (byte(state) != 34) { fail(state, \"expected JSON string\"); kaesu \"\"; }\n    state.at[0] = state.at[0] + 1; kaku output: []uint8 = [];\n    aida (state.at[0] < len(state.data) && state.error[0] == \"\") {\n        kaku value = byte(state); state.at[0] = state.at[0] + 1;\n        moshi (value == 34) { kaku text = string.from_utf8(output); moshi (text == mu) { fail(state, \"invalid string UTF8\"); kaesu \"\"; } kaesu text; }\n        moshi (value < 32) { fail(state, \"unescaped string control byte\"); kaesu \"\"; }\n        moshi (value != 92) { array.push(output, uint8(value)); tsuzuku; }\n        kaku escaped = byte(state); state.at[0] = state.at[0] + 1;\n        moshi (escaped == 34 || escaped == 92 || escaped == 47) { array.push(output, uint8(escaped)); tsuzuku; }\n        kaku control = -1;\n        moshi (escaped == 98) { control = 8; } moshi (escaped == 102) { control = 12; } moshi (escaped == 110) { control = 10; }\n        moshi (escaped == 114) { control = 13; } moshi (escaped == 116) { control = 9; }\n        moshi (control >= 0) { array.push(output, uint8(control)); tsuzuku; }\n        moshi (escaped != 117) { fail(state, \"invalid JSON escape\"); kaesu \"\"; }\n        kaku scalar = hex4(state.data, state.at[0]);\n        moshi (scalar < 0) { fail(state, \"invalid Unicode escape\"); kaesu \"\"; }\n        state.at[0] = state.at[0] + 4;\n        moshi (scalar >= 55296 && scalar <= 56319) {\n            kaku low = -1;\n            moshi (state.at[0] + 6 <= len(state.data) && state.data[state.at[0]] == uint8(92) && state.data[state.at[0] + 1] == uint8(117)) { low = hex4(state.data, state.at[0] + 2); }\n            moshi (low >= 56320 && low <= 57343) { scalar = 65536 + (scalar - 55296) * 1024 + low - 56320; state.at[0] = state.at[0] + 6; }\n            sore { scalar = 65533; }\n        }\n        sore { moshi (scalar >= 56320 && scalar <= 57343) { scalar = 65533; } }\n        utf8.append_rune(output, rune(scalar));\n    }\n    fail(state, \"unterminated JSON string\"); kaesu \"\";\n}\nwaza push(state: State, kind: int64, text: string, children: []int64, keys: []string) -> int64 {\n    kaku id = len(state.values); array.push(state.values, Value { kind: kind, text: text, children: children, keys: keys }); kaesu id;\n}\nwaza keyword(state: State, expected: string, kind: int64) -> int64 {\n    kaku bytes = string.to_bytes(expected); kaku at = 0;\n    aida (at < len(bytes)) {\n        moshi (byte(state) != int64(bytes[at])) { fail(state, \"invalid JSON keyword\"); kaesu -1; }\n        state.at[0] = state.at[0] + 1; at = at + 1;\n    }\n    kaesu push(state, kind, expected, [], []);\n}\nwaza digit(value: int64) -> bool { kaesu value >= 48 && value <= 57; }\nwaza number(state: State) -> int64 {\n    kaku first = state.at[0]; moshi (byte(state) == 45) { state.at[0] = state.at[0] + 1; }\n    moshi (byte(state) == 48) { state.at[0] = state.at[0] + 1; }\n    sore { moshi (byte(state) < 49 || byte(state) > 57) { fail(state, \"invalid JSON number\"); kaesu -1; }\n        aida (digit(byte(state))) { state.at[0] = state.at[0] + 1; }\n    }\n    moshi (byte(state) == 46) {\n        state.at[0] = state.at[0] + 1; moshi (!digit(byte(state))) { fail(state, \"missing fraction digits\"); kaesu -1; }\n        aida (digit(byte(state))) { state.at[0] = state.at[0] + 1; }\n    }\n    moshi (byte(state) == 101 || byte(state) == 69) {\n        state.at[0] = state.at[0] + 1; moshi (byte(state) == 43 || byte(state) == 45) { state.at[0] = state.at[0] + 1; }\n        moshi (!digit(byte(state))) { fail(state, \"missing exponent digits\"); kaesu -1; }\n        aida (digit(byte(state))) { state.at[0] = state.at[0] + 1; }\n    }\n    kaesu push(state, 2, text_range(state.data, first, state.at[0]), [], []);\n}\nwaza value(state: State, depth: int64) -> int64 {\n    whitespace(state);\n    moshi (depth > 256 || len(state.values) >= 1000000) { fail(state, \"JSON structure limit exceeded\"); kaesu -1; }\n    kaku current = byte(state);\n    moshi (current == 34) { kaku text = parse_string(state); moshi (state.error[0] != \"\") { kaesu -1; } kaesu push(state, 3, text, [], []); }\n    moshi (current == 110) { kaesu keyword(state, \"null\", 0); }\n    moshi (current == 116) { kaesu keyword(state, \"true\", 1); }\n    moshi (current == 102) { kaesu keyword(state, \"false\", 1); }\n    moshi (current == 45 || digit(current)) { kaesu number(state); }\n    moshi (current != 91 && current != 123) { fail(state, \"expected JSON value\"); kaesu -1; }\n    kaku object = current == 123; kaku end = 93; kaku kind = 4; moshi (object) { end = 125; kind = 5; }\n    state.at[0] = state.at[0] + 1; whitespace(state); kaku children: []int64 = []; kaku keys: []string = [];\n    moshi (byte(state) == end) { state.at[0] = state.at[0] + 1; kaesu push(state, kind, \"\", children, keys); }\n    aida (state.error[0] == \"\") {\n        moshi (object) {\n            kaku key = parse_string(state); moshi (state.error[0] != \"\") { kaesu -1; }\n            array.push(keys, key); whitespace(state); moshi (byte(state) != 58) { fail(state, \"expected object colon\"); kaesu -1; }\n            state.at[0] = state.at[0] + 1;\n        }\n        kaku child = value(state, depth + 1); moshi (child < 0) { kaesu -1; } array.push(children, child); whitespace(state);\n        moshi (byte(state) == end) { state.at[0] = state.at[0] + 1; kaesu push(state, kind, \"\", children, keys); }\n        moshi (byte(state) != 44) { fail(state, \"expected comma or closing delimiter\"); kaesu -1; }\n        state.at[0] = state.at[0] + 1; whitespace(state);\n    }\n    kaesu -1;\n}\n\nkoukai waza parse(data: []uint8) -> Document {\n    kaku state = State { data: data, at: [0], values: [], error: [\"\"] };\n    moshi (len(data) > 67108864 || !utf8.valid(data)) { kaesu Document { values: [], root: -1, error: \"invalid JSON size or UTF8\", offset: 0 }; }\n    kaku root = value(state, 0); whitespace(state);\n    moshi (state.at[0] != len(data)) { fail(state, \"trailing JSON data\"); }\n    kaesu Document { values: state.values, root: root, error: state.error[0], offset: state.at[0] };\n}\nkoukai waza member(document: Document, object: int64, key: string) -> int64 {\n    moshi (object < 0 || object >= len(document.values) || document.values[object].kind != 5) { kaesu -1; }\n    kaku node = document.values[object]; kaku at = len(node.keys) - 1;\n    aida (at >= 0) { moshi (node.keys[at] == key) { kaesu node.children[at]; } at = at - 1; } kaesu -1;\n}\nkoukai waza text(document: Document, node: int64) -> string {\n    moshi (node < 0 || node >= len(document.values)) { kaesu \"\"; } kaesu document.values[node].text;\n}\nkoukai waza integer(document: Document, node: int64) -> int64? {\n    moshi (node < 0 || node >= len(document.values) || document.values[node].kind != 2) { kaesu mu; }\n    kaesu convert.parse_int(document.values[node].text);\n}\nkoukai waza quote(text: string) -> string {\n    kaku bytes = string.to_bytes(text); kaku output: []uint8 = [uint8(34)]; kaku digits = string.to_bytes(\"0123456789abcdef\"); kaku at = 0;\n    aida (at < len(bytes)) {\n        kaku byte = int64(bytes[at]); kaku escaped = 0;\n        moshi (byte == 34 || byte == 92) { escaped = byte; }\n        moshi (byte == 8) { escaped = 98; } moshi (byte == 9) { escaped = 116; } moshi (byte == 10) { escaped = 110; } moshi (byte == 12) { escaped = 102; } moshi (byte == 13) { escaped = 114; }\n        moshi (escaped > 0) { array.push(output, uint8(92)); array.push(output, uint8(escaped)); }\n        sore { moshi (byte < 32) {\n            array.push(output, uint8(92)); array.push(output, uint8(117)); array.push(output, uint8(48)); array.push(output, uint8(48)); array.push(output, digits[byte / 16]); array.push(output, digits[byte - (byte / 16) * 16]);\n        } sore { array.push(output, uint8(byte)); } }\n        at = at + 1;\n    }\n    array.push(output, uint8(34)); kaku result = string.from_utf8(output); moshi (result == mu) { kaesu \"\\\"\\\"\"; } kaesu result;\n}\nkoukai waza render(document: Document, node: int64) -> string {\n    moshi (node < 0 || node >= len(document.values)) { kaesu \"null\"; }\n    kaku item = document.values[node];\n    moshi (item.kind == 0) { kaesu \"null\"; }\n    moshi (item.kind == 1 || item.kind == 2) { kaesu item.text; }\n    moshi (item.kind == 3) { kaesu quote(item.text); }\n    kaku output = string.new_builder(); kaku object = item.kind == 5; kaku open = \"[\"; kaku close = \"]\";\n    moshi (object) { open = \"{\"; close = \"}\"; } string.write_string(output, open); kaku at = 0;\n    aida (at < len(item.children)) {\n        moshi (at > 0) { string.write_string(output, \",\"); }\n        moshi (object) { string.write_string(output, string.concat(quote(item.keys[at]), \":\")); }\n        string.write_string(output, render(document, item.children[at])); at = at + 1;\n    }\n    string.write_string(output, close); kaesu string.builder_string(output);\n}\n" }; }
waza data_24() -> File { kaesu File { path: "kiso/encoding/mochi/decode.mio", version: "Bunko-GF3-v0.2", length: 23766, sha256: "55d4480a288703503032231050c35817c129edaacacc78ee44adce9fefd28903", source: "yobu \"kiso/array\";\nyobu \"kiso/encoding/binary\";\nyobu \"kiso/string\";\nyobu \"kiso/utf8\";\n\nkoukai teisu VERSION: int64 = 16;\nkoukai teisu MAX_FILE_SIZE: int64 = 67108864;\nkoukai teisu MAX_CONSTANTS: int64 = 65536;\nkoukai teisu MAX_GLOBALS: int64 = 65536;\nkoukai teisu MAX_STRING_BYTES: int64 = 16777216;\nkoukai teisu MAX_INSTRUCTION_BYTES: int64 = 16777216;\nkoukai teisu MAX_FUNCTIONS: int64 = 65536;\nkoukai teisu MAX_FUNCTION_SLOTS: int64 = 65536;\n\nkoukai sentaku DecodeErrorKind {\n    Truncated;\n    InvalidMagic;\n    UnsupportedVersion;\n    LimitExceeded;\n    InvalidConstant;\n    InvalidUtf8;\n    InvalidFunction;\n    InvalidInstruction;\n    InvalidIndex;\n    InvalidJump;\n    TrailingData;\n    IoFailure;\n}\n\nkoukai kata DecodeError { kind: DecodeErrorKind; offset: int64; detail: int64; }\nkoukai kata Constant { tag: uint8; bits: binary.U64; data: []uint8; }\nkoukai kata Capture { local: bool; index: int64; }\nkoukai kata Function {\n    id: int64;\n    name: string;\n    name_bytes: []uint8;\n    parameter_count: int64;\n    local_count: int64;\n    returns_value: bool;\n    captures: []Capture;\n    instructions: []uint8;\n}\nkoukai kata File {\n    version: int64;\n    constants: []Constant;\n    global_count: int64;\n    instructions: []uint8;\n    functions: []Function;\n}\nkoukai kata DecodeResult { value: File?; error: DecodeError?; }\n\nwaza failure(kind: DecodeErrorKind, offset: int64, detail: int64) -> DecodeResult {\n    kaesu DecodeResult { value: mu, error: DecodeError { kind: kind, offset: offset, detail: detail } };\n}\n\nwaza empty_file() -> File {\n    kaesu File { version: 0, constants: array.with_capacity[Constant](0), global_count: 0,\n        instructions: array.with_capacity[uint8](0), functions: array.with_capacity[Function](0) };\n}\n\nwaza instruction_width(opcode: int64) -> int64 {\n    moshi (opcode == 38) { kaesu 5; }\n    moshi (opcode == 54) { kaesu 3; }\n    moshi (opcode == 56 || opcode == 67) { kaesu 4; }\n    moshi ((opcode >= 1 && opcode <= 1) || (opcode >= 17 && opcode <= 20) ||\n        (opcode >= 23 && opcode <= 25) || opcode == 30 || opcode == 36 || opcode == 37 ||\n        opcode == 40 || (opcode >= 44 && opcode <= 49)) { kaesu 3; }\n    moshi (opcode == 55 || opcode == 57 || opcode == 58 || opcode == 65 || opcode == 66) { kaesu 2; }\n    moshi (opcode >= 2 && opcode <= 16) { kaesu 1; }\n    moshi (opcode >= 21 && opcode <= 22) { kaesu 1; }\n    moshi (opcode >= 26 && opcode <= 29) { kaesu 1; }\n    moshi (opcode >= 31 && opcode <= 35) { kaesu 1; }\n    moshi (opcode == 39 || (opcode >= 41 && opcode <= 43)) { kaesu 1; }\n    moshi (opcode >= 50 && opcode <= 53) { kaesu 1; }\n    moshi (opcode >= 59 && opcode <= 64) { kaesu 1; }\n    kaesu 0;\n}\n\nwaza version_allows(opcode: int64, version: int64) -> bool {\n    moshi(opcode==67 && version<16){kaesu iie;}\n    moshi ((opcode == 28 || opcode == 29) && version < 4) { kaesu iie; }\n    moshi ((opcode == 30 || opcode == 31) && version < 5) { kaesu iie; }\n    moshi ((opcode == 32 || opcode == 33) && version < 6) { kaesu iie; }\n    moshi ((opcode == 34 || opcode == 35) && version < 7) { kaesu iie; }\n    moshi (opcode >= 36 && opcode <= 45 && version < 8) { kaesu iie; }\n    moshi (opcode >= 46 && opcode <= 49 && version < 9) { kaesu iie; }\n    moshi (opcode >= 50 && opcode <= 54 && version < 10) { kaesu iie; }\n    moshi (opcode == 55 && version < 11) { kaesu iie; }\n    moshi (opcode >= 56 && opcode <= 62 && version < 12) { kaesu iie; }\n    moshi ((opcode == 63 || opcode == 64) && version < 13) { kaesu iie; }\n    moshi (opcode == 65 && version < 14) { kaesu iie; }\n    moshi (opcode == 66 && version < 15) { kaesu iie; }\n    kaesu hai;\n}\n\nwaza valid_descriptor(value: int64) -> bool {\n    moshi (value == 0) { kaesu hai; }\n    kaku base = value;\n    moshi (base >= 128) { base = base - 128; }\n    moshi (base == 1 || base == 2 || base == 3 || base == 4 || base == 5 ||\n        base == 7 || base == 8 || base == 9 || base == 10 || base == 11 ||\n        (base >= 12 && base <= 17)) { kaesu hai; }\n    kaesu iie;\n}\n\nwaza read_operand_u16(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset]) * 256 + int64(data[offset + 1]);\n}\n\nwaza validate_instructions(file: File, data: []uint8, function_index: int64) -> DecodeError? {\n    kaku boundaries = array.make[bool](len(data) + 1, iie);\n    boundaries[len(data)] = hai;\n    kaku jump_offsets = array.with_capacity[int64](8);\n    kaku jump_targets = array.with_capacity[int64](8);\n    kaku offset = 0;\n    aida (offset < len(data)) {\n        boundaries[offset] = hai;\n        kaku opcode = int64(data[offset]);\n        kaku width = instruction_width(opcode);\n        moshi (width == 0 || !version_allows(opcode, file.version)) {\n            kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: opcode };\n        }\n        moshi (width > len(data) - offset) {\n            kaesu DecodeError { kind: DecodeErrorKind.Truncated(), offset: offset, detail: opcode };\n        }\n        kaku first = 0;\n        kaku second = 0;\n        moshi (width >= 3 && opcode != 54) { first = read_operand_u16(data, offset + 1); }\n        moshi (width == 2) { first = int64(data[offset + 1]); }\n        moshi (opcode == 54) { first = int64(data[offset + 1]); second = int64(data[offset + 2]); }\n        moshi (opcode == 56 || opcode == 67) { first = read_operand_u16(data, offset + 1); second = int64(data[offset + 3]); }\n        moshi (opcode == 38) { first = read_operand_u16(data, offset + 1); second = read_operand_u16(data, offset + 3); }\n        moshi(opcode==67 && second>1){kaesu DecodeError {kind:DecodeErrorKind.InvalidInstruction(),offset:offset,detail:second};}\n        moshi (opcode == 66 && (first == 0 || first >= 128 || !valid_descriptor(first))) {\n            kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: first };\n        }\n\n        moshi (opcode == 1 && first >= len(file.constants)) {\n            kaesu DecodeError { kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: first };\n        }\n        moshi ((opcode == 19 || opcode == 20) && first >= file.global_count) {\n            kaesu DecodeError { kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: first };\n        }\n        moshi (opcode == 23 || opcode == 24 || opcode == 49) {\n            moshi (function_index < 0 || first >= file.functions[function_index].local_count) {\n                kaesu DecodeError { kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: first };\n            }\n        }\n        moshi (opcode == 25 || opcode == 44 || opcode == 46) {\n            moshi (first >= len(file.functions)) { kaesu DecodeError { kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: first }; }\n            moshi ((opcode == 25 || opcode == 44) && len(file.functions[first].captures) != 0) {\n                kaesu DecodeError { kind: DecodeErrorKind.InvalidFunction(), offset: offset, detail: first };\n            }\n            moshi (opcode == 46) {\n                // A capture-free closure may be constructed at module scope.\n                // Only actual captures require an enclosing function frame.\n                moshi (function_index < 0 && len(file.functions[first].captures) != 0) { kaesu DecodeError { kind: DecodeErrorKind.InvalidFunction(), offset: offset, detail: first }; }\n                kaku capture_index = 0;\n                aida (capture_index < len(file.functions[first].captures)) {\n                    kaku capture = file.functions[first].captures[capture_index];\n                    kaku limit = len(file.functions[function_index].captures);\n                    moshi (capture.local) { limit = file.functions[function_index].local_count; }\n                    moshi (capture.index >= limit) { kaesu DecodeError { kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: capture.index }; }\n                    capture_index = capture_index + 1;\n                }\n            }\n        }\n        moshi (opcode == 47 || opcode == 48) {\n            moshi (function_index < 0 || first >= len(file.functions[function_index].captures)) {\n                kaesu DecodeError { kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: first };\n            }\n        }\n        moshi (opcode == 26 || opcode == 27) {\n            moshi (function_index < 0) { kaesu DecodeError { kind: DecodeErrorKind.InvalidFunction(), offset: offset, detail: opcode }; }\n            moshi ((opcode == 26 && file.functions[function_index].returns_value) ||\n                (opcode == 27 && !file.functions[function_index].returns_value)) {\n                kaesu DecodeError { kind: DecodeErrorKind.InvalidFunction(), offset: offset, detail: opcode };\n            }\n        }\n        moshi (opcode == 54) {\n            moshi (first < 1 || first > 13) { kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: first }; }\n            kaku expected = 1; moshi (first == 10) { expected = 2; }\n            moshi (second != expected) { kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: second }; }\n        }\n        moshi (opcode == 55 && (first < 1 || first > 7)) { kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: first }; }\n        moshi (opcode == 65 && (first < 1 || first > 2)) { kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: first }; }\n        moshi (opcode == 56 && !valid_descriptor(second)) { kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: second }; }\n        moshi ((opcode == 57 || opcode == 58) && !valid_descriptor(first)) { kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: first }; }\n        moshi (opcode == 17 || opcode == 18) { array.push(jump_offsets, offset); array.push(jump_targets, first); }\n        offset = offset + width;\n    }\n    kaku index = 0;\n    aida (index < len(jump_targets)) {\n        kaku target = jump_targets[index];\n        moshi (target > len(data) || !boundaries[target]) {\n            kaesu DecodeError { kind: DecodeErrorKind.InvalidJump(), offset: jump_offsets[index], detail: target };\n        }\n        index = index + 1;\n    }\n    kaesu mu;\n}\n\nwaza read_constant(input: binary.BinaryReader, version: int64) -> DecodeResult {\n    kaku tag_offset = binary.reader_offset(input);\n    kaku tag_result = binary.reader_read_u8(input);\n    moshi (tag_result.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), tag_offset, 1); }\n    kaku tag = tag_result.value;\n    moshi (tag == uint8(1) || tag == uint8(3)) {\n        moshi (tag == uint8(3) && version < 3) { kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag)); }\n        kaku wide = binary.reader_read_u64_be(input);\n        moshi (wide.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 8); }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: wide.value, data: [] });\n        kaesu DecodeResult { value: File { version: version, constants: constants, global_count: 0,\n            instructions: [], functions: [] }, error: mu };\n    }\n    moshi (tag == uint8(2)) {\n        kaku length_at = binary.reader_offset(input);\n        kaku length = binary.reader_read_u32_be(input);\n        moshi (length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), length_at, 4); }\n        moshi (int64(length.value) > MAX_STRING_BYTES) { kaesu failure(DecodeErrorKind.LimitExceeded(), length_at, int64(length.value)); }\n        kaku bytes_result = binary.reader_read_bytes(input, int64(length.value));\n        moshi (bytes_result.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), int64(length.value)); }\n        moshi (!utf8.valid(bytes_result.data)) { kaesu failure(DecodeErrorKind.InvalidUtf8(), length_at + 4, int64(length.value)); }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: binary.U64 { high: uint32(0), low: uint32(0) }, data: bytes_result.data });\n        kaesu DecodeResult { value: File { version: version, constants: constants, global_count: 0,\n            instructions: [], functions: [] }, error: mu };\n    }\n    moshi (tag == uint8(4)) {\n        moshi (version < 10) { kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag)); }\n        kaku raw = binary.reader_read_u32_be(input); moshi (raw.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 4); }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: binary.U64 { high: uint32(0), low: raw.value }, data: [] });\n        kaesu DecodeResult { value: File { version: version, constants: constants, global_count: 0, instructions: [], functions: [] }, error: mu };\n    }\n    moshi (tag == uint8(5) || tag == uint8(8)) {\n        moshi (version < 11) { kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag)); }\n        kaku raw = binary.reader_read_u8(input); moshi (raw.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 1); }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: binary.U64 { high: uint32(0), low: uint32(raw.value) }, data: [] });\n        kaesu DecodeResult { value: File { version: version, constants: constants, global_count: 0, instructions: [], functions: [] }, error: mu };\n    }\n    moshi (tag == uint8(6) || tag == uint8(9)) {\n        moshi (version < 11) { kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag)); }\n        kaku raw = binary.reader_read_u16_be(input); moshi (raw.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 2); }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: binary.U64 { high: uint32(0), low: uint32(raw.value) }, data: [] });\n        kaesu DecodeResult { value: File { version: version, constants: constants, global_count: 0, instructions: [], functions: [] }, error: mu };\n    }\n    moshi (tag == uint8(7) || tag == uint8(10)) {\n        moshi (version < 11) { kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag)); }\n        kaku raw = binary.reader_read_u32_be(input); moshi (raw.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 4); }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: binary.U64 { high: uint32(0), low: raw.value }, data: [] });\n        kaesu DecodeResult { value: File { version: version, constants: constants, global_count: 0, instructions: [], functions: [] }, error: mu };\n    }\n    kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag));\n}\n\nkoukai waza decode(data: []uint8) -> DecodeResult {\n    moshi (len(data) > MAX_FILE_SIZE) { kaesu failure(DecodeErrorKind.LimitExceeded(), 0, len(data)); }\n    kaku input = binary.reader(data);\n    kaku magic = binary.reader_read_bytes(input, 5);\n    moshi (magic.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), 0, 5); }\n    moshi (magic.data[0] != uint8(77) || magic.data[1] != uint8(79) || magic.data[2] != uint8(67) || magic.data[3] != uint8(72) || magic.data[4] != uint8(73)) {\n        kaesu failure(DecodeErrorKind.InvalidMagic(), 0, 0);\n    }\n    kaku version_result = binary.reader_read_u16_be(input);\n    moshi (version_result.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), 5, 2); }\n    kaku version = int64(version_result.value);\n    moshi (version < 1 || version > VERSION) { kaesu failure(DecodeErrorKind.UnsupportedVersion(), 5, version); }\n    kaku count_at = binary.reader_offset(input);\n    kaku constant_count = binary.reader_read_u32_be(input);\n    moshi (constant_count.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), count_at, 4); }\n    moshi (int64(constant_count.value) > MAX_CONSTANTS) { kaesu failure(DecodeErrorKind.LimitExceeded(), count_at, int64(constant_count.value)); }\n    kaku constants = array.with_capacity[Constant](int64(constant_count.value));\n    kaku index = 0;\n    aida (index < int64(constant_count.value)) {\n        kaku decoded = read_constant(input, version);\n        kaku decoded_error = decoded.error;\n        moshi (decoded_error != mu) { kaesu DecodeResult { value: mu, error: decoded_error }; }\n        kaku part = decoded.value;\n        moshi (part != mu) { array.push(constants, part.constants[0]); }\n        sore { kaesu failure(DecodeErrorKind.InvalidConstant(), binary.reader_offset(input), index); }\n        index = index + 1;\n    }\n    kaku globals_at = binary.reader_offset(input);\n    kaku globals = binary.reader_read_u32_be(input);\n    moshi (globals.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), globals_at, 4); }\n    moshi (int64(globals.value) > MAX_GLOBALS) { kaesu failure(DecodeErrorKind.LimitExceeded(), globals_at, int64(globals.value)); }\n    kaku instructions_at = binary.reader_offset(input);\n    kaku instruction_length = binary.reader_read_u32_be(input);\n    moshi (instruction_length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), instructions_at, 4); }\n    moshi (int64(instruction_length.value) > MAX_INSTRUCTION_BYTES) { kaesu failure(DecodeErrorKind.LimitExceeded(), instructions_at, int64(instruction_length.value)); }\n    kaku instruction_data = binary.reader_read_bytes(input, int64(instruction_length.value));\n    moshi (instruction_data.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), int64(instruction_length.value)); }\n    kaku functions = array.with_capacity[Function](0);\n    moshi (version >= 2) {\n        kaku functions_at = binary.reader_offset(input);\n        kaku function_count = binary.reader_read_u32_be(input);\n        moshi (function_count.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), functions_at, 4); }\n        moshi (int64(function_count.value) > MAX_FUNCTIONS) { kaesu failure(DecodeErrorKind.LimitExceeded(), functions_at, int64(function_count.value)); }\n        functions = array.with_capacity[Function](int64(function_count.value));\n        index = 0;\n        aida (index < int64(function_count.value)) {\n            kaku function_at = binary.reader_offset(input);\n            kaku id = binary.reader_read_u16_be(input);\n            kaku name_length = binary.reader_read_u16_be(input);\n            moshi (id.error != mu || name_length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), function_at, 4); }\n            moshi (int64(id.value) != index) { kaesu failure(DecodeErrorKind.InvalidFunction(), function_at, int64(id.value)); }\n            kaku name_data = binary.reader_read_bytes(input, int64(name_length.value));\n            moshi (name_data.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), int64(name_length.value)); }\n            moshi (len(name_data.data) == 0) { kaesu failure(DecodeErrorKind.InvalidFunction(), function_at + 4, 0); }\n            moshi (!utf8.valid(name_data.data)) { kaesu failure(DecodeErrorKind.InvalidUtf8(), function_at + 4, len(name_data.data)); }\n            kaku name = string.from_utf8(name_data.data);\n            moshi (name == mu) { kaesu failure(DecodeErrorKind.InvalidUtf8(), function_at + 4, len(name_data.data)); }\n            kaku parameter_at = binary.reader_offset(input);\n            kaku parameters = binary.reader_read_u32_be(input);\n            kaku locals = binary.reader_read_u32_be(input);\n            kaku flags = binary.reader_read_u8(input);\n            moshi (parameters.error != mu || locals.error != mu || flags.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), parameter_at, 9); }\n            moshi (int64(parameters.value) > MAX_FUNCTION_SLOTS || int64(locals.value) < int64(parameters.value) || int64(locals.value) > MAX_FUNCTION_SLOTS || flags.value > uint8(1)) {\n                kaesu failure(DecodeErrorKind.InvalidFunction(), parameter_at, index);\n            }\n            kaku captures = array.with_capacity[Capture](0);\n            moshi (version >= 9) {\n                kaku capture_at = binary.reader_offset(input);\n                kaku capture_count = binary.reader_read_u32_be(input);\n                moshi (capture_count.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), capture_at, 4); }\n                moshi (int64(capture_count.value) > MAX_FUNCTION_SLOTS) { kaesu failure(DecodeErrorKind.LimitExceeded(), capture_at, int64(capture_count.value)); }\n                captures = array.with_capacity[Capture](int64(capture_count.value));\n                kaku capture_index = 0;\n                aida (capture_index < int64(capture_count.value)) {\n                    kaku source = binary.reader_read_u8(input);\n                    kaku capture_slot = binary.reader_read_u32_be(input);\n                    moshi (source.error != mu || capture_slot.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 5); }\n                    moshi (source.value > uint8(1) || int64(capture_slot.value) >= MAX_FUNCTION_SLOTS) { kaesu failure(DecodeErrorKind.InvalidFunction(), capture_at, capture_index); }\n                    array.push(captures, Capture { local: source.value == uint8(1), index: int64(capture_slot.value) });\n                    capture_index = capture_index + 1;\n                }\n            }\n            kaku length_at = binary.reader_offset(input);\n            kaku length = binary.reader_read_u32_be(input);\n            moshi (length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), length_at, 4); }\n            moshi (int64(length.value) > MAX_INSTRUCTION_BYTES) { kaesu failure(DecodeErrorKind.LimitExceeded(), length_at, int64(length.value)); }\n            kaku body = binary.reader_read_bytes(input, int64(length.value));\n            moshi (body.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), int64(length.value)); }\n            array.push(functions, Function { id: int64(id.value), name: name, name_bytes: name_data.data,\n                parameter_count: int64(parameters.value), local_count: int64(locals.value), returns_value: flags.value == uint8(1),\n                captures: captures, instructions: body.data });\n            index = index + 1;\n        }\n    }\n    moshi (!binary.reader_eof(input)) { kaesu failure(DecodeErrorKind.TrailingData(), binary.reader_offset(input), binary.reader_remaining(input)); }\n    kaku file = File { version: version, constants: constants, global_count: int64(globals.value),\n        instructions: instruction_data.data, functions: functions };\n    kaku validation = validate_instructions(file, file.instructions, -1);\n    moshi (validation != mu) { kaesu DecodeResult { value: mu, error: validation }; }\n    index = 0;\n    aida (index < len(file.functions)) {\n        validation = validate_instructions(file, file.functions[index].instructions, index);\n        moshi (validation != mu) { kaesu DecodeResult { value: mu, error: validation }; }\n        index = index + 1;\n    }\n    kaesu DecodeResult { value: file, error: mu };\n}\n\nkoukai waza error_code(error: DecodeError) -> int64 {\n    awase (error.kind) {\n        baai Truncated { kaesu 1; } baai InvalidMagic { kaesu 2; } baai UnsupportedVersion { kaesu 3; }\n        baai LimitExceeded { kaesu 4; } baai InvalidConstant { kaesu 5; } baai InvalidUtf8 { kaesu 6; }\n        baai InvalidFunction { kaesu 7; } baai InvalidInstruction { kaesu 8; } baai InvalidIndex { kaesu 9; }\n        baai InvalidJump { kaesu 10; } baai TrailingData { kaesu 11; } baai IoFailure { kaesu 12; }\n    }\n    kaesu 0;\n}\n" }; }
waza data_25() -> File { kaesu File { path: "kiso/encoding/mochi/encode.mio", version: "Bunko-GF3-v0.2", length: 3613, sha256: "754e2241e08a97da95bd3809e8ef30ff956b7f599178e77ba6e5f5e853961867", source: "yobu \"kiso/encoding/binary\";\n\nwaza write_constant(output: binary.BinaryWriter, value: Constant) -> unit {\n    binary.writer_write_u8(output, value.tag);\n    moshi (value.tag == uint8(1) || value.tag == uint8(3)) { binary.writer_write_u64_be(output, value.bits); kaesu; }\n    moshi (value.tag == uint8(2)) { binary.writer_write_length_prefixed(output, value.data); kaesu; }\n    moshi (value.tag == uint8(4) || value.tag == uint8(7) || value.tag == uint8(10)) { binary.writer_write_u32_be(output, value.bits.low); kaesu; }\n    moshi (value.tag == uint8(6) || value.tag == uint8(9)) { binary.writer_write_u16_be(output, uint16(value.bits.low)); kaesu; }\n    binary.writer_write_u8(output, uint8(value.bits.low));\n}\n\n// canonical_bytes deterministically serializes every decoded field.  For a valid\n// Mochi file this is a structural normalization, not a copy of the input buffer.\nkoukai waza canonical_bytes(value: File) -> []uint8 {\n    kaku output = binary.writer(MAX_FILE_SIZE);\n    binary.writer_write_bytes(output, [77, 79, 67, 72, 73]);\n    binary.writer_write_u16_be(output, uint16(value.version));\n    binary.writer_write_u32_be(output, uint32(len(value.constants)));\n    kaku index = 0;\n    aida (index < len(value.constants)) { write_constant(output, value.constants[index]); index = index + 1; }\n    binary.writer_write_u32_be(output, uint32(value.global_count));\n    binary.writer_write_length_prefixed(output, value.instructions);\n    moshi (value.version >= 2) {\n        binary.writer_write_u32_be(output, uint32(len(value.functions)));\n        index = 0;\n        aida (index < len(value.functions)) {\n            kaku function = value.functions[index];\n            binary.writer_write_u16_be(output, uint16(function.id));\n            binary.writer_write_u16_be(output, uint16(len(function.name_bytes)));\n            binary.writer_write_bytes(output, function.name_bytes);\n            binary.writer_write_u32_be(output, uint32(function.parameter_count));\n            binary.writer_write_u32_be(output, uint32(function.local_count));\n            kaku flags = uint8(0); moshi (function.returns_value) { flags = uint8(1); }\n            binary.writer_write_u8(output, flags);\n            moshi (value.version >= 9) {\n                binary.writer_write_u32_be(output, uint32(len(function.captures)));\n                kaku capture_index = 0;\n                aida (capture_index < len(function.captures)) {\n                    kaku source = uint8(0); moshi (function.captures[capture_index].local) { source = uint8(1); }\n                    binary.writer_write_u8(output, source);\n                    binary.writer_write_u32_be(output, uint32(function.captures[capture_index].index));\n                    capture_index = capture_index + 1;\n                }\n            }\n            binary.writer_write_length_prefixed(output, function.instructions);\n            index = index + 1;\n        }\n    }\n    kaesu binary.writer_bytes(output);\n}\n\nkoukai kata Summary {\n    version: int64;\n    constants: int64;\n    functions: int64;\n    globals: int64;\n    instruction_bytes: int64;\n    canonical_size: int64;\n}\n\nkoukai waza summarize(value: File) -> Summary {\n    kaku instruction_bytes = len(value.instructions);\n    kaku index = 0;\n    aida (index < len(value.functions)) { instruction_bytes = instruction_bytes + len(value.functions[index].instructions); index = index + 1; }\n    kaesu Summary { version: value.version, constants: len(value.constants), functions: len(value.functions),\n        globals: value.global_count, instruction_bytes: instruction_bytes, canonical_size: len(canonical_bytes(value)) };\n}\n" }; }
waza data_26() -> File { kaesu File { path: "kiso/encoding/mochi/file.mio", version: "Bunko-GF3-v0.2", length: 1429, sha256: "d30815c4c97ed744552f5d705e4313875b087428df8546608f97fe63b5835ed1", source: "yobu \"kiso/array\";\nyobu \"kiso/fs\";\n\n// decode_file enforces the Mochi file ceiling while reading, before an attacker-\n// controlled file can cause an unbounded destination allocation.\nkoukai waza decode_file(path: string) -> DecodeResult {\n    kaku opened = fs.open_read(path);\n    kaku open_error = opened.error;\n    moshi (open_error != mu) { kaesu failure(DecodeErrorKind.IoFailure(), 0, 0); }\n    kaku file = opened.file;\n    moshi (file == mu) { kaesu failure(DecodeErrorKind.IoFailure(), 0, 0); }\n    kaku output = array.with_capacity[uint8](32768);\n    kaku buffer = array.make[uint8](32768, uint8(0));\n    aida (hai) {\n        kaku result = fs.read(file, buffer, 0, len(buffer));\n        kaku read_error = result.error;\n        moshi (read_error != mu) { fs.close(file); kaesu failure(DecodeErrorKind.IoFailure(), len(output), 0); }\n        moshi (result.count > MAX_FILE_SIZE - len(output)) { fs.close(file); kaesu failure(DecodeErrorKind.LimitExceeded(), len(output), result.count); }\n        kaku index = 0;\n        aida (index < result.count) { array.push(output, buffer[index]); index = index + 1; }\n        moshi (result.eof) { nukeru; }\n        moshi (result.count == 0) { fs.close(file); kaesu failure(DecodeErrorKind.IoFailure(), len(output), 0); }\n    }\n    kaku closed = fs.close(file);\n    moshi (closed.error != mu) { kaesu failure(DecodeErrorKind.IoFailure(), len(output), 0); }\n    kaesu decode(output);\n}\n" }; }
waza data_27() -> File { kaesu File { path: "kiso/fs/fs.mio", version: "Bunko-GF3-v0.2", length: 11060, sha256: "50d8e1cf5aa2fbbd30fd67df5a1a0aa654275e5359d74aa70e4442c6656ed775", source: "yobu \"kiso/array\";\nyobu \"kiso/io\";\nyobu \"mio/fs/runtime\";\n\nkoukai sentaku FsError {\n    NotFound(string);\n    PermissionDenied(string);\n    Closed(string);\n    InvalidArgument(string);\n    NoSpace(string);\n    InvalidPath(string);\n    IOFailure(string);\n}\n\nkoukai kata File { handle: resource; }\nkoukai kata FileResult { file: File?; error: FsError?; }\nkoukai kata ReadAllResult { data: []uint8; error: FsError?; }\nkoukai kata UnitResult { error: FsError?; }\nkoukai kata StatResult { exists: bool; is_file: bool; is_dir: bool; error: FsError?; }\nkoukai kata DirEntry { name: string; is_file: bool; is_dir: bool; }\nkoukai kata DirResult { entries: []DirEntry; error: FsError?; }\n\nwaza error_from(code: uint8, message: string) -> FsError? {\n    moshi (code == uint8(0)) { kaesu mu; }\n    moshi (code == uint8(1)) { kaesu FsError.NotFound(message); }\n    moshi (code == uint8(2)) { kaesu FsError.PermissionDenied(message); }\n    moshi (code == uint8(3)) { kaesu FsError.Closed(message); }\n    moshi (code == uint8(4)) { kaesu FsError.InvalidArgument(message); }\n    moshi (code == uint8(6)) { kaesu FsError.NoSpace(message); }\n    moshi (code == uint8(7)) { kaesu FsError.InvalidPath(message); }\n    kaesu FsError.IOFailure(message);\n}\n\nwaza decode_count(status: []uint8) -> int64 {\n    kaku result = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 8) {\n        result = result + int64(status[index]) * factor;\n        factor = factor * 256;\n        index = index + 1;\n    }\n    kaesu result;\n}\n\nwaza open_mode(path: string, mode: int64) -> FileResult {\n    kaku handle = runtime.open(path, mode);\n    kaku status: []uint8 = [0];\n    kaku message = runtime.file_status(handle, status);\n    kaku open_error = error_from(status[0], message);\n    moshi (open_error != mu) {\n        kaku close_status: []uint8 = [0];\n        runtime.close(handle, close_status);\n        kaesu FileResult { file: mu, error: open_error };\n    }\n    kaesu FileResult { file: File { handle: handle }, error: mu };\n}\n\nkoukai waza open_read(path: string) -> FileResult { kaesu open_mode(path, 0); }\nkoukai waza open_write(path: string) -> FileResult { kaesu open_mode(path, 1); }\nkoukai waza open_append(path: string) -> FileResult { kaesu open_mode(path, 2); }\n\nkoukai waza read(file: File, destination: []uint8, offset: int64, length: int64) -> io.ReadResult {\n    moshi (offset < 0 || length < 0 || offset > len(destination) || length > len(destination) - offset) {\n        kaesu io.ReadResult { count: 0, eof: iie, error: io.IoError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = runtime.read(file.handle, destination, offset, length, status);\n    kaku failure = error_from(status[9], message);\n    moshi (failure == mu) {\n        kaesu io.ReadResult { count: decode_count(status), eof: status[8] != uint8(0), error: mu };\n    }\n    awase (failure) {\n        baai Closed(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Closed() }; }\n        baai InvalidArgument(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.InvalidArgument() }; }\n        baai IOFailure(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai NotFound(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai PermissionDenied(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai NoSpace(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai InvalidPath(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n    }\n    kaesu io.ReadResult { count: 0, eof: iie, error: io.IoError.Other(message) };\n}\n\nkoukai waza write(file: File, source: []uint8, offset: int64, length: int64) -> io.WriteResult {\n    moshi (offset < 0 || length < 0 || offset > len(source) || length > len(source) - offset) {\n        kaesu io.WriteResult { count: 0, error: io.IoError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = runtime.write(file.handle, source, offset, length, status);\n    kaku failure = error_from(status[9], message);\n    moshi (failure == mu) { kaesu io.WriteResult { count: decode_count(status), error: mu }; }\n    awase (failure) {\n        baai Closed(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Closed() }; }\n        baai InvalidArgument(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.InvalidArgument() }; }\n        baai IOFailure(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai NotFound(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai PermissionDenied(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai NoSpace(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai InvalidPath(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n    }\n    kaesu io.WriteResult { count: 0, error: io.IoError.Other(message) };\n}\n\nkoukai waza close(file: File) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = runtime.close(file.handle, status);\n    kaesu UnitResult { error: error_from(status[0], message) };\n}\n\nkoukai waza reader(file: File) -> io.Reader {\n    kaesu io.Reader { read: waza (destination: []uint8, offset: int64, length: int64) -> io.ReadResult {\n        kaesu read(file, destination, offset, length);\n    } };\n}\n\nkoukai waza writer(file: File) -> io.Writer {\n    kaesu io.Writer { write: waza (source: []uint8, offset: int64, length: int64) -> io.WriteResult {\n        kaesu write(file, source, offset, length);\n    } };\n}\n\nkoukai waza read_all(path: string) -> ReadAllResult {\n    kaku opened = open_read(path);\n    kaku open_error = opened.error;\n    moshi (open_error != mu) { kaesu ReadAllResult { data: [], error: open_error }; }\n    kaku file = opened.file;\n    moshi (file == mu) { kaesu ReadAllResult { data: [], error: FsError.IOFailure(\"missing file handle\") }; }\n    kaku output = array.with_capacity[uint8](32768);\n    kaku buffer = array.make[uint8](32768, uint8(0));\n    aida (hai) {\n        kaku result = read(file, buffer, 0, len(buffer));\n        kaku index = 0;\n        aida (index < result.count) {\n            array.push(output, buffer[index]);\n            index = index + 1;\n        }\n        kaku read_error = result.error;\n        moshi (read_error != mu) {\n            close(file);\n            awase (read_error) {\n                baai Closed { kaesu ReadAllResult { data: output, error: FsError.Closed(\"file is closed\") }; }\n                baai InvalidArgument { kaesu ReadAllResult { data: output, error: FsError.InvalidArgument(\"invalid read range\") }; }\n                baai NoProgress { kaesu ReadAllResult { data: output, error: FsError.IOFailure(\"read made no progress\") }; }\n                baai UnexpectedEOF { kaesu ReadAllResult { data: output, error: FsError.IOFailure(\"unexpected EOF\") }; }\n                baai Other(message) { kaesu ReadAllResult { data: output, error: FsError.IOFailure(message) }; }\n            }\n        }\n        moshi (result.eof) { nukeru; }\n        moshi (result.count == 0) {\n            close(file);\n            kaesu ReadAllResult { data: output, error: FsError.IOFailure(\"read made no progress\") };\n        }\n    }\n    kaku closed = close(file);\n    kaesu ReadAllResult { data: output, error: closed.error };\n}\n\nkoukai waza write_all(path: string, data: []uint8) -> UnitResult {\n    kaku opened = open_write(path);\n    kaku open_error = opened.error;\n    moshi (open_error != mu) { kaesu UnitResult { error: open_error }; }\n    kaku file = opened.file;\n    moshi (file == mu) { kaesu UnitResult { error: FsError.IOFailure(\"missing file handle\") }; }\n    kaku result = io.write_all(writer(file), data, 0, len(data));\n    kaku write_error = result.error;\n    kaku closed = close(file);\n    moshi (write_error != mu) {\n        awase (write_error) {\n            baai Closed { kaesu UnitResult { error: FsError.Closed(\"file is closed\") }; }\n            baai InvalidArgument { kaesu UnitResult { error: FsError.InvalidArgument(\"invalid write range\") }; }\n            baai NoProgress { kaesu UnitResult { error: FsError.IOFailure(\"write made no progress\") }; }\n            baai UnexpectedEOF { kaesu UnitResult { error: FsError.IOFailure(\"unexpected EOF\") }; }\n            baai Other(message) { kaesu UnitResult { error: FsError.IOFailure(message) }; }\n        }\n    }\n    kaesu closed;\n}\n\nkoukai waza stat(path: string) -> StatResult {\n    kaku status: []uint8 = [0, 0];\n    kaku message = runtime.stat(path, status);\n    kaku stat_error = error_from(status[1], message);\n    moshi (status[1] == uint8(1)) {\n        kaesu StatResult { exists: iie, is_file: iie, is_dir: iie, error: mu };\n    }\n    kaesu StatResult { exists: stat_error == mu, is_file: status[0] == uint8(1), is_dir: status[0] == uint8(2), error: stat_error };\n}\n\nkoukai waza exists(path: string) -> bool { kaesu stat(path).exists; }\nkoukai waza is_file(path: string) -> bool { kaesu stat(path).is_file; }\nkoukai waza is_dir(path: string) -> bool { kaesu stat(path).is_dir; }\n\nkoukai waza create_dir(path: string) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = runtime.mkdir(path, status);\n    kaesu UnitResult { error: error_from(status[0], message) };\n}\n\nkoukai waza read_dir(path: string) -> DirResult {\n    kaku iterator = runtime.open_dir(path);\n    kaku status: []uint8 = [0];\n    kaku message = runtime.dir_status(iterator, status);\n    kaku directory_error = error_from(status[0], message);\n    kaku entries = array.with_capacity[DirEntry](0);\n    moshi (directory_error != mu) {\n        runtime.dir_close(iterator, status);\n        kaesu DirResult { entries: entries, error: directory_error };\n    }\n    aida (runtime.dir_next(iterator)) {\n        kaku directory = runtime.dir_is_dir(iterator);\n        array.push(entries, DirEntry { name: runtime.dir_name(iterator), is_file: runtime.dir_is_file(iterator), is_dir: directory });\n    }\n    message = runtime.dir_status(iterator, status);\n    directory_error = error_from(status[0], message);\n    message = runtime.dir_close(iterator, status);\n    moshi (directory_error == mu) { directory_error = error_from(status[0], message); }\n    kaesu DirResult { entries: entries, error: directory_error };\n}\n\n// Optional third status byte extends the existing NativeFS stat protocol.\n// The original existence/file/directory and error bytes remain unchanged.\nkoukai waza is_character_device(path: string) -> bool {\n    kaku status: []uint8=[0,0,0];runtime.stat(path,status);\n    kaesu status[1]==uint8(0) && status[2]==uint8(1);\n}\n" }; }
waza data_28() -> File { kaesu File { path: "kiso/io/io.mio", version: "Bunko-GF3-v0.2", length: 5935, sha256: "68e0e56e765a262092db578cd9dfaf25c40271d0b3489af6abff18609e9ace67", source: "yobu \"kiso/array\";\nyobu \"kiso/bytes\";\n\nkoukai sentaku IoError {\n    Closed;\n    InvalidArgument;\n    NoProgress;\n    UnexpectedEOF;\n    Other(string);\n}\n\nkoukai kata ReadResult { count: int64; eof: bool; error: IoError?; }\nkoukai kata WriteResult { count: int64; error: IoError?; }\nkoukai kata CopyResult { count: int64; error: IoError?; }\n\nkoukai kata Reader { read: ([]uint8, int64, int64) -> ReadResult; }\nkoukai kata Writer { write: ([]uint8, int64, int64) -> WriteResult; }\n\nwaza valid_range(values: []uint8, offset: int64, length: int64) -> bool {\n    kaesu offset >= 0 && length >= 0 && offset <= len(values) && length <= len(values) - offset;\n}\n\nkoukai waza read(reader: Reader, destination: []uint8, offset: int64, length: int64) -> ReadResult {\n    moshi (!valid_range(destination, offset, length)) {\n        kaesu ReadResult { count: 0, eof: iie, error: IoError.InvalidArgument() };\n    }\n    kaesu reader.read(destination, offset, length);\n}\n\nkoukai waza write(writer: Writer, source: []uint8, offset: int64, length: int64) -> WriteResult {\n    moshi (!valid_range(source, offset, length)) {\n        kaesu WriteResult { count: 0, error: IoError.InvalidArgument() };\n    }\n    kaesu writer.write(source, offset, length);\n}\n\nkoukai waza read_full(reader: Reader, destination: []uint8, offset: int64, length: int64) -> ReadResult {\n    moshi (!valid_range(destination, offset, length)) {\n        kaesu ReadResult { count: 0, eof: iie, error: IoError.InvalidArgument() };\n    }\n    kaku total = 0;\n    aida (total < length) {\n        kaku result = reader.read(destination, offset + total, length - total);\n        moshi (result.count < 0 || result.count > length - total) {\n            kaesu ReadResult { count: total, eof: iie, error: IoError.InvalidArgument() };\n        }\n        total = total + result.count;\n        kaku read_error = result.error;\n        moshi (read_error != mu) {\n            kaesu ReadResult { count: total, eof: result.eof, error: result.error };\n        }\n        moshi (total == length) {\n            kaesu ReadResult { count: total, eof: result.eof, error: mu };\n        }\n        moshi (result.eof) {\n            kaesu ReadResult { count: total, eof: hai, error: IoError.UnexpectedEOF() };\n        }\n        moshi (result.count == 0) {\n            kaesu ReadResult { count: total, eof: iie, error: IoError.NoProgress() };\n        }\n    }\n    kaesu ReadResult { count: total, eof: iie, error: mu };\n}\n\nkoukai waza write_all(writer: Writer, source: []uint8, offset: int64, length: int64) -> WriteResult {\n    moshi (!valid_range(source, offset, length)) {\n        kaesu WriteResult { count: 0, error: IoError.InvalidArgument() };\n    }\n    kaku total = 0;\n    aida (total < length) {\n        kaku result = writer.write(source, offset + total, length - total);\n        moshi (result.count < 0 || result.count > length - total) {\n            kaesu WriteResult { count: total, error: IoError.InvalidArgument() };\n        }\n        total = total + result.count;\n        kaku write_error = result.error;\n        moshi (write_error != mu) {\n            kaesu WriteResult { count: total, error: result.error };\n        }\n        moshi (result.count == 0) {\n            kaesu WriteResult { count: total, error: IoError.NoProgress() };\n        }\n    }\n    kaesu WriteResult { count: total, error: mu };\n}\n\nkoukai waza copy_stream(reader: Reader, writer: Writer) -> CopyResult {\n    kaku buffer = array.make[uint8](32768, uint8(0));\n    kaku total = 0;\n    aida (hai) {\n        kaku read_result = reader.read(buffer, 0, len(buffer));\n        moshi (read_result.count < 0 || read_result.count > len(buffer)) {\n            kaesu CopyResult { count: total, error: IoError.InvalidArgument() };\n        }\n        moshi (read_result.count > 0) {\n            kaku write_result = write_all(writer, buffer, 0, read_result.count);\n            total = total + write_result.count;\n            kaku stream_write_error = write_result.error;\n            moshi (stream_write_error != mu) {\n                kaesu CopyResult { count: total, error: write_result.error };\n            }\n        }\n        kaku stream_read_error = read_result.error;\n        moshi (stream_read_error != mu) {\n            kaesu CopyResult { count: total, error: read_result.error };\n        }\n        moshi (read_result.eof) {\n            kaesu CopyResult { count: total, error: mu };\n        }\n        moshi (read_result.count == 0) {\n            kaesu CopyResult { count: total, error: IoError.NoProgress() };\n        }\n    }\n    kaesu CopyResult { count: total, error: mu };\n}\n\nkoukai waza reader_from_bytes(source: []uint8) -> Reader {\n    kaku position = 0;\n    kaesu Reader { read: waza (destination: []uint8, offset: int64, length: int64) -> ReadResult {\n        moshi (!valid_range(destination, offset, length)) {\n            kaesu ReadResult { count: 0, eof: iie, error: IoError.InvalidArgument() };\n        }\n        moshi (position > len(source)) { position = len(source); }\n        kaku remaining = len(source) - position;\n        kaku count = length;\n        moshi (remaining < count) { count = remaining; }\n        kaku index = 0;\n        aida (index < count) {\n            destination[offset + index] = source[position + index];\n            index = index + 1;\n        }\n        position = position + count;\n        kaesu ReadResult { count: count, eof: position == len(source), error: mu };\n    } };\n}\n\nkoukai waza writer_to_buffer(buffer: bytes.ByteBuffer) -> Writer {\n    kaesu Writer { write: waza (source: []uint8, offset: int64, length: int64) -> WriteResult {\n        moshi (!valid_range(source, offset, length)) {\n            kaesu WriteResult { count: 0, error: IoError.InvalidArgument() };\n        }\n        kaku index = 0;\n        aida (index < length) {\n            array.push(buffer.data, source[offset + index]);\n            index = index + 1;\n        }\n        kaesu WriteResult { count: length, error: mu };\n    } };\n}\n" }; }
waza data_29() -> File { kaesu File { path: "kiso/math/compare.mio", version: "Bunko-GF3-v0.2", length: 1176, sha256: "7cadb689838a1fcf48bb31ec69a52d683482706e7fde1c94bd2820590412b27e", source: "koukai waza min<T: Number>(left: T, right: T) -> T {\n    moshi (left != left) { kaesu left; }\n    moshi (right != right) { kaesu right; }\n    moshi (left < right) { kaesu left; }\n    moshi (right < left) { kaesu right; }\n    moshi (__is_negative(left)) { kaesu left; }\n    kaesu right;\n}\n\nkoukai waza max<T: Number>(left: T, right: T) -> T {\n    moshi (left != left) { kaesu left; }\n    moshi (right != right) { kaesu right; }\n    moshi (left > right) { kaesu left; }\n    moshi (right > left) { kaesu right; }\n    moshi (__is_negative(left)) { kaesu right; }\n    kaesu left;\n}\n\nkoukai waza checked_abs<T: Signed>(value: T) -> T? {\n    moshi (__neg_overflows(value)) { kaesu mu; }\n    moshi (__is_negative(value)) { kaesu -value; }\n    kaesu value;\n}\n\nkoukai waza abs<T: Signed>(value: T) -> T {\n    kaku result: T? = checked_abs(value);\n    moshi (result != mu) { kaesu result; }\n    __math_error(\"kiso/math.abs: int64 overflow\");\n    kaesu value;\n}\n\nkoukai waza clamp<T: Number>(value: T, lower: T, upper: T) -> T {\n    moshi (lower > upper) {\n        __math_error(\"kiso/math.clamp: lower bound is greater than upper bound\");\n    }\n    kaesu min(max(value, lower), upper);\n}\n" }; }
waza data_30() -> File { kaesu File { path: "kiso/math/constants.mio", version: "Bunko-GF3-v0.2", length: 334, sha256: "e346e50367337bf9b32a3f4a2a814d05628945955302a3dae441c94b4b87dc02", source: "koukai teisu pi32: float32 = 3.14159265358979323846264338327950288419716939937510;\nkoukai teisu pi64: float64 = 3.14159265358979323846264338327950288419716939937510;\nkoukai teisu tau32: float32 = 6.28318530717958647692528676655900576839433879875021;\nkoukai teisu tau64: float64 = 6.28318530717958647692528676655900576839433879875021;\n" }; }
waza data_31() -> File { kaesu File { path: "kiso/math/fail.mio", version: "Bunko-GF3-v0.2", length: 230, sha256: "abaf8a60a2e150d5401bb30ce2c103c0a70e30bd2870e279e074ba3bb0cda888", source: "// Raise the existing checked runtime failure with a caller-supplied message.\n// Native tooling writes its structured diagnostic to stderr before this call.\nkoukai waza fail(message: string) -> unit {\n    __math_error(message);\n}\n" }; }
waza data_32() -> File { kaesu File { path: "kiso/math/float.mio", version: "Bunko-GF3-v0.2", length: 581, sha256: "e2e16c03416c7bea5e45a2deedea531afd05df6186a64fabeb40373fcfcdc5ab", source: "koukai waza sqrt<T: Float>(value: T) -> T { kaesu __sqrt(value); }\n\nkoukai waza floor<T: Float>(value: T) -> T { kaesu __floor(value); }\n\nkoukai waza ceil<T: Float>(value: T) -> T { kaesu __ceil(value); }\n\nkoukai waza round<T: Float>(value: T) -> T { kaesu __round_even(value); }\n\nkoukai waza trunc<T: Float>(value: T) -> T { kaesu __trunc(value); }\n\nkoukai waza is_nan<T: Float>(value: T) -> bool { kaesu __is_nan(value); }\n\nkoukai waza is_inf<T: Float>(value: T) -> bool { kaesu __is_inf(value); }\n\nkoukai waza is_finite<T: Float>(value: T) -> bool { kaesu __is_finite(value); }\n" }; }
waza data_33() -> File { kaesu File { path: "kiso/math/integer.mio", version: "Bunko-GF3-v0.2", length: 1408, sha256: "3e0b4bc2a8a3d6080d605e54c88fd03bc091feb410ff01d39358a28ef845e6bb", source: "koukai waza checked_gcd(left: int64, right: int64) -> int64? {\n    kaku a = left;\n    kaku b = right;\n    moshi (a > 0) { a = -a; }\n    moshi (b > 0) { b = -b; }\n    aida (b != 0) {\n        kaku remainder = a - (a / b) * b;\n        a = b;\n        b = remainder;\n    }\n    moshi (__neg_overflows(a)) { kaesu mu; }\n    kaesu -a;\n}\n\nkoukai waza gcd(left: int64, right: int64) -> int64 {\n    kaku result: int64? = checked_gcd(left, right);\n    moshi (result != mu) { kaesu result; }\n    __math_error(\"kiso/math.gcd: result does not fit int64\");\n    kaesu 0;\n}\n\nkoukai waza checked_lcm(left: int64, right: int64) -> int64? {\n    moshi (left == 0 || right == 0) { kaesu 0; }\n    kaku divisor: int64? = checked_gcd(left, right);\n    moshi (divisor != mu) {\n        kaku absolute_left: int64? = checked_abs(left);\n        moshi (absolute_left != mu) {\n            kaku absolute_right: int64? = checked_abs(right);\n            moshi (absolute_right != mu) {\n                kaku factor = absolute_left / divisor;\n                moshi (factor > 9223372036854775807 / absolute_right) { kaesu mu; }\n                kaesu factor * absolute_right;\n            }\n        }\n    }\n    kaesu mu;\n}\n\nkoukai waza lcm(left: int64, right: int64) -> int64 {\n    kaku result: int64? = checked_lcm(left, right);\n    moshi (result != mu) { kaesu result; }\n    __math_error(\"kiso/math.lcm: result does not fit int64\");\n    kaesu 0;\n}\n" }; }
waza data_34() -> File { kaesu File { path: "kiso/os/os.mio", version: "Bunko-GF3-v0.2", length: 3275, sha256: "89012103a88dc6ccb31ac64e353ae93fc236dffc13d6e84ec92c4f757e4afa25", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\nyobu \"kiso/math\";\nyobu \"mio/os/runtime\";\n\nkoukai waza argument(index: int64) -> string? {\n    kaku size = runtime.arg_size(index);\n    moshi (size < 0) { kaesu mu; }\n    kaku bytes = array.make[uint8](size, uint8(0));\n    moshi (runtime.arg_copy(index, bytes) != size) { kaesu mu; }\n    kaesu string.from_utf8(bytes);\n}\nkoukai waza arguments() -> []string {\n    kaku result: []string = []; kaku count = runtime.argc(); kaku index = 0;\n    aida (index < count) {\n        kaku value = argument(index); moshi (value == mu) { math.fail(\"invalid OS argument encoding\"); kaesu []; }\n        array.push(result, value); index = index + 1;\n    }\n    kaesu result;\n}\nkoukai waza chmod(path: string, mode: int64) -> int64 { kaesu runtime.chmod(path, mode); }\nkoukai waza exit(status: int64) -> unit { runtime.exit(status); }\n\n// Arguments include argv[0], matching the OS ABI. Negative values report a\n// system errno; spawned child exits and signals become shell-compatible codes.\nkoukai waza spawn(path: string, arguments: []string) -> int64 { kaesu runtime.spawn(path, arguments); }\nkoukai waza exec(path: string, arguments: []string) -> int64 { kaesu runtime.exec(path, arguments); }\nkoukai waza pid() -> int64 { kaesu runtime.pid(); }\nkoukai waza remove(path: string) -> int64 { kaesu runtime.remove(path); }\n\nkoukai waza remove_dir(path: string) -> int64 { kaesu runtime.rmdir(path); }\n\n// Test-only child isolation: capture stdout, stderr and assertion packets into\n// private files; the positive CPU and wall budgets terminate only the child process.\nkoukai waza spawn_test(path: string, arguments: []string, stdout: string, stderr: string, records: string, cpu_seconds: int64) -> int64 {\n    kaesu runtime.spawn_test(path, arguments, stdout, stderr, records, cpu_seconds);\n}\n\n// Milliseconds from the OS-accessible ARM64 virtual counter; not wall time.\nkoukai waza monotonic_ms() -> int64 { kaesu runtime.monotonic_ms(); }\n\n// Missing, malformed or non-UTF8 environment values return mu; an existing\n// empty value remains an empty string. No ambient compiler/Bunko path fallback.\nkoukai waza environment(name: string) -> string? {\n    kaku size=runtime.env_size(name);moshi(size<0){kaesu mu;}\n    kaku bytes=array.make[uint8](size,uint8(0));moshi(runtime.env_copy(name,bytes)!=size){kaesu mu;}kaesu string.from_utf8(bytes);\n}\nkoukai waza getenv(name: string) -> string { kaku value=environment(name);moshi(value==mu){kaesu \"\";}kaesu value; }\n\n// Nonblocking stdin readiness: positive for data/EOF, zero while idle, negative errno.\nkoukai waza stdin_ready() -> int64 { kaesu runtime.stdin_ready(); }\n\n// Millisecond timeout, or -1 to wait without a deadline. Other negative values\n// and values above INT32_MAX return -EINVAL without blocking.\nkoukai waza stdin_wait(timeout_ms: int64) -> int64 { kaesu runtime.stdin_wait(timeout_ms); }\n\n// Physical absolute identity for existing paths. Unresolvable/non-UTF8 paths\n// return mu; callers retain memory-only source identities separately.\nkoukai waza canonical_path(path: string) -> string? {\n    kaku bytes=array.make[uint8](1024,uint8(0));kaku size=runtime.real_path(path,bytes);\n    moshi(size<0 || size>=len(bytes)){kaesu mu;}array.truncate(bytes,size);kaesu string.from_utf8(bytes);\n}\n" }; }
waza data_35() -> File { kaesu File { path: "kiso/path/path.mio", version: "Bunko-GF3-v0.2", length: 4395, sha256: "92306d1fa6f0fa6f7d5180e93e0e27313ce18f4cdacf05201aa9cd07a3dc66bd", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\nkoukai kata SplitResult { dir: string; base: string; }\n\nwaza bytes_to_string(data: []uint8) -> string {\n    kaku result = string.from_utf8(data);\n    moshi (result != mu) { kaesu result; }\n    kaesu \"\";\n}\n\nwaza byte_range(data: []uint8, start: int64, end: int64) -> string {\n    kaku output = array.with_capacity[uint8](end - start);\n    kaku index = start;\n    aida (index < end) {\n        array.push(output, data[index]);\n        index = index + 1;\n    }\n    kaesu bytes_to_string(output);\n}\n\nwaza push_segment(segments: []string, data: []uint8, start: int64, end: int64, absolute: bool) -> unit {\n    moshi (end == start) { kaesu; }\n    kaku segment = byte_range(data, start, end);\n    moshi (segment == \".\") { kaesu; }\n    moshi (segment == \"..\") {\n        moshi (len(segments) > 0 && segments[len(segments) - 1] != \"..\") {\n            array.truncate(segments, len(segments) - 1);\n            kaesu;\n        }\n        moshi (!absolute) { array.push(segments, segment); }\n        kaesu;\n    }\n    array.push(segments, segment);\n}\n\nkoukai waza clean(value: string) -> string {\n    kaku data = string.to_bytes(value);\n    kaku absolute = len(data) > 0 && data[0] == uint8(47);\n    kaku segments = array.with_capacity[string](8);\n    kaku start = 0;\n    kaku index = 0;\n    aida (index <= len(data)) {\n        moshi (index == len(data) || data[index] == uint8(47)) {\n            push_segment(segments, data, start, index, absolute);\n            start = index + 1;\n        }\n        index = index + 1;\n    }\n    moshi (len(segments) == 0) {\n        moshi (absolute) { kaesu \"/\"; }\n        kaesu \".\";\n    }\n    kaku builder = string.new_builder();\n    moshi (absolute) { string.write_string(builder, \"/\"); }\n    index = 0;\n    aida (index < len(segments)) {\n        moshi (index > 0) { string.write_string(builder, \"/\"); }\n        string.write_string(builder, segments[index]);\n        index = index + 1;\n    }\n    kaesu string.builder_string(builder);\n}\n\nkoukai waza join(left: string, right: string) -> string {\n    moshi (left == \"\") { kaesu clean(right); }\n    moshi (right == \"\") { kaesu clean(left); }\n    kaku builder = string.builder_with_capacity(string.byte_len(left) + string.byte_len(right) + 1);\n    string.write_string(builder, left);\n    string.write_string(builder, \"/\");\n    string.write_string(builder, right);\n    kaesu clean(string.builder_string(builder));\n}\n\nkoukai waza join_all(parts: []string) -> string {\n    kaku capacity = 0;\n    kaku index = 0;\n    aida (index < len(parts)) {\n        capacity = capacity + string.byte_len(parts[index]) + 1;\n        index = index + 1;\n    }\n    kaku builder = string.builder_with_capacity(capacity);\n    index = 0;\n    aida (index < len(parts)) {\n        moshi (index > 0) { string.write_string(builder, \"/\"); }\n        string.write_string(builder, parts[index]);\n        index = index + 1;\n    }\n    kaesu clean(string.builder_string(builder));\n}\n\nkoukai waza is_abs(value: string) -> bool {\n    kaku data = string.to_bytes(value);\n    kaesu len(data) > 0 && data[0] == uint8(47);\n}\n\nkoukai waza base(value: string) -> string {\n    kaku normalized = clean(value);\n    moshi (normalized == \"/\" || normalized == \".\" || normalized == \"..\") { kaesu normalized; }\n    kaku data = string.to_bytes(normalized);\n    kaku index = len(data) - 1;\n    aida (index >= 0) {\n        moshi (data[index] == uint8(47)) { kaesu byte_range(data, index + 1, len(data)); }\n        index = index - 1;\n    }\n    kaesu normalized;\n}\n\nkoukai waza dir(value: string) -> string {\n    kaku normalized = clean(value);\n    moshi (normalized == \"/\") { kaesu \"/\"; }\n    kaku data = string.to_bytes(normalized);\n    kaku index = len(data) - 1;\n    aida (index >= 0) {\n        moshi (data[index] == uint8(47)) {\n            moshi (index == 0) { kaesu \"/\"; }\n            kaesu byte_range(data, 0, index);\n        }\n        index = index - 1;\n    }\n    kaesu \".\";\n}\n\nkoukai waza ext(value: string) -> string {\n    kaku name = base(value);\n    kaku data = string.to_bytes(name);\n    kaku index = len(data) - 1;\n    aida (index > 0) {\n        moshi (data[index] == uint8(46)) { kaesu byte_range(data, index, len(data)); }\n        index = index - 1;\n    }\n    kaesu \"\";\n}\n\nkoukai waza split(value: string) -> SplitResult {\n    kaku normalized = clean(value);\n    kaesu SplitResult { dir: dir(normalized), base: base(normalized) };\n}\n" }; }
waza data_36() -> File { kaesu File { path: "kiso/regexp/regexp.mio", version: "Bunko-GF3-v0.2", length: 27662, sha256: "4c66cfb48e7d7343322ddaede749acaf598732ecfa786c4bf0ed7e49bbc9d37c", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\nyobu \"kiso/utf8\";\nyobu \"kiso/regexp/unicode_data\";\n\n// Thompson NFA boolean matching; no backtracking interpreter or host regex.\n// Unicode 15 properties and simple folding use generated Mio range tables.\nkoukai kata State { op: int64; out: int64; other: int64; ranges: []int64; }\nkoukai kata Program { states: []State; start: int64; error: string; }\nkata Node { op: int64; a: int64; b: int64; low: int64; high: int64; ranges: []int64; }\nkata Parser { input: []int64; at: []int64; flags: []int64; quoted: []bool; nodes: []Node; heights: []int64; folds: []int64; error: []string; }\nkata Term { ranges: []int64; scalar: int64; }\nkata Fragment { start: int64; ends: []int64; }\nkata Count { valid: bool; low: int64; high: int64; end: int64; }\nkata Frame { items: []int64; alternatives: []int64; flags: int64; capture: bool; }\n\nwaza runes(text: string) -> []int64 {\n    kaku bytes = string.to_bytes(text); kaku output: []int64 = []; kaku at = 0;\n    aida (at < len(bytes)) { kaku decoded = utf8.decode_one(bytes, at); moshi (!decoded.valid) { kaesu []; } array.push(output, int64(decoded.value)); at = at + decoded.width; }\n    kaesu output;\n}\nwaza current(p: Parser) -> int64 { moshi (p.at[0] >= len(p.input)) { kaesu -1; } kaesu p.input[p.at[0]]; }\nwaza look(p: Parser, distance: int64) -> int64 { moshi (p.at[0] + distance >= len(p.input)) { kaesu -1; } kaesu p.input[p.at[0] + distance]; }\nwaza fail(p: Parser, error: string) -> unit { moshi (p.error[0] == \"\") { p.error[0] = error; } }\nwaza flag(flags: int64, power: int64) -> bool { kaku value = flags / power; kaesu value - (value / 2) * 2 == 1; }\nwaza quotes(p: Parser) -> unit {\n    kaku changed = hai;\n    aida (changed) {\n        changed = iie;\n        moshi (current(p) == 92 && ((!p.quoted[0] && look(p, 1) == 81) || (p.quoted[0] && look(p, 1) == 69))) {\n            p.quoted[0] = !p.quoted[0]; p.at[0] = p.at[0] + 2; changed = hai;\n        }\n    }\n}\nwaza node(p: Parser, op: int64, a: int64, b: int64, low: int64, high: int64, ranges: []int64) -> int64 {\n    moshi (len(p.nodes) >= 3355443) { fail(p, \"regexp syntax size limit\"); kaesu -1; }\n    kaku height = 1;\n    moshi ((op == 11 || op == 12 || op == 13 || op == 14) && a >= 0) { height = p.heights[a] + 1; }\n    moshi ((op == 11 || op == 12) && b >= 0) { moshi (height < p.heights[b] + 1) { height = p.heights[b] + 1; } }\n    moshi (height > 1000) { fail(p, \"regexp tree nesting limit\"); kaesu -1; }\n    array.push(p.heights, height);\n    kaku id = len(p.nodes); array.push(p.nodes, Node { op: op, a: a, b: b, low: low, high: high, ranges: ranges }); kaesu id;\n}\nwaza clean(ranges: []int64) -> []int64 {\n    kaku sorted: []int64 = []; kaku at = 0;\n    aida (at < len(ranges)) {\n        kaku low = ranges[at]; kaku high = ranges[at + 1]; array.push(sorted, low); array.push(sorted, high); kaku i = len(sorted) - 2;\n        aida (i > 0 && sorted[i] < sorted[i - 2]) { kaku a = sorted[i - 2]; kaku b = sorted[i - 1]; sorted[i - 2] = sorted[i]; sorted[i - 1] = sorted[i + 1]; sorted[i] = a; sorted[i + 1] = b; i = i - 2; }\n        at = at + 2;\n    }\n    kaku result: []int64 = []; at = 0;\n    aida (at < len(sorted)) {\n        moshi (len(result) > 0 && sorted[at] <= result[len(result) - 1] + 1) { moshi (sorted[at + 1] > result[len(result) - 1]) { result[len(result) - 1] = sorted[at + 1]; } }\n        sore { array.push(result, sorted[at]); array.push(result, sorted[at + 1]); }\n        at = at + 2;\n    }\n    kaesu result;\n}\nwaza contains(ranges: []int64, value: int64) -> bool {\n    kaku low = 0; kaku high = len(ranges) / 2;\n    aida (low < high) { kaku mid = low + (high - low) / 2; moshi (value < ranges[mid * 2]) { high = mid; } sore { moshi (value > ranges[mid * 2 + 1]) { low = mid + 1; } sore { kaesu hai; } } } kaesu iie;\n}\nwaza invert(ranges: []int64) -> []int64 {\n    kaku ordered = clean(ranges); kaku output: []int64 = []; kaku next = 0; kaku at = 0;\n    aida (at < len(ordered)) { moshi (next < ordered[at]) { array.push(output, next); array.push(output, ordered[at] - 1); } next = ordered[at + 1] + 1; at = at + 2; }\n    moshi (next <= 1114111) { array.push(output, next); array.push(output, 1114111); } kaesu output;\n}\nwaza folded(p: Parser, ranges: []int64) -> []int64 {\n    moshi (!flag(p.flags[0], 1)) { kaesu ranges; }\n    moshi (len(p.folds) == 0) { array.append_all(p.folds, unicode_data.lookup(\"fold\")); }\n    kaku result = clean(ranges); kaku pass = 0; kaku changed = hai;\n    aida (changed && pass < 4) {\n        changed = iie; kaku next = array.clone(result); kaku at = 0;\n        aida (at < len(p.folds)) {\n            moshi (contains(result, p.folds[at]) && !contains(result, p.folds[at + 1])) { array.push(next, p.folds[at + 1]); array.push(next, p.folds[at + 1]); changed = hai; } at = at + 2;\n        }\n        result = clean(next); pass = pass + 1;\n    }\n    kaesu result;\n}\nwaza unicode_name(value: []int64) -> string {\n    kaku bytes: []uint8 = []; kaku at = 0;\n    aida (at < len(value)) { kaku byte = value[at];\n        moshi (byte != 95 && byte != 45 && byte != 32) { moshi (byte >= 65 && byte <= 90) { byte = byte + 32; } moshi (byte < 0 || byte > 127) { kaesu \"\"; } array.push(bytes, uint8(byte)); } at = at + 1;\n    }\n    kaku decoded = string.from_utf8(bytes); moshi (decoded == mu) { kaesu \"\"; } kaesu decoded;\n}\nwaza unicode_class(p: Parser, negative: bool) -> Term {\n    kaku name: []int64 = []; kaku inverse = negative;\n    moshi (current(p) == 123) {\n        p.at[0] = p.at[0] + 1;\n        moshi (current(p) == 94) { inverse = !inverse; p.at[0] = p.at[0] + 1; }\n        aida (current(p) >= 0 && current(p) != 125) { array.push(name, current(p)); p.at[0] = p.at[0] + 1; }\n        moshi (current(p) != 125) { fail(p, \"unterminated Unicode class\"); } sore { p.at[0] = p.at[0] + 1; }\n    } sore { moshi (current(p) >= 0) { array.push(name, current(p)); p.at[0] = p.at[0] + 1; } }\n    kaku key = unicode_name(name); kaku ranges: []int64 = [];\n    moshi (key == \"any\") { ranges = [0,1114111]; }\n    sore { moshi (key == \"ascii\") { ranges = [0,127]; }\n    sore {\n        moshi (key == \"assigned\") { key = \"cn\"; inverse = !inverse; }\n        kaku triples = unicode_data.lookup(key);\n        moshi (len(triples) == 0) { fail(p, \"invalid Unicode character class\"); kaesu Term { ranges: [], scalar: -1 }; }\n        kaku at = 0;\n        aida (at < len(triples)) {\n            kaku low = triples[at]; kaku high = triples[at + 1]; kaku stride = triples[at + 2];\n            moshi (stride == 1) { array.push(ranges, low); array.push(ranges, high); }\n            sore { aida (low <= high) { array.push(ranges, low); array.push(ranges, low); low = low + stride; } }\n            at = at + 3;\n        }\n    } }\n    ranges = folded(p, ranges); moshi (inverse) { ranges = invert(ranges); }\n    kaesu Term { ranges: ranges, scalar: -1 };\n}\nwaza ascii(name: string) -> []int64 {\n    moshi (name == \"alnum\") { kaesu [48,57,65,90,97,122]; }\n    moshi (name == \"alpha\") { kaesu [65,90,97,122]; }\n    moshi (name == \"ascii\") { kaesu [0,127]; }\n    moshi (name == \"blank\") { kaesu [9,9,32,32]; }\n    moshi (name == \"cntrl\") { kaesu [0,31,127,127]; }\n    moshi (name == \"digit\") { kaesu [48,57]; }\n    moshi (name == \"graph\") { kaesu [33,126]; }\n    moshi (name == \"lower\") { kaesu [97,122]; }\n    moshi (name == \"print\") { kaesu [32,126]; }\n    moshi (name == \"punct\") { kaesu [33,47,58,64,91,96,123,126]; }\n    moshi (name == \"space\") { kaesu [9,13,32,32]; }\n    moshi (name == \"upper\") { kaesu [65,90]; }\n    moshi (name == \"word\") { kaesu [48,57,65,90,95,95,97,122]; }\n    moshi (name == \"xdigit\") { kaesu [48,57,65,70,97,102]; } kaesu [];\n}\nwaza is_digit(value: int64) -> bool { kaesu value >= 48 && value <= 57; }\nwaza hex(value: int64) -> int64 {\n    moshi (is_digit(value)) { kaesu value - 48; } moshi (value >= 65 && value <= 70) { kaesu value - 55; } moshi (value >= 97 && value <= 102) { kaesu value - 87; } kaesu -1;\n}\nwaza escaped(p: Parser) -> Term {\n    p.at[0] = p.at[0] + 1; kaku value = current(p); p.at[0] = p.at[0] + 1;\n    kaku name = \"\"; kaku negative = iie;\n    moshi (value == 100 || value == 68) { name = \"digit\"; negative = value == 68; }\n    moshi (value == 119 || value == 87) { name = \"word\"; negative = value == 87; }\n    moshi (value == 115 || value == 83) { name = \"space\"; negative = value == 83; }\n    moshi (name != \"\") {\n        kaku ranges = ascii(name); moshi (name == \"space\") { ranges = [9,10,12,13,32,32]; } ranges = folded(p, ranges); moshi (negative) { ranges = invert(ranges); }\n        kaesu Term { ranges: ranges, scalar: -1 };\n    }\n    moshi (value == 112 || value == 80) { kaesu unicode_class(p, value == 80); }\n    moshi (value == 97) { value = 7; }\n    sore { moshi (value == 102) { value = 12; }\n    sore { moshi (value == 110) { value = 10; }\n    sore { moshi (value == 114) { value = 13; }\n    sore { moshi (value == 116) { value = 9; }\n    sore { moshi (value == 118) { value = 11; }\n    sore { moshi (value >= 48 && value <= 55) {\n        moshi (value != 48 && (current(p) < 48 || current(p) > 55)) { fail(p, \"backreferences are not supported\"); }\n        value = value - 48; kaku at = 1;\n        aida (at < 3 && current(p) >= 48 && current(p) <= 55) { value = value * 8 + current(p) - 48; p.at[0] = p.at[0] + 1; at = at + 1; }\n    }\n    sore { moshi (value == 120) {\n        value = 0; kaku count = 0; kaku braced = current(p) == 123; moshi (braced) { p.at[0] = p.at[0] + 1; }\n        aida (hex(current(p)) >= 0 && (braced || count < 2)) {\n            value = value * 16 + hex(current(p)); p.at[0] = p.at[0] + 1; count = count + 1;\n            moshi (value > 1114111) { fail(p, \"hex escape exceeds Unicode range\"); nukeru; }\n        }\n        moshi ((!braced && count != 2) || (braced && (count == 0 || current(p) != 125))) { fail(p, \"invalid hex escape\"); }\n        moshi (braced && current(p) == 125) { p.at[0] = p.at[0] + 1; }\n    }\n    sore { moshi (value < 0 || value >= 128 || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || is_digit(value)) { fail(p, \"invalid regexp escape\"); } } } } } } } } }\n    kaesu Term { ranges: [value,value], scalar: value };\n}\nwaza balanced(p: Parser, items: []int64, op: int64) -> int64 {\n    moshi (len(items) == 0) { kaesu node(p, 0, -1, -1, 0, 0, []); }\n    kaku work = items;\n    aida (len(work) > 1) {\n        kaku next: []int64 = []; kaku at = 0;\n        aida (at < len(work)) { kaku id = work[at]; moshi (at + 1 < len(work)) { id = node(p, op, id, work[at + 1], 0, 0, []); } array.push(next, id); at = at + 2; }\n        work = next;\n    }\n    kaesu work[0];\n}\nwaza bracket(p: Parser) -> int64 {\n    p.at[0] = p.at[0] + 1; kaku negative = current(p) == 94; moshi (negative) { p.at[0] = p.at[0] + 1; }\n    kaku ranges: []int64 = []; kaku first = hai;\n    aida (p.error[0] == \"\" && (current(p) != 93 || first)) {\n        moshi (current(p) < 0) { fail(p, \"unterminated character class\"); nukeru; } first = iie;\n        moshi (current(p) == 91 && look(p, 1) == 58) {\n            kaku end = p.at[0] + 2;\n            aida (end + 1 < len(p.input) && !(p.input[end] == 58 && p.input[end + 1] == 93)) { end = end + 1; }\n            moshi (end + 1 < len(p.input)) {\n                kaku bytes: []uint8 = []; kaku at = p.at[0] + 2; kaku neg = iie; moshi (p.input[at] == 94) { neg = hai; at = at + 1; }\n                aida (at < end) { utf8.append_rune(bytes, rune(p.input[at])); at = at + 1; }\n                kaku text = string.from_utf8(bytes); kaku named: []int64 = []; moshi (text != mu) { named = ascii(text); }\n                moshi (len(named) == 0) { fail(p, \"invalid ASCII character class\"); nukeru; }\n                named = folded(p, named); moshi (neg) { named = invert(named); } array.append_all(ranges, named); p.at[0] = end + 2; tsuzuku;\n            }\n        }\n        kaku term = Term { ranges: [], scalar: -1 };\n        moshi (current(p) == 92) { term = escaped(p); }\n        sore { kaku value = current(p); p.at[0] = p.at[0] + 1; term = Term { ranges: [value,value], scalar: value }; }\n        moshi (term.scalar < 0) { array.append_all(ranges, term.ranges); tsuzuku; }\n        kaku low = term.scalar; kaku high = low;\n        moshi (current(p) == 45 && look(p, 1) != 93 && look(p, 1) >= 0) {\n            p.at[0] = p.at[0] + 1;\n            moshi (current(p) == 92) { kaku last = escaped(p); high = last.scalar; }\n            sore { high = current(p); p.at[0] = p.at[0] + 1; }\n            moshi (high < low) { fail(p, \"invalid character range\"); nukeru; }\n        }\n        array.append_all(ranges, folded(p, [low,high]));\n    }\n    moshi (current(p) != 93) { fail(p, \"unterminated character class\"); } sore { p.at[0] = p.at[0] + 1; }\n    ranges = clean(ranges); moshi (negative) { ranges = invert(ranges); }\n    kaesu node(p, 1, -1, -1, 0, 0, ranges);\n}\nwaza group_header(p: Parser) -> int64 {\n    kaku capturing = hai;\n    p.at[0] = p.at[0] + 1;\n    moshi (current(p) == 63) {\n        capturing = iie;\n        p.at[0] = p.at[0] + 1;\n        moshi (current(p) == 80 && look(p, 1) == 60) { p.at[0] = p.at[0] + 1; }\n        moshi (current(p) == 60) {\n            capturing = hai;\n            p.at[0] = p.at[0] + 1; kaku count = 0;\n            aida (current(p) != 62 && current(p) >= 0) {\n                kaku value = current(p); moshi (!(is_digit(value) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95)) { fail(p, \"invalid capture name\"); nukeru; }\n                p.at[0] = p.at[0] + 1; count = count + 1;\n            }\n            moshi (count == 0 || current(p) != 62) { fail(p, \"invalid capture name\"); } sore { p.at[0] = p.at[0] + 1; }\n        }\n        sore {\n            kaku clear = iie; kaku count = 0; kaku hyphen = iie; kaku cleared = 0;\n            aida (current(p) != 58 && current(p) != 41 && p.error[0] == \"\") {\n                kaku value = current(p);\n                moshi (value == 45 && !hyphen) { clear = hai; hyphen = hai; p.at[0] = p.at[0] + 1; tsuzuku; }\n                kaku power = 0; moshi (value == 105) { power = 1; } moshi (value == 109) { power = 2; } moshi (value == 115) { power = 4; } moshi (value == 85) { power = 8; }\n                moshi (power == 0) { fail(p, \"invalid regexp group or flags\"); nukeru; }\n                moshi (flag(p.flags[0], power) != !clear) { moshi (clear) { p.flags[0] = p.flags[0] - power; } sore { p.flags[0] = p.flags[0] + power; } }\n                p.at[0] = p.at[0] + 1; count = count + 1; moshi (clear) { cleared = cleared + 1; }\n            }\n            moshi (hyphen && cleared == 0) { fail(p, \"invalid regexp flags after hyphen\"); }\n            moshi (current(p) == 41 && count > 0) { p.at[0] = p.at[0] + 1; kaesu -2; }\n            moshi (current(p) != 58) { fail(p, \"invalid regexp group\"); } sore { p.at[0] = p.at[0] + 1; }\n        }\n    }\n    moshi (capturing) { kaesu 1; } kaesu 0;\n}\nwaza atom(p: Parser) -> int64 {\n    quotes(p); kaku value = current(p);\n    moshi (!p.quoted[0] && value == 123) { kaku count = repetition_count(p); moshi (count.valid) { fail(p, \"repetition has no operand\"); kaesu -1; } }\n    moshi (p.quoted[0]) { p.at[0] = p.at[0] + 1; kaesu node(p, 1, -1, -1, 0, 0, folded(p, [value,value])); }\n    moshi (value == 91) { kaesu bracket(p); }\n    p.at[0] = p.at[0] + 1;\n    moshi (value == 46) { kaku op = 2; moshi (flag(p.flags[0], 4)) { op = 3; } kaesu node(p, op, -1, -1, 0, 0, []); }\n    moshi (value == 94 || value == 36) { kaku op = 5; moshi (value == 36) { op = 6; } moshi (flag(p.flags[0], 2)) { op = op + 2; } kaesu node(p, op, -1, -1, 0, 0, []); }\n    moshi (value == 92) {\n        kaku escaped_value = current(p);\n        moshi (escaped_value == 65 || escaped_value == 122 || escaped_value == 98 || escaped_value == 66) {\n            p.at[0] = p.at[0] + 1; kaku op = 5;\n            moshi (escaped_value == 122) { op = 6; } moshi (escaped_value == 98) { op = 9; } moshi (escaped_value == 66) { op = 10; }\n            kaesu node(p, op, -1, -1, 0, 0, []);\n        }\n        p.at[0] = p.at[0] - 1; kaku term = escaped(p); kaku ranges = term.ranges;\n        moshi (term.scalar >= 0) { ranges = folded(p, ranges); }\n        kaesu node(p, 1, -1, -1, 0, 0, ranges);\n    }\n    moshi (value < 0 || value == 42 || value == 43 || value == 63) { fail(p, \"repetition has no operand\"); kaesu -1; }\n    kaesu node(p, 1, -1, -1, 0, 0, folded(p, [value,value]));\n}\n// A malformed count is a literal brace, including multi-digit leading zeros.\nwaza repetition_count(p: Parser) -> Count {\n    kaku bad = Count { valid: iie, low: -1, high: -1, end: p.at[0] };\n    moshi (current(p) != 123) { kaesu bad; }\n    kaku at = p.at[0] + 1; kaku low = 0; kaku high = -1;\n    moshi (at >= len(p.input)) { kaesu bad; }\n    moshi (!is_digit(p.input[at])) { kaesu bad; }\n    moshi (p.input[at] == 48 && at + 1 < len(p.input)) { moshi (is_digit(p.input[at + 1])) { kaesu bad; } }\n    aida (at < len(p.input)) { moshi (!is_digit(p.input[at])) { nukeru; } moshi (low < 100000) { low = low * 10 + p.input[at] - 48; } at = at + 1; }\n    high = low;\n    moshi (at < len(p.input)) { moshi (p.input[at] == 44) {\n        at = at + 1; high = -1;\n        moshi (at < len(p.input)) { moshi (is_digit(p.input[at])) {\n            moshi (p.input[at] == 48 && at + 1 < len(p.input)) { moshi (is_digit(p.input[at + 1])) { kaesu bad; } }\n            high = 0;\n            aida (at < len(p.input)) { moshi (!is_digit(p.input[at])) { nukeru; } moshi (high < 100000) { high = high * 10 + p.input[at] - 48; } at = at + 1; }\n        } }\n    } }\n    moshi (at >= len(p.input)) { kaesu bad; }\n    moshi (p.input[at] != 125) { kaesu bad; }\n    kaesu Count { valid: hai, low: low, high: high, end: at + 1 };\n}\nwaza repeat_valid(p: Parser, root: int64) -> bool {\n    kaku nodes: []int64 = [root]; kaku limits: []int64 = [1000];\n    aida (len(nodes) > 0) {\n        kaku last = len(nodes) - 1; kaku id = nodes[last]; kaku limit = limits[last]; array.truncate(nodes, last); array.truncate(limits, last);\n        kaku item = p.nodes[id];\n        moshi (item.op == 13 && item.b == 1) {\n            kaku count = item.high; moshi (count == 0) { tsuzuku; } moshi (count < 0) { count = item.low; }\n            moshi (count > limit) { kaesu iie; } moshi (count > 0) { limit = limit / count; }\n        }\n        moshi (item.op == 11 || item.op == 12 || item.op == 13 || item.op == 14) { array.push(nodes, item.a); array.push(limits, limit); }\n        moshi (item.op == 11 || item.op == 12) { array.push(nodes, item.b); array.push(limits, limit); }\n    }\n    kaesu hai;\n}\nwaza repetition(p: Parser, child: int64) -> int64 {\n    quotes(p); moshi (p.quoted[0]) { kaesu child; }\n    kaku value = current(p); kaku low = -1; kaku high = -1; kaku first = p.at[0];\n    moshi (value == 42) { low = 0; }\n    moshi (value == 43) { low = 1; }\n    moshi (value == 63) { low = 0; high = 1; }\n    moshi (value == 42 || value == 43 || value == 63) { p.at[0] = p.at[0] + 1; }\n    sore { moshi (value == 123) {\n        kaku count = repetition_count(p);\n        moshi (count.valid) { low = count.low; high = count.high; p.at[0] = count.end;\n            moshi (low > 1000 || high > 1000 || (high >= 0 && high < low)) { fail(p, \"invalid repetition count\"); }\n        }\n    } }\n    moshi (low < 0) { kaesu child; }\n    moshi (current(p) == 63) { p.at[0] = p.at[0] + 1; }\n    moshi (current(p) == 42 || current(p) == 43 || current(p) == 63) { fail(p, \"nested repetition operator\"); }\n    moshi (current(p) == 123) { kaku count = repetition_count(