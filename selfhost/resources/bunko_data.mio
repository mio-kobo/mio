waza data_29() -> File { kaesu File { path: "kiso/aot/lowerlinux/gc.mio", version: "Bunko-v2.1.1", length: 30894, sha256: "0b8566e1c0016643381910cd5d46284f4fafe1bd11ca8fa0dfe0536f05a7f57f", source: "yobu \"kiso/aot/elf\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// Runtime ABI RA-1 layout profile \"x64-marksweep-v1\" (kiso/runtime/abi, docs/runtime-abi.md): two-word header,\n// sizes rounded to 8-byte granules (so objects are 8-byte aligned), no generations, no large-object space.\nkoukai teisu object_layout_profile = 2;\nkoukai teisu object_header_bytes = 16;\nkoukai teisu object_size_granule = 8;\n\n// Precise, non-moving, stop-the-world mark & sweep collector for the single-threaded Linux backend.\n//\n// Object header: [0] = kind | total_bytes << 8 (kind 0 = free block), [8] = mark word.\n// Roots: Mochi globals (rt.globals_map) and every frame of the rbp chain. The collector runs only at poll\n// points (function entry, loop back-edges); each call/poll site is followed by `jmp over; descriptor; over:`\n// where the descriptor lists the rbp-relative slots of that frame that hold references, so a frame is scanned\n// from its return address alone. No collection happens inside runtime routines, so their temporaries need no roots.\n//\n// Data segment layout (offsets from elf.data_base):\n//   0 heap_next, 8 heap_end, 16.. NativeFS handle table (64 x 24), 1552.. directory table (64 x 32),\n//   3600.. collector state, 8192.. directory buffers (64 x 32 KiB), then the Mochi globals.\nwaza gc_state() -> int64 { kaesu elf.data_base + 3600; }\nkoukai waza directory_buffers() -> int64 { kaesu elf.data_base + 8192; }\nkoukai waza globals_base() -> int64 { kaesu elf.data_base + 8192 + 2097152; }\n// collector state words: +0 free list head, +8 bytes allocated since the last collection, +16 threshold,\n// +24 heap base, +32 mark stack top, +40 mark stack limit, +48 mark stack base, +56 collections, +64 minimum threshold\nwaza gc_base_register() -> int64 { kaesu x86_64.rcx; }\n\nwaza emit_gc_init(code: x86_64.Assembler) -> unit {\n    // rt.init: reserve the heap (1 GiB) and the mark stack (512 MiB), both lazily committed.\n    x86_64.label(code, \"rt.init\");\n    x86_64.mov_ri(code, x86_64.rdi, 0);\n    x86_64.mov_ri(code, x86_64.rsi, 8589934592);\n    x86_64.mov_ri(code, x86_64.rdx, 3);\n    x86_64.mov_ri(code, x86_64.r10, 16418);\n    x86_64.mov_ri(code, x86_64.r8, -1);\n    x86_64.mov_ri(code, x86_64.r9, 0);\n    x86_64.mov_eax_imm(code, 9);\n    x86_64.syscall(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.trap.memory\");\n    x86_64.mov_ri(code, x86_64.rcx, elf.data_base);\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdx, gc_state());\n    x86_64.mov_store(code, x86_64.rdx, 24, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 8589934592);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rcx, 8, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdi, 0);\n    x86_64.mov_ri(code, x86_64.rsi, 536870912);\n    x86_64.mov_ri(code, x86_64.rdx, 3);\n    x86_64.mov_ri(code, x86_64.r10, 16418);\n    x86_64.mov_ri(code, x86_64.r8, -1);\n    x86_64.mov_ri(code, x86_64.r9, 0);\n    x86_64.mov_eax_imm(code, 9);\n    x86_64.syscall(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.trap.memory\");\n    x86_64.mov_ri(code, x86_64.rdx, gc_state());\n    x86_64.mov_store(code, x86_64.rdx, 32, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rdx, 48, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 536870912);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rdx, 40, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 33554432);\n    x86_64.mov_store(code, x86_64.rdx, 16, x86_64.rax);\n    // crash reporting: SIGSEGV, SIGBUS 