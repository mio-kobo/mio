waza data_27() -> File { kaesu File { path: "kiso/aot/lower/old_satb.mio", version: "Bunko-v2.1.1", length: 3118, sha256: "1b7eeee7e12611bf454e0f055be4e368e0c90dba5c99948099e0c72904209d73", source: "// Darwin/AArch64 instruction adapter for neutral typed prewrite semantics.\n// Preserve every live operand; x14 is only a private argument carrier.\nwaza emit_old_typed_prewrite(c: arm64.Assembler, base: int64, offset: int64) -> unit {\n    moshi (!old_mark_proto_enabled(c)) { kaesu; }\n    emit(c, arm64.sub_imm_x(31, 31, 16, iie));\n    emit(c, arm64.str_x(14, 31, 0));\n    emit(c, arm64.add_imm_x(14, base, offset, iie));\n    arm64.assembler_bl(c, \"old_satb_slot\");\n    emit(c, arm64.ldr_x(14, 31, 0));\n    emit(c, arm64.add_imm_x(31, 31, 16, iie));\n}\nwaza emit_old_release_store(c: arm64.Assembler, value: int64, base: int64, offset: int64) -> unit {\n    moshi (!old_mark_proto_enabled(c)) {\n        emit(c, arm64.str_x(value, base, offset));\n        kaesu;\n    }\n    emit(c, arm64.sub_imm_x(31, 31, 16, iie));\n    emit(c, arm64.str_x(14, 31, 0));\n    emit(c, arm64.add_imm_x(14, base, offset, iie));\n    emit(c, arm64.stlr_x(value, 14));\n    emit(c, arm64.ldr_x(14, 31, 0));\n    emit(c, arm64.add_imm_x(31, 31, 16, iie));\n}\nwaza emit_old_satb_adapter(c: arm64.Assembler, p: []macho.AddressPatch, first: int64) -> unit {\n    emit_old_bulk_adapter(c, p, first);\n    attached_save(c, \"old_satb_slot\");\n    move_x(c, 1, 14);\n    old_control(c, p, first, 0);\n    arm64.assembler_cbz_x(c, 0, \"old_satb_no_state\");\n    wr_imports(c, p, first);\n    wr_call(c, \"gc_old_prewrite\");\n    arm64.assembler_label(c, \"old_satb_no_state\");\n    attached_restore(c);\n    attached_save(c, \"old_remember_header\");\n    move_x(c, 0, 14);\n    wr_imports(c, p, first);\n    wr_call(c, \"gc_old_remember_header\");\n    attached_restore(c);\n}\n// Terminal error packet for this explicit development mode. Preserve the\n// originating status/return PC before the exit syscall; no managed dereference.\nwaza emit_old_error_diagnostic(c: arm64.Assembler) -> unit {\n    emit(c, arm64.sub_imm_x(31, 31, 128, iie));\n    kaku registers = [0, 30, 23, 7, 19, 20, 21, 22, 24, 25, 26, 27, 28];\n    kaku i = 0;\n    aida (i<len(registers)) {\n        emit(c, arm64.str_x(registers[i], 31, (i + 1) * 8));\n        i = i + 1;\n    }\n    emit(c, arm64.add_imm_x(9, 31, 128, iie));\n    emit(c, arm64.str_x(9, 31, 112));\n    wr_num(c, 9, 1330398546);\n    emit(c, arm64.str_x(9, 31, 0));\n    wr_num(c, 9, 1);\n    emit(c, arm64.str_x(9, 31, 120));\n    wr_num(c, 0, 2);\n    emit(c, arm64.add_imm_x(1, 31, 0, iie));\n    wr_num(c, 2, 128);\n    wr_num(c, 16, 4);\n    emit(c, arm64.svc(128));\n}\n\n// Native operand movement only; aligned copy/clear and prewrite ordering are\n// neutral IR. Runtime helpers preserve all user registers and their caller LR.\nwaza emit_old_bulk_adapter(c: arm64.Assembler, p: []macho.AddressPatch, first: int64) -> unit {\n    attached_save(c, \"old_bulk_copy\");\n    move_x(c, 3, 2);\n    move_x(c, 2, 1);\n    move_x(c, 1, 0);\n    old_control(c, p, first, 0);\n    wr_imports(c, p, first);\n    wr_call(c, \"gc_copy_reference_slots\");\n    attached_restore(c);\n    attached_save(c, \"old_bulk_clear\");\n    move_x(c, 1, 11);\n    old_control(c, p, first, 0);\n    wr_imports(c, p, first);\n    wr_call(c, \"gc_clear_reference_slots\");\n    attached_restore(c);\n}\n" }; }
waza data_28() -> File { kaesu File { path: "kiso/aot/lower/old_sweep.mio", version: "Bunko-v2.1.1", length: 6063, sha256: "19b74fdaf53c0b907b641cc2a4e00731ace01c966c7b537277f5553c52da4591", source: "// E5 experimental Darwin/AArch64 CPU/OS adaptation, native gates NOT_ACCEPTED.\nkoukai teisu concurrent_old_root_words = 3306;\nwaza old_sweep_enabled(c: arm64.Assembler) -> bool { kaesu arm64.assembler_label_word(c, \"old_sweep_enabled\") >= 0; }\nwaza old_mapping_size(c: arm64.Assembler) -> int64 {\n    moshi (old_sweep_enabled(c)) {\n        kaesu 263168;\n    }\n    kaesu old_mapping_bytes;\n}\nwaza old_queue_start(c: arm64.Assembler) -> int64 {\n    moshi (old_sweep_enabled(c)) {\n        kaesu 1024;\n    }\n    kaesu 512;\n}\nwaza emit_sweep_dispatch(c: arm64.Assembler, p: []macho.AddressPatch, first: int64) -> unit {\n    // Called inside old_collect_dispatch's owned64B scratch, with ctrl0/mode9.\n    kaku modes = [20, 21, 22, 23, 24, 26, 27, 28, 29, 32, 33, 34, 41, 42, 43, 44, 45];\n    kaku offsets = [712, 552, 536, 576, 560, 648, 656, 720, 584, 752, 744, 544, 768, 776, 808, 816, 672];\n    kaku i = 0;\n    aida (i<len(modes)) {\n        kaku next = string.concat(\"sweep_query_next_\", convert.format_int(modes[i]));\n        emit(c, arm64.cmp_imm_x(9, modes[i], iie));\n        arm64.assembler_b_cond(c, 1, next);\n        emit(c, arm64.add_imm_x(9, 0, offsets[i], iie));\n        emit(c, arm64.ldar_x(0, 9));\n        old_result(c, 0);\n        arm64.assembler_label(c, next);\n        i = i + 1;\n    }\n    // Heap metrics acquire the actual stopped heap and shared sweep lock.\n    kaku heap_modes = [35, 36, 37, 38, 39, 40];\n    kaku heap_offsets = [gc.los_count, gc.los_bytes, gc.los_reclaimed, 2720, 304, 1120];\n    i = 0;\n    aida (i<len(heap_modes)) {\n        kaku next = string.concat(\"sweep_heap_query_next_\", convert.format_int(heap_modes[i]));\n        emit(c, arm64.cmp_imm_x(9, heap_modes[i], iie));\n        arm64.assembler_b_cond(c, 1, next);\n        wr_poll(c, p, first, \"gc_heap_enter\");\n        emit(c, arm64.ldr_x(9, 23, heap_offsets[i]));\n        emit(c, arm64.str_x(9, 31, 32));\n        wr_current(c, p, first);\n        wr_call(c, \"gc_end\");\n        emit(c, arm64.ldr_x(0, 31, 32));\n        old_result(c, 0);\n        arm64.assembler_label(c, next);\n        i = i + 1;\n    }\n    emit(c, arm64.cmp_imm_x(9, 25, iie));\n    arm64.assembler_b_cond(c, 1, \"sweep_query_not_observe\");\n    wr_imports(c, p, first);\n    arm64.assembler_bl(c, \"attached_gc_sweep_observe\");\n    old_result(c, 0);\n    arm64.assembler_label(c, \"sweep_query_not_observe\");\n    emit(c, arm64.cmp_imm_x(9, 30, iie));\n    arm64.assembler_b_cond(c, 0, \"sweep_query_finish\");\n    emit(c, arm64.cmp_imm_x(9, 31, iie));\n    arm64.assembler_b_cond(c, 1, \"sweep_queries_done\");\n    arm64.assembler_label(c, \"sweep_query_finish\");\n    wr_poll(c, p, first, \"gc_heap_enter\");\n    wr_current(c, p, first);\n    emit(c, arm64.str_x(0, 31, 0));\n    move_x(c, 1, 0);\n    old_control(c, p, first, 0);\n    wr_imports(c, p, first);\n    emit(c, arm64.ldr_x(9, 31, 24));\n    emit(c, arm64.cmp_imm_x(9, 31, iie));\n    arm64.assembler_b_cond(c, 0, \"sweep_do_retry\");\n    wr_call(c, \"gc_sweep_finish\");\n    old_control(c, p, first, 9);\n    emit(c, arm64.ldr_x(9, 9, 552));\n    emit(c, arm64.str_x(9, 31, 32));\n    arm64.assembler_b(c, \"sweep_query_resume\");\n    arm64.assembler_label(c, \"sweep_do_retry\");\n    wr_call(c, \"gc_sweep_retry\");\n    emit(c, arm64.str_x(31, 31, 32));\n    arm64.assembler_label(c, \"sweep_query_resume\");\n    wr_current(c, p, first);\n    wr_call(c, \"gc_end\");\n    emit(c, arm64.ldr_x(0, 31, 32));\n    old_result(c, 0);\n    arm64.assembler_label(c, \"sweep_queries_done\");\n    emit(c, arm64.ldr_x(9, 31, 24));\n}\nwaza emit_sweep_adapter(c: arm64.Assembler, p: []macho.AddressPatch, first: int64) -> unit {\n    attached_save(c, \"sweep_bin_reused\");\n    move_x(c, 1, 13);\n    old_control(c, p, first, 0);\n    arm64.assembler_cbz_x(c, 0, \"sweep_bin_no_state\");\n    wr_imports(c, p, first);\n    wr_call(c, \"gc_sweep_reused\");\n    arm64.assembler_label(c, \"sweep_bin_no_state\");\n    attached_restore(c);\n    // Neutral reclaim owns lock/charges; adapter reports the real public OS result.\n    stw_bridge_enter(c, \"worker_sweep_account\");\n    move_x(c, 23, 0);\n    arm64.assembler_bl(c, \"memory_sample\");\n    wr_num(c, 0, 0);\n    stw_bridge_leave(c);\n    stw_bridge_enter(c, \"worker_sweep_unmap\");\n    moshi (arm64.assembler_label_word(c, \"sweep_unmap_fault_enabled\") >= 0) {\n        move_x(c, 19, 0);\n        move_x(c, 20, 1);\n        old_control(c, p, first, 9);\n        emit(c, arm64.ldr_x(10, 9, 784));\n        arm64.assembler_cbnz_x(c, 10, \"sweep_unmap_real\");\n        wr_num(c, 10, 1);\n        emit(c, arm64.str_x(10, 9, 784));\n        emit(c, arm64.add_imm_x(0, 19, 1, iie));\n        arm64.assembler_label(c, \"sweep_unmap_real\");\n    }\n    wr_num(c, 16, 73);\n    emit(c, arm64.svc(128));\n    arm64.assembler_b_cond(c, 2, \"sweep_unmap_return\");\n    wr_num(c, 0, 0);\n    arm64.assembler_label(c, \"sweep_unmap_return\");\n    stw_bridge_leave(c);\n    // Report to separately owned stack. Never overwrite a control that still has\n    // a live native owner when failure cleanup could not join.\n    attached_save(c, \"sweep_control_report\");\n    old_control(c, p, first, 14);\n    arm64.assembler_cbz_x(c, 14, \"sweep_report_no_state\");\n    emit(c, arm64.sub_imm_x(31, 31, 256, iie));\n    wr_num(c, 9, 1330406979);\n    emit(c, arm64.str_x(9, 31, 0));\n    wr_num(c, 9, 3);\n    emit(c, arm64.str_x(9, 31, 8));\n    kaku offsets = [712, 720, 544, 552, 536, 576, 560, 624, 632, 640, 648, 656, 608, 616, 664, 672, 680, 688, 704, 584, 736, 744, 752, 760, 768, 776, 808, 816, 824, 832];\n    kaku i = 0;\n    aida (i<len(offsets)) {\n        emit(c, arm64.add_imm_x(9, 14, offsets[i], iie));\n        emit(c, arm64.ldar_x(9, 9));\n        emit(c, arm64.str_x(9, 31, (i + 2) * 8));\n        i = i + 1;\n    }\n    wr_num(c, 0, 2);\n    emit(c, arm64.add_imm_x(1, 31, 0, iie));\n    wr_num(c, 2, 256);\n    wr_num(c, 16, 4);\n    emit(c, arm64.svc(128));\n    emit(c, arm64.add_imm_x(31, 31, 256, iie));\n    arm64.assembler_label(c, \"sweep_report_no_state\");\n    attached_restore(c);\n}\n\nwaza worker_import_slots(c: arm64.Assembler) -> int64 {\n    moshi (old_sweep_enabled(c)) {\n        kaesu 30;\n    }\n    kaesu 28;\n}\n" }; }
waza data_29() -> File { kaesu File { path: "kiso/aot/lower/sha256_native.mio", version: "Bunko-v2.1.1", length: 5298, sha256: "6155ee848c8bf47a0c8650b8698edba9d7e766f7d54513cb1034c23ab71d4ab3", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/aot/lower/types\";\n\n// ARMv8 SHA-256 for kiso/crypto/sha256's sha256_compress_native_block(state, words, k, x, bytes): every Apple-silicon\n// Mac implements FEAT_SHA256. The call keeps the Mochi call's stack effect (five operands popped, no result); the routine\n// validates its three arrays (non-nil, 8-byte elements, lengths >= 8, 16 and 64) and fails like any bad index otherwise.\n// It allocates nothing and stores only integers, so no shadow frame, safepoint or barrier is involved. Full-sweep images\n// (acquire loads for heap reads) keep the ordinary call.\nteisu sha256_native_name = \"sha256_compress_native_block\";\n\nwaza sha256_native_call(code: arm64.Assembler, analysis: types.TypeAnalysis, entries: []int64, target: mochi.Function) -> bool {\n    moshi (old_sweep_enabled(code) || target.name != sha256_native_name || target.parameter_count != 5 || target.returns_value) {\n        kaesu iie;\n    }\n    moshi (len(entries) < 5) { kaesu iie; }\n    kaku i = len(entries) - 5;\n    aida (i < len(entries)) {\n        moshi (types.type_kind(analysis, entries[i]) != types.type_array_ref) { kaesu iie; }\n        i = i + 1;\n    }\n    kaesu hai;\n}\n\nwaza emit_sha256_native_call(code: arm64.Assembler) -> unit {\n    emit(code, arm64.sub_imm_x(20, 20, 40, iie));\n    emit(code, arm64.add_x(8, 19, 20));\n    emit(code, arm64.ldp_x(0, 1, 8, 0));\n    emit(code, arm64.ldr_x(2, 8, 16));\n    arm64.assembler_bl(code, \"rt_sha256_compress\");\n}\n\nwaza simd(code: arm64.Assembler, word: int64) -> unit { emit(code, arm64.Instruction { word: uint32(word), error: mu }); }\n// INS Vd.S[lane], Wn / UMOV Wd, Vn.S[lane]\nwaza ins_s(code: arm64.Assembler, vd: int64, lane: int64, wn: int64) -> unit {\n    simd(code, 1308630016 + (lane * 8 + 4) * 65536 + wn * 32 + vd);\n}\nwaza umov_s(code: arm64.Assembler, wd: int64, vn: int64, lane: int64) -> unit {\n    simd(code, 234896384 + (lane * 8 + 4) * 65536 + vn * 32 + wd);\n}\nwaza add_4s(code: arm64.Assembler, vd: int64, vn: int64, vm: int64) -> unit { simd(code, 1319142400 + vm * 65536 + vn * 32 + vd); }\nwaza mov_16b(code: arm64.Assembler, vd: int64, vn: int64) -> unit { simd(code, 1319115776 + vn * 65536 + vn * 32 + vd); }\nwaza sha256h(code: arm64.Assembler, qd: int64, qn: int64, vm: int64) -> unit { simd(code, 1577074688 + vm * 65536 + qn * 32 + qd); }\nwaza sha256h2(code: arm64.Assembler, qd: int64, qn: int64, vm: int64) -> unit { simd(code, 1577078784 + vm * 65536 + qn * 32 + qd); }\nwaza sha256su0(code: arm64.Assembler, vd: int64, vn: int64) -> unit { simd(code, 1579689984 + vn * 32 + vd); }\nwaza sha256su1(code: arm64.Assembler, vd: int64, vn: int64, vm: int64) -> unit { simd(code, 1577082880 + vm * 65536 + vn * 32 + vd); }\n\n// x<reg> array descriptor -> x<storage> first element address; minimum length checked.\nwaza sha256_native_array(code: arm64.Assembler, reg: int64, minimum: int64, storage: int64) -> unit {\n    arm64.assembler_cbz_x(code, reg, \"runtime_error\");\n    emit(code, arm64.ldr_x(9, reg, 8));\n    emit(code, arm64.cmp_imm_x(9, minimum, iie));\n    arm64.assembler_b_cond(code, 3, \"runtime_error\");\n    emit(code, arm64.ldrb_w(9, reg, 1));\n    emit(code, arm64.cmp_imm_x(9, 8, iie));\n    arm64.assembler_b_cond(code, 1, \"runtime_error\");\n    emit(code, arm64.ldr_x(storage, reg, 40));\n    emit(code, arm64.add_imm_x(storage, storage, 32, iie));\n}\n\n// Four consecutive 64-bit elements (low 32 bits each, little-endian) at x<base> + 8 * first into Vd.4S.\nwaza sha256_native_load(code: arm64.Assembler, vd: int64, base: int64, first: int64) -> unit {\n    kaku lane = 0;\n    aida (lane < 4) {\n        emit(code, arm64.ldr_w(9, base, (first + lane) * 8));\n        ins_s(code, vd, lane, 9);\n        lane = lane + 1;\n    }\n}\n\n// x0 state, x1 words, x2 k; uses x9-x12, v16-v27.\nwaza emit_sha256_native_routine(code: arm64.Assembler) -> unit {\n    arm64.assembler_label(code, \"rt_sha256_compress\");\n    sha256_native_array(code, 0, 8, 10);\n    sha256_native_array(code, 1, 16, 11);\n    sha256_native_array(code, 2, 64, 12);\n    sha256_native_load(code, 16, 10, 0);\n    sha256_native_load(code, 17, 10, 4);\n    sha256_native_load(code, 20, 11, 0);\n    sha256_native_load(code, 21, 11, 4);\n    sha256_native_load(code, 22, 11, 8);\n    sha256_native_load(code, 23, 11, 12);\n    mov_16b(code, 24, 16);\n    mov_16b(code, 25, 17);\n    kaku group = 0;\n    aida (group < 16) {\n        kaku m0 = 20 + group - (group / 4) * 4;\n        sha256_native_load(code, 26, 12, group * 4);\n        add_4s(code, 26, m0, 26);\n        moshi (group < 12) {\n            kaku m1 = 20 + (group + 1) - ((group + 1) / 4) * 4;\n            kaku m2 = 20 + (group + 2) - ((group + 2) / 4) * 4;\n            kaku m3 = 20 + (group + 3) - ((group + 3) / 4) * 4;\n            sha256su0(code, m0, m1);\n            sha256su1(code, m0, m2, m3);\n        }\n        mov_16b(code, 27, 16);\n        sha256h(code, 16, 17, 26);\n        sha256h2(code, 17, 27, 26);\n        group = group + 1;\n    }\n    add_4s(code, 16, 16, 24);\n    add_4s(code, 17, 17, 25);\n    kaku lane = 0;\n    aida (lane < 4) {\n        umov_s(code, 9, 16, lane);\n        emit(code, arm64.str_x(9, 10, lane * 8));\n        umov_s(code, 9, 17, lane);\n        emit(code, arm64.str_x(9, 10, (lane + 4) * 8));\n        lane = lane + 1;\n    }\n    emit(code, arm64.ret());\n}\n" }; }
waza data_30() -> File { kaesu File { path: "kiso/aot/lower/specialize.mio", version: "Bunko-v2.1.1", length: 4269, sha256: "4520a70e87b26f24d72afd1583575370d514476cb529d2d659585d75a35484dc", source: "yobu \"kiso/array\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/encoding/mochi\";\n\nkata Specialization {\n    file: mochi.File;\n    analysis: types.TypeAnalysis;\n}\n\nwaza instance_function(source: mochi.Function, id: int64, data: []uint8) -> mochi.Function {\n    // Each specialization owns its mutable metadata arrays. Explicitly typed\n    // copies also retain the array representation when the input function list\n    // is empty and no reachable constructor supplies an element witness.\n    kaku name_bytes: []uint8 = [];\n    array.append_all(name_bytes, source.name_bytes);\n    kaku captures: []mochi.Capture = [];\n    array.append_all(captures, source.captures);\n    kaesu mochi.Function { id: id, name: source.name, name_bytes: name_bytes,\n        parameter_count: source.parameter_count, local_count: source.local_count,\n        returns_value: source.returns_value, captures: captures, instructions: data };\n}\n\nwaza retarget_call(data: []uint8, at: int64, id: int64) -> unit {\n    data[at + 1] = uint8(id / 256);\n    data[at + 2] = uint8(id - (id / 256) * 256);\n}\n\n// v14 erases generic type arguments. Recover separate representations only\n// when the unchanged strict solver rejects a direct call's shared signature.\n// The complete callee is cloned, retaining its control flow and GC analysis.\n// A call site is split at most once; an actual per-instance type/layout failure\n// stays a failure. Bounds prevent recursive specialization from running away.\nwaza specialize(file: mochi.File) -> Specialization {\n    kaku work = mochi.File { version: file.version, constants: file.constants,\n        global_count: file.global_count, instructions: file.instructions,\n        functions: array.clone(file.functions) };\n    kaku attempted: []int64 = [];\n    kaku count = 0;\n    kaku analysis = types.analyze_types(work);\n    aida (analysis.error_detail != 0 && count < 256 && len(work.functions) < 65536) {\n        kaku detail = analysis.error_detail;\n        moshi (detail - (detail / 100) * 100 != 25) { nukeru; }\n        kaku owner = detail / 1000000 - 1;\n        kaku offset = (detail - (owner + 1) * 1000000) / 100;\n        kaku repeated = iie;\n        kaku index = 0;\n        aida (index < len(attempted)) {\n            moshi (attempted[index] == detail) {\n                repeated = hai;\n            }\n            index = index + 1;\n        }\n        moshi (repeated || owner >= len(work.functions)) { nukeru; }\n        array.push(attempted, detail);\n        kaku caller = work.instructions;\n        moshi (owner >= 0) {\n            caller = work.functions[owner].instructions;\n        }\n        moshi (offset < 0 || offset + 3 > len(caller) || caller[offset] != uint8(25)) { nukeru; }\n        kaku target = int64(caller[offset + 1]) * 256 + int64(caller[offset + 2]);\n        moshi (target >= len(work.functions)) { nukeru; }\n        kaku source = work.functions[target];\n        // Captured environments have separate identity/representation edges.\n        // Do not clone them without specializing those edges as well.\n        moshi (len(source.captures) != 0 || len(source.instructions) == 0) { nukeru; }\n        kaku id = len(work.functions);\n        kaku body = array.clone(source.instructions);\n        kaku at = 0;\n        aida (at < len(body)) {\n            kaku opcode = int64(body[at]);\n            kaku width = types.type_instruction_width(opcode);\n            moshi (width <= 0 || at + width > len(body)) { kaesu Specialization { file: work, analysis: analysis }; }\n            moshi (opcode == 25 && int64(body[at + 1]) * 256 + int64(body[at + 2]) == target) { retarget_call(body, at, id); }\n            at = at + width;\n        }\n        array.push(work.functions, instance_function(source, id, body));\n        kaku patched = array.clone(caller);\n        retarget_call(patched, offset, id);\n        moshi (owner < 0) {\n            work = mochi.File { version: work.version, constants: work.constants,\n                global_count: work.global_count, instructions: patched, functions: work.functions };\n        }\n        sore { work.functions[owner] = instance_function(work.functions[owner], owner, patched); }\n        count = count + 1;\n        analysis = types.analyze_types(work);\n    }\n    kaesu Specialization { file: work, analysis: analysis };\n}\n" }; }
waza data_31() -> File { kaesu File { path: "kiso/aot/lower/stw_bridge.mio", version: "Bunko-v2.1.1", length: 2877, sha256: "12c51f0aa2ec435e2f3d55b178334648b309cf298d4c80ec557a7f22ffef21a1", source: "// Darwin/AArch64 ABI bridge for the legacy heap. Exclusivity is established by\n// the portable coordinator, never by sharing a thread's x24. Each call installs\n// a coordinator-owned exact snapshot, and restores every native callee-save.\n// These entry points are internal runtime adapters, not language builtins.\nwaza stw_bridge_enter(code: arm64.Assembler, name: string) -> unit {\n    arm64.assembler_label(code, name);\n    emit(code, arm64.stp_pre_x(29, 30, 31, -16));\n    kaku r = 19;\n    aida (r<29) {\n        emit(code, arm64.stp_pre_x(r, r + 1, 31, -16));\n        r = r + 2;\n    }\n}\nwaza stw_bridge_leave(code: arm64.Assembler) -> unit {\n    kaku r = 27;\n    aida (r >= 19) {\n        emit(code, arm64.ldp_post_x(r, r + 1, 31, 16));\n        r = r - 2;\n    }\n    emit(code, arm64.ldp_post_x(29, 30, 31, 16));\n    emit(code, arm64.ret());\n}\nkoukai waza emit_stopped_heap_adapter(code: arm64.Assembler, capacity: int64) -> unit {\n    stw_bridge_enter(code, \"stw_heap_init\");\n    emit_runtime_init(code, capacity, runtime_metadata_bytes);\n    emit_observation_init(code);\n    arm64.assembler_bl(code, \"memory_sample\");\n    move_x(code, 0, 23);\n    stw_bridge_leave(code);\n    // heap, exact snapshot, size, type. Requires exclusive heap access; an\n    // allocation-triggered collection uses the same complete root snapshot.\n    stw_bridge_enter(code, \"stw_heap_alloc\");\n    move_x(code, 23, 0);\n    move_x(code, 24, 1);\n    move_x(code, 0, 2);\n    move_x(code, 1, 3);\n    arm64.assembler_bl(code, \"runtime_alloc\");\n    stw_bridge_leave(code);\n    // heap, exact snapshot, major. The ordinary collector remains unchanged.\n    stw_bridge_enter(code, \"stw_heap_collect\");\n    move_x(code, 23, 0);\n    move_x(code, 24, 1);\n    arm64.assembler_cbz_x(code, 2, \"stw_heap_minor\");\n    arm64.assembler_bl(code, \"gen_major\");\n    arm64.assembler_b(code, \"stw_heap_collected\");\n    arm64.assembler_label(code, \"stw_heap_minor\");\n    arm64.assembler_bl(code, \"gen_minor\");\n    arm64.assembler_label(code, \"stw_heap_collected\");\n    emit(code, arm64.movz_x(0, 0, 0));\n    stw_bridge_leave(code);\n    // heap, typed owner. Exact pointer stores use the legacy post-write barrier\n    // while all mutators are stopped; this is NOT a concurrent SATB barrier.\n    stw_bridge_enter(code, \"stw_heap_remember\");\n    move_x(code, 23, 0);\n    move_x(code, 0, 1);\n    emit_gen_remember(code, 0);\n    emit(code, arm64.movz_x(0, 0, 0));\n    stw_bridge_leave(code);\n    emit_managed_runtime(code, iie, runtime_metadata_bytes, iie);\n    kaku labels = [\"runtime_error\", \"runtime_oom\", \"runtime_gc_bad_type\", \"runtime_gc_bad_kind\", \"runtime_gc_bad_count\"];\n    kaku i = 0;\n    aida (i<len(labels)) {\n        arm64.assembler_label(code, labels[i]);\n        emit(code, arm64.movz_x(0, 91 + i, 0));\n        emit(code, arm64.movz_x(16, 1, 0));\n        emit(code, arm64.svc(128));\n        i = i + 1;\n    }\n}\n" }; }
waza data_32() -> File { kaesu File { path: "kiso/aot/lower/testing.mio", version: "Bunko-v2.1.1", length: 3963, sha256: "6782cf2ad066ddc1ecb09ddc79c915522d4a43e2cc86c7228377a3a01245fcc7", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/array\";\n\nwaza uses_testing(file: mochi.File) -> bool {\n    kaku index = 0;\n    aida (index < len(file.functions)) {\n        moshi (types.is_testing_report(file.functions[index].name)) { kaesu hai; }\n        index = index + 1;\n    }\n    kaesu iie;\n}\n\nwaza testing_counter_address(code: arm64.Assembler, patches: []macho.AddressPatch, slot: int64) -> unit {\n    kaku at = len(code.words);\n    emit(code, arm64.Instruction { word: uint32(0), error: mu });\n    emit(code, arm64.Instruction { word: uint32(0), error: mu });\n    array.push(patches, macho.AddressPatch { at_word: at, add_at_word: at + 1,\n            target: macho.data_target(), target_offset: slot * 8, register: 8 });\n}\n\n// report records every failure and returns normally, as the reference recorder\n// does. Program exit reflects the accumulated result; it does not stop after\n// the first failed expectation or turn a failed assertion into success.\nwaza emit_testing_report(code: arm64.Assembler, patches: []macho.AddressPatch, slot: int64,\n    analysis: types.TypeAnalysis, function_id: int64, packet: bool) -> unit {\n    emit(code, arm64.ldr_x(9, 21, 0));\n    emit_unbox_register(code, analysis, analysis.locals[function_id][0], 9);\n    arm64.assembler_cbnz_x(code, 9, \"testing_report_done\");\n    moshi (worker_roots_enabled(code)) { arm64.assembler_bl(code, \"attached_heap_enter\"); }\n    testing_counter_address(code, patches, slot);\n    emit(code, arm64.ldr_x(9, 8, 0));\n    emit(code, arm64.add_imm_x(9, 9, 1, iie));\n    emit(code, arm64.str_x(9, 8, 0));\n    emit(code, arm64.ldr_x(9, 21, 8));\n    emit_string_view(code);\n    moshi (packet) {\n        emit(code, arm64.sub_imm_x(31, 31, 32, iie));\n        emit(code, arm64.str_x(13, 31, 0));\n        emit(code, arm64.str_x(10, 31, 8));\n        // Length-prefixed bytes preserve newlines/NUL and distinguish assertion\n        // data from user stderr. Only test-linked images ever write fd 3.\n        emit(code, arm64.movz_x(0, 3, 0));\n        emit(code, arm64.add_imm_x(1, 31, 8, iie));\n        emit(code, arm64.movz_x(2, 8, 0));\n        emit(code, arm64.movz_x(16, 4, 0));\n        emit_print_boundary(code);\n        emit(code, arm64.movz_x(0, 3, 0));\n        emit(code, arm64.ldr_x(1, 31, 0));\n        emit(code, arm64.ldr_x(2, 31, 8));\n        emit(code, arm64.movz_x(16, 4, 0));\n        emit_print_boundary(code);\n        emit(code, arm64.ldr_x(13, 31, 0));\n        emit(code, arm64.ldr_x(10, 31, 8));\n        emit(code, arm64.add_imm_x(31, 31, 32, iie));\n    }\n    emit(code, arm64.movz_x(0, 2, 0));\n    move_x(code, 1, 13);\n    move_x(code, 2, 10);\n    emit(code, arm64.movz_x(16, 4, 0));\n    emit_print_boundary(code);\n    // A separate stack byte supplies the newline without an embedded string.\n    emit(code, arm64.sub_imm_x(31, 31, 16, iie));\n    emit(code, arm64.movz_x(9, 10, 0));\n    emit(code, arm64.strb_w(9, 31, 0));\n    emit(code, arm64.movz_x(0, 2, 0));\n    emit(code, arm64.add_imm_x(1, 31, 0, iie));\n    emit(code, arm64.movz_x(2, 1, 0));\n    emit(code, arm64.movz_x(16, 4, 0));\n    emit_print_boundary(code);\n    emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    arm64.assembler_label(code, \"testing_report_done\");\n}\n\nwaza uses_testing_packet(file: mochi.File) -> bool {\n    kaku at = 0;\n    aida (at < len(file.functions)) {\n        moshi (types.is_testing_packet(file.functions[at].name)) {\n            kaesu hai;\n        }\n        at = at + 1;\n    }\n    kaesu iie;\n}\nwaza emit_testing_completion(code: arm64.Assembler) -> unit {\n    emit(code, arm64.sub_imm_x(31, 31, 16, iie));\n    emit(code, arm64.movn_x(9, 0, 0));\n    emit(code, arm64.str_x(9, 31, 0));\n    emit(code, arm64.movz_x(0, 3, 0));\n    emit(code, arm64.add_imm_x(1, 31, 0, iie));\n    emit(code, arm64.movz_x(2, 8, 0));\n    emit(code, arm64.movz_x(16, 4, 0));\n    emit_print_boundary(code);\n    emit(code, arm64.add_imm_x(31, 31, 16, iie));\n}\n" }; }
waza data_33() -> File { kaesu File { path: "kiso/aot/lower/types/types.mio", version: "Bunko-v2.1.1", length: 94589, sha256: "24d5ab2ca36cb33a41e803f84c517c55eb8dc726b8767f3c31cfa62746d57af6", source: "yobu \"kiso/array\";\nyobu \"kiso/aot/cabi\";\nyobu \"kiso/aot/lower/nativefs\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/encoding/win64c\";\n\n// Closed value categories used by the pure-Mio lowering pass.  These are\n// representation categories rather than source-language names: in\n// particular, strings are tagged IDs or managed dynamic descriptors. Exact\n// string slots are published as tagged-union Roots; marking skips tagged IDs.\nkoukai teisu type_unknown = 0;\nkoukai teisu type_integer = 1;\nkoukai teisu type_float32 = 2;\nkoukai teisu type_float64 = 3;\nkoukai teisu type_bool = 4;\nkoukai teisu type_string_id = 5;\nkoukai teisu type_array_ref = 6;\nkoukai teisu type_struct_ref = 7;\nkoukai teisu type_enum_ref = 8;\nkoukai teisu type_function_ref = 9;\nkoukai teisu type_nil = 10;\nkoukai teisu type_float_any = 11;\nkoukai teisu type_map_ref = 12;\n\nkoukai waza is_testing_report(name: string) -> bool {\n    kaesu name == \"$mma::mio/testing/runtime::report::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967\" || is_testing_packet(name);\n}\n\nkoukai waza is_testing_packet(name: string) -> bool {\n    kaesu name == \"$mma::mio/testing/runtime::report_packet::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967\";\n}\n\nkoukai kata TypeArena {\n    parent: []int64;\n    revision: []int64;\n    kind: []int64;\n    nullable: []bool;\n    struct_arity: []int64;\n    struct_exact: []bool;\n    fields: [][]int64;\n    array_width: []int64;\n    array_descriptor: []int64;\n    integer_descriptor: []int64;\n    map_written: []bool;\n    targets: [][]int64;\n    variants: [][][]int64;\n    trace: []bool;\n    context: []int64;\n    nullable_origins: [][]int64;\n}\n\nkoukai kata TypeBlock {\n    data: []uint8;\n    function_id: int64;\n    entry: [][]int64;\n    reachable: []bool;\n}\n\nkoukai kata TypeAnalysis {\n    arena: TypeArena;\n    globals: []int64;\n    locals: [][]int64;\n    returns: []int64;\n    upvalues: [][]int64;\n    cells: [][]bool;\n    blocks: []TypeBlock;\n    error_detail: int64;\n}\n\nwaza type_arena() -> TypeArena {\n    kaesu TypeArena { parent: [], revision: [0], kind: [], nullable: [], struct_arity: [],\n        struct_exact: [], fields: [], array_width: [], array_descriptor: [], integer_descriptor: [], map_written: [], targets: [], variants: [], trace: [iie], context: [0], nullable_origins: [] };\n}\n\nwaza type_new(arena: TypeArena, kind: int64) -> int64 {\n    kaku id = len(arena.parent);\n    array.push(arena.parent, id);\n    array.push(arena.kind, kind);\n    array.push(arena.array_width, 0);\n    array.push(arena.array_descriptor, 0);\n    array.push(arena.integer_descriptor, 0);\n    array.push(arena.map_written, iie);\n    array.push(arena.nullable, iie);\n    array.push(arena.struct_arity, -1);\n    array.push(arena.struct_exact, iie);\n    kaku empty: []int64 = [];\n    array.push(arena.fields, empty);\n    kaku targets: []int64 = [];\n    array.push(arena.targets, targets);\n    kaku variants: [][]int64 = [];\n    array.push(arena.variants, variants);\n    kaesu id;\n}\n\nwaza type_root(arena: TypeArena, node: int64) -> int64 {\n    kaku root = node;\n    aida (arena.parent[root] != root) { root = arena.parent[root]; }\n    kaku cursor = node;\n    aida (arena.parent[cursor] != cursor) {\n        kaku next = arena.parent[cursor];\n        arena.parent[cursor] = root;\n        cursor = next;\n    }\n    kaesu root;\n}\n\nkoukai waza type_kind(analysis: TypeAnalysis, node: int64) -> int64 {\n    kaesu analysis.arena.kind[type_root(analysis.arena, node)];\n}\n\nkoukai waza integer_descriptor(analysis: TypeAnalysis, node: int64) -> int64 {\n    kaesu analysis.arena.integer_descriptor[type_root(analysis.arena, node)];\n}\n\nkoukai waza type_nullable(analysis: TypeAnalysis, node: int64) -> bool {\n    kaesu analysis.arena.nullable[type_root(analysis.arena, node)];\n}\n\nkoukai waza type_is_heap_reference(analysis: TypeAnalysis, node: int64) -> bool {\n    kaku kind = type_kind(analysis, node);\n    kaesu kind == type_string_id || kind == type_array_ref || kind == type_struct_ref || kind == type_enum_ref ||\n    kind == type_function_ref || kind == type_map_ref || (type_nullable(analysis, node) && type_is_scalar_kind(kind));\n}\n\nwaza type_is_scalar_kind(kind: int64) -> bool {\n    kaesu kind == type_integer || kind == type_float32 || kind == type_float64 || kind == type_float_any ||\n    kind == type_bool || kind == type_string_id;\n}\n\nwaza type_merge_fields(arena: TypeArena, left: int64, right: int64) -> bool {\n    kaku left_fields = arena.fields[left];\n    kaku right_fields = arena.fields[right];\n    kaku index = 0;\n    aida (index < len(right_fields)) {\n        moshi (index < len(left_fields)) {\n            moshi (!type_join(arena, left_fields[index], right_fields[index])) { kaesu iie; }\n        }\n        sore { array.push(left_fields, right_fields[index]); }\n        index = index + 1;\n    }\n    arena.fields[left] = left_fields;\n    kaesu hai;\n}\n\n// Union is deliberately strict.  Unknown is a constraint variable, while Nil\n// only adds nullability to a concrete representation.  Two different concrete\n// representations never silently collapse to \"maybe a pointer\".\nwaza type_join(arena: TypeArena, a: int64, b: int64) -> bool {\n    moshi (a < 0 || b < 0 || a >= len(arena.parent) || b >= len(arena.parent)) { kaesu iie; }\n    kaku left = type_root(arena, a);\n    kaku right = type_root(arena, b);\n    moshi (left == right) { kaesu hai; }\n    kaku left_kind = arena.kind[left];\n    moshi (arena.trace[0] && arena.nullable[left] != arena.nullable[right]) {\n        array.push(arena.nullable_origins, [arena.context[0], a, b, 1]);\n    }\n    moshi (arena.trace[0] && ((arena.kind[left] == type_nil && arena.kind[right] != type_nil && arena.kind[right] != type_unknown) || (arena.kind[right] == type_nil && arena.kind[left] != type_nil && arena.kind[left] != type_unknown))) {\n        array.push(arena.nullable_origins, [arena.context[0], a, b, 2]);\n    }\n    kaku right_kind = arena.kind[right];\n    kaku resolved = iie;\n    moshi ((left_kind == type_float_any && (right_kind == type_float32 || right_kind == type_float64)) ||\n        (right_kind == type_float_any && (left_kind == type_float32 || left_kind == type_float64))) {\n        arena.kind[left] = type_float_any;\n        resolved = hai;\n    }\n    moshi (left_kind == type_nil && right_kind != type_nil && right_kind != type_unknown) {\n        arena.kind[left] = right_kind;\n        arena.nullable[left] = hai;\n        resolved = hai;\n    }\n    moshi (!resolved && right_kind == type_nil && left_kind != type_nil && left_kind != type_unknown) {\n        arena.nullable[left] = hai;\n        resolved = hai;\n    }\n    moshi (!resolved && left_kind == type_unknown) {\n        arena.kind[left] = right_kind;\n        resolved = hai;\n    }\n    moshi (!resolved && right_kind != type_unknown && left_kind != right_kind) { kaesu iie; }\n\n    moshi (arena.struct_exact[left] && arena.struct_exact[right] &&\n        arena.struct_arity[left] != arena.struct_arity[right]) { kaesu iie; }\n    moshi (arena.integer_descriptor[left] != 0 && arena.integer_descriptor[right] != 0 && arena.integer_descriptor[left] != arena.integer_descriptor[right]) {\n        kaesu iie;\n    }\n    moshi (arena.integer_descriptor[left] == 0) { arena.integer_descriptor[left] = arena.integer_descriptor[right]; }\n    moshi (arena.array_descriptor[left] != 0 && arena.array_descriptor[right] != 0 && arena.array_descriptor[left] != arena.array_descriptor[right]) {\n        kaesu iie;\n    }\n    moshi (arena.array_descriptor[left] == 0) { arena.array_descriptor[left] = arena.array_descriptor[right]; }\n    arena.map_written[left] = arena.map_written[left] || arena.map_written[right];\n    arena.parent[right] = left;\n    arena.revision[0] = arena.revision[0] + 1;\n    // Nullability belongs to the class before the recursive field joins run: a self-referential shape\n    // (struct Tree { left: Tree? }) can make a nested join re-parent `left`, and anything written to `left`\n    // afterwards would land on a node that is no longer the root.\n    arena.nullable[left] = arena.nullable[left] || arena.nullable[right];\n    moshi (!type_merge_fields(arena, left, right)) { kaesu iie; }\n    moshi (arena.array_width[left] != 0 && arena.array_width[right] != 0 && arena.array_width[left] != arena.array_width[right]) {\n        kaesu iie;\n    }\n    moshi (arena.array_width[left] == 0) { arena.array_width[left] = arena.array_width[right]; }\n    kaku variants = arena.variants[left];\n    kaku vi = 0;\n    aida (vi < len(arena.variants[right])) {\n        aida (len(variants) <= vi) {\n            kaku empty: []int64 = [];\n            array.push(variants, empty);\n        }\n        kaku incoming = arena.variants[right][vi];\n        kaku current = variants[vi];\n        moshi (len(incoming) > 0) {\n            moshi (len(current) == 0) { variants[vi] = incoming; }\n            sore {\n                moshi (len(current) != len(incoming)) { kaesu iie; }\n                kaku fi = 1;\n                aida (fi < len(current)) {\n                    moshi (!type_join(arena, current[fi], incoming[fi])) {\n                        kaesu iie;\n                    }\n                    fi = fi + 1;\n                }\n            }\n        }\n        vi = vi + 1;\n    }\n    arena.variants[left] = variants;\n    kaku targets = arena.targets[left];\n    kaku ti = 0;\n    aida (ti < len(arena.targets[right])) {\n        kaku target = arena.targets[right][ti];\n        kaku found = iie;\n        kaku tj = 0;\n        aida (tj < len(targets)) {\n            moshi (targets[tj] == target) {\n                found = hai;\n            }\n            tj = tj + 1;\n        }\n        moshi (!found) {\n            array.push(targets, target);\n        }\n        ti = ti + 1;\n    }\n    arena.targets[left] = targets;\n    arena.parent[right] = left;\n    arena.nullable[left] = arena.nullable[left] || arena.nullable[right];\n    moshi (!arena.struct_exact[left] && arena.struct_exact[right]) {\n        arena.struct_exact[left] = hai;\n        arena.struct_arity[left] = arena.struct_arity[right];\n    }\n    moshi (!arena.struct_exact[left] && arena.struct_arity[left] < arena.struct_arity[right]) {\n        arena.struct_arity[left] = arena.struct_arity[right];\n    }\n    // A nested join may have re-parented `left` (see above): carry its facts to the current root.\n    kaesu type_carry_to_root(arena, left);\n}\n\nwaza type_carry_to_root(arena: TypeArena, node: int64) -> bool {\n    kaku root = type_root(arena, node);\n    moshi (root == node) { kaesu hai; }\n    moshi (arena.nullable[node] && !arena.nullable[root]) {\n        arena.nullable[root] = hai;\n        arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (arena.map_written[node] && !arena.map_written[root]) {\n        arena.map_written[root] = hai;\n        arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (merge_targets(arena.targets[root], arena.targets[node])) { arena.revision[0] = arena.revision[0] + 1; }\n    moshi (arena.struct_exact[node] && arena.struct_exact[root] && arena.struct_arity[node] != arena.struct_arity[root]) { kaesu iie; }\n    moshi (arena.struct_exact[node] && !arena.struct_exact[root]) {\n        arena.struct_exact[root] = hai;\n        arena.struct_arity[root] = arena.struct_arity[node];\n    }\n    moshi (!arena.struct_exact[root] && arena.struct_arity[root] < arena.struct_arity[node]) {\n        arena.struct_arity[root] = arena.struct_arity[node];\n    }\n    kaku variants = arena.variants[node];\n    kaku current = arena.variants[root];\n    kaku vi = 0;\n    aida (vi < len(variants)) {\n        aida (len(current) <= vi) {\n            kaku empty: []int64 = [];\n            array.push(current, empty);\n        }\n        moshi (len(current[vi]) == 0 && len(variants[vi]) > 0) { current[vi] = variants[vi]; }\n        vi = vi + 1;\n    }\n    arena.variants[root] = current;\n    kaesu hai;\n}\n\nwaza type_require(arena: TypeArena, node: int64, kind: int64) -> bool {\n    kaesu type_join(arena, node, type_new(arena, kind));\n}\n\nwaza type_mark_nullable(arena: TypeArena, node: int64) -> unit {\n    moshi (node < 0 || node >= len(arena.parent)) { kaesu; }\n    moshi (arena.trace[0]) { array.push(arena.nullable_origins, [arena.context[0], node, node, 3]); }\n    arena.nullable[type_root(arena, node)] = hai;\n}\n\nwaza type_new_struct(arena: TypeArena, fields: []int64) -> int64 {\n    kaku node = type_new(arena, type_struct_ref);\n    arena.struct_arity[node] = len(fields);\n    arena.struct_exact[node] = hai;\n    arena.fields[node] = fields;\n    kaesu node;\n}\n\nwaza type_struct_field(arena: TypeArena, node: int64, index: int64) -> int64 {\n    kaku root = type_root(arena, node);\n    moshi (arena.kind[root] == type_unknown) { arena.kind[root] = type_struct_ref; }\n    // A class that has only met nil so far (for example a global initialised with mu whose struct stores are\n    // analysed in a later block) is a nullable struct once a field is read, exactly as type_join(nil, struct).\n    moshi (arena.kind[root] == type_nil) {\n        arena.kind[root] = type_struct_ref;\n        arena.nullable[root] = hai;\n        arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (arena.kind[root] != type_struct_ref || index < 0) { kaesu -1; }\n    moshi (arena.struct_exact[root] && index >= arena.struct_arity[root]) { kaesu -1; }\n    kaku fields = arena.fields[root];\n    aida (len(fields) <= index) { array.push(fields, type_new(arena, type_unknown)); }\n    arena.fields[root] = fields;\n    moshi (arena.struct_arity[root] < index + 1) { arena.struct_arity[root] = index + 1; }\n    kaesu fields[index];\n}\n\n// Arrays reuse the constraint edge vector with one element edge. The node\n// kind distinguishes these edges from Struct fields.\nkoukai waza type_array_element(arena: TypeArena, node: int64) -> int64 {\n    kaku root = type_root(arena, node);\n    moshi (arena.kind[root] == type_unknown) {\n        arena.kind[root] = type_array_ref;\n        arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (arena.kind[root] != type_array_ref) { kaesu -1; }\n    kaku fields = arena.fields[root];\n    moshi (len(fields) == 0) {\n        array.push(fields, type_new(arena, type_unknown));\n        arena.fields[root] = fields;\n    }\n    kaesu fields[0];\n}\n\n// Map edges describe key and stored nullable value independently of the\n// descriptor's physical linked-entry layout. Scalar values use existing boxes.\nkoukai waza map_field(arena: TypeArena, node: int64, index: int64) -> int64 {\n    moshi (!type_require(arena, node, type_map_ref)) { kaesu -1; }\n    kaku root = type_root(arena, node);\n    kaku fields = arena.fields[root];\n    aida (len(fields) < 2) { array.push(fields, type_new(arena, type_unknown)); }\n    arena.fields[root] = fields;\n    type_mark_nullable(arena, fields[1]);\n    kaesu fields[index];\n}\n\nwaza type_descriptor_kind(descriptor: int64) -> int64 {\n    kaku kind = descriptor - (descriptor / 128) * 128;\n    moshi (kind == 0) { kaesu type_unknown; }\n    moshi (kind == 2) { kaesu type_float64; }\n    moshi (kind == 3) { kaesu type_float32; }\n    moshi (kind == 4) { kaesu type_bool; }\n    moshi (kind == 5) { kaesu type_string_id; }\n    moshi (kind == 7) { kaesu type_array_ref; }\n    moshi (kind == 8) { kaesu type_struct_ref; }\n    moshi (kind == 9) { kaesu type_enum_ref; }\n    moshi (kind == 10) { kaesu type_map_ref; }\n    moshi (kind == 11) { kaesu type_function_ref; }\n    kaesu type_integer;\n}\n\nkoukai waza type_instruction_width(opcode: int64) -> int64 {\n    moshi (opcode == 1 || (opcode >= 17 && opcode <= 20) ||\n        (opcode >= 23 && opcode <= 25) || opcode == 30 || opcode == 36 || opcode == 37 ||\n        opcode == 40 || (opcode >= 44 && opcode <= 49)) { kaesu 3; }\n    moshi (opcode == 38) { kaesu 5; }\n    moshi (opcode == 56 || opcode == 67) { kaesu 4; }\n    moshi (opcode == 54) { kaesu 3; }\n    moshi (opcode == 55 || opcode == 57 || opcode == 58 || opcode == 65 || opcode == 66) { kaesu 2; }\n    moshi ((opcode >= 2 && opcode <= 16) || opcode == 21 || opcode == 22 ||\n        (opcode >= 26 && opcode <= 35) || (opcode >= 39 && opcode <= 43) ||\n        (opcode >= 50 && opcode <= 53) || (opcode >= 59 && opcode <= 64)) { kaesu 1; }\n    kaesu 0;\n}\n\nwaza type_u16(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset + 1]) * 256 + int64(data[offset + 2]);\n}\n\nwaza type_operand2(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset + 3]) * 256 + int64(data[offset + 4]);\n}\n\nwaza type_constant_kind(constant: mochi.Constant) -> int64 {\n    moshi (constant.tag == uint8(2)) { kaesu type_string_id; }\n    moshi (constant.tag == uint8(3)) { kaesu type_float64; }\n    moshi (constant.tag == uint8(4)) { kaesu type_float32; }\n    moshi (constant.tag >= uint8(1) && constant.tag <= uint8(10)) { kaesu type_integer; }\n    kaesu type_unknown;\n}\n\nwaza type_stack_effect(file: mochi.File, opcode: int64, operand: int64, operand2: int64) -> []int64 {\n    kaku need = 0;\n    kaku push = 0;\n    kaku handled = iie;\n    moshi (opcode == 1 || opcode == 8 || opcode == 9 || opcode == 20 || opcode == 21 ||\n        opcode == 24 || opcode == 44 || opcode == 46 || opcode == 47) {\n        push = 1;\n        handled = hai;\n    }\n    moshi (!handled && (opcode == 3 || opcode == 18 || opcode == 19 || opcode == 22 || opcode == 23 ||\n            opcode == 48 || opcode == 49 || opcode == 27)) {\n        need = 1;\n        handled = hai;\n    }\n    moshi (!handled && (opcode == 7 || opcode == 10 || (opcode >= 28 && opcode <= 29) || opcode == 32 ||\n            opcode == 34 || opcode == 39 || opcode == 40 || (opcode >= 50 && opcode <= 53) ||\n            opcode == 55 || opcode == 60 || opcode == 62 || opcode == 65 || opcode == 66)) {\n        need = 1;\n        push = 1;\n        handled = hai;\n    }\n    moshi (!handled && ((opcode >= 2 && opcode <= 6) || (opcode >= 11 && opcode <= 16) || opcode == 31 ||\n            opcode == 42 || opcode == 57)) {\n        need = 2;\n        push = 1;\n        handled = hai;\n    }\n    moshi (!handled && (opcode == 33 || opcode == 35 || opcode == 43)) {\n        need = 3;\n        handled = hai;\n    }\n    moshi (!handled && (opcode == 30 || opcode == 36 || opcode == 56)) {\n        need = operand;\n        push = 1;\n        handled = hai;\n    }\n    moshi (!handled && opcode == 38) {\n        need = operand2;\n        push = 1;\n        handled = hai;\n    }\n    moshi (!handled && opcode == 41) {\n        push = 1;\n        handled = hai;\n    }\n    moshi (!handled && opcode == 58) {\n        need = 1;\n        push = 1;\n        handled = hai;\n    }\n    moshi (!handled && (opcode == 59 || opcode == 61 || opcode == 63 || opcode == 64)) {\n        need = 2;\n        handled = hai;\n    }\n    moshi (!handled && opcode == 54) {\n        need = operand2;\n        moshi (operand != 13) {\n            push = 1;\n        }\n        handled = hai;\n    }\n    moshi (!handled && opcode == 25) {\n        moshi (operand < 0 || operand >= len(file.functions)) { kaesu [-1, -1]; }\n        need = file.functions[operand].parameter_count;\n        moshi (file.functions[operand].returns_value) { push = 1; }\n        handled = hai;\n    }\n    moshi (!handled && opcode == 45) {\n        need = operand + 1;\n        push = 1;\n    }\n    moshi (!handled && opcode == 67) {\n        moshi (file.version<16 || operand2<0 || operand2>1) {\n            kaesu [-1, -1];\n        }\n        need = operand + 1;\n        push = operand2;\n    }\n    kaesu [need, push];\n}\n\nwaza call_push(file: mochi.File, data: []uint8, offset: int64, count: int64) -> int64 {\n    // Exact targets validate this provisional shape after graph construction.\n    kaku shape = -1;\n    kaku i = 0;\n    aida (i < len(file.functions)) {\n        kaku fn = file.functions[i];\n        moshi (fn.parameter_count == count) {\n            kaku value = 0;\n            moshi (fn.returns_value) {\n                value = 1;\n            }\n            moshi (shape == -1) {\n                shape = value;\n            } sore {\n                moshi (shape != value) {\n                    shape = 2;\n                }\n            }\n        }\n        i = i + 1;\n    }\n    moshi (shape < 2 && shape >= 0) { kaesu shape; }\n    // A directly preceding literal has no intervening arguments for arity 0.\n    moshi (count == 0 && offset >= 3 && (data[offset - 3] == uint8(44) || data[offset - 3] == uint8(46))) {\n        kaku id = type_u16(data, offset - 3);\n        moshi (id < len(file.functions)) {\n            moshi (file.functions[id].returns_value) {\n                kaesu 1;\n            }\n            kaesu 0;\n        }\n    }\n    moshi (offset + 3 < len(data)) {\n        kaku next = int64(data[offset + 3]);\n        moshi (next == 3 || next == 19 || next == 22 || next == 23 || next == 27 || next == 48 || next == 49) { kaesu 1; }\n    }\n    moshi (offset + 3 == len(data) || (offset + 3 < len(data) && data[offset + 3] == uint8(26))) { kaesu 0; }\n    kaesu -1;\n}\n\n// Recognize the compiler's exact awase prologue and binding triples.\n// Other control flow stays unresolved rather than merging unrelated variants.\nkoukai waza enum_read_tag(file: mochi.File, data: []uint8, at: int64) -> int64 {\n    kaku cursor = 0;\n    kaku tag = -1;\n    kaku binding = -1;\n    aida (cursor < at) {\n        kaku op = int64(data[cursor]);\n        kaku width = type_instruction_width(op);\n        moshi (width == 0) { kaesu -1; }\n        moshi ((op == 20 || op == 24) && cursor + 11 <= len(data) && data[cursor + 3] == uint8(39) &&\n            data[cursor + 4] == uint8(1) && data[cursor + 7] == uint8(11) && data[cursor + 8] == uint8(18)) {\n            kaku id = type_u16(data, cursor + 4);\n            moshi (id < len(file.constants) && file.constants[id].tag == uint8(1) && file.constants[id].bits.high == uint32(0) && file.constants[id].bits.low <= uint32(65535)) {\n                tag = int64(file.constants[id].bits.low);\n                binding = cursor + 11;\n            }\n        }\n        moshi (binding >= 0 && cursor == binding) {\n            moshi (cursor + 9 <= len(data) && (op == 20 || op == 24) && data[cursor + 3] == uint8(40) &&\n                (data[cursor + 6] == uint8(19) || data[cursor + 6] == uint8(23))) {\n                moshi (at == cursor + 3) {\n                    kaesu tag;\n                }\n                binding = cursor + 9;\n            } sore { binding = -1; }\n        }\n        cursor = cursor + width;\n    }\n    kaesu -1;\n}\n\nwaza merge_targets(destination: []int64, source: []int64) -> bool {\n    kaku changed = iie;\n    kaku i = 0;\n    aida (i < len(source)) {\n        kaku j = 0;\n        kaku found = iie;\n        aida (j < len(destination)) {\n            moshi (destination[j] == source[i]) {\n                found = hai;\n            }\n            j = j + 1;\n        }\n        moshi (!found) {\n            array.push(destination, source[i]);\n            changed = hai;\n        }\n        i = i + 1;\n    }\n    kaesu changed;\n}\n\n// Return-shape hints mirror M15b's branchless literal/local/factory analysis.\n// They decide only provisional stack depths; the full graph validates targets.\nwaza call_hints(file: mochi.File) -> [][]int64 {\n    kaku hints: [][]int64 = [];\n    kaku results: [][]int64 = [];\n    kaku globals: [][]int64 = [];\n    kaku i = 0;\n    aida (i < file.global_count) {\n        kaku empty: []int64 = [];\n        array.push(globals, empty);\n        i = i + 1;\n    }\n    i = -1;\n    aida (i < len(file.functions)) {\n        kaku data = file.instructions;\n        moshi (i >= 0) {\n            data = file.functions[i].instructions;\n        }\n        array.push(hints, array.make[int64](len(data) + 1, -1));\n        moshi (i >= 0) {\n            kaku empty: []int64 = [];\n            array.push(results, empty);\n        }\n        i = i + 1;\n    }\n    kaku pass = 0;\n    kaku changed = hai;\n    aida (changed && pass <= len(file.functions) + 1) {\n        changed = iie;\n        i = -1;\n        aida (i < len(file.functions)) {\n            kaku data = file.instructions;\n            kaku count = 0;\n            moshi (i >= 0) {\n                data = file.functions[i].instructions;\n                count = file.functions[i].local_count;\n            }\n            kaku branchless = hai;\n            kaku at = 0;\n            aida (at < len(data)) {\n                kaku op = int64(data[at]);\n                moshi (op == 17 || op == 18) {\n                    branchless = iie;\n                }\n                kaku w = type_instruction_width(op);\n                moshi (w == 0) {\n                    branchless = iie;\n                    nukeru;\n                }\n                at = at + w;\n            }\n            moshi (!branchless) {\n                i = i + 1;\n                tsuzuku;\n            }\n            kaku locals: [][]int64 = [];\n            kaku stack: [][]int64 = [];\n            kaku j = 0;\n            aida (j < count) {\n                kaku empty: []int64 = [];\n                array.push(locals, empty);\n                j = j + 1;\n            }\n            at = 0;\n            aida (at < len(data)) {\n                kaku op = int64(data[at]);\n                kaku w = type_instruction_width(op);\n                kaku arg = 0;\n                kaku arg2 = 0;\n                moshi (w >= 3) { arg = type_u16(data, at); }\n                moshi (op == 38) { arg2 = type_operand2(data, at); }\n                moshi (op == 54 || op == 55 || op == 57 || op == 58 || op == 65) { arg = int64(data[at + 1]); }\n                moshi (op == 54) { arg2 = int64(data[at + 2]); }\n                moshi (op == 67) { arg2 = int64(data[at + 3]); }\n                kaku effect = type_stack_effect(file, op, arg, arg2);\n                kaku value: []int64 = [];\n                moshi (op == 44 || op == 46) { array.push(value, arg); }\n                moshi (op == 20 && arg < len(globals)) { value = globals[arg]; }\n                moshi (op == 24 && arg < len(locals)) { value = locals[arg]; }\n                moshi (op == 25 && arg < len(results)) { value = results[arg]; }\n                moshi (op == 66 && len(stack) > 0) { value = stack[len(stack) - 1]; }\n                moshi (op == 45) {\n                    moshi (len(stack) < arg + 1) { nukeru; }\n                    kaku targets = stack[len(stack) - arg - 1];\n                    kaku shape = -1;\n                    kaku ti = 0;\n                    aida (ti < len(targets)) {\n                        kaku target = targets[ti];\n                        kaku fn = file.functions[target];\n                        kaku current = 0;\n                        moshi (fn.returns_value) {\n                            current = 1;\n                        }\n                        moshi (fn.parameter_count != arg || (shape >= 0 && shape != current)) {\n                            shape = -2;\n                            nukeru;\n                        }\n                        shape = current;\n                        merge_targets(value, results[target]);\n                        ti = ti + 1;\n                    }\n                    moshi (shape >= 0) {\n                        moshi (hints[i + 1][at] != shape) {\n                            hints[i + 1][at] = shape;\n                            changed = hai;\n                        }\n                        effect[1] = shape;\n                    }\n                    sore { effect[1] = call_push(file, data, at, arg); }\n                    moshi (effect[1] < 0) { nukeru; }\n                }\n                moshi (effect[0] > len(stack)) { nukeru; }\n                moshi (op == 19 || op == 23 || op == 49 || op == 27) {\n                    kaku top = stack[len(stack) - 1];\n                    moshi (op == 19) { changed = merge_targets(globals[arg], top) || changed; }\n                    moshi (op == 23 || op == 49) { locals[arg] = top; }\n                    moshi (op == 27 && i >= 0) { changed = merge_targets(results[i], top) || changed; }\n                }\n                array.truncate(stack, len(stack) - effect[0]);\n                moshi (effect[1] > 0) { array.push(stack, value); }\n                at = at + w;\n            }\n            i = i + 1;\n        }\n        pass = pass + 1;\n    }\n    kaesu hints;\n}\n\nwaza type_block_depths(file: mochi.File, data: []uint8, function_id: int64, hints: []int64) -> []int64 {\n    kaku depths = array.make[int64](len(data) + 1, -1);\n    kaku boundary = array.make[bool](len(data) + 1, iie);\n    kaku offset = 0;\n    aida (offset < len(data)) {\n        kaku width = type_instruction_width(int64(data[offset]));\n        moshi (width == 0 || offset + width > len(data)) { kaesu []; }\n        boundary[offset] = hai;\n        offset = offset + width;\n    }\n    boundary[len(data)] = hai;\n    depths[0] = 0;\n    kaku queue: []int64 = [0];\n    kaku cursor = 0;\n    aida (cursor < len(queue)) {\n        offset = queue[cursor];\n        cursor = cursor + 1;\n        moshi (offset == len(data)) { tsuzuku; }\n        kaku opcode = int64(data[offset]);\n        kaku width = type_instruction_width(opcode);\n        kaku operand = 0;\n        kaku operand2 = 0;\n        moshi (width >= 3) { operand = type_u16(data, offset); }\n        moshi (opcode == 38) { operand2 = type_operand2(data, offset); }\n        moshi (opcode == 56 || opcode == 67) { operand2 = int64(data[offset + 3]); }\n        moshi (opcode == 54 || opcode == 55 || opcode == 57 || opcode == 58 || opcode == 65 || opcode == 66) {\n            operand = int64(data[offset + 1]);\n        }\n        moshi (opcode == 54) { operand2 = int64(data[offset + 2]); }\n        kaku effect = type_stack_effect(file, opcode, operand, operand2);\n        moshi (opcode == 45) {\n            effect[1] = hints[offset];\n            moshi (effect[1] < 0) {\n                effect[1] = call_push(file, data, offset, operand);\n            }\n        }\n        moshi (effect[1] < 0) { kaesu []; }\n        moshi (len(effect) != 2 || effect[0] < 0 || depths[offset] < effect[0]) { kaesu []; }\n        kaku next_depth = depths[offset] - effect[0] + effect[1];\n        kaku next = offset + width;\n        kaku targets: []int64 = [];\n        moshi (opcode == 17) { array.push(targets, operand); }\n        moshi (opcode == 18) {\n            array.push(targets, operand);\n            array.push(targets, next);\n        }\n        moshi (opcode != 17 && opcode != 18 && opcode != 26 && opcode != 27) { array.push(targets, next); }\n        kaku index = 0;\n        aida (index < len(targets)) {\n            kaku target = targets[index];\n            moshi (target < 0 || target > len(data) || !boundary[target]) { kaesu []; }\n            moshi (depths[target] < 0) {\n                depths[target] = next_depth;\n                array.push(queue, target);\n            }\n            moshi (depths[target] != next_depth) { kaesu []; }\n            index = index + 1;\n        }\n    }\n    kaesu depths;\n}\n\nwaza type_merge_entry(arena: TypeArena, entries: [][]int64, at: int64, stack: []int64) -> bool {\n    kaku current = entries[at];\n    moshi (len(current) == 0 && len(stack) > 0) {\n        kaku copied: []int64 = [];\n        kaku index = 0;\n        aida (index < len(stack)) {\n            array.push(copied, stack[index]);\n            index = index + 1;\n        }\n        entries[at] = copied;\n        kaesu hai;\n    }\n    moshi (len(current) != len(stack)) { kaesu iie; }\n    kaku index = 0;\n    aida (index < len(stack)) {\n        moshi (!type_join(arena, current[index], stack[index])) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nwaza type_pop(stack: []int64) -> int64 {\n    moshi (len(stack) == 0) { kaesu -1; }\n    kaku value = stack[len(stack) - 1];\n    array.truncate(stack, len(stack) - 1);\n    kaesu value;\n}\n\nwaza type_copy_stack(source: []int64) -> []int64 {\n    kaku result: []int64 = [];\n    kaku index = 0;\n    aida (index < len(source)) {\n        array.push(result, source[index]);\n        index = index + 1;\n    }\n    kaesu result;\n}\n\nwaza type_fail(function_id: int64, offset: int64, opcode: int64) -> int64 {\n    kaesu (function_id + 1) * 1000000 + offset * 100 + opcode;\n}\n\n// Build the graph in two stages: reachability establishes exact stack depths,\n// then each value-producing position receives a union node.  Successor stacks\n// are joined at bytecode boundaries, so loops and diamonds share the same\n// representation decision.\n// Only locals captured into shared Cells can be rebound by another call.\n// A normal by-value local keeps its non-nil fact across direct/indirect calls.\nwaza type_captured_locals(file: mochi.File, data: []uint8, count: int64) -> []bool {\n    kaku shared = array.make[bool](count, iie);\n    kaku at = 0;\n    aida (at < len(data)) {\n        kaku opcode = int64(data[at]);\n        kaku width = type_instruction_width(opcode);\n        moshi (width <= 0 || width > len(data) - at) { kaesu shared; }\n        moshi (opcode == 46) {\n            kaku target = type_u16(data, at);\n            moshi (target >= 0 && target < len(file.functions)) {\n                kaku captures = file.functions[target].captures;\n                kaku ci = 0;\n                aida (ci < len(captures)) { kaku capture = captures[ci];\n                    moshi (capture.local && capture.index >= 0 && capture.index < count) {\n                        shared[capture.index] = hai;\n                    }\n                    ci = ci + 1;\n                }\n            }\n        }\n        at = at + width;\n    }\n    kaesu shared;\n}\n// Forward must-analysis intersects incoming paths. Stores invalidate their\n// local; calls and Cell writes invalidate potentially shared captured locals.\nwaza type_nonnil_entries(file: mochi.File, data: []uint8, count: int64) -> [][]bool {\n    kaku shared = type_captured_locals(file, data, count);\n    kaku facts = array.with_capacity[[]bool](len(data) + 1);\n    kaku visited = array.make[bool](len(data) + 1, iie);\n    // Unvisited positions share one all-false placeholder: a position's facts are replaced by its own array on its\n    // first visit, and only visited positions are ever updated in place.\n    kaku none = array.make[bool](count, iie);\n    kaku at = 0;\n    aida (at <= len(data)) {\n        array.push(facts, none);\n        at = at + 1;\n    }\n    // Lambda bindings have an implicit nil placeholder for recursive scope.\n    // A literal closure stored on its sole fallthrough path is definitely\n    // non-nil. Do not infer this at a branch target with another predecessor.\n    kaku jump_target = array.make[bool](len(data) + 1, iie);\n    kaku scan = 0;\n    aida (scan<len(data)) {\n        kaku op = int64(data[scan]);\n        kaku size = type_instruction_width(op);\n        moshi (size <= 0 || size>len(data) - scan) {\n            kaesu facts;\n        }\n        moshi (op == 17 || op == 18) {\n            kaku dest = type_u16(data, scan);\n            moshi (dest >= 0 && dest <= len(data)) {\n                jump_target[dest] = hai;\n            }\n        }\n        scan = scan + size;\n    }\n    visited[0] = hai;\n    kaku changed = hai;\n    aida (changed) {\n        changed = iie;\n        at = 0;\n        kaku previous = -1;\n        aida (at < len(data)) {\n            kaku op = int64(data[at]);\n            kaku width = type_instruction_width(op);\n            moshi (visited[at]) {\n                kaku out = array.clone(facts[at]);\n                moshi (op == 23 || op == 49) {\n                    kaku slot = type_u16(data, at);\n                    moshi (slot < count) {\n                        out[slot] = iie;\n                        moshi (op == 23 && !jump_target[at] && previous >= 0 && (data[previous] == uint8(44) || data[previous] == uint8(46))) {\n                            out[slot] = hai;\n                        }\n                    }\n                }\n                moshi (op == 25 || op == 45 || op == 67 || op == 48) {\n                    kaku i = 0;\n                    aida (i < count) {\n                        moshi (shared[i]) {\n                            out[i] = iie;\n                        }\n                        i = i + 1;\n                    }\n                }\n                kaku successors: []int64 = [];\n                kaku guard = -1;\n                kaku inverted = iie;\n                moshi (op == 17 || op == 18) { array.push(successors, type_u16(data, at)); }\n                moshi (op != 17 && op != 26 && op != 27) { array.push(successors, at + width); }\n                // These are the compiler's local nil-test forms. All other\n                // conditions provide no fact; no instruction bytes are guessed\n                // from inside operands: verify their instruction boundaries.\n                moshi (op == 18) {\n                    kaku start = at - 4;\n                    moshi (at >= 5 && data[at - 1] == uint8(10)) {\n                        start = at - 5;\n                        inverted = hai;\n                    }\n                    moshi (start >= 0 && data[start] == uint8(24) && data[start + 3] == uint8(34)) {\n                        kaku boundary = 0;\n                        aida (boundary < start) {\n                            boundary = boundary + type_instruction_width(int64(data[boundary]));\n                        }\n                        moshi (boundary == start) { guard = type_u16(data, start); }\n                    }\n                }\n                kaku si = 0;\n                aida (si < len(successors)) {\n                    kaku dest = successors[si];\n                    kaku guarded = guard >= 0 && guard < count && ((si == 0 && !inverted) || (si == 1 && inverted));\n                    // The incoming facts are out plus the guard; they are only materialised when stored (first visit).\n                    moshi (!visited[dest]) {\n                        kaku incoming = array.clone(out);\n                        moshi (guarded) {\n                            incoming[guard] = hai;\n                        }\n                        facts[dest] = incoming;\n                        visited[dest] = hai;\n                        changed = hai;\n                    } sore {\n                        kaku current = facts[dest];\n                        kaku i = 0;\n                        aida (i < count) {\n                            moshi (current[i] && !out[i] && !(guarded && i == guard)) {\n                                current[i] = iie;\n                                changed = hai;\n                            }\n                            i = i + 1;\n                        }\n                    }\n                    si = si + 1;\n                }\n            }\n            previous = at;\n            at = at + width;\n        }\n    }\n    kaesu facts;\n}\n\n// Operations relate base types without equating their raw/boxed value\n// representations. Only real value-flow edges use type_join.\nwaza type_same_kind(arena: TypeArena, a: int64, b: int64, infer_nil: bool) -> bool {\n    kaku left = type_root(arena, a);\n    kaku right = type_root(arena, b);\n    kaku lk = arena.kind[left];\n    kaku rk = arena.kind[right];\n    moshi (infer_nil && lk == type_nil && rk != type_nil && rk != type_unknown) {\n        moshi (arena.trace[0]) { array.push(arena.nullable_origins, [arena.context[0], a, b, 2]); }\n        arena.kind[left] = rk;\n        arena.nullable[left] = hai;\n        arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (infer_nil && rk == type_nil && lk != type_nil && lk != type_unknown) {\n        moshi (arena.trace[0]) { array.push(arena.nullable_origins, [arena.context[0], b, a, 2]); }\n        arena.kind[right] = lk;\n        arena.nullable[right] = hai;\n        arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (lk == type_unknown && rk != type_unknown && rk != type_nil) {\n        arena.kind[left] = rk;\n        arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (rk == type_unknown && lk != type_unknown && lk != type_nil) {\n        arena.kind[right] = lk;\n        arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (arena.kind[left] == type_integer && arena.kind[right] == type_integer) {\n        kaku ld = arena.integer_descriptor[left];\n        kaku rd = arena.integer_descriptor[right];\n        moshi (ld != 0 && rd != 0 && ld != rd) { kaesu iie; }\n        moshi (ld == 0 && rd != 0) {\n            arena.integer_descriptor[left] = rd;\n            arena.revision[0] = arena.revision[0] + 1;\n        }\n        moshi (rd == 0 && ld != 0) {\n            arena.integer_descriptor[right] = ld;\n            arena.revision[0] = arena.revision[0] + 1;\n        }\n    }\n    // Nil is a comparison alternative, never a reason to rebox the peer.\n    kaesu lk == rk || lk == type_unknown || rk == type_unknown || lk == type_nil || rk == type_nil ||\n    (lk == type_float_any && (rk == type_float32 || rk == type_float64)) ||\n    (rk == type_float_any && (lk == type_float32 || lk == type_float64));\n}\n\n// Array storage and SSA scalar slots have independent raw/boxed ABIs.\n// Reference elements retain their complete shape edges; scalar links relate\n// base kinds and convert at stores/loads instead of merging representations.\nwaza type_array_link(arena: TypeArena, receiver: int64, value: int64, write: bool) -> bool {\n    kaku element = type_array_element(arena, receiver);\n    moshi (element < 0) { kaesu iie; }\n    moshi (!type_same_kind(arena, element, value, hai)) { kaesu iie; }\n    kaku root = type_root(arena, receiver);\n    kaku er = type_root(arena, element);\n    kaku vr = type_root(arena, value);\n    kaku kind = arena.kind[er];\n    moshi (kind == type_array_ref || kind == type_struct_ref || kind == type_enum_ref || kind == type_function_ref || kind == type_map_ref || kind == type_string_id) {\n        kaesu type_join(arena, element, value);\n    }\n    kaku descriptor = arena.array_descriptor[root];\n    kaku boxed = arena.nullable[er];\n    moshi (descriptor != 0) { boxed = descriptor >= 128; }\n    sore { moshi (write && (arena.nullable[vr] || arena.kind[vr] == type_nil)) { boxed = hai; } }\n    moshi (boxed != arena.nullable[er]) {\n        arena.nullable[er] = boxed;\n        arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (write && arena.kind[vr] == type_nil && descriptor > 0 && descriptor < 128) { kaesu iie; }\n    moshi (!write && boxed && !arena.nullable[vr]) {\n        arena.nullable[vr] = hai;\n        arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (kind == type_unknown && arena.kind[vr] == type_nil && write) {\n        arena.kind[er] = type_nil;\n        arena.revision[0] = arena.revision[0] + 1;\n    }\n    kaesu hai;\n}\n\n// Conservative inter-function reachability: static calls and every function\n// value/closure retain their targets, including mutually recursive closures.\nkoukai waza reachable_functions(file: mochi.File) -> []bool {\n    kaesu reachable_from(file, empty_scalar_exports());\n}\n\nkoukai kata ScalarExport { id: int64; signature: cabi.Signature; }\n\n// Stage A uses untyped Mochi. Materialize one element so its analysis\n// learns the nested signature shape even in compilers without dylib support.\nwaza empty_scalar_exports() -> []ScalarExport {\n    kaku prototype = cabi.Signature { symbol: \"\", result: 0, parameters: [0], valid: iie, indirect: iie };\n    kaku exports = [ScalarExport { id: -1, signature: prototype }];\n    array.truncate(exports, 0);\n    kaesu exports;\n}\n\nkoukai waza reachable_from(file: mochi.File, exports: []ScalarExport) -> []bool {\n    kaku reached = array.make[bool](len(file.functions), iie);\n    kaku queue: []int64 = [-1];\n    // Exported functions (`export \"symbol\"`, kiso/aot/cabi) are entry points of a shared library: roots like the main program.\n    kaku root = 0;\n    aida (root < len(file.functions)) {\n        moshi (cabi.is_export(file.functions[root].name)) { reached[root] = hai; array.push(queue, root); }\n        root = root + 1;\n    }\n    root = 0;\n    aida (root < len(exports)) {\n        kaku id = exports[root].id;\n        moshi (!reached[id]) { reached[id] = hai; array.push(queue, id); }\n        root = root + 1;\n    }\n    kaku next = 0;\n    aida (next < len(queue)) {\n        kaku id = queue[next];\n        next = next + 1;\n        kaku data = file.instructions;\n        moshi (id >= 0) { data = file.functions[id].instructions; }\n        kaku at = 0;\n        aida (at < len(data)) {\n            kaku op = int64(data[at]);\n            kaku width = type_instruction_width(op);\n            moshi (width == 0 || at + width > len(data)) { kaesu array.make[bool](len(file.functions), hai); }\n            moshi (op == 25 || op == 44 || op == 46) {\n                kaku target = type_u16(data, at);\n                moshi (target >= 0 && target < len(reached) && !reached[target]) {\n                    reached[target] = hai;\n                    array.push(queue, target);\n                }\n            }\n            at = at + width;\n        }\n    }\n    kaesu reached;\n}\n\n// Self-hosted v14 preserves generic array forwarding functions. Specialize\n// their exact bodies at static call sites, without merging unrelated []T.\nkoukai waza array_forward_opcode(function: mochi.Function) -> int64 {\n    kaku data = function.instructions;\n    kaku count = function.parameter_count;\n    moshi (len(function.captures) != 0 || count < 1 || count > 2 || function.local_count != count || len(data) < count * 3 + 2) { kaesu 0; }\n    kaku i = 0;\n    aida (i < count) {\n        moshi (data[i * 3] != uint8(24) || data[i * 3 + 1] != uint8(0) || data[i * 3 + 2] != uint8(i)) { kaesu 0; }\n        i = i + 1;\n    }\n    kaku opcode = int64(data[count * 3]);\n    moshi (opcode < 57 || opcode > 64) { kaesu 0; }\n    kaku parameters = 2;\n    kaku returns = iie;\n    moshi (opcode == 58 || opcode == 60 || opcode == 62) { parameters = 1; }\n    moshi (opcode == 57 || opcode == 58 || opcode == 60 || opcode == 62) { returns = hai; }\n    kaku width = type_instruction_width(opcode);\n    kaku last = 26;\n    moshi (returns) {\n        last = 27;\n    }\n    moshi (count != parameters || function.returns_value != returns || len(data) != count * 3 + width + 1 || int64(data[len(data) - 1]) != last) {\n        kaesu 0;\n    }\n    // Constructors must carry the generic descriptor, not a fixed element ABI.\n    moshi ((opcode == 57 || opcode == 58) && data[count * 3 + 1] != uint8(0)) { kaesu 0; }\n    kaesu opcode;\n}\n\n// A width-polymorphic predicate has no shared argument representation. Match\n// the complete bytecode body, rather than trusting a source function name.\nkoukai waza is_float_predicate(function: mochi.Function) -> bool {\n    kaku data = function.instructions;\n    kaesu function.parameter_count == 1 && function.returns_value && len(function.captures) == 0 &&\n    len(data) == 7 && data[0] == uint8(24) && data[1] == uint8(0) && data[2] == uint8(0) &&\n    data[3] == uint8(54) && data[4] >= uint8(6) && data[4] <= uint8(8) && data[5] == uint8(1) && data[6] == uint8(27);\n}\n\n// Exact, effect-free parameter forwarding has a representation-polymorphic\n// ABI. Preserve its call-site edge instead of unifying unrelated instances.\n// This is a body proof, independent of names and source generic annotations.\nkoukai waza forwarded_parameter(function: mochi.Function) -> int64 {\n    kaku data = function.instructions;\n    moshi (!function.returns_value || len(function.captures) != 0 || len(data) != 4 ||\n        data[0] != uint8(24) || data[3] != uint8(27)) { kaesu -1; }\n    kaku parameter = type_u16(data, 0);\n    moshi (parameter >= function.parameter_count) { kaesu -1; }\n    kaesu parameter;\n}\n\nwaza constrain_c_scalar(arena: TypeArena, slot: int64, kind: int64) -> unit {\n    moshi (kind == 105) { type_require(arena, slot, type_float32); kaesu; }\n    moshi (kind == 106) { type_require(arena, slot, type_float64); kaesu; }\n    moshi (kind == 108) { type_require(arena, slot, type_bool); kaesu; }\n    type_require(arena, slot, type_integer);\n    kaku descriptor = 1;\n    moshi (kind == 97) { descriptor = 12; }\n    moshi (kind == 98) { descriptor = 15; }\n    moshi (kind == 99) { descriptor = 13; }\n    moshi (kind == 100) { descriptor = 16; }\n    moshi (kind == 101) { descriptor = 14; }\n    moshi (kind == 102) { descriptor = 17; }\n    arena.integer_descriptor[type_root(arena, slot)] = descriptor;\n}\n\nkoukai waza analyze_types(file: mochi.File) -> TypeAnalysis {\n    kaesu analyze_types_traced(file, iie);\n}\n\n// Optional provenance records: [instruction detail, value node, peer node,\n// reason (1: nullable propagation, 2: nil alternative, 3: explicit nullable)].\nkoukai waza analyze_types_traced(file: mochi.File, trace: bool) -> TypeAnalysis {\n    kaesu analyze_types_from(file, trace, empty_scalar_exports());\n}\n\nkoukai waza analyze_export_types(file: mochi.File, exports: []ScalarExport) -> TypeAnalysis {\n    kaesu analyze_types_from(file, iie, exports);\n}\n\nwaza analyze_types_from(file: mochi.File, trace: bool, exports: []ScalarExport) -> TypeAnalysis {\n    kaku arena = type_arena();\n    arena.trace[0] = trace;\n    kaku function_reachable = reachable_from(file, exports);\n    kaku globals: []int64 = [];\n    kaku index = 0;\n    aida (index < file.global_count) {\n        array.push(globals, type_new(arena, type_unknown));\n        index = index + 1;\n    }\n    kaku locals: [][]int64 = [];\n    kaku returns: []int64 = [];\n    kaku upvalues: [][]int64 = [];\n    kaku cells: [][]bool = [];\n    index = 0;\n    aida (index < len(file.functions)) {\n        kaku slots: []int64 = [];\n        kaku slot = 0;\n        aida (slot < file.functions[index].local_count) {\n            array.push(slots, type_new(arena, type_unknown));\n            slot = slot + 1;\n        }\n        array.push(locals, slots);\n        kaku uv: []int64 = [];\n        kaku ci = 0;\n        aida (ci < len(file.functions[index].captures)) {\n            array.push(uv, type_new(arena, type_unknown));\n            ci = ci + 1;\n        }\n        array.push(upvalues, uv);\n        array.push(cells, array.make[bool](len(slots), iie));\n        kaku result = -1;\n        moshi (file.functions[index].returns_value) {\n            result = type_new(arena, type_unknown);\n        }\n        array.push(returns, result);\n        moshi (is_testing_report(file.functions[index].name) && len(slots) == 2) {\n            type_require(arena, slots[0], type_bool);\n            type_require(arena, slots[1], type_string_id);\n        }\n        kaku function = file.functions[index];\n        moshi (cabi.is_external(function.name)) {\n            kaku declaration = cabi.signature(function.name, function.parameter_count, function.returns_value);\n            moshi (declaration.valid && len(slots) >= function.parameter_count) {\n                kaku parameter = 0;\n                aida (parameter < function.parameter_count) {\n                    moshi (declaration.parameters[parameter] != 109) { constrain_c_scalar(arena, slots[parameter], declaration.parameters[parameter]); }\n                    parameter = parameter + 1;\n                }\n                moshi (