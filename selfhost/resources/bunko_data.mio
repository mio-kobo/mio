isp(parameters, capture.index), is_reference_node(analysis, node));\n            }\n            moshi (!capture.local) {\n                moshi (function_id < 0) { kaesu \"CAPTURE_OUTSIDE_FUNCTION\"; }\n                x86_64.mov_load(code, x86_64.rax, x86_64.rbp, 16 + 8 * parameters);\n                x86_64.mov_load(code, x86_64.rax, x86_64.rax, 40);\n                x86_64.mov_load(code, x86_64.rax, x86_64.rax, 24 + 8 * capture.index);\n            }\n            x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 0);\n            x86_64.mov_store(code, x86_64.rcx, 24 + 8 * index, x86_64.rax);\n            index = index + 1;\n        }\n    }\n    moshi (count == 0) { x86_64.mov_ri(code, x86_64.rax, 0); x86_64.push_r(code, x86_64.rax); }\n    x86_64.mov_ri(code, x86_64.rax, 56);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_ri(code, x86_64.rcx, 56 * 256 + 7);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, target);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, callee.parameter_count);\n    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rcx);\n    kaku returns = 0;\n    moshi (callee.returns_value) { returns = 1; }\n    x86_64.mov_ri(code, x86_64.rcx, returns);\n    x86_64.mov_store(code, x86_64.rax, 32, x86_64.rcx);\n    x86_64.pop_r(code, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rax, 40, x86_64.rcx);\n    x86_64.lea_label(code, x86_64.rcx, function_label(target));\n    x86_64.mov_store(code, x86_64.rax, 48, x86_64.rcx);\n    push(code, x86_64.rax);\n    kaesu \"\";\n}\n\n// 0 = not a float, 1 = float32, 2 = float64 (an unresolved float literal counts as float64).\nwaza float_kind(analysis: types.TypeAnalysis, node: int64) -> int64 {\n    moshi (node < 0) { kaesu 0; }\n    kaku kind = types.type_kind(analysis, node);\n    moshi (kind == types.type_float32) { kaesu 1; }\n    moshi (kind == types.type_float64 || kind == types.type_float_any) { kaesu 2; }\n    kaesu 0;\n}\n\n// Float predicate on the raw bits in rax for width fk (1 float32, 2 float64): primitive 6 is_nan, 7 is_inf,\n// 8 is_finite -> rax = 0/1. Clobbers rcx, rdx, xmm0.\nwaza emit_float_predicate(code: x86_64.Assembler, fk: int64, primitive: int64) -> unit {\n    kaku double = fk == 2;\n    moshi (primitive == 6) {\n        emit_float_load(code, fk, 0, x86_64.rax); x86_64.ucomis(code, double, 0, 0); x86_64.setcc_rax(code, 10);\n    }\n    moshi (primitive == 7 || primitive == 8) {\n        // exponent field all ones: infinity or NaN; infinity has a zero fraction\n        kaku bits = 52; kaku mask = 2047; kaku infinity = 9218868437227405312;\n        moshi (fk == 1) { bits = 23; mask = 255; infinity = 2139095040; x86_64.mov_ri(code, x86_64.rcx, 4294967295); x86_64.and_rr(code, x86_64.rax, x86_64.rcx); }\n        x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n        x86_64.shr_ri(code, x86_64.rcx, bits);\n        x86_64.and_ri(code, x86_64.rcx, mask);\n        x86_64.cmp_ri(code, x86_64.rcx, mask);\n        moshi (primitive == 8) { x86_64.setcc_rax(code, x86_64.cc_ne); }\n        moshi (primitive == 7) {\n            x86_64.setcc_rcx(code, x86_64.cc_e);\n            x86_64.mov_ri(code, x86_64.rdx, infinity);\n            moshi (fk == 1) { x86_64.and_ri(code, x86_64.rax, 2147483647); }\n            moshi (fk == 2) { x86_64.shl_ri(code, x86_64.rax, 1); x86_64.shr_ri(code, x86_64.rax, 1); }\n            x86_64.cmp_rr(code, x86_64.rax, x86_64.rdx);\n            x86_64.setcc_rax(code, x86_64.cc_e);\n            x86_64.and_rr(code, x86_64.rax, x86_64.rcx);\n        }\n    }\n}\n\n// xmm0 <- rax, xmm1 <- rcx for the given float kind (1 or 2).\nwaza emit_float_load(code: x86_64.Assembler, kind: int64, xmm: int64, reg: int64) -> unit {\n    moshi (kind == 2) { x86_64.movq_xmm_r(code, xmm, reg); }\n    moshi (kind == 1) { x86_64.movd_xmm_r(code, xmm, reg); }\n}\nwaza emit_float_store(code: x86_64.Assembler, kind: int64, reg: int64, xmm: int64) -> unit {\n    moshi (kind == 2) { x86_64.movq_r_xmm(code, reg, xmm); }\n    moshi (kind == 1) { x86_64.movd_r_xmm(code, reg, xmm); }\n}\n\n\n// Nullable scalars (int64?, bool?, float64? ...) are boxed: a pointer to a kind-11 object holding the value at\n// [16], or 0 for nil. Every stack/storage slot whose analysis type is a nullable scalar holds such a box.\nwaza unbox_node(code: x86_64.Assembler, analysis: types.TypeAnalysis, node: int64, reg: int64) -> unit {\n    moshi (node >= 0 && nullable_scalar(analysis, node)) {\n        x86_64.test_rr(code, reg, reg);\n        x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n        x86_64.mov_load(code, reg, reg, 16);\n    }\n}\n\nwaza nilish(analysis: types.TypeAnalysis, node: int64) -> bool {\n    kaesu node >= 0 && (types.type_nullable(analysis, node) || types.type_kind(analysis, node) == types.type_nil);\n}\n\n// Convert the value in rax between the representation of `source` and of `target` (box <-> raw).\n// Clobbers rcx, rdx, r8, r9 when it boxes.\nwaza convert_scalar(code: x86_64.Assembler, analysis: types.TypeAnalysis, source: int64, target: int64) -> unit {\n    moshi (source < 0 || target < 0) { kaesu; }\n    moshi (types.type_kind(analysis, source) == types.type_nil) { kaesu; }\n    kaku source_box = nullable_scalar(analysis, source);\n    kaku target_box = nullable_scalar(analysis, target);\n    moshi (source_box && !target_box) { unbox_node(code, analysis, source, x86_64.rax); }\n    moshi (!source_box && target_box) { x86_64.call(code, \"rt.box_scalar\"); }\n}\n\nwaza nil_equality(analysis: types.TypeAnalysis, function_id: int64, offset: int64, opcode: int64) -> bool {\n    moshi (opcode != 11 && opcode != 12) { kaesu iie; }\n    kaesu (nilish(analysis, stack_node(analysis, function_id, offset, 0)) || nilish(analysis, stack_node(analysis, function_id, offset, 1))) && !operand_is_string(analysis, function_id, offset);\n}\n\n// Element node of the array whose analysis node is `array_node` (-1 when unknown).\nwaza element_node(analysis: types.TypeAnalysis, array_node: int64) -> int64 {\n    moshi (array_node < 0 || types.type_kind(analysis, array_node) != types.type_array_ref) { kaesu -1; }\n    kaesu types.type_array_element(analysis.arena, array_node);\n}\n\nwaza raw_producer(opcode: int64) -> bool {\n    kaesu opcode == 1 || opcode == 8 || opcode == 9 || opcode == 10 || opcode == 34 || opcode == 7 || opcode == 2 ||\n        (opcode >= 4 && opcode <= 6) || (opcode >= 11 && opcode <= 16) || (opcode >= 28 && opcode <= 29) ||\n        (opcode >= 50 && opcode <= 55) || opcode == 32 || opcode == 60;\n}\n\nwaza emit_box_runtime(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.box_scalar\");\n    x86_64.mov_rr(code, x86_64.r9, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 24);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_ri(code, x86_64.rcx, 24 * 256 + 11);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.r9);\n    x86_64.ret(code);\n}\n\nwaza nullable_scalar_descriptor(descriptor: int64) -> bool {\n    kaku kind = descriptor - (descriptor / 128) * 128;\n    kaesu descriptor >= 128 && (kind == 1 || kind == 4 || kind == 2 || kind == 3 || (kind >= 12 && kind <= 17));\n}\n\nwaza supported(opcode: int64) -> bool {\n    kaesu (opcode >= 1 && opcode <= 20) || opcode == 22 || (opcode >= 23 && opcode <= 27) || (opcode >= 30 && opcode <= 40) || opcode == 28 || opcode == 29 || (opcode >= 50 && opcode <= 53) || opcode == 49 || (opcode >= 44 && opcode <= 48) || opcode == 66 || opcode == 67 || (opcode >= 41 && opcode <= 43) || opcode == 54 || opcode == 55 || (opcode >= 56 && opcode <= 65) || opcode == 21;\n}\n\n\nwaza stack_node(analysis: types.TypeAnalysis, function_id: int64, offset: int64, depth: int64) -> int64 {\n    kaku entries = analysis.blocks[function_id + 1].entry[offset];\n    moshi (depth >= len(entries)) { kaesu -1; }\n    kaesu entries[len(entries) - 1 - depth];\n}\n\nwaza scalar_kind(kind: int64) -> bool {\n    kaesu kind == types.type_integer || kind == types.type_bool || kind == types.type_float32 || kind == types.type_float64 || kind == types.type_float_any;\n}\n\n// Nullable scalars are boxed by the ARM64 backend; this backend does not support them yet.\nwaza nullable_scalar(analysis: types.TypeAnalysis, node: int64) -> bool {\n    kaesu types.type_nullable(analysis, node) && scalar_kind(types.type_kind(analysis, node));\n}\n\nwaza is_reference_node(analysis: types.TypeAnalysis, node: int64) -> bool {\n    kaesu types.type_is_heap_reference(analysis, node);\n}\n\n// Wrap rax to the fixed-width integer type described by `descriptor` (12..17 = int8..uint32 as in the analysis).\nwaza emit_normalize(code: x86_64.Assembler, descriptor: int64) -> unit {\n    moshi (descriptor < 12 || descriptor > 17) { kaesu; }\n    kaku width = 8;\n    moshi (descriptor == 13 || descriptor == 16) { width = 16; }\n    moshi (descriptor == 14 || descriptor == 17) { width = 32; }\n    x86_64.shl_ri(code, x86_64.rax, 64 - width);\n    moshi (descriptor <= 14) { x86_64.sar_ri(code, x86_64.rax, 64 - width); }\n    moshi (descriptor > 14) { x86_64.shr_ri(code, x86_64.rax, 64 - width); }\n}\n\nwaza array_width(descriptor: int64) -> int64 {\n    moshi (descriptor == 15) { kaesu 1; }\n    kaesu 8;\n}\nwaza array_is_reference(descriptor: int64) -> bool {\n    kaku nullable = descriptor >= 128;\n    kaku kind = descriptor - (descriptor / 128) * 128;\n    kaesu nullable || kind == 5 || kind == 7 || kind == 8 || kind == 9 || kind == 10 || kind == 11;\n}\nwaza inferred_descriptor(analysis: types.TypeAnalysis, node: int64) -> int64 {\n    kaku root = node;\n    aida (analysis.arena.parent[root] != root) { root = analysis.arena.parent[root]; }\n    kaku fields = analysis.arena.fields[root];\n    moshi (len(fields) == 0) { kaesu -1; }\n    kaku element = fields[0];\n    kaku kind = types.type_kind(analysis, element);\n    moshi (kind == types.type_unknown) { kaesu -1; }\n    kaku descriptor = 1;\n    moshi (analysis.arena.array_width[root] == 1) { descriptor = 15; }\n    moshi (kind == types.type_string_id) { descriptor = 5; }\n    moshi (kind == types.type_array_ref) { descriptor = 7; }\n    moshi (kind == types.type_struct_ref) { descriptor = 8; }\n    moshi (kind == types.type_enum_ref) { descriptor = 9; }\n    moshi (kind == types.type_map_ref) { descriptor = 10; }\n    moshi (kind == types.type_function_ref) { descriptor = 11; }\n    moshi (types.type_nullable(analysis, element)) { descriptor = descriptor + 128; }\n    kaesu descriptor;\n}\n\n// rdi = length, rsi = capacity are set by the caller; this loads width/reference and calls rt.array_new.\nwaza emit_array_new_call(code: x86_64.Assembler, descriptor: int64) -> unit {\n    x86_64.mov_ri(code, x86_64.rdx, array_width(descriptor));\n    kaku reference = 0;\n    moshi (array_is_reference(descriptor)) { reference = 1; }\n    x86_64.mov_ri(code, x86_64.r8, reference);\n    x86_64.call(code, \"rt.array_new\");\n}\n\n// Allocates a struct (kind 1) or enum (kind 2) with `count` payload words taken from the stack.\nwaza emit_record(code: x86_64.Assembler, analysis: types.TypeAnalysis, function_id: int64, offset: int64,\n    kind: int64, tag: int64, count: int64) -> string {\n    moshi (count > 62) { kaesu \"UNSUPPORTED_LARGE_RECORD\"; }\n    kaku bitmap = 0;\n    kaku power = 1;\n    kaku field = 0;\n    aida (field < count) {\n        kaku node = stack_node(analysis, function_id, offset, count - 1 - field);\n        moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n        moshi (types.type_kind(analysis, node) == types.type_unknown) { kaesu \"UNSUPPORTED_UNKNOWN_FIELD\"; }\n        moshi (is_reference_node(analysis, node)) { bitmap = bitmap + power; }\n        power = power * 2;\n        field = field + 1;\n    }\n    kaku size = 40 + 8 * count;\n    x86_64.mov_ri(code, x86_64.rax, size);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_ri(code, x86_64.rcx, size * 256 + kind);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, count);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, bitmap);\n    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, tag);\n    x86_64.mov_store(code, x86_64.rax, 32, x86_64.rcx);\n    field = count;\n    aida (field > 0) {\n        field = field - 1;\n        pop(code, x86_64.rcx);\n        x86_64.mov_store(code, x86_64.rax, 40 + 8 * field, x86_64.rcx);\n    }\n    push(code, x86_64.rax);\n    kaesu \"\";\n}\n\n// Dereference a record in rax and load payload word `index` (null checked).\nwaza emit_record_load(code: x86_64.Assembler, index: int64) -> unit {\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 40 + 8 * index);\n}\n\nwaza emit_array_op_check(analysis: types.TypeAnalysis, function_id: int64, offset: int64, depth: int64) -> string {\n    kaku node = stack_node(analysis, function_id, offset, depth);\n    moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n    moshi (types.type_kind(analysis, node) != types.type_array_ref) { kaesu \"UNSUPPORTED_ARRAY_OPERAND\"; }\n    kaesu \"\";\n}\n\n// True when the two operands on top of the stack at `offset` are strings.\nwaza operand_is_string(analysis: types.TypeAnalysis, function_id: int64, offset: int64) -> bool {\n    kaku entries = analysis.blocks[function_id + 1].entry[offset];\n    moshi (len(entries) < 2) { kaesu iie; }\n    kaesu types.type_kind(analysis, entries[len(entries) - 1]) == types.type_string_id && types.type_kind(analysis, entries[len(entries) - 2]) == types.type_string_id;\n}\n\nwaza emit_function(code: x86_64.Assembler, file: mochi.File, analysis: types.TypeAnalysis, index: int64, reachable: bool) -> string {\n    kaku function = file.functions[index];\n    x86_64.label(code, function_label(index));\n    moshi (!reachable) { x86_64.call(code, \"rt.trap.unreachable\"); kaesu \"\"; }\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    moshi (len(function.instructions) == 0 && (types.is_testing_report(function.name) || types.is_testing_packet(function.name))) {\n        moshi (function.parameter_count != 2 || function.returns_value || len(function.captures) != 0) { kaesu \"INVALID_TESTING_REPORT\"; }\n        x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, local_disp(2, 0));\n        unbox_node(code, analysis, analysis.locals[index][0], x86_64.rdi);\n        x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, local_disp(2, 1));\n        x86_64.mov_ri(code, x86_64.rdx, 0);\n        moshi (types.is_testing_packet(function.name)) { x86_64.mov_ri(code, x86_64.rdx, 1); }\n        x86_64.call(code, \"rt.testing_report\");\n        x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp); x86_64.pop_r(code, x86_64.rbp); x86_64.ret(code);\n        kaesu \"\";\n    }\n    moshi (len(function.instructions) == 0) {\n        kaku operation = native_operation(function.name);\n        kaku routine = native_routine(operation);\n        moshi (routine == \"\") { routine = socket_routine(function.name); }\n        moshi (routine == \"\") { routine = \"rt.os_unsupported\"; }\n        moshi (routine != \"rt.os_unsupported\" && function.parameter_count > 6) { kaesu \"UNSUPPORTED_NATIVE_ARITY\"; }\n        kaku registers: []int64 = [x86_64.rdi, x86_64.rsi, x86_64.rdx, x86_64.rcx, x86_64.r8, x86_64.r9];\n        kaku arg = 0;\n        aida (arg < function.parameter_count && routine != \"rt.os_unsupported\") {\n            x86_64.mov_load(code, registers[arg], x86_64.rbp, local_disp(function.parameter_count, arg));\n            arg = arg + 1;\n        }\n        x86_64.call(code, routine);\n        x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp); x86_64.pop_r(code, x86_64.rbp); x86_64.ret(code);\n        kaesu \"\";\n    }\n    kaku locals = function.local_count - function.parameter_count;\n    moshi (locals < 0) { kaesu \"INVALID_LOCAL_COUNT\"; }\n    moshi (locals > 0) {\n        x86_64.mov_ri(code, x86_64.rax, 0);\n        kaku slot = 0;\n        aida (slot < locals) { x86_64.push_r(code, x86_64.rax); slot = slot + 1; }\n    }\n    kaku param = 0;\n    aida (param < function.parameter_count) {\n        moshi (param < len(analysis.cells[index]) && analysis.cells[index][param]) {\n            kaku node = analysis.locals[index][param];\n            emit_new_cell(code, is_reference_node(analysis, node));\n            x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, local_disp(function.parameter_count, param));\n            x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);\n            x86_64.mov_store(code, x86_64.rbp, local_disp(function.parameter_count, param), x86_64.rax);\n        }\n        param = param + 1;\n    }\n    kaku entry_poll = emit_poll(code, file, analysis, index, 0, function.parameter_count);\n    moshi (entry_poll != \"\") { kaesu string.concat(function.name, string.concat(\": \", entry_poll)); }\n    kaku body = emit_block(code, file, analysis, function.instructions, string.concat(\"f\", convert.format_int(index)), index, function.parameter_count);\n    moshi (body != \"\") { kaesu string.concat(function.name, string.concat(\": \", body)); }\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp); x86_64.pop_r(code, x86_64.rbp); x86_64.ret(code);\n    kaesu \"\";\n}\n\n// First-collection threshold in bytes allocated; the default is 32 MiB. Tests use tiny values to force frequent collections.\nkoukai waza compile(file: mochi.File) -> LowerResult { kaesu compile_with_gc_threshold(file, 33554432); }\n\nkoukai waza compile_with_gc_threshold(file: mochi.File, gc_threshold: int64) -> LowerResult {\n    kaesu compile_target(file, gc_threshold, iie);\n}\n\n// macOS x86-64 target: the same lowering and runtime, every Linux system call routed through the darwin_syscall adapter\n// (darwinabi.mio) and the result packaged as a Mach-O executable (kiso/aot/machox64).\nkoukai waza compile_darwin_amd64(file: mochi.File, gc_threshold: int64) -> LowerResult {\n    kaesu compile_target(file, gc_threshold, hai);\n}\n\nwaza compile_target(file: mochi.File, gc_threshold: int64, darwin: bool) -> LowerResult {\n    moshi (gc_threshold < 4096) { kaesu failed(\"INVALID_GC_THRESHOLD\"); }\n    kaku analysis = types.analyze_types(file);\n    kaku code = x86_64.assembler();\n    // dyld enters at LC_MAIN with main(argc, argv, envp): rsi = argv, and argc sits just below it, exactly where the Linux\n    // entry expects its stack pointer. The label darwin_abi makes every x86_64.syscall a call of darwin_syscall.\n    moshi (darwin) { x86_64.label(code, \"darwin_abi\"); x86_64.lea(code, x86_64.rsp, x86_64.rsi, -8); }\n    x86_64.mov_ri(code, x86_64.rcx, initial_sp_cell());\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rsp);\n    x86_64.call(code, \"rt.init\");\n    x86_64.mov_ri(code, x86_64.rcx, gc_state());\n    x86_64.mov_ri(code, x86_64.rax, gc_threshold);\n    x86_64.mov_store(code, x86_64.rcx, 16, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rcx, 64, x86_64.rax);\n    // The main program runs in a frame of its own so that its operand stack is a scannable frame; its saved rbp is 0.\n    x86_64.mov_ri(code, x86_64.rbp, 0);\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    kaku problem = emit_block(code, file, analysis, file.instructions, \"main\", -1, 0);\n    moshi (problem != \"\") { kaesu failed(problem); }\n    moshi (uses_testing(file)) {\n        x86_64.mov_ri(code, x86_64.rdi, 0);\n        moshi (uses_testing_packet(file)) { x86_64.mov_ri(code, x86_64.rdi, 1); }\n        x86_64.call(code, \"rt.testing_finish\");\n    }\n    emit_exit(code, 0);\n    kaku reached = types.reachable_functions(file);\n    kaku index = 0;\n    aida (index < len(file.functions)) {\n        kaku problem = emit_function(code, file, analysis, index, reached[index]);\n        moshi (problem != \"\") { kaesu failed(problem); }\n        index = index + 1;\n    }\n    emit_runtime(code);\n    moshi (darwin) { emit_darwin_abi_runtime(code); }\n    emit_globals_map(code, file, analysis);\n    emit_string_constants(code, file);\n    kaku assembled = x86_64.assemble(code);\n    moshi (assembled.error != \"\") { kaesu failed(assembled.error); }\n    kaku bss = 8192 + 2097152 + 8 * file.global_count + 32;\n    moshi (darwin) {\n        kaku macho_image = machox64.executable(machox64.ImageSpec { code: assembled.bytes, entry_offset: 0, bss_size: bss });\n        moshi (macho_image.error != \"\") { kaesu failed(macho_image.error); }\n        kaesu LowerResult { bytes: macho_image.bytes, error: \"\" };\n    }\n    kaku image = elf.executable(elf.ImageSpec { code: assembled.bytes, entry_offset: 0, bss_size: bss });\n    moshi (image.error != \"\") { kaesu failed(image.error); }\n    kaesu LowerResult { bytes: image.bytes, error: \"\" };\n}\n" }; }
waza data_31() -> File { kaesu File { path: "kiso/aot/lowerlinux/maps.mio", version: "Bunko-v2.1.1", length: 7315, sha256: "344ee3c36a73f4ca496a0f8abb0000773fa3dfca8dc206a93d0cb3e03bf20cd6", source: "yobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/x86_64\";\n\n// Map[K, V] with integer, bool or string keys (the key kinds the language allows and the reference backend supports).\n// Map object (kind 12): [16] head entry. Entry (kind 13, 48 bytes): [16] next, [24] key, [32] value, [40] flags\n// (bit 0: the key is a reference (string), bit 1: the value is a reference). Lookup is a linear walk, a new key is\n// pushed at the front and an existing key is updated in place, exactly like the reference lowering. Values are stored\n// raw: a nullable scalar is unboxed on the way in and boxed again on the way out.\n//\n// rt.map_new -> rax = map\n// rt.map_find: rdi = map, rsi = key, rdx = 1 for string keys -> rax = entry or 0\n// rt.map_set: rdi = map, rsi = key, rdx = value, rcx = flags (bit 0 string key, bit 1 reference value)\nwaza emit_map_runtime(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.map_new\");\n    x86_64.mov_ri(code, x86_64.rax, 24);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_ri(code, x86_64.rcx, 24 * 256 + 12);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.ret(code);\n\n    x86_64.label(code, \"rt.map_find\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.push_r(code, x86_64.rbx);\n    x86_64.push_r(code, x86_64.r12);\n    x86_64.push_r(code, x86_64.r13);\n    x86_64.mov_load(code, x86_64.rbx, x86_64.rdi, 16);\n    x86_64.mov_rr(code, x86_64.r12, x86_64.rsi);\n    x86_64.mov_rr(code, x86_64.r13, x86_64.rdx);\n    x86_64.label(code, \"rt.map_find.loop\");\n    x86_64.test_rr(code, x86_64.rbx, x86_64.rbx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.map_find.none\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rbx, 24);\n    x86_64.test_rr(code, x86_64.r13, x86_64.r13);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.map_find.scalar\");\n    // string keys: pointer equality first, a nil key matches only nil, otherwise compare the bytes\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.r12);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.map_find.hit\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.map_find.next\");\n    x86_64.test_rr(code, x86_64.r12, x86_64.r12);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.map_find.next\");\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.r12);\n    x86_64.call(code, \"rt.string_equal\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.map_find.hit\");\n    x86_64.jmp(code, \"rt.map_find.next\");\n    x86_64.label(code, \"rt.map_find.scalar\");\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.r12);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.map_find.hit\");\n    x86_64.label(code, \"rt.map_find.next\");\n    x86_64.mov_load(code, x86_64.rbx, x86_64.rbx, 16);\n    x86_64.jmp(code, \"rt.map_find.loop\");\n    x86_64.label(code, \"rt.map_find.hit\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rbx);\n    x86_64.jmp(code, \"rt.map_find.done\");\n    x86_64.label(code, \"rt.map_find.none\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.label(code, \"rt.map_find.done\");\n    x86_64.pop_r(code, x86_64.r13);\n    x86_64.pop_r(code, x86_64.r12);\n    x86_64.pop_r(code, x86_64.rbx);\n    x86_64.ret(code);\n\n    x86_64.label(code, \"rt.map_set\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 48);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rdi);\n    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rbp, -32, x86_64.rcx);\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rcx);\n    x86_64.and_ri(code, x86_64.rdx, 1);\n    x86_64.call(code, \"rt.map_find\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.map_set.insert\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -24);\n    x86_64.mov_store(code, x86_64.rax, 32, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -32);\n    x86_64.mov_store(code, x86_64.rax, 40, x86_64.rcx);\n    x86_64.jmp(code, \"rt.map_set.done\");\n    x86_64.label(code, \"rt.map_set.insert\");\n    x86_64.mov_ri(code, x86_64.rax, 48);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_ri(code, x86_64.rcx, 48 * 256 + 13);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 16);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -16);\n    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -24);\n    x86_64.mov_store(code, x86_64.rax, 32, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -32);\n    x86_64.mov_store(code, x86_64.rax, 40, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rdi, 16, x86_64.rax);\n    x86_64.label(code, \"rt.map_set.done\");\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n}\n\n// Opcodes 41 (new), 42 (get) and 43 (set). Returns an error name or \"\".\nwaza emit_map_op(code: x86_64.Assembler, analysis: types.TypeAnalysis, function_id: int64, offset: int64, step: int64, opcode: int64) -> string {\n    moshi (opcode == 41) {\n        x86_64.call(code, \"rt.map_new\");\n        push(code, x86_64.rax);\n        kaesu \"\";\n    }\n    kaku key_depth = 0;\n    moshi (opcode == 43) { key_depth = 1; }\n    kaku key_node = stack_node(analysis, function_id, offset, key_depth);\n    moshi (key_node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n    kaku key_kind = types.type_kind(analysis, key_node);\n    moshi (key_kind != types.type_integer && key_kind != types.type_bool && key_kind != types.type_string_id) { kaesu \"UNSUPPORTED_MAP_KEY\"; }\n    kaku string_key = 0;\n    moshi (key_kind == types.type_string_id) { string_key = 1; }\n    moshi (opcode == 42) {\n        kaku result_node = stack_node(analysis, function_id, offset + step, 0);\n        kaku missing = block_label(\"map_missing\", len(code.bytes));\n        kaku finished = block_label(\"map_done\", len(code.bytes));\n        pop(code, x86_64.rsi); unbox_node(code, analysis, key_node, x86_64.rsi);\n        pop(code, x86_64.rdi);\n        x86_64.mov_ri(code, x86_64.rdx, string_key);\n        x86_64.call(code, \"rt.map_find\");\n        x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n        x86_64.jcc(code, x86_64.cc_e, missing);\n        x86_64.mov_load(code, x86_64.rax, x86_64.rax, 32);\n        moshi (result_node >= 0 && nullable_scalar(analysis, result_node)) { x86_64.call(code, \"rt.box_scalar\"); }\n        x86_64.jmp(code, finished);\n        x86_64.label(code, missing);\n        x86_64.mov_ri(code, x86_64.rax, 0);\n        x86_64.label(code, finished);\n        push(code, x86_64.rax);\n        kaesu \"\";\n    }\n    kaku value_node = stack_node(analysis, function_id, offset, 0);\n    moshi (value_node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n    kaku flags = string_key;\n    moshi (is_reference_node(analysis, value_node) && !nullable_scalar(analysis, value_node)) { flags = flags + 2; }\n    pop(code, x86_64.rdx); unbox_node(code, analysis, value_node, x86_64.rdx);\n    pop(code, x86_64.rsi); unbox_node(code, analysis, key_node, x86_64.rsi);\n    pop(code, x86_64.rdi);\n    x86_64.mov_ri(code, x86_64.rcx, flags);\n    x86_64.call(code, \"rt.map_set\");\n    kaesu \"\";\n}\n" }; }
waza data_32() -> File { kaesu File { path: "kiso/aot/lowerlinux/runtime_fs.mio", version: "Bunko-v2.1.1", length: 36868, sha256: "599ea81a5f95b7bd0c99eca192dec0f9648818730aedfd6cea22396cb11f3713", source: "yobu \"kiso/aot/elf\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// Linux NativeFS bridge for the body-less \"mio/fs/runtime\" functions of kiso/fs.\n// Resource token = generation << 8 | (slot + 1). The 64-slot handle table lives in the data segment:\n// 3 words per slot: fd, state (0 free, 1 open, 10 + code failed), generation.\n// Status codes follow kiso/fs: 0 ok, 1 not found, 2 permission, 3 closed, 4 invalid argument, 5 I/O, 6 no space, 7 invalid path.\nwaza handle_table_base() -> int64 { kaesu elf.data_base + 16; }\nwaza handle_slots() -> int64 { kaesu 64; }\n\nwaza emit_string_object(code: x86_64.Assembler, label: string, text: string) -> unit {\n    x86_64.label(code, label);\n    kaku bytes = string.to_bytes(text);\n    kaku size = 24 + len(bytes);\n    size = size + 7 - ((size + 7) - ((size + 7) / 8) * 8);\n    emit_word(code, 256 * size + 6);\n    emit_word(code, 0);\n    emit_word(code, len(bytes));\n    kaku at = 0;\n    aida (at < len(bytes)) { x86_64.byte(code, int64(bytes[at])); at = at + 1; }\n}\n\nwaza message_for(code: int64) -> string {\n    moshi (code == 1) { kaesu \"no such file or directory\"; }\n    moshi (code == 2) { kaesu \"permission denied\"; }\n    moshi (code == 3) { kaesu \"file already closed\"; }\n    moshi (code == 4) { kaesu \"invalid argument\"; }\n    moshi (code == 6) { kaesu \"no space left on device\"; }\n    moshi (code == 7) { kaesu \"invalid path\"; }\n    kaesu \"input/output error\";\n}\n\nwaza message_label(code: int64) -> string { kaesu string.concat(\"rt.fs.message.\", convert.format_int(code)); }\n\nwaza leave_frame(code: x86_64.Assembler) -> unit {\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code)