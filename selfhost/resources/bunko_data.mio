, arm64.str_x(9, 13, 96));\n    // FILETIME (100 ns since 1601) -> seconds since 1970\n    wx_li(c, 12, 10000000);\n    wx_li(c, 14, 11644473600);\n    kaku times = [2084, 64, 2092, 32, 2100, 48];\n    at = 0;\n    aida (at < len(times)) {\n        wx(c, arm64.ldr_w(9, 31, times[at]));\n        wx(c, arm64.ldr_w(10, 31, times[at] + 4));\n        wx(c, arm64.lsl_x(10, 10, 32));\n        wx(c, arm64.orr_x(9, 9, 10));\n        wx(c, arm64.udiv_x(9, 9, 12));\n        wx(c, arm64.sub_x(9, 9, 14));\n        wx(c, arm64.str_x(9, 13, times[at + 1]));\n        at = at + 2;\n    }\n    wx_free(c, 2304);\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_stat_failed\");\n    wx_fail_last(c, patches, 2304);\n    wx_label(c, \"wx_stat_invalid\");\n    wx_free(c, 2304);\n    wx_b(c, \"wx_inval\");\n\n    // ---- getdirentries64(fd, buffer, nbytes >= 8192, basep) -> GetFileInformationByHandleEx(FileIdBothDirectoryInfo),\n    // converted entry by entry into Darwin dirent64 (ino 0, seekoff 8, reclen 16, namlen 18, type 20, name 21)\n    wx_label(c, \"wx_dirents\");\n    wx_li(c, 9, 8192);\n    wx(c, arm64.cmp_x(2, 9));\n    wx_bcc(c, 2, \"wx_dirents_ok\");\n    wx_b(c, \"wx_inval\");\n    wx_label(c, \"wx_dirents_ok\");\n    wx_alloc(c, 4352);\n    wx(c, arm64.str_x(0, 31, 4096));\n    wx(c, arm64.str_x(1, 31, 4112));\n    wx(c, arm64.str_x(2, 31, 4120));\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_dirents_badfd\");\n    wx(c, arm64.str_x(0, 31, 4104));\n    wx_data(c, patches, base, 10, 64);\n    wx(c, arm64.ldr_x(11, 31, 4096));\n    wx(c, arm64.lsl_x(11, 11, 3));\n    wx(c, arm64.add_x(10, 10, 11));\n    wx(c, arm64.str_x(10, 31, 4136));\n    wx(c, arm64.ldr_x(12, 10, 0));\n    wx_li(c, 1, 11);\n    wx_cbz(c, 12, \"wx_dirents_query\");\n    wx_li(c, 1, 10);\n    wx_label(c, \"wx_dirents_query\");\n    wx(c, arm64.ldr_x(0, 31, 4104));\n    wx(c, arm64.add_imm_x(2, 31, 0, iie));\n    wx_li(c, 3, 4096);\n    wx_call(c, patches, \"GetFileInformationByHandle