 == \"bind_ipv4\") { kaesu \"rt.sock_bind\"; }\n    moshi (name == \"connect_ipv4\") { kaesu \"rt.sock_connect\"; }\n    moshi (name == \"listen\") { kaesu \"rt.sock_listen\"; }\n    moshi (name == \"accept\") { kaesu \"rt.sock_accept\"; }\n    moshi (name == \"read\") { kaesu \"rt.sock_read\"; }\n    moshi (name == \"write\") { kaesu \"rt.sock_write\"; }\n    moshi (name == \"close\") { kaesu \"rt.sock_close\"; }\n    kaesu \"\";\n}\n" }; }
waza data_45() -> File { kaesu File { path: "kiso/aot/lowerwinrt/winos.mio", version: "Bunko-v2.1.1", length: 58647, sha256: "fc3fa48216e0d60f29f9b4435ea2ca03efbb84d6250fde6d9bf8f718f96c09a0", source: "yobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/pe\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// Windows OS layer of the heap-capable lowering. The rest of the package is the Linux runtime (allocator, precise\n// collector, objects) with the ELF/syscall assumptions removed. Everything that touches Windows lives here:\n//  * fixed image base, no relocations: absolute data addresses are constants (data_base) fixed by a two-pass layout;\n//  * KERNEL32 imports are called through `call [rip+rel32]` patched by the PE writer (no DIR64 relocation needed);\n//  * every Win64 boundary routine is a frame-pointer function with unwind info, 16-byte realigned, 32-byte shadow space.\n// Imports (index): 0 GetStdHandle, 1 WriteFile, 2 ExitProcess, 3 VirtualAlloc, 4 CreateFileW, 5 ReadFile, 6 CloseHandle,\n// 7 MultiByteToWideChar, 8 GetLastError, 9 GetFileAttributesW, 10 CreateDirectoryW, 11 FindFirstFileW, 12 FindNextFileW,\n// 13 FindClose, 14 WideCharToMultiByte, 15 GetCommandLineW, 16 GetEnvironmentStringsW, 17 DeleteFileW, 18 RemoveDirectoryW,\n// 19 GetCurrentProcessId, 20 GetTickCount64, 21 GetFullPathNameW.\nkoukai teisu import_get_std_handle = 0;\nkoukai teisu import_write_file = 1;\nkoukai teisu import_exit_process = 2;\nkoukai teisu import_virtual_alloc = 3;\nkoukai teisu import_create_file = 4;\nkoukai teisu import_read_file = 5;\nkoukai teisu import_close_handle = 6;\nkoukai teisu import_multibyte = 7;\nkoukai teisu import_last_error = 8;\nkoukai teisu import_get_attributes = 9;\nkoukai teisu import_create_directory = 10;\nkoukai teisu import_find_first = 11;\nkoukai teisu import_find_next = 12;\nkoukai teisu import_find_close = 13;\nkoukai teisu import_wide_to_multibyte = 14;\nkoukai teisu import_command_line = 15;\nkoukai teisu import_environment_strings = 16;\nkoukai teisu import_delete_file = 17;\nkoukai teisu import_remove_directory = 18;\nkoukai teisu import_process_id = 19;\nkoukai teisu import_tick_count = 20;\nkoukai teisu import_full_path = 21;\n// 22 GetModuleFileNameW (executable path). Process layer (winprocess.mio): 23 CreateProcessW, 24 WaitForSingleObject,\n// 25 GetExitCodeProcess, 26 TerminateProcess, 27 GetStartupInfoW, 28 PeekNamedPipe, 29 GetFileType, 30 Sleep.\nkoukai teisu import_module_file = 22;\nkoukai teisu import_create_process = 23;\nkoukai teisu import_wait_object = 24;\nkoukai teisu import_exit_code = 25;\nkoukai teisu import_terminate_process = 26;\nkoukai teisu import_startup_info = 27;\nkoukai teisu import_peek_pipe = 28;\nkoukai teisu import_file_type = 29;\nkoukai teisu import_sleep = 30;\nkoukai teisu io_failure_exit = 111;\nkoukai teisu heap_reserve = 8589934592;\nkoukai teisu heap_first_commit = 16777216;\nkoukai teisu heap_commit_step = 16777216;\nkoukai teisu mark_stack_size = 536870912;\n\n// Packages cannot hold mutable globals, so the collected unwind records and patches travel in a context.\nkoukai kata WinContext { patches: []pe.Patch; frames: []pe.FrameFunction; sockets: bool; }\n// .data is the first section, at RVA 0x1000 (pe.executable_placed data-first layout): every absolute data address is a\n// link-time constant and the image has no RVA gap.\nkoukai teisu data_rva = 4096;\nkoukai waza data_base() -> int64 { kaesu pe.image_base + data_rva; }\n// Scratch zone between the directory buffers and the Mochi globals (131072 bytes): +0 UTF-16 path buffer (64 KiB),\n// +65536 directory-enumeration state, 64 slots x 1024 bytes: [0] find handle (0 = free), [8] entry pending flag,\n// [16..608) WIN32_FIND_DATAW.\nwaza scratch_path() -> int64 { kaesu data_base() + 8192 + 2097152; }\nwaza dir_state() -> int64 { kaesu scratch_path() + 65536; }\n\nwaza open_frame(code: x86_64.Assembler, name: string, allo