   x86_64.and_rr(code, x86_64.rcx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.mut_slot_alloc.next\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 0);\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.mut_slot_alloc.next\");\n    x86_64.or_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rcx, 1);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rcx, 1);\n    x86_64.or_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rdi);\n    x86_64.shl_ri(code, x86_64.rcx, 4);\n    x86_64.add_rr(code, x86_64.rcx, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rcx, 8, x86_64.rax);\n    x86_64.shr_ri(code, x86_64.rdx, 8);\n    x86_64.shl_ri(code, x86_64.rdx, 16);\n    x86_64.add_ri(code, x86_64.rdi, 1);\n    x86_64.or_rr(code, x86_64.rdx, x86_64.rdi);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.jmp(code, \"rt.mut_slot_alloc.done\");\n    x86_64.label(code, \"rt.mut_slot_alloc.next\");\n    x86_64.add_ri(code, x86_64.rdi, 1);\n    x86_64.jmp(code, \"rt.mut_slot_alloc.scan\");\n    x86_64.label(code, \"rt.mut_slot_alloc.full\");\n    x86_64.mov_ri(code, x86_64.rax, -11);\n    x86_64.jmp(code, \"rt.mut_slot_alloc.done\");\n    x86_64.label(code, \"rt.mut_slot_alloc.nomem\");\n    x86_64.mov_ri(code, x86_64.rax, -12);\n    x86_64.label(code, \"rt.mut_slot_alloc.done\");\n    x86_64.push_r(code, x86_64.rax);\n    x86_64.call(code, \"rt.mut_lock_release\");\n    x86_64.pop_r(code, x86_64.rax);\n    x86_64.ret(code);\n    // slot address: rdi = handle -> rsi = slot address, or 0 when the handle cannot name a slot (clobbers rax, rcx)\n    x86_64.label(code, \"rt.mut_slot_address\");\n    x86_64.mov_ri(code, x86_64.rcx, 65535);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rdi);\n    x86_64.and_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.test