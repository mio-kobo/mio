t(op: int64, index: int64) -> bool {\n    moshi (op >= 32 && op <= 40) {\n        moshi (op == 33 || op == 40) { kaesu index == 1; }\n        moshi (op == 34 || op == 35) { kaesu index == 1 || index == 3; }\n        moshi (op == 36) { kaesu index == 2; }\n        moshi (op == 38 || op == 39) { kaesu index == 1 || index == 4; }\n        kaesu iie;\n    }\n\n    moshi (op == 27 || op == 28 || op == 31) { kaesu hai; }\n    moshi (op == 25) { kaesu index < 5; }\n    moshi (op == 20 || op == 21 || op == 23 || op == 24) { kaesu hai; }\n    moshi (op == 17) { kaesu index == 1; }\n    moshi (op == 18) { kaesu index == 0; }\n    moshi (op == op_open || op == op_open_dir) { kaesu index == 0; }\n    moshi (op == op_stat || op == op_mkdir) { kaesu index == 0 || index == 1; }\n    moshi (op == op_close || op == op_dir_close || op == op_file_status || op == op_dir_status) { kaesu index == 1; }\n    moshi (op == op_read || op == op_write) { kaesu index == 1 || index == 4; }\n    kaesu iie;\n}\n\nkoukai waza returns_reference(op: int64) -> bool {\n    moshi (op >= 32 && op <= 40) { kaesu op != 32 && op != 37; }\n    kaesu op == op_close || op == op_dir_close || op == op_dir_name || op == op_dir_status ||\n        op == op_file_status || op == op_mkdir || op == op_read || op == op_stat || op == op_write;\n}\n\nkoukai waza entry_label(op: int64) -> string {\n    moshi (op == 32) { kaesu \"native_socket_open\"; }\n    moshi (op == 33) { kaesu \"native_socket_status\"; }\n    moshi (op == 34) { kaesu \"native_socket_bind_ipv4\"; }\n    moshi (op == 35) { kaesu \"native_socket_connect_ipv4\"; }\n    moshi (op == 36) { kaesu \"native_socket_listen\"; }\n    moshi (op == 37) { kaesu \"native_socket_accept\"; }\n    moshi (op == 38) { kaesu \"native_socket_read\"; }\n    moshi (op == 39) { kaesu \"native_socket_write\"; }\n    moshi (op == 40) { kaesu \"native_socket_close\"; }\n\n    moshi(op==31){kaesu \"nativeos_real_path\";}\n    moshi (op == 30) { kaesu \"nativeos_stdin_wait\"; }\n   