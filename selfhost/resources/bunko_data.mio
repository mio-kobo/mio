        k=k+1;\n    }\n    attached_restore(c);\n}\n// Test-only rendezvous. The worker stays parked while the coordinator\n// enters a real stopped Epoch. The coordinator observes the waiter reach\n// THREAD_GC_PARKED inside native_leave before allowing collection to proceed.\nwaza emit_wait_gc_test(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {\n    attached_save(c,\"runtime_alloc_test_command\");\n    emit(c,arm64.ldr_x(9,31,152));\n    arm64.assembler_cbnz_x(c,9,\"runtime_alloc_test_read\");\n    wr_current(c,p,first);wr_addr(c,9,0,wr_wait_test_arm);\n    emit(c,arm64.movz_x(10,1,0));emit(c,arm64.str_x(10,9,0));\n    arm64.assembler_b(c,\"runtime_alloc_test_read\");\n    arm64.assembler_label(c,\"runtime_alloc_test_read\");\n    wr_main_word(c,p,first,9,wr_wait_test_phase);emit(c,arm64.ldar_x(10,9));\n    emit(c,arm64.str_x(10,31,144));attached_restore(c);\n\n    arm64.assembler_label(c,\"runtime_alloc_test_parked\");\n    wr_main_word(c,p,first,9,wr_wait_test_phase);\n    emit(c,arm64.movz_x(10,1,0));emit(c,arm64.stlr_x(10,9));\n    arm64.assembler_label(c,\"runtime_alloc_test_wait_stop\");\n    emit(c,arm64.ldar_x(10,9));emit(c,arm64.cmp_imm_x(10,2,iie));arm64.assembler_b_cond(c,1,\"runtime_alloc_test_wait_stop\");\n    arm64.assembler_bl(c,\"attached_native_leave\");\n    wr_main_word(c,p,first,9,wr_wait_test_gc_count);emit(c,arm64.ldr_x(10,9,0));\n    emit(c,arm64.ldr_x(11,23,16));emit(c,arm64.cmp_x(11,10));arm64.assembler_b_cond(c,9,\"runtime_error\");\n    wr_main_word(c,p,first,9,wr_wait_test_phase);\n    emit(c,arm64.movz_x(10,3,0));emit(c,arm64.stlr_x(10,9));\n    wr_main_word(c,p,first,9,wr_wait_test_ctx);emit(c,arm64.stlr_x(31,9));\n    arm64.assembler_b(c,\"runtime_alloc_retry_reload\");\n\n    attached_save(c,\"runtime_alloc_test_stopped\");\n    wr_main_word(c,p,first,9,wr_wait_test_phase);\n    emit(c,arm64.ldar_x(10,9));emit(c,arm64.cmp_imm_x(10,1,iie));arm64.assembler_b_cond(c,1,\"runtime_alloc_test_stopped_done\");\n    wr_main