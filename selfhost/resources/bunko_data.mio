de == 58) && !valid_descriptor(first)) { kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: first }; }\n        moshi (opcode == 17 || opcode == 18) { array.push(jump_offsets, offset); array.push(jump_targets, first); }\n        offset = offset + width;\n    }\n    kaku index = 0;\n    aida (index < len(jump_targets)) {\n        kaku target = jump_targets[index];\n        moshi (target > len(data) || !boundaries[target]) {\n            kaesu DecodeError { kind: DecodeErrorKind.InvalidJump(), offset: jump_offsets[index], detail: target };\n        }\n        index = index + 1;\n    }\n    kaesu mu;\n}\n\nwaza read_constant(input: binary.BinaryReader, version: int64) -> DecodeResult {\n    kaku tag_offset = binary.reader_offset(input);\n    kaku tag_result = binary.reader_read_u8(input);\n    moshi (tag_result.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), tag_offset, 1); }\n    kaku tag = tag_result.value;\n    moshi (tag == uint8(1) || tag == uint8(3)) {\n        moshi (tag == uint8(3) && version < 3) { kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag)); }\n        kaku wide = binary.reader_read_u64_be(input);\n        moshi (wide.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 8); }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: wide.value, data: [] });\n        kaesu DecodeResult { value: File { version: version, constants: constants, global_count: 0,\n            instructions: [], functions: [] }, error: mu };\n    }\n    moshi (tag == uint8(2)) {\n        kaku length_at = binary.reader_offset(input);\n        kaku length = binary.reader_read_u32_be(input);\n        moshi (length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), length_at, 4); }\n        moshi (int64(length.value) > MAX_STRING_BYTES) { kaesu failure(DecodeErrorKind.LimitExceeded(), length_at, int64(length.value)