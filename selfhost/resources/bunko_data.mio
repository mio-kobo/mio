, \"wx_ok\");\n    wx_label(c, \"wx_setrlimit\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n\n    // execve(path, argv, envp) -> CreateProcessW; in the emulated child the parent resumes with the child's status, otherwise\n    // this process exits with it (Windows has no exec). Frame 2304: 0 outgoing stack arguments, 16 UTF-16 path (2048 bytes),\n    // 2064 scratch buffer, 2072 argv, 2080 path, 2088 timeout, 2112 STARTUPINFOW (104), 2216 PROCESS_INFORMATION (24),\n    // 2240 lpReserved2 table (40), 2288 exit code.\n    wx_label(c, \"wx_execve\");\n    wx_alloc(c, 2304);\n    wx_str(c, 0, 2080);\n    wx_str(c, 1, 2072);\n    wx_li(c, 0, 65001);\n    wx_li(c, 1, 0);\n    wx_ldr(c, 2, 2080);\n    wx(c, arm64.movn_x(3, 0, 0));\n    wx(c, arm64.add_imm_x(4, 31, 16, iie));\n    wx_li(c, 5, 1024);\n    wx_call(c, patches, \"MultiByteToWideChar\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"wx_exec_inval\");\n    wx_li(c, 0, 0);\n    wx_li(c, 1, 262144);\n    wx_li(c, 2, 12288);\n    wx_li(c, 3, 4);\n    wx_call(c, patches, \"VirtualAlloc\");\n    wx_cbz(c, 0, \"wx_exec_nomem\");\n    wx_str(c, 0, 2064);\n    // command line: every argument quoted with the CommandLineToArgvW rules, UTF-8, at the start of the scratch buffer\n    wx_mov(c, 9, 0);\n    wx_ldr(c, 10, 2072);\n    wx_li(c, 16, 1);\n    wx_label(c, \"wx_quote_arg\");\n    wx(c, arm64.ldr_x(11, 10, 0));\n    wx_cbz(c, 11, \"wx_quote_done\");\n    wx_cbnz(c, 16, \"wx_quote_first\");\n    wx_li(c, 17, 32);\n    wx(c, arm64.strb_w(17, 9, 0));\n    wx(c, arm64.add_imm_x(9, 9, 1, iie));\n    wx_label(c, \"wx_quote_first\");\n    wx_li(c, 16, 0);\n    wx_li(c, 14, 0);\n    wx_mov(c, 15, 11);\n    wx(c, arm64.ldrb_w(12, 15, 0));\n    wx_cbnz(c, 12, \"wx_quote_scan\");\n    wx_li(c, 14, 1);\n    wx_label(c, \"wx_quote_scan\");\n    wx(c, arm64.ldrb_w(12, 15, 0));\n    wx_cbz(c, 12, \"wx_quote_scanned\");\n    wx_cmpi(c, 12, 32);\n    wx_bcc(c, 0, \"wx_quote_special\");\n    wx_cmpi(c, 12, 9);\n    wx_bcc(c, 0, \"wx_quote_