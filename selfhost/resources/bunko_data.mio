waza data_28() -> File { kaesu File { path: "kiso/aot/lowerlinux/darwinabi.mio", version: "Bunko-v2.1.1", length: 19388, sha256: "b17c5a1febba38b6aa0fb55f156be2a3507144a69e5ca416bb4bec0243ff5c5c", source: "yobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// macOS x86-64 operating-system adapter for the Linux x86-64 lowering.\n//\n// The Linux lowering reaches the kernel only through x86_64.syscall (number in eax, arguments in rdi rsi rdx r10 r8 r9,\n// result or -errno in rax, all other registers except rcx and r11 preserved). With the label `darwin_abi` defined (see\n// x86_64.syscall) each such instruction becomes `call darwin_syscall`, emitted here. The routine performs the equivalent\n// Darwin BSD call (number | 0x2000000; error = carry flag set and a positive Darwin errno in rax) and returns the Linux\n// convention: it translates numbers, open/mmap flags, the stat and directory-entry layouts, sockaddr_in, the fork result\n// and the errno values; /proc/self/exe and /proc/self/fd/N are answered with proc_info and fcntl(F_GETPATH);\n// CLOCK_MONOTONIC is served from gettimeofday (a documented approximation). Signals (rt_sigaction/rt_sigreturn: the crash\n// reporter reads Linux ucontext offsets) and every unknown call fail explicitly with ENOSYS (-38).\n// All registers except rax, rcx and r11 are preserved, as on Linux.\n//\n// Frame: 200 bytes of scratch at rsp+0, saved r10 r9 r8 rdx rsi rdi r15 r14 r13 r12 rbx at rsp+200 .. rsp+280.\n\nwaza dx_jmp(c: x86_64.Assembler, name: string) -> unit { x86_64.jmp(c, name); }\nwaza dx_jcc(c: x86_64.Assembler, cc: int64, name: string) -> unit { x86_64.jcc(c, cc, name); }\nwaza dx_name(prefix: string, index: int64) -> string { kaesu string.concat(prefix, convert.format_int(index)); }\nwaza dx_class(number: int64) -> int64 { kaesu 33554432 + number; }\n\n// Linux call `linux` -> Darwin call `darwin`, same arguments and result convention.\nwaza dx_direct(c: x86_64.Assembler, linux: int64, darwin: int64, index: int64) -> unit {\n    kaku next = dx_name(\"dx_direct_next_\", index);\n    x86_64.cmp_ri(c, x86_64.rax, linux); dx_jcc(c, x86_64.cc_ne, next);\n    x86_64.mov_eax_imm(c, dx_class(darwin)); dx_jmp(c, \"dx_svc\");\n    x86_64.label(c, next);\n}\n\nwaza dx_dispatch(c: x86_64.Assembler, linux: int64, target: string, index: int64) -> unit {\n    kaku next = dx_name(\"dx_dispatch_next_\", index);\n    x86_64.cmp_ri(c, x86_64.rax, linux); dx_jcc(c, x86_64.cc_ne, next); dx_jmp(c, target);\n    x86_64.label(c, next);\n}\n\n// dst = (src & mask_low) | translated bits; pairs (from mask, to mask). Uses rcx and r14.\nwaza dx_flags(c: x86_64.Assembler, src: int64, dst: int64, low_mask: int64, pairs: []int64, prefix: string) -> unit {\n    x86_64.mov_rr(c, dst, src); x86_64.and_ri(c, dst, low_mask);\n    kaku at = 0;\n    aida (at < len(pairs)) {\n        kaku skip = dx_name(prefix, at);\n        x86_64.mov_rr(c, x86_64.rcx, src); x86_64.and_ri(c, x86_64.rcx, pairs[at]); dx_jcc(c, x86_64.cc_e, skip);\n        x86_64.mov_ri(c, x86_64.r14, pairs[at + 1]); x86_64.or_rr(c, dst, x86_64.r14);\n        x86_64.label(c, skip);\n        at = at + 2;\n    }\n}\n\n// Compare the bytes of `text` at [reg] and jump to `fail` on the first difference. Uses rax.\nwaza dx_prefix(c: x86_64.Assembler, reg: int64, text: string, fail: string) -> unit {\n    kaku bytes = string.to_bytes(text); kaku at = 0;\n    aida (at < len(bytes)) {\n        x86_64.mov_load8(c, x86_64.rax, reg, at); x86_64.cmp_ri(c, x86_64.rax, int64(bytes[at])); dx_jcc(c, x86_64.cc_ne, fail);\n        at = at + 1;\n    }\n}\n\n// Store `text` and a NUL at [rsp + offset].\nwaza dx_store_text(c: x86_64.Assembler, offset: int64, text: string) -> int64 {\n    kaku bytes = string.to_bytes(text); kaku at = 0;\n    aida (at < len(bytes)) { x86_64.mov_ri(c, x86_64.rax, int64(bytes[at])); x86_64.mov_store8(c, x86_64.rsp, offset + at, x86_64.rax); at = at + 1; }\n    x86_64.mov_ri(c, x86_64.rax, 0); x86_64.mov_store8(c, x86_64.rsp, offset + len(bytes), x86_64.rax);\n    kaesu offset + len(bytes);\n}\n\n// Length of the NUL-terminated string at [reg] (at most 1023) into rax; clobbers rcx.\nwaza dx_strlen(c: x86_64.Assembler, reg: int64, label: string) -> unit {\n    x86_64.mov_ri(c, x86_64.rax, 0);\n    x86_64.label(c, label);\n    x86_64.mov_rr(c, x86_64.rcx, reg); x86_64.add_rr(c, x86_64.rcx, x86_64.rax);\n    x86_64.mov_load8(c, x86_64.rcx, x86_64.rcx, 0); x86_64.test_rr(c, x86_64.rcx, x86_64.rcx); dx_jcc(c, x86_64.cc_e, string.concat(label, \"_done\"));\n    x86_64.add_ri(c, x86_64.rax, 1); x86_64.cmp_ri(c, x86_64.rax, 1023); dx_jcc(c, x86_64.cc_b, label);\n    x86_64.label(c, string.concat(label, \"_done\"));\n}\n\n// The syscall instruction proper, then the carry-flag test: success returns rax, failure maps the Darwin errno.\nwaza dx_tail(c: x86_64.Assembler) -> unit {\n    x86_64.label(c, \"dx_svc\"); x86_64.syscall_raw(c);\n    dx_jcc(c, x86_64.cc_ae, \"dx_return\");\n    x86_64.label(c, \"dx_fail\");\n    x86_64.call(c, \"dx_errno\"); x86_64.neg_r(c, x86_64.rax);\n    x86_64.label(c, \"dx_return\");\n    x86_64.add_ri(c, x86_64.rsp, 200);\n    x86_64.pop_r(c, x86_64.r10); x86_64.pop_r(c, x86_64.r9); x86_64.pop_r(c, x86_64.r8); x86_64.pop_r(c, x86_64.rdx);\n    x86_64.pop_r(c, x86_64.rsi); x86_64.pop_r(c, x86_64.rdi); x86_64.pop_r(c, x86_64.r15); x86_64.pop_r(c, x86_64.r14);\n    x86_64.pop_r(c, x86_64.r13); x86_64.pop_r(c, x86_64.r12); x86_64.pop_r(c, x86_64.rbx);\n    x86_64.ret(c);\n}\n\n// Darwin errno (rax) -> Linux errno for the values that differ.\nwaza dx_errno(c: x86_64.Assembler) -> unit {\n    x86_64.label(c, \"dx_errno\");\n    kaku pairs = [35, 11, 36, 115, 37, 114, 38, 88, 39, 89, 40, 90, 41, 91, 42, 92, 43, 93, 45, 95, 47, 97, 48, 98, 49, 99, 50, 100,\n        51, 101, 53, 103, 54, 104, 55, 105, 56, 106, 57, 107, 60, 110, 61, 111, 65, 113, 66, 39, 62, 40, 63, 36, 78, 38];\n    kaku at = 0;\n    aida (at < len(pairs)) {\n        kaku next = dx_nam