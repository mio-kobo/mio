waza data_41() -> File { kaesu File { path: "kiso/aot/lowerlinux/mutators.mio", version: "Bunko-v2.1.1", length: 52711, sha256: "eec1782d95cbc2c7290a24fd4d347d3291449deaca455c156656046a48402b49", source: "yobu \"kiso/aot/elf\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\n\n// Linux x86-64 后端的多 Mutator 运行时（见 docs/concurrency.md，RA-2 草案）。\n//\n// 仅当程序引用线程原生接口时启用：lowering 在生成代码前定义标签 `mutators`，\n// 从而替换或扩展单 Mutator 运行时；未使用线程原生接口的程序仍生成逐字节相同的镜像。\n//\n// 模型：共享非移动堆、STW（Stop-The-World）回收、协作式 Safepoint（函数入口与循环回边）。\n//   * Mutator 记录（128 字节，位于线程自身的栈映射内；主线程记录位于收集器状态区）。\n//     该记录同时作为线程的 TLS 块：字 0 指向自身，FS 基址即该记录地址，因此 `mov r, fs:[0]` 即可取得当前记录。\n//       +0 self  +8 next  +16 state  +24 saved rbp  +32 saved call-site id  +40 entry closure（GC 根）\n//       +48 tid word（线程结束时由内核清零并唤醒 futex 等待者）  +56 result  +64 stack base  +72 stack size\n//   * 状态值：0 运行中，1 停靠于 Safepoint，2 阻塞于 thread_join、word_wait 或 socket/reactor 系统调用（根链和临时根已发布），3 正在执行回收。\n//     线程在离开运行态之前必须先发布帧链（rbp 与标识描述符的调用点 ID），并在重新进入运行态之后再次检查 stop 标志；\n//     收集器则在读取任何状态之前先设置 stop 标志。双方均采用顺序一致的 xchg，保证要么收集器看到线程未运行，\n//     要么线程看到停止请求：正在运行的线程绝不会被扫描，也绝不会被漏扫。\n//   * 堆锁：自旋锁字串行化 rt.alloc（及注册表变更）。运行时例程内部绝不触发回收，因此线程不可能持锁停靠。\n//   * 回收：首个在轮询中发现分配量超过阈值（或 stop 标志已置位）的线程通过 lock cmpxchg 抢占 stop 标志，\n//     等待其余已注册 Mutator 全部离开运行态后，标记全局变量、各 Mutator 发布的帧链及入口闭包，\n//     随后清扫（sweep）、清空每线程分配缓存、清除 stop 标志并唤醒所有停靠线程（futex）。\n//   * 线程退出时在锁保护下从链表摘除记录；joiner 在内核清零 tid 字后 munmap 其栈映射。\n// rt.blk_enter 与 rt.blk_leave 在 socket/reactor 系统调用期间发布并保留 rec_pin0/rec_pin1。\n// 文件、进程等待等其他阻塞系统调用尚未接入 Safepoint 协议。\n\n// gc_state() + 72 is the saved initial stack pointer and + 80 the testing failure counter: these words are free.\n// The heap lock has a cache line of its own (data offset 1088, in the unused range): every allocation writes it, while every thread reads the stop\n// flag at each poll. Sharing a line made each allocation invalidate that flag in all other cores' caches.\nkoukai teisu mut_lock = -2512;\nkoukai teisu mut_stop = 96;\nkoukai teisu mut_count = 104;\nkoukai teisu mut_registry = 112;\nkoukai teisu mut_table = 120;           // address of the thread handle table (mmap, 4096 slots of 16 bytes), set by rt.mut_init\nkoukai teisu mut_slab_next = 128;        // channel word blocks are carved from 64 KiB chunks that are never unmapped\nkoukai teisu mut_slab_end = 136;\n// Set by the allocator (under the heap lock) when the allocation volume reaches the threshold, cleared when the collector resumes the world: a\n// poll reads this word instead of the volume and threshold words, which every allocation writes.\nkoukai teisu mut_want = 144;\nkoukai teisu thread_slots = 4096;\nkoukai teisu mut_main_record = 256;      // offset from gc_state(): the main thread's record\n\nkoukai teisu rec_self = 0;\nkoukai teisu rec_next = 8;\nkoukai teisu rec_state = 16;\nkoukai teisu rec_rbp = 24;\nkoukai teisu rec_ret = 32;\nkoukai teisu rec_entry = 40;\n// Per-thread allocation cache: five singly linked lists of free blocks of exactly 24, 32, 40, 48 and 56 bytes (record words 11..15; the record is 128 bytes and word 10 is the join status). A small\n// allocation pops from the thread's own list, with no lock and no write to shared memory; an empty list is refilled with 64 blocks carved from one\n// locked allocation. The blocks in a cache are ordinary free blocks (valid header, mark word 0), so a sweep reclaims them like any dead block; the\n// collector empties every thread's lists before it resumes the world.\nkoukai teisu rec_cache = 88;                // words 11..15 (88..127); word 10 (80) is the join status\nkoukai teisu rec_tid = 48;\nkoukai teisu rec_result = 56;\nkoukai teisu rec_base = 64;\nkoukai teisu rec_size = 72;\nkoukai teisu rec_joinerr = 80;           // status of this thread's last join: 0 ok, 22 (EINVAL) = not a live thread handle\n// The allocation cache occupies 88..127. Leave word 128 available for the joined-stack pool; the thread mapping reserves 256 bytes here.\nkoukai teisu rec_pin0 = 136;             // two heap references (GC roots) kept alive while the thread is in a blocking region: 0 when unused\nkoukai teisu rec_pin1 = 144;\n\nkoukai teisu thread_stack_bytes = 1048576;\nkoukai teisu thread_guard_bytes = 4096;\nkoukai teisu clone_flags = 4001536;      // VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|SETTLS|PARENT_SETTID|CHILD_CLEARTID\n\nkoukai waza mutators_enabled(code: x86_64.Assembler) -> bool { kaesu x86_64.label_offset(code, \"mutators\") >= 0; }\n\nwaza mut_state_address() -> int64 { kaesu elf.data_base + 3600; }\n\n// mov dst, fs:[0]  (the current thread's record)\nwaza fs_self(code: x86_64.Assembler, dst: int64) -> unit {\n    x86_64.byte(code, 100);\n    moshi (dst >= 8) {\n        x86_64.byte(code, 76);\n    } sore {\n        x86_64.byte(code, 72);\n    }\n    x86_64.byte(code, 139);\n    x86_64.byte(code, (dst - (dst / 8) * 8) * 8 + 4);\n    x86_64.byte(code, 37);\n    x86_64.byte(code, 0);\n    x86_64.byte(code, 0);\n    x86_64.byte(code, 0);\n    x86_64.byte(code, 0);\n}\n\n// rt.mut_lock_acquire / release: clobber rcx, rdx only. A short spin, then sched_yield between attempts: with more runnable threads than cores\n// the holder can be descheduled, and spinners that never yield would burn their whole quantum (measured: 8 cores busy for minutes with 4000 threads).\nwaza emit_lock_routines(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.mut_lock_acquire\");\n    x86_64.push_r(code, x86_64.r8);\n    x86_64.push_r(code, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.r8, 0);\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address() + mut_lock);\n    x86_64.label(code, \"rt.mut_lock_acquire.try\");\n    x86_64.mov_ri(code, x86_64.rdx, 1);\n    x86_64.xchg_store(code, x86_64.rcx, x86_64.rdx);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.mut_lock_acquire.done\");\n    x86_64.add_ri(code, x86_64.r8, 1);\n    x86_64.cmp_ri(code, x86_64.r8, 64);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.mut_lock_acquire.pause\");\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.push_r(code, x86_64.rdi);\n    x86_64.mov_eax_imm(code, 24);                        // sched_yield\n    x86_64.syscall(code);\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.pop_r(code, x86_64.rsi);\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address() + mut_lock);\n    x86_64.mov_ri(code, x86_64.r8, 0);\n    x86_64.label(code, \"rt.mut_lock_acquire.pause\");\n    x86_64.byte(code, 243);\n    x86_64.byte(code, 144);     // pause\n    x86_64.jmp(code, \"rt.mut_lock_acquire.try\");\n    x86_64.label(code, \"rt.mut_lock_acquire.done\");\n    x86_64.pop_r(code, x86_64.rax);\n    x86_64.pop_r(code, x86_64.r8);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.mut_lock_release\");\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address() + mut_lock);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rdx);\n    x86_64.ret(code);\n}\n\n// rt.alloc (mutator mode): take the heap lock around the unchanged single-mutator allocator, which is emitted as rt.alloc.locked.\nwaza emit_alloc_wrapper(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.alloc\");\n    // fast path: sizes 24..56 come from the thread's own cache. rdx = size - 24 = 8 * class (anything else wraps or exceeds 32: slow path)\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.sub_ri(code, x86_64.rdx, 24);\n    x86_64.cmp_ri(code, x86_64.rdx, 32);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.alloc.slow\");\n    fs_self(code, x86_64.rcx);\n    x86_64.add_rr(code, x86_64.rcx, x86_64.rdx);                  // rcx = record + 8 * class\n    x86_64.mov_load(code, x86_64.r8, x86_64.rcx, rec_cache);\n    x86_64.test_rr(code, x86_64.r8, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.refill\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.r8, 16);\n    x86_64.mov_store(code, x86_64.rcx, rec_cache, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rdx, 0);                           // the block is handed out zeroed (only these three words were written)\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.r8, 8, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.r8, 16, x86_64.rdx);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.r8);\n    x86_64.ret(code);\n    // refill: one locked allocation of 64 blocks, carved into free blocks; the first is returned and the rest become the cache\n    x86_64.label(code, \"rt.alloc.refill\");\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.push_r(code, x86_64.rdi);\n    x86_64.push_r(code, x86_64.r9);\n    x86_64.push_r(code, x86_64.r10);\n    x86_64.push_r(code, x86_64.r11);\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);                  // block size\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rcx);                  // record + 8 * class\n    x86_64.shl_ri(code, x86_64.rax, 6);\n    x86_64.call(code, \"rt.alloc.slow\");                          // rax = a zeroed chunk of 64 blocks\n    x86_64.mov_rr(code, x86_64.r9, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rsi);\n    x86_64.shl_ri(code, x86_64.r8, 8);                            // free block header: size << 8, kind 0\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.r9);\n    x86_64.mov_ri(code, x86_64.r10, 63);\n    x86_64.label(code, \"rt.alloc.carve\");\n    x86_64.mov_rr(code, x86_64.r11, x86_64.rdx);\n    x86_64.add_rr(code, x86_64.r11, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rdx, 0, x86_64.r8);\n    x86_64.mov_store(code, x86_64.rdx, 16, x86_64.r11);\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.r11);\n    x86_64.sub_ri(code, x86_64.r10, 1);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.alloc.carve\");\n    x86_64.mov_store(code, x86_64.rdx, 0, x86_64.r8);             // the last block keeps next = 0\n    x86_64.mov_load(code, x86_64.rdx, x86_64.r9, 16);\n    x86_64.mov_store(code, x86_64.rdi, rec_cache, x86_64.rdx);    // the cache is everything after the first block\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store(code, x86_64.r9, 0, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.r9, 16, x86_64.rdx);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.r9);\n    x86_64.pop_r(code, x86_64.r11);\n    x86_64.pop_r(code, x86_64.r10);\n    x86_64.pop_r(code, x86_64.r9);\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.pop_r(code, x86_64.rsi);\n    x86_64.ret(code);\n    // slow path: the heap lock around the unchanged single-mutator allocator\n    x86_64.label(code, \"rt.alloc.slow\");\n    x86_64.mov_ri(code, x86_64.r8, 0);\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address() + mut_lock);\n    x86_64.label(code, \"rt.alloc.acquire\");\n    // test and test-and-set: a waiter only reads the lock word (a shared cache line) until it looks free; the atomic exchange that writes it\n    // is tried only then. A plain exchange loop made every waiting thread invalidate the line on every attempt.\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 0);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.alloc.busy\");\n    x86_64.mov_ri(code, x86_64.rdx, 1);\n    x86_64.xchg_store(code, x86_64.rcx, x86_64.rdx);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.held\");\n    x86_64.label(code, \"rt.alloc.busy\");\n    x86_64.add_ri(code, x86_64.r8, 1);\n    x86_64.cmp_ri(code, x86_64.r8, 64);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.alloc.pause\");\n    x86_64.push_r(code, x86_64.rax);                      // the request size must survive the system call\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.push_r(code, x86_64.rdi);\n    x86_64.mov_eax_imm(code, 24);                         // sched_yield\n    x86_64.syscall(code);\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.pop_r(code, x86_64.rsi);\n    x86_64.pop_r(code, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address() + mut_lock);\n    x86_64.mov_ri(code, x86_64.r8, 0);\n    x86_64.label(code, \"rt.alloc.pause\");\n    x86_64.byte(code, 243);\n    x86_64.byte(code, 144);\n    x86_64.jmp(code, \"rt.alloc.acquire\");\n    x86_64.label(code, \"rt.alloc.held\");\n    x86_64.call(code, \"rt.alloc.locked\");\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address() + mut_lock);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rdx);\n    x86_64.ret(code);\n}\n\n// rt.mut_init: register the main thread (record in the collector state area) and point FS at it.\nwaza emit_mut_init(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.mut_init\");\n    x86_64.mov_ri(code, x86_64.rdi, mut_state_address() + mut_main_record);\n    x86_64.mov_store(code, x86_64.rdi, rec_self, x86_64.rdi);\n    x86_64.mov_ri(code, x86_64.rdx, mut_state_address());\n    x86_64.mov_store(code, x86_64.rdx, mut_registry, x86_64.rdi);\n    x86_64.mov_ri(code, x86_64.rax, 1);\n    x86_64.mov_store(code, x86_64.rdx, mut_count, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rdi);\n    x86_64.mov_ri(code, x86_64.rdi, 4098);               // ARCH_SET_FS\n    x86_64.mov_eax_imm(code, 158);                       // arch_prctl\n    x86_64.syscall(code);\n    // the handle table: a failed mapping leaves it null and every thread_start then reports ENOMEM\n    x86_64.mov_ri(code, x86_64.rdi, 0);\n    x86_64.mov_ri(code, x86_64.rsi, thread_slots * 16);\n    x86_64.mov_ri(code, x86_64.rdx, 3);\n    x86_64.mov_ri(code, x86_64.r10, 34);\n    x86_64.mov_ri(code, x86_64.r8, -1);\n    x86_64.mov_ri(code, x86_64.r9, 0);\n    x86_64.mov_eax_imm(code, 9);\n    x86_64.syscall(code);\n    x86_64.mov_ri(code, x86_64.rcx, -4096);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_ae, \"rt.mut_init.done\");\n    x86_64.mov_ri(code, x86_64.rdx, mut_state_address());\n    x86_64.mov_store(code, x86_64.rdx, mut_table, x86_64.rax);\n    x86_64.label(code, \"rt.mut_init.done\");\n    x86_64.ret(code);\n}\n\n// Park the calling thread at a safepoint. Entered by jump from rt.gc or by call from the thread entry / join paths with\n// r10 = frame pointer and r11 = call-site id of the frame to publish (0, 0 = no managed frames yet). Returns once no collection is\n// in progress and the thread is running again.\nwaza emit_park(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.gc.park\");\n    fs_self(code, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rax, rec_rbp, x86_64.r10);\n    x86_64.mov_store(code, x86_64.rax, rec_ret, x86_64.r11);\n    x86_64.label(code, \"rt.gc.park.again\");\n    x86_64.lea(code, x86_64.rdi, x86_64.rax, rec_state);\n    x86_64.mov_ri(code, x86_64.rdx, 1);\n    x86_64.xchg_store(code, x86_64.rdi, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address());\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, mut_stop);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.gc.park.resume\");\n    x86_64.mov_ri(code, x86_64.rdi, mut_state_address() + mut_stop);\n    x86_64.mov_ri(code, x86_64.rsi, 128);                // FUTEX_WAIT_PRIVATE\n    x86_64.mov_ri(code, x86_64.rdx, 1);\n    x86_64.mov_ri(code, x86_64.r10, 0);\n    x86_64.mov_eax_imm(code, 202);\n    x86_64.syscall(code);\n    fs_self(code, x86_64.rax);\n    x86_64.jmp(code, \"rt.gc.park.again\");\n    x86_64.label(code, \"rt.gc.park.resume\");\n    x86_64.lea(code, x86_64.rdi, x86_64.rax, rec_state);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.xchg_store(code, x86_64.rdi, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address());\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, mut_stop);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.gc.park.again\");\n    x86_64.ret(code);\n}\n\n// Blocking region (used around a syscall that can block for an unbounded time, with the managed heap untouched in between).\n//   rt.blk_enter: rdi = a frame pointer whose [rdi] / [rdi+8] are the managed caller's frame pointer and call-site id (the native wrapper\n//     frame, exactly as for thread_join), rsi / rdx = up to two heap references to keep alive (0 = none). Publishes the chain, pins the\n//     references, then leaves the running state. Clobbers rax, rcx, rdx, rsi, rdi; preserves every other register.\n//   rt.blk_leave: re-enters the running state, observes a pending stop request (parking until the collection ends, with the chain still\n//     published), unpins, and returns with rax and r8/r9 unchanged. Every other register is clobbered.\n// The collector sets the stop flag BEFORE it reads any state; the thread publishes BEFORE it leaves state 0 and re-checks the flag AFTER it\n// re-enters it, so a stop request racing with entry is either seen by the collector (state != 0, roots published) or by the thread.\nwaza emit_blocking_region(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.blk_enter\");\n    fs_self(code, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 0);\n    x86_64.mov_store(code, x86_64.rax, rec_rbp, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 8);\n    x86_64.mov_store(code, x86_64.rax, rec_ret, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rax, rec_pin0, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rax, rec_pin1, x86_64.rdx);\n    x86_64.lea(code, x86_64.rdi, x86_64.rax, rec_state);\n    x86_64.mov_ri(code, x86_64.rdx, 2);\n    x86_64.xchg_store(code, x86_64.rdi, x86_64.rdx);\n    x86_64.ret(code);\n\n    x86_64.label(code, \"rt.blk_leave\");\n    x86_64.push_r(code, x86_64.rax);\n    x86_64.push_r(code, x86_64.r8);\n    x86_64.push_r(code, x86_64.r9);\n    fs_self(code, x86_64.rax);\n    x86_64.lea(code, x86_64.rdi, x86_64.rax, rec_state);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.xchg_store(code, x86_64.rdi, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address());\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, mut_stop);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.blk_leave.running\");\n    x86_64.mov_load(code, x86_64.r10, x86_64.rax, rec_rbp);\n    x86_64.mov_load(code, x86_64.r11, x86_64.rax, rec_ret);\n    x86_64.call(code, \"rt.gc.park\");\n    fs_self(code, x86_64.rax);\n    x86_64.label(code, \"rt.blk_leave.running\");\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store(code, x86_64.rax, rec_pin0, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rax, rec_pin1, x86_64.rdx);\n    x86_64.pop_r(code, x86_64.r9);\n    x86_64.pop_r(code, x86_64.r8);\n    x86_64.pop_r(code, x86_64.rax);\n    x86_64.ret(code);\n}\n\n// rt.mgc.chain: r10 = frame pointer, r11 = call-site id. Marks every reference slot of the chain. Clobbers rax, rcx, rdx, rsi, rdi, r9, r10, r11.\nwaza emit_chain_scan(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.mgc.chain\");\n    x86_64.label(code, \"rt.mgc.frames\");\n    x86_64.test_rr(code, x86_64.r10, x86_64.r10);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.mgc.chain_done\");\n    x86_64.lea(code, x86_64.rsi, x86_64.r11, 5);\n    x86_64.mov_load(code, x86_64.r9, x86_64.rsi, 0);\n    x86_64.add_ri(code, x86_64.rsi, 8);\n    x86_64.label(code, \"rt.mgc.slots\");\n    x86_64.test_rr(code, x86_64.r9, x86_64.r9);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.mgc.next_frame\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsi, 0);\n    x86_64.add_rr(code, x86_64.rax, x86_64.r10);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rax, 0);\n    x86_64.call(code, \"rt.gc_mark\");\n    x86_64.add_ri(code, x86_64.rsi, 8);\n    x86_64.sub_ri(code, x86_64.r9, 1);\n    x86_64.jmp(code, \"rt.mgc.slots\");\n    x86_64.label(code, \"rt.mgc.next_frame\");\n    x86_64.mov_load(code, x86_64.r11, x86_64.r10, 8);\n    x86_64.mov_load(code, x86_64.r10, x86_64.r10, 0);\n    x86_64.jmp(code, \"rt.mgc.frames\");\n    x86_64.label(code, \"rt.mgc.chain_done\");\n    x86_64.ret(code);\n}\n\n// rt.gc (mutator mode): called from a poll site; [rsp] = call-site id, rbp = the polling frame.\nkoukai waza emit_collect_mutators(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.gc\");\n    x86_64.mov_load(code, x86_64.r11, x86_64.rsp, 0);\n    x86_64.mov_rr(code, x86_64.r10, x86_64.rbp);\n    x86_64.label(code, \"rt.gc.retry\");\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address());\n    x86_64.mov_load(code, x86_64.rax, x86_64.rcx, mut_stop);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.gc.park\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 16);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.gc.out\");\n    // become the collector\n    x86_64.mov_ri(code, x86_64.rdi, mut_state_address() + mut_stop);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 1);\n    x86_64.lock_cmpxchg(code, x86_64.rdi, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.gc.retry\");\n    fs_self(code, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rsi, rec_rbp, x86_64.r10);\n    x86_64.mov_store(code, x86_64.rsi, rec_ret, x86_64.r11);\n    x86_64.mov_ri(code, x86_64.rdx, 3);\n    x86_64.mov_store(code, x86_64.rsi, rec_state, x86_64.rdx);\n    // wait until no other registered mutator is running\n    x86_64.label(code, \"rt.gc.wait\");\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address());\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, mut_registry);\n    x86_64.label(code, \"rt.gc.wait_scan\");\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.gc.stopped\");\n    x86_64.cmp_rr(code, x86_64.rdx, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.gc.wait_next\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdx, rec_state);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.gc.wait_yield\");\n    x86_64.label(code, \"rt.gc.wait_next\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rdx, rec_next);\n    x86_