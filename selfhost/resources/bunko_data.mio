; }\n            moshi (child < 0) { kaesu -1; }\n            p.flags[0] = frame.flags; array.truncate(frames, index); p.at[0] = p.at[0] + 1;\n            array.push(frames[index - 1].items, repetition(p, child)); tsuzuku;\n        }\n        kaku item = atom(p); moshi (item < 0) { kaesu -1; }\n        array.push(frame.items, repetition(p, item));\n    }\n    kaesu -1;\n}\n\nwaza state(states: []State, op: int64, out: int64, other: int64, ranges: []int64) -> int64 {\n    kaku id = len(states); array.push(states, State { op: op, out: out, other: other, ranges: ranges }); kaesu id;\n}\nwaza patch(states: []State, ends: []int64, target: int64) -> unit {\n    kaku at = 0;\n    aida (at < len(ends)) {\n        kaku id = ends[at] / 2; kaku port = ends[at] - id * 2; kaku old = states[id]; kaku out = old.out; kaku other = old.other;\n        moshi (port == 0) { out = target; } sore { other = target; }\n        states[id] = State { op: old.op, out: out, other: other, ranges: old.ranges }; at = at + 1;\n    }\n}\nwaza compile_node(p: Parser, id: int64, states: []State) -> Fragment {\n    moshi (id < 0 || len(states) > 3355443) { fail(p, \"regexp program size limit\"); kaesu Fragment { start: -1, ends: [] }; }\n    kaku item = p.nodes[id];\n    moshi (item.op == 14) { kaesu compile_node(p, item.a, states); }\n    moshi (item.op <= 10) {\n        kaku op = item.op; moshi (op == 0) { op = 4; }\n        kaku start = state(states, op, -1, -1, item.ranges); kaesu Fragment { start: start, ends: [start * 2] };\n    }\n    moshi (item.op == 11 || item.op == 12) {\n        kaku left = compile_node(p, item.a, states); kaku right = compile_node(p, item.b, states);\n        moshi (item.op == 11) { patch(states, left.ends, right.start); kaesu Fragment { start: left.start, ends: right.ends }; }\n        kaku start = state(states, 11, left.start, right.start, []); kaku ends = array.clone(left.ends); array.append_all(ends, right.ends); kaesu Fragment { start: start, ends: ends };\n    }\n    