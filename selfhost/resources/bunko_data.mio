\n    kaku item = p.nodes[id];\n    moshi (item.op == 14) { kaesu compile_node(p, item.a, states); }\n    moshi (item.op <= 10) {\n        kaku op = item.op;\n        moshi (op == 0) {\n            op = 4;\n        }\n        kaku start = state(states, op, -1, -1, item.ranges);\n        kaesu Fragment {\n            start: start, ends: [start * 2] };\n    }\n    moshi (item.op == 11 || item.op == 12) {\n        kaku left = compile_node(p, item.a, states);\n        kaku right = compile_node(p, item.b, states);\n        moshi (item.op == 11) {\n            patch(states, left.ends, right.start);\n            kaesu Fragment {\n                start: left.start, ends: right.ends };\n        }\n        kaku start = state(states, 11, left.start, right.start, []);\n        kaku ends = array.clone(left.ends);\n        array.append_all(ends, right.ends);\n        kaesu Fragment {\n            start: start, ends: ends };\n    }\n    kaku start = state(states, 4, -1, -1, []);\n    kaku ends: []int64 = [start * 2];\n    kaku at = 0;\n    aida (at < item.low && p.error[0] == \"\") {\n        kaku next = compile_node(p, item.a, states);\n        patch(states, ends, next.start);\n        ends = next.ends;\n        at = at + 1;\n    }\n    moshi (item.high < 0 && p.error[0] == \"\") {\n        kaku child = compile_node(p, item.a, states);\n        kaku split = state(states, 11, child.start, -1, []);\n        patch(states, ends, split);\n        patch(states, child.ends, split);\n        ends = [split * 2 + 1];\n    }\n    sore { aida (at < item.high && p.error[0] == \"\") {\n            kaku child = compile_node(p, item.a, states);\n            kaku split = state(states, 11, child.start, -1, []);\n            patch(states, ends, split);\n            ends = array.clone(child.ends);\n            array.push(ends, split * 2 + 1);\n            at = at + 1;\n        } }\n    kaesu Fragment { start: start, ends: ends };\n}\n\nkoukai waza compile(pattern: string) -> Program {\n    moshi (string.byte_len(pattern) > 33554432) { kaesu Program { states: [], start: -1, error: \"regexp size limit\" }; }\n    kaku p = Parser { input: runes(pattern), at: [0], flags: [0], quoted: [iie], nodes: [], heights: [], folds: [], error: [\"\"] };\n    kaku root = parse_expression(p);\n    moshi (p.at[0] != len(p.input)) {\n        fail(p, \"unexpected closing parenthesis\");\n    }\n    kaku states: []State = [];\n    kaku fragment = Fragment {\n        start: -1, ends: [] };\n    moshi (p.error[0] == \"\") { fragment = compile_node(p, root, states); }\n    moshi (p.error[0] != \"\") { kaesu Program { states: [], start: -1, error: p.error[0] }; }\n    kaku accepted = state(states, 0, -1, -1, []);\n    patch(states, fragment.ends, accepted);\n    kaesu Program { states: states, start: fragment.start, error: \"\" };\n}\nwaza word(value: int64) -> bool { kaesu is_digit(value) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95; }\nwaza closure(program: Program, id: int64, position: int64, input: []int64, seen: []int64, epoch: int64, active: []int64) -> unit {\n    kaku stack: []int64 = [id];\n    aida (len(stack) > 0) {\n        kaku node = stack[len(stack) - 1];\n        array.truncate(stack, len(stack) - 1);\n        moshi (node < 0 || node >= len(program.states)) { tsuzuku; }\n        moshi (seen[node] == epoch) {\n            tsuzuku;\n        }\n        seen[node] = epoch;\n        kaku item = program.states[node];\n        moshi (item.op == 4) {\n            array.push(stack, item.out);\n            tsuzuku;\n        }\n        moshi (item.op == 11) {\n            array.push(stack, item.out);\n            array.push(stack, item.other);\n            tsuzuku;\n        }\n        moshi (item.op >= 5 && item.op <= 10) {\n            kaku before = -1;\n            kaku after = -1;\n            moshi (position > 0) {\n                before = input[position - 1];\n            }\n            moshi (position < len(input)) {\n                after = input[position];\n            }\n            kaku valid = iie;\n            moshi (item.op == 5) {\n                valid = position == 0;\n            }\n            moshi (item.op == 6) {\n                valid = position == len(input);\n            }\n            moshi (item.op == 7) {\n                valid = position == 0 || before == 10;\n            }\n            moshi (item.op == 8) {\n                valid = position == len(input) || after == 10;\n            }\n            moshi (item.op == 9) {\n                valid = word(before) != word(after);\n            }\n            moshi (item.op == 10) {\n                valid = word(before) == word(after);\n            }\n            moshi (valid) {\n                array.push(stack, item.out);\n            }\n            tsuzuku;\n        }\n        array.push(active, node);\n    }\n}\nkoukai waza matches(program: Program, text: string) -> bool {\n    moshi (program.error != \"\" || program.start < 0) { kaesu iie; }\n    kaku input = runes(text);\n    kaku seen = array.make[int64](len(program.states), 0);\n    kaku active: []int64 = [];\n    kaku epoch = 1;\n    kaku position = 0;\n    closure(program, program.start, 0, input, seen, epoch, active);\n    aida (position <= len(input)) {\n        kaku at = 0;\n        aida (at < len(active)) {\n            moshi (program.states[active[at]].op == 0) {\n                kaesu hai;\n            }\n            at = at + 1;\n        }\n        moshi (position == len(input)) { kaesu iie; }\n        kaku next: []int64 = [];\n        epoch = epoch + 1;\n        at = 0;\n        aida (at < len(active)) {\n            kaku item = program.states[active[at]];\n            kaku valid = iie;\n            moshi (item.op == 1) { valid = contains(item.ranges, input[position]); }\n            moshi (item.op == 2) {\n                valid = input[position] != 10;\n            }\n            moshi (item.op == 3) {\n                valid = hai;\n            }\n            moshi (