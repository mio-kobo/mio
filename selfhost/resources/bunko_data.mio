rt.failed\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.r14);\n    x86_64.jmp(code, \"rt.thread_start.return\");\n    x86_64.label(code, \"rt.thread_start.failed\");\n    x86_64.mov_rr(code, x86_64.r12, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.r8);\n    x86_64.call(code, \"rt.mut_unlink\");\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.r13);\n    x86_64.mov_ri(code, x86_64.rsi, thread_stack_bytes);\n    x86_64.mov_eax_imm(code, 11);                        // munmap\n    x86_64.syscall(code);\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.r14);\n    x86_64.call(code, \"rt.mut_slot_release\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.r12);\n    x86_64.jmp(code, \"rt.thread_start.return\");\n    x86_64.label(code, \"rt.thread_start.map_failed\");\n    x86_64.mov_rr(code, x86_64.r12, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.r14);\n    x86_64.call(code, \"rt.mut_slot_release\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.r12);\n    x86_64.label(code, \"rt.thread_start.return\");\n    x86_64.pop_r(code, x86_64.r14);\n    x86_64.pop_r(code, x86_64.r13);\n    x86_64.pop_r(code, x86_64.r12);\n    x86_64.ret(code);\n    // the new thread: rsp = child stack with the record at [rsp]\n    x86_64.label(code, \"rt.thread_child\");\n    x86_64.mov_ri(code, x86_64.rbp, 0);\n    x86_64.mov_load(code, x86_64.r12, x86_64.rsp, 0);\n    x86_64.mov_ri(code, x86_64.r10, 0);\n    x86_64.mov_ri(code, x86_64.r11, 0);\n    x86_64.call(code, \"rt.gc.park\");                     // enters the running state, honouring a collection already in progress\n    x86_64.mov_load(code, x86_64.rax, x86_64.r12, rec_entry);\n    x86_64.push_r(code, x86_64.rax);\n    x86_64.call_memory(code, x86_64.rax, 48);\n    x86_64.add_ri(code, x86_64.rsp, 8);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.r12, rec_entry);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rcx, 32);   // closure returns a value?\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.thread_child.store\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.label(code, \"rt.thread_child.store\");\n    x86_64.mov_store(code, x86_64.r12, rec_result, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.r12);\n    x86_64.call(code, \"rt.mut_unlink\");\n    x86_64.mov_ri(code, x86_64.rdi, 0);\n    x86_64.mov_eax_imm(code, 60);                        // exit this thread only; the kernel clears the tid word and wakes joiners\n    x86_64.syscall(code);\n}\n\n// rt.mut_unlink: rdi = record. Removes it from the registry and decrements the mutator count under the lock.\nwaza emit_unlink(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.mut_unlink\");\n    x86_64.push_r(code, x86_64.rdi);\n    x86_64.call(code, \"rt.mut_lock_acquire\");\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.mov_ri(code, x86_64.rsi, mut_state_address() + mut_registry);\n    x86_64.label(code, \"rt.mut_unlink.scan\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsi, 0);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.mut_unlink.done\");\n    x86_64.cmp_rr(code, x86_64.rdx, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.mut_unlink.found\");\n    x86_64.lea(code, x86_64.rsi, x86_64.rdx, rec_next);\n    x86_64.jmp(code, \"rt.mut_unlink.scan\");\n    x86_64.label(code, \"rt.mut_unlink.found\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rdx, rec_next);\n    x86_64.mov_store(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address());\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, mut_count);\n    x86_64.sub_ri(code, x86_64.rdx, 1);\n    x86_64.mov_store(code, x86_64.rcx, mut_count, x86_64.rdx);\n    x86_64.label(code, \"rt.mut_unlink.done\");\n    x86_64.call(code, \"rt.mut_lock_release\");\n    x86_64.ret(code);\n}\n\n// rt.thread_join: rdi = handle. Returns the thread's result, or -22 (EINVAL) when the handle is not a live thread handle (never issued,\n// already joined, stale) and sets this thread's join status (rt.join_status). Called from the native wrapper frame, so the managed chain\n// to publish starts at [rbp] / [rbp+8].\nwaza emit_thread_join(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.thread_join\");\n    x86_64.push_r(code, x86_64.r12);\n    x86_64.push_r(code, x86_64.r13);\n    x86_64.push_r(code, x86_64.r14);\n    x86_64.mov_rr(code, x86_64.r14, x86_64.rdi);\n    x86_64.call(code, \"rt.mut_slot_claim\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.thread_join.claimed\");\n    fs_self(code, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rcx, 22);\n    x86_64.mov_store(code, x86_64.rax, rec_joinerr, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rax, -22);\n    x86_64.jmp(code, \"rt.thread_join.return\");\n    x86_64.label(code, \"rt.thread_join.claimed\");\n    x86_64.mov_rr(code, x86_64.r12, x86_64.rax);\n    fs_self(code, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, 0);\n    x86_64.mov_store(code, x86_64.rax, rec_rbp, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, 8);\n    x86_64.mov_store(code, x86_64.rax, rec_ret, x86_64.rcx);\n    x86_64.label(code, \"rt.thread_join.loop\");\n    fs_self(code, x86_64.rax);\n    x86_64.lea(code, x86_64.rdi, x86_64.rax, rec_state);\n    x86_64.mov_ri(code, x86_64.rdx, 2);\n    x86_64.xchg_store(code, x86_64.rdi, x86_64.rdx);\n    x86_64.mov_load32(code, x86_64.rax, x86_64.r12, rec_tid);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.thread_join.done\");\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.lea(code, x86_64.rdi, x86_64.r12, rec_tid);\n    x86_64.mov_ri(code, x86_64.rsi, 0);                  // FUTEX_WAIT on the kernel-cleared tid word\n    x86_64.mov_ri(code, x86_64.r10, 0);\n    x86_64.mov_eax_imm(code, 202);\n    x86_64.syscall(code);\n    x86_64.jmp(code, \"rt.thread_join.loop\");\n    x86_64.label(code, \"rt.thread_join.done\");\n    fs_self(code, x86_64.rax);\n    x86_64.lea(code, x86_64.rdi, x86_64.rax, rec_state);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.xchg_store(code, x86_64.rdi, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address());\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, mut_stop);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.thread_join.ready\");\n    x86_64.mov_load(code, x86_64.r10, x86_64.rax, rec_rbp);\n    x86_64.mov_load(code, x86_64.r11, x86_64.rax, rec_ret);\n    x86_64.call(code, \"rt.gc.park\");\n    x86_64.label(code, \"rt.thread_join.ready\");\n    x86_64.mov_load(code, x86_64.r13, x86_64.r12, rec_result);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.r12, rec_base);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.r12, rec_size);\n    x86_64.mov_eax_imm(code, 11);                        // munmap the stack (the record lives in it)\n    x86_64.syscall(code);\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.r14);\n    x86_64.call(code, \"rt.mut_slot_release\");            // the handle is dead from here on: a second join is detected\n    fs_self(code, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.mov_store(code, x86_64.rax, rec_joinerr, x86_64.rcx);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.r13);\n    x86_64.label(code, \"rt.thread_join.return\");\n    x86_64.pop_r(code, x86_64.r14);\n    x86_64.pop_r(code, x86_64.r13);\n    x86_64.pop_r(code, x86_64.r12);\n    x86_64.ret(code);\n    // rt.join_status: the status of this thread's last join (0 ok, 22 invalid handle)\n    x86_64.label(code, \"rt.join_status\");\n    fs_self(code, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rax, rec_joinerr);\n    x86_64.ret(code);\n}\n\n// 通道离堆控制字原语（word_address 计算目标字地址：rdi = handle, rsi = index -> rdi = 字地址）。\n// 控制块句柄是指向匿名映射的 64 位字块地址，GC 从不扫描该区域（仅存放计数器、锁与 futex 字，绝不存放堆引用；\n// 载荷引用存放在普通 Mio 数组中由 GC 正常追踪）。所有参数与返回值均为 int64，仅限 thread 包内部使用。\nwaza word_address(code: x86_64.Assembler) -> unit {\n    x86_64.shl_ri(code, x86_64.rsi, 3);\n    x86_64.add_rr(code, x86_64.rdi, x86_64.rsi);\n}\nwaza emit_word_natives(code: x86_64.Assembler) -> unit {\n    // words_new(count)：从 64 KiB 匿名内存块中切分出清零的 count 个 64 位字控制块。\n    // 控制块在进程生命周期内永不归还给操作系统，确保销毁通道后仍处于 send/receive 路径中的线程只会读到已关闭标志，绝不会访问已释放内存。\n    x86_64.label(code, \"rt.words_new\");\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rdi);\n    x86_64.shl_ri(code, x86_64.rsi, 3);\n    x86_64.add_ri(code, x86_64.rsi, 63);\n    x86_64.mov_ri(code, x86_64.rax, -64);\n    x86_64.and_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.cmp_ri(code, x86_64.rsi, 65536);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.words_new.toobig\");\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.words_new.toobig\");\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.call(code, \"rt.mut_lock_acquire\");\n    x86_64.pop_r(code, x86_64.rsi);\n    x86_64.mov_ri(code, x86_64.rcx, mut_state_address());\n    x86_64.mov_load(code, x86_64.rax, x86_64.rcx, mut_slab_next);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.words_new.chunk\");\n    x86_64.lea(code, x86_64.rdx, x86_64.rax, 0);\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rsi);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rcx, mut_slab_end);\n    x86_64.cmp_rr(code, x86_64.rdx, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.words_new.chunk\");\n    x86_64.mov_store(code, x86_64.rcx, mut_slab_next, x86_64.rdx);\n    x86_64.jmp(code, \"rt.words_new.done\");\n    x86_64.label(code, \"rt.words_new.chunk\");\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.mov_ri(code, x86_64.rdi, 0);\n    x86_64.mov_ri(code, x86_64.rsi, 65536);\n    x86_64.mov_ri(code, x86_64.rdx, 3);\n    x86_64.mov_ri(code, x86_64.r10, 34);                 // MAP_PRIVATE | MAP_ANONYMOUS\n    x86_64.mov_ri(code, x86_64.r8, -1);\n    x86_64.mov_ri(code, x86_64.r9, 0);\n    x86_64.mov_eax_imm(code, 9);\n    x86_64.sys