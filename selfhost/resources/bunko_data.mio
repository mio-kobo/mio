));\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_poll_invalid\");\n    wx(c, arm64.str_x(0, 31, 160));\n    wx_call(c, patches, \"GetFileType\");\n    wx_bool(c);\n    wx_cmpi(c, 0, 2);\n    wx_bcc(c, 0, \"wx_poll_console\");\n    wx_cmpi(c, 0, 3);\n    wx_bcc(c, 0, \"wx_poll_pipe\");\n    wx_b(c, \"wx_poll_ready\");\n    wx_label(c, \"wx_poll_console\");\n    wx(c, arm64.ldr_x(0, 31, 160));\n    wx_li(c, 1, 0);\n    wx_call(c, patches, \"WaitForSingleObject\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"wx_poll_ready\");\n    wx_b(c, \"wx_poll_idle\");\n    wx_label(c, \"wx_poll_pipe\");\n    wx(c, arm64.str_x(31, 31, 168));\n    wx(c, arm64.ldr_x(0, 31, 160));\n    wx_li(c, 1, 0);\n    wx_li(c, 2, 0);\n    wx_li(c, 3, 0);\n    wx(c, arm64.add_imm_x(4, 31, 168, iie));\n    wx_li(c, 5, 0);\n    wx_call(c, patches, \"PeekNamedPipe\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"wx_poll_pipe_failed\");\n    wx(c, arm64.ldr_w(9, 31, 168));\n    wx_cbz(c, 9, \"wx_poll_idle\");\n    wx_b(c, \"wx_poll_ready\");\n    wx_label(c, \"wx_poll_pipe_failed\");\n    wx_b(c, \"wx_poll_ready\");\n    wx_label(c, \"wx_poll_idle\");\n    wx(c, arm64.ldr_x(2, 31, 152));\n    wx_cbz(c, 2, \"wx_poll_timeout\");\n    wx(c, arm64.cmp_imm_x(2, 0, iie));\n    wx_bcc(c, 11, \"wx_poll_sleep\");\n    wx_cmpi(c, 2, 10);\n    wx_bcc(c, 9, \"wx_poll_timeout\");\n    wx(c, arm64.sub_imm_x(2, 2, 10, iie));\n    wx(c, arm64.str_x(2, 31, 152));\n    wx_label(c, \"wx_poll_sleep\");\n    wx_li(c, 0, 10);\n    wx_call(c, patches, \"Sleep\");\n    wx_b(c, \"wx_poll_again\");\n    wx_label(c, \"wx_poll_timeout\");\n    wx(c, arm64.ldr_x(9, 31, 144));\n    wx(c, arm64.strh_w(31, 9, 6));\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_poll_ready\");\n    wx(c, arm64.ldr_x(9, 31, 144));\n    wx_li(c, 10, 1);\n    wx(c, arm64.strh_w(10, 9, 6));\n    wx_li(c, 0, 1);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_poll_invalid\");\n    wx(c, arm64.ldr_x(9, 31, 144));\n    wx_li(c, 10, 32);\n    wx(c, arm64.strh_w(10, 9, 6));\n    wx_li(c, 0, 1);\n    wx_b(c, \"wx_ok\");\n    // A socket descriptor (>= 64) is polled for connect completion only (POLLOUT, no waiting): a pending SO_ERROR is POLLERR (8), a socket\n    // whose SO_CONNECT_TIME is not 0xFFFFFFFF is connected and writable (POLLOUT, 4), anything else is not ready (0 descriptors).\n    wx_label(c, \"wx_poll_socket\");\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_poll_invalid\");\n    wx(c, arm64.str_x(0, 31, 160));\n    wx_li(c, 9, 0);\n    wx(c, arm64.str_x(9, 31, 168));\n    wx_li(c, 9, 4);\n    wx(c, arm64.str_x(9, 31, 176));\n    wx(c, arm64.ldr_x(0, 31, 160));\n    wx_li(c, 1, 65535);\n    wx_li(c, 2, 4103);\n    wx(c, arm64.add_imm_x(3, 31, 168, iie));\n    wx(c, arm64.add_imm_x(4, 31, 176, iie));\n    wx_call(c, patches, \"getsockopt\");\n    wx_bool(c);\n    wx_cbnz(c, 0, \"wx_poll_socket_error\");\n    wx(c, arm64.ldr_w(9, 31, 168));\n    wx_cbnz(c, 9, \"wx_poll_socket_error\");\n    wx_li(c, 9, 0);\n    wx(c, arm64.str_x(9, 31, 168));\n    wx_li(c, 9, 4);\n    wx(c, arm64.str_x(9, 31, 176));\n    wx(c, arm64.ldr_x(0, 31, 160));\n    wx_li(c, 1, 65535);\n    wx_li(c, 2, 28684);\n    wx(c, arm64.add_imm_x(3, 31, 168, iie));\n    wx(c, arm64.add_imm_x(4, 31, 176, iie));\n    wx_call(c, patches, \"getsockopt\");\n    wx_bool(c);\n    wx_cbnz(c, 0, \"wx_poll_socket_error\");\n    wx(c, arm64.ldr_w(9, 31, 168));\n    wx_li(c, 10, 4294967295);\n    wx(c, arm64.cmp_x(9, 10));\n    wx_bcc(c, 0, \"wx_poll_timeout\");\n    wx(c, arm64.ldr_x(9, 31, 144));\n    wx_li(c, 10, 4);\n    wx(c, arm64.strh_w(10, 9, 6));\n    wx_li(c, 0, 1);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_poll_socket_error\");\n    wx(c, arm64.ldr_x(9, 31, 144));\n    wx_li(c, 10, 8);\n    wx(c, arm64.strh_w(10, 9, 6));\n    wx_li(c, 0, 1);\n    wx_b(c, \"wx_ok\");\n\n    // ioctl(fd, request, argp): only FIONBIO (0x8004667e, the same number on Darwin and Windows) is translated, to ioctlsocket\n    wx_label(c, \"wx_ioctl\");\n    wx(c, arm64.str_x(1, 31, 144));\n    wx(c, arm64.str_x(2, 31, 152));\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_badfd\");\n    wx(c, arm64.ldr_x(1, 31, 144));\n    wx_li(c, 9, 2147772030);\n    wx(c, arm64.cmp_x(1, 9));\n    wx_bcc(c, 1, \"wx_unsupported\");\n    wx(c, arm64.ldr_x(2, 31, 152));\n    wx_call(c, patches, \"ioctlsocket\");\n    wx_bool(c);\n    wx_cbnz(c, 0, \"wx_net_failed\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n\n    // getsockopt(fd, level, name, value, length): SOL_SOCKET (0xffff) and SO_ERROR (0x1007) have the same numbers on both systems; the pending\n    // error the system stores in *value is a Win32 code and becomes the Darwin errno the shared classifier expects.\n    wx_label(c, \"wx_getsockopt\");\n    wx(c, arm64.stp_x(1, 2, 31, 144));\n    wx(c, arm64.stp_x(3, 4, 31, 160));\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_badfd\");\n    wx(c, arm64.ldp_x(1, 2, 31, 144));\n    wx(c, arm64.ldp_x(3, 4, 31, 160));\n    wx_call(c, patches, \"getsockopt\");\n    wx_bool(c);\n    wx_cbnz(c, 0, \"wx_net_failed\");\n    wx(c, arm64.ldr_x(2, 31, 152));\n    wx_li(c, 9, 4103);\n    wx(c, arm64.cmp_x(2, 9));\n    wx_bcc(c, 1, \"wx_getsockopt_done\");\n    wx(c, arm64.ldr_x(3, 31, 160));\n    wx(c, arm64.ldr_w(0, 3, 0));\n    wx_cbz(c, 0, \"wx_getsockopt_done\");\n    wx_bl(c, \"wx_map_error\");\n    wx(c, arm64.ldr_x(3, 31, 160));\n    wx(c, arm64.str_w(0, 3, 0));\n    wx_label(c, \"wx_getsockopt_done\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n\n    // ================= sockets (Winsock) =================\n    // A socket is a SOCKET handle kept in the descriptor table (flag word = 2), so read/write go through ReadFile/WriteFile\n    // and close through closesocket. Darwin and Windows agree on SOL_SOCKET, SO_REUSEADDR and the AF/SOCK/IPPROTO values.\n    wx_label(c, \"wx_socket\");\n    wx_alloc(c, 2304);\n    wx_str(c, 0, 2048);\n    wx_str(c, 1, 2056);\n    wx_str(c, 2, 2064);\n    wx_get(c, patches, base, 9, 162);\n    wx_cbnz(c, 9, \"wx_socket_started\");\n    wx_li(c, 0, 514);\n    wx(c, arm64.add_imm_x(1, 31, 0, iie));\n    wx_call(c, patches, \"WSAStartup\");\n    wx_bool(c);\n    wx_cbnz(c, 0, \"wx_socket_wsa_failed\");\n    wx_li(c, 9, 1);\n    wx_put(c, patches, base, 9, 162);\n    wx_label(c, \"wx_socket_started\");\n    wx_ldr(c, 0, 2048);\n    wx_ldr(c, 1, 2056);\n    wx_ldr(c, 2, 2064);\n    wx_li(c, 3, 0);\n    wx_li(c, 4, 0);\n    wx_li(c, 5, 0);\n    wx_call(c, patches, \"WSASocketW\");\n    wx(c, arm64.cmn_imm_x(0, 1, iie));\n    wx_bcc(c, 0, \"wx_socket_failed\");\n    wx_str(c, 0, 2072);\n    wx_data(c, patches, base, 10, 256);\n    wx_li(c, 11, 0);\n    wx_label(c, \"wx_socket_scan\");\n    wx_cmpi(c, 11, 4032);\n    wx_bcc(c, 2, \"wx_socket_full\");\n    wx(c, arm64.ldr_x_register_scaled(12, 10, 11));\n    wx_cbz(c, 12, \"wx_socket_found\");\n    wx(c, arm64.add_imm_x(11, 11, 1, iie));\n    wx_b(c, \"wx_socket_scan\");\n    wx_label(c, \"wx_socket_found\");\n    wx_ldr(c, 0, 2072);\n    wx(c, arm64.lsl_x(12, 11, 3));\n    wx(c, arm64.add_x(12, 10, 12));\n    wx(c, arm64.str_x(0, 12, 0));\n    wx(c, arm64.add_imm_x(0, 11, 64, iie));\n    wx_free(c, 2304);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_socket_full\");\n    wx_ldr(c, 0, 2072);\n    wx_call(c, patches, \"closesocket\");\n    wx_free(c, 2304);\n    wx_li(c, 0, 24);\n    wx_b(c, \"wx_error\");\n    wx_label(c, \"wx_socket_wsa_failed\");\n    wx_bl(c, \"wx_map_error\");\n    wx_free(c, 2304);\n    wx_b(c, \"wx_error\");\n    wx_label(c, \"wx_socket_failed\");\n    wx_call(c, patches, \"WSAGetLastError\");\n    wx_bool(c);\n    wx_bl(c, \"wx_map_error\");\n    wx_free(c, 2304);\n    wx_b(c, \"wx_error\");\n\n    // bind / connect (fd, sockaddr_in, length): Darwin's sin_len + 8-bit family becomes Windows' 16-bit family\n    wx_label(c, \"wx_bind\");\n    wx_li(c, 9, 0);\n    wx_b(c, \"wx_sockaddr\");\n    wx_label(c, \"wx_connect\");\n    wx_li(c, 9, 1);\n    wx_label(c, \"wx_sockaddr\");\n    wx_alloc(c, 2304);\n    wx_str(c, 9, 2048);\n    wx(c, arm64.ldp_x(10, 11, 1, 0));\n    wx(c, arm64.stp_x(10, 11, 31, 16));\n    wx_li(c, 10, 2);\n    wx(c, arm64.strb_w(10, 31, 16));\n    wx(c, arm64.strb_w(31, 31, 17));\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_sockaddr_badfd\");\n    wx(c, arm64.add_imm_x(1, 31, 16, iie));\n    wx_li(c, 2, 16);\n    wx_ldr(c, 9, 2048);\n    wx_cbz(c, 9, \"wx_sockaddr_bind\");\n    wx_call(c, patches, \"connect\");\n    wx_b(c, \"wx_sockaddr_result\");\n    wx_label(c, \"wx_sockaddr_bind\");\n    wx_call(c, patches, \"bind\");\n    wx_label(c, \"wx_sockaddr_result\");\n    wx_bool(c);\n    wx_cbnz(c, 0, \"wx_sockaddr_failed\");\n    wx_free(c, 2304);\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    // A nonblocking connect reports WSAEWOULDBLOCK (mapped to EAGAIN, 35) while it is in progress: that is EINPROGRESS (36) on Darwin.\n    wx_label(c, \"wx_sockaddr_failed\");\n    wx_call(c, patches, \"WSAGetLastError\");\n    wx_bool(c);\n    wx_bl(c, \"wx_map_error\");\n    wx_ldr(c, 9, 2048);\n    wx_cbz(c, 9, \"wx_sockaddr_failed_done\");\n    wx_cmpi(c, 0, 35);\n    wx_bcc(c, 1, \"wx_sockaddr_failed_done\");\n    wx_li(c, 0, 36);\n    wx_label(c, \"wx_sockaddr_failed_done\");\n    wx_free(c, 2304);\n    wx_b(c, \"wx_error\");\n    wx_label(c, \"wx_sockaddr_badfd\");\n    wx_free(c, 2304);\n    wx_b(c, \"wx_badfd\");\n\n    // listen(fd, backlog)\n    wx_label(c, \"wx_listen\");\n    wx(c, arm64.str_x(1, 31, 144));\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_badfd\");\n    wx(c, arm64.ldr_x(1, 31, 144));\n    wx_call(c, patches, \"listen\");\n    wx_bool(c);\n    wx_cbnz(c, 0, \"wx_net_failed\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_net_failed\");\n    wx_call(c, patches, \"WSAGetLastError\");\n    wx_bool(c);\n    wx_bl(c, \"wx_map_error\");\n    wx_b(c, \"wx_error\");\n\n    // accept(fd, NULL, NULL): the new SOCKET gets a descriptor of its own\n    wx_label(c, \"wx_accept\");\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_badfd\");\n    wx_li(c, 1, 0);\n    wx_li(c, 2, 0);\n    wx_call(c, patches, \"accept\");\n    wx(c, arm64.cmn_imm_x(0, 1, iie));\n    wx_bcc(c, 0, \"wx_net_failed\");\n    wx(c, arm64.str_x(0, 31, 144));\n    wx_data(c, patches, base, 10, 256);\n    wx_li(c, 11, 0);\n    wx_label(c, \"wx_accept_scan\");\n    wx_cmpi(c, 11, 4032);\n    wx_bcc(c, 2, \"wx_accept_full\");\n    wx(c, arm64.ldr_x_register_scaled(12, 10, 11));\n    wx_cbz(c, 12, \"wx_accept_found\");\n    wx(c, arm64.add_imm_x(11, 11, 1, iie));\n    wx_b(c, \"wx_accept_scan\");\n    wx_label(c, \"wx_accept_found\");\n    wx(c, arm64.ldr_x(0, 31, 144));\n    wx(c, arm64.lsl_x(12, 11, 3));\n    wx(c, arm64.add_x(12, 10, 12));\n    wx(c, arm64.str_x(0, 12, 0));\n    wx(c, arm64.add_imm_x(0, 11, 64, iie));\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_accept_full\");\n    wx(c, arm64.ldr_x(0, 31, 144));\n    wx_call(c, patches, \"closesocket\");\n    wx_li(c, 0, 24);\n    wx_b(c, \"wx_error\");\n\n    // setsockopt(fd, level, name, value, length): SO_NOSIGPIPE (0x1022) has no Windows counterpart and is ignored\n    wx_label(c, \"wx_setsockopt\");\n    wx_li(c, 9, 4130);\n    wx(c, arm64.cmp_x(2, 9));\n    wx_bcc(c, 1, \"wx_setsockopt_real\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_setsockopt_real\");\n    // Darwin's SO_REUSEADDR only allows reuse of a port in TIME_WAIT; on Windows it would let a second socket take over a live\n    // port, so (like the Windows amd64 runtime) it becomes SO_EXCLUSIVEADDRUSE (0xFFFFFFFB): a second bind reports AddressInUse\n    wx_cmpi(c, 2, 4);\n    wx_bcc(c, 1, \"wx_setsockopt_pass\");\n    wx_li(c, 2, 4294967291);\n    wx_label(c, \"wx_setsockopt_pass\");\n    wx(c, arm64.stp_x(1, 2, 31, 144));\n    wx(c, arm64.stp_x(3, 4, 31, 160));\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_badfd\");\n    wx(c, arm64.ldp_x(1, 2, 31, 144));\n    wx(c, arm64.ldp_x(3, 4, 31, 160));\n    wx_call(c, patches, \"setsockopt\");\n    wx_bool(c);\n    wx_cbnz(c, 0, \"wx_net_failed\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n\n    // ---- memory. Darwin pages are 16 KiB: lengths are rounded up to 16 KiB (VirtualAlloc returns 64 KiB-aligned regions).\n    // mmap -> VirtualAlloc(NULL, length, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE)\n    wx_label(c, \"wx_mmap\");\n    wx_li(c, 9, 16383);\n    wx(c, arm64.add_x(1, 1, 9));\n    wx(c, arm64.movn_x(10, 16383, 0));\n    wx(c, arm64.and_x(1, 1, 10));\n    wx_li(c, 0, 0);\n    wx_li(c, 2, 12288);\n    wx_li(c, 3, 4);\n    wx_call(c, patches, \"VirtualAlloc\");\n    wx_cbz(c, 0, \"wx_nomem\");\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_nomem\");\n    wx_li(c, 0, 12);\n    wx_b(c, \"wx_error\");\n    // mprotect(addr, length, prot): PROT_NONE decommits the range, anything else commits it read/write\n    wx_label(c, \"wx_mprotect\");\n    wx(c, arm64.str_x(0, 31, 144));\n    wx(c, arm64.str_x(1, 31, 152));\n    wx_cbz(c, 2, \"wx_decommit\");\n    wx_li(c, 2, 4096);\n    wx_li(c, 3, 4);\n    wx_call(c, patches, \"VirtualAlloc\");\n    wx_cbz(c, 0, \"wx_nomem\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_decommit\");\n    wx_li(c, 2, 16384);\n    wx_call(c, patches, \"VirtualFree\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"wx_nomem\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    // munmap(addr, length): release the whole region when addr is its base, otherwise decommit the range\n    wx_label(c, \"wx_munmap\");\n    wx(c, arm64.str_x(0, 31, 144));\n    wx(c, arm64.str_x(1, 31, 152));\n    wx_li(c, 1, 0);\n    wx_li(c, 2, 32768);\n    wx_call(c, patches, \"VirtualFree\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"wx_munmap_range\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_munmap_range\");\n    wx(c, arm64.ldr_x(0, 31, 144));\n    wx(c, arm64.ldr_x(1, 31, 152));\n    wx_li(c, 9, 16383);\n    wx(c, arm64.add_x(1, 1, 9));\n    wx(c, arm64.movn_x(10, 16383, 0));\n    wx(c, arm64.and_x(1, 1, 10));\n    wx_li(c, 2, 16384);\n    wx_call(c, patches, \"VirtualFree\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"wx_nomem\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n}\n\n// Start-up: the three standard handles go into descriptor-table entries 0..2 and the console is switched to UTF-8.\nkoukai waza emit_windows_init(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64) -> unit {\n    wx_label(c, \"windows_init\");\n    wx(c, arm64.stp_pre_x(29, 30, 31, -16));\n    kaku handle = 0;\n    aida (handle < 3) {\n        wx_li(c, 0, 4294967286 - handle);\n        wx_call(c, patches, \"GetStdHandle\");\n        wx_data(c, patches, base, 10, 0);\n        wx(c, arm64.str_x(0, 10, handle * 8));\n        handle = handle + 1;\n    }\n    wx_li(c, 0, 65001);\n    wx_call(c, patches, \"SetConsoleOutputCP\");\n    wx_li(c, 0, 65001);\n    wx_call(c, patches, \"SetConsoleCP\");\n    // a parent that passed a records channel (spawn_test) describes it in STARTUPINFO.lpReserved2 with the C runtime layout:\n    // count (4 bytes), count flag bytes, count handles; descriptor 3 becomes table entry 3\n    wx_alloc(c, 128);\n    wx(c, arm64.add_imm_x(0, 31, 0, iie));\n    wx_call(c, patches, \"GetStartupInfoW\");\n    wx(c, arm64.ldrh_w(9, 31, 66));\n    wx_cmpi(c, 9, 40);\n    wx_bcc(c, 3, \"windows_init_done\");\n    wx(c, arm64.ldr_x(9, 31, 72));\n    wx_cbz(c, 9, \"windows_init_done\");\n    wx(c, arm64.ldr_w(10, 9, 0));\n    wx_cmpi(c, 10, 4);\n    wx_bcc(c, 3, \"windows_init_done\");\n    wx(c, arm64.ldrb_w(11, 9, 7));\n    wx_li(c, 12, 1);\n    wx(c, arm64.and_x(11, 11, 12));\n    wx_cbz(c, 11, \"windows_init_done\");\n    wx(c, arm64.add_x(12, 9, 10));\n    wx(c, arm64.add_imm_x(12, 12, 28, iie));\n    wx(c, arm64.ldr_x(13, 12, 0));\n    wx_data(c, patches, base, 14, 0);\n    wx(c, arm64.str_x(13, 14, 24));\n    wx_label(c, \"windows_init_done\");\n    wx_free(c, 128);\n    wx(c, arm64.ldp_post_x(29, 30, 31, 16));\n    wx(c, arm64.ret());\n}\n\n// Process arguments and environment as the Darwin entry expects them: x0 = argc, x1 = argv (UTF-8, NULL-terminated array),\n// x2 = envp (UTF-8 \"NAME=VALUE\" strings, NULL-terminated array). Everything lives in a 4 MiB arena that is never freed.\n// The command line is split by CommandLineToArgvW (the Windows quoting rules), then each argument is converted to UTF-8;\n// the environment block (a double-NUL-terminated UTF-16 list) is converted in one call and indexed.\nkoukai waza emit_windows_args(c: arm64.Assembler, patches: []macho.AddressPatch) -> unit {\n    wx_label(c, \"windows_args\");\n    wx(c, arm64.stp_pre_x(29, 30, 31, -128));\n    // arena\n    wx_li(c, 0, 0);\n    wx_li(c, 1, 4194304);\n    wx_li(c, 2, 12288);\n    wx_li(c, 3, 4);\n    wx_call(c, patches, \"VirtualAlloc\");\n    wx_cbz(c, 0, \"windows_args_fail\");\n    wx_str(c, 0, 16);\n    wx_str(c, 0, 24);\n    // argc / wide argv\n    wx_call(c, patches, \"GetCommandLineW\");\n    wx(c, arm64.add_imm_x(1, 31, 32, iie));\n    wx_call(c, patches, \"CommandLineToArgvW\");\n    wx_cbz(c, 0, \"windows_args_fail\");\n    wx_str(c, 0, 40);\n    wx(c, arm64.ldr_w(9, 31, 32));\n    wx_str(c, 9, 32);\n    // the argv pointer array\n    wx_ldr(c, 10, 24);\n    wx_str(c, 10, 48);\n    wx(c, arm64.add_imm_x(11, 9, 1, iie));\n    wx(c, arm64.lsl_x(11, 11, 3));\n    wx(c, arm64.add_x(10, 10, 11));\n    wx_str(c, 10, 24);\n    wx_str(c, 31, 56);\n    wx_label(c, \"windows_args_next\");\n    wx_ldr(c, 9, 56);\n    wx_ldr(c, 10, 32);\n    wx(c, arm64.cmp_x(9, 10));\n    wx_bcc(c, 2, \"windows_args_done\");\n    wx_ldr(c, 11, 40);\n    wx(c, arm64.ldr_x_register_scaled(2, 11, 9));\n    wx_li(c, 0, 65001);\n    wx_li(c, 1, 0);\n    wx(c, arm64.movn_x(3, 0, 0));\n    wx_ldr(c, 4, 24);\n    wx_ldr(c, 9, 16);\n    wx_li(c, 12, 4194304);\n    wx(c, arm64.add_x(9, 9, 12));\n    wx(c, arm64.sub_x(5, 9, 4));\n    wx_li(c, 6, 0);\n    wx_li(c, 7, 0);\n    wx_call(c, patches, \"WideCharToMultiByte\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"windows_args_fail\");\n    wx_ldr(c, 9, 56);\n    wx_ldr(c, 10, 48);\n    wx_ldr(c, 11, 24);\n    wx(c, arm64.lsl_x(12, 9, 3));\n    wx(c, arm64.add_x(12, 10, 12));\n    wx(c, arm64.str_x(11, 12, 0));\n    wx(c, arm64.add_x(11, 11, 0));\n    wx_str(c, 11, 24);\n    wx(c, arm64.add_imm_x(9, 9, 1, iie));\n    wx_str(c, 9, 56);\n    wx_b(c, \"windows_args_next\");\n    wx_label(c, \"windows_args_done\");\n    wx_ldr(c, 9, 32);\n    wx_ldr(c, 10, 48);\n    wx(c, arm64.lsl_x(9, 9, 3));\n    wx(c, arm64.add_x(10, 10, 9));\n    wx(c, arm64.str_x(31, 10, 0));\n    // the environment block\n    wx_ldr(c, 11, 24);\n    wx(c, arm64.add_imm_x(11, 11, 7, iie));\n    wx(c, arm64.movn_x(12, 7, 0));\n    wx(c, arm64.and_x(11, 11, 12));\n    wx_str(c, 11, 24);\n    wx_call(c, patches, \"GetEnvironmentStringsW\");\n    wx_str(c, 0, 64);\n    wx_cbz(c, 0, \"windows_args_noenv\");\n    // length in UTF-16 units: up to and including the terminating pair of NULs\n    wx_mov(c, 9, 0);\n    wx_label(c, \"windows_args_scan\");\n    wx(c, arm64.ldrh_w(10, 9, 0));\n    wx_cbnz(c, 10, \"windows_args_advance\");\n    wx(c, arm64.ldrh_w(10, 9, 2));\n    wx_cbz(c, 10, \"windows_args_scanned\");\n    wx_label(c, \"windows_args_advance\");\n    wx(c, arm64.add_imm_x(9, 9, 2, iie));\n    wx_b(c, \"windows_args_scan\");\n    wx_label(c, \"windows_args_scanned\");\n    wx_ldr(c, 10, 64);\n    wx(c, arm64.sub_x(9, 9, 10));\n    wx(c, arm64.lsr_x(3, 9, 1));\n    wx(c, arm64.add_imm_x(3, 3, 2, iie));\n    wx_li(c, 0, 65001);\n    wx_li(c, 1, 0);\n    wx_ldr(c, 2, 64);\n    wx_ldr(c, 4, 24);\n    wx_ldr(c, 9, 16);\n    wx_li(c, 12, 4194304);\n    wx(c, arm64.add_x(9, 9, 12));\n    wx(c, arm64.sub_x(5, 9, 4));\n    wx_li(c, 6, 0);\n    wx_li(c, 7, 0);\n    wx_call(c, patches, \"WideCharToMultiByte\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"windows_args_noenv\");\n    wx_str(c, 0, 80);\n    wx_ldr(c, 9, 24);\n    wx_str(c, 9, 72);\n    wx_ldr(c, 10, 80);\n    wx(c, arm64.add_x(9, 9, 10));\n    wx(c, arm64.add_imm_x(9, 9, 7, iie));\n    wx(c, arm64.movn_x(12, 7, 0));\n    wx(c, arm64.and_x(9, 9, 12));\n    wx_str(c, 9, 88);\n    // envp[k] = start of each non-empty string\n    wx_li(c, 11, 0);\n    wx_li(c, 12, 1);\n    wx_li(c, 13, 0);\n    wx_label(c, \"windows_args_env_loop\");\n    wx_ldr(c, 10, 80);\n    wx(c, arm64.cmp_x(11, 10));\n    wx_bcc(c, 2, \"windows_args_env_end\");\n    wx_ldr(c, 9, 72);\n    wx(c, arm64.add_x(9, 9, 11));\n    wx(c, arm64.ldrb_w(14, 9, 0));\n    wx_cbz(c, 14, \"windows_args_env_nul\");\n    wx_cbz(c, 12, \"windows_args_env_cont\");\n    wx_ldr(c, 15, 88);\n    wx(c, arm64.lsl_x(16, 13, 3));\n    wx(c, arm64.add_x(15, 15, 16));\n    wx(c, arm64.str_x(9, 15, 0));\n    wx(c, arm64.add_imm_x(13, 13, 1, iie));\n    wx_label(c, \"windows_args_env_cont\");\n    wx_li(c, 12, 0);\n    wx(c, arm64.add_imm_x(11, 11, 1, iie));\n    wx_b(c, \"windows_args_env_loop\");\n    wx_label(c, \"windows_args_env_nul\");\n    wx_li(c, 12, 1);\n    wx(c, arm64.add_imm_x(11, 11, 1, iie));\n    wx_b(c, \"windows_args_env_loop\");\n    wx_label(c, \"windows_args_env_end\");\n    wx_ldr(c, 15, 88);\n    wx(c, arm64.lsl_x(16, 13, 3));\n    wx(c, arm64.add_x(15, 15, 16));\n    wx(c, arm64.str_x(31, 15, 0));\n    wx_b(c, \"windows_args_return\");\n    wx_label(c, \"windows_args_noenv\");\n    wx_ldr(c, 9, 24);\n    wx_str(c, 9, 88);\n    wx(c, arm64.str_x(31, 9, 0));\n    wx_label(c, \"windows_args_return\");\n    wx_ldr(c, 0, 32);\n    wx_ldr(c, 1, 48);\n    wx_ldr(c, 2, 88);\n    wx(c, arm64.ldp_post_x(29, 30, 31, 128));\n    wx(c, arm64.ret());\n    wx_label(c, \"windows_args_fail\");\n    wx_li(c, 0, 3);\n    wx_call(c, patches, \"ExitProcess\");\n    wx_label(c, \"windows_args_hang\");\n    wx_b(c, \"windows_args_hang\");\n}\n\n// PE entry point: the loader calls it with no arguments. It initialises the adapter, builds argc/argv/envp from the real\n// command line and environment, and continues at the first lowered word (label windows_main) with the Darwin entry registers.\nkoukai waza emit_windows_start(c: arm64.Assembler) -> unit {\n    wx_label(c, \"windows_start\");\n    wx_bl(c, \"windows_init\");\n    wx_bl(c, \"windows_args\");\n    wx_b(c, \"windows_main\");\n}\n" }; }
waza data_35() -> File { kaesu File { path: "kiso/aot/lower/worker_roots.mio", version: "Bunko-v2.1.1", length: 62191, sha256: "0904d85b66c679a6ea877418fe3ccba79bb15a8550208893867ce5541cb356f5", source: "// Darwin/AArch64 implementation of the portable managed-mutator protocol.\n// The internal bridge has two joinable worker slots and a shared process key.\n// Each slot owns native context/opaque locks/bootstrap root/snapshot storage.\n// The bridge owns one context per concurrently live worker (plus the main thread's): `worker_slots` of them, 8800 bytes each. A start with\n// every slot in use is a runtime error (never a silent wait); the public thread API will turn that into an explicit error value.\nkoukai teisu worker_slots=128;\nkoukai teisu word_blocks=16384;\n// Off-heap control words for channels: a pool of word_blocks blocks of 8 words after the thread contexts. Word 0 of the pool counts issued\n// blocks; block h (a handle, 1..word_blocks) starts at word 8*h. Blocks are never reused (a channel's control block stays valid for the life of\n// the process, so a thread still inside send/receive or using an old Channel alias can never touch recycled memory).\n// Exhaustion is permanent for that process: words_new returns -12 without issuing a handle or modifying any block.\n// Words per thread context: the fixed records, then (from wr_snapshot) the collector's root snapshot of wr_snapshot_capacity entries.\nteisu wr_ctx_words=5200;\nkoukai teisu worker_root_words=(worker_slots+1)*wr_ctx_words+4+(word_blocks+1)*8;\nteisu wr_stride=41600;\n// Context word at +8800: the integer a worker entry returned (0 for an entry that returns nothing); join hands it to the caller.\nteisu wr_result=8800;\n// Context word at +8808: zero when free, -1 during start or join, otherwise the exact joinable handle.\nteisu wr_claim=8808;\n// Context word at +8816: generation of the slot (counts joins; part of the handle). Word at +8824: status of this thread's last join (0 or 22).\nteisu wr_generation=8816;\nteisu wr_join_status=8824;\nteisu wr_snapshot=9000;\n// 4000 roots: with 128 live threads the stopped-world snapshot needs several dozen per thread (1000 overflowed: gc_scan_roots failed).\nteisu wr_snapshot_capacity=4000;\n// Diagnostic counters of an observed build (label worker_observe, mio build --observe), kept in the TAIL of each thread context. Layout audit: the\n// snapshot header and entries end at wr_snapshot+16+8*wr_snapshot_capacity = 41016 (gc_snapshot_root refuses an entry past the capacity) and the stride\n// is 41600, so bytes 41016..41599 of every context are referenced by no routine; contexts are zero-initialized global data that nothing clears or\n// reuses as a whole, so a slot's counters accumulate over the threads that used it. 3 kinds x 11 words + 1 word = 272 bytes from wr_obs. A normal\n// build never reads or writes these bytes and its image is byte-identical to one built before this code existed.\n//   kind 0 = gc_heap_enter (epoch acquisition), 1 = gc_mutator_poll (release / park), 2 = gc_block_leave (return from a blocking native)\n//   per kind: 9 buckets of elapsed nanoseconds [<1us, <4us, <16us, <64us, <256us, <1ms, <4ms, <16ms, >=16ms], then the sum and the maximum in ns.\nteisu wr_obs=41032;\nteisu wr_obs_kind=88;\nteisu wr_obs_retained=264;\n// Allocation lock (docs/darwin-thread-heap-exclusion-design.md section 11). The lock word lives in the zero-initialized tail of the main thread's\n// context (context 0, nothing else uses bytes 41304..41599). Observed builds also count, per thread context: allocations served by the lock fast path,\n// allocations that took the Epoch path, and attempts that exhausted the contention budget.\n// The last two counters track blocked wait rounds and requests that entered the wait path at least once.\nteisu wr_alloc_lock=41440;\nteisu wr_obs_alloc=41304;\nteisu wr_alloc_spin=256;\nteisu wr_alloc_wait_rounds=64;\nteisu wr_alloc_wait_us=1000;\nteisu wr_alloc_locked=1;\nteisu wr_alloc_waiting=2;\n// Darwin raw UNIX syscall errno values (carry set on error).\nteisu wr_ulock_enoent=2;\nteisu wr_ulock_eintr=4;\nteisu wr_ulock_etimedout=60;\nteisu wr_obs_wait_guard=41488; // first word after the allocation-lock stress fields\nteisu wr_obs_wait_preflight=41496;\nteisu wr_alloc_wait_disabled=41504; // main context, monotonic after a hard syscall error\nteisu wr_wait_test_arm=41512;       // per-thread test command\nteisu wr_wait_test_phase=41520;    // main context, test only\nteisu wr_wait_test_ctx=41528;      // main context, test only\nteisu wr_wait_test_gc_count=41536;\nwaza wr_wait_test(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,\"worker_alloc_wait_test\")>=0;}\nwaza wr_wait_owner_test(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,\"worker_alloc_wait_owner_test\")>=0;}\nwaza wr_wait_error_test(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,\"worker_alloc_wait_error_test\")>=0;}\nwaza wr_wait_park_test(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,\"worker_alloc_wait_park_test\")>=0;}\nwaza wr_main_word(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,dst:int64,offset:int64) -> unit {\n    wr_ctx(c,p,first,dst,0);wr_addr(c,dst,dst,offset);\n}\n// Lock-stress words, all in context 0's tail and touched only while holding the lock: +8 epoch seen at entry, +16 attempt counter.\nteisu wr_stress_period=4;\n// Largest request served by the lock fast path (the legacy allocator maps a large object at 128 KiB or more and the fast path never maps).\nteisu wr_alloc_small=4095;\n// Test-only lock-stress image (design doc section 12): label worker_alloc_lock_stress. Never present in a default image.\nwaza wr_lock_stress(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,\"worker_alloc_lock_stress\")>=0;}\n// Detector-sensitivity control (MIO_ALLOC_LOCK_STRESS=violate): the image deliberately polls inside the locked region, which the real protocol forbids.\nwaza wr_lock_violate(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,\"worker_alloc_lock_violate\")>=0;}\nwaza wr_observed(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,\"worker_observe\")>=0;}\n// Start of a timed runtime call: push the current time (attached_platform_now returns nanoseconds in x0).\nwaza wr_obs_begin(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {\n    moshi(!wr_observed(c)){kaesu;}\n    wr_imports(c,p,first);arm64.assembler_bl(c,\"attached_platform_now\");emit(c,arm64.sub_imm_x(31,31,16,iie));emit(c,arm64.str_x(0,31,0));\n}\n// End of a timed runtime call: elapsed time into the bucket, sum and maximum of this thread's context for `kind` (only this thread writes its context).\nwaza wr_obs_end(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,kind:int64) -> unit {\n    moshi(!wr_observed(c)){kaesu;}\n    wr_imports(c,p,first);arm64.assembler_bl(c,\"attached_platform_now\");emit(c,arm64.ldr_x(1,31,0));emit(c,arm64.sub_x(0,0,1));emit(c,arm64.str_x(0,31,0));\n    wr_current(c,p,first);emit(c,arm64.ldr_x(2,31,0));emit(c,arm64.add_imm_x(31,31,16,iie));\n    // x0 = context, x2 = elapsed ns. Bucket index in x3: the number of times 1000 * 4^k is <= elapsed (at most 8).\n    emit(c,arm64.movz_x(3,0,0));wr_num(c,4,1000);\n    kaku loop=block_label(\"wr_obs_bucket_\",len(c.words));kaku done=string.concat(loop,\"_done\");\n    arm64.assembler_label(c,loop);emit(c,arm64.cmp_x(2,4));arm64.assembler_b_cond(c,3,done);emit(c,arm64.add_imm_x(3,3,1,iie));emit(c,arm64.cmp_imm_x(3,8,iie));arm64.assembler_b_cond(c,0,done);emit(c,arm64.lsl_x(4,4,2));arm64.assembler_b(c,loop);\n    arm64.assembler_label(c,done);\n    wr_num(c,5,wr_obs+kind*wr_obs_kind);emit(c,arm64.add_x(5,0,5));\n    emit(c,arm64.lsl_x(6,3,3));emit(c,arm64.add_x(6,5,6));emit(c,arm64.ldr_x(7,6,0));emit(c,arm64.add_imm_x(7,7,1,iie));emit(c,arm64.str_x(7,6,0));\n    emit(c,arm64.ldr_x(7,5,72));emit(c,arm64.add_x(7,7,2));emit(c,arm64.str_x(7,5,72));\n    kaku skip=block_label(\"wr_obs_max_\",len(c.words));\n    emit(c,arm64.ldr_x(7,5,80));emit(c,arm64.cmp_x(2,7));arm64.assembler_b_cond(c,9,skip);emit(c,arm64.str_x(2,5,80));arm64.assembler_label(c,skip);\n}\nwaza worker_roots_enabled(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,\"worker_roots_enabled\")>=0;}\nwaza emit_print_boundary(c:arm64.Assembler) -> unit {\n    moshi(worker_roots_enabled(c)){\n        emit(c,arm64.sub_imm_x(31,31,16,iie));emit(c,arm64.str_x(30,31,0));arm64.assembler_bl(c,\"attached_native_enter\");\n        emit(c,arm64.svc(128));arm64.assembler_bl(c,\"attached_native_leave\");emit(c,arm64.ldr_x(30,31,0));emit(c,arm64.add_imm_x(31,31,16,iie));\n    } sore {emit(c,arm64.svc(128));}\n}\nwaza wr_emit(c:arm64.Assembler,w:arm64.Instruction) -> unit {emit(c,w);}\nwaza wr_ctx(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,r:int64,slot:int64) -> unit {attached_data_address(c,p,first+worker_import_slots(c)+slot*wr_ctx_words,r);}\nwaza wr_pool(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,r:int64) -> unit {attached_data_address(c,p,first+worker_import_slots(c)+(worker_slots+1)*wr_ctx_words,r);}\nwaza wr_neg(c:arm64.Assembler,r:int64,n:int64) -> unit {wr_num(c,r,n);emit(c,arm64.sub_x(r,31,r));}\n// Leaves the address of word x1 of block x0 in x13 or branches to bad. Clobbers x9-x13.\nwaza word_address(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,bad:string) -> unit {\n    arm64.assembler_cbz_x(c,0,bad);wr_num(c,14,word_blocks);emit(c,arm64.cmp_x(0,14));arm64.assembler_b_cond(c,8,bad);\n    emit(c,arm64.cmp_imm_x(1,8,iie));arm64.assembler_b_cond(c,2,bad);\n    wr_pool(c,p,first,9);emit(c,arm64.ldr_x(10,9,0));emit(c,arm64.cmp_x(0,10));arm64.assembler_b_cond(c,8,bad);\n    wr_num(c,12,8);emit(c,arm64.mul_x(11,0,12));emit(c,arm64.add_x(11,11,1));emit(c,arm64.mul_x(11,11,12));emit(c,arm64.add_x(13,9,11));\n}\nwaza emit_word_natives(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {\n    // words_new(n): n in 1..8\n    arm64.assembler_label(c,\"native_words_new\");emit(c,arm64.cmp_imm_x(0,1,iie));arm64.assembler_b_cond(c,11,\"native_word_bad\");emit(c,arm64.cmp_imm_x(0,8,iie));arm64.assembler_b_cond(c,12,\"native_word_bad\");\n    wr_pool(c,p,first,9);arm64.assembler_label(c,\"native_words_new_retry\");emit(c,arm64.ldxr_x(10,9,hai));wr_num(c,14,word_blocks);emit(c,arm64.cmp_x(10,14));arm64.assembler_b_cond(c,2,\"native_words_full\");\n    emit(c,arm64.add_imm_x(11,10,1,iie));emit(c,arm64.stxr_x(12,11,9,hai));arm64.assembler_cbnz_x(c,12,\"native_words_new_retry\");emit(c,arm64.add_imm_x(0,10,1,iie));emit(c,arm64.ret());\n    arm64.assembler_label(c,\"native_words_full\");emit(c,arm64.clrex());wr_neg(c,0,12);emit(c,arm64.ret());\n    arm64.assembler_label(c,\"native_word_bad\");wr_neg(c,0,22);emit(c,arm64.ret());\n    // words_free(h, n): blocks stay mapped for the life of the process\n    arm64.assembler_label(c,\"native_join_status\");emit(c,arm64.sub_imm_x(31,31,16,iie));emit(c,arm64.str_x(30,31,0));arm64.assembler_bl(c,\"attached_join_status\");emit(c,arm64.ldr_x(30,31,0));emit(c,arm64.add_imm_x(31,31,16,iie));emit(c,arm64.ret());\n    arm64.assembler_label(c,\"native_words_free\");emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ret());\n    arm64.assembler_label(c,\"native_word_get\");\n    moshi(wr_wait_park_test(c)){arm64.assembler_cbz_x(c,0,\"runtime_alloc_test_command\");}\n    word_address(c,p,first,\"native_word_bad\");emit(c,arm64.ldar_x(0,13));emit(c,arm64.ret());\n    arm64.assembler_label(c,\"native_word_set\");word_address(c,p,first,\"native_word_bad\");emit(c,arm64.stlr_x(2,13));emit(c,arm64.dmb_ish());emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ret());\n    // word_cas(h, i, expected, new) -> the value found\n    arm64.assembler_label(c,\"native_word_cas\");word_address(c,p,first,\"native_word_bad\");\n    arm64.assembler_label(c,\"native_word_cas_retry\");emit(c,arm64.ldxr_x(14,13,hai));emit(c,arm64.cmp_x(14,2));arm64.assembler_b_cond(c,1,\"native_word_cas_done\");\n    emit(c,arm64.stxr_x(15,3,13,hai));arm64.assembler_cbnz_x(c,15,\"native_word_cas_retry\");\n    arm64.assembler_label(c,\"native_word_cas_done\");move_x(c,0,14);emit(c,arm64.dmb_ish());emit(c,arm64.ret());\n    // word_add(h, i, delta) -> the value before\n    arm64.assembler_label(c,\"native_word_add\");word_address(c,p,first,\"native_word_bad\");\n    arm64.assembler_label(c,\"native_word_add_retry\");emit(c,arm64.ldxr_x(14,13,hai));emit(c,arm64.add_x(10,14,2));emit(c,arm64.stxr_x(15,10,13,hai));arm64.assembler_cbnz_x(c,15,\"native_word_add_retry\");\n    move_x(c,0,14);emit(c,arm64.dmb_ish());emit(c,arm64.ret());\n    // word_wake(h, i, n): waiters poll with a short timed sleep, so there is nothing to signal\n    arm64.assembler_label(c,\"native_word_wake\");word_address(c,p,first,\"native_word_bad\");\n    // ulock wake: one waiter for a count of 1 (a mutex hand-off), every waiter otherwise (flag 0x100, wake all). A wake with nobody waiting is a no-op.\n    emit(c,arm64.cmp_imm_x(2,1,iie));arm64.assembler_b_cond(c,0,\"native_word_wake_one\");wr_num(c,0,261);arm64.assembler_b(c,\"native_word_wake_go\");\n    arm64.assembler_label(c,\"native_word_wake_one\");wr_num(c,0,5);\n    arm64.assembler_label(c,\"native_word_wake_go\");move_x(c,1,13);emit(c,arm64.movz_x(2,0,0));wr_num(c,16,516);emit(c,arm64.svc(128));emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ret());\n    // word_wait(h, i, expected): returns once the word differs from expected, on a wake, or after at most 100 ms (callers re-check).\n    arm64.assembler_label(c,\"native_word_wait\");word_address(c,p,first,\"native_word_bad\");\n    emit(c,arm64.sub_imm_x(31,31,48,iie));emit(c,arm64.str_x(30,31,0));emit(c,arm64.str_x(0,31,8));emit(c,arm64.str_x(1,31,16));emit(c,arm64.str_x(2,31,24));\n    // Short holds are the common case: spin a bounded number of reads (no safepoint, so a collector waiting for this thread's acknowledgement waits\n    // for the whole spin) before sleeping. The budget is for this one call only; it never spans an epoch change and it is not the collector-park spin\n    // that #113 removed. Measured on macOS 15 with 3 cores and 9 channel threads (run 43818508856, mpmc_long): 4000 reads put 43 % of all samples into\n    // this loop, because with more runnable threads than cores the holder that must change the word is usually not running. 128 reads (about a\n    // microsecond at most) still cover a hold by a running thread.\n    wr_num(c,15,128);arm64.assembler_label(c,\"native_word_wait_spin\");emit(c,arm64.ldar_x(14,13));emit(c,arm64.cmp_x(14,2));arm64.assembler_b_cond(c,1,\"native_word_wait_done\");\n    emit(c,arm64.sub_imm_x(15,15,1,iie));arm64.assembler_cbnz_x(c,15,\"native_word_wait_spin\");\n    // Then block in the kernel on the word (ulock wait, 64-bit compare-and-wait) until a wake or 100 ms (a safety net: callers re-check the word).\n    // The thread is in the blocked region for the whole wait, exactly like a blocking write: a stop-the-world collection does not wait for it and its\n    // roots are already published; leaving the region parks it if a collection is running. This replaces the sleep-polling loop, whose shortest sleep\n    // cost about 0.65 ms on macOS (a ping-pong round trip took 1.3 ms) and which needed a periodic wake-up per waiting thread.\n    wr_num(c,0,5);move_x(c,1,13);emit(c,arm64.ldr_x(2,31,24));wr_num(c,3,100000);wr_num(c,16,515);\n    arm64.assembler_bl(c,\"attached_native_enter\");emit(c,arm64.svc(128));arm64.assembler_bl(c,\"attached_native_leave\");\n    arm64.assembler_label(c,\"native_word_wait_done\");emit(c,arm64.movz_x(0,0,0));emit(c,arm64.ldr_x(30,31,0));emit(c,arm64.add_imm_x(31,31,48,iie));emit(c,arm64.ret());\n}\nwaza wr_imports(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {attached_data_address(c,p,first,7);}\nwaza wr_num(c:arm64.Assembler,r:int64,n:int64) -> unit {move_bits(c,r,uint32(0),uint32(n));}\nwaza wr_current(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {\n    wr_ctx(c,p,first,0,0);wr_imports(c,p,first);emit(c,arm64.ldr_x(0,0,gc.thread_key));aarch64.emit_import_call(c,7,5,28);arm64.assembler_cbz_x(c,0,\"runtime_error\");\n    wr_ctx(c,p,first,9,0);emit(c,arm64.add_imm_x(9,9,400,iie));emit(c,arm64.ldr_x(10,0,gc.thread_registry));emit(c,arm64.cmp_x(9,10));arm64.assembler_b_cond(c,1,\"runtime_error\");\n    emit(c,arm64.ldr_x(10,0,gc.thread_registered));arm64.assembler_cbz_x(c,10,\"runtime_error\");\n    emit(c,arm64.add_imm_x(9,0,gc.thread_shadow,iie));emit(c,arm64.stlr_x(24,9));wr_imports(c,p,first);\n}\n// x9 = allocation lock. SWPL xzr,x10,[x9] is available on Darwin ARM64\n// (FEAT_LSE). Clear the word and take its old value in one release operation.\n// A waiter can change held -> waiting even while its mutator is parked.\nwaza wr_alloc_unlock(c:arm64.Assembler) -> unit {\n    emit(c,arm64.swpl_x(31,10,9));\n    emit(c,arm64.cmp_imm_x(10,wr_alloc_waiting,iie));\n    kaku done=block_label(\"runtime_alloc_unlock_\",len(c.words));\n    arm64.assembler_b_cond(c,1,done);\n    arm64.assembler_bl(c,\"runtime_alloc_wake\");\n    arm64.assembler_label(c,done);\n}\nwaza wr_alloc_observe(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,offset:int64) -> unit {\n    moshi(!wr_observed(c)){kaesu;}\n    wr_current(c,p,first);\n    wr_addr(c,11,0,wr_obs_alloc+offset);\n    wr_increment(c,11,0);\n}\n// A failed runtime call ends the process. In the public thread build the exit status says which call failed and how (30 + 4 * call + min(result, 3));\n// test builds keep the plain runtime error (status 1).\nwaza wr_call(c:arm64.Assembler,name:string) -> unit {\n    arm64.assembler_bl(c,string.concat(\"attached_\",name));\n    moshi(arm64.assembler_label_word(c,\"worker_evidence\")>=0){arm64.assembler_cbnz_x(c,0,\"runtime_error\");}\n    sore {\n        kaku names=[\"gc_block_enter\",\"gc_block_leave\",\"thread_open_shared\",\"thread_wait_started\",\"thread_wait_completion\",\"thread_close\",\"gc_mutator_poll\",\"gc_heap_enter\",\"thread_attach\",\"thread_enter\",\"thread_leave\",\"gc_scan_roots\"];\n        kaku id=12;kaku i=0;aida(i<len(names)){moshi(names[i]==name){id=i;}i=i+1;}\n        kaku ok=block_label(\"wr_ok_\",len(c.words));arm64.assembler_cbz_x(c,0,ok);\n        emit(c,arm64.cmp_imm_x(0,3,iie));kaku keep=block_label(\"wr_rc_\",len(c.words));arm64.assembler_b_cond(c,9,keep);emit(c,arm64.movz_x(0,3,0));arm64.assembler_label(c,keep);\n        emit(c,arm64.add_imm_x(0,0,30+id*4,iie));emit(c,arm64.movz_x(16,1,0));emit(c,arm64.svc(128));arm64.assembler_label(c,ok);\n    }\n}\nwaza wr_poll(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,operation:string) -> unit {wr_current(c,p,first);move_x(c,1,24);wr_call(c,operation);}\nwaza wr_addr(c:arm64.Assembler,r:int64,base:int64,offset:int64) -> unit {wr_num(c,12,offset);emit(c,arm64.add_x(r,base,12));}\nwaza wr_increment(c:arm64.Assembler,ctx:int64,offset:int64) -> unit {emit(c,arm64.ldr_x(10,ctx,offset));emit(c,arm64.add_imm_x(10,10,1,iie));emit(c,arm64.str_x(10,ctx,offset));}\nwaza wr_snapshot_trace(c:arm64.Assembler,ctx:int64) -> unit {\n    kaku done=block_label(\"worker_snapshot_max_\",len(c.words));emit(c,arm64.ldr_x(10,ctx,wr_snapshot+8));emit(c,arm64.ldr_x(11,ctx,8672));emit(c,arm64.cmp_x(10,11));arm64.assembler_b_cond(c,9,done);emit(c,arm64.str_x(10,ctx,8672));arm64.assembler_label(c,done);\n    emit(c,arm64.ldr_x(11,ctx,gc.thread_registry));emit(c,arm64.add_imm_x(11,11,gc.gc_registry_epoch,iie));emit(c,arm64.ldar_x(10,11));emit(c,arm64.str_x(10,ctx,8680));\n}\n// Observed builds: the main thread prints the epoch-protocol counters once, after every thread it started has been joined (stderr, text, same format\n// family as the heap observation record: `mio-thread name=value`). Sums over every context slot; maxima over every slot. The registry epoch word is\n// the number of epochs entered by anyone (gc_begin increments it), the buckets are timed calls described at wr_obs.\nwaza wr_obs_print(c:arm64.Assembler,name:string) -> unit {\n    kaku prefix=string.to_bytes(string.concat(string.concat(\"mio-thread \",name),\"=\"));kaku bytes=((len(prefix)+15)/16)*16;\n    emit(c,arm64.sub_imm_x(31,31,bytes,iie));kaku i=0;\n    aida(i<len(prefix)){emit(c,arm64.movz_w(9,int64(prefix[i])));emit(c,arm64.strb_w(9,31,i));i=i+1;}\n    emit(c,arm64.movz_x(0,2,0));emit(c,arm64.add_imm_x(1,31,0,iie));emit(c,arm64.movz_x(2,len(prefix),0));emit(c,arm64.movz_x(16,4,0));emit(c,arm64.svc(128));\n    emit(c,arm64.add_imm_x(31,31,bytes,iie));move_x(c,0,15);arm64.assembler_bl(c,\"observation_print_uint\");\n}\n// x15 = sum (or maximum when `maximum`) of the word at `offset` of every thread context.\nwaza wr_obs_total(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64,offset:int64,maximum:bool) -> unit {\n    wr_ctx(c,p,first,10,0);wr_num(c,11,worker_slots+1);wr_num(c,14,wr_stride);wr_num(c,12,offset);emit(c,arm64.movz_x(15,0,0));\n    kaku loop=block_label(\"wr_obs_total_\",len(c.words));kaku skip=string.concat(loop,\"_skip\");\n    arm64.assembler_label(c,loop);emit(c,arm64.add_x(13,10,12));emit(c,arm64.ldr_x(13,13,0));\n    moshi(maximum){emit(c,arm64.cmp_x(13,15));arm64.assembler_b_cond(c,9,skip);move_x(c,15,13);arm64.assembler_label(c,skip);}\n    sore{emit(c,arm64.add_x(15,15,13));}\n    emit(c,arm64.add_x(10,10,14));emit(c,arm64.sub_imm_x(11,11,1,iie));arm64.assembler_cbnz_x(c,11,loop);\n}\nwaza emit_worker_observation_dump(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {\n    attached_save(c,\"worker_observation_dump\");\n    wr_ctx(c,p,first,10,0);emit(c,arm64.ldr_x(13,10,gc.thread_registry));emit(c,arm64.ldr_x(15,13,gc.gc_registry_epoch));wr_obs_print(c,\"epochs_entered\");\n    wr_obs_total(c,p,first,480,iie);wr_obs_print(c,\"safepoint_polls\");\n    wr_obs_total(c,p,first,488,iie);wr_obs_print(c,\"runtime_protocol_calls\");\n    wr_obs_total(c,p,first,8648,iie);wr_obs_print(c,\"blocking_native_entries\");\n    wr_obs_total(c,p,first,wr_obs+wr_obs_retained,iie);wr_obs_print(c,\"retained_polls_taken\");\n    wr_