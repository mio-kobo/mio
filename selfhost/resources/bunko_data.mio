and layout survive the allocator in callee-saved registers.\n    emit(code, arm64.sub_imm_x(31, 31, 16, iie)); emit(code, arm64.str_x(22, 31, 0));\n    move_x(code, 22, 10); arm64.assembler_bl(code, \"runtime_alloc\"); arm64.assembler_cbz_x(code, 0, \"runtime_oom\"); move_x(code, 14, 0);\n    kaku flags = 3 + width * 256; moshi (reference) { flags = flags + 65536; }\n    move_bits(code, 9, uint32(0), uint32(flags)); emit(code, arm64.str_x(9, 14, 0)); emit(code, arm64.str_x(22, 14, 8)); move_bits(code, 9, uint32(0), uint32(1)); emit(code, arm64.str_x(9, 14, 16));\n    kaku ref = 0; moshi (reference) { ref = 1; } move_bits(code, 9, uint32(0), uint32(ref)); emit(code, arm64.str_x(9, 14, 24));\n    // Free-list reuse is not zero-filled. Clear all logical storage so unused\n    // reference slots can safely be scanned.\n    move_bits(code, 10, uint32(0), uint32(width)); emit(code, arm64.mul_x(10, 22, 10)); emit(code, arm64.add_imm_x(11, 14, 32, iie)); move_bits(code, 12, uint32(0), uint32(0));\n    kaku zero_loop = string.concat(\"array_zero_\", convert.format_int(len(code.words))); kaku zero_done = string.concat(\"array_zero_done_\", convert.format_int(len(code.words))); arm64.assembler_label(code, zero_loop); emit(code, arm64.cmp_x(12, 10)); arm64.assembler_b_cond(code, 2, zero_done); emit(code, arm64.strb_w(31, 11, 0)); emit(code, arm64.add_imm_x(11, 11, 1, iie)); emit(code, arm64.add_imm_x(12, 12, 1, iie)); arm64.assembler_b(code, zero_loop); arm64.assembler_label(code, zero_done);\n    // Nested temporary root protects storage while descriptor allocation may\n    // collect; the outer exact frame continues protecting caller values.\n    emit(code, arm64.sub_imm_x(31, 31, 32, iie)); emit(code, arm64.str_x(24, 31, 0)); move_bits(code, 9, uint32(0), uint32(1)); emit(code, arm64.str_x(9, 31, 8)); emit(code, arm64.str_x(14, 31, 16)); emit(code, arm64.add_imm_x(24, 31, 0, iie));\n    move_bits(code, 0, uint32(0), uint32(48)); move_bits(code, 1, uint32(0), uint32(101)); arm64.assembler_bl(code, \"runtime_alloc\"); emit(code, arm64.ldr_x(14, 31, 16)); emit(code, arm64.ldr_x(24, 31, 0)); emit(code, arm64.add_imm_x(31, 31, 32, iie)); arm64.assembler_cbz_x(code, 0, \"runtime_oom\"); move_x(code, 12, 0);\n    kaku descriptor_flags = 2 + width * 256; moshi (reference) { descriptor_flags = descriptor_flags + 65536; }\n    move_bits(code, 9, uint32(0), uint32(descriptor_flags)); emit(code, arm64.str_x(9, 12, 0)); move_bits(code, 9, uint32(0), uint32(0)); emit(code, arm64.str_x(9, 12, 8)); emit(code, arm64.str_x(22, 12, 16)); move_bits(code, 9, uint32(0), uint32(1)); emit(code, arm64.str_x(9, 12, 24)); emit(code, arm64.str_x(9, 12, 32)); emit(code, arm64.str_x(14, 12, 40));\n    emit(code, arm64.ldr_x(22, 31, 0)); emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    emit_shadow_pop(code, shadow_bytes); push_register(code, 12); kaesu hai;\n}\n\n// The exact caller shadow frame owns both descriptors and transitively their\n// storage/elements. Runtime scratch slots are never treated as conservative roots.\nwaza emit_array_mutation(code: arm64.Assembler, patches: []macho.AddressPatch,\n    type_result: types.TypeAnalysis, function_id: int64, entries: []int64, opcode: int64) -> bool {\n    kaku shadow_bytes = emit_shadow_push(code, patches, type_result, function_id, entries);\n    moshi (shadow_bytes < 0) { kaesu iie; }\n    emit(code, arm64.add_x(8, 19, 20)); emit(code, arm64.sub_imm_x(8, 8, 16, iie));\n    emit(code, arm64.ldr_x(0, 8, 0)); emit(code, arm64.ldr_x(1, 8, 8));\n    moshi (opcode == 61 || opcode == 63) { emit_unbox_register(code, type_result, entries[len(entries) - 1], 1); }\n    moshi (opcode == 64) { arm64.assembler_bl(code, \"runtime_array_append\"); }\n    moshi (opcode == 59) { arm64.assembler_bl(code, \"runtime_array_push\"); }\n    moshi (opcode == 61) { arm64.assembler_bl(code, \"runtime_array_reserve\"); }\n    moshi (opcode == 63) { arm64.assembler_bl(code, \"runtime_array_truncate\"); }\n    emit(code, arm64.sub_imm_x(20, 20, 16, iie)); emit_shadow_pop(code, shadow_bytes); kaesu hai;\n}\n\nwaza array_inferred_descriptor(type_result: types.TypeAnalysis, node: int64) -> int64 {\n    kaku root = node;\n    aida (type_result.arena.parent[root] != root) { root = type_result.arena.parent[root]; }\n    kaku fields = type_result.arena.fields[root];\n    moshi (len(fields) == 0) { kaesu -1; }\n    kaku element = fields[0]; kaku kind = types.type_kind(type_result, element);\n    moshi (kind == types.type_unknown) { kaesu -1; }\n    kaku descriptor = 1;\n    moshi (type_result.arena.array_width[root] == 1) { descriptor = 15; }\n    moshi (kind == types.type_string_id) { descriptor = 5; }\n    moshi (kind == types.type_array_ref) { descriptor = 7; }\n    moshi (kind == types.type_struct_ref) { descriptor = 8; }\n    moshi (kind == types.type_enum_ref) { descriptor = 9; }\n    moshi (kind == types.type_map_ref) { descriptor = 10; }\n    moshi (kind == types.type_function_ref) { descriptor = 11; }\n    moshi (types.type_nullable(type_result, element)) { descriptor = descriptor + 128; }\n    kaesu descriptor;\n}\n\nwaza emit_array_construct(code: arm64.Assembler, patches: []macho.AddressPatch,\n    type_result: types.TypeAnalysis, function_id: int64, entries: []int64,\n    opcode: int64, count: int64, descriptor: int64) -> bool {\n    moshi (descriptor < 0) { kaesu iie; }\n    // Existing elements/source stay on the operand stack throughout both\n    // allocations; the temporary capacity is scalar and adds no Root.\n    moshi (opcode == 30 || opcode == 56) { move_bits(code, 9, uint32(0), uint32(count)); }\n    moshi (opcode == 57) { emit(code, arm64.add_x(8, 19, 20)); emit(code, arm64.sub_imm_x(8, 8, 16, iie)); emit(code, arm64.ldr_x(9, 8, 0)); emit_unbox_register(code, type_result, entries[len(entries) - 2], 9); }\n    moshi (opcode == 62) { emit(code, arm64.add_x(8, 19, 20)); emit(code, arm64.sub_imm_x(8, 8, 8, iie)); emit(code, arm64.ldr_x(9, 8, 0)); emit(code, arm64.ldr_x(9, 9, 8)); }\n    push_register(code, 9);\n    moshi (!emit_array_with_capacity(code, patches, type_result, function_id, entries, descriptor, -1)) { kaesu iie; }\n    pop_register(code, 12);\n    emit(code, arm64.ldr_x(11, 12, 40)); emit(code, arm64.add_imm_x(11, 11, 32, iie));\n    kaku width = array_descriptor_width(descriptor);\n    moshi (opcode == 30 || opcode == 56) {\n        kaku index = count;\n        aida (index > 0) {\n            index = index - 1; pop_register(code, 9);\n            moshi (width == 1) { emit(code, arm64.strb_w(9, 11, index)); }\n            sore { emit(code, arm64.str_x(9, 11, index * 8)); }\n        }\n        move_bits(code, 10, uint32(0), uint32(count)); emit(code, arm64.str_x(10, 12, 8));\n    }\n    moshi (opcode == 57) {\n        pop_register(code, 9); pop_register(code, 10); emit_unbox_register(code, type_result, entries[len(entries) - 2], 10); emit(code, arm64.str_x(10, 12, 8));\n        kaku loop = string.concat(\"array_make_\", convert.format_int(len(code.words))); kaku done = string.concat(loop, \"_done\");\n        arm64.assembler_label(code, loop); arm64.assembler_cbz_x(code, 10, done);\n        moshi (width == 1) { emit(code, arm64.strb_w(9, 11, 0)); }\n        sore { emit(code, arm64.str_x(9, 11, 0)); }\n        emit(code, arm64.add_imm_x(11, 11, width, iie)); emit(code, arm64.sub_imm_x(10, 10, 1, iie)); arm64.assembler_b(code, loop); arm64.assembler_label(code, done);\n    }\n    moshi (opcode == 62) {\n        pop_register(code, 13); emit(code, arm64.ldr_x(10, 13, 8)); emit(code, arm64.str_x(10, 12, 8)); emit(code, arm64.ldr_x(13, 13, 40)); emit(code, arm64.add_imm_x(13, 13, 32, iie));\n        move_bits(code, 9, uint32(0), uint32(width)); emit(code, arm64.mul_x(10, 10, 9));\n        kaku loop = string.concat(\"array_clone_\", convert.format_int(len(code.words))); kaku done = string.concat(loop, \"_done\");\n        arm64.assembler_label(code, loop); arm64.assembler_cbz_x(code, 10, done); emit(code, arm64.ldrb_w(9, 13, 0)); emit(code, arm64.strb_w(9, 11, 0)); emit(code, arm64.add_imm_x(11, 11, 1, iie)); emit(code, arm64.add_imm_x(13, 13, 1, iie)); emit(code, arm64.sub_imm_x(10, 10, 1, iie)); arm64.assembler_b(code, loop); arm64.assembler_label(code, done);\n    }\n    push_register(code, 12); kaesu hai;\n}\n\nwaza emit_set_index(code: arm64.Assembler, analysis: types.TypeAnalysis, index_node: int64) -> unit {\n    pop_register(code, 9); pop_register(code, 10); pop_register(code, 12);\n    emit_unbox_register(code, analysis, index_node, 10);\n    arm64.assembler_cbz_x(code, 12, \"runtime_error\"); emit(code, arm64.ldr_x(11, 12, 8)); emit(code, arm64.cmp_x(10, 11)); arm64.assembler_b_cond(code, 2, \"runtime_error\");\n    emit(code, arm64.ldr_x(13, 12, 0)); emit(code, arm64.lsr_x(13, 13, 8)); move_bits(code, 14, uint32(0), uint32(255)); emit(code, arm64.and_x(13, 13, 14)); emit(code, arm64.ldr_x(11, 12, 40)); emit(code, arm64.add_imm_x(11, 11, 32, iie));\n    kaku byte = string.concat(\"set_index_byte_\", convert.format_int(len(code.words))); kaku done = string.concat(byte, \"_done\");\n    emit(code, arm64.cmp_imm_x(13, 1, iie)); arm64.assembler_b_cond(code, 0, byte); emit(code, arm64.lsl_x(10, 10, 3)); emit(code, arm64.add_x(11, 11, 10));\n    moshi(old_mark_proto_enabled(code)){kaku scalar=block_label(\"old_array_scalar_\",len(code.words));emit(code,arm64.ldr_x(13,12,40));emit(code,arm64.ldr_x(13,13,24));arm64.assembler_cbz_x(code,13,scalar);emit_old_typed_prewrite(code,11,0);arm64.assembler_label(code,scalar);}\n    emit_old_release_store(code,9,11,0); arm64.assembler_b(code, done);\n    arm64.assembler_label(code, byte); emit(code, arm64.add_x(11, 11, 10)); emit(code, arm64.strb_w(9, 11, 0)); arm64.assembler_label(code, done);\n    emit(code, arm64.ldr_x(11, 12, 40)); emit_gen_remember(code, 11);\n}\n\nwaza is_nullable_scalar(type_result: types.TypeAnalysis, node: int64) -> bool {\n    kaku kind = types.type_kind(type_result, node);\n    kaesu types.type_nullable(type_result, node) &&\n        (kind == types.type_integer || kind == types.type_float32 || kind == types.type_float64 ||\n         kind == types.type_float_any || kind == types.type_bool);\n}\n\nwaza is_raw_producer(opcode: int64) -> bool {\n    kaesu opcode == 1 || opcode == 8 || opcode == 9 || opcode == 10 || opcode == 34 ||\n        opcode == 7 || opcode == 2 || (opcode >= 4 && opcode <= 6) ||\n        (opcode >= 11 && opcode <= 16) || (opcode >= 28 && opcode <= 29) ||\n        (opcode >= 50 && opcode <= 55) || opcode == 32 || opcode == 60;\n}\n\nwaza emit_nullable_box(code: arm64.Assembler, patches: []macho.AddressPatch,\n    type_result: types.TypeAnalysis, function_id: int64, after: []int64) -> bool {\n    // The produced raw scalar is never published under its boxed result type.\n    // Retain only the surviving operand prefix, and keep raw bits off-root.\n    kaku live: []int64 = []; kaku i = 0;\n    aida (i + 1 < len(after)) { array.push(live, after[i]); i = i + 1; }\n    pop_register(code, 9); emit(code, arm64.sub_imm_x(31, 31, 16, iie)); emit(code, arm64.str_x(9, 31, 0));\n    kaku shadow_bytes = emit_shadow_push(code, patches, type_result, function_id, live);\n    moshi (shadow_bytes < 0) { kaesu iie; }\n    move_bits(code, 0, uint32(0), uint32(16)); move_bits(code, 1, uint32(0), uint32(106));\n    arm64.assembler_bl(code, \"runtime_alloc\"); emit_shadow_pop(code, shadow_bytes);\n    arm64.assembler_cbz_x(code, 0, \"runtime_oom\");\n    move_bits(code, 10, uint32(0), uint32(7)); emit(code, arm64.str_x(10, 0, 0));\n    emit(code, arm64.ldr_x(9, 31, 0)); emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    emit(code, arm64.str_x(9, 0, 8)); push_register(code, 0); kaesu hai;\n}\n\n// Convert one live operand slot to the physical scalar element ABI.\n// A private entry vector describes every intermediate GC safepoint; analysis\n// entries remain immutable and raw bits are never published as boxed Roots.\nwaza emit_array_operand(code: arm64.Assembler, patches: []macho.AddressPatch,\n    analysis: types.TypeAnalysis, function_id: int64, entries: []int64, index: int64, target: int64) -> bool {\n    kaku source = entries[index]; kaku source_box = is_nullable_scalar(analysis, source); kaku target_box = is_nullable_scalar(analysis, target);\n    moshi (source_box == target_box || types.type_kind(analysis, source) == types.type_nil) { entries[index] = target; kaesu hai; }\n    emit(code, arm64.ldr_x(9, 19, index * 8));\n    moshi (source_box) {\n        emit_unbox_register(code, analysis, source, 9); emit(code, arm64.str_x(9, 19, index * 8)); entries[index] = target; kaesu hai;\n    }\n    push_register(code, 9);\n    kaku after: []int64 = []; kaku at = 0;\n    aida (at < len(entries)) { array.push(after, entries[at]); at = at + 1; }\n    array.push(after, target);\n    moshi (!emit_nullable_box(code, patches, analysis, function_id, after)) { kaesu iie; }\n    pop_register(code, 9); emit(code, arm64.str_x(9, 19, index * 8)); entries[index] = target; kaesu hai;\n}\n\nwaza operand_entries(entries: []int64) -> []int64 {\n    kaku result: []int64 = []; kaku at = 0;\n    aida (at < len(entries)) { array.push(result, entries[at]); at = at + 1; }\n    kaesu result;\n}\n\nwaza file_uses_heap(file: mochi.File) -> bool {\n    kaku block = -1;\n    aida (block < len(file.functions)) {\n        kaku data = file.instructions; moshi (block >= 0) {\n            moshi (nativefs.operation(file.functions[block].name) != nativefs.op_none) { kaesu hai; }\n            data = file.functions[block].instructions;\n        }\n        kaku offset = 0;\n        aida (offset < len(data)) {\n            kaku opcode = int64(data[offset]);\n            moshi (opcode == 65 || opcode == 41 || opcode == 42 || opcode == 43 || opcode == 44 || opcode == 46 || opcode == 36 || opcode == 38 || opcode == 30 || (opcode >= 56 && opcode <= 64)) { kaesu hai; }\n            moshi (opcode == 21 || opcode == 34) { kaesu hai; }\n            kaku size = types.type_instruction_width(opcode); moshi (size == 0) { kaesu iie; }\n            offset = offset + size;\n        }\n        block = block + 1;\n    }\n    kaesu iie;\n}\n\nwaza file_uses_nativefs(file: mochi.File) -> bool {\n    kaku index = 0; aida (index < len(file.functions)) {\n        moshi (nativefs.operation(file.functions[index].name) != nativefs.op_none) { kaesu hai; }\n        index = index + 1;\n    }\n    kaesu iie;\n}\n\nwaza block_label(prefix: string, offset: int64) -> string {\n    kaesu string.concat(prefix, convert.format_int(offset));\n}\n\nwaza function_label(id: int64) -> string {\n    kaesu string.concat(\"fn_\", convert.format_int(id));\n}\n\nwaza function_end_label(id: int64) -> string {\n    kaesu string.concat(\"fn_end_\", convert.format_int(id));\n}\n\nwaza emit(code: arm64.Assembler, value: arm64.Instruction) -> unit {\n    arm64.assembler_emit(code, value);\n}\n\nwaza move_x(code: arm64.Assembler, destination: int64, source: int64) -> unit {\n    emit(code, arm64.orr_x(destination, 31, source));\n}\n\nwaza move_bits(code: arm64.Assembler, destination: int64, high: uint32, low: uint32) -> unit {\n    kaku low_value = int64(low);\n    kaku high_value = int64(high);\n    kaku part0 = low_value - (low_value / 65536) * 65536;\n    kaku part1 = low_value / 65536;\n    kaku part2 = high_value - (high_value / 65536) * 65536;\n    kaku part3 = high_value / 65536;\n    // Shortest MOVZ/MOVN + MOVK sequence: halfwords equal to the background (0 for MOVZ, 0xFFFF for MOVN) are skipped.\n    kaku parts = [part0, part1, part2, part3];\n    kaku zeros = 0; kaku ones = 0; kaku i = 0;\n    aida (i < 4) { moshi (parts[i] == 0) { zeros = zeros + 1; } moshi (parts[i] == 65535) { ones = ones + 1; } i = i + 1; }\n    kaku background = 0; moshi (ones > zeros) { background = 65535; }\n    kaku first = hai; i = 0;\n    aida (i < 4) {\n        moshi (parts[i] != background) {\n            moshi (first) {\n                moshi (background == 0) { emit(code, arm64.movz_x(destination, parts[i], i)); }\n               