waza data_23() -> File { kaesu File { path: "kiso/aot/lower/nativefs/worker_process.mio", version: "Bunko-v2.1.1", length: 2087, sha256: "8bac1a0aac0416afeca85b5cf547d2af57a480afc5969faafe235cb6c6af3d4c", source: "yobu \"kiso/aot/arm64\";\n// Darwin worker-mode process adapter. Input path/argv/envp are already copied\n// into unmanaged mappings. Never execute GC/TLS/locks in a fork child.\n// Caller owns its native frame and exact managed argument roots. On all paths\n// the existing exec cleanup releases every copied mapping before returning.\nwaza emit_worker_spawn_invoke(code: arm64.Assembler) -> unit {\n    // pid_t and wait status are32-bit OS outputs in zeroed native words.\n    emit(code, arm64.str_x(31, 31, 88));\n    emit(code, arm64.str_x(31, 31, 0));\n    mov(code, 5, 2);\n    mov(code, 4, 1);\n    mov(code, 1, 0);\n    emit(code, arm64.add_imm_x(0, 31, 88, iie));\n    bits(code, 2, 0);\n    bits(code, 3, 0);\n    arm64.assembler_bl(code, \"attached_native_enter\");\n    arm64.assembler_bl(code, \"worker_posix_spawn\");\n    arm64.assembler_bl(code, \"attached_native_leave\");\n    arm64.assembler_cbnz_x(code, 0, \"nativeos_worker_spawn_error\");\n    arm64.assembler_label(code, \"nativeos_worker_spawn_wait\");\n    emit(code, arm64.ldr_x(0, 31, 88));\n    emit(code, arm64.add_imm_x(1, 31, 0, iie));\n    bits(code, 2, 0);\n    bits(code, 3, 0);\n    bits(code, 16, 7);\n    emit(code, arm64.svc(128));\n    arm64.assembler_b_cond(code, 3, \"nativeos_worker_spawn_status\");\n    emit(code, arm64.cmp_imm_x(0, 4, iie));\n    arm64.assembler_b_cond(code, 0, \"nativeos_worker_spawn_wait\");\n    arm64.assembler_label(code, \"nativeos_worker_spawn_error\");\n    emit(code, arm64.sub_x(0, 31, 0));\n    arm64.assembler_b(code, \"nativeos_exec_failure\");\n    arm64.assembler_label(code, \"nativeos_worker_spawn_status\");\n    emit(code, arm64.ldr_x(9, 31, 0));\n    bits(code, 10, 127);\n    emit(code, arm64.and_x(10, 9, 10));\n    arm64.assembler_cbnz_x(code, 10, \"nativeos_worker_spawn_signal\");\n    emit(code, arm64.lsr_x(0, 9, 8));\n    bits(code, 10, 255);\n    emit(code, arm64.and_x(0, 0, 10));\n    arm64.assembler_b(code, \"nativeos_exec_failure\");\n    arm64.assembler_label(code, \"nativeos_worker_spawn_signal\");\n    emit(code, arm64.add_imm_x(0, 10, 128, iie));\n    arm64.assembler_b(code, \"nativeos_exec_failure\");\n}\n" }; }
waza data_24() -> File { kaesu File { path: "kiso/aot/lower/observation.mio", version: "Bunko-v2.1.1", length: 10799, sha256: "ef3f232bc0cb550d365750bd2d0036501b8270ea694a4710ad8f58427a2154da", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/string\";\nyobu \"kiso/convert\";\n\n// Observation metadata is outside the managed arena. M19b reserves 3072\n// bytes in both modes, including generation state and separate pause histograms.\n// All values are uint64 native words; no GC path allocates or writes stderr.\n// 288 objects, 296 physical allocation bytes, 304 occupied bytes, 312 peak,\n// 320 start counter, 328 last pause, 336 total pause, 344 max pause, 352 Hz,\n// 360..871 histogram, 872 before, 880 after, 888 cumulative reclaimed,\n// 896 current collection start. The runtime is currently single-threaded.\nteisu observation_metadata_bytes = 3072;\n\nwaza observation_word(code: arm64.Assembler, word: int64) -> unit {\n    emit(code, arm64.Instruction { word: uint32(word), error: mu });\n}\n\nwaza emit_observation_init(code: arm64.Assembler) -> unit {\n    observation_word(code, 3577471049); // MRS x9, CNTVCT_EL0 (0xd53be049)\n    emit(code, arm64.str_x(9, 23, 320));\n    observation_word(code, 3577470985); // MRS x9, CNTFRQ_EL0\n    emit(code, arm64.str_x(9, 23, 352));\n}\n\nwaza emit_observation_alloc(code: arm64.Assembler) -> unit {\n    arm64.assembler_cbz_x(code, 0, \"observation_alloc_done\");\n    // Read the actual block span: a reused block can contain unsplit padding.\n    emit(code, arm64.sub_imm_x(9, 0, 16, iie));\n    emit(code, arm64.ldr_x(9, 9, 8));\n    emit(code, arm64.add_imm_x(9, 9, 31, iie));\n    emit(code, arm64.movn_x(10, 15, 0));\n    emit(code, arm64.and_x(9, 9, 10));\n    emit(code, arm64.ldr_x(10, 23, 288));\n    emit(code, arm64.add_imm_x(10, 10, 1, iie));\n    emit(code, arm64.str_x(10, 23, 288));\n    emit(code, arm64.ldr_x(10, 23, 296));\n    emit(code, arm64.add_x(10, 10, 9));\n    emit(code, arm64.str_x(10, 23, 296));\n    emit(code, arm64.ldr_x(10, 23, 304));\n    emit(code, arm64.add_x(10, 10, 9));\n    emit(code, arm64.str_x(10, 23, 304));\n    emit(code, arm64.ldr_x(9, 23, 312));\n    emit(code, arm64.cmp_x(10, 9));\n    arm64.assembler_b_cond(code, 9, \"observation_alloc_done\");\n    emit(code, arm64.str_x(10, 23, 312));\n    arm64.assembler_label(code, \"observation_alloc_done\");\n}\n\nwaza emit_observation_gc_start(code: arm64.Assembler) -> unit {\n    emit(code, arm64.stp_pre_x(25, 26, 31, -16));\n    observation_word(code, 3577471049);\n    emit(code, arm64.str_x(9, 23, 896));\n    emit(code, arm64.ldr_x(9, 23, 304));\n    emit(code, arm64.str_x(9, 23, 872));\n    emit(code, arm64.movz_x(25, 0, 0));\n}\n\nwaza emit_observation_gc_end(code: arm64.Assembler) -> unit {\n    observation_word(code, 3577471049);\n    emit(code, arm64.ldr_x(10, 23, 896));\n    emit(code, arm64.sub_x(9, 9, 10));\n    emit(code, arm64.ldr_x(10, 23, gen_MajorTicks));\n    emit(code, arm64.add_x(10, 10, 9));\n    emit(code, arm64.str_x(10, 23, gen_MajorTicks));\n    emit(code, arm64.ldr_x(10, 23, gen_MajorMax));\n    emit(code, arm64.cmp_x(9, 10));\n    arm64.assembler_b_cond(code, 9, \"gen_major_kindmax\");\n    emit(code, arm64.str_x(9, 23, gen_MajorMax));\n    arm64.assembler_label(code, \"gen_major_kindmax\");\n    emit(code, arm64.str_x(9, 23, 328));\n    emit(code, arm64.ldr_x(10, 23, 336));\n    emit(code, arm64.add_x(10, 10, 9));\n    emit(code, arm64.str_x(10, 23, 336));\n    emit(code, arm64.ldr_x(10, 23, 344));\n    emit(code, arm64.cmp_x(9, 10));\n    arm64.assembler_b_cond(code, 9, \"observation_gc_max_done\");\n    emit(code, arm64.str_x(9, 23, 344));\n    arm64.assembler_label(code, \"observation_gc_max_done\");\n    // Bucket i has inclusive upper bound 2^i ticks. Bucket 63 also holds\n    // overflow. Zero and one tick use bucket 0; no samples are dropped.\n    emit(code, arm64.movz_x(11, 0, 0));\n    arm64.assembler_cbz_x(code, 9, \"observation_gc_bucket_done\");\n    emit(code, arm64.sub_imm_x(10, 9, 1, iie));\n    arm64.assembler_label(code, \"observation_gc_bucket\");\n    arm64.assembler_cbz_x(code, 10, \"observation_gc_bucket_done\");\n    emit(code, arm64.cmp_imm_x(11, 63, iie));\n    arm64.assembler_b_cond(code, 0, \"observation_gc_bucket_done\");\n    emit(code, arm64.lsr_x(10, 10, 1));\n    emit(code, arm64.add_imm_x(11, 11, 1, iie));\n    arm64.assembler_b(code, \"observation_gc_bucket\");\n    arm64.assembler_label(code, \"observation_gc_bucket_done\");\n    emit(code, arm64.lsl_x(11, 11, 3));\n    emit(code, arm64.add_x(11, 23, 11));\n    emit(code, arm64.ldr_x(10, 11, 360));\n    emit(code, arm64.add_imm_x(10, 10, 1, iie));\n    emit(code, arm64.str_x(10, 11, 360));\n    emit(code, arm64.ldr_x(10, 11, 2048));\n    emit(code, arm64.add_imm_x(10, 10, 1, iie));\n    emit(code, arm64.str_x(10, 11, 2048));\n    emit(code, arm64.str_x(25, 23, 304));\n    emit(code, arm64.str_x(25, 23, 880));\n    emit(code, arm64.ldr_x(9, 23, 872));\n    emit(code, arm64.sub_x(9, 9, 25));\n    emit(code, arm64.ldr_x(10, 23, 888));\n    emit(code, arm64.add_x(10, 10, 9));\n    emit(code, arm64.str_x(10, 23, 888));\n    emit(code, arm64.ldp_post_x(25, 26, 31, 16));\n}\n\n// Emit a compile-time ASCII prefix, then print x0 as an unsigned integer.\n// Runtime output only happens on exit, after the measured GC has returned.\nwaza emit_observation_metric(code: arm64.Assembler, name: string, offset: int64) -> unit {\n    kaku prefix = string.to_bytes(string.concat(string.concat(\"mio-gc \", name), \"=\"));\n    kaku bytes = ((len(prefix) + 15) / 16) * 16;\n    emit(code, arm64.sub_imm_x(31, 31, bytes, iie));\n    kaku i = 0;\n    aida (i < len(prefix)) {\n        emit(code, arm64.movz_w(9, int64(prefix[i])));\n        emit(code, arm64.strb_w(9, 31, i));\n        i = i + 1;\n    }\n    emit(code, arm64.movz_x(0, 2, 0));\n    emit(code, arm64.add_imm_x(1, 31, 0, iie));\n    emit(code, arm64.movz_x(2, len(prefix), 0));\n    emit(code, arm64.movz_x(16, 4, 0));\n    emit(code, arm64.svc(128));\n    emit(code, arm64.add_imm_x(31, 31, bytes, iie));\n    emit(code, arm64.ldr_x(0, 23, offset));\n    arm64.assembler_bl(code, \"observation_print_uint\");\n}\n\nwaza emit_observation_runtime(code: arm64.Assembler, metadata_bytes: int64) -> unit {\n    arm64.assembler_label(code, \"observation_dump\");\n    emit(code, arm64.stp_pre_x(29, 30, 31, -16));\n    arm64.assembler_cbz_x(code, 23, \"observation_dump_done\");\n    observation_word(code, 3577471049);\n    emit(code, arm64.ldr_x(10, 23, 320));\n    emit(code, arm64.sub_x(9, 9, 10));\n    emit(code, arm64.str_x(9, 23, 912));\n    emit(code, arm64.ldr_x(9, 23, 8));\n    emit(code, arm64.add_imm_x(10, 23, metadata_bytes, iie));\n    emit(code, arm64.sub_x(9, 9, 10));\n    emit(code, arm64.str_x(9, 23, 904));\n    emit(code, arm64.ldr_x(9, 23, 0));\n    emit(code, arm64.sub_x(9, 9, 10));\n    emit(code, arm64.str_x(9, 23, 920));\n    emit_observation_metric(code, \"oom_request_bytes\", 2816);\n    emit_observation_metric(code, \"pressure_transitions\", 2808);\n    emit_observation_metric(code, \"heap_goal\", memory_Goal);\n    emit_observation_metric(code, \"heap_limit\", memory_Limit);\n    emit_observation_metric(code, \"heap_committed\", memory_Committed);\n    emit_observation_metric(code, \"heap_reserved\", memory_Reserved);\n    emit_observation_metric(code, \"pressure_level\", memory_Level);\n    emit_observation_metric(code, \"pressure_reason\", memory_Reason);\n    emit_observation_metric(code, \"pressure_sequence\", memory_Sequence);\n    emit_observation_metric(code, \"allocation_rate\", memory_Rate);\n    emit_observation_metric(code, \"system_pressure_available\", 2752);\n    emit_observation_metric(code, \"los_live_bytes\", los_Bytes);\n    emit_observation_metric(code, \"los_objects\", los_Count);\n    emit_observation_metric(code, \"los_reclaimed_bytes\", los_Reclaimed);\n    emit_observation_metric(code, \"heap_capacity\", 904);\n    emit_observation_metric(code, \"heap_cursor\", 920);\n    emit_observation_metric(code, \"heap_live_bytes\", 304);\n    emit_observation_metric(code, \"heap_peak_live_bytes\", 312);\n    emit_observation_metric(code, \"allocated_objects\", 288);\n    emit_observation_metric(code, \"allocated_bytes\", 296);\n    emit_observation_metric(code, \"gc_count\", 16);\n    emit_observation_metric(code, \"gc_before_bytes\", 872);\n    emit_observation_metric(code, \"gc_after_bytes\", 880);\n    emit_observation_metric(code, \"gc_total_reclaimed_bytes\", 888);\n    emit_observation_metric(code, \"gc_last_ticks\", 328);\n    emit_observation_metric(code, \"gc_total_ticks\", 336);\n    emit_observation_metric(code, \"gc_max_ticks\", 344);\n    emit_observation_metric(code, \"timer_frequency_hz\", 352);\n    emit_observation_metric(code, \"runtime_ticks\", 912);\n    kaku i = 0;\n    aida (i < 64) {\n        emit_observation_metric(code, string.concat(\"gc_pause_bucket_\", convert.format_int(i)), 360 + i * 8);\n        i = i + 1;\n    }\n    emit_observation_metric(code, \"minor_gc_max_ticks\", gen_MinorMax);\n    emit_observation_metric(code, \"major_gc_max_ticks\", gen_MajorMax);\n    emit_observation_metric(code, \"minor_gc_count\", gen_MinorCount);\n    emit_observation_metric(code, \"major_gc_count\", gen_MajorCount);\n    emit_observation_metric(code, \"minor_gc_total_ticks\", gen_MinorTicks);\n    emit_observation_metric(code, \"major_gc_total_ticks\", gen_MajorTicks);\n    emit_observation_metric(code, \"young_live_bytes\", gen_YoungBytes);\n    emit_observation_metric(code, \"old_live_bytes\", gen_OldBytes);\n    emit_observation_metric(code, \"promoted_objects\", gen_PromotedObjects);\n    emit_observation_metric(code, \"promoted_bytes\", gen_PromotedBytes);\n    emit_observation_metric(code, \"promotion_threshold\", gen_Threshold);\n    emit_observation_metric(code, \"remembered_set_entries\", gen_RememberedCount);\n    emit_observation_metric(code, \"minor_scanned_old_objects\", gen_ScannedOld);\n    i = 0;\n    aida (i < 64) {\n        emit_observation_metric(code, string.concat(\"minor_gc_pause_bucket_\", convert.format_int(i)), 1536 + i * 8);\n        emit_observation_metric(code, string.concat(\"major_gc_pause_bucket_\", convert.format_int(i)), 2048 + i * 8);\n        i = i + 1;\n    }\n    arm64.assembler_label(code, \"observation_dump_done\");\n    emit(code, arm64.ldp_post_x(29, 30, 31, 16));\n    emit(code, arm64.ret());\n\n    arm64.assembler_label(code, \"observation_print_uint\");\n    emit(code, arm64.sub_imm_x(31, 31, 32, iie));\n    emit(code, arm64.add_imm_x(1, 31, 31, iie));\n    emit(code, arm64.movz_w(4, 10));\n    emit(code, arm64.strb_w(4, 1, 0));\n    emit(code, arm64.movz_x(2, 1, 0));\n    emit(code, arm64.movz_x(6, 10, 0));\n    arm64.assembler_label(code, \"observation_print_digit\");\n    emit(code, arm64.udiv_x(3, 0, 6));\n    emit(code, arm64.msub_x(4, 3, 6, 0));\n    emit(code, arm64.add_imm_w(4, 4, 48));\n    emit(code, arm64.sub_imm_x(1, 1, 1, iie));\n    emit(code, arm64.strb_w(4, 1, 0));\n    emit(code, arm64.add_imm_x(2, 2, 1, iie));\n    move_x(code, 0, 3);\n    arm64.assembler_cbnz_x(code, 0, \"observation_print_digit\");\n    emit(code, arm64.movz_x(0, 2, 0));\n    emit(code, arm64.movz_x(16, 4, 0));\n    emit(code, arm64.svc(128));\n    emit(code, arm64.add_imm_x(31, 31, 32, iie));\n    emit(code, arm64.ret());\n}\n" }; }
waza data_25() -> File { kaesu File { path: "kiso/aot/lower/old_pause.mio", version: "Bunko-v2.1.1", length: 2578, sha256: "d8c06bfc08cb60d448f82d4076d73523064eccea29d2f8c962b96b57f69d30d6", source: "// Experimental adapter, under native validation. Control belongs to the\n// stopped Mutator epoch. Wrapper return values never forge a successful pause.\nwaza emit_old_pause_adapter(c: arm64.Assembler, p: []macho.AddressPatch, first: int64) -> unit {\n    attached_save(c, \"old_stress_minor\");\n    old_control(c, p, first, 0);\n    wr_num(c, 9, 0);\n    arm64.assembler_cbz_x(c, 0, \"old_stress_minor_result\");\n    wr_imports(c, p, first);\n    arm64.assembler_bl(c, \"attached_gc_old_stress_minor\");\n    move_x(c, 9, 0);\n    arm64.assembler_label(c, \"old_stress_minor_result\");\n    emit(c, arm64.str_x(9, 31, 88));\n    attached_restore(c);\n\n    kaku labels = [\"old_pause_heap\", \"old_resume_heap\", \"old_note_minor\", \"old_pause_epoch\"];\n    kaku functions = [\"gc_old_pause\", \"gc_old_resume\", \"gc_old_note_minor\", \"gc_old_pause_epoch\"];\n    kaku i = 0;\n    aida (i<4) {\n        attached_save(c, labels[i]);\n        old_control(c, p, first, 0);\n        kaku done = string.concat(labels[i], \"_done\");\n        arm64.assembler_cbz_x(c, 0, done);\n        wr_imports(c, p, first);\n        wr_call(c, functions[i]);\n        arm64.assembler_label(c, done);\n        attached_restore(c);\n        i = i + 1;\n    }\n    attached_save(c, \"old_promoted_publish\");\n    move_x(c, 1, 14);\n    old_control(c, p, first, 0);\n    arm64.assembler_cbz_x(c, 0, \"old_promoted_no_state\");\n    wr_imports(c, p, first);\n    wr_call(c, \"gc_old_promoted\");\n    arm64.assembler_label(c, \"old_promoted_no_state\");\n    attached_restore(c);\n    attached_save(c, \"old_major_active\");\n    old_control(c, p, first, 0);\n    wr_num(c, 9, 0);\n    arm64.assembler_cbz_x(c, 0, \"old_major_active_result\");\n    emit(c, arm64.add_imm_x(9, 0, 144, iie));\n    emit(c, arm64.ldar_x(9, 9));\n    emit(c, arm64.cmp_imm_x(9, 2, iie));\n    emit(c, arm64.cset_w(9, 0));\n    moshi (old_sweep_enabled(c)) {\n        arm64.assembler_cbnz_x(c, 9, \"old_major_active_result\");\n        emit(c, arm64.add_imm_x(9, 0, 712, iie));\n        emit(c, arm64.ldar_x(9, 9));\n        emit(c, arm64.cmp_imm_x(9, 2, iie));\n        emit(c, arm64.cset_w(9, 0));\n    }\n    arm64.assembler_label(c, \"old_major_active_result\");\n    emit(c, arm64.str_x(9, 31, 88));\n    attached_restore(c);\n}\nwaza emit_old_promoted_publish(c: arm64.Assembler, payload: int64) -> unit {\n    moshi (!old_mark_proto_enabled(c)) { kaesu; }\n    emit(c, arm64.sub_imm_x(31, 31, 16, iie));\n    emit(c, arm64.str_x(14, 31, 0));\n    move_x(c, 14, payload);\n    arm64.assembler_bl(c, \"old_promoted_publish\");\n    emit(c, arm64.ldr_x(14, 31, 0));\n    emit(c, arm64.add_imm_x(31, 31, 16, iie));\n}\n" }; }
waza data_26() -> File { kaesu File { path: "kiso/aot/lower/old_roots.mio", version: "Bunko-v2.1.1", length: 12885, sha256: "127a6f14240eff4d0324df92af1cc4cdce34606551056ad0e83a1d810e9f78e8", source: "// Experimental Darwin/AArch64 adapter. Core Old algorithms remain neutral IR.\n// Native control VM mapping is separately owned, outside user globals/heap ABI.\nteisu old_mapping_bytes = 262656;\nteisu old_queue_capacity = 32768;\nwaza old_mark_proto_enabled(c: arm64.Assembler) -> bool { kaesu arm64.assembler_label_word(c, \"old_mark_proto_enabled\") >= 0; }\nwaza old_control(c: arm64.Assembler, p: []macho.AddressPatch, first: int64, r: int64) -> unit {\n    wr_ctx(c, p, first, r, 0);\n    emit(c, arm64.ldr_x(r, r, 8696));\n}\nwaza old_result(c: arm64.Assembler, r: int64) -> unit {\n    emit(c, arm64.str_x(r, 31, 208));\n    emit(c, arm64.add_imm_x(31, 31, 64, iie));\n    attached_restore(c);\n}\nwaza emit_old_mark_adapter(c: arm64.Assembler, p: []macho.AddressPatch, first: int64, queue_slots: int64) -> unit {\n    emit_old_satb_adapter(c, p, first);\n    emit_old_pause_adapter(c, p, first);\n    // Fatal paths retain mappings until process teardown. Attempt the actual\n    // marker Abort/join without recursively raising another runtime_error when\n    // a clock/OS failure prevents cleanup. Every reported join count is real.\n    attached_save(c, \"old_fatal_cleanup\");\n    old_control(c, p, first, 0);\n    arm64.assembler_cbz_x(c, 0, \"old_fatal_no_state\");\n    // Raw TLS lookup avoids recursive runtime_error. The neutral helper only\n    // joins/discards when THIS caller owns a fully stopped epoch. Otherwise\n    // cancel only and retain every mapping until immediate terminal OS exit.\n    wr_ctx(c, p, first, 0, 0);\n    emit(c, arm64.ldr_x(0, 0, gc.thread_key));\n    wr_imports(c, p, first);\n    aarch64.emit_import_call(c, 7, 5, worker_import_slots(c));\n    move_x(c, 1, 0);\n    old_control(c, p, first, 0);\n    wr_imports(c, p, first);\n    arm64.assembler_bl(c, \"attached_gc_old_fatal\");\n    emit(c, arm64.sub_imm_x(31, 31, 80, iie));\n    emit(c, arm64.str_x(0, 31, 64));\n    old_control(c, p, first, 14);\n    wr_num(c, 9, 1330401613);\n    emit(c, arm64.str_x(9, 31, 0));\n    wr_num(c, 9, 1);\n    emit(c, arm64.str_x(9, 31, 8));\n    kaku fatal_offsets = [144, 192, 304, 312, 184, 280];\n    kaku fatal_i = 0;\n    aida (fatal_i<len(fatal_offsets)) {\n        emit(c, arm64.ldr_x(9, 14, fatal_offsets[fatal_i]));\n        emit(c, arm64.str_x(9, 31, (fatal_i + 2) * 8));\n        fatal_i = fatal_i + 1;\n    }\n    wr_num(c, 0, 2);\n    emit(c, arm64.add_imm_x(1, 31, 0, iie));\n    wr_num(c, 2, 72);\n    wr_num(c, 16, 4);\n    emit(c, arm64.svc(128));\n    emit(c, arm64.add_imm_x(31, 31, 80, iie));\n    moshi (old_sweep_enabled(c)) {\n        arm64.assembler_bl(c, \"sweep_control_report\");\n    }\n    arm64.assembler_label(c, \"old_fatal_no_state\");\n    attached_restore(c);\n\n    moshi (old_sweep_enabled(c)) {\n        // A Major/reentry request cancels promptly, BEFORE waiting for STW.\n        // This only publishes cancellation. Join/claim cleanup still requires\n        // the subsequent stopped heap owner; no foreign ownership is stolen.\n        attached_save(c, \"old_cancel_requested\");\n        old_control(c, p, first, 0);\n        arm64.assembler_cbz_x(c, 0, \"old_cancel_request_empty\");\n        wr_imports(c, p, first);\n        wr_call(c, \"gc_old_cancel\");\n        arm64.assembler_label(c, \"old_cancel_request_empty\");\n        attached_restore(c);\n    }\n    attached_save(c, \"old_abort_before_mutation\");\n    old_control(c, p, first, 0);\n    arm64.assembler_cbz_x(c, 0, \"old_abort_no_state\");\n    emit(c, arm64.ldr_x(9, 0, 144));\n    emit(c, arm64.cmp_imm_x(9, 2, iie));\n    arm64.assembler_b_cond(c, 0, \"old_record_abort\");\n    emit(c, arm64.cmp_imm_x(9, 3, iie));\n    arm64.assembler_b_cond(c, 1, \"old_abort_call\");\n    arm64.assembler_label(c, \"old_record_abort\");\n    emit(c, arm64.