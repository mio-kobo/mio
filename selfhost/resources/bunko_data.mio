e,arm64.movn_x(4,0,0)); emit(code,arm64.movz_x(5,0,0)); emit(code,arm64.movz_x(16,197,0)); emit(code,arm64.svc(128));\n arm64.assembler_b_cond(code,2,\"los_alloc_fail\");\n emit(code,arm64.ldr_x(9,23,los_Head)); emit(code,arm64.str_x(9,0,0)); emit(code,arm64.str_x(0,23,los_Head)); emit(code,arm64.ldr_x(9,31,0)); emit(code,arm64.str_x(9,0,8)); emit(code,arm64.ldr_x(10,23,memory_LOSCommitted)); emit(code,arm64.add_x(10,10,9)); emit(code,arm64.str_x(10,23,memory_LOSCommitted)); emit(code,arm64.str_x(20,0,32)); emit(code,arm64.str_x(19,0,40));\n emit(code,arm64.ldr_x(9,23,los_Bytes)); emit(code,arm64.add_x(9,9,22)); emit(code,arm64.str_x(9,23,los_Bytes));\n emit(code,arm64.ldr_x(9,23,los_Count)); emit(code,arm64.add_imm_x(9,9,1,iie)); emit(code,arm64.str_x(9,23,los_Count));\n emit(code,arm64.add_imm_x(0,0,48,iie)); arm64.assembler_b(code,\"los_alloc_return\");\n arm64.assembler_label(code,\"los_alloc_fail\"); emit(code,arm64.movz_x(0,0,0));\n arm64.assembler_label(code,\"los_alloc_return\"); emit(code,arm64.add_imm_x(31,31,16,iie)); emit(code,arm64.ret());\n\n // Dead nodes are unlinked before synchronous munmap; failed releases retain\n // ownership. Called only after generational links have been reconstructed.\n arm64.assembler_label(code,\"los_prune\");\n emit(code,arm64.stp_pre_x(19,20,31,-16)); emit(code,arm64.stp_pre_x(21,22,31,-16));\n emit(code,arm64.add_imm_x(19,23,los_Head,iie)); emit(code,arm64.movz_x(22,0,0));\n arm64.assembler_label(code,\"los_prune_loop\"); emit(code,arm64.ldr_x(20,19,0)); arm64.assembler_cbz_x(code,20,\"los_prune_done\");\n emit(code,arm64.ldr_x(9,20,32)); arm64.assembler_cbz_x(code,9,\"los_prune_dead\"); move_x(code,19,20); arm64.assembler_b(code,\"los_prune_loop\");\n arm64.assembler_label(code,\"los_prune_dead\"); emit(code,arm64.cmp_imm_x(22,8,iie)); arm64.assembler_b_cond(code,2,\"los_prune_done\"); emit(code,arm64.add_imm_x(22,22,1,iie)); emit(code,arm64.ldr_x(9,20,0)); emit(code,arm64.str_x(9,19,0)); emit(code,arm64.ldr_x(1,20,8)); move_x(code,21,1); move_x(code,0,20); emit(code,arm64.movz_x(16,73,0)); emit(code,arm64.svc(128)); arm64.assembler_b_cond(code,2,\"los_prune_failed\"); emit(code,arm64.ldr_x(9,23,memory_LOSCommitted)); emit(code,arm64.sub_x(9,9,21)); emit(code,arm64.str_x(9,23,memory_LOSCommitted)); arm64.assembler_b(code,\"los_prune_loop\");\n arm64.assembler_label(code,\"los_prune_failed\");\n emit(code,arm64.ldr_x(9,19,0)); emit(code,arm64.str_x(9,20,0)); emit(code,arm64.str_x(20,19,0)); move_x(code,19,20); arm64.assembler_b(code,\"los_prune_loop\");\n arm64.assembler_label(code,\"los_prune_done\"); emit(code,arm64.ldp_post_x(21,22,31,16)); emit(code,arm64.ldp_post_x(19,20,31,16)); emit(code,arm64.ret());\n\n // Major sweep; returns live physical bytes in x0 for occupied accounting.\n arm64.assembler_label(code,\"los_major\");\n emit(code,arm64.movz_x(0,0,0)); emit(code,arm64.ldr_x(12,23,los_Head));\n arm64.assembler_label(code,\"los_major_loop\"); arm64.assembler_cbz_x(code,12,\"los_major_done\");\n emit(code,arm64.ldr_x(9,12,32)); arm64.assembler_cbz_x(code,9,\"los_major_next\");\n emit(code,arm64.ldr_x(9,12,32)); move_bits(code,10,uint32(1),uint32(0)); emit(code,arm64.and_x(10,9,10));\n arm64.assembler_cbz_x(code,10,\"los_major_dead\");\n move_bits(code,10,uint32(4294967292),uint32(4294967295)); emit(code,arm64.and_x(9,9,10)); emit(code,arm64.str_x(9,12,32));\n emit(code,arm64.ldr_x(9,12,40)); emit(code,arm64.add_imm_x(9,9,31,iie)); emit(code,arm64.movn_x(10,15,0)); emit(code,arm64.and_x(9,9,10)); emit(code,arm64.add_x(0,0,9)); arm64.assembler_b(code,\"los_major_next\");\n arm64.assembler_label(code,\"los_major_dead\"); emit(code,arm64.str_x(31,12,32));\n emit(code,arm64.ldr_x(9,12,40)); emit(code,arm64.add_imm_x(9,9,31,iie)); emit(code,arm64.movn_x(10,15,0)); emit(code,arm64.and_x(9,9,10));\n emit(code,arm64.ldr_x(10,23,los_Bytes)); emit(code,arm64.sub_x(10,10,9)); emit(code,arm64.str_x(10,23,los_Bytes));\n emit(code,arm64.ldr_x(10,23,los_Reclaimed)); emit(code,arm64.add_x(1