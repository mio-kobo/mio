64.ldrh_w(9, 10, 16)); lx(c, arm64.add_x(10, 10, 9)); lx_b(c, \"lx_dirents_next\");\n    lx_label(c, \"lx_dirents_done\");\n    lx(c, arm64.sub_x(0, 12, 13)); lx(c, arm64.add_imm_x(31, 31, 2048, iie)); lx_b(c, \"lx_norm\");\n    lx_label(c, \"lx_dirents_end\"); lx(c, arm64.add_imm_x(31, 31, 2048, iie)); lx_li(c, 0, 0); lx_b(c, \"lx_norm\");\n    lx_label(c, \"lx_dirents_fail\"); lx(c, arm64.add_imm_x(31, 31, 2048, iie)); lx_b(c, \"lx_norm\");\n\n    // ---- path calls with the directory descriptor AT_FDCWD\n    lx_label(c, \"lx_mkdir\"); lx_mov(c, 2, 1); lx_mov(c, 1, 0); lx_li(c, 0, -100); lx_li(c, 8, 34); lx_b(c, \"lx_svc\");\n    lx_label(c, \"lx_chmod\"); lx_mov(c, 2, 1); lx_mov(c, 1, 0); lx_li(c, 0, -100); lx_li(c, 8, 53); lx_b(c, \"lx_svc\");\n    lx_label(c, \"lx_unlink\"); lx_mov(c, 1, 0); lx_li(c, 0, -100); lx_li(c, 2, 0); lx_li(c, 8, 35); lx_b(c, \"lx_svc\");\n    lx_label(c, \"lx_rmdir\"); lx_mov(c, 1, 0); lx_li(c, 0, -100); lx_li(c, 2, 512); lx_li(c, 8, 35); lx_b(c, \"lx_svc\");\n\n    // ---- fork() -> clone(SIGCHLD): Darwin returns x1 = 0 in the parent and 1 in the child\n    lx_label(c, \"lx_fork\");\n    lx_li(c, 0, 17); lx_li(c, 1, 0); lx_li(c, 2, 0); lx_li(c, 3, 0); lx_li(c, 4, 0); lx_li(c, 8, 220); lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie)); lx_bcc(c, 11, \"lx_norm\");\n    lx_li(c, 9, 0); lx_cbnz(c, 0, \"lx_fork_store\"); lx_li(c, 9, 1);\n    lx_label(c, \"lx_fork_store\");\n    lx(c, arm64.str_x(9, 31, 128)); lx_b(c, \"lx_norm\");\n\n    // ---- dup2(old, new): dup3 rejects old == new, dup2 returns new\n    lx_label(c, \"lx_dup2\");\n    lx(c, arm64.cmp_x(0, 1)); lx_bcc(c, 1, \"lx_dup2_go\"); lx_mov(c, 0, 1); lx_b(c, \"lx_norm\");\n    lx_label(c, \"lx_dup2_go\"); lx_li(c, 2, 0); lx_li(c, 8, 24); lx_b(c, \"lx_svc\");\n\n    // ---- fcntl: F_GETPATH (50) reads /proc/self/fd/<fd>; F_DUPFD_CLOEXEC 67 -> 1030; the rest keep their values\n    lx_label(c, \"lx_fcntl\");\n    lx(c, arm64.cmp_imm_x(1, 50, iie)); lx_bcc(c, 0, \"lx_getpath