begin(c,p,first);}wr_current(c,p,first);wr_increment(c,0,488);\n        moshi(i==1){wr_increment(c,0,480);move_x(c,1,24);wr_call(c,\"gc_mutator_poll\");wr_obs_end(c,p,first,1);}\n        moshi(i==2){move_x(c,1,24);wr_call(c,\"gc_heap_enter\");wr_obs_end(c,p,first,0);}\n        attached_restore(c);i=i+1;\n    }\n    // Bounded epoch retention (docs/darwin-thread-heap-exclusion-design.md, section 8): the poll in front of an opcode that the compiler has proven\n    // to continue a straight-line run of this thread's own epoch. The thread that owns the epoch is the only one that can clear the owner word, so\n    // when the owner is this thread nothing is released and only the shadow-root head is republished (release store, as gc_mutator_poll does);\n    // when the epoch is not owned any more (a blocking native in the previous opcode ended it) this is exactly gc_mutator_poll.\n    attached_save(c,\"attached_roots_retain\");wr_current(c,p,first);wr_increment(c,0,488);\n    emit(c,arm64.ldr_x(9,0,gc.thread_registry));emit(c,arm64.add_imm_x(9,9,gc.gc_registry_owner,iie));emit(c,arm64.ldar_x(10,9));emit(c,arm64.cmp_x(10,0));arm64.assembler_b_cond(c,1,\"attached_retain_not_owner\");\n    emit(c,arm64.add_imm_x(9,0,gc.thread_shadow,iie));emit(c,arm64.stlr_x(24,9));\n    moshi(wr_observed(c)){wr_num(c,11,wr_obs+wr_obs_retained);emit(c,arm64.add_x(11,0,11));emit(c,arm64.ldr_x(12,11,0));emit(c,arm64.add_imm_x(12,12,1,iie));emit(c,arm64.str_x(12,11,0));}\n    arm64.assembler_b(c,\"attached_retain_done\");\n    arm64.assembler_label(c,\"attached_retain_not_owner\");moshi(wr_observed(c)){wr_obs_begin(c,p,first);wr_current(c,p,first);}wr_increment(c,0,480);move_x(c,1,24);wr_call(c,\"gc_mutator_poll\");wr_obs_end(c,p,first,1);\n    arm64.assembler_label(c,\"attached_retain_done\");attached_restore(c);\n    moshi(wr_observed(c)){emit_worker_observation_dump(c,p,first);}\n    // The legacy allocator may collect, so it sees a coordinator-owned complete\n    // snapshot. Keep the epoch stopped until the next solved opcode poll.\n    attached_save(c,\"runtime_alloc\");\n    // Lock fast path. Correct because an Epoch owner starts only after every other non-blocked thread has acknowledged at a poll, and nothing between\n    // the lock and its release polls, blocks or collects. A holder may itself own a stopped Epoch.\n    // When it does, the other mutators cannot acquire the lock or enter the heap.\n    // On contention, publish the same shadow roots as the Epoch path, then\n    // wait as a blocked native mutator. Reenter through the existing GC\n    // handshake before attempting to own the allocation lock again.\n    moshi(alloc_lock_enabled(c)){\n        emit(c,arm64.cmp_imm_x(0,wr_alloc_small,iie));\n        arm64.assembler_b_cond(c,8,\"runtime_alloc_slow\");\n        emit(c,arm64.str_x(31,31,8)); // wait rounds already attempted (saved frame padding)\n        moshi(wr_wait_park_test(c)){\n            wr_current(c,p,first);\n            wr_addr(c,9,0,wr_wait_test_arm);\n            emit(c,arm64.ldr_x(10,9,0));arm64.assembler_cbz_x(c,10,\"runtime_alloc_test_unarmed\");\n            emit(c,arm64.str_x(31,9,0));\n            wr_main_word(c,p,first,9,wr_wait_test_ctx);emit(c,arm64.stlr_x(0,9));\n            arm64.assembler_b(c,\"runtime_alloc_wait_entry\");\n            arm64.assembler_label(c,\"runtime_alloc_test_unarmed\");\n            emit(c,arm64.ldr_x(0,31,144));emit(c,arm64.ldr_x(1,31,152));\n        }\n        moshi(wr_wait_test(c) && !wr_wait_park_test(c)){\n            // Force one visit to the cold path per allocation. The guard\n            // sees the real owner, even if the lock never looked busy.\n            arm64.assembler_b(c,\"runtime_alloc_wait_entry\");\n        }\n        arm64.assembler_label(c,\"runtime_alloc_retry_lock\");\n        wr_ctx(c,p,first,9,0);wr_num(c,10,wr_alloc_lock);emit(c,arm64.add_x(9,9,10));\n        wr_num(c,11,wr_alloc_spin);emit(c,arm64.movz_x(13,wr_alloc_locked,0));\n        arm64.assembler_label(c,\"