eax_imm(code, 59);\n    x86_64.syscall(code);\n    x86_64.mov_ri(code, x86_64.rdi, 127);\n    x86_64.mov_eax_imm(code, 231);\n    x86_64.syscall(code);\n    x86_64.label(code, \"rt.os_spawn_test.setup_failed\");\n    x86_64.mov_ri(code, x86_64.rdi, 126);\n    x86_64.mov_eax_imm(code, 231);\n    x86_64.syscall(code);\n}\n\n// Unsupported process helpers fail loudly at run time instead of being skipped.\nwaza emit_os_unsupported(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.os_unsupported\");\n    emit_write_literal(code, \"rt.text.os_unsupported\", 40, 2);\n    emit_exit(code, 1);\n    data_string(code, \"rt.text.os_unsupported\", \"runtime error: unsupported OS operation\\n\");\n}\n\nwaza os_routine(operation: string) -> string {\n    moshi (operation == \"argc\") { kaesu \"rt.os_argc\"; }\n    moshi (operation == \"arg_size\") { kaesu \"rt.os_arg_size\"; }\n    moshi (operation == \"arg_copy\") { kaesu \"rt.os_arg_copy\"; }\n    moshi (operation == \"exit\") { kaesu \"rt.os_exit\"; }\n    moshi (operation == \"chmod\") { kaesu \"rt.os_chmod\"; }\n    moshi (operation == \"remove\") { kaesu \"rt.os_remove\"; }\n    moshi (operation == \"rmdir\") { kaesu \"rt.os_rmdir\"; }\n    moshi (operation == \"pid\") { kaesu \"rt.os_pid\"; }\n    moshi (operation == \"real_path\") { kaesu \"rt.os_real_path\"; }\n    moshi (operation == \"env_size\") { kaesu \"rt.os_env_size\"; }\n    moshi (operation == \"env_copy\") { kaesu \"rt.os_env_copy\"; }\n    moshi (operation == \"monotonic_ms\") { kaesu \"rt.os_monotonic_ms\"; }\n    moshi (operation == \"stdin_ready\") { kaesu \"rt.os_stdin_ready\"; }\n    moshi (operation == \"stdin_wait\") { kaesu \"rt.os_stdin_wait\"; }\n    moshi (operation == \"spawn\") { kaesu \"rt.os_spawn\"; }\n    moshi (operation == \"exec\") { kaesu \"rt.os_exec\"; }\n    moshi (operation == \"spawn_test\") { kaesu \"rt.os_spawn_test\"; }\n    kaesu \"\";\n}\n" }; }
waza data_35() -> File { kaesu File { path: "kiso/aot/lowerlinux/runtime_socket.mio", version: "Bunko-v2.1.1", length: 21830, sha256: "775aba9909bda9fecfcc36d006536f96c57551a23d487e376589049a51ab91e2", source: "yobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// Linux IPv4 stream sockets for the body-less \"mio/sys/socket\" functions (kiso/net/tcp). Sockets share the NativeFS\n// generation-checked handle table. Status codes: 0 ok, 1 invalid argument, 2 closed, 3 timed out, 4 connection refused,\n// 5 connection reset, 6 address in use, 7 permission denied, 8 would block, 9 other.\nwaza socket_message_text(code: int64) -> string {\n    moshi (code == 1) { kaesu \"invalid argument\"; }\n    moshi (code == 2) { kaesu \"socket closed\"; }\n    moshi (code == 3) { kaesu \"connection timed out\"; }\n    moshi (code == 4) { kaesu \"connection refused\"; }\n    moshi (code == 5) { kaesu \"connection reset\"; }\n    moshi (code == 6) { kaesu \"address already in use\"; }\n    moshi (code == 7) { kaesu \"permission denied\"; }\n    moshi (code == 8) { kaesu \"operation would block\"; }\n    kaesu \"socket error\";\n}\nwaza socket_message_label(code: int64) -> string { kaesu string.concat(\"rt.sock.message.\", convert.format_int(code)); }\n\nwaza emit_socket_runtime(code: x86_64.Assembler) -> unit {\n    kaku code_number = 0;\n    aida (code_number < 10) {\n        kaku text = \"\";\n        moshi (code_number != 0) { text = socket_message_text(code_number); }\n        emit_string_object(code, socket_message_label(code_number), text);\n        code_number = code_number + 1;\n    }\n    // rt.sock_classify: rax = positive errno -> rax = socket status code\n    x86_64.label(code, \"rt.sock_classify\");\n    kaku errnos: []int64 = [22, 97, 9, 88, 110, 111, 104, 32, 98, 13, 1, 11];\n    kaku codes: []int64 = [1, 1, 2, 2, 3, 4, 5, 5, 6, 7, 7, 8];\n    kaku at = 0;\n    aida (at < len(errnos)) {\n        kaku next = string.concat(\"rt.sock_classify.next.\", convert.format_int(at));\n        x86_64.cmp_ri(code, x86_64.rax, errnos[at]);\n        x86_64.jcc(code, x86_64.cc_ne, next);\n        x86_64.mov_ri(code, x86_64.rax, codes[at]);\n        x86_64.ret(code);\n        x86_64.label(code, next);\n        at = at + 1;\n    }\n    x86_64.mov_ri(code, x86_64.rax, 9);\n    x86_64.ret(code);\n\n    // rt.sock_message: rax = code -> rax = message string\n    x86_64.label(code, \"rt.sock_message\");\n    at = 0;\n    aida (at < 9) {\n        kaku next = string.concat(\"rt.sock_message.next.\", convert.format_int(at));\n        x86_64.cmp_ri(code, x86_64.rax, at);\n        x86_64.jcc(code, x86_64.cc_ne, next);\n        x86_64.lea_label(code, x86_64.rax, socket_message_label(at));\n        x86_64.ret(code);\n        x86_64.label(code, next);\n        at = at + 1;\n    }\n    x86_64.lea_label(code, x86_64.rax, socket_message_label(9));\n    x86_64.ret(code);\n\n    // rt.sock_status_one: rdi = status array (>= 1 byte), rsi = code -> rax = message\n    x86_64.label(code, \"rt.sock_status_one\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 40);\n    x86_64.mov_store8(code, x86_64.rax, 0, x86_64.rsi);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.jmp(code, \"rt.sock_message\");\n\n    // rt.sock_status_io: rdi = status array (10 bytes), rsi = count, rdx = eof, rcx = code -> rax = message\n    x86_64.label(code, \"rt.sock_status_io\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 40);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rsi);\n    x86_64.mov_store8(code, x86_64.rax, 8, x86_64.rdx);\n    x86_64.mov_store8(code, x86_64.rax, 9, x86_64.rcx);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.jmp(code, \"rt.sock_message\");\n\n    // rt.sock_fd: rdi = token 