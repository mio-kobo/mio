waza data_59() -> File { kaesu File { path: "kiso/aot/macho/dylib.mio", version: "Bunko-v2.1.1", length: 12142, sha256: "b5843a2d9a3da522fc642c3d3917a0035abe6c8978465ba2cfce09156494cc65", source: "yobu \"kiso/array\";\nyobu \"kiso/encoding/binary\";\nyobu \"kiso/string\";\n\n// Names are Mach-O names (including the leading underscore). Words are\n// offsets into __text, relative to the first emitted ARM64 instruction.\nkoukai kata DylibExport { name: string; word: int64; }\nkoukai kata DylibSpec {\n    image: ImageSpec;\n    install_name: string;\n    exports: []DylibExport;\n}\n\nkata ExportEdge { byte: uint8; child: int64; }\nkata ExportNode { address: []uint8; edges: []ExportEdge; }\n\nwaza dylib_failure(layout: Layout, error: MachOError?) -> ImageResult {\n    kaesu ImageResult { bytes: [], layout: layout, error: error };\n}\n\nwaza uleb_width(value: int64) -> int64 {\n    kaku width = 1;\n    kaku left = value;\n    aida (left >= 128) { left = left / 128; width = width + 1; }\n    kaesu width;\n}\n\nwaza append_uleb(bytes: []uint8, value: int64) -> unit {\n    kaku left = value;\n    aida (left >= 128) {\n        array.push(bytes, uint8(128 + (left - (left / 128) * 128)));\n        left = left / 128;\n    }\n    array.push(bytes, uint8(left));\n}\n\nwaza ascii_name(bytes: []uint8) -> bool {\n    kaku index = 0;\n    aida (index < len(bytes)) {\n        moshi (bytes[index] < uint8(33) || bytes[index] > uint8(126)) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nwaza export_nodes(exports: []DylibExport, word_count: int64) -> []ExportNode {\n    kaku nodes: []ExportNode = [ExportNode { address: [], edges: [] }];\n    kaku index = 0;\n    aida (index < len(exports)) {\n        kaku entry = exports[index];\n        kaku name = string.to_bytes(entry.name);\n        moshi (len(name) < 2 || len(name) > 127 || name[0] != uint8(95) ||\n            !ascii_name(name) || entry.word < 0 || entry.word >= word_count) { kaesu []; }\n        kaku current = 0;\n        kaku at = 0;\n        aida (at < len(name)) {\n            kaku edges = nodes[current].edges;\n            kaku child = -1;\n            kaku ei = 0;\n            aida (ei < len(edges)) {\n                moshi (edges[ei].byte == name[at]) { child = edges[ei].child; nukeru; }\n                ei = ei + 1;\n            }\n            moshi (child < 0) {\n                child = len(nodes);\n                array.push(edges, ExportEdge { byte: name[at], child: child });\n                array.push(nodes, ExportNode { address: [], edges: [] });\n            }\n            current = child;\n            at = at + 1;\n        }\n        moshi (len(nodes[current].address) != 0) { kaesu []; }\n        // A regular export has flags zero and a ULEB128 image-relative address.\n        append_uleb(nodes[current].address, entry_offset + entry.word * 4);\n        index = index + 1;\n    }\n    kaesu nodes;\n}\n\nwaza export_trie(nodes: []ExportNode) -> []uint8 {\n    kaku offsets = array.with_capacity[int64](len(nodes));\n    kaku index = 0;\n    aida (index < len(nodes)) { array.push(offsets, 0); index = index + 1; }\n    // Child offsets are ULEB128. Starting at zero grows their widths\n    // monotonically until every node offset agrees with the encoded layout.\n    kaku changed = hai;\n    aida (changed) {\n        changed = iie;\n        kaku offset = 0;\n        kaku index = 0;\n        aida (index < len(nodes)) {\n            moshi (offsets[index] != offset) { changed = hai; offsets[index] = offset; }\n            kaku node = nodes[index];\n            offset = offset + 2;\n            moshi (len(node.address) != 0) { offset = offset + 1 + len(node.address); }\n            kaku ei = 0;\n            aida (ei < len(node.edges)) {\n                offset = offset + 2 + uleb_width(offsets[node.edges[ei].child]);\n                ei = ei + 1;\n            }\n            index = index + 1;\n        }\n    }\n    kaku bytes: []uint8 = [];\n    index = 0;\n    aida (index < len(nodes)) {\n        kaku node = nodes[index];\n        moshi (len(node.address) == 0) { array.push(bytes, uint8(0)); }\n        sore {\n            array.push(bytes, uint8(1 + len(node.address)));\n            array.push(bytes, uint8(0));\n            array.append_all(bytes, node.address);\n        }\n        array.push(bytes, uint8(len(node.edges)));\n        kaku ei = 0;\n        aida (ei < len(node.edges)) {\n            kaku edge = node.edges[ei];\n            array.push(bytes, edge.byte);\n            array.push(bytes, uint8(0));\n            append_uleb(bytes, offsets[edge.child]);\n            ei = ei + 1;\n        }\n        index = index + 1;\n    }\n    kaesu bytes;\n}\n\nwaza dylib_words(output: binary.BinaryWriter, values: []int64) -> MachOError? {\n    kaku index = 0;\n    aida (index < len(values)) {\n        kaku failure = put32(output, values[index]);\n        moshi (failure != mu) { kaesu failure; }\n        index = index + 1;\n    }\n    kaesu mu;\n}\n\nwaza dylib_name(output: binary.BinaryWriter, command: int64, name: []uint8) -> MachOError? {\n    kaku size = align(24 + len(name) + 1, 8);\n    kaku failure = dylib_words(output, [command, size, 24, 0, 65536, 65536]);\n    moshi (failure != mu) { kaesu failure; }\n    failure = put_bytes(output, name);\n    moshi (failure != mu) { kaesu failure; }\n    kaesu zeros(output, size - 24 - len(name));\n}\n\n// A dependency-free body may use ADRP/ADD image-relative patches. The only\n// dylib dependency is libSystem, required by dyld for a userland image.\nkoukai waza dylib(spec: DylibSpec) -> ImageResult {\n    kaku image = spec.image;\n    kaku empty = plan(0, 0, 0);\n    moshi (len(image.words) == 0) { kaesu dylib_failure(empty, MachOError.EmptyText()); }\n    moshi (image.globals < 0 || image.globals > 2052) { kaesu dylib_failure(empty, MachOError.TooManyGlobals()); }\n    moshi (len(image.words) > (maximum_image_size - entry_offset) / 4 || len(image.constants) > maximum_image_size) {\n        kaesu dylib_failure(empty, MachOError.ImageTooLarge());\n    }\n    kaku layout = plan(len(image.words) * 4, len(image.constants), image.globals);\n    kaku name = string.to_bytes(spec.install_name);\n    moshi (len(name) <= 7 || len(name) > 127 || !ascii_name(name) || !string.has_prefix(spec.install_name, \"@rpath/\") ||\n        len(spec.exports) == 0 || len(spec.exports) > 128) { kaesu dylib_failure(layout, MachOError.InvalidExport()); }\n    kaku nodes = export_nodes(spec.exports, len(image.words));\n    moshi (len(nodes) == 0) { kaesu dylib_failure(layout, MachOError.InvalidExport()); }\n    kaku trie = export_trie(nodes);\n    kaku symoff = align(layout.linkedit_offset + len(trie), 8);\n    kaku stroff = symoff + len(spec.exports) * 16;\n    kaku names = binary.writer(1 + len(spec.exports) * 128);\n    kaku symbols = binary.writer(len(spec.exports) * 16);\n    kaku failure = zeros(names, 1);\n    kaku index = 0;\n    aida (index < len(spec.exports)) {\n        moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n        kaku entry = spec.exports[index];\n        // n_strx, N_SECT|N_EXT, section 1, n_desc, n_value.\n        failure = dylib_words(symbols, [binary.writer_offset(names), 271, entry_offset + entry.word * 4, 0]);\n        moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n        failure = put_bytes(names, string.to_bytes(entry.name));\n        moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n        failure = zeros(names, 1);\n        index = index + 1;\n    }\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    kaku file_size = align(stroff + binary.writer_offset(names), 16);\n    moshi (file_size > maximum_image_size) { kaesu dylib_failure(layout, MachOError.ImageTooLarge()); }\n    layout = Layout { text_size: layout.text_size, const_offset: layout.const_offset, data_offset: layout.data_offset,\n        linkedit_offset: layout.linkedit_offset, file_size: file_size, sections: layout.sections };\n    kaku patched = patch_words(image, layout);\n    moshi (patched.error != mu) { kaesu patched; }\n\n    kaku text_sections = 1;\n    moshi (len(image.constants) > 0) { text_sections = 2; }\n    kaku text_command = 72 + 80 * text_sections;\n    kaku command_size = text_command + 72 + align(25 + len(name), 8) + 56 + 24 + 16 + 24 + 80;\n    kaku count = 8;\n    moshi (image.globals > 0) { command_size = command_size + 152; count = count + 1; }\n    moshi (32 + command_size + 16 > entry_offset) { kaesu dylib_failure(layout, MachOError.LoadCommandsTooLarge()); }\n    kaku output = binary.writer(file_size);\n    // MH_DYLIB with MH_NOUNDEFS and MH_TWOLEVEL. Dylibs are slideable by default.\n    failure = dylib_words(output, [4277009103, 16777228, 0, 6, count, command_size, 133, 0]);\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    kaku text_name: []uint8 = [95,95,84,69,88,84];\n    failure = segment(output, text_name, 0, 0, 0, layout.text_size, 0, layout.text_size, 5, 5, text_sections, text_command);\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = section(output, [95,95,116,101,120,116], text_name, 0, entry_offset, len(image.words) * 4, entry_offset, 2, 2147484672);\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    moshi (len(image.constants) > 0) {\n        failure = section(output, [95,95,99,111,110,115,116], text_name, 0, layout.const_offset, len(image.constants), layout.const_offset, 3, 0);\n        moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    }\n    moshi (image.globals > 0) {\n        kaku data_name: []uint8 = [95,95,68,65,84,65];\n        kaku data_size = layout.linkedit_offset - layout.data_offset;\n        failure = segment(output, data_name, 0, layout.data_offset, 0, data_size, layout.data_offset, data_size, 3, 3, 1, 152);\n        moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n        failure = section(output, [95,95,100,97,116,97], data_name, 0, layout.data_offset, image.globals * 8, layout.data_offset, 3, 0);\n        moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    }\n    kaku payload = file_size - layout.linkedit_offset;\n    failure = segment(output, [95,95,76,73,78,75,69,68,73,84], 0, layout.linkedit_offset, 0,\n        align(payload, page_size), layout.linkedit_offset, payload, 1, 1, 0, 72);\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = dylib_name(output, 13, name);\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = dylib_name(output, 12, string.to_bytes(\"/usr/lib/libSystem.B.dylib\"));\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = dylib_words(output, [50, 24, 1, 720896, 720896, 0, 2147483699, 16, layout.linkedit_offset, len(trie),\n        2, 24, symoff, len(spec.exports), stroff, file_size - stroff, 11, 80, 0, 0, 0, len(spec.exports), len(spec.exports), 0]);\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = zeros(output, 48);\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = zeros(output, entry_offset - binary.writer_offset(output));\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = put_bytes(output, patched.bytes);\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = zeros(output, layout.const_offset - binary.writer_offset(output));\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = put_bytes(output, image.constants);\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = zeros(output, layout.linkedit_offset - binary.writer_offset(output));\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = put_bytes(output, trie);\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = zeros(output, symoff - binary.writer_offset(output));\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = put_bytes(output, binary.writer_bytes(symbols));\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = put_bytes(output, binary.writer_bytes(names));\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    failure = zeros(output, file_size - binary.writer_offset(output));\n    moshi (failure != mu) { kaesu dylib_failure(layout, failure); }\n    kaesu ImageResult { bytes: binary.writer_bytes(output), layout: layout, error: mu };\n}\n" }; }
waza data_60() -> File { kaesu File { path: "kiso/aot/macho/macho.mio", version: "Bunko-v2.1.1", length: 20099, sha256: "b3f060a6ceabfc31aaeb263c1d0d902b2a4ce2e4ca42c737aeea75bcf29efeaf", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/array\";\nyobu \"kiso/encoding/binary\";\n\n// 纯 Mio 实现的 Darwin ARM64 Mach-O 可执行文件生成器。\n// 布局与 Go AOT 生成器保持一致；所有标签与映像内地址修补（Patch）均在输出前静态解析完毕，因此重定位表保持为空。\nkoukai sentaku MachOError {\n    EmptyText;\n    TooManyGlobals;\n    ImageTooLarge;\n    LoadCommandsTooLarge;\n    InvalidPatch;\n    EncodeFailure;\n    WriteFailure;\n    InvalidExport;\n}\n\nkoukai kata AddressTarget { kind: int64; }\nkoukai waza text_target() -> AddressTarget { kaesu AddressTarget { kind: 0 }; }\nkoukai waza const_target() -> AddressTarget { kaesu AddressTarget { kind: 1 }; }\nkoukai waza data_target() -> AddressTarget { kaesu AddressTarget { kind: 2 }; }\nkoukai kata AddressPatch {\n    at_word: int64;\n    add_at_word: int64;\n    target: AddressTarget;\n    target_offset: int64;\n    register: int64;\n}\nkoukai kata Section {\n    segment: string;\n    name: string;\n    file_offset: int64;\n    vm_offset: int64;\n    size: int64;\n    alignment: int64;\n}\nkoukai kata Symbol {\n    name: string;\n    section: int64;\n    value: int64;\n}\nkoukai kata Relocation {\n    section: int64;\n    offset: int64;\n    symbol: int64;\n    pc_relative: bool;\n    width: int64;\n}\nkoukai kata Layout {\n    text_size: int64;\n    const_offset: int64;\n    data_offset: int64;\n    linkedit_offset: int64;\n    file_size: int64;\n    sections: []Section;\n}\nkoukai kata ImageSpec {\n    words: []uint32;\n    constants: []uint8;\n    globals: int64;\n    patches: []AddressPatch;\n}\nkoukai kata ImageResult {\n    bytes: []uint8;\n    layout: Layout;\n    error: MachOError?;\n}\n\nteisu page_size = 16384;\nteisu entry_offset = 768;\nteisu maximum_image_size = 67108864;\n\nwaza align(value: int64, boundary: int64) -> int64 {\n    kaku remainder = value - (value / boundary) * boundary;\n    moshi (remainder == 0) { kaesu value; }\n    kaesu value + boundary - remainder;\n}\n\nkoukai waza plan(code_size: int64, const_size: int64, globals: int64) -> Layout {\n    kaku const_offset = align(entry_offset + code_size, 8);\n    kaku text_end = entry_offset + code_size;\n    moshi (const_size > 0) { text_end = const_offset + const_size; }\n    kaku text_size = align(text_end, page_size);\n    kaku data_size = 0;\n    moshi (globals > 0) {\n        data_size = align(globals * 8, page_size);\n    }\n    kaku sections = array.with_capacity[Section](3);\n    array.push(sections, Section {\n            segment: \"__TEXT\", name: \"__text\", file_offset: entry_offset, vm_offset: entry_offset, size: code_size, alignment: 2 });\n    moshi (const_size > 0) {\n        array.push(sections, Section {\n                segment: \"__TEXT\", name: \"__const\", file_offset: const_offset, vm_offset: const_offset, size: const_size, alignment: 3 });\n    }\n    moshi (globals > 0) {\n        array.push(sections, Section {\n                segment: \"__DATA\", name: \"__data\", file_offset: text_size, vm_offset: text_size, size: globals * 8, alignment: 3 });\n    }\n    kaesu Layout {\n        text_size: text_size, const_offset: const_offset, data_offset: text_size, linkedit_offset: text_size + data_size, file_size: text_size + data_size, sections: sections };\n}\n\nwaza binary_failure(problem: binary.BinaryError?) -> MachOError? {\n    moshi (problem != mu) { kaesu MachOError.WriteFailure(); }\n    kaesu mu;\n}\nwaza put32(output: binary.BinaryWriter, value: int64) -> MachOError? {\n    moshi (value < 0 || value > 4294967295) { kaesu MachOError.WriteFailure(); }\n    kaesu binary_failure(binary.writer_write_u32_le(output, uint32(value)));\n}\nwaza put64(output: binary.BinaryWriter, high: int64, low: int64) -> MachOError? {\n    moshi (high < 0 || high > 4294967295 || low < 0 || low > 4294967295) { kaesu MachOError.WriteFailure(); }\n    kaesu binary_failure(binary.writer_write_u64_le(output, binary.U64 { high: uint32(high), low: uint32(low) }));\n}\nwaza put_bytes(output: binary.BinaryWriter, value: []uint8) -> MachOError? {\n    kaesu binary_failure(binary.writer_write_bytes(output, value));\n}\nwaza zeros(output: binary.BinaryWriter, count: int64) -> MachOError? { kaesu binary_failure(binary.writer_reserve(output, count).error); }\n\nwaza name16(output: binary.BinaryWriter, value: []uint8) -> MachOError? {\n    moshi (len(value) > 16) { kaesu MachOError.WriteFailure(); }\n    kaku failure = put_bytes(output, value);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    kaesu zeros(output, 16 - len(value));\n}\n\nwaza segment(output: binary.BinaryWriter, name: []uint8, vm_high: int64, vm_low: int64, vm_size_high: int64, vm_size: int64,\n    file_offset: int64, file_size: int64, max_protection: int64, initial_protection: int64,\n    section_count: int64, command_size: int64) -> MachOError? {\n    kaku failure = put32(output, 25);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put32(output, command_size);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = name16(output, name);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put64(output, vm_high, vm_low);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put64(output, vm_size_high, vm_size);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put64(output, 0, file_offset);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put64(output, 0, file_size);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put32(output, max_protection);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put32(output, initial_protection);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put32(output, section_count);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    kaesu put32(output, 0);\n}\n\nwaza section(output: binary.BinaryWriter, section_name: []uint8, segment_name: []uint8,\n    vm_high: int64, vm_low: int64, size: int64, file_offset: int64, alignment: int64, flags: int64) -> MachOError? {\n    kaku failure = name16(output, section_name);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = name16(output, segment_name);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put64(output, vm_high, vm_low);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put64(output, 0, size);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put32(output, file_offset);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put32(output, alignment);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put32(output, 0);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put32(output, 0);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put32(output, flags);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put32(output, 0);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    failure = put32(output, 0);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    kaesu put32(output, 0);\n}\n\nwaza target_is_const(value: AddressTarget) -> bool { kaesu value.kind == 1; }\nwaza target_is_data(value: AddressTarget) -> bool { kaesu value.kind == 2; }\nwaza target_is_text(value: AddressTarget) -> bool { kaesu value.kind == 0; }\n\nwaza patch_words(spec: ImageSpec, layout: Layout) -> ImageResult {\n    kaku words = array.clone(spec.words);\n    kaku index = 0;\n    aida (index < len(spec.patches)) {\n        kaku patch = spec.patches[index];\n        moshi (patch.at_word < 0 || patch.at_word >= len(words) || patch.target_offset < 0) {\n            kaesu ImageResult { bytes: [], layout: layout, error: MachOError.InvalidPatch() };\n        }\n        moshi (patch.target.kind < 0 || patch.target.kind > 2) {\n            kaesu ImageResult {\n                bytes: [], layout: layout, error: MachOError.InvalidPatch() };\n        }\n        kaku target = entry_offset + patch.target_offset;\n        moshi (target_is_const(patch.target)) { target = layout.const_offset + patch.target_offset; }\n        moshi (target_is_data(patch.target)) { target = layout.data_offset + patch.target_offset; }\n        moshi ((target_is_text(patch.target) && patch.target_offset >= len(spec.words) * 4) ||\n            (target_is_const(patch.target) && patch.target_offset >= len(spec.constants)) ||\n            (target_is_data(patch.target) && patch.target_offset >= spec.globals * 8)) {\n            kaesu ImageResult { bytes: [], layout: layout, error: MachOError.InvalidPatch() };\n        }\n        kaku encoded = arm64.adrp_offset(patch.register, entry_offset + patch.at_word * 4, target);\n        moshi (encoded.error != mu) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.EncodeFailure() }; }\n        words[patch.at_word] = encoded.word;\n        moshi (patch.add_at_word >= 0) {\n            moshi (patch.add_at_word >= len(words) || patch.add_at_word == patch.at_word) {\n                kaesu ImageResult {\n                    bytes: [], layout: layout, error: MachOError.InvalidPatch() };\n            }\n            kaku low = target - (target / 4096) * 4096;\n            kaku addition = arm64.add_imm_x(patch.register, patch.register, low, iie);\n            moshi (addition.error != mu) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.EncodeFailure() }; }\n            words[patch.add_at_word] = addition.word;\n        }\n        index = index + 1;\n    }\n    // An internal helper result uses bytes as a little-endian word stream.\n    kaku temp = binary.writer(len(words) * 4);\n    index = 0;\n    aida (index < len(words)) {\n        moshi (binary.writer_write_u32_le(temp, words[index]) != mu) {\n            kaesu ImageResult {\n                bytes: [], layout: layout, error: MachOError.WriteFailure() };\n        }\n        index = index + 1;\n    }\n    kaesu ImageResult { bytes: binary.writer_bytes(temp), layout: layout, error: mu };\n}\n\nkoukai waza executable(spec: ImageSpec) -> ImageResult { kaesu executable_bounded(spec, 2052); }\n// Keep the source-language/private ABI global envelope intact. A target runtime\n// may append separately owned words; it may not consume existing user slots.\nkoukai waza executable_with_runtime_data(spec: ImageSpec, runtime_words: int64) -> ImageResult {\n    moshi (spec.globals<0 || spec.globals>2052 || runtime_words<0 || runtime_words>1048576) {\n        kaesu ImageResult { bytes: [], layout: plan(0, 0, 0), error: MachOError.TooManyGlobals() };\n    }\n    kaesu executable_bounded(ImageSpec { words: spec.words, constants: spec.constants,\n            globals: spec.globals + runtime_words, patches: spec.patches }, 2052 + 1048576);\n}\nwaza executable_bounded(spec: ImageSpec, maximum_globals: int64) -> ImageResult {\n    kaku empty_layout = plan(0, 0, 0);\n    moshi (len(spec.words) == 0) { kaesu ImageResult { bytes: [], layout: empty_layout, error: MachOError.EmptyText() }; }\n    // The lowerer still enforces 2048 user globals. Four private ABI words\n    // preserve that capacity when assertion reporting and OS arguments coexist.\n    moshi (spec.globals < 0 || spec.globals > maximum_globals) {\n        kaesu ImageResult {\n            bytes: [], layout: empty_layout, error: MachOError.TooManyGlobals() };\n    }\n    moshi (len(spec.words) > (maximum_image_size - entry_offset) / 4 || len(spec.constants) > maximum_image_size) {\n        kaesu ImageResult { bytes: [], layout: empty_layout, error: MachOError.ImageTooLarge() };\n    }\n    kaku layout = plan(len(spec.words) * 4, len(spec.constants), spec.globals);\n    moshi (layout.file_size > maximum_image_size) { kaesu ImageResult { bytes: [], layout: layout, error: MachOError.ImageTooLarge() }; }\n    kaku patched = patch_words(spec, layout);\n    moshi (patched.error != mu) { kaesu patched; }\n\n    kaku has_const = len(spec.constants) > 0;\n    kaku has_data = spec.globals > 0;\n    kaku text_command_size = 152;\n    moshi (has_const) {\n        text_command_size = 232;\n    }\n    kaku command_size = 72 + text_command_size + 72 + 32 + 24 + 24 + 80 + 24;\n    kaku command_count = 8;\n    moshi (has_data) {\n        command_size = command_size + 152;\n        command_count = 9;\n    }\n    moshi (32 + command_size + 16 > entry_offset) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: MachOError.LoadCommandsTooLarge() };\n    }\n\n    kaku output = binary.writer(layout.file_size);\n    kaku failure = put32(output, 4277009103);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 16777228);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 0);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 2);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, command_count);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, command_size);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 2097285);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 0);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n\n    failure = segment(output, [95, 95, 80, 65, 71, 69, 90, 69, 82, 79], 0, 0, 1, 0, 0, 0, 0, 0, 0, 72);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    kaku text_sections = 1;\n    moshi (has_const) {\n        text_sections = 2;\n    }\n    failure = segment(output, [95, 95, 84, 69, 88, 84], 1, 0, 0, layout.text_size, 0, layout.text_size, 5, 5, text_sections, text_command_size);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    failure = section(output, [95, 95, 116, 101, 120, 116], [95, 95, 84, 69, 88, 84], 1, entry_offset, len(spec.words) * 4, entry_offset, 2, 2147484672);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    moshi (has_const) {\n        failure = section(output, [95, 95, 99, 111, 110, 115, 116], [95, 95, 84, 69, 88, 84], 1, layout.const_offset, len(spec.constants), layout.const_offset, 3, 0);\n        moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    }\n    moshi (has_data) {\n        failure = segment(output, [95, 95, 68, 65, 84, 65], 1, layout.data_offset, 0, layout.linkedit_offset - layout.data_offset, layout.data_offset, layout.linkedit_offset - layout.data_offset, 3, 3, 1, 152);\n        moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n        failure = section(output, [95, 95, 100, 97, 116, 97], [95, 95, 68, 65, 84, 65], 1, layout.data_offset, spec.globals * 8, layout.data_offset, 3, 0);\n        moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n    }\n    failure = segment(output, [95, 95, 76, 73, 78, 75, 69, 68, 73, 84], 1, layout.linkedit_offset, 0, page_size, layout.linkedit_offset, 0, 1, 1, 0, 72);\n    moshi (failure != mu) { kaesu ImageResult { bytes: [], layout: layout, error: failure }; }\n\n    // LC_LOAD_DYLINKER, command size 32, path offset 12.\n    failure = put32(output, 14);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 32);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 12);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put_bytes(output, [47, 117, 115, 114, 47, 108, 105, 98, 47, 100, 121, 108, 100, 0]);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = zeros(output, 6);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n\n    // LC_BUILD_VERSION: macOS 11.0, no tool records.\n    failure = put32(output, 50);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 24);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 1);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 720896);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 720896);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 0);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n\n    // Empty LC_SYMTAB and LC_DYSYMTAB. All pure-Mio fixups are already final.\n    failure = put32(output, 2);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 24);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = zeros(output, 16);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 11);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 80);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = zeros(output, 72);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n\n    failure = put32(output, 2147483688);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put32(output, 24);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put64(output, 0, entry_offset);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put64(output, 0, 0);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n\n    failure = zeros(output, entry_offset - binary.writer_offset(output));\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = put_bytes(output, patched.bytes);\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    failure = zeros(output, layout.const_offset - binary.writer_offset(output));\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    moshi (has_const) {\n        failure = put_bytes(output, spec.constants);\n        moshi (failure != mu) {\n            kaesu ImageResult {\n                bytes: [], layout: layout, error: failure };\n        }\n    }\n    failure = zeros(output, layout.file_size - binary.writer_offset(output));\n    moshi (failure != mu) {\n        kaesu ImageResult {\n            bytes: [], layout: layout, error: failure };\n    }\n    kaesu ImageResult { bytes: binary.writer_bytes(output), layout: layout, error: mu };\n}\n" }; }
waza data_61() -> File { kaesu File { path: "kiso/aot/machox64/machox64.mio", version: "Bunko-v2.1.1", length: 6637, sha256: "0d892758bd96aebed91acc246cd0704d66a22b393df477a6454ddac1537d1d6a", source: "yobu \"kiso/aot/elf\";\nyobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// Pure Mio macOS x86-64 Mach-O (MH_EXECUTE) writer for the Linux-convention x86-64 lowering (kiso/aot/lowerlinux).\n//\n// The image keeps the ELF writer's fixed, position-dependent addresses so the lowered code needs no relocation:\n//   __PAGEZERO  0x0 .. 0x400000                       (no access)\n//   __TEXT      vm 0x400000 (file 0): header, load commands and the code at file offset 0x1000   r-x\n//   __DATA      vm 0x10000000, zero-fill (no file bytes)                                          rw-\n//   __LINKEDIT  after __DATA (empty)\n// Load commands: LC_LOAD_DYLINKER /usr/lib/dyld, LC_BUILD_VERSION (macOS minos 11.0), empty LC_SYMTAB/LC_DYSYMTAB and\n// LC_MAIN. The header has no MH_PIE flag: x86-64 macOS runs fixed-address executables. cputype is CPU_TYPE_X86_64\n// (0x01000007) and cpusubtype CPU_SUBTYPE_X86_64_ALL (3). dyld enters at LC_MAIN's entryoff with the C calling\n// convention main(argc, argv, envp); the caller of this writer is responsible for the first instructions at the entry.\nkoukai teisu text_base = 4194304;\nkoukai teisu code_offset = 4096;\nkoukai teisu data_base = 268435456;\nteisu page_size = 4096;\nteisu maximum_text_size = 264241152;\nteisu maximum_bss_size = 268435456;\nteisu header_size = 32;\n\nkoukai kata ImageSpec {\n    code: []uint8;\n    entry_offset: int64;\n    bss_size: int64;\n}\nkoukai kata ImageResult {\n    bytes: []uint8;\n    error: string;\n}\n\nwaza put(out: []uint8, value: int64, width: int64) -> unit {\n    kaku x = value;\n    moshi (x < 0) {\n        x = x + 4294967296;\n    }\n    kaku i = 0;\n    aida (i < width) {\n        array.push(out, uint8(x - (x / 256) * 256));\n        x = x / 256;\n        i = i + 1;\n    }\n}\n// 64-bit values below 2^62 as two halves\nwaza put64(out: []uint8, value: int64) -> unit {\n    put(out, value - (value / 4294967296) * 4294967296, 4);\n    put(out, value / 4294967296, 4);\n}\nwaza name16(out: []uint8, text: string) -> unit {\n    kaku bytes = string.to_bytes(text);\n    array.append_all(out, bytes);\n    kaku n = len(bytes);\n    aida (n < 16) {\n        array.push(out, uint8(0));\n        n = n + 1;\n    }\n}\nwaza align(value: int64, boundary: int64) -> int64 {\n    kaku r = value - (value / boundary) * boundary;\n    moshi (r == 0) { kaesu value; }\n    kaesu value + boundary - r;\n}\n// LC_SEGMENT_64: name, vmaddr, vmsize, fileoff, filesize, maxprot, initprot, nsects (command size 72 + 80 * nsects)\nwaza segment(out: []uint8, name: string, vmaddr: int64, vmsize: int64, fileoff: int64, filesize: int64, maxprot: int64, initprot: int64, sections: int64) -> unit {\n    put(out, 25, 4);\n    put(out, 72 + 80 * sections, 4);\n    name16(out, name);\n    put64(out, vmaddr);\n    put64(out, vmsize);\n    put64(out, fileoff);\n    put64(out, filesize);\n    put(out, maxprot, 4);\n    put(out, initprot, 4);\n    put(out, sections, 4);\n    put(out, 0, 4);\n}\nwaza section(out: []uint8, name: string, segment_name: string, addr: int64, size: int64, offset: int64, alignment: int64, flags: int64) -> unit {\n    name16(out, name);\n    name16(out, segment_name);\n    put64(out, addr);\n    put64(out, size);\n    put(out, offset, 4);\n    put(out, alignment, 4);\n    put(out, 0, 4);\n    put(out, 0, 4);\n    put(out, flags, 4);\n    put(out, 0, 4);\n    put(out, 0, 4);\n    put(out, 0, 4);\n}\n\nkoukai waza executable(spec: ImageSpec) -> ImageResult {\n    moshi (len(spec.code) == 0) { kaesu ImageResult { bytes: [], error: \"EMPTY_TEXT\" }; }\n    moshi (spec.entry_offset < 0 || spec.entry_offset >= len(spec.code)) { kaesu ImageResult { bytes: [], error: \"INVALID_ENTRY\" }; }\n    moshi (spec.bss_size < 0 || spec.bss_size > maximum_bss_size) { kaesu ImageResult { bytes: [], error: \"INVALID_BSS\" }; }\n    kaku text_end = code_offset + len(spec.code);\n    moshi (text_end > maximum_text_size) { kaesu ImageResult { bytes: [], error: \"IMAGE_TOO_LARGE\" }; }\n    kaku file_size = align(text_end, page_size);\n    kaku has_data = spec.bss_size > 0;\n    kaku data_size = align(spec.bss_size, page_size);\n    kaku commands = 8;\n    moshi (has_data) { commands = commands + 1; }\n    // 8 commands without __DATA (PAGEZERO, TEXT, LINKEDIT, DYLINKER, BUILD_VERSION, SYMTAB, DYSYMTAB, MAIN), 9 with it.\n    // sizes: PAGEZERO 72, TEXT 72+80, DATA 72+80, LINKEDIT 72, DYLINKER 32, BUILD_VERSION 24, SYMTAB 24, DYSYMTAB 80, MAIN 24\n    kaku command_bytes = 72 + 152 + 72 + 32 + 24 + 24 + 80 + 24;\n    moshi (has_data) { command_bytes = command_bytes + 152; }\n    moshi (header_size + command_bytes > code_offset) { kaesu ImageResult { bytes: [], error: \"LOAD_COMMANDS_TOO_LARGE\" }; }\n    kaku out: []uint8 = array.with_capacity[uint8](file_size);\n    // mach_header_64\n    put(out, 4277009103, 4);\n    put(out, 16777223, 4);\n    put(out, 3, 4);\n    put(out, 2, 4);\n    put(out, commands, 4);\n    put(out, command_bytes, 4);\n    put(out, 133, 4);\n    put(out, 0, 4);\n    segment(out, \"__PAGEZERO\", 0, text_base, 0, 0, 0, 0, 0);\n    segment(out, \"__TEXT\", text_base, file_size, 0, file_size, 5, 5, 1);\n    section(out, \"__text\", \"__TEXT\", text_base + code_offset, len(spec.code), code_offset, 4, 2147484672);\n    kaku linkedit_vm = text_base + file_size;\n    moshi (has_data) {\n        segment(out, \"__DATA\", data_base, data_size, 0, 0, 3, 3, 1);\n        section(out, \"__bss\", \"__DATA\", data_base, spec.bss_size, 0, 3, 1);\n        linkedit_vm = data_base + data_size;\n    }\n    segment(out, \"__LINKEDIT\", linkedit_vm, page_size, file_size, 0, 1, 1, 0);\n    // LC_LOAD_DYLINKER \"/usr/lib/dyld\"\n    put(out, 14, 4);\n    put(out, 32, 4);\n    put(out, 12, 4);\n    array.append_all(out, string.to_bytes(\"/usr/lib/dyld\"));\n    kaku pad = 0;\n    aida (pad < 7) {\n        array.push(out, uint8(0));\n        pad = pad + 1;\n    }\n    // LC_BUILD_VERSION: platform macOS (1), minos 11.0, sdk 11.0, no tools\n    put(out, 50, 4);\n    put(out, 24, 4);\n    put(out, 1, 4);\n    put(out, 720896, 4);\n    put(out, 720896, 4);\n    put(out, 0, 4);\n    // empty LC_SYMTAB and LC_DYSYMTAB\n    put(out, 2, 4);\n    put(out, 24, 4);\n    kaku z = 0;\n    aida (z < 16) {\n        array.push(out, uint8(0));\n        z = z + 1;\n    }\n    put(out, 11, 4);\n    put(out, 80, 4);\n    z = 0;\n    aida (z < 72) {\n        array.push(out, uint8(0));\n        z = z + 1;\n    }\n    // LC_MAIN: entryoff (file offset of the entry), stacksize 0\n    put(out, 2147483688, 4);\n    put(out, 24, 4);\n    put64(out, code_offset + spec.entry_offset);\n    put64(out, 0);\n    aida (len(out) < code_offset) { array.push(out, uint8(0)); }\n    array.append_all(out, spec.code);\n    aida (len(out) < file_size) { array.push(out, uint8(0)); }\n    kaesu ImageResult { bytes: out, error: \"\" };\n}\n" }; }
waza data_62() -> File { kaesu File { path: "kiso/aot/pe/pe.mio", version: "Bunko-v2.1.1", length: 26812, sha256: "c3e5f44cb57231e88a44b73d749b9d66eaf4314cb21091a7c2994e40f3c3f486", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// 纯 Mio 实现的 Windows PE32+ 可执行映像生成器：仅负责段布局、导入表（IAT）、重定位与 xdata/pdata 展开信息编码，\n// 不涉及指令选择、宿主 I/O 或外部链接器进程。\nkoukai teisu text_section = 1;\nkoukai teisu rdata_section = 2;\nkoukai teisu data_section = 3;\nkoukai teisu import_section = 4;\nkoukai teisu rva32 = 1;\nkoukai teisu rel32 = 2;\nkoukai teisu va64 = 3;\nkoukai teisu image_base = 5368709120;\nkoukai teisu file_alignment = 512;\nkoukai teisu section_alignment = 4096;\nkoukai teisu maximum_image_size = 67108864;\n\nkoukai sentaku PEError {\n    EmptyText;\n    InvalidEntry;\n    ImageTooLarge;\n    InvalidImport;\n    InvalidPatch;\n    InvalidUnwind;\n}\nkoukai kata ImportLibrary {\n    name: string;\n    symbols: []string;\n}\n// Source offsets are within initialized bytes. Target offsets are within the\n// virtual section; import_section instead uses a flattened zero-based IAT index.\nkoukai kata Patch {\n    section: int64;\n    offset: int64;\n    kind: int64;\n    target: int64;\n    target_offset: int64;\n}\n// Bounded unwind model: no frame pointer, handlers or nonvolatile saves yet.\n// stack_offset is the offset AFTER the single stack allocation instruction.\nkoukai kata UnwindFunction {\n    begin: int64;\n    end: int64;\n    prolog_size: int64;\n    stack_size: int64;\n    stack_offset: int64;\n}\n// Frame-pointer function: `push rbp` (offsets are AFTER each instruction), `mov rbp,rsp`, optional\n// `sub rsp,alloc_size`. alloc_size==0 means no allocation and alloc_offset must be 0.\n// Unwind recovers RSP from RBP (FrameOffset 0), so later dynamic pushes and `and rsp,-16` are covered.\nkoukai kata FrameFunction {\n    begin: int64;\n    end: int64;\n    push_offset: int64;\n    set_offset: int64;\n    alloc_offset: int64;\n    alloc_size: int64;\n}\nkoukai kata ImageSpec {\n    text: []uint8;\n    rdata: []uint8;\n    data: []uint8;\n    zero_fill: int64;\n    entry: int64;\n    imports: []ImportLibrary;\n    patches: []Patch;\n    unwind: []UnwindFunction;\n}\nkoukai kata Section {\n    kind: int64;\n    name: string;\n    rva: int64;\n    offset: int64;\n    virtual_size: int64;\n    raw_size: int64;\n    flags: int64;\n}\nkoukai kata Layout {\n    headers_size: int64;\n    image_size: int64;\n    file_size: int64;\n    sections: []Section;\n    iat_rva: int64;\n    iat_size: int64;\n}\nkoukai kata ImageResult {\n    bytes: []uint8;\n    layout: Layout;\n    error: PEError?;\n}\n\nkata LibraryLayout {\n    lookup: int64;\n    iat: int64;\n    name: int64;\n    hints: []int64;\n}\nkata Imports {\n    size: int64;\n    iat: int64;\n    iat_size: int64;\n    libraries: []LibraryLayout;\n    slots: []int64;\n}\n\nwaza align(value: int64, boundary: int64) -> int64 { kaesu ((value + boundary - 1) / boundary) * boundary; }\nwaza empty_layout() -> Layout { kaesu Layout { headers_size: 0, image_size: 0, file_size: 0, sections: [], iat_rva: 0, iat_size: 0 }; }\nwaza failure(error: PEError) -> ImageResult { kaesu ImageResult { bytes: [], layout: empty_layout(), error: error }; }\nwaza put(bytes: []uint8, at: int64, width: int64, value: int64) -> unit {\n    kaku i = 0;\n    kaku rest = value;\n    aida (i<width) {\n        bytes[at + i] = uint8(rest - (rest / 256) * 256);\n        rest = rest / 256;\n        i = i + 1;\n    }\n}\nwaza copy_bytes(bytes: []uint8, at: int64, source: []uint8) -> unit {\n    kaku i = 0;\n    aida (i<len(source)) {\n        bytes[at + i] = source[i];\n        i = i + 1;\n    }\n}\nwaza ascii_name(name: string) -> bool {\n    kaku bytes = string.to_bytes(name);\n    moshi (len(bytes) == 0 || len(bytes)>255) { kaesu iie; }\n    kaku i = 0;\n    aida (i<len(bytes)) {\n        moshi (bytes[i]<uint8(33) || bytes[i]>uint8(126)) {\n            kaesu iie;\n        }\n        i = i + 1;\n    }\n    kaesu hai;\n}\nwaza valid_imports(libraries: []ImportLibrary) -> bool {\n    moshi (len(libraries)>256) { kaesu iie; }\n    kaku total = 0;\n    kaku i = 0;\n    aida (i<len(libraries)) {\n        kaku lib = libraries[i];\n        moshi (!ascii_name(lib.name) || len(lib.symbols) == 0 || len(lib.symbols)>4096 - total) {\n            kaesu iie;\n        }\n        kaku j = 0;\n        aida (j<i) {\n            moshi (libraries[j].name == lib.name) {\n                kaesu iie;\n            }\n            j = j + 1;\n        }\n        j = 0; aida (j<len(lib.symbols)) {\n            moshi (!ascii_name(lib.symbols[j])) { kaesu iie; }\n            kaku k = 0;\n            aida (k<j) {\n                moshi (lib.symbols[k] == lib.symbols[j]) {\n                    kaesu iie;\n                }\n                k = k + 1;\n            }\n            j = j + 1;\n        }\n        total = total + len(lib.symbols);\n        i = i + 1;\n    } kaesu hai;\n}\nwaza plan_imports(libraries: []ImportLibrary) -> Imports {\n    kaku result = Imports { size: 0, iat: 0, iat_size: 0, libraries: [], slots: [] };\n    moshi (len(libraries) == 0) { kaesu result; }\n    kaku at = align((len(libraries) + 1) * 20, 8);\n    kaku i = 0;\n    aida (i<len(libraries)) {\n        array.push(result.libraries, LibraryLayout { lookup: at, iat: 0, name: 0, hints: [] });\n        at = at + (len(libraries[i].symbols) + 1) * 8;\n        i = i + 1;\n    }\n    kaku iat = at;\n    i = 0;\n    aida (i<len(libraries)) {\n        kaku entry = result.libraries[i];\n        result.libraries[i] = LibraryLayout {\n            lookup: entry.lookup, iat: at, name: 0, hints: [] };\n        kaku j = 0;\n        aida (j<len(libraries[i].symbols)) {\n            array.push(result.slots, at + j * 8);\n            j = j + 1;\n        }\n        at = at + (len(libraries[i].symbols) + 1) * 8;\n        i = i + 1;\n    }\n    kaku iat_size = at - iat;\n    i = 0;\n    aida (i<len(libraries)) {\n        kaku entry = result.libraries[i];\n        result.libraries[i] = LibraryLayout {\n            lookup: entry.lookup, iat: entry.iat, name: at, hints: entry.hints };\n        at = at + len(string.to_bytes(libraries[i].name)) + 1;\n        kaku j = 0;\n        aida (j<len(libraries[i].symbols)) {\n            at = align(at, 2);\n            array.push(result.libraries[i].hints, at);\n            at = at + 2 + len(string.to_bytes(libraries[i].symbols[j])) + 1;\n            j = j + 1;\n        } i = i + 1;\n    } kaesu Imports { size: at, iat: iat, iat_size: iat_size, libraries: result.libraries, slots: result.slots };\n}\nwaza unwind_size(functions: []UnwindFunction) -> int64 {\n    kaku size = 0;\n    kaku i = 0;\n    aida (i<len(functions)) {\n        size = size + 4;\n        moshi (functions[i].stack_size>0) {\n            size = size + 4;\n        }\n        i = i + 1;\n    }\n    kaesu size;\n}\nwaza frame_slots(f: FrameFunction) -> int64 {\n    kaku slots = 2;\n    moshi (f.alloc_size>128) {\n        slots = 4;\n    }\n    moshi (f.alloc_size>0 && f.alloc_size <= 128) {\n        slots = 3;\n    }\n    moshi (slots == 3) {\n        slots = 4;\n    }\n    kaesu slots;\n}\nwaza frame_size(frames: []FrameFunction) -> int64 {\n    kaku size = 0;\n    kaku i = 0;\n    aida (i<len(frames)) {\n        size = size + 4 + frame_slots(frames[i]) * 2;\n        i = i + 1;\n    }\n    kaesu size;\n}\nwaza valid_frames(frames: []FrameFunction, text_size: int64) -> bool {\n    moshi (len(frames)>4096) {\n        kaesu iie;\n    }\n    kaku previous = 0;\n    kaku i = 0;\n    aida (i<len(frames)) {\n        kaku f = frames[i];\n        moshi (f.begin<previous || f.end <= f.begin || f.end>text_size) { kaesu iie; }\n        moshi (f.push_offset <= 0 || f.set_offset <= f.push_offset) { kaesu iie; }\n        moshi (f.alloc_size<0 || f.alloc_size>524280 || f.alloc_size - (f.alloc_size / 8) * 8 != 0) { kaesu iie; }\n        moshi (f.alloc_size == 0 && f.alloc_offset != 0) { kaesu iie; }\n        moshi (f.alloc_size>0 && f.alloc_offset <= f.set_offset) { kaesu iie; }\n        kaku prolog = f.set_offset;\n        moshi (f.alloc_size>0) {\n            prolog = f.alloc_offset;\n        }\n        moshi (prolog>255 || prolog>f.end - f.begin) { kaesu iie; }\n        previous = f.end;\n        i = i + 1;\n    } kaesu hai;\n}\nwaza valid_unwind(functions: []UnwindFunction, text_size: int64) -> bool {\n    moshi (len(functions)>4096) {\n        kaesu iie;\n    }\n    kaku previous = 0;\n    kaku i = 0;\n    aida (i<len(functions)) {\n        kaku f = functions[i];\n        moshi (f.begin<previous || f.end <= f.begin || f.end>text_size || f.prolog_size<0 || f.prolog_size>255 || f.prolog_size>f.end - f.begin) {\n            kaesu iie;\n        }\n        moshi (f.stack_size<0 || f.stack_size>524280 || f.stack_size - (f.stack_size / 8) * 8 != 0) { kaesu iie; }\n        moshi (f.stack_size == 0 && f.stack_offset != 0) { kaesu iie; }\n        moshi (f.stack_size>0 && (f.stack_offset <= 0 || f.stack_offset>f.prolog_size)) { kaesu iie; }\n        previous = f.end;\n        i = i + 1;\n    } kaesu hai;\n}\nwaza add_section(layout: Layout, kind: int64, name: string, size: int64, virtual_size: int64, flags: int64) -> Layout {\n    kaku raw = align(size, file_alignment);\n    kaku at = layout.file_size;\n    moshi (size == 0) {\n        at = 0;\n    }\n    array.push(layout.sections, Section {\n            kind: kind, name: name, rva: layout.image_size, offset: at, virtual_size: virtual_size, raw_size: raw, flags: flags });\n    kaesu Layout {\n        headers_size: layout.headers_size, file_size: layout.file_size + raw, image_size: align(layout.image_size + virtual_size, section_alignment), sections: layout.sections, iat_rva: layout.iat_rva, iat_size: layout.iat_size };\n}\nwaza section(layout: Layout, kind: int64) -> Section {\n    kaku i = 0;\n    aida (i<len(layout.sections)) {\n        moshi (layout.sections[i].kind == kind) {\n            kaesu layout.sections[i];\n        }\n        i = i + 1;\n    }\n    kaesu Section { kind: 0, name: \"\", rva: 0, offset: 0, virtual_size: 0, raw_size: 0, flags: 0 };\n}\nwaza source_size(spec: ImageSpec, kind: int64) -> int64 {\n    moshi (kind == text_section) { kaesu len(spec.text); }\n    moshi (kind == rdata_section) { kaesu len(spec.rdata); }\n    moshi (kind == data_section) {\n        kaesu len(spec.data);\n    }\n    kaesu -1;\n}\nwaza patch_target(p: Patch, layout: Layout, imports: Imports) -> int64 {\n    kaku target = section(layout, p.target);\n    moshi (p.target == import_section) {\n        moshi (p.target_offset<0 || p.target_offset >= len(imports.slots)) { kaesu -1; }\n        kaesu target.rva + imports.slots[p.target_offset];\n    }\n    moshi (p.target<text_section || p.target>data_section || target.kind == 0 || p.target_offset<0 || p.target_offset >= target.virtual_size) {\n        kaesu -1;\n    }\n    kaesu target.rva + p.target_offset;\n}\nwaza valid_patches(spec: ImageSpec, layout: Layout, imports: Imports) -> bool {\n    kaku i = 0; aida (i<len(spec.patches)) {\n        kaku p = spec.patches[i];\n        kaku width = 4;\n        moshi (p.kind == va64) {\n            width = 8;\n        }\n        kaku size = source_size(spec, p.section);\n        moshi (p.kind<rva32 || p.kind>va64 || p.offset<0 || p.offset>size || width>size - p.offset || patch_target(p, layout, imports)<0) {\n            kaesu iie;\n        }\n        kaku j = 0;\n        aida (j<i) {\n            kaku q = spec.patches[j];\n            kaku other = 4;\n            moshi (q.kind == va64) {\n                other = 8;\n            }\n            moshi (p.section == q.section && p.offset<q.offset + other && q.offset<p.offset + width) {\n                kaesu iie;\n            }\n            j = j + 1;\n        } i = i + 1;\n    } kaesu hai;\n}\n// Sort relocation RVAs independently of patch input order. Each page block has\n// a DWORD-sized header and an even number of WORDs, padded with ABSOLUTE (0).\nwaza relocation_bytes(spec: ImageSpec, layout: Layout) -> []uint8 {\n    kaku addresses: []int64 = [];\n    kaku i = 0;\n    aida (i<len(spec.patches)) {\n        kaku p = spec.patches[i];\n        moshi (p.kind == va64) {\n            array.push(addresses, section(layout, p.section).rva + p.offset);\n        }\n        i = i + 1;\n    }\n    i = 1;\n    aida (i<len(addresses)) {\n        kaku j = i;\n        aida (j>0 && addresses[j]<addresses[j - 1]) {\n            kaku value = addresses[j];\n            addresses[j] = addresses[j - 1];\n            addresses[j - 1] = value;\n            j = j - 1;\n        }\n        i = i + 1;\n    }\n    kaku bytes: []uint8 = [];\n    i = 0;\n    aida (i<len(addresses)) {\n        kaku page = (addresses[i] / 4096) * 4096;\n        kaku end = i;\n        aida (end<len(addresses) && (addresses[end] / 4096) * 4096 == page) { end = end + 1; }\n        kaku size = align(8 + (end - i) * 2, 4);\n        kaku start = len(bytes);\n        kaku n = 0;\n        aida (n<size) {\n            array.push(bytes, uint8(0));\n            n = n + 1;\n        }\n        put(bytes, start, 4, page);\n        put(bytes, start + 4, 4, size);\n        n = 0;\n        aida (i<end) {\n            put(bytes, start + 8 + n * 2, 2, 40960 + addresses[i] - page);\n            n = n + 1;\n            i = i + 1;\n        }\n    } kaesu bytes;\n}\nwaza emit_imports(bytes: []uint8, spec: ImageSpec, layout: Layout, imports: Imports) -> unit {\n    moshi (imports.size == 0) {\n        kaesu;\n    }\n    kaku s = section(layout, import_section);\n    kaku i = 0;\n    aida (i<len(spec.imports)) {\n        kaku lib = spec.imports[i];\n        kaku entry = imports.libraries[i];\n        kaku at = s.offset + i * 20;\n        put(bytes, at, 4, s.rva + entry.lookup);\n        put(bytes, at + 12, 4, s.rva + entry.name);\n        put(bytes, at + 16, 4, s.rva + entry.iat);\n        copy_bytes(bytes, s.offset + entry.name, string.to_bytes(lib.name));\n        kaku j = 0;\n        aida (j<len(lib.symbols)) {\n            put(bytes, s.offset + entry.lookup + j * 8, 8, s.rva + entry.hints[j]);\n            put(bytes, s.offset + entry.iat + j * 8, 8, s.rva + entry.hints[j]);\n            copy_bytes(bytes, s.offset + entry.hints[j] + 2, string.to_bytes(lib.symbols[j]));\n            j = j + 1;\n        } i = i + 1;\n    }\n}\nwaza emit_unwind(bytes: []uint8, spec: ImageSpec, layout: Layout) -> unit {\n    kaku pdata = section(layout, 5);\n    kaku xdata = section(layout, 6);\n    kaku text = section(layout, text_section);\n    kaku offset = 0;\n    kaku i = 0;\n    aida (i<len(spec.unwind)) {\n        kaku f = spec.unwind[i];\n        kaku at = xdata.offset + offset;\n        put(bytes, pdata.offset + i * 12, 4, text.rva + f.begin);\n        put(bytes, pdata.offset + i * 12 + 4, 4, text.rva + f.end);\n        put(bytes, pdata.offset + i * 12 + 8, 4, xdata.rva + offset);\n        put(bytes, at, 1, 1);\n        put(bytes, at + 1, 1, f.prolog_size);\n        offset = offset + 4;\n        moshi (f.stack_size>0) {\n            put(bytes, at + 4, 1, f.stack_offset);\n            moshi (f.stack_size <= 128) {\n                put(bytes, at + 2, 1, 1);\n                put(bytes, at + 5, 1, 2 + ((f.stack_size - 8) / 8) * 16);\n            }\n            sore {\n                put(bytes, at + 2, 1, 2);\n                put(bytes, at + 5, 1, 1);\n                put(bytes, at + 6, 2, f.stack_size / 8);\n            }\n            offset = offset + 4;\n        } i = i + 1;\n    }\n}\nwaza emit_frames(bytes: []uint8, spec: ImageSpec, frames: []FrameFunction, layout: Layout) -> unit {\n    kaku pdata = section(layout, 5);\n    kaku xdata = section(layout, 6);\n    kaku text = section(layout, text_section);\n    kaku offset = 0;\n    kaku i = 0;\n    aida (i<len(frames)) {\n        kaku f = frames[i];\n        kaku at = xdata.offset + offset;\n        kaku slots = frame_slots(f);\n        put(bytes, pdata.offset + i * 12, 4, text.rva + f.begin);\n        put(bytes, pdata.offset + i * 12 + 4, 4, text.rva + f.end);\n        put(bytes, pdata.offset + i * 12 + 8, 4, xdata.rva + offset);\n        kaku prolog = f.set_offset;\n        kaku count = 2;\n        moshi (f.alloc_size>0) {\n            prolog = f.alloc_offset;\n            count = 3;\n        }\n        moshi (f.alloc_size>128) {\n            count = 4;\n        }\n        put(bytes, at, 1, 1);\n        put(bytes, at + 1, 1, prolog);\n        put(bytes, at + 2, 1, count);\n        put(bytes, at + 3, 1, 5);\n        kaku c = at + 4;\n        moshi (f.alloc_size>0) {\n            put(bytes, c, 1, f.alloc_offset);\n            moshi (f.alloc_size <= 128) {\n                put(bytes, c + 1, 1, 2 + ((f.alloc_size - 8) / 8) * 16);\n                c = c + 2;\n            }\n            sore {\n                put(bytes, c + 1, 1, 1);\n                put(bytes, c + 2, 2, f.alloc_size / 8);\n                c = c + 4;\n            }\n        }\n        put(bytes, c, 1, f.set_offset);\n        put(bytes, c + 1, 1, 3);\n        c = c + 2;\n        put(bytes, c, 1, f.push_offset);\n        put(bytes, c + 1, 1, 5 * 16);\n        offset = offset + 4 + slots * 2;\n        i = i + 1;\n    }\n}\nwaza directory(bytes: []uint8, index: int64, rva: int64, size: int64) -> unit {\n    put(bytes, 264 + index * 8, 4, rva);\n    put(bytes, 268 + index * 8, 4, size);\n}\n\nkoukai waza executable(spec: ImageSpec) -> ImageResult { kaesu executable_framed(spec, []); }\n\n// Like executable, with unwind data for frame-pointer functions. A spec uses either spec.unwind or frames, not both.\nkoukai waza executable_framed(spec: ImageSpec, frames: []FrameFunction) -> ImageResult { kaesu executable_sized(spec, frames, 1048576); }\n\n// stack_reserve is the PE SizeOfStackReserve of the main thread (a multiple of 65536, at most 1 GiB).\nkoukai waza executable_sized(spec: ImageSpec, frames: []FrameFunction, stack_reserve: int64) -> ImageResult {\n    kaesu executable_placed(spec, frames, stack_reserve, 0);\n}\n\n// data_rva > 0 places .data at that RVA (a multiple of 4096, not below the end of .text/.rdata), so generated code may\n// embed absolute data addresses (image_base + data_rva) as constants. 4096 is special: .data comes first, directly after the\n// headers, so there is no RVA gap and .text follows it. 0 keeps the sequential layout.\nkoukai teisu machine_amd64 = 34404;\nkoukai teisu machine_arm64 = 43620;\nkoukai waza executable_placed(spec: ImageSpec, frames: []FrameFunction, stack_reserve: int64, data_rva: int64) -> ImageResult {\n    kaesu executable_machine(spec, frames, stack_reserve, data_rva, machine_amd64);\n}\n\n// COFF machine type: IMAGE_FILE_MACHINE_AMD64 (0x8664) or IMAGE_FILE_MACHINE_ARM64 (0xAA64). Any other value fails closed.\nkoukai waza executable_machine(spec: ImageSpec, frames: []FrameFunction, stack_reserve: int64, data_rva: int64, machine: int64) -> ImageResult {\n    moshi (machine != machine_amd64 && machine != machine_arm64) { kaesu failure(PEError.InvalidEntry()); }\n    moshi (data_rva<0 || data_rva - (data_rva / 4096) * 4096 != 0 || data_rva>maximum_image_size) { kaesu failure(PEError.InvalidEntry()); }\n    moshi (stack_reserve<65536 || stack_reserve>1073741824 || stack_reserve - (stack_reserve / 65536) * 65536 != 0) {\n        kaesu failure(PEError.ImageTooLarge());\n    }\n    moshi (len(frames)>0 && len(spec.unwind)>0) { kaesu failure(PEError.InvalidUnwind()); }\n    moshi (!valid_frames(frames, len(spec.text))) { kaesu failure(PEError.InvalidUnwind()); }\n    kaku unwind_count = len(spec.unwind) + len(frames);\n    moshi (len(spec.text) == 0) { kaesu failure(PEError.EmptyText()); }\n    moshi (spec.entry<0 || spec.entry >= len(spec.text)) { kaesu failure(PEError.InvalidEntry()); }\n    // Validate bounds before addition/alignment/allocation. Every intermediate\n    // after these checks is far below both signed-int64 and PE DWORD limits.\n    moshi (len(spec.text)>maximum_image_size || len(spec.rdata)>maximum_image_size || len(spec.data)>maximum_image_size || spec.zero_fill<0 || spec.zero_fill>maximum_image_size - len(spec.data)) {\n        kaesu failure(PEError.ImageTooLarge());\n    }\n    moshi (!valid_imports(spec.imports)) { kaesu failure(PEError.InvalidImport()); }\n    moshi (!valid_unwind(spec.unwind, len(spec.text))) { kaesu failure(PEError.InvalidUnwind()); }\n    moshi (len(spec.patches)>4096) { kaesu failure(PEError.InvalidPatch()); }\n    kaku imports = plan_imports(spec.imports);\n    kaku count = 1;\n    kaku has_relocations = iie;\n    kaku i = 0;\n    moshi (len(spec.rdata)>0) { count = count + 1; }\n    moshi (len(spec.data) + spec.zero_fill>0) { count = count + 1; }\n    moshi (imports.size>0) { count = count + 1; }\n    moshi (unwind_count>0) { count = count + 2; }\n    aida (i<len(spec.patches)) {\n        moshi (spec.patches[i].kind == va64) {\n            has_relocations = hai;\n        }\n        i = i + 1;\n    }\n    moshi (has_relocations) { count = count + 1; }\n    kaku headers = align(392 + count * 40, file_alignment);\n    kaku layout = Layout { headers_size: headers, image_size: 4096, file_size: headers, sections: [], iat_rva: 0, iat_size: imports.iat_size };\n    // data_rva == 4096 puts .data FIRST (right after the headers, no RVA gap), so its address is a constant independent of code size.\n    kaku data_first = data_rva == 4096;\n    moshi (data_first && len(spec.data) + spec.zero_fill>0) {\n        kaku first_flags = 3221225536;\n        moshi (len(spec.data) == 0) {\n            first_flags = 3221225600;\n        }\n        layout = add_section(layout, data_section, \".data\", len(spec.data), len(spec.data) + spec.zero_fill, first_flags);\n    }\n    layout = add_section(layout, text_section, \".text\", len(spec.text), len(spec.text), 1610612768);\n    moshi (len(spec.rdata)>0) { layout = add_section(layout, rdata_section, \".rdata\", len(spec.rdata), len(spec.rdata), 1073741888); }\n    moshi (!data_first && len(spec.data) + spec.zero_fill>0) {\n        moshi (data_rva>0 && data_rva<layout.image_size) { kaesu failure(PEError.ImageTooLarge()); }\n        moshi (data_rva>0) {\n            layout = Layout {\n                headers_size: layout.headers_size, image_size: data_rva, file_size: layout.file_size, sections: layout.sections, iat_rva: layout.iat_rva, iat_size: layout.iat_size };\n        }\n        kaku flags = 3221225536;\n        moshi (len(spec.data) == 0) {\n            flags = 3221225600;\n        }\n        layout = add_section(layout, data_section, \".data\", len(spec.data), len(spec.data) + spec.zero_fill, flags);\n    }\n    moshi (imports.size>0) {\n        layout = add_section(layout, import_section, \".idata\", imports.size, imports.size, 3221225536);\n        layout = Layout {\n            headers_size: layout.headers_size, image_size: layout.image_size, file_size: layout.file_size, sections: layout.sections, iat_rva: section(layout, import_section).rva + imports.iat, iat_size: imports.iat_size };\n    }\n    moshi (unwind_count>0) {\n        kaku xsize = unwind_size(spec.unwind) + frame_size(frames);\n        layout = add_section(layout, 5, \".pdata\", unwind_count * 12, unwind_count * 12, 1073741888);\n        layout = add_section(layout, 6, \".xdata\", xsize, xsize, 1073741888);\n    }\n    moshi (!valid_patches(spec, layout, imports)) { kaesu failure(PEError.InvalidPatch()); }\n    kaku relocations = relocation_bytes(spec, layout);\n    moshi (has_relocations) { layout = add_section(layout, 7, \".reloc\", len(relocations), len(relocations), 1107296320); }\n    moshi (layout.file_size>maximum_image_size || layout.image_size>maximum_image_size) { kaesu failure(PEError.ImageTooLarge()); }\n    kaku bytes = array.make[uint8](layout.file_size, uint8(0));\n    // DOS header and a real DOS exit stub, PE signature, COFF header.\n    put(bytes, 0, 2, 23117);\n    put(bytes, 2, 2, 128);\n    put(bytes, 4, 2, 1);\n    put(bytes, 8, 2, 4);\n    put(bytes, 10, 2, 16);\n    put(bytes, 12, 2, 65535);\n    put(bytes, 16, 2, 256);\n    put(bytes, 24, 2, 64);\n    put(bytes, 60, 4, 128);\n    copy_bytes(bytes, 64, [184, 1, 76, 205, 33]);\n    put(bytes, 128, 4, 17744);\n    put(bytes, 132, 2, machine);\n    put(bytes, 134, 2, count);\n    put(bytes, 148, 2, 240);\n    kaku characteristics = 35;\n    moshi (has_relocations) {\n        characteristics = 34;\n    }\n    put(bytes, 150, 2, characteristics);\n    kaku text = section(layout, text_section);\n    kaku initialized = 0;\n    kaku uninitialized = 0;\n    i = 0;\n    aida (i<len(layout.sections)) {\n        kaku s = layout.sections[i];\n        moshi (s.kind != text_section) {\n            initialized = initialized + s.raw_size;\n        }\n        moshi (s.virtual_size>s.raw_size) {\n            uninitialized = uninitialized + s.virtual_size - s.raw_size;\n        }\n        i = i + 1;\n    }\n    put(bytes, 152, 2, 523);\n    put(bytes, 156, 4, text.raw_size);\n    put(bytes, 160, 4, initialized);\n    put(bytes, 164, 4, uninitialized);\n    put(bytes, 168, 4, text.rva + spec.entry);\n    put(bytes, 172, 4, text.rva);\n    put(bytes, 176, 8, image_base);\n    put(bytes, 184, 4, section_alignment);\n    put(bytes, 188, 4, file_alignment);\n    put(bytes, 192, 2, 6);\n    put(bytes, 200, 2, 6);\n    put(bytes, 208, 4, layout.image_size);\n    put(bytes, 212, 4, headers);\n    put(bytes, 220, 2, 3);\n    kaku dll_flags = 256;\n    moshi (has_relocations) {\n        dll_flags = 352;\n    }\n    put(bytes, 222, 2, dll_flags);\n    put(bytes, 224, 8, stack_reserve);\n    put(bytes, 232, 8, 4096);\n    put(bytes, 240, 8, 1048576);\n    put(bytes, 248, 8, 4096);\n    put(bytes, 260, 4, 16);\n    moshi (imports.size>0) {\n        directory(bytes, 1, section(layout, import_section).rva, (len(spec.imports) + 1) * 20);\n        directory(bytes, 12, layout.iat_rva, layout.iat_size);\n    }\n    moshi (unwind_count>0) { directory(bytes, 3, section(layout, 5).rva, unwind_count * 12); }\n    moshi (has_relocations) { directory(bytes, 5, section(layout, 7).rva, len(relocations)); }\n    i = 0; aida (i<len(layout.sections)) {\n        kaku s = layout.sections[i];\n        kaku at = 392 + i * 40;\n        copy_bytes(bytes, at, string.to_bytes(s.name));\n        put(bytes, at + 8, 4, s.virtual_size);\n        put(bytes, at + 12, 4, s.rva);\n        put(bytes, at + 16, 4, s.raw_size);\n        put(bytes, at + 20, 4, s.offset);\n        put(bytes, at + 36, 4, s.flags);\n        i = i + 1;\n    }\n    copy_bytes(bytes, text.offset, spec.text);\n    moshi (len(spec.rdata)>0) { copy_bytes(bytes, section(layout, rdata_section).offset, spec.rdata); }\n    moshi (len(spec.data)>0) { copy_bytes(bytes, section(layout, data_section).offset, spec.data); }\n    emit_imports(bytes, spec, layout, imports);\n    emit_unwind(bytes, spec, layout);\n    emit_frames(bytes, spec, frames, layout);\n    moshi (has_relocations) { copy_bytes(bytes, section(layout, 7).offset, relocations); }\n    i = 0; aida (i<len(spec.patches)) {\n        kaku p = spec.patches[i];\n        kaku source = section(layout, p.section);\n        kaku value = patch_target(p, layout, imports);\n        kaku width = 4;\n        moshi (p.kind == va64) {\n            width = 8;\n            value = image_base + value;\n        }\n        moshi (p.kind == rel32) {\n            value = value - (source.rva + p.offset + 4);\n            moshi (value<0) {\n                value = value + 4294967296;\n            }\n        }\n        put(bytes, source.offset + p.offset, width, value);\n        i = i + 1;\n    }\n    kaesu ImageResult { bytes: bytes, layout: layout, error: mu };\n}\n" }; }
waza data_63() -> File { kaesu File { path: "kiso/aot/sign/sign.mio", version: "Bunko-v2.1.1", length: 6620, sha256: "fbe6f23dca191789033c6fd8df81ccf0ae18eaa18dd6a6261d811b0bd2c15e5c", source: "yobu \"kiso/array\";\nyobu \"kiso/crypto/sha256\";\n\nkoukai kata SignResult {\n    bytes: []uint8;\n    error: string;\n}\nwaza failure(message: string) -> SignResult { kaesu SignResult { bytes: [], error: message }; }\nwaza read32(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset]) + int64(data[offset + 1]) * 256 + int64(data[offset + 2]) * 65536 + int64(data[offset + 3]) * 16777216;\n}\nwaza write32(data: []uint8, offset: int64, value: int64, big: bool) -> unit {\n    kaku left = value;\n    kaku at = 0;\n    aida (at < 4) {\n        kaku position = offset + at;\n        moshi (big) {\n            position = offset + 3 - at;\n        }\n        data[position] = uint8(left - (left / 256) * 256);\n        left = left / 256;\n        at = at + 1;\n    }\n}\nwaza align(value: int64, boundary: int64) -> int64 { kaesu ((value + boundary - 1) / boundary) * boundary; }\n\n// Deterministic local ad-hoc signature for our relocation-free ARM64 images.\n// No identity, certificate, entitlement or notarization is claimed. Every code\n// page hash covers the final header and final LC_CODE_SIGNATURE/__LINKEDIT.\nkoukai waza adhoc(image: []uint8) -> SignResult { kaesu sign_image(image, 2, iie); }\n// Explicit dynamic-image path: preserves an existing dyld binding payload.\nkoukai waza adhoc_linked(image: []uint8) -> SignResult { kaesu sign_image(image, 2, hai); }\nkoukai waza adhoc_dylib(image: []uint8) -> SignResult { kaesu sign_image(image, 6, hai); }\nwaza sign_image(image: []uint8, kind: int64, linked: bool) -> SignResult {\n    moshi (len(image) < 768 || len(image) > 67108864 || len(image) != align(len(image), 16)) {\n        kaesu failure(\"invalid unsigned image length\");\n    }\n    moshi (read32(image, 0) != 4277009103 || read32(image, 4) != 16777228 || read32(image, 12) != kind) {\n        kaesu failure(\"unexpected ARM64 Mach-O image type\");\n    }\n    kaku count = read32(image, 16);\n    kaku command_bytes = read32(image, 20);\n    moshi (count < 1 || count > 32 || command_bytes > 720 || 32 + command_bytes + 16 > 768) { kaesu failure(\"invalid load commands\"); }\n    kaku linkedit = -1;\n    kaku payload_size = 0;\n    kaku text_limit = 0;\n    kaku at = 32;\n    kaku index = 0;\n    aida (index < count) {\n        moshi (at + 8 > 32 + command_bytes) { kaesu failure(\"truncated load command\"); }\n        kaku command = read32(image, at);\n        kaku size = read32(image, at + 4);\n        moshi (size < 8 || at + size > 32 + command_bytes || size != align(size, 8)) { kaesu failure(\"invalid load command size\"); }\n        moshi (command == 29) { kaesu failure(\"image is already signed\"); }\n        moshi (command == 25 && size >= 72) {\n            // Exact segment names, including the NUL padding.\n            kaku name: []uint8 = [95, 95, 76, 73, 78, 75, 69, 68, 73, 84, 0, 0, 0, 0, 0, 0];\n            kaku equal = hai;\n            kaku ni = 0;\n            aida (ni < 16) {\n                moshi (image[at + 8 + ni] != name[ni]) {\n                    equal = iie;\n                }\n                ni = ni + 1;\n            }\n            moshi (equal) {\n                kaku offset = read32(image, at + 40);\n                kaku size = read32(image, at + 48);\n                moshi (linkedit >= 0 || read32(image, at + 44) != 0 || read32(image, at + 52) != 0 ||\n                    offset > len(image) || size != len(image) - offset || (!linked && size != 0)) {\n                    kaesu failure(\"unexpected LINKEDIT layout\");\n                }\n                payload_size = size;\n                linkedit = at;\n            }\n            moshi (image[at + 8] == uint8(95) && image[at + 9] == uint8(95) && image[at + 10] == uint8(84) && image[at + 11] == uint8(69) && image[at + 12] == uint8(88) && image[at + 13] == uint8(84) && image[at + 14] == uint8(0)) {\n                text_limit = read32(image, at + 48);\n            }\n        }\n        at = at + size;\n        index = index + 1;\n    }\n    moshi (at != 32 + command_bytes || linkedit < 0 || text_limit < 768 || text_limit > len(image)) {\n        kaesu failure(\"missing canonical image segments\");\n    }\n    // SuperBlob(20), CodeDirectory v0x20400(88), identifier \"mio\\0\"(4),\n    // SHA256 code slots. No special slots or CMS are needed for ad-hoc.\n    kaku slots = (len(image) + 4095) / 4096;\n    kaku directory_size = 92 + slots * 32;\n    kaku blob_size = 20 + directory_size;\n    kaku signature_size = align(blob_size, 16);\n    kaku output = array.with_capacity[uint8](len(image) + signature_size);\n    array.append_all(output, image);\n    kaku pad = 0;\n    aida (pad < signature_size) {\n        array.push(output, uint8(0));\n        pad = pad + 1;\n    }\n    write32(output, 16, count + 1, iie);\n    write32(output, 20, command_bytes + 16, iie);\n    write32(output, at, 29, iie);\n    write32(output, at + 4, 16, iie);\n    write32(output, at + 8, len(image), iie);\n    write32(output, at + 12, signature_size, iie);\n    write32(output, linkedit + 32, align(payload_size + signature_size, 16384), iie);\n    write32(output, linkedit + 36, 0, iie);\n    write32(output, linkedit + 48, payload_size + signature_size, iie);\n    write32(output, linkedit + 52, 0, iie);\n    kaku base = len(image);\n    write32(output, base, 4208856256, hai);\n    write32(output, base + 4, blob_size, hai);\n    write32(output, base + 8, 1, hai);\n    write32(output, base + 12, 0, hai);\n    write32(output, base + 16, 20, hai);\n    kaku cd = base + 20;\n    write32(output, cd, 4208856066, hai);\n    write32(output, cd + 4, directory_size, hai);\n    write32(output, cd + 8, 132096, hai);\n    write32(output, cd + 12, 2, hai);\n    write32(output, cd + 16, 92, hai);\n    write32(output, cd + 20, 88, hai);\n    write32(output, cd + 28, slots, hai);\n    write32(output, cd + 32, len(image), hai);\n    output[cd + 36] = uint8(32);\n    output[cd + 37] = uint8(2);\n    output[cd + 39] = uint8(12);\n    write32(output, cd + 76, text_limit, hai);\n    moshi (kind == 2) { write32(output, cd + 84, 1, hai); }\n    output[cd + 88] = uint8(109);\n    output[cd + 89] = uint8(105);\n    output[cd + 90] = uint8(111);\n    kaku ctx = sha256.context();\n    index = 0;\n    aida (index < slots) {\n        kaku length = 4096;\n        moshi ((index + 1) * 4096 > len(image)) {\n            length = len(image) - index * 4096;\n        }\n        kaku hash = sha256.sum_range(ctx, output, index * 4096, length);\n        moshi (len(hash) != 32) { kaesu failure(\"page hashing failed\"); }\n        kaku hi = 0;\n        aida (hi < 32) {\n            output[cd + 92 + index * 32 + hi] = hash[hi];\n            hi = hi + 1;\n        }\n        index = index + 1;\n    }\n    kaesu SignResult { bytes: output, error: \"\" };\n}\n" }; }
waza data_64() -> File { kaesu File { path: "kiso/aot/win64abi/bridge.mio", version: "Bunko-v2.1.1", length: 10075, sha256: "3a197e1f58ebfc5950ca8926c814d9f5c03d5739f1d21d67bc51fae6f97aff8a", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/encoding/win64c\";\nyobu \"kiso/aot/pe\";\nyobu \"kiso/aot/x86_64\";\n\nkoukai kata ImportPlan { libraries: []pe.ImportLibrary; slots: []int64; runtime_slots: []int64; error: string; }\n\nwaza plan_failure(plan: ImportPlan, error: string) -> ImportPlan { kaesu ImportPlan { libraries: plan.libraries, slots: plan.slots, runtime_slots: plan.runtime_slots, error: error }; }\n\n// Windows DLL 名按不区分大小写匹配，保留实际输入拼写；导出名始终区分大小写。\nwaza dll_key(name: string) -> string {\n    kaesu win64c.dll_identity(name);\n}\nwaza import_parts(name: string) -> []string {\n    kaku p = win64c.parts(name);\n    moshi (dll_key(p[1]) == \"mio.dynamic.dll\") { p[1] = \"mio_native_ffi.dll\"; p[2] = \"mio_ffi_dispatch\"; }\n    kaesu p;\n}\nwaza less(a: string, b: string) -> bool {\n    kaku x = string.to_bytes(a); kaku y = string.to_bytes(b); kaku i = 0;\n    aida (i < len(x) && i < len(y)) { moshi (x[i] != y[i]) { kaesu x[i] < y[i]; } i = i + 1; }\n    kaesu len(x) < len(y);\n}\n// 保留既有 Runtime IAT 索引，将外部函数按 DLL/导出名排序后合并，避免编译顺序影响布局。\n// 所有声明都校验原型，只有可达声明进入 IAT；同一导出的冲突原型拒绝生成镜像。\nkoukai waza imports(file: mochi.File, reached: []bool, base: []pe.ImportLibrary) -> ImportPlan {\n    kaku original: []pe.ImportLibrary = []; kaku bi = 0;\n    // 保存合并前的符号数，防止新增 KERNEL32 符号移动 Winsock 的 IAT 槽。\n    aida (bi < len(base)) { array.push(original, pe.ImportLibrary { name: base[bi].name, symbols: array.clone(base[bi].symbols) }); bi = bi + 1; }\n    kaku plan = ImportPlan { libraries: base, slots: array.make[int64](len(file.functions), -1), runtime_slots: [], error: \"\" };\n    kaku order: []int64 = []; kaku i = 0;\n    aida (i < len(file.functions)) {\n        kaku f = file.functions[i];\n        moshi (win64c.is_external(f.name)) {\n            kaku problem = win64c.validate(f.name, f.parameter_count, f.returns_value);\n            moshi (problem != \"\") { kaesu plan_failure(plan, problem); }\n            moshi (len(f.instructions) != 0 || len(f.captures) != 0 || f.local_count != f.parameter_count) { kaesu plan_failure(plan, \"E_FFI_PROTOTYPE invalid C stub layout\"); }\n            kaku p = win64c.parts(f.name); kaku j = 0;\n            aida (j < i) {\n                moshi (win64c.is_external(file.functions[j].name)) {\n                    moshi (win64c.conflicts(f.name, file.functions[j].name)) { kaesu plan_failure(plan, \"E_FFI_PROTOTYPE conflicting C export prototypes\"); }\n                }\n                j = j + 1;\n            }\n            moshi (reached[i]) {\n                array.push(order, i); kaku at = len(order) - 1;\n                kaku key = string.concat(dll_key(p[1]), string.concat(\"|\", f.name));\n                aida (at > 0) {\n                    kaku previous = win64c.parts(file.functions[order[at - 1]].name);\n                    kaku other = string.concat(dll_key(previous[1]), string.concat(\"|\", file.functions[order[at - 1]].name));\n                    moshi (!less(key, other)) { nukeru; }\n                    order[at] = order[at - 1]; at = at - 1;\n                }\n                order[at] = i;\n            }\n        }\n        i = i + 1;\n    }\n    i = 0;\n    aida (i < len(order)) {\n        kaku id = order[i]; kaku p = import_parts(file.functions[id].name); kaku lib = 0;\n        aida (lib < len(plan.libraries) && dll_key(plan.libraries[lib].name) != dll_key(p[1])) { lib = lib + 1; }\n        moshi (lib == len(plan.libraries)) { array.push(plan.libraries, pe.ImportLibrary { name: p[1], symbols: [] }); }\n        kaku symbols = plan.libraries[lib].symbols; kaku symbol = 0;\n        aida (symbol < len(symbols) && symbols[symbol] != p[2]) { symbol = symbol + 1; }\n        moshi (symbol == len(symbols)) { array.push(symbols, p[2]); plan.libraries[lib] = pe.ImportLibrary { name: plan.libraries[lib].name, symbols: symbols }; }\n        i = i + 1;\n    }\n    // 新符号可能插入已有 Runtime DLL，所以必须在完成合并后统一计算扁平 IAT 索引。\n    i = 0;\n    aida (i < len(order)) {\n        kaku id = order[i]; kaku p = import_parts(file.functions[id].name); kaku lib = 0; kaku slot = 0;\n        aida (lib < len(plan.libraries)) {\n            kaku symbols = plan.libraries[lib].symbols; kaku j = 0;\n            aida (j < len(symbols)) { moshi (dll_key(plan.libraries[lib].name) == dll_key(p[1]) && symbols[j] == p[2]) { plan.slots[id] = slot + j; } j = j + 1; }\n            slot = slot + len(symbols); lib = lib + 1;\n        }\n        i = i + 1;\n    }\n    bi = 0; kaku offset = 0;\n    aida (bi < len(original)) {\n        kaku j = 0; aida (j < len(original[bi].symbols)) { array.push(plan.runtime_slots, offset + j); j = j + 1; }\n        offset = offset + len(plan.libraries[bi].symbols); bi = bi + 1;\n    }\n    kaesu plan;\n}\n\n// 负索引仅作本 lowering 的外部补丁标记，在交给 PE Writer 前消解。\nkoukai waza patch_imports(plan: ImportPlan, patches: []pe.Patch) -> unit {\n    kaku i = 0;\n    aida (i < len(patches)) {\n        kaku p = patches[i];\n        moshi (p.target == pe.import_section) {\n            kaku slot = p.target_offset;\n            moshi (slot < 0) { slot = -slot - 1; } sore { slot = plan.runtime_slots[slot]; }\n            patches[i] = pe.Patch { section: p.section, offset: p.offset, kind: p.kind, target: p.target, target_offset: slot };\n        }\n        i = i + 1;\n    }\n}\n\nwaza normalize(code: x86_64.Assembler, name: string) -> unit {\n    kaku bits = 64; kaku signed = iie;\n    moshi (name == \"int8\" || name == \"uint8\") { bits = 8; }\n    moshi (name == \"int16\" || name == \"uint16\") { bits = 16; }\n    moshi (name == \"int32\" || name == \"uint32\") { bits = 32; }\n    signed = name == \"int8\" || name == \"int16\" || name == \"int32\";\n    moshi (bits < 64) {\n        x86_64.shl_ri(code, x86_64.rax, 64 - bits);\n        moshi (signed) { x86_64.sar_ri(code, x86_64.rax, 64 - bits); } sore { x86_64.shr_ri(code, x86_64.rax, 64 - bits); }\n    }\n}\n\n// Mio 的参数在操作数栈上，C 则使用按位置编号的 GPR/XMM 与 32 字节 Shadow Space。\n// 这不是 System V：RDI/RSI 在 Win64 必须保留；此桥只写 volatile 寄存器与已保存的 RBP。\n// 活跃 Mio 值留在调用者栈/局部槽，C 不可回调或获得 GC 地址，因此不会改变根链。\nwaza call_import(code: x86_64.Assembler, patches: []pe.Patch, slot: int64) -> unit {\n    x86_64.byte(code, 255); x86_64.byte(code, 21); kaku at = len(code.bytes);\n    x86_64.byte(code, 0); x86_64.byte(code, 0); x86_64.byte(code, 0); x86_64.byte(code, 0);\n    array.push(patches, pe.Patch { section: pe.text_section, offset: at, kind: pe.rel32, target: pe.import_section, target_offset: -slot - 1 });\n}\nkoukai waza emit(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction, f: mochi.Function, label: string, slot: int64) -> unit {\n    kaku p = win64c.parts(f.name); kaku count = f.parameter_count;\n    kaku dynamic = dll_key(p[1]) == \"mio.dynamic.dll\";\n    kaku skip = 0; moshi (dynamic) { skip = 1; }\n    kaku native_count = count - skip;\n    x86_64.label(code, label); kaku begin = len(code.bytes);\n    x86_64.push_r(code, x86_64.rbp); x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    // 操作数深度可为奇数，不能假设进入此桥时已按 C ABI 对齐。\n    // RBP 是展开锚点，后续动态对齐不计入固定 ALLOC，也不伪造栈分配展开码。\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    kaku area = 32; moshi (native_count > 4) { area = area + (native_count - 4) * 8; }\n    area = ((area + 15) / 16) * 16;\n    // Two private slots after outgoing arguments hold target and result.\n    kaku private_slot = area; moshi (dynamic) { area = area + 16; }\n    x86_64.sub_ri(code, x86_64.rsp, area);\n    moshi (dynamic) {\n        kaku parameters: []string = []; kaku j = 5;\n        aida (j < len(p)) { array.push(parameters, p[j]); j = j + 1; }\n        x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, 16 + (count - 1) * 8);\n        x86_64.mov_ri(code, x86_64.rdx, win64c.native_signature(p[3], parameters));\n        x86_64.mov_ri(code, x86_64.r8, 0); call_import(code, patches, slot);\n        x86_64.mov_store(code, x86_64.rsp, private_slot, x86_64.rax);\n    }\n    kaku registers: []int64 = [x86_64.rcx, x86_64.rdx, x86_64.r8, x86_64.r9]; kaku i = 0;\n    aida (i < native_count) {\n        x86_64.mov_load(code, x86_64.rax, x86_64.rbp, 16 + (count - 1 - i - skip) * 8); normalize(code, p[4 + i + skip]);\n        moshi (i < 4) {\n            // 浮点寄存器编号由参数位置决定，不能分别计数整数和浮点参数。\n            moshi (p[4 + i + skip] == \"float32\") { x86_64.movd_xmm_r(code, i, x86_64.rax); }\n            sore { moshi (p[4 + i + skip] == \"float64\") { x86_64.movq_xmm_r(code, i, x86_64.rax); }\n                sore { x86_64.mov_rr(code, registers[i], x86_64.rax); } }\n        } sore { x86_64.mov_store(code, x86_64.rsp, 32 + (i - 4) * 8, x86_64.rax); }\n        i = i + 1;\n    }\n    moshi (dynamic) {\n        x86_64.mov_load(code, x86_64.r11, x86_64.rsp, private_slot); x86_64.call_r(code, x86_64.r11);\n    } sore { call_import(code, patches, slot); }\n    moshi (p[3] == \"float32\") { x86_64.movd_r_xmm(code, x86_64.rax, 0); }\n    sore { moshi (p[3] == \"float64\") { x86_64.movq_r_xmm(code, x86_64.rax, 0); }\n        sore { moshi (p[3] != \"unit\") { normalize(code, p[3]); } } }\n    moshi (dynamic) {\n        x86_64.mov_store(code, x86_64.rsp, private_slot + 8, x86_64.rax);\n        x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, 16 + (count - 1) * 8);\n        x86_64.mov_ri(code, x86_64.rdx, 0); x86_64.mov_ri(code, x86_64.r8, 1); call_import(code, patches, slot);\n        x86_64.mov_load(code, x86_64.rax, x86_64.rsp, private_slot + 8);\n    }\n    x86_64.lea(code, x86_64.rsp, x86_64.rbp, 0); x86_64.pop_r(code, x86_64.rbp); x86_64.ret(code);\n    array.push(frames, pe.FrameFunction { begin: begin, end: len(code.bytes), push_offset: 1, set_offset: 4, alloc_offset: 0, alloc_size: 0 });\n}\n" }; }
waza data_65() -> File { kaesu File { path: "kiso/aot/winarm64/winarm64.mio", version: "Bunko-v2.1.1", length: 7715, sha256: "d6acefac0b976874431824f10f1c7000f1e3118cd4944995e51094c9c32e875e", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/aot/pe\";\nyobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// PE32+ (IMAGE_FILE_MACHINE_ARM64, 0xAA64) packaging for the lowered Windows ARM64 words (kiso/aot/lower,\n// compile_windows_arm64). Layout from kiso/aot/pe: `.data` first at RVA 0x1000 (zero-fill, the program's globals), then\n// `.text`, `.rdata` (constants), `.idata` (imports; the loader fills the IAT) and `.reloc`. The preferred image base is\n// 0x140000000; the image is ASLR-capable (see build) and the code is PC-relative, so it needs no relocation of its own:\n// ADRP/ADD patches are resolved here from the final section RVAs.\n//\n// AddressPatch.target kinds: 0 text (byte offset), 1 constants (.rdata), 2 globals (.data), 3 IAT slot (offset = flattened\n// import index * 8). The generated code uses no structured exception handling and no unwinding, so the image carries no\n// .pdata/.xdata; Win32 calls are plain leaf-style AAPCS64 calls made through the IAT.\nteisu stack_reserve = 67108864;\nteisu data_rva = 4096;\n\nkoukai kata ImageResult {\n    bytes: []uint8;\n    error: string;\n}\nwaza failed(message: string) -> ImageResult { kaesu ImageResult { bytes: [], error: message }; }\n\n// Code word of the label `windows_start` (the PE entry routine emitted by lower.compile_windows_arm64), or -1.\nkoukai waza start_word(labels: []arm64.Label) -> int64 {\n    kaku at = 0;\n    aida (at < len(labels)) {\n        moshi (labels[at].name == \"windows_start\") {\n            kaesu labels[at].word;\n        }\n        at = at + 1;\n    }\n    kaesu -1;\n}\n\nwaza push_word(out: []uint8, word: uint32) -> unit {\n    kaku value = int64(word);\n    kaku i = 0;\n    aida (i < 4) {\n        array.push(out, uint8(value - (value / 256) * 256));\n        value = value / 256;\n        i = i + 1;\n    }\n}\n\n// imports: pairs (library, symbol), grouped by library, in IAT order.\nwaza libraries(imports: []string) -> []pe.ImportLibrary {\n    kaku result: []pe.ImportLibrary = [];\n    kaku at = 0;\n    aida (at + 1 < len(imports)) {\n        kaku last = len(result) - 1;\n        moshi (last >= 0 && result[last].name == imports[at]) { array.push(result[last].symbols, imports[at + 1]); }\n        sore { array.push(result, pe.ImportLibrary { name: imports[at], symbols: [imports[at + 1]] }); }\n        at = at + 2;\n    }\n    kaesu result;\n}\n\n// IAT slot of flattened import `index` (each library's IAT ends with a zero entry).\nwaza iat_slot(imports: []string, iat_rva: int64, index: int64) -> int64 {\n    kaku libs = 0;\n    kaku at = 0;\n    kaku previous = \"\";\n    aida (at / 2 <= index) {\n        moshi (imports[at] != previous) {\n            libs = libs + 1;\n            previous = imports[at];\n        }\n        at = at + 2;\n    }\n    kaesu iat_rva + (index + libs - 1) * 8;\n}\n\nwaza section_rva(layout: pe.Layout, kind: int64) -> int64 {\n    kaku at = 0;\n    aida (at < len(layout.sections)) {\n        moshi (layout.sections[at].kind == kind) {\n            kaesu layout.sections[at].rva;\n        }\n        at = at + 1;\n    }\n    kaesu -1;\n}\n\n// Windows on ARM64 only runs ASLR-capable images (IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE with a base-relocation table).\n// The generated code is entirely PC-relative (ADRP/ADD; the loader fills the IAT), so it is position independent and the\n// image may be relocated freely. pe.executable emits DYNAMIC_BASE and a .reloc section as soon as one DIR64 relocation\n// exists; that relocation covers an unused, zero-initialised 8-byte slot appended to .rdata, which no code ever reads.\nwaza build(words: []uint32, constants: []uint8, globals: int64, entry_word: int64, imports: []string) -> pe.ImageResult {\n    kaku text: []uint8 = array.with_capacity[uint8](len(words) * 4);\n    kaku i = 0;\n    aida (i < len(words)) {\n        push_word(text, words[i]);\n        i = i + 1;\n    }\n    kaku rdata = array.clone(constants);\n    aida (len(rdata) - (len(rdata) / 8) * 8 != 0) { array.push(rdata, uint8(0)); }\n    kaku slot = len(rdata);\n    i = 0;\n    aida (i < 8) {\n        array.push(rdata, uint8(0));\n        i = i + 1;\n    }\n    kaku relocation = pe.Patch { section: pe.rdata_section, offset: slot, kind: pe.va64, target: pe.text_section, target_offset: 0 };\n    kaesu pe.executable_machine(pe.ImageSpec { text: text, rdata: rdata, data: [], zero_fill: globals * 8, entry: entry_word * 4,\n            imports: libraries(imports), patches: [relocation], unwind: [] }, [], stack_reserve, data_rva, pe.machine_arm64);\n}\n\nkoukai waza image(spec: macho.ImageSpec, entry_word: int64, imports: []string) -> ImageResult {\n    moshi (len(spec.words) == 0) { kaesu failed(\"EMPTY_TEXT\"); }\n    moshi (entry_word < 0 || entry_word >= len(spec.words)) { kaesu failed(\"INVALID_ENTRY\"); }\n    moshi (spec.globals < 0 || spec.globals > 10244) { kaesu failed(\"TOO_MANY_GLOBALS\"); }\n    moshi (len(imports) == 0 || len(imports) - (len(imports) / 2) * 2 != 0) { kaesu failed(\"INVALID_IMPORTS\"); }\n    // pass 1 fixes the section RVAs (they depend only on sizes); pass 2 carries the patched words\n    kaku first = build(spec.words, spec.constants, spec.globals, entry_word, imports);\n    moshi (first.error != mu) { kaesu failed(\"PE_LAYOUT\"); }\n    kaku layout = first.layout;\n    kaku base = pe.image_base;\n    kaku text_rva = section_rva(layout, pe.text_section);\n    kaku words = array.clone(spec.words);\n    kaku index = 0;\n    aida (index < len(spec.patches)) {\n        kaku patch = spec.patches[index];\n        moshi (patch.at_word < 0 || patch.at_word >= len(words) || patch.target_offset < 0 || patch.target.kind < 0 || patch.target.kind > 3) {\n            kaesu failed(\"INVALID_PATCH\");\n        }\n        kaku target = 0;\n        moshi (patch.target.kind == 0) {\n            moshi (patch.target_offset >= len(words) * 4) { kaesu failed(\"INVALID_PATCH\"); }\n            target = base + text_rva + patch.target_offset;\n        }\n        moshi (patch.target.kind == 1) {\n            moshi (patch.target_offset >= len(spec.constants) || section_rva(layout, pe.rdata_section) < 0) {\n                kaesu failed(\"INVALID_PATCH\");\n            }\n            target = base + section_rva(layout, pe.rdata_section) + patch.target_offset;\n        }\n        moshi (patch.target.kind == 2) {\n            moshi (patch.target_offset >= spec.globals * 8 || section_rva(layout, pe.data_section) < 0) { kaesu failed(\"INVALID_PATCH\"); }\n            target = base + section_rva(layout, pe.data_section) + patch.target_offset;\n        }\n        moshi (patch.target.kind == 3) {\n            kaku slot = patch.target_offset / 8;\n            moshi (patch.target_offset - slot * 8 != 0 || slot >= len(imports) / 2) { kaesu failed(\"INVALID_PATCH\"); }\n            target = base + iat_slot(imports, layout.iat_rva, slot);\n        }\n        kaku encoded = arm64.adrp_offset(patch.register, base + text_rva + patch.at_word * 4, target);\n        moshi (encoded.error != mu) { kaesu failed(\"ENCODE\"); }\n        words[patch.at_word] = encoded.word;\n        moshi (patch.add_at_word >= 0) {\n            moshi (patch.add_at_word >= len(words) || patch.add_at_word == patch.at_word) { kaesu failed(\"INVALID_PATCH\"); }\n            kaku addition = arm64.add_imm_x(patch.register, patch.register, target - (target / 4096) * 4096, iie);\n            moshi (addition.error != mu) { kaesu failed(\"ENCODE\"); }\n            words[patch.add_at_word] = addition.word;\n        }\n        index = index + 1;\n    }\n    kaku second = build(words, spec.constants, spec.globals, entry_word, imports);\n    moshi (second.error != mu) { kaesu failed(\"PE_LAYOUT\"); }\n    moshi (second.layout.image_size != layout.image_size || second.layout.iat_rva != layout.iat_rva) { kaesu failed(\"LAYOUT_CHANGED\"); }\n    kaesu ImageResult { bytes: second.bytes, error: \"\" };\n}\n" }; }
waza data_66() -> File { kaesu File { path: "kiso/aot/winconsole/winconsole.mio", version: "Bunko-v2.1.1", length: 5302, sha256: "3077ff95d7bf063921235c2681b41a935b43bd990244b0a40faed5148c09b42f", source: "yobu \"kiso/aot/x86_64\";\nyobu \"kiso/aot/pe\";\nyobu \"kiso/array\";\n\n// Bounded Windows console image generator, not source-language lowering.\nkoukai teisu io_failure_exit = 111;\nkoukai teisu maximum_message_size = 1048576;\nkoukai kata BuildResult {\n    bytes: []uint8;\n    error: string;\n}\n\nwaza failure(message: string) -> BuildResult { kaesu BuildResult { bytes: [], error: message }; }\nwaza import_call(code: x86_64.Assembler, patches: []pe.Patch, index: int64) -> unit {\n    kaku at = len(code.bytes);\n    x86_64.mov_ri(code, x86_64.r11, 0);\n    array.push(patches, pe.Patch { section: pe.text_section, offset: at + 2, kind: pe.va64, target: pe.import_section, target_offset: index });\n    x86_64.call_memory(code, x86_64.r11, 0);\n}\nwaza finish(code: x86_64.Assembler, patches: []pe.Patch, message: []uint8, symbols: []string, stack: int64, prolog: int64) -> BuildResult {\n    kaku assembled = x86_64.assemble(code);\n    moshi (assembled.error != \"\") { kaesu failure(assembled.error); }\n    kaku image = pe.executable(pe.ImageSpec { text: assembled.bytes, rdata: message, data: [], zero_fill: 0, entry: 0,\n            imports: [pe.ImportLibrary { name: \"KERNEL32.dll\", symbols: symbols }], patches: patches,\n            unwind: [pe.UnwindFunction { begin: 0, end: len(assembled.bytes), prolog_size: prolog, stack_size: stack, stack_offset: prolog }] });\n    moshi (image.error != mu) { kaesu failure(\"PE_IMAGE_ERROR\"); }\n    kaesu BuildResult { bytes: image.bytes, error: \"\" };\n}\n\nkoukai waza exit_executable(exit_code: int64) -> BuildResult {\n    moshi (exit_code<0 || exit_code>255) { kaesu failure(\"INVALID_EXIT_CODE\"); }\n    kaku code = x86_64.assembler();\n    kaku patches: []pe.Patch = [];\n    // Entry RSP is 8 mod 16. 32-byte outgoing shadow space + alignment.\n    x86_64.sub_ri(code, x86_64.rsp, 40);\n    kaku prolog = len(code.bytes);\n    x86_64.mov_ri(code, x86_64.rcx, exit_code);\n    import_call(code, patches, 0);\n    // ExitProcess does not return; retain a valid epilog if it ever does.\n    x86_64.add_ri(code, x86_64.rsp, 40);\n    x86_64.ret(code);\n    kaesu finish(code, patches, [], [\"ExitProcess\"], 40, prolog);\n}\n\n// Synchronous inherited stdout only; output is bytes, without encoding/newline conversion.\n// Uses volatile registers exclusively; state survives API calls in local stack slots.\nkoukai waza stdout_executable(message: []uint8, exit_code: int64) -> BuildResult {\n    moshi (exit_code<0 || exit_code>255) { kaesu failure(\"INVALID_EXIT_CODE\"); }\n    moshi (len(message)>maximum_message_size) { kaesu failure(\"MESSAGE_TOO_LARGE\"); }\n    moshi (len(message) == 0) { kaesu exit_executable(exit_code); }\n    kaku code = x86_64.assembler();\n    kaku patches: []pe.Patch = [];\n    // [0,32) shadow space, +32 fifth argument, +40 zero-extended DWORD\n    // bytes-written, +48 handle, +56 cursor, +64 remaining. Total 72 aligns calls.\n    x86_64.sub_ri(code, x86_64.rsp, 72);\n    kaku prolog = len(code.bytes);\n    x86_64.mov_ri(code, x86_64.rcx, 4294967285); // DWORD STD_OUTPUT_HANDLE (-11)\n    import_call(code, patches, 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"failure\");\n    x86_64.cmp_ri(code, x86_64.rax, -1);\n    x86_64.jcc(code, x86_64.cc_e, \"failure\");\n    x86_64.mov_store(code, x86_64.rsp, 48, x86_64.rax);\n    kaku at = len(code.bytes);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    array.push(patches, pe.Patch { section: pe.text_section, offset: at + 2, kind: pe.va64, target: pe.rdata_section, target_offset: 0 });\n    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.r8, len(message));\n    x86_64.mov_store(code, x86_64.rsp, 64, x86_64.r8);\n    x86_64.label(code, \"write\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 48);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 56);\n    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 64);\n    x86_64.lea(code, x86_64.r9, x86_64.rsp, 40);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rsp, 40, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rax); // lpOverlapped = NULL\n    import_call(code, patches, 1);\n    x86_64.zero_extend_eax(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"failure\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 40);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"failure\");\n    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 64);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_a, \"failure\");\n    x86_64.sub_rr(code, x86_64.r8, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 64, x86_64.r8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 56);\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rdx);\n    x86_64.test_rr(code, x86_64.r8, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_ne, \"write\");\n    x86_64.mov_ri(code, x86_64.rcx, exit_code);\n    x86_64.jmp(code, \"exit\");\n    x86_64.label(code, \"failure\");\n    x86_64.mov_ri(code, x86_64.rcx, io_failure_exit);\n    x86_64.label(code, \"exit\");\n    import_call(code, patches, 2);\n    x86_64.add_ri(code, x86_64.rsp, 72);\n    x86_64.ret(code);\n    kaesu finish(code, patches, message, [\"GetStdHandle\", \"WriteFile\", \"ExitProcess\"], 72, prolog);\n}\n" }; }
waza data_67() -> File { kaesu File { path: "kiso/aot/x86_64/x86_64.mio", version: "Bunko-v2.1.1", length: 22596, sha256: "b53a53c2af3a773a76202a4e4eb49fcc74aca5d0f31d968ae52b163b24700c6e", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// 纯 Mio 实现的 x86-64（AMD64 64 位模式）指令编码器，服务于 Linux / Darwin runtime-IR 降级。\n// 由于 Mio 语言不提供位运算符，所有指令字段均通过受检整数算术拼接。\n// 寄存器编号遵循 ISA 约定：rax=0..rdi=7, r8..r15=8..15；控制流采用 32 位相对修补（Fixup），由 assemble() 统一回填。\nkoukai kata Label {\n    name: string;\n    offset: int64;\n}\nkoukai kata Fixup {\n    at: int64;\n    target: string;\n}\n// `table` holds one open-addressing hash table (label index + 1, 0 = empty) so that label lookup is O(1).\nkoukai kata Assembler {\n    bytes: []uint8;\n    labels: []Label;\n    fixups: []Fixup;\n    errors: []string;\n    table: [][]int64;\n    // PIC mode only (label \"pic\"): rip-relative references to the data (bss) area, see mov_data.\n    data_refs: []DataRef;\n}\n// A rel32 at `at` that must address `offset` bytes into the zero-filled data area: S + A - P with A = offset - 4.\nkoukai kata DataRef {\n    at: int64;\n    offset: int64;\n}\nkoukai kata AssembleResult {\n    bytes: []uint8;\n    error: string;\n}\n\nkoukai teisu rax = 0;\nkoukai teisu rcx = 1;\nkoukai teisu rdx = 2;\nkoukai teisu rbx = 3;\nkoukai teisu rsp = 4;\nkoukai teisu rbp = 5;\nkoukai teisu rsi = 6;\nkoukai teisu rdi = 7;\nkoukai teisu r8 = 8;\nkoukai teisu r9 = 9;\nkoukai teisu r10 = 10;\nkoukai teisu r11 = 11;\nkoukai teisu r12 = 12;\nkoukai teisu r13 = 13;\nkoukai teisu r14 = 14;\nkoukai teisu r15 = 15;\n// Condition codes (low nibble of Jcc/SETcc opcodes).\nkoukai teisu cc_b = 2;\nkoukai teisu cc_ae = 3;\nkoukai teisu cc_e = 4;\nkoukai teisu cc_ne = 5;\nkoukai teisu cc_be = 6;\nkoukai teisu cc_a = 7;\nkoukai teisu cc_l = 12;\nkoukai teisu cc_ge = 13;\nkoukai teisu cc_le = 14;\nkoukai teisu cc_g = 15;\n\nkoukai waza assembler() -> Assembler {\n    kaesu Assembler {\n        bytes: array.with_capacity[uint8](256), labels: array.with_capacity[Label](16), fixups: array.with_capacity[Fixup](16), errors: array.with_capacity[string](1), table: [array.make[int64](256, 0)], data_refs: array.with_capacity[DataRef](0) };\n}\n\nwaza fail(a: Assembler, message: string) -> unit { array.push(a.errors, message); }\nwaza low3(x: int64) -> int64 { kaesu x - (x / 8) * 8; }\nwaza high(x: int64) -> int64 {\n    moshi (x >= 8) {\n        kaesu 1;\n    }\n    kaesu 0;\n}\nwaza valid_register(a: Assembler, r: int64) -> bool {\n    moshi (r < 0 || r > 15) {\n        fail(a, \"INVALID_REGISTER\");\n        kaesu iie;\n    }\n    kaesu hai;\n}\nkoukai waza byte(a: Assembler, value: int64) -> unit {\n    moshi (value < 0 || value > 255) {\n        fail(a, \"INVALID_BYTE\");\n        kaesu;\n    }\n    array.push(a.bytes, uint8(value));\n}\nwaza imm32(a: Assembler, value: int64) -> unit {\n    moshi (value < -2147483648 || value > 2147483647) {\n        fail(a, \"INVALID_IMMEDIATE\");\n        kaesu;\n    }\n    kaku x = value;\n    moshi (x < 0) {\n        x = x + 4294967296;\n    }\n    kaku i = 0;\n    aida (i < 4) {\n        byte(a, x - (x / 256) * 256);\n        x = x / 256;\n        i = i + 1;\n    }\n}\n// Two's-complement 64-bit little-endian; negative values use ~(-(v+1)).\nwaza imm64(a: Assembler, value: int64) -> unit {\n    kaku negative = value < 0;\n    kaku x = value;\n    moshi (negative) {\n        x = -(value + 1);\n    }\n    kaku i = 0;\n    aida (i < 8) {\n        kaku b = x - (x / 256) * 256;\n        x = x / 256;\n        moshi (negative) { b = 255 - b; }\n        byte(a, b);\n        i = i + 1;\n    }\n}\n// REX.W prefix with R (reg field) and B (rm/base field) extensions.\nwaza rex(a: Assembler, reg: int64, rm: int64) -> unit { byte(a, 72 + high(reg) * 4 + high(rm)); }\nwaza modrm(a: Assembler, mode: int64, reg: int64, rm: int64) -> unit { byte(a, mode * 64 + low3(reg) * 8 + low3(rm)); }\n// [base + disp32]; rsp/r12 bases require a SIB byte.\nwaza memory(a: Assembler, reg: int64, base: int64, disp: int64) -> unit {\n    modrm(a, 2, reg, base);\n    moshi (low3(base) == 4) { byte(a, 36); }\n    imm32(a, disp);\n}\nkoukai waza op_rr(a: Assembler, opcode: int64, rm: int64, reg: int64) -> unit {\n    moshi (!valid_register(a, rm) || !valid_register(a, reg)) { kaesu; }\n    rex(a, reg, rm);\n    byte(a, opcode);\n    modrm(a, 3, reg, rm);\n}\nkoukai waza mov_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 137, dst, src); }\nkoukai waza add_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 1, dst, src); }\nkoukai waza sub_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 41, dst, src); }\nkoukai waza and_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 33, dst, src); }\nkoukai waza or_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 9, dst, src); }\nkoukai waza xor_rr(a: Assembler, dst: int64, src: int64) -> unit { op_rr(a, 49, dst, src); }\nkoukai waza cmp_rr(a: Assembler, left: int64, right: int64) -> unit { op_rr(a, 57, left, right); }\nkoukai waza test_rr(a: Assembler, left: int64, right: int64) -> unit { op_rr(a, 133, left, right); }\nkoukai waza xchg_rr(a: Assembler, left: int64, right: int64) -> unit { op_rr(a, 135, left, right); }\nkoukai waza imul_rr(a: Assembler, dst: int64, src: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, src)) { kaesu; }\n    rex(a, dst, src);\n    byte(a, 15);\n    byte(a, 175);\n    modrm(a, 3, dst, src);\n}\n// Unsigned divide rdx:rax by src (callers zero rdx).\nkoukai waza div_r(a: Assembler, src: int64) -> unit {\n    moshi (!valid_register(a, src)) { kaesu; }\n    rex(a, 0, src);\n    byte(a, 247);\n    modrm(a, 3, 6, src);\n}\n// Signed divide rdx:rax by src (callers run cqo first).\nkoukai waza idiv_r(a: Assembler, src: int64) -> unit {\n    moshi (!valid_register(a, src)) { kaesu; }\n    rex(a, 0, src);\n    byte(a, 247);\n    modrm(a, 3, 7, src);\n}\n// Sign-extend rax into rdx:rax.\nkoukai waza cqo(a: Assembler) -> unit {\n    byte(a, 72);\n    byte(a, 153);\n}\nkoukai waza neg_r(a: Assembler, dst: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst);\n    byte(a, 247);\n    modrm(a, 3, 3, dst);\n}\n// mov [base + disp32], low byte of src (a bare REX prefix selects sil/dil/spl/bpl).\nkoukai waza mov_store8(a: Assembler, base: int64, disp: int64, src: int64) -> unit {\n    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }\n    byte(a, 64 + high(src) * 4 + high(base));\n    byte(a, 136);\n    memory(a, src, base, disp);\n}\n// movzx dst, byte [base + disp32]\nkoukai waza mov_load8(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }\n    rex(a, dst, base);\n    byte(a, 15);\n    byte(a, 182);\n    memory(a, dst, base, disp);\n}\n// mov dst32, dword [base + disp32] (zero-extends into dst), mov dword [base + disp32], src32.\nkoukai waza mov_load32(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }\n    byte(a, 64 + high(dst) * 4 + high(base));\n    byte(a, 139);\n    memory(a, dst, base, disp);\n}\nkoukai waza mov_store32(a: Assembler, base: int64, disp: int64, src: int64) -> unit {\n    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }\n    byte(a, 64 + high(src) * 4 + high(base));\n    byte(a, 137);\n    memory(a, src, base, disp);\n}\n// movzx dst, word [base + disp32] and mov word [base + disp32], src16.\nkoukai waza mov_load16(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }\n    byte(a, 64 + high(dst) * 4 + high(base));\n    byte(a, 15);\n    byte(a, 183);\n    memory(a, dst, base, disp);\n}\nkoukai waza mov_store16(a: Assembler, base: int64, disp: int64, src: int64) -> unit {\n    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }\n    byte(a, 102);\n    byte(a, 64 + high(src) * 4 + high(base));\n    byte(a, 137);\n    memory(a, src, base, disp);\n}\nkoukai waza mov_ri(a: Assembler, dst: int64, value: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst);\n    byte(a, 184 + low3(dst));\n    imm64(a, value);\n}\n// Loads the absolute data-area address `value` (elf.data_base + offset). Without the label \"pic\" this is exactly\n// mov_ri, so static images are byte-for-byte unchanged. In PIC mode it is `lea dst, [rip + rel32]` and the rel32 is\n// recorded in data_refs, to become an R_X86_64_PC32 against the data section: no instruction depends on a load address.\nkoukai waza mov_data(a: Assembler, dst: int64, value: int64) -> unit {\n    moshi (find_label(a, \"pic\") < 0) { mov_ri(a, dst, value); kaesu; }\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, dst, 0);\n    byte(a, 141);\n    modrm(a, 0, dst, 5);\n    array.push(a.data_refs, DataRef { at: len(a.bytes), offset: value - data_area_base });\n    imm32(a, 0);\n}\n// elf.data_base, repeated here because the encoder does not import the ELF writer.\nkoukai teisu data_area_base = 268435456;\nkoukai waza mov_load(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }\n    rex(a, dst, base);\n    byte(a, 139);\n    memory(a, dst, base, disp);\n}\nkoukai waza mov_store(a: Assembler, base: int64, disp: int64, src: int64) -> unit {\n    moshi (!valid_register(a, src) || !valid_register(a, base)) { kaesu; }\n    rex(a, src, base);\n    byte(a, 137);\n    memory(a, src, base, disp);\n}\nkoukai waza lea(a: Assembler, dst: int64, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, dst) || !valid_register(a, base)) { kaesu; }\n    rex(a, dst, base);\n    byte(a, 141);\n    memory(a, dst, base, disp);\n}\nkoukai waza add_ri(a: Assembler, dst: int64, value: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst);\n    byte(a, 129);\n    modrm(a, 3, 0, dst);\n    imm32(a, value);\n}\nkoukai waza sub_ri(a: Assembler, dst: int64, value: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst);\n    byte(a, 129);\n    modrm(a, 3, 5, dst);\n    imm32(a, value);\n}\nkoukai waza and_ri(a: Assembler, dst: int64, value: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst);\n    byte(a, 129);\n    modrm(a, 3, 4, dst);\n    imm32(a, value);\n}\nkoukai waza cmp_ri(a: Assembler, dst: int64, value: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, 0, dst);\n    byte(a, 129);\n    modrm(a, 3, 7, dst);\n    imm32(a, value);\n}\nwaza shift_ri(a: Assembler, dst: int64, extension: int64, count: int64) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    moshi (count < 0 || count > 63) {\n        fail(a, \"INVALID_SHIFT\");\n        kaesu;\n    }\n    rex(a, 0, dst);\n    byte(a, 193);\n    modrm(a, 3, extension, dst);\n    byte(a, count);\n}\nkoukai waza shl_ri(a: Assembler, dst: int64, count: int64) -> unit { shift_ri(a, dst, 4, count); }\nkoukai waza shr_ri(a: Assembler, dst: int64, count: int64) -> unit { shift_ri(a, dst, 5, count); }\nkoukai waza sar_ri(a: Assembler, dst: int64, count: int64) -> unit { shift_ri(a, dst, 7, count); }\n// rep movsb: copy rcx bytes from [rsi] to [rdi].\nkoukai waza rep_movsb(a: Assembler) -> unit {\n    byte(a, 243);\n    byte(a, 164);\n}\n// ---- SSE scalar floating point (xmm0..xmm15) ----------------------------------------------------------\n// prefix: 0 none, 102 (66), 242 (F2), 243 (F3); escape 1 = 0F xx, 2 = 0F 3A xx; `wide` adds REX.W.\n// `reg` goes in ModRM.reg, `rm` in ModRM.rm (both registers).\nwaza sse_rr(a: Assembler, prefix: int64, wide: bool, escape: int64, op: int64, reg: int64, rm: int64) -> unit {\n    moshi (!valid_register(a, reg) || !valid_register(a, rm)) { kaesu; }\n    moshi (prefix != 0) { byte(a, prefix); }\n    kaku rex_bits = high(reg) * 4 + high(rm);\n    moshi (wide) { rex_bits = rex_bits + 8; }\n    moshi (rex_bits != 0) { byte(a, 64 + rex_bits); }\n    byte(a, 15);\n    moshi (escape == 2) { byte(a, 58); }\n    byte(a, op);\n    modrm(a, 3, reg, rm);\n}\nkoukai waza movq_xmm_r(a: Assembler, xmm: int64, r: int64) -> unit { sse_rr(a, 102, hai, 1, 110, xmm, r); }\nkoukai waza movq_r_xmm(a: Assembler, r: int64, xmm: int64) -> unit { sse_rr(a, 102, hai, 1, 126, xmm, r); }\nkoukai waza movd_xmm_r(a: Assembler, xmm: int64, r: int64) -> unit { sse_rr(a, 102, iie, 1, 110, xmm, r); }\nkoukai waza movd_r_xmm(a: Assembler, r: int64, xmm: int64) -> unit { sse_rr(a, 102, iie, 1, 126, xmm, r); }\n// Arithmetic: double (F2) when `double`, single (F3) otherwise. op: 88 add, 92 sub, 89 mul, 94 div, 81 sqrt.\nkoukai waza sse_arith(a: Assembler, double: bool, op: int64, dst: int64, src: int64) -> unit {\n    kaku prefix = 243;\n    moshi (double) { prefix = 242; }\n    sse_rr(a, prefix, iie, 1, op, dst, src);\n}\nkoukai waza ucomis(a: Assembler, double: bool, left: int64, right: int64) -> unit {\n    kaku prefix = 0;\n    moshi (double) { prefix = 102; }\n    sse_rr(a, prefix, iie, 1, 46, left, right);\n}\nkoukai waza cvtsi2s(a: Assembler, double: bool, xmm: int64, r: int64) -> unit {\n    kaku prefix = 243;\n    moshi (double) { prefix = 242; }\n    sse_rr(a, prefix, hai, 1, 42, xmm, r);\n}\nkoukai waza cvtts2si(a: Assembler, double: bool, r: int64, xmm: int64) -> unit {\n    kaku prefix = 243;\n    moshi (double) { prefix = 242; }\n    sse_rr(a, prefix, hai, 1, 44, r, xmm);\n}\nkoukai waza cvtsd2ss(a: Assembler, dst: int64, src: int64) -> unit { sse_rr(a, 242, iie, 1, 90, dst, src); }\nkoukai waza cvtss2sd(a: Assembler, dst: int64, src: int64) -> unit { sse_rr(a, 243, iie, 1, 90, dst, src); }\n// roundsd/roundss dst, src, mode (8 nearest-even, 9 floor, 10 ceil, 11 truncate; SSE4.1).\nkoukai waza rounds(a: Assembler, double: bool, dst: int64, src: int64, mode: int64) -> unit {\n    kaku op = 10;\n    moshi (double) { op = 11; }\n    sse_rr(a, 102, iie, 2, op, dst, src);\n    byte(a, mode);\n}\n\nkoukai waza push_r(a: Assembler, r: int64) -> unit {\n    moshi (!valid_register(a, r)) { kaesu; }\n    moshi (r >= 8) {\n        byte(a, 65);\n    }\n    byte(a, 80 + low3(r));\n}\nkoukai waza pop_r(a: Assembler, r: int64) -> unit {\n    moshi (!valid_register(a, r)) { kaesu; }\n    moshi (r >= 8) {\n        byte(a, 65);\n    }\n    byte(a, 88 + low3(r));\n}\n// SETcc into the low byte of rax, zero-extended (the runtime IR's boolean).\nkoukai waza setcc_rax(a: Assembler, cc: int64) -> unit {\n    moshi (cc < 0 || cc > 15) {\n        fail(a, \"INVALID_CONDITION\");\n        kaesu;\n    }\n    byte(a, 15);\n    byte(a, 144 + cc);\n    byte(a, 192);\n    byte(a, 15);\n    byte(a, 182);\n    byte(a, 192);\n}\nkoukai waza ret(a: Assembler) -> unit { byte(a, 195); }\n// mov eax, imm32 (zero-extends into rax).\nkoukai waza mov_eax_imm(a: Assembler, value: int64) -> unit {\n    moshi (value < 0 || value > 2147483647) {\n        fail(a, \"INVALID_IMMEDIATE\");\n        kaesu;\n    }\n    byte(a, 184);\n    imm32(a, value);\n}\n// mov eax,eax: zero-extends a 32-bit native result into rax.\nkoukai waza zero_extend_eax(a: Assembler) -> unit {\n    byte(a, 137);\n    byte(a, 192);\n}\n// The SYSCALL instruction itself (0F 05).\nkoukai waza syscall_raw(a: Assembler) -> unit {\n    byte(a, 15);\n    byte(a, 5);\n}\n// Darwin (macOS x86-64) mode, chosen by defining the label \"darwin_abi\" before any code is emitted: a Linux-convention\n// system call (number in eax, arguments in rdi rsi rdx r10 r8 r9, result or -errno in rax) becomes `call darwin_syscall`,\n// a runtime routine that performs the equivalent Darwin BSD call. Without the label this is the plain SYSCALL instruction,\n// so Linux images stay byte-identical.\nkoukai waza syscall(a: Assembler) -> unit {\n    moshi (find_label(a, \"darwin_abi\") >= 0) {\n        call(a, \"darwin_syscall\");\n        kaesu;\n    }\n    syscall_raw(a);\n}\nkoukai waza mfence(a: Assembler) -> unit {\n    byte(a, 15);\n    byte(a, 174);\n    byte(a, 240);\n}\n// xchg [base], reg (implicitly locked): sequentially consistent store.\nkoukai waza xchg_store(a: Assembler, base: int64, reg: int64) -> unit {\n    moshi (!valid_register(a, reg) || !valid_register(a, base)) { kaesu; }\n    rex(a, reg, base);\n    byte(a, 135);\n    memory(a, reg, base, 0);\n}\n// SETcc into cl, zero-extended into rcx.\nkoukai waza setcc_rcx(a: Assembler, cc: int64) -> unit {\n    moshi (cc < 0 || cc > 15) {\n        fail(a, \"INVALID_CONDITION\");\n        kaesu;\n    }\n    byte(a, 15);\n    byte(a, 144 + cc);\n    byte(a, 193);\n    byte(a, 15);\n    byte(a, 182);\n    byte(a, 201);\n}\n// lock xadd [base], reg : reg receives the previous value.\nkoukai waza lock_xadd(a: Assembler, base: int64, reg: int64) -> unit {\n    moshi (!valid_register(a, reg) || !valid_register(a, base)) { kaesu; }\n    byte(a, 240);\n    rex(a, reg, base);\n    byte(a, 15);\n    byte(a, 193);\n    memory(a, reg, base, 0);\n}\n// lock cmpxchg [base], desired : compares with rax, ZF=1 on success, rax=observed.\nkoukai waza lock_cmpxchg(a: Assembler, base: int64, desired: int64) -> unit {\n    moshi (!valid_register(a, desired) || !valid_register(a, base)) { kaesu; }\n    byte(a, 240);\n    rex(a, desired, base);\n    byte(a, 15);\n    byte(a, 177);\n    memory(a, desired, base, 0);\n}\nkoukai waza call_r(a: Assembler, r: int64) -> unit {\n    moshi (!valid_register(a, r)) { kaesu; }\n    moshi (r >= 8) {\n        byte(a, 65);\n    }\n    byte(a, 255);\n    modrm(a, 3, 2, r);\n}\nkoukai waza call_memory(a: Assembler, base: int64, disp: int64) -> unit {\n    moshi (!valid_register(a, base)) { kaesu; }\n    moshi (base >= 8) {\n        byte(a, 65);\n    }\n    byte(a, 255);\n    memory(a, 2, base, disp);\n}\n\nwaza label_hash(name: string) -> int64 {\n    kaku data = string.to_bytes(name);\n    kaku value = 5381;\n    kaku at = 0;\n    aida (at < len(data)) {\n        kaku next = value * 33 + int64(data[at]);\n        value = next - (next / 1073741789) * 1073741789;\n        at = at + 1;\n    }\n    kaesu value;\n}\n\nwaza find_label(a: Assembler, name: string) -> int64 {\n    kaku table = a.table[0];\n    kaku capacity = len(table);\n    kaku hash = label_hash(name);\n    kaku slot = hash - (hash / capacity) * capacity;\n    aida (table[slot] != 0) {\n        kaku entry = a.labels[table[slot] - 1];\n        moshi (entry.name == name) { kaesu entry.offset; }\n        slot = slot + 1;\n        moshi (slot == capacity) { slot = 0; }\n    }\n    kaesu -1;\n}\n\nwaza insert_label(table: []int64, labels: []Label, index: int64) -> unit {\n    kaku capacity = len(table);\n    kaku hash = label_hash(labels[index].name);\n    kaku slot = hash - (hash / capacity) * capacity;\n    aida (table[slot] != 0) {\n        slot = slot + 1;\n        moshi (slot == capacity) {\n            slot = 0;\n        }\n    }\n    table[slot] = index + 1;\n}\n\nkoukai waza label(a: Assembler, name: string) -> unit {\n    moshi (find_label(a, name) >= 0) {\n        fail(a, \"DUPLICATE_LABEL\");\n        kaesu;\n    }\n    array.push(a.labels, Label { name: name, offset: len(a.bytes) });\n    kaku count = len(a.labels);\n    moshi (count * 2 > len(a.table[0])) {\n        kaku bigger = array.make[int64](len(a.table[0]) * 4, 0);\n        kaku index = 0;\n        aida (index < count) {\n            insert_label(bigger, a.labels, index);\n            index = index + 1;\n        }\n        a.table[0] = bigger;\n    }\n    sore { insert_label(a.table[0], a.labels, count - 1); }\n}\nkoukai waza label_offset(a: Assembler, name: string) -> int64 { kaesu find_label(a, name); }\nwaza branch(a: Assembler, target: string) -> unit {\n    array.push(a.fixups, Fixup { at: len(a.bytes), target: target });\n    imm32(a, 0);\n}\nkoukai waza jmp(a: Assembler, target: string) -> unit {\n    byte(a, 233);\n    branch(a, target);\n}\nkoukai waza call(a: Assembler, target: string) -> unit {\n    byte(a, 232);\n    branch(a, target);\n}\nkoukai waza jcc(a: Assembler, cc: int64, target: string) -> unit {\n    moshi (cc < 0 || cc > 15) {\n        fail(a, \"INVALID_CONDITION\");\n        kaesu;\n    }\n    byte(a, 15);\n    byte(a, 128 + cc);\n    branch(a, target);\n}\n// lea dst, [rip + label]\nkoukai waza lea_label(a: Assembler, dst: int64, target: string) -> unit {\n    moshi (!valid_register(a, dst)) { kaesu; }\n    rex(a, dst, 0);\n    byte(a, 141);\n    modrm(a, 0, dst, 5);\n    branch(a, target);\n}\n\n// 外部调用（System V C ABI）：目标标签以 \"ext:\" 开头的 call 不在本汇编器内解析。\n// 其 rel32 保持 0，并作为 ExternalCall 返回；由系统链接器通过 R_X86_64_PLT32 回填。\nkoukai teisu external_prefix = \"ext:\";\nkoukai kata ExternalCall {\n    at: int64;\n    symbol: string;\n}\nkoukai kata LinkedAssembly {\n    bytes: []uint8;\n    error: string;\n    externals: []ExternalCall;\n    data_refs: []DataRef;\n}\n\n// call rel32 到链接器解析的外部符号。返回时 rel32 位于调用指令末尾 4 字节。\nkoukai waza call_external(a: Assembler, symbol: string) -> unit {\n    byte(a, 232);\n    branch(a, string.concat(external_prefix, symbol));\n}\n\nkoukai waza assemble(a: Assembler) -> AssembleResult {\n    kaku linked = assemble_linked(a);\n    moshi (linked.error == \"\" && len(linked.externals) != 0) { kaesu AssembleResult { bytes: [], error: \"UNRESOLVED_EXTERNAL\" }; }\n    kaesu AssembleResult { bytes: linked.bytes, error: linked.error };\n}\n\nkoukai waza assemble_linked(a: Assembler) -> LinkedAssembly {\n    moshi (len(a.errors) > 0) { kaesu LinkedAssembly { bytes: [], error: a.errors[0], externals: [], data_refs: [] }; }\n    kaku output = array.clone(a.bytes);\n    kaku externals: []ExternalCall = [];\n    kaku i = 0;\n    aida (i < len(a.fixups)) {\n        kaku f = a.fixups[i];\n        moshi (string.has_prefix(f.target, external_prefix)) {\n            kaku name_bytes = string.to_bytes(f.target);\n            kaku symbol_bytes: []uint8 = [];\n            kaku n = 4;\n            aida (n < len(name_bytes)) { array.push(symbol_bytes, name_bytes[n]); n = n + 1; }\n            kaku symbol = string.from_utf8(symbol_bytes);\n            moshi (symbol == mu) { kaesu LinkedAssembly { bytes: [], error: \"INVALID_EXTERNAL\", externals: [], data_refs: [] }; }\n            array.push(externals, ExternalCall { at: f.at, symbol: symbol });\n            i = i + 1;\n            tsuzuku;\n        }\n        kaku target = find_label(a, f.target);\n        moshi (target < 0) { kaesu LinkedAssembly { bytes: [], error: \"UNDEFINED_LABEL\", externals: [], data_refs: [] }; }\n        kaku delta = target - (f.at + 4);\n        moshi (delta < -2147483648 || delta > 2147483647) { kaesu LinkedAssembly { bytes: [], error: \"BRANCH_OUT_OF_RANGE\", externals: [], data_refs: [] }; }\n        kaku x = delta;\n        moshi (x < 0) {\n            x = x + 4294967296;\n        }\n        kaku k = 0;\n        aida (k < 4) {\n            output[f.at + k] = uint8(x - (x / 256) * 256);\n            x = x / 256;\n            k = k + 1;\n        }\n        i = i + 1;\n    }\n    kaesu LinkedAssembly { bytes: output, error: \"\", externals: externals, data_refs: a.data_refs };\n}\n" }; }
waza data_68() -> File { kaesu File { path: "kiso/array/array.mio", version: "Bunko-v2.1.1", length: 790, sha256: "a2d7cbe2385873f015fc032ee1be309de7e93d813aaacbb69d279895e24e153f", source: "koukai waza make<T>(length: int64, initial: T) -> []T {\n    kaesu __array_make(length, initial);\n}\n\nkoukai waza with_capacity<T>(capacity: int64) -> []T {\n    kaesu __array_with_capacity(capacity);\n}\n\nkoukai waza push<T>(values: []T, value: T) -> unit {\n    __array_push(values, value);\n}\n\nkoukai waza capacity<T>(values: []T) -> int64 {\n    kaesu __array_capacity(values);\n}\n\nkoukai waza reserve<T>(values: []T, additional: int64) -> unit {\n    __array_reserve(values, additional);\n}\n\nkoukai waza clone<T>(values: []T) -> []T {\n    kaesu __array_clone(values);\n}\n\nkoukai waza truncate<T>(values: []T, new_length: int64) -> unit {\n    __array_truncate(values, new_length);\n}\n\nkoukai waza append_all<T>(destination: []T, source: []T) -> unit {\n    __array_append_all(destination, source);\n}\n" }; }
waza data_69() -> File { kaesu File { path: "kiso/bytes/bytes.mio", version: "Bunko-v2.1.1", length: 3321, sha256: "cca8c910bc492a3f39bd2872ef0923b55dc642b88bc0b5d810f9039e3e9e6c5f", source: "yobu \"kiso/array\";\n\nkoukai kata ByteBuffer { data: []uint8; }\n\nkoukai waza equal(left: []uint8, right: []uint8) -> bool {\n    moshi (len(left) != len(right)) { kaesu iie; }\n    kaku index = 0;\n    aida (index < len(left)) {\n        moshi (left[index] != right[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nkoukai waza compare(left: []uint8, right: []uint8) -> int64 {\n    kaku limit = len(left);\n    moshi (len(right) < limit) { limit = len(right); }\n    kaku index = 0;\n    aida (index < limit) {\n        moshi (left[index] < right[index]) { kaesu -1; }\n        moshi (left[index] > right[index]) { kaesu 1; }\n        index = index + 1;\n    }\n    moshi (len(left) < len(right)) { kaesu -1; }\n    moshi (len(left) > len(right)) { kaesu 1; }\n    kaesu 0;\n}\n\nkoukai waza index(values: []uint8, target: uint8) -> int64 {\n    kaku current = 0;\n    aida (current < len(values)) {\n        moshi (values[current] == target) { kaesu current; }\n        current = current + 1;\n    }\n    kaesu -1;\n}\n\nkoukai waza contains(values: []uint8, target: uint8) -> bool {\n    kaesu index(values, target) >= 0;\n}\n\nkoukai waza has_prefix(values: []uint8, prefix: []uint8) -> bool {\n    moshi (len(prefix) > len(values)) { kaesu iie; }\n    kaku index = 0;\n    aida (index < len(prefix)) {\n        moshi (values[index] != prefix[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nkoukai waza has_suffix(values: []uint8, suffix: []uint8) -> bool {\n    moshi (len(suffix) > len(values)) { kaesu iie; }\n    kaku offset = len(values) - len(suffix);\n    kaku index = 0;\n    aida (index < len(suffix)) {\n        moshi (values[offset + index] != suffix[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nkoukai waza copy(destination: []uint8, source: []uint8) -> int64 {\n    kaku count = len(destination);\n    moshi (len(source) < count) { count = len(source); }\n    kaku index = 0;\n    aida (index < count) {\n        destination[index] = source[index];\n        index = index + 1;\n    }\n    kaesu count;\n}\n\nkoukai waza fill(values: []uint8, value: uint8) -> unit {\n    kaku index = 0;\n    aida (index < len(values)) {\n        values[index] = value;\n        index = index + 1;\n    }\n    kaesu;\n}\n\nkoukai waza clone(values: []uint8) -> []uint8 {\n    kaesu array.clone(values);\n}\n\nkoukai waza new_buffer() -> ByteBuffer {\n    kaesu ByteBuffer { data: array.with_capacity[uint8](0) };\n}\n\nkoukai waza buffer_with_capacity(capacity: int64) -> ByteBuffer {\n    kaesu ByteBuffer { data: array.with_capacity[uint8](capacity) };\n}\n\nkoukai waza write_byte(buffer: ByteBuffer, value: uint8) -> unit {\n    array.push(buffer.data, value);\n}\n\nkoukai waza write(buffer: ByteBuffer, source: []uint8) -> int64 {\n    kaku count = len(source);\n    array.append_all(buffer.data, source);\n    kaesu count;\n}\n\nkoukai waza buffer_len(buffer: ByteBuffer) -> int64 {\n    kaesu len(buffer.data);\n}\n\nkoukai waza buffer_capacity(buffer: ByteBuffer) -> int64 {\n    kaesu array.capacity(buffer.data);\n}\n\nkoukai waza reset(buffer: ByteBuffer) -> unit {\n    array.truncate(buffer.data, 0);\n}\n\nkoukai waza buffer_clone(buffer: ByteBuffer) -> ByteBuffer {\n    kaesu ByteBuffer { data: array.clone(buffer.data) };\n}\n\nkoukai waza buffer_bytes(buffer: ByteBuffer) -> []uint8 {\n    kaesu array.clone(buffer.data);\n}\n" }; }
waza data_70() -> File { kaesu File { path: "kiso/convert/convert.mio", version: "Bunko-v2.1.1", length: 3103, sha256: "f802730285564dc17c44eaf860392e6b9df72e49a4b1163c0c29d0b8dd471b2d", source: "yobu \"kiso/bytes\";\nyobu \"kiso/string\";\n\nwaza parse_negative(data: []uint8, offset: int64, limit: int64) -> int64? {\n    kaku result: int64 = 0;\n    kaku cutoff = limit / 10;\n    kaku last_digit = -(limit - cutoff * 10);\n    kaku current_offset = offset;\n    aida (current_offset < len(data)) {\n        kaku current = data[current_offset];\n        moshi (current < 48 || current > 57) { kaesu mu; }\n        kaku digit = int64(current - 48);\n        moshi (result < cutoff || (result == cutoff && digit > last_digit)) { kaesu mu; }\n        result = result * 10 - digit;\n        current_offset = current_offset + 1;\n    }\n    kaesu result;\n}\n\nwaza format_negative(value: int64, negative: bool, capacity: int64) -> string {\n    kaku builder = string.builder_with_capacity(capacity);\n    kaku start: int64 = 0;\n    moshi (negative) {\n        bytes.write_byte(builder.buffer, uint8(45));\n        start = 1;\n    }\n    kaku current = value;\n    moshi (current == 0) {\n        bytes.write_byte(builder.buffer, uint8(48));\n    } sore {\n        aida (current != 0) {\n            kaku digit = -(current - (current / 10) * 10);\n            bytes.write_byte(builder.buffer, uint8(48 + digit));\n            current = current / 10;\n        }\n    }\n    kaku left = start;\n    kaku right = len(builder.buffer.data) - 1;\n    aida (left < right) {\n        kaku temporary = builder.buffer.data[left];\n        builder.buffer.data[left] = builder.buffer.data[right];\n        builder.buffer.data[right] = temporary;\n        left = left + 1;\n        right = right - 1;\n    }\n    kaesu string.builder_string(builder);\n}\n\nkoukai waza parse_int(value: string) -> int64? {\n    kaku data = string.to_bytes(value);\n    moshi (len(data) == 0) { kaesu mu; }\n    kaku offset: int64 = 0;\n    kaku negative = iie;\n    moshi (data[0] == 45) {\n        negative = hai;\n        offset = 1;\n    } sore {\n        moshi (data[0] == 43) { offset = 1; }\n    }\n    moshi (offset == len(data)) { kaesu mu; }\n    kaku limit: int64 = -9223372036854775807;\n    moshi (negative) { limit = limit - 1; }\n    kaku result = parse_negative(data, offset, limit);\n    moshi (result == mu) { kaesu mu; }\n    moshi (negative) { kaesu result; }\n    kaesu -result;\n}\n\nkoukai waza parse_uint(value: string) -> uint32? {\n    kaku data = string.to_bytes(value);\n    moshi (len(data) == 0) { kaesu mu; }\n    kaku offset: int64 = 0;\n    moshi (data[0] == 43) { offset = 1; }\n    moshi (offset == len(data)) { kaesu mu; }\n    kaku result = parse_negative(data, offset, -4294967295);\n    moshi (result == mu) { kaesu mu; }\n    kaesu uint32(-result);\n}\n\nkoukai waza format_int(value: int64) -> string {\n    moshi (value < 0) { kaesu format_negative(value, hai, 20); }\n    kaesu format_negative(-value, iie, 19);\n}\n\nkoukai waza format_uint(value: uint32) -> string {\n    kaesu format_negative(-int64(value), iie, 10);\n}\n\nkoukai waza parse_bool(value: string) -> bool? {\n    moshi (value == \"hai\") { kaesu hai; }\n    moshi (value == \"iie\") { kaesu iie; }\n    kaesu mu;\n}\n\nkoukai waza format_bool(value: bool) -> string {\n    moshi (value) { kaesu \"hai\"; }\n    kaesu \"iie\";\n}\n" }; }
waza data_71() -> File { kaesu File { path: "kiso/convert/float.mio", version: "Bunko-v2.1.1", length: 23499, sha256: "4cf2eb2fff5c55be8d6387dbec245aa04dac36007660a6705175695bf75da45f", source: "yobu \"kiso/array\";\nyobu \"kiso/bytes\";\nyobu \"kiso/math\";\nyobu \"kiso/string\";\n\nkata DecimalBig { limbs: []int64; }\n\nteisu decimal_base: int64 = 1000000000;\nteisu max_float_input_bytes: int64 = 10000;\n\nwaza big_zero() -> DecimalBig {\n    kaesu DecimalBig { limbs: array.with_capacity[int64](1) };\n}\n\nwaza big_one() -> DecimalBig {\n    kaku result = big_zero();\n    array.push(result.limbs, 1);\n    kaesu result;\n}\n\nwaza big_clone(value: DecimalBig) -> DecimalBig {\n    kaesu DecimalBig { limbs: array.clone(value.limbs) };\n}\n\nwaza big_normalize(value: DecimalBig) -> unit {\n    aida (len(value.limbs) > 0 && value.limbs[len(value.limbs) - 1] == 0) {\n        array.truncate(value.limbs, len(value.limbs) - 1);\n    }\n}\n\nwaza big_compare(left: DecimalBig, right: DecimalBig) -> int64 {\n    moshi (len(left.limbs) < len(right.limbs)) { kaesu -1; }\n    moshi (len(left.limbs) > len(right.limbs)) { kaesu 1; }\n    kaku index = len(left.limbs) - 1;\n    aida (index >= 0) {\n        moshi (left.limbs[index] < right.limbs[index]) { kaesu -1; }\n        moshi (left.limbs[index] > right.limbs[index]) { kaesu 1; }\n        index = index - 1;\n    }\n    kaesu 0;\n}\n\nwaza big_subtract(left: DecimalBig, right: DecimalBig) -> unit {\n    kaku borrow: int64 = 0;\n    kaku index: int64 = 0;\n    aida (index < len(left.limbs)) {\n        kaku subtrahend = borrow;\n        moshi (index < len(right.limbs)) { subtrahend = subtrahend + right.limbs[index]; }\n        kaku current = left.limbs[index] - subtrahend;\n        borrow = 0;\n        moshi (current < 0) {\n            current = current + decimal_base;\n            borrow = 1;\n        }\n        left.limbs[index] = current;\n        index = index + 1;\n    }\n    big_normalize(left);\n}\n\nwaza big_multiply_small(value: DecimalBig, factor: int64) -> unit {\n    moshi (factor == 0 || len(value.limbs) == 0) {\n        array.truncate(value.limbs, 0);\n        kaesu;\n    }\n    kaku carry: int64 = 0;\n    kaku index: int64 = 0;\n    aida (index < len(value.limbs)) {\n        kaku product = value.limbs[index] * factor + carry;\n        value.limbs[index] = product - (product / decimal_base) * decimal_base;\n        carry = product / decimal_base;\n        index = index + 1;\n    }\n    aida (carry != 0) {\n        array.push(value.limbs, carry - (carry / decimal_base) * decimal_base);\n        carry = carry / decimal_base;\n    }\n}\n\nwaza big_multiply_power(value: DecimalBig, factor: int64, exponent: int64) -> unit {\n    kaku remaining = exponent;\n    moshi (factor == 2) {\n        aida (remaining >= 29) {\n            big_multiply_small(value, 536870912);\n            remaining = remaining - 29;\n        }\n    }\n    moshi (factor == 5) {\n        aida (remaining >= 12) {\n            big_multiply_small(value, 244140625);\n            remaining = remaining - 12;\n        }\n    }\n    aida (remaining > 0) {\n        big_multiply_small(value, factor);\n        remaining = remaining - 1;\n    }\n}\n\nwaza big_divide_small(value: DecimalBig, divisor: int64) -> int64 {\n    kaku remainder: int64 = 0;\n    kaku index = len(value.limbs) - 1;\n    aida (index >= 0) {\n        kaku current = remainder * decimal_base + value.limbs[index];\n        value.limbs[index] = current / divisor;\n        remainder = current - value.limbs[index] * divisor;\n        index = index - 1;\n    }\n    big_normalize(value);\n    kaesu remainder;\n}\n\nwaza big_from_decimal(data: []uint8, start: int64, end: int64) -> DecimalBig {\n    kaku result = big_zero();\n    kaku right = end;\n    aida (right > start) {\n        kaku left = right - 9;\n        moshi (left < start) { left = start; }\n        kaku limb: int64 = 0;\n        kaku index = left;\n        aida (index < right) {\n            limb = limb * 10 + int64(data[index] - 48);\n            index = index + 1;\n        }\n        array.push(result.limbs, limb);\n        right = left;\n    }\n    big_normalize(result);\n    kaesu result;\n}\n\nwaza big_from_positive(value: int64) -> DecimalBig {\n    kaku result = big_zero();\n    kaku remaining = value;\n    aida (remaining != 0) {\n        kaku quotient = remaining / decimal_base;\n        array.push(result.limbs, remaining - quotient * decimal_base);\n        remaining = quotient;\n    }\n    kaesu result;\n}\n\nwaza append_positive_decimal(buffer: bytes.ByteBuffer, value: int64, width: int64) -> unit {\n    kaku temporary = array.with_capacity[uint8](20);\n    kaku remaining = value;\n    moshi (remaining == 0) { array.push(temporary, uint8(48)); }\n    aida (remaining != 0) {\n        kaku quotient = remaining / 10;\n        array.push(temporary, uint8(48 + remaining - quotient * 10));\n        remaining = quotient;\n    }\n    aida (len(temporary) < width) { array.push(temporary, uint8(48)); }\n    kaku index = len(temporary) - 1;\n    aida (index >= 0) {\n        bytes.write_byte(buffer, temporary[index]);\n        index = index - 1;\n    }\n}\n\nwaza big_decimal_bytes(value: DecimalBig) -> []uint8 {\n    kaku buffer = bytes.buffer_with_capacity(len(value.limbs) * 9);\n    kaku index = len(value.limbs) - 1;\n    moshi (index < 0) {\n        bytes.write_byte(buffer, uint8(48));\n        kaesu bytes.buffer_bytes(buffer);\n    }\n    append_positive_decimal(buffer, value.limbs[index], 1);\n    index = index - 1;\n    aida (index >= 0) {\n        append_positive_decimal(buffer, value.limbs[index], 9);\n        index = index - 1;\n    }\n    kaesu bytes.buffer_bytes(buffer);\n}\n\nwaza floor_divide(value: int64, divisor: int64) -> int64 {\n    kaku quotient = value / divisor;\n    moshi (value < 0 && value - quotient * divisor != 0) { quotient = quotient - 1; }\n    kaesu quotient;\n}\n\nwaza decimal_compare_power(significand: DecimalBig, exponent10: int64, exponent2: int64) -> int64 {\n    kaku left = big_clone(significand);\n    kaku right = big_one();\n    kaku shift: int64 = 0;\n    moshi (exponent10 >= 0) {\n        big_multiply_power(left, 5, exponent10);\n        shift = exponent2 - exponent10;\n    } sore {\n        big_multiply_power(right, 5, -exponent10);\n        shift = exponent2 - exponent10;\n    }\n    moshi (shift >= 0) {\n        big_multiply_power(right, 2, shift);\n    } sore {\n        big_multiply_power(left, 2, -shift);\n    }\n    kaesu big_compare(left, right);\n}\n\nwaza decimal_binary_exponent(significand: DecimalBig, decimal_digits: int64, exponent10: int64) -> int64 {\n    kaku adjusted = decimal_digits + exponent10 - 1;\n    kaku exponent2 = floor_divide(adjusted * 3322, 1000);\n    aida (decimal_compare_power(significand, exponent10, exponent2) < 0) {\n        exponent2 = exponent2 - 1;\n    }\n    aida (decimal_compare_power(significand, exponent10, exponent2 + 1) >= 0) {\n        exponent2 = exponent2 + 1;\n    }\n    kaesu exponent2;\n}\n\nwaza decimal_round_binary(significand: DecimalBig, exponent10: int64, scale2: int64, precision: int64) -> int64 {\n    kaku numerator = big_clone(significand);\n    kaku denominator = big_one();\n    moshi (exponent10 >= 0) {\n        big_multiply_power(numerator, 5, exponent10);\n    } sore {\n        big_multiply_power(denominator, 5, -exponent10);\n    }\n    kaku shift = exponent10 - scale2;\n    moshi (shift >= 0) {\n        big_multiply_power(numerator, 2, shift);\n    } sore {\n        big_multiply_power(denominator, 2, -shift);\n    }\n\n    kaku multiple = big_clone(denominator);\n    big_multiply_power(multiple, 2, precision);\n    kaku bit_value: int64 = 1;\n    kaku bit_index: int64 = 0;\n    aida (bit_index < precision) {\n        bit_value = bit_value * 2;\n        bit_index = bit_index + 1;\n    }\n    kaku quotient: int64 = 0;\n    kaku current = precision;\n    aida (current >= 0) {\n        moshi (big_compare(numerator, multiple) >= 0) {\n            big_subtract(numerator, multiple);\n            quotient = quotient + bit_value;\n        }\n        moshi (current > 0) { big_divide_small(multiple, 2); }\n        bit_value = bit_value / 2;\n        current = current - 1;\n    }\n\n    kaku doubled = big_clone(numerator);\n    big_multiply_small(doubled, 2);\n    kaku comparison = big_compare(doubled, denominator);\n    moshi (comparison > 0 || (comparison == 0 && quotient - (quotient / 2) * 2 != 0)) {\n        quotient = quotient + 1;\n    }\n    kaesu quotient;\n}\n\nkata ParsedDecimal {\n    negative: bool;\n    zero: bool;\n    significand: DecimalBig;\n    digits: int64;\n    exponent10: int64;\n}\n\nwaza parse_finite_decimal(data: []uint8) -> ParsedDecimal? {\n    moshi (len(data) == 0 || len(data) > max_float_input_bytes) { kaesu mu; }\n    kaku offset: int64 = 0;\n    kaku negative = iie;\n    moshi (data[0] == 45) {\n        negative = hai;\n        offset = 1;\n    } sore {\n        moshi (data[0] == 43) { offset = 1; }\n    }\n    moshi (offset == len(data)) { kaesu mu; }\n\n    kaku digits = array.with_capacity[uint8](len(data));\n    kaku fractional_digits: int64 = 0;\n    kaku saw_digit = iie;\n    kaku saw_point = iie;\n    aida (offset < len(data) && data[offset] != 101 && data[offset] != 69) {\n        kaku current = data[offset];\n        moshi (current == 46) {\n            moshi (saw_point) { kaesu mu; }\n            saw_point = hai;\n        } sore {\n            moshi (current < 48 || current > 57) { kaesu mu; }\n            saw_digit = hai;\n            array.push(digits, current);\n            moshi (saw_point) { fractional_digits = fractional_digits + 1; }\n        }\n        offset = offset + 1;\n    }\n    moshi (!saw_digit) { kaesu mu; }\n\n    kaku explicit_exponent: int64 = 0;\n    moshi (offset < len(data)) {\n        offset = offset + 1;\n        kaku exponent_negative = iie;\n        moshi (offset < len(data) && (data[offset] == 43 || data[offset] == 45)) {\n            exponent_negative = data[offset] == 45;\n            offset = offset + 1;\n        }\n        moshi (offset == len(data)) { kaesu mu; }\n        aida (offset < len(data)) {\n            kaku current = data[offset];\n            moshi (current < 48 || current > 57) { kaesu mu; }\n            moshi (explicit_exponent < 20000) {\n                explicit_exponent = explicit_exponent * 10 + int64(current - 48);\n                moshi (explicit_exponent > 20000) { explicit_exponent = 20000; }\n            }\n            offset = offset + 1;\n        }\n        moshi (exponent_negative) { explicit_exponent = -explicit_exponent; }\n    }\n\n    kaku first: int64 = 0;\n    aida (first < len(digits) && digits[first] == 48) { first = first + 1; }\n    moshi (first == len(digits)) {\n        kaesu ParsedDecimal { negative: negative, zero: hai, significand: big_zero(), digits: 1, exponent10: 0 };\n    }\n    kaku last = len(digits) - 1;\n    aida (last > first && digits[last] == 48) { last = last - 1; }\n    kaku trailing = len(digits) - 1 - last;\n    kaku count = last - first + 1;\n    kaesu ParsedDecimal {\n        negative: negative,\n        zero: iie,\n        significand: big_from_decimal(digits, first, last + 1),\n        digits: count,\n        exponent10: explicit_exponent - fractional_digits + trailing,\n    };\n}\n\nwaza scale_float64(value: int64, exponent2: int64) -> float64 {\n    kaku result = float64(value);\n    kaku remaining = exponent2;\n    aida (remaining > 0) {\n        result = result * 2.0;\n        remaining = remaining - 1;\n    }\n    aida (remaining < 0) {\n        result = result / 2.0;\n        remaining = remaining + 1;\n    }\n    kaesu result;\n}\n\nwaza scale_float32(value: int64, exponent2: int64) -> float32 {\n    kaku result = float32(value);\n    kaku remaining = exponent2;\n    aida (remaining > 0) {\n        result = result * float32(2.0);\n        remaining = remaining - 1;\n    }\n    aida (remaining < 0) {\n        result = result / float32(2.0);\n        remaining = remaining + 1;\n    }\n    kaesu result;\n}\n\nkoukai waza parse_float64(value: string) -> float64? {\n    moshi (value == \"NaN\") { kaesu 0.0 / 0.0; }\n    moshi (value == \"Infinity\" || value == \"+Infinity\") { kaesu 1.0 / 0.0; }\n    moshi (value == \"-Infinity\") { kaesu -1.0 / 0.0; }\n    kaku parsed = parse_finite_decimal(string.to_bytes(value));\n    moshi (parsed == mu) { kaesu mu; }\n    moshi (parsed.zero) {\n        moshi (parsed.negative) { kaesu -0.0; }\n        kaesu 0.0;\n    }\n    kaku adjusted = parsed.digits + parsed.exponent10 - 1;\n    moshi (adjusted > 308) { kaesu mu; }\n    moshi (adjusted < -324) {\n        moshi (parsed.negative) { kaesu -0.0; }\n        kaesu 0.0;\n    }\n    kaku exponent2 = decimal_binary_exponent(parsed.significand, parsed.digits, parsed.exponent10);\n    kaku scale2 = exponent2 - 52;\n    moshi (exponent2 < -1022) { scale2 = -1074; }\n    kaku significand = decimal_round_binary(parsed.significand, parsed.exponent10, scale2, 53);\n    moshi (significand == 9007199254740992 && exponent2 >= 1023) { kaesu mu; }\n    kaku result = scale_float64(significand, scale2);\n    moshi (math.is_inf(result)) { kaesu mu; }\n    moshi (parsed.negative) { result = -result; }\n    kaesu result;\n}\n\nkoukai waza parse_float32(value: string) -> float32? {\n    moshi (value == \"NaN\") { kaesu float32(0.0) / float32(0.0); }\n    moshi (value == \"Infinity\" || value == \"+Infinity\") { kaesu float32(1.0) / float32(0.0); }\n    moshi (value == \"-Infinity\") { kaesu -float32(1.0) / float32(0.0); }\n    kaku parsed = parse_finite_decimal(string.to_bytes(value));\n    moshi (parsed == mu) { kaesu mu; }\n    moshi (parsed.zero) {\n        moshi (parsed.negative) { kaesu -float32(0.0); }\n        kaesu float32(0.0);\n    }\n    kaku adjusted = parsed.digits + parsed.exponent10 - 1;\n    moshi (adjusted > 38) { kaesu mu; }\n    moshi (adjusted < -46) {\n        moshi (parsed.negative) { kaesu -float32(0.0); }\n        kaesu float32(0.0);\n    }\n    kaku exponent2 = decimal_binary_exponent(parsed.significand, parsed.digits, parsed.exponent10);\n    kaku scale2 = exponent2 - 23;\n    moshi (exponent2 < -126) { scale2 = -149; }\n    kaku significand = decimal_round_binary(parsed.significand, parsed.exponent10, scale2, 24);\n    moshi (significand == 16777216 && exponent2 >= 127) { kaesu mu; }\n    kaku result = scale_float32(significand, scale2);\n    moshi (math.is_inf(result)) { kaesu mu; }\n    moshi (parsed.negative) { result = -result; }\n    kaesu result;\n}\n\nwaza exact_decimal(significand: int64, exponent2: int64) -> ParsedDecimal {\n    kaku coefficient = big_from_positive(significand);\n    kaku exponent10: int64 = 0;\n    moshi (exponent2 >= 0) {\n        big_multiply_power(coefficient, 2, exponent2);\n    } sore {\n        big_multiply_power(coefficient, 5, -exponent2);\n        exponent10 = exponent2;\n    }\n    aida (len(coefficient.limbs) > 0) {\n        kaku copy = big_clone(coefficient);\n        moshi (big_divide_small(copy, 10) != 0) { nukeru; }\n        coefficient = copy;\n        exponent10 = exponent10 + 1;\n    }\n    kaku digits = big_decimal_bytes(coefficient);\n    kaesu ParsedDecimal { negative: iie, zero: iie, significand: coefficient, digits: len(digits), exponent10: exponent10 };\n}\n\nwaza rounded_decimal_coefficient(digits: []uint8, precision: int64) -> int64 {\n    kaku coefficient: int64 = 0;\n    kaku index: int64 = 0;\n    aida (index < precision && index < len(digits)) {\n        coefficient = coefficient * 10 + int64(digits[index] - 48);\n        index = index + 1;\n    }\n    moshi (precision < len(digits)) {\n        kaku next = digits[precision] - 48;\n        kaku sticky = iie;\n        index = precision + 1;\n        aida (index < len(digits)) {\n            moshi (digits[index] != 48) {\n                sticky = hai;\n                nukeru;\n            }\n            index = index + 1;\n        }\n        moshi (next > 5 || (next == 5 && (sticky || coefficient - (coefficient / 2) * 2 != 0))) {\n            coefficient = coefficient + 1;\n        }\n    }\n    kaesu coefficient;\n}\n\nwaza decimal_candidate(coefficient_value: int64, exponent10_value: int64) -> string {\n    kaku coefficient = coefficient_value;\n    kaku exponent10 = exponent10_value;\n    aida (coefficient > 9 && coefficient - (coefficient / 10) * 10 == 0) {\n        coefficient = coefficient / 10;\n        exponent10 = exponent10 + 1;\n    }\n    kaku coefficient_bytes = string.to_bytes(format_int(coefficient));\n    kaku point = len(coefficient_bytes) + exponent10;\n\n    kaku fixed = bytes.buffer_with_capacity(len(coefficient_bytes) + 16);\n    moshi (point <= 0) {\n        bytes.write_byte(fixed, uint8(48));\n        bytes.write_byte(fixed, uint8(46));\n        kaku zeros = -point;\n        aida (zeros > 0) {\n            bytes.write_byte(fixed, uint8(48));\n            zeros = zeros - 1;\n        }\n        bytes.write(fixed, coefficient_bytes);\n    } sore {\n        moshi (point >= len(coefficient_bytes)) {\n            bytes.write(fixed, coefficient_bytes);\n            kaku zeros = point - len(coefficient_bytes);\n            aida (zeros > 0) {\n                bytes.write_byte(fixed, uint8(48));\n                zeros = zeros - 1;\n            }\n        } sore {\n            kaku index: int64 = 0;\n            aida (index < len(coefficient_bytes)) {\n                moshi (index == point) { bytes.write_byte(fixed, uint8(46)); }\n                bytes.write_byte(fixed, coefficient_bytes[index]);\n                index = index + 1;\n            }\n        }\n    }\n\n    kaku scientific = bytes.buffer_with_capacity(len(coefficient_bytes) + 16);\n    bytes.write_byte(scientific, coefficient_bytes[0]);\n    moshi (len(coefficient_bytes) > 1) {\n        bytes.write_byte(scientific, uint8(46));\n        kaku index: int64 = 1;\n        aida (index < len(coefficient_bytes)) {\n            bytes.write_byte(scientific, coefficient_bytes[index]);\n            index = index + 1;\n        }\n    }\n    kaku scientific_exponent = exponent10 + len(coefficient_bytes) - 1;\n    moshi (scientific_exponent != 0) {\n        bytes.write_byte(scientific, uint8(101));\n        moshi (scientific_exponent > 0) { bytes.write_byte(scientific, uint8(43)); }\n        bytes.write(scientific, string.to_bytes(format_int(scientific_exponent)));\n    }\n    kaku fixed_text = string.from_utf8(bytes.buffer_bytes(fixed));\n    kaku scientific_text = string.from_utf8(bytes.buffer_bytes(scientific));\n    moshi (fixed_text != mu) {\n        moshi (scientific_text != mu) {\n            moshi (string.byte_len(scientific_text) < string.byte_len(fixed_text)) { kaesu scientific_text; }\n            kaesu fixed_text;\n        }\n    }\n    kaesu \"\";\n}\n\nwaza roundtrip_candidate64(value: float64, coefficient: int64, exponent10: int64) -> string? {\n    kaku candidate = decimal_candidate(coefficient, exponent10);\n    kaku parsed = parse_float64(candidate);\n    moshi (parsed != mu) {\n        moshi (parsed == value) { kaesu candidate; }\n    }\n    kaesu mu;\n}\n\nwaza roundtrip_candidate32(value: float32, coefficient: int64, exponent10: int64) -> string? {\n    kaku candidate = decimal_candidate(coefficient, exponent10);\n    kaku parsed = parse_float32(candidate);\n    moshi (parsed != mu) {\n        moshi (parsed == value) { kaesu candidate; }\n    }\n    kaesu mu;\n}\n\nwaza shorter_candidate(current: string, candidate: string?) -> string {\n    moshi (candidate == mu) { kaesu current; }\n    moshi (current == \"\" || string.byte_len(candidate) < string.byte_len(current)) { kaesu candidate; }\n    kaesu current;\n}\n\nwaza format_finite_float64(value: float64) -> string {\n    kaku normalized = value;\n    kaku exponent2: int64 = 0;\n    aida (normalized >= 2.0) {\n        normalized = normalized / 2.0;\n        exponent2 = exponent2 + 1;\n    }\n    aida (normalized < 1.0) {\n        normalized = normalized * 2.0;\n        exponent2 = exponent2 - 1;\n    }\n    kaku factor: float64 = 1.0;\n    kaku count: int64 = 0;\n    aida (count < 52) {\n        factor = factor * 2.0;\n        count = count + 1;\n    }\n    kaku significand = int64(normalized * factor);\n    exponent2 = exponent2 - 52;\n    aida (significand - (significand / 2) * 2 == 0) {\n        significand = significand / 2;\n        exponent2 = exponent2 + 1;\n    }\n    kaku exact = exact_decimal(significand, exponent2);\n    kaku digits = big_decimal_bytes(exact.significand);\n    kaku lower: int64 = 1;\n    kaku upper: int64 = 17;\n    moshi (len(digits) < upper) { upper = len(digits); }\n    kaku best = \"\";\n    aida (lower <= upper) {\n        kaku precision = (lower + upper) / 2;\n        kaku coefficient = rounded_decimal_coefficient(digits, precision);\n        kaku exponent10 = exact.exponent10 + len(digits) - precision;\n        kaku current = roundtrip_candidate64(value, coefficient, exponent10);\n        kaku candidate = \"\";\n        moshi (current != mu) { candidate = current; }\n        moshi (coefficient > 0) {\n            candidate = shorter_candidate(candidate, roundtrip_candidate64(value, coefficient - 1, exponent10));\n        }\n        candidate = shorter_candidate(candidate, roundtrip_candidate64(value, coefficient + 1, exponent10));\n        moshi (candidate != \"\") {\n            best = candidate;\n            upper = precision - 1;\n        } sore {\n            lower = precision + 1;\n        }\n    }\n    kaesu best;\n}\n\nwaza format_finite_float32(value: float32) -> string {\n    kaku normalized = value;\n    kaku exponent2: int64 = 0;\n    aida (normalized >= float32(2.0)) {\n        normalized = normalized / float32(2.0);\n        exponent2 = exponent2 + 1;\n    }\n    aida (normalized < float32(1.0)) {\n        normalized = normalized * float32(2.0);\n        exponent2 = exponent2 - 1;\n    }\n    kaku factor: float32 = float32(1.0);\n    kaku count: int64 = 0;\n    aida (count < 23) {\n        factor = factor * float32(2.0);\n        count = count + 1;\n    }\n    kaku significand = int64(normalized * factor);\n    exponent2 = exponent2 - 23;\n    aida (significand - (significand / 2) * 2 == 0) {\n        significand = significand / 2;\n        exponent2 = exponent2 + 1;\n    }\n    kaku exact = exact_decimal(significand, exponent2);\n    kaku digits = big_decimal_bytes(exact.significand);\n    kaku lower: int64 = 1;\n    kaku upper: int64 = 9;\n    moshi (len(digits) < upper) { upper = len(digits); }\n    kaku best = \"\";\n    aida (lower <= upper) {\n        kaku precision = (lower + upper) / 2;\n        kaku coefficient = rounded_decimal_coefficient(digits, precision);\n        kaku exponent10 = exact.exponent10 + len(digits) - precision;\n        kaku current = roundtrip_candidate32(value, coefficient, exponent10);\n        kaku candidate = \"\";\n        moshi (current != mu) { candidate = current; }\n        moshi (coefficient > 0) {\n            candidate = shorter_candidate(candidate, roundtrip_candidate32(value, coefficient - 1, exponent10));\n        }\n        candidate = shorter_candidate(candidate, roundtrip_candidate32(value, coefficient + 1, exponent10));\n        moshi (candidate != \"\") {\n            best = candidate;\n            upper = precision - 1;\n        } sore {\n            lower = precision + 1;\n        }\n    }\n    kaesu best;\n}\n\nkoukai waza format_float64(value: float64) -> string {\n    moshi (math.is_nan(value)) { kaesu \"NaN\"; }\n    moshi (math.is_inf(value)) {\n        moshi (value < 0.0) { kaesu \"-Infinity\"; }\n        kaesu \"Infinity\";\n    }\n    moshi (value == 0.0) {\n        moshi (1.0 / value < 0.0) { kaesu \"-0\"; }\n        kaesu \"0\";\n    }\n    moshi (value < 0.0) { kaesu string.concat(\"-\", format_finite_float64(-value)); }\n    kaesu format_finite_float64(value);\n}\n\nkoukai waza format_float32(value: float32) -> string {\n    moshi (math.is_nan(value)) { kaesu \"NaN\"; }\n    moshi (math.is_inf(value)) {\n        moshi (value < float32(0.0)) { kaesu \"-Infinity\"; }\n        kaesu \"Infinity\";\n    }\n    moshi (value == float32(0.0)) {\n        moshi (float32(1.0) / value < float32(0.0)) { kaesu \"-0\"; }\n        kaesu \"0\";\n    }\n    moshi (value < float32(0.0)) { kaesu string.concat(\"-\", format_finite_float32(-value)); }\n    kaesu format_finite_float32(value);\n}\n" }; }
waza data_72() -> File { kaesu File { path: "kiso/crypto/sha256/sha256.mio", version: "Bunko-v2.1.1", length: 23761, sha256: "de9e7e6a3090114a6b891b64ad7e51c78e33e1cbf3aa487f6cff3e8024e00d8e", source: "yobu \"kiso/array\";\n\n// Immutable arithmetic lookup tables; no host crypto or foreign compiler is\n// involved. Values stay nonnegative int64 while sums wrap modulo 2^32.\nkoukai kata Context {\n    xor_nibbles: []int64;\n    powers: []int64;\n    constants: []int64;\n    byte_tables: []Tables;\n}\n\nkoukai waza context() -> Context {\n    kaku table: []int64 = [];\n    kaku b = 0;\n    aida (b < 16) {\n        kaku a = 0;\n        aida (a < 16) {\n            kaku left = a;\n            kaku right = b;\n            kaku power = 1;\n            kaku result = 0;\n            kaku bit = 0;\n            aida (bit < 4) {\n                kaku x = left - (left / 2) * 2;\n                kaku y = right - (right / 2) * 2;\n                moshi (x != y) { result = result + power; }\n                left = left / 2;\n                right = right / 2;\n                power = power * 2;\n                bit = bit + 1;\n            }\n            array.push(table, result);\n            a = a + 1;\n        }\n        b = b + 1;\n    }\n    kaku powers: []int64 = [1];\n    kaku at = 0;\n    aida (at < 32) {\n        array.push(powers, powers[at] * 2);\n        at = at + 1;\n    }\n    kaku cache: []Tables = [];\n    kaesu Context { xor_nibbles: table, powers: powers, byte_tables: cache, constants: [\n            1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,\n            3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,\n            3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,\n            2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,\n            666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,\n            2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,\n            430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,\n            1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298] };\n}\n\n// Byte-sliced SHA-256. Mio has no bitwise operators, so XOR/AND of two bytes are two lookups in the 16x16 nibble XOR\n// table (via 256-entry nibble-split tables) and shifts are lookups in 9x256 tables. A 32-bit word is split into its four bytes once (three divisions) and all\n// rotations, Sigma/sigma, Ch and Maj work on bytes; additions stay on int64 values and wrap by subtraction. The\n// tables are built on first use and cached in the context, so reusing one context (as signing does) builds them once.\nkoukai kata Tables {\n    nib: []int64;\n    nib16: []int64;\n    low: []int64;\n    low16: []int64;\n    high: []int64;\n    high16: []int64;\n    shr: []int64;\n    shl: []int64;\n}\n\nwaza tables(ctx: Context) -> Tables {\n    moshi (len(ctx.byte_tables) > 0) { kaesu ctx.byte_tables[0]; }\n    // low/high nibble of every byte value, pre-scaled for the 16x16 nibble XOR table\n    kaku low = array.make[int64](256, 0);\n    kaku low16 = array.make[int64](256, 0);\n    kaku high = array.make[int64](256, 0);\n    kaku high16 = array.make[int64](256, 0);\n    kaku v = 0;\n    aida (v < 256) {\n        kaku h = v / 16;\n        high[v] = h;\n        high16[v] = h * 16;\n        low[v] = v - h * 16;\n        low16[v] = low[v] * 16;\n        v = v + 1;\n    }\n    kaku nib16 = array.make[int64](256, 0);\n    v = 0;\n    aida (v < 256) {\n        nib16[v] = ctx.xor_nibbles[v] * 16;\n        v = v + 1;\n    }\n    kaku shr = array.make[int64](9 * 256, 0);\n    kaku shl = array.make[int64](9 * 256, 0);\n    kaku shift = 0;\n    aida (shift <= 8) {\n        v = 0;\n        aida (v < 256) {\n            shr[shift * 256 + v] = v / ctx.powers[shift];\n            kaku left = v * ctx.powers[shift];\n            shl[shift * 256 + v] = left - (left / 256) * 256;\n            v = v + 1;\n        }\n        shift = shift + 1;\n    }\n    kaku built = Tables { nib: ctx.xor_nibbles, nib16: nib16, low: low, low16: low16, high: high, high16: high16, shr: shr, shl: shl };\n    array.push(ctx.byte_tables, built);\n    kaesu built;\n}\n\n// XOR and AND of two bytes: two lookups in the 16x16 nibble XOR table.\nwaza bx(t: Tables, a: int64, b: int64) -> int64 { kaesu t.nib[t.low[a] + t.low16[b]] + t.nib16[t.high[a] + t.high16[b]]; }\nwaza band(t: Tables, a: int64, b: int64) -> int64 { kaesu (a + b - bx(t, a, b)) / 2; }\n\nwaza wrap_sum(value: int64) -> int64 {\n    kaku result = value;\n    aida (result >= 4294967296) { result = result - 4294967296; }\n    kaesu result;\n}\n\n// bytes[base .. base + 3] = value (big endian)\nwaza split(value: int64, bytes: []int64, base: int64) -> unit {\n    kaku b0 = value / 16777216;\n    kaku rest = value - b0 * 16777216;\n    kaku b1 = rest / 65536;\n    rest = rest - b1 * 65536;\n    kaku b2 = rest / 256;\n    bytes[base] = b0;\n    bytes[base + 1] = b1;\n    bytes[base + 2] = b2;\n    bytes[base + 3] = rest - b2 * 256;\n}\n\n// Byte i of ROTR(word, 8q + s) (rotate) or SHR(word, 8q + s) (shift) of the big-endian word at bytes[base].\nwaza rot_byte(t: Tables, bytes: []int64, base: int64, i: int64, q: int64, s: int64, shift: bool) -> int64 {\n    kaku k = i - q;\n    kaku high = 0;\n    kaku low = 0;\n    moshi (shift) {\n        moshi (k >= 0) { high = bytes[base + k]; }\n        moshi (k >= 1) { low = bytes[base + k - 1]; }\n    } sore {\n        moshi (k < 0) { k = k + 4; }\n        high = bytes[base + k];\n        kaku previous = k - 1;\n        moshi (previous < 0) {\n            previous = previous + 4;\n        }\n        low = bytes[base + previous];\n    }\n    kaku complement = 8 - s;\n    kaesu t.shr[s * 256 + high] + t.shl[complement * 256 + low];\n}\n\n// ROTR(n1) ^ ROTR(n2) ^ (ROTR or SHR)(n3) of the word at bytes[base], as an int64.\nwaza sigma_bytes(t: Tables, bytes: []int64, base: int64, n1: int64, n2: int64, n3: int64, small: bool) -> int64 {\n    kaku q1 = n1 / 8;\n    kaku s1 = n1 - q1 * 8;\n    kaku q2 = n2 / 8;\n    kaku s2 = n2 - q2 * 8;\n    kaku q3 = n3 / 8;\n    kaku s3 = n3 - q3 * 8;\n    kaku value = 0;\n    kaku i = 0;\n    aida (i < 4) {\n        kaku r1 = rot_byte(t, bytes, base, i, q1, s1, iie);\n        kaku r2 = rot_byte(t, bytes, base, i, q2, s2, iie);\n        kaku r3 = rot_byte(t, bytes, base, i, q3, s3, small);\n        value = value * 256 + bx(t, bx(t, r1, r2), r3);\n        i = i + 1;\n    }\n    kaesu value;\n}\n\n// Hash a range without allocating a copy of the input. Invalid ranges return an empty digest; callers must check the\n// 32-byte result.\nkoukai waza sum_range(ctx: Context, data: []uint8, start: int64, length: int64) -> []uint8 {\n    moshi (start < 0 || length < 0 || start > len(data) || length > len(data) - start) { kaesu []; }\n    moshi (length >= fast_threshold) { kaesu sum_range_fast(ctx, data, start, length); }\n    kaesu sum_range_small(ctx, data, start, length);\n}\n\nwaza sum_range_small(ctx: Context, data: []uint8, start: int64, length: int64) -> []uint8 {\n    kaku t = tables(ctx);\n    kaku state: []int64 = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225];\n    kaku words = array.make[int64](64, 0);\n    kaku wbytes = array.make[int64](256, 0);\n    // working variables a..h: values and their bytes (rotated by reference each round)\n    kaku vb = array.make[int64](32, 0);\n    kaku tail = array.make[int64](128, 0);\n    kaku full = length / 64;\n    kaku blocks = (length + 9 + 63) / 64;\n    kaku block = 0;\n    // the padded tail (last one or two blocks)\n    kaku tail_start = full * 64;\n    kaku at = 0;\n    aida (at < length - tail_start) {\n        tail[at] = int64(data[start + tail_start + at]);\n        at = at + 1;\n    }\n    tail[length - tail_start] = 128;\n    kaku bits = length * 8;\n    kaku position = (blocks - full) * 64 - 1;\n    aida (bits > 0) {\n        kaku high = bits / 256;\n        tail[position] = bits - high * 256;\n        bits = high;\n        position = position - 1;\n    }\n    aida (block < blocks) {\n        kaku at = 0;\n        aida (at < 16) {\n            kaku b0 = 0;\n            kaku b1 = 0;\n            kaku b2 = 0;\n            kaku b3 = 0;\n            moshi (block < full) {\n                kaku offset = start + block * 64 + at * 4;\n                b0 = int64(data[offset]);\n                b1 = int64(data[offset + 1]);\n                b2 = int64(data[offset + 2]);\n                b3 = int64(data[offset + 3]);\n            } sore {\n                kaku offset = (block - full) * 64 + at * 4;\n                b0 = tail[offset];\n                b1 = tail[offset + 1];\n                b2 = tail[offset + 2];\n                b3 = tail[offset + 3];\n            }\n            wbytes[at * 4] = b0;\n            wbytes[at * 4 + 1] = b1;\n            wbytes[at * 4 + 2] = b2;\n            wbytes[at * 4 + 3] = b3;\n            words[at] = ((b0 * 256 + b1) * 256 + b2) * 256 + b3;\n            at = at + 1;\n        }\n        aida (at < 64) {\n            kaku value = wrap_sum(sigma_bytes(t, wbytes, (at - 2) * 4, 17, 19, 10, hai) + words[at - 7] +\n                sigma_bytes(t, wbytes, (at - 15) * 4, 7, 18, 3, hai) + words[at - 16]);\n            words[at] = value;\n            split(value, wbytes, at * 4);\n            at = at + 1;\n        }\n        // vb holds the bytes of a, b, c, d, e, f, g, h at 0, 4, ..., 28; slot[] maps a variable to its 4-byte group so\n        // the per-round shuffle moves indices, not bytes.\n        kaku a = state[0];\n        kaku b = state[1];\n        kaku c = state[2];\n        kaku d = state[3];\n        kaku e = state[4];\n        kaku f = state[5];\n        kaku g = state[6];\n        kaku h = state[7];\n        kaku ia = 0;\n        kaku ib = 4;\n        kaku ic = 8;\n        kaku id = 12;\n        kaku ie = 16;\n        kaku iff = 20;\n        kaku ig = 24;\n        kaku ih = 28;\n        split(a, vb, ia);\n        split(b, vb, ib);\n        split(c, vb, ic);\n        split(d, vb, id);\n        split(e, vb, ie);\n        split(f, vb, iff);\n        split(g, vb, ig);\n        split(h, vb, ih);\n        at = 0;\n        aida (at < 64) {\n            kaku choice = 0;\n            kaku majority = 0;\n            kaku i = 0;\n            aida (i < 4) {\n                kaku eb = vb[ie + i];\n                kaku fb = vb[iff + i];\n                kaku gb = vb[ig + i];\n                kaku ab = vb[ia + i];\n                kaku bb = vb[ib + i];\n                kaku cb = vb[ic + i];\n                choice = choice * 256 + bx(t, gb, band(t, eb, bx(t, fb, gb)));\n                kaku axb = bx(t, ab, bb);\n                majority = majority * 256 + bx(t, band(t, ab, bb), band(t, cb, axb));\n                i = i + 1;\n            }\n            kaku first = wrap_sum(h + sigma_bytes(t, vb, ie, 6, 11, 25, iie) + choice + ctx.constants[at] + words[at]);\n            kaku second = wrap_sum(sigma_bytes(t, vb, ia, 2, 13, 22, iie) + majority);\n            // h <- g <- f <- e <- d + first; d <- c <- b <- a <- first + second (reusing the byte groups of h and d)\n            kaku free_e = ih;\n            kaku free_a = id;\n            h = g;\n            ih = ig;\n            g = f;\n            ig = iff;\n            f = e;\n            iff = ie;\n            e = wrap_sum(d + first);\n            ie = free_e;\n            split(e, vb, ie);\n            d = c;\n            id = ic;\n            c = b;\n            ic = ib;\n            b = a;\n            ib = ia;\n            a = wrap_sum(first + second);\n            ia = free_a;\n            split(a, vb, ia);\n            at = at + 1;\n        }\n        state[0] = wrap_sum(state[0] + a);\n        state[1] = wrap_sum(state[1] + b);\n        state[2] = wrap_sum(state[2] + c);\n        state[3] = wrap_sum(state[3] + d);\n        state[4] = wrap_sum(state[4] + e);\n        state[5] = wrap_sum(state[5] + f);\n        state[6] = wrap_sum(state[6] + g);\n        state[7] = wrap_sum(state[7] + h);\n        block = block + 1;\n    }\n    kaku output: []uint8 = [];\n    kaku oat = 0;\n    kaku digest = array.make[int64](4, 0);\n    aida (oat < 8) {\n        split(state[oat], digest, 0);\n        array.push(output, uint8(digest[0]));\n        array.push(output, uint8(digest[1]));\n        array.push(output, uint8(digest[2]));\n        array.push(output, uint8(digest[3]));\n        oat = oat + 1;\n    }\n    kaesu output;\n}\n// Inputs of at least this many bytes (one code-signing page) use 256x256 byte tables built once per context and a\n// call-free compression loop; smaller inputs keep the light path above. Both compute the same digest.\nteisu fast_threshold = 4096;\n\nwaza fast_tables(ctx: Context) -> []int64 {\n    // [0, 65536) XOR, [65536, 131072) AND, then 9x256 SHR and 9x256 SHL rows\n    moshi (len(ctx.byte_tables) > 1) { kaesu ctx.byte_tables[1].shr; }\n    kaku t = tables(ctx);\n    kaku table = array.make[int64](sigma_base + 16384, 0);\n    kaku a = 0;\n    kaku index = 0;\n    aida (a < 256) {\n        kaku la = t.low[a];\n        kaku ha = t.high[a];\n        kaku b = 0;\n        aida (b < 256) {\n            kaku x = t.nib[la + t.low16[b]] + t.nib16[ha + t.high16[b]];\n            table[index] = x;\n            table[65536 + index] = (a + b - x) / 2;\n            b = b + 1;\n            index = index + 1;\n        }\n        a = a + 1;\n    }\n    kaku at = 0;\n    aida (at < 2304) {\n        table[131072 + at] = t.shr[at];\n        table[131072 + 2304 + at] = t.shl[at];\n        at = at + 1;\n    }\n    // Sigma tables: the four functions are XOR-linear, so f(w) = T[f][0][b0] ^ T[f][1][b1] ^ T[f][2][b2] ^ T[f][3][b3]\n    // for the bytes b0..b3 of w (b0 most significant); T[f][j][v] holds the four output bytes of f(v << 8 (3 - j)).\n    // f: 0 Sigma1 (6, 11, 25), 1 Sigma0 (2, 13, 22), 2 sigma0 (7, 18, >>3), 3 sigma1 (17, 19, >>10).\n    kaku amounts = [6, 11, 25, 2, 13, 22, 7, 18, 3, 17, 19, 10];\n    kaku f = 0;\n    aida (f < 4) {\n        kaku j = 0;\n        aida (j < 4) {\n            kaku v = 0;\n            aida (v < 256) {\n                kaku word = v * ctx.powers[8 * (3 - j)];\n                kaku r1 = rotr32(ctx, word, amounts[f * 3]);\n                kaku r2 = rotr32(ctx, word, amounts[f * 3 + 1]);\n                kaku r3 = rotr32(ctx, word, amounts[f * 3 + 2]);\n                moshi (f >= 2) {\n                    r3 = word / ctx.powers[amounts[f * 3 + 2]];\n                }\n                kaku bi = 0;\n                kaku divisor = 16777216;\n                aida (bi < 4) {\n                    kaku y1 = (r1 / divisor) - (r1 / divisor / 256) * 256;\n                    kaku y2 = (r2 / divisor) - (r2 / divisor / 256) * 256;\n                    kaku y3 = (r3 / divisor) - (r3 / divisor / 256) * 256;\n                    kaku y12 = table[y1 * 256 + y2];\n                    table[sigma_base + ((f * 4 + j) * 256 + v) * 4 + bi] = table[y12 * 256 + y3];\n                    divisor = divisor / 256;\n                    bi = bi + 1;\n                }\n                v = v + 1;\n            }\n            j = j + 1;\n        }\n        f = f + 1;\n    }\n    array.push(ctx.byte_tables, Tables { nib: [], nib16: [], low: [], low16: [], high: [], high16: [], shr: table, shl: [] });\n    kaesu table;\n}\n\nteisu sigma_base = 131072 + 4608;\n\nwaza rotr32(ctx: Context, word: int64, count: int64) -> int64 {\n    kaku high = word * ctx.powers[32 - count];\n    kaku wrapped = high - (high / 4294967296) * 4294967296;\n    kaesu word / ctx.powers[count] + wrapped;\n}\n\n// Word layout in the fast path: 12 entries per word, [0, 0, 0, 0, b0, b1, b2, b3, b0, b1, b2, b3] (b0 most significant).\n// Byte i of ROTR(w, 8q + s) is SHR_s(e[8 + i - q]) + SHL_(8-s)(e[7 + i - q]); of SHR(w, 8q + s) it is\n// SHR_s(e[4 + i - q]) + SHL_(8-s)(e[3 + i - q]), the leading zeros supplying the shifted-in bits.\nwaza put_word(bytes: []int64, base: int64, value: int64) -> unit {\n    kaku b0 = value / 16777216;\n    kaku rest = value - b0 * 16777216;\n    kaku b1 = rest / 65536;\n    rest = rest - b1 * 65536;\n    kaku b2 = rest / 256;\n    kaku b3 = rest - b2 * 256;\n    bytes[base + 4] = b0;\n    bytes[base + 5] = b1;\n    bytes[base + 6] = b2;\n    bytes[base + 7] = b3;\n    bytes[base + 8] = b0;\n    bytes[base + 9] = b1;\n    bytes[base + 10] = b2;\n    bytes[base + 11] = b3;\n}\n\n// One SHA-256 compression: state[0..7] (32-bit values) absorbs the block whose words are words[0..15] and whose bytes are\n// laid out in bytes as described above; words[16..63] and bytes are scratch. The Darwin/ARM64 backend implements calls to\n// this exact function with the ARMv8 SHA-256 instructions (x and bytes are then unused); it must keep this signature.\nwaza sha256_compress_native_block(state: []int64, words: []int64, k: []int64, x: []int64, bytes: []int64) -> unit {\n    kaku at = 16;\n    aida (at < 64) {\n        kaku s1 = 0;\n        kaku s0 = 0;\n        kaku i = 0;\n        kaku p = (at - 2) * 12 + 4;\n        kaku q = (at - 15) * 12 + 4;\n        kaku p0 = sigma_base + (3 * 1024 + bytes[p]) * 4;\n        kaku p1 = sigma_base + (3 * 1024 + 256 + bytes[p + 1]) * 4;\n        kaku p2 = sigma_base + (3 * 1024 + 512 + bytes[p + 2]) * 4;\n        kaku p3 = sigma_base + (3 * 1024 + 768 + bytes[p + 3]) * 4;\n        kaku q0 = sigma_base + (2 * 1024 + bytes[q]) * 4;\n        kaku q1 = sigma_base + (2 * 1024 + 256 + bytes[q + 1]) * 4;\n        kaku q2 = sigma_base + (2 * 1024 + 512 + bytes[q + 2]) * 4;\n        kaku q3 = sigma_base + (2 * 1024 + 768 + bytes[q + 3]) * 4;\n        aida (i < 4) {\n            kaku u01 = x[x[p0 + i] * 256 + x[p1 + i]];\n            kaku u23 = x[x[p2 + i] * 256 + x[p3 + i]];\n            s1 = s1 * 256 + x[u01 * 256 + u23];\n            kaku v01 = x[x[q0 + i] * 256 + x[q1 + i]];\n            kaku v23 = x[x[q2 + i] * 256 + x[q3 + i]];\n            s0 = s0 * 256 + x[v01 * 256 + v23];\n            i = i + 1;\n        }\n        kaku value = s1 + words[at - 7] + s0 + words[at - 16];\n        aida (value >= 4294967296) { value = value - 4294967296; }\n        words[at] = value;\n        put_word(bytes, at * 12, value);\n        at = at + 1;\n    }\n    kaku a = state[0];\n    kaku b = state[1];\n    kaku c = state[2];\n    kaku d = state[3];\n    kaku e = state[4];\n    kaku f = state[5];\n    kaku g = state[6];\n    kaku h = state[7];\n    // byte groups of the working variables; the round shuffle permutes these offsets, not bytes\n    kaku sa = 768;\n    kaku sb = 780;\n    kaku sc = 792;\n    kaku sd = 804;\n    kaku se = 816;\n    kaku sf = 828;\n    kaku sg = 840;\n    kaku sh = 852;\n    put_word(bytes, sa, a);\n    put_word(bytes, sb, b);\n    put_word(bytes, sc, c);\n    put_word(bytes, sd, d);\n    put_word(bytes, se, e);\n    put_word(bytes, sf, f);\n    put_word(bytes, sg, g);\n    put_word(bytes, sh, h);\n    at = 0;\n    aida (at < 64) {\n        kaku sigma1 = 0;\n        kaku sigma0 = 0;\n        kaku choice = 0;\n        kaku majority = 0;\n        kaku i = 0;\n        kaku e0 = sigma_base + bytes[se + 4] * 4;\n        kaku e1 = sigma_base + (256 + bytes[se + 5]) * 4;\n        kaku e2 = sigma_base + (512 + bytes[se + 6]) * 4;\n        kaku e3 = sigma_base + (768 + bytes[se + 7]) * 4;\n        kaku a0 = sigma_base + (1024 + bytes[sa + 4]) * 4;\n        kaku a1 = sigma_base + (1280 + bytes[sa + 5]) * 4;\n        kaku a2 = sigma_base + (1536 + bytes[sa + 6]) * 4;\n        kaku a3 = sigma_base + (1792 + bytes[sa + 7]) * 4;\n        aida (i < 4) {\n            kaku u01 = x[x[e0 + i] * 256 + x[e1 + i]];\n            kaku u23 = x[x[e2 + i] * 256 + x[e3 + i]];\n            sigma1 = sigma1 * 256 + x[u01 * 256 + u23];\n            kaku v01 = x[x[a0 + i] * 256 + x[a1 + i]];\n            kaku v23 = x[x[a2 + i] * 256 + x[a3 + i]];\n            sigma0 = sigma0 * 256 + x[v01 * 256 + v23];\n            kaku eb = bytes[se + 4 + i];\n            kaku fb = bytes[sf + 4 + i];\n            kaku gb = bytes[sg + 4 + i];\n            kaku ab = bytes[sa + 4 + i];\n            kaku bb = bytes[sb + 4 + i];\n            kaku cb = bytes[sc + 4 + i];\n            choice = choice * 256 + x[gb * 256 + x[65536 + eb * 256 + x[fb * 256 + gb]]];\n            majority = majority * 256 + x[x[65536 + ab * 256 + bb] * 256 + x[65536 + cb * 256 + x[ab * 256 + bb]]];\n            i = i + 1;\n        }\n        kaku first = h + sigma1 + choice + k[at] + words[at];\n        aida (first >= 4294967296) { first = first - 4294967296; }\n        kaku second = sigma0 + majority;\n        aida (second >= 4294967296) { second = second - 4294967296; }\n        kaku free_e = sh;\n        kaku free_a = sd;\n        h = g;\n        sh = sg;\n        g = f;\n        sg = sf;\n        f = e;\n        sf = se;\n        e = d + first;\n        aida (e >= 4294967296) {\n            e = e - 4294967296;\n        }\n        se = free_e;\n        d = c;\n        sd = sc;\n        c = b;\n        sc = sb;\n        b = a;\n        sb = sa;\n        a = first + second;\n        aida (a >= 4294967296) {\n            a = a - 4294967296;\n        }\n        sa = free_a;\n        put_word(bytes, se, e);\n        put_word(bytes, sa, a);\n        at = at + 1;\n    }\n    state[0] = wrap_sum(state[0] + a);\n    state[1] = wrap_sum(state[1] + b);\n    state[2] = wrap_sum(state[2] + c);\n    state[3] = wrap_sum(state[3] + d);\n    state[4] = wrap_sum(state[4] + e);\n    state[5] = wrap_sum(state[5] + f);\n    state[6] = wrap_sum(state[6] + g);\n    state[7] = wrap_sum(state[7] + h);\n}\n\nwaza sum_range_fast(ctx: Context, data: []uint8, start: int64, length: int64) -> []uint8 {\n    kaku x = fast_tables(ctx);\n    kaku state: []int64 = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225];\n    kaku words = array.make[int64](64, 0);\n    // W[0..63] at 12t, working variables at 768 + 12v; the four leading entries of every word stay zero\n    kaku bytes = array.make[int64](768 + 96, 0);\n    kaku tail = array.make[int64](128, 0);\n    kaku full = length / 64;\n    kaku blocks = (length + 9 + 63) / 64;\n    kaku tail_start = full * 64;\n    kaku at = 0;\n    aida (at < length - tail_start) {\n        tail[at] = int64(data[start + tail_start + at]);\n        at = at + 1;\n    }\n    tail[length - tail_start] = 128;\n    kaku bits = length * 8;\n    kaku position = (blocks - full) * 64 - 1;\n    aida (bits > 0) {\n        kaku high = bits / 256;\n        tail[position] = bits - high * 256;\n        bits = high;\n        position = position - 1;\n    }\n    kaku block = 0;\n    aida (block < blocks) {\n        at = 0;\n        aida (at < 16) {\n            kaku b0 = 0;\n            kaku b1 = 0;\n            kaku b2 = 0;\n            kaku b3 = 0;\n            moshi (block < full) {\n                kaku offset = start + block * 64 + at * 4;\n                b0 = int64(data[offset]);\n                b1 = int64(data[offset + 1]);\n                b2 = int64(data[offset + 2]);\n                b3 = int64(data[offset + 3]);\n            } sore {\n                kaku offset = (block - full) * 64 + at * 4;\n                b0 = tail[offset];\n                b1 = tail[offset + 1];\n                b2 = tail[offset + 2];\n                b3 = tail[offset + 3];\n            }\n            kaku base = at * 12;\n            bytes[base + 4] = b0;\n            bytes[base + 5] = b1;\n            bytes[base + 6] = b2;\n            bytes[base + 7] = b3;\n            bytes[base + 8] = b0;\n            bytes[base + 9] = b1;\n            bytes[base + 10] = b2;\n            bytes[base + 11] = b3;\n            words[at] = ((b0 * 256 + b1) * 256 + b2) * 256 + b3;\n            at = at + 1;\n        }\n        sha256_compress_native_block(state, words, ctx.constants, x, bytes);\n        block = block + 1;\n    }\n    kaku output: []uint8 = [];\n    kaku oat = 0;\n    kaku digest = array.make[int64](4, 0);\n    aida (oat < 8) {\n        split(state[oat], digest, 0);\n        array.push(output, uint8(digest[0]));\n        array.push(output, uint8(digest[1]));\n        array.push(output, uint8(digest[2]));\n        array.push(output, uint8(digest[3]));\n        oat = oat + 1;\n    }\n    kaesu output;\n}\n\nkoukai waza sum(data: []uint8) -> []uint8 { kaesu sum_range(context(), data, 0, len(data)); }\n" }; }
waza data_73() -> File { kaesu File { path: "kiso/encoding/binary/binary.mio", version: "Bunko-v2.1.1", length: 13323, sha256: "a6c2ec249c1c206219af179f5da2b9531210b8e8f67e3e33c13d02b69ad7ac5d", source: "yobu \"kiso/array\";\n\nkoukai sentaku BinaryError {\n    InvalidOffset;\n    InsufficientData;\n    Overflow;\n    MalformedVarint;\n}\n\nkoukai kata U8Result {\n    value: uint8;\n    error: BinaryError?;\n}\nkoukai kata U16Result {\n    value: uint16;\n    error: BinaryError?;\n}\nkoukai kata U32Result {\n    value: uint32;\n    error: BinaryError?;\n}\nkoukai kata I8Result {\n    value: int8;\n    error: BinaryError?;\n}\nkoukai kata I16Result {\n    value: int16;\n    error: BinaryError?;\n}\nkoukai kata I32Result {\n    value: int32;\n    error: BinaryError?;\n}\nkoukai kata I64Result {\n    value: int64;\n    error: BinaryError?;\n}\nkoukai kata BytesResult {\n    data: []uint8;\n    error: BinaryError?;\n}\nkoukai kata VarU32Result {\n    value: uint32;\n    count: int64;\n    error: BinaryError?;\n}\nkoukai kata VarI64Result {\n    value: int64;\n    count: int64;\n    error: BinaryError?;\n}\n\nwaza range_error(data: []uint8, offset: int64, width: int64) -> BinaryError? {\n    moshi (offset < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (offset > len(data) || width > len(data) - offset) { kaesu BinaryError.InsufficientData(); }\n    kaesu mu;\n}\n\nkoukai waza read_u8(data: []uint8, offset: int64) -> U8Result {\n    kaku failure = range_error(data, offset, 1);\n    moshi (failure != mu) { kaesu U8Result { value: uint8(0), error: failure }; }\n    kaesu U8Result { value: data[offset], error: mu };\n}\n\nkoukai waza read_u16_le(data: []uint8, offset: int64) -> U16Result {\n    kaku failure = range_error(data, offset, 2);\n    moshi (failure != mu) { kaesu U16Result { value: uint16(0), error: failure }; }\n    kaesu U16Result { value: uint16(int64(data[offset]) + int64(data[offset + 1]) * 256), error: mu };\n}\n\nkoukai waza read_u16_be(data: []uint8, offset: int64) -> U16Result {\n    kaku failure = range_error(data, offset, 2);\n    moshi (failure != mu) { kaesu U16Result { value: uint16(0), error: failure }; }\n    kaesu U16Result { value: uint16(int64(data[offset]) * 256 + int64(data[offset + 1])), error: mu };\n}\n\nkoukai waza read_u32_le(data: []uint8, offset: int64) -> U32Result {\n    kaku failure = range_error(data, offset, 4);\n    moshi (failure != mu) { kaesu U32Result { value: uint32(0), error: failure }; }\n    kaku value = int64(data[offset]) + int64(data[offset + 1]) * 256 + int64(data[offset + 2]) * 65536 + int64(data[offset + 3]) * 16777216;\n    kaesu U32Result { value: uint32(value), error: mu };\n}\n\nkoukai waza read_u32_be(data: []uint8, offset: int64) -> U32Result {\n    kaku failure = range_error(data, offset, 4);\n    moshi (failure != mu) { kaesu U32Result { value: uint32(0), error: failure }; }\n    kaku value = int64(data[offset]) * 16777216 + int64(data[offset + 1]) * 65536 + int64(data[offset + 2]) * 256 + int64(data[offset + 3]);\n    kaesu U32Result { value: uint32(value), error: mu };\n}\n\nkoukai waza read_i8(data: []uint8, offset: int64) -> I8Result {\n    kaku unsigned = read_u8(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I8Result { value: int8(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 128) { value = value - 256; }\n    kaesu I8Result { value: int8(value), error: mu };\n}\n\nkoukai waza read_i16_le(data: []uint8, offset: int64) -> I16Result {\n    kaku unsigned = read_u16_le(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I16Result { value: int16(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 32768) { value = value - 65536; }\n    kaesu I16Result { value: int16(value), error: mu };\n}\n\nkoukai waza read_i16_be(data: []uint8, offset: int64) -> I16Result {\n    kaku unsigned = read_u16_be(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I16Result { value: int16(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 32768) { value = value - 65536; }\n    kaesu I16Result { value: int16(value), error: mu };\n}\n\nkoukai waza read_i32_le(data: []uint8, offset: int64) -> I32Result {\n    kaku unsigned = read_u32_le(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I32Result { value: int32(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 2147483648) { value = value - 4294967296; }\n    kaesu I32Result { value: int32(value), error: mu };\n}\n\nkoukai waza read_i32_be(data: []uint8, offset: int64) -> I32Result {\n    kaku unsigned = read_u32_be(data, offset);\n    kaku failure = unsigned.error;\n    moshi (failure != mu) { kaesu I32Result { value: int32(0), error: failure }; }\n    kaku value = int64(unsigned.value);\n    moshi (value >= 2147483648) { value = value - 4294967296; }\n    kaesu I32Result { value: int32(value), error: mu };\n}\n\nwaza read_i64_order(data: []uint8, offset: int64, little: bool) -> I64Result {\n    kaku failure = range_error(data, offset, 8);\n    moshi (failure != mu) { kaesu I64Result { value: 0, error: failure }; }\n    kaku value = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 7) {\n        kaku byte_index = offset + index;\n        moshi (!little) { byte_index = offset + 7 - index; }\n        value = value + int64(data[byte_index]) * factor;\n        factor = factor * 256;\n        index = index + 1;\n    }\n    kaku top_index = offset + 7;\n    moshi (!little) { top_index = offset; }\n    value = value + (int64(data[top_index]) - 256) * factor;\n    moshi (data[top_index] < uint8(128)) { value = value + 256 * factor; }\n    kaesu I64Result { value: value, error: mu };\n}\n\nkoukai waza read_i64_le(data: []uint8, offset: int64) -> I64Result { kaesu read_i64_order(data, offset, hai); }\nkoukai waza read_i64_be(data: []uint8, offset: int64) -> I64Result { kaesu read_i64_order(data, offset, iie); }\n\nwaza write_unsigned(destination: []uint8, offset: int64, width: int64, value: int64, little: bool) -> BinaryError? {\n    kaku failure = range_error(destination, offset, width);\n    moshi (failure != mu) { kaesu failure; }\n    kaku remaining = value;\n    kaku index = 0;\n    aida (index < width) {\n        kaku byte_value = remaining - (remaining / 256) * 256;\n        kaku target = offset + index;\n        moshi (!little) { target = offset + width - 1 - index; }\n        destination[target] = uint8(byte_value);\n        remaining = remaining / 256;\n        index = index + 1;\n    }\n    kaesu mu;\n}\n\nwaza write_signed64(destination: []uint8, offset: int64, value: int64, little: bool) -> BinaryError? {\n    kaku failure = range_error(destination, offset, 8);\n    moshi (failure != mu) { kaesu failure; }\n    kaku remaining = value;\n    kaku index = 0;\n    aida (index < 8) {\n        kaku quotient = remaining / 256;\n        kaku remainder = remaining - quotient * 256;\n        moshi (remainder < 0) {\n            remainder = remainder + 256;\n            quotient = quotient - 1;\n        }\n        kaku target = offset + index;\n        moshi (!little) { target = offset + 7 - index; }\n        destination[target] = uint8(remainder);\n        remaining = quotient;\n        index = index + 1;\n    }\n    kaesu mu;\n}\n\nkoukai waza write_u8(destination: []uint8, offset: int64, value: uint8) -> BinaryError? {\n    kaesu write_unsigned(destination, offset, 1, int64(value), hai);\n}\nkoukai waza write_u16_le(destination: []uint8, offset: int64, value: uint16) -> BinaryError? {\n    kaesu write_unsigned(destination, offset, 2, int64(value), hai);\n}\nkoukai waza write_u16_be(destination: []uint8, offset: int64, value: uint16) -> BinaryError? {\n    kaesu write_unsigned(destination, offset, 2, int64(value), iie);\n}\nkoukai waza write_u32_le(destination: []uint8, offset: int64, value: uint32) -> BinaryError? {\n    kaesu write_unsigned(destination, offset, 4, int64(value), hai);\n}\nkoukai waza write_u32_be(destination: []uint8, offset: int64, value: uint32) -> BinaryError? {\n    kaesu write_unsigned(destination, offset, 4, int64(value), iie);\n}\nkoukai waza write_i8(destination: []uint8, offset: int64, value: int8) -> BinaryError? {\n    kaesu write_unsigned(destination, offset, 1, int64(value) + 256, hai);\n}\nkoukai waza write_i16_le(destination: []uint8, offset: int64, value: int16) -> BinaryError? {\n    kaesu write_unsigned(destination, offset, 2, int64(value) + 65536, hai);\n}\nkoukai waza write_i16_be(destination: []uint8, offset: int64, value: int16) -> BinaryError? {\n    kaesu write_unsigned(destination, offset, 2, int64(value) + 65536, iie);\n}\nkoukai waza write_i32_le(destination: []uint8, offset: int64, value: int32) -> BinaryError? {\n    kaesu write_unsigned(destination, offset, 4, int64(value) + 4294967296, hai);\n}\nkoukai waza write_i32_be(destination: []uint8, offset: int64, value: int32) -> BinaryError? {\n    kaesu write_unsigned(destination, offset, 4, int64(value) + 4294967296, iie);\n}\nkoukai waza write_i64_le(destination: []uint8, offset: int64, value: int64) -> BinaryError? {\n    kaesu write_signed64(destination, offset, value, hai);\n}\nkoukai waza write_i64_be(destination: []uint8, offset: int64, value: int64) -> BinaryError? {\n    kaesu write_signed64(destination, offset, value, iie);\n}\n\nkoukai waza write_var_u32(value: uint32) -> BytesResult {\n    kaku output = array.with_capacity[uint8](5);\n    kaku remaining = int64(value);\n    aida (remaining >= 128) {\n        array.push(output, uint8(remaining - (remaining / 128) * 128 + 128));\n        remaining = remaining / 128;\n    }\n    array.push(output, uint8(remaining));\n    kaesu BytesResult { data: output, error: mu };\n}\n\nkoukai waza read_var_u32(data: []uint8, offset: int64) -> VarU32Result {\n    moshi (offset < 0) { kaesu VarU32Result { value: uint32(0), count: 0, error: BinaryError.InvalidOffset() }; }\n    kaku value = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 5) {\n        moshi (offset + index >= len(data)) {\n            kaesu VarU32Result {\n                value: uint32(0), count: index, error: BinaryError.InsufficientData() };\n        }\n        kaku current = int64(data[offset + index]);\n        kaku payload = current;\n        moshi (payload >= 128) { payload = payload - 128; }\n        moshi (index == 4 && payload > 15) { kaesu VarU32Result { value: uint32(0), count: 5, error: BinaryError.Overflow() }; }\n        value = value + payload * factor;\n        moshi (current < 128) {\n            kaku encoded = write_var_u32(uint32(value));\n            moshi (len(encoded.data) != index + 1) {\n                kaesu VarU32Result {\n                    value: uint32(0), count: index + 1, error: BinaryError.MalformedVarint() };\n            }\n            kaesu VarU32Result { value: uint32(value), count: index + 1, error: mu };\n        }\n        factor = factor * 128;\n        index = index + 1;\n    }\n    kaesu VarU32Result { value: uint32(0), count: 5, error: BinaryError.MalformedVarint() };\n}\n\nkoukai waza write_var_i64(value: int64) -> BytesResult {\n    kaku output = array.with_capacity[uint8](10);\n    kaku remaining = value;\n    kaku done = iie;\n    aida (!done) {\n        kaku quotient = remaining / 128;\n        kaku payload = remaining - quotient * 128;\n        moshi (payload < 0) {\n            payload = payload + 128;\n            quotient = quotient - 1;\n        }\n        done = (quotient == 0 && payload < 64) || (quotient == -1 && payload >= 64);\n        moshi (!done) { payload = payload + 128; }\n        array.push(output, uint8(payload));\n        remaining = quotient;\n    }\n    kaesu BytesResult { data: output, error: mu };\n}\n\nkoukai waza read_var_i64(data: []uint8, offset: int64) -> VarI64Result {\n    moshi (offset < 0) { kaesu VarI64Result { value: 0, count: 0, error: BinaryError.InvalidOffset() }; }\n    kaku value = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 10) {\n        moshi (offset + index >= len(data)) { kaesu VarI64Result { value: 0, count: index, error: BinaryError.InsufficientData() }; }\n        kaku current = int64(data[offset + index]);\n        kaku payload = current;\n        moshi (payload >= 128) { payload = payload - 128; }\n        moshi (index == 9) {\n            moshi (current != 0 && current != 127) { kaesu VarI64Result { value: 0, count: 10, error: BinaryError.Overflow() }; }\n            moshi (current == 127) { value = value - 9223372036854775807 - 1; }\n        } sore {\n            value = value + payload * factor;\n        }\n        moshi (current < 128) {\n            moshi (index < 9 && current >= 64) { value = value - factor * 128; }\n            kaku encoded = write_var_i64(value);\n            moshi (len(encoded.data) != index + 1) {\n                kaesu VarI64Result {\n                    value: 0, count: index + 1, error: BinaryError.MalformedVarint() };\n            }\n            kaku compare = 0;\n            aida (compare < len(encoded.data)) {\n                moshi (encoded.data[compare] != data[offset + compare]) {\n                    kaesu VarI64Result {\n                        value: 0, count: index + 1, error: BinaryError.MalformedVarint() };\n                }\n                compare = compare + 1;\n            }\n            kaesu VarI64Result { value: value, count: index + 1, error: mu };\n        }\n        moshi (index == 9) { kaesu VarI64Result { value: 0, count: 10, error: BinaryError.MalformedVarint() }; }\n        factor = factor * 128;\n        index = index + 1;\n    }\n    kaesu VarI64Result { value: 0, count: 10, error: BinaryError.MalformedVarint() };\n}\n" }; }
waza data_74() -> File { kaesu File { path: "kiso/encoding/binary/stream.mio", version: "Bunko-v2.1.1", length: 9319, sha256: "7a3d0034a7e40254cc6b9525137c51648ae81b8cdb5883d8fe87c53d53bdcdbd", source: "yobu \"kiso/array\";\n\n// U64 keeps the complete unsigned 64-bit bit pattern without adding uint64 to Mio.\nkoukai kata U64 {\n    high: uint32;\n    low: uint32;\n}\nkoukai kata U64Result {\n    value: U64;\n    error: BinaryError?;\n}\n\n// BinaryReader owns an immutable view of the caller's bytes and a private cursor cell.\n// Reads never modify data.  The single-element state array gives functions reference\n// semantics while keeping the public language free of pointers.\nkoukai kata BinaryReader {\n    data: []uint8;\n    state: []int64;\n}\n\nkoukai waza reader(data: []uint8) -> BinaryReader {\n    kaesu BinaryReader { data: data, state: [0] };\n}\n\nkoukai waza reader_offset(value: BinaryReader) -> int64 { kaesu value.state[0]; }\nkoukai waza reader_remaining(value: BinaryReader) -> int64 { kaesu len(value.data) - value.state[0]; }\nkoukai waza reader_eof(value: BinaryReader) -> bool { kaesu value.state[0] == len(value.data); }\n\nkoukai waza reader_seek(value: BinaryReader, offset: int64) -> BinaryError? {\n    moshi (offset < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (offset > len(value.data)) { kaesu BinaryError.InsufficientData(); }\n    value.state[0] = offset;\n    kaesu mu;\n}\n\nkoukai waza reader_skip(value: BinaryReader, count: int64) -> BinaryError? {\n    moshi (count < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (count > reader_remaining(value)) { kaesu BinaryError.InsufficientData(); }\n    value.state[0] = value.state[0] + count;\n    kaesu mu;\n}\n\nkoukai waza reader_read_u8(value: BinaryReader) -> U8Result {\n    kaku result = read_u8(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 1; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u16_le(value: BinaryReader) -> U16Result {\n    kaku result = read_u16_le(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 2; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u16_be(value: BinaryReader) -> U16Result {\n    kaku result = read_u16_be(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 2; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u32_le(value: BinaryReader) -> U32Result {\n    kaku result = read_u32_le(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 4; }\n    kaesu result;\n}\n\nkoukai waza reader_read_u32_be(value: BinaryReader) -> U32Result {\n    kaku result = read_u32_be(value.data, value.state[0]);\n    moshi (result.error == mu) { value.state[0] = value.state[0] + 4; }\n    kaesu result;\n}\n\nwaza read_u64_order(value: BinaryReader, little: bool) -> U64Result {\n    kaku failure = range_error(value.data, value.state[0], 8);\n    moshi (failure != mu) { kaesu U64Result { value: U64 { high: uint32(0), low: uint32(0) }, error: failure }; }\n    kaku high = read_u32_be(value.data, value.state[0]);\n    kaku low = read_u32_be(value.data, value.state[0] + 4);\n    moshi (little) {\n        low = read_u32_le(value.data, value.state[0]);\n        high = read_u32_le(value.data, value.state[0] + 4);\n    }\n    value.state[0] = value.state[0] + 8;\n    kaesu U64Result { value: U64 { high: high.value, low: low.value }, error: mu };\n}\n\nkoukai waza reader_read_u64_le(value: BinaryReader) -> U64Result { kaesu read_u64_order(value, hai); }\nkoukai waza reader_read_u64_be(value: BinaryReader) -> U64Result { kaesu read_u64_order(value, iie); }\n\nkoukai waza reader_read_bytes(value: BinaryReader, count: int64) -> BytesResult {\n    moshi (count < 0) { kaesu BytesResult { data: [], error: BinaryError.InvalidOffset() }; }\n    moshi (count > reader_remaining(value)) { kaesu BytesResult { data: [], error: BinaryError.InsufficientData() }; }\n    kaku output = array.with_capacity[uint8](count);\n    kaku index = 0;\n    aida (index < count) {\n        array.push(output, value.data[value.state[0] + index]);\n        index = index + 1;\n    }\n    value.state[0] = value.state[0] + count;\n    kaesu BytesResult { data: output, error: mu };\n}\n\n// max_length is a hard allocation ceiling. A negative limit is rejected.\nkoukai kata BinaryWriter {\n    data: []uint8;\n    max_length: int64;\n}\n\nkoukai waza writer(max_length: int64) -> BinaryWriter {\n    kaku limit = max_length;\n    moshi (limit < 0) { limit = 0; }\n    kaesu BinaryWriter { data: array.with_capacity[uint8](0), max_length: limit };\n}\n\nkoukai waza writer_offset(value: BinaryWriter) -> int64 { kaesu len(value.data); }\n\nwaza writer_grow(value: BinaryWriter, count: int64) -> BinaryError? {\n    moshi (count < 0) { kaesu BinaryError.InvalidOffset(); }\n    moshi (len(value.data) > value.max_length || count > value.max_length - len(value.data)) { kaesu BinaryError.Overflow(); }\n    kaku target = len(value.data) + count;\n    array.reserve(value.data, count);\n    aida (len(value.data) < target) { array.push(value.data, uint8(0)); }\n    kaesu mu;\n}\n\nkoukai waza writer_reserve(value: BinaryWriter, count: int64) -> I64Result {\n    kaku offset = len(value.data);\n    kaku failure = writer_grow(value, count);\n    moshi (failure != mu) { kaesu I64Result { value: -1, error: failure }; }\n    kaesu I64Result { value: offset, error: mu };\n}\n\nkoukai waza writer_write_bytes(value: BinaryWriter, source: []uint8) -> BinaryError? {\n    kaku start = writer_reserve(value, len(source));\n    moshi (start.error != mu) { kaesu start.error; }\n    kaku index = 0;\n    aida (index < len(source)) {\n        value.data[start.value + index] = source[index];\n        index = index + 1;\n    }\n    kaesu mu;\n}\n\nkoukai waza writer_write_length_prefixed(value: BinaryWriter, source: []uint8) -> BinaryError? {\n    moshi (len(source) > 4294967295) { kaesu BinaryError.Overflow(); }\n    moshi (len(value.data) > value.max_length || value.max_length - len(value.data) < 4 ||\n        len(source) > value.max_length - len(value.data) - 4) { kaesu BinaryError.Overflow(); }\n    kaku failure = writer_write_u32_be(value, uint32(len(source)));\n    moshi (failure != mu) { kaesu failure; }\n    kaesu writer_write_bytes(value, source);\n}\n\nkoukai waza writer_write_u8(value: BinaryWriter, number: uint8) -> BinaryError? {\n    kaku start = writer_reserve(value, 1);\n    moshi (start.error != mu) {\n        kaesu start.error;\n    }\n    kaesu write_u8(value.data, start.value, number);\n}\nkoukai waza writer_write_u16_le(value: BinaryWriter, number: uint16) -> BinaryError? {\n    kaku start = writer_reserve(value, 2);\n    moshi (start.error != mu) {\n        kaesu start.error;\n    }\n    kaesu write_u16_le(value.data, start.value, number);\n}\nkoukai waza writer_write_u16_be(value: BinaryWriter, number: uint16) -> BinaryError? {\n    kaku start = writer_reserve(value, 2);\n    moshi (start.error != mu) {\n        kaesu start.error;\n    }\n    kaesu write_u16_be(value.data, start.value, number);\n}\nkoukai waza writer_write_u32_le(value: BinaryWriter, number: uint32) -> BinaryError? {\n    kaku start = writer_reserve(value, 4);\n    moshi (start.error != mu) {\n        kaesu start.error;\n    }\n    kaesu write_u32_le(value.data, start.value, number);\n}\nkoukai waza writer_write_u32_be(value: BinaryWriter, number: uint32) -> BinaryError? {\n    kaku start = writer_reserve(value, 4);\n    moshi (start.error != mu) {\n        kaesu start.error;\n    }\n    kaesu write_u32_be(value.data, start.value, number);\n}\n\nwaza writer_write_u64_order(value: BinaryWriter, number: U64, little: bool) -> BinaryError? {\n    kaku start = writer_reserve(value, 8);\n    moshi (start.error != mu) {\n        kaesu start.error;\n    }\n    moshi (little) {\n        write_u32_le(value.data, start.value, number.low);\n        kaesu write_u32_le(value.data, start.value + 4, number.high);\n    }\n    write_u32_be(value.data, start.value, number.high);\n    kaesu write_u32_be(value.data, start.value + 4, number.low);\n}\nkoukai waza writer_write_u64_le(value: BinaryWriter, number: U64) -> BinaryError? { kaesu writer_write_u64_order(value, number, hai); }\nkoukai waza writer_write_u64_be(value: BinaryWriter, number: U64) -> BinaryError? { kaesu writer_write_u64_order(value, number, iie); }\n\nkoukai waza writer_patch_u16_be(value: BinaryWriter, offset: int64, number: uint16) -> BinaryError? {\n    kaesu write_u16_be(value.data, offset, number);\n}\nkoukai waza writer_patch_u16_le(value: BinaryWriter, offset: int64, number: uint16) -> BinaryError? {\n    kaesu write_u16_le(value.data, offset, number);\n}\nkoukai waza writer_patch_u32_be(value: BinaryWriter, offset: int64, number: uint32) -> BinaryError? {\n    kaesu write_u32_be(value.data, offset, number);\n}\nkoukai waza writer_patch_u32_le(value: BinaryWriter, offset: int64, number: uint32) -> BinaryError? {\n    kaesu write_u32_le(value.data, offset, number);\n}\nkoukai waza writer_patch_u64_be(value: BinaryWriter, offset: int64, number: U64) -> BinaryError? {\n    kaku failure = write_u32_be(value.data, offset, number.high);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    kaesu write_u32_be(value.data, offset + 4, number.low);\n}\nkoukai waza writer_patch_u64_le(value: BinaryWriter, offset: int64, number: U64) -> BinaryError? {\n    kaku failure = write_u32_le(value.data, offset, number.low);\n    moshi (failure != mu) {\n        kaesu failure;\n    }\n    kaesu write_u32_le(value.data, offset + 4, number.high);\n}\n\nkoukai waza writer_bytes(value: BinaryWriter) -> []uint8 { kaesu array.clone(value.data); }\n" }; }
waza data_75() -> File { kaesu File { path: "kiso/encoding/json/json.mio", version: "Bunko-v2.1.1", length: 12375, sha256: "4ad7a50bd91f9373a8b371ba24ac7e63fa436c6b5230d05e25e744710ab87853", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\nyobu \"kiso/utf8\";\nyobu \"kiso/convert\";\n\n// 纯 Mio 实现的 RFC 8259 JSON 解析与序列化器。\n// 数字节点保留原始字面量文本（text），确保大整数请求 ID 等场景不会因浮点转换而丢失精度。\n// kind 枚举约定：0=null, 1=bool, 2=number, 3=string, 4=array, 5=object。\nkoukai kata Value {\n    kind: int64;\n    text: string;\n    children: []int64;\n    keys: []string;\n}\nkoukai kata Document {\n    values: []Value;\n    root: int64;\n    error: string;\n    offset: int64;\n}\nkata State {\n    data: []uint8;\n    at: []int64;\n    values: []Value;\n    error: []string;\n}\nwaza byte(state: State) -> int64 {\n    moshi (state.at[0] >= len(state.data)) {\n        kaesu -1;\n    }\n    kaesu int64(state.data[state.at[0]]);\n}\nwaza fail(state: State, message: string) -> unit { moshi (state.error[0] == \"\") { state.error[0] = message; } }\nwaza whitespace(state: State) -> unit {\n    kaku value = byte(state);\n    aida (value == 32 || value == 9 || value == 10 || value == 13) {\n        state.at[0] = state.at[0] + 1;\n        value = byte(state);\n    }\n}\nwaza text_range(data: []uint8, first: int64, end: int64) -> string {\n    kaku bytes: []uint8 = [];\n    kaku at = first;\n    aida (at < end) {\n        array.push(bytes, data[at]);\n        at = at + 1;\n    }\n    kaku text = string.from_utf8(bytes);\n    moshi (text == mu) {\n        kaesu \"\";\n    }\n    kaesu text;\n}\nwaza hex(value: int64) -> int64 {\n    moshi (value >= 48 && value <= 57) { kaesu value - 48; }\n    moshi (value >= 65 && value <= 70) { kaesu value - 55; }\n    moshi (value >= 97 && value <= 102) {\n        kaesu value - 87;\n    }\n    kaesu -1;\n}\nwaza hex4(data: []uint8, at: int64) -> int64 {\n    moshi (at < 0 || at + 4 > len(data)) { kaesu -1; }\n    kaku result = 0;\n    kaku index = 0;\n    aida (index < 4) {\n        kaku digit = hex(int64(data[at + index]));\n        moshi (digit < 0) {\n            kaesu -1;\n        }\n        result = result * 16 + digit;\n        index = index + 1;\n    }\n    kaesu result;\n}\nwaza parse_string(state: State) -> string {\n    moshi (byte(state) != 34) {\n        fail(state, \"expected JSON string\");\n        kaesu \"\";\n    }\n    state.at[0] = state.at[0] + 1;\n    kaku output: []uint8 = [];\n    aida (state.at[0] < len(state.data) && state.error[0] == \"\") {\n        kaku value = byte(state);\n        state.at[0] = state.at[0] + 1;\n        moshi (value == 34) {\n            kaku text = string.from_utf8(output);\n            moshi (text == mu) {\n                fail(state, \"invalid string UTF8\");\n                kaesu \"\";\n            }\n            kaesu text;\n        }\n        moshi (value < 32) {\n            fail(state, \"unescaped string control byte\");\n            kaesu \"\";\n        }\n        moshi (value != 92) {\n            array.push(output, uint8(value));\n            tsuzuku;\n        }\n        kaku escaped = byte(state);\n        state.at[0] = state.at[0] + 1;\n        moshi (escaped == 34 || escaped == 92 || escaped == 47) {\n            array.push(output, uint8(escaped));\n            tsuzuku;\n        }\n        kaku control = -1;\n        moshi (escaped == 98) {\n            control = 8;\n        }\n        moshi (escaped == 102) {\n            control = 12;\n        }\n        moshi (escaped == 110) {\n            control = 10;\n        }\n        moshi (escaped == 114) {\n            control = 13;\n        }\n        moshi (escaped == 116) {\n            control = 9;\n        }\n        moshi (control >= 0) {\n            array.push(output, uint8(control));\n            tsuzuku;\n        }\n        moshi (escaped != 117) {\n            fail(state, \"invalid JSON escape\");\n            kaesu \"\";\n        }\n        kaku scalar = hex4(state.data, state.at[0]);\n        moshi (scalar < 0) {\n            fail(state, \"invalid Unicode escape\");\n            kaesu \"\";\n        }\n        state.at[0] = state.at[0] + 4;\n        moshi (scalar >= 55296 && scalar <= 56319) {\n            kaku low = -1;\n            moshi (state.at[0] + 6 <= len(state.data) && state.data[state.at[0]] == uint8(92) && state.data[state.at[0] + 1] == uint8(117)) {\n                low = hex4(state.data, state.at[0] + 2);\n            }\n            moshi (low >= 56320 && low <= 57343) {\n                scalar = 65536 + (scalar - 55296) * 1024 + low - 56320;\n                state.at[0] = state.at[0] + 6;\n            }\n            sore { scalar = 65533; }\n        }\n        sore { moshi (scalar >= 56320 && scalar <= 57343) { scalar = 65533; } }\n        utf8.append_rune(output, rune(scalar));\n    }\n    fail(state, \"unterminated JSON string\");\n    kaesu \"\";\n}\nwaza push(state: State, kind: int64, text: string, children: []int64, keys: []string) -> int64 {\n    kaku id = len(state.values);\n    array.push(state.values, Value {\n            kind: kind, text: text, children: children, keys: keys });\n    kaesu id;\n}\nwaza keyword(state: State, expected: string, kind: int64) -> int64 {\n    kaku bytes = string.to_bytes(expected);\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        moshi (byte(state) != int64(bytes[at])) {\n            fail(state, \"invalid JSON keyword\");\n            kaesu -1;\n        }\n        state.at[0] = state.at[0] + 1;\n        at = at + 1;\n    }\n    kaesu push(state, kind, expected, [], []);\n}\nwaza digit(value: int64) -> bool { kaesu value >= 48 && value <= 57; }\nwaza number(state: State) -> int64 {\n    kaku first = state.at[0];\n    moshi (byte(state) == 45) {\n        state.at[0] = state.at[0] + 1;\n    }\n    moshi (byte(state) == 48) { state.at[0] = state.at[0] + 1; }\n    sore {\n        moshi (byte(state) < 49 || byte(state) > 57) {\n            fail(state, \"invalid JSON number\");\n            kaesu -1;\n        }\n        aida (digit(byte(state))) { state.at[0] = state.at[0] + 1; }\n    }\n    moshi (byte(state) == 46) {\n        state.at[0] = state.at[0] + 1;\n        moshi (!digit(byte(state))) {\n            fail(state, \"missing fraction digits\");\n            kaesu -1;\n        }\n        aida (digit(byte(state))) { state.at[0] = state.at[0] + 1; }\n    }\n    moshi (byte(state) == 101 || byte(state) == 69) {\n        state.at[0] = state.at[0] + 1;\n        moshi (byte(state) == 43 || byte(state) == 45) {\n            state.at[0] = state.at[0] + 1;\n        }\n        moshi (!digit(byte(state))) {\n            fail(state, \"missing exponent digits\");\n            kaesu -1;\n        }\n        aida (digit(byte(state))) { state.at[0] = state.at[0] + 1; }\n    }\n    kaesu push(state, 2, text_range(state.data, first, state.at[0]), [], []);\n}\nwaza value(state: State, depth: int64) -> int64 {\n    whitespace(state);\n    moshi (depth > 256 || len(state.values) >= 1000000) {\n        fail(state, \"JSON structure limit exceeded\");\n        kaesu -1;\n    }\n    kaku current = byte(state);\n    moshi (current == 34) {\n        kaku text = parse_string(state);\n        moshi (state.error[0] != \"\") {\n            kaesu -1;\n        }\n        kaesu push(state, 3, text, [], []);\n    }\n    moshi (current == 110) { kaesu keyword(state, \"null\", 0); }\n    moshi (current == 116) { kaesu keyword(state, \"true\", 1); }\n    moshi (current == 102) { kaesu keyword(state, \"false\", 1); }\n    moshi (current == 45 || digit(current)) { kaesu number(state); }\n    moshi (current != 91 && current != 123) {\n        fail(state, \"expected JSON value\");\n        kaesu -1;\n    }\n    kaku object = current == 123;\n    kaku end = 93;\n    kaku kind = 4;\n    moshi (object) {\n        end = 125;\n        kind = 5;\n    }\n    state.at[0] = state.at[0] + 1;\n    whitespace(state);\n    kaku children: []int64 = [];\n    kaku keys: []string = [];\n    moshi (byte(state) == end) {\n        state.at[0] = state.at[0] + 1;\n        kaesu push(state, kind, \"\", children, keys);\n    }\n    aida (state.error[0] == \"\") {\n        moshi (object) {\n            kaku key = parse_string(state);\n            moshi (state.error[0] != \"\") {\n                kaesu -1;\n            }\n            array.push(keys, key);\n            whitespace(state);\n            moshi (byte(state) != 58) {\n                fail(state, \"expected object colon\");\n                kaesu -1;\n            }\n            state.at[0] = state.at[0] + 1;\n        }\n        kaku child = value(state, depth + 1);\n        moshi (child < 0) {\n            kaesu -1;\n        }\n        array.push(children, child);\n        whitespace(state);\n        moshi (byte(state) == end) {\n            state.at[0] = state.at[0] + 1;\n            kaesu push(state, kind, \"\", children, keys);\n        }\n        moshi (byte(state) != 44) {\n            fail(state, \"expected comma or closing delimiter\");\n            kaesu -1;\n        }\n        state.at[0] = state.at[0] + 1;\n        whitespace(state);\n    }\n    kaesu -1;\n}\n\nkoukai waza parse(data: []uint8) -> Document {\n    kaku state = State { data: data, at: [0], values: [], error: [\"\"] };\n    moshi (len(data) > 67108864 || !utf8.valid(data)) {\n        kaesu Document {\n            values: [], root: -1, error: \"invalid JSON size or UTF8\", offset: 0 };\n    }\n    kaku root = value(state, 0);\n    whitespace(state);\n    moshi (state.at[0] != len(data)) { fail(state, \"trailing JSON data\"); }\n    kaesu Document { values: state.values, root: root, error: state.error[0], offset: state.at[0] };\n}\nkoukai waza member(document: Document, object: int64, key: string) -> int64 {\n    moshi (object < 0 || object >= len(document.values) || document.values[object].kind != 5) { kaesu -1; }\n    kaku node = document.values[object];\n    kaku at = len(node.keys) - 1;\n    aida (at >= 0) {\n        moshi (node.keys[at] == key) {\n            kaesu node.children[at];\n        }\n        at = at - 1;\n    }\n    kaesu -1;\n}\nkoukai waza text(document: Document, node: int64) -> string {\n    moshi (node < 0 || node >= len(document.values)) {\n        kaesu \"\";\n    }\n    kaesu document.values[node].text;\n}\nkoukai waza integer(document: Document, node: int64) -> int64? {\n    moshi (node < 0 || node >= len(document.values) || document.values[node].kind != 2) { kaesu mu; }\n    kaesu convert.parse_int(document.values[node].text);\n}\nkoukai waza quote(text: string) -> string {\n    kaku bytes = string.to_bytes(text);\n    kaku output: []uint8 = [uint8(34)];\n    kaku digits = string.to_bytes(\"0123456789abcdef\");\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        kaku byte = int64(bytes[at]);\n        kaku escaped = 0;\n        moshi (byte == 34 || byte == 92) { escaped = byte; }\n        moshi (byte == 8) {\n            escaped = 98;\n        }\n        moshi (byte == 9) {\n            escaped = 116;\n        }\n        moshi (byte == 10) {\n            escaped = 110;\n        }\n        moshi (byte == 12) {\n            escaped = 102;\n        }\n        moshi (byte == 13) {\n            escaped = 114;\n        }\n        moshi (escaped > 0) {\n            array.push(output, uint8(92));\n            array.push(output, uint8(escaped));\n        }\n        sore { moshi (byte < 32) {\n                array.push(output, uint8(92));\n                array.push(output, uint8(117));\n                array.push(output, uint8(48));\n                array.push(output, uint8(48));\n                array.push(output, digits[byte / 16]);\n                array.push(output, digits[byte - (byte / 16) * 16]);\n            } sore { array.push(output, uint8(byte)); } }\n        at = at + 1;\n    }\n    array.push(output, uint8(34));\n    kaku result = string.from_utf8(output);\n    moshi (result == mu) {\n        kaesu \"\\\"\\\"\";\n    }\n    kaesu result;\n}\nkoukai waza render(document: Document, node: int64) -> string {\n    moshi (node < 0 || node >= len(document.values)) { kaesu \"null\"; }\n    kaku item = document.values[node];\n    moshi (item.kind == 0) { kaesu \"null\"; }\n    moshi (item.kind == 1 || item.kind == 2) { kaesu item.text; }\n    moshi (item.kind == 3) { kaesu quote(item.text); }\n    kaku output = string.new_builder();\n    kaku object = item.kind == 5;\n    kaku open = \"[\";\n    kaku close = \"]\";\n    moshi (object) {\n        open = \"{\";\n        close = \"}\";\n    }\n    string.write_string(output, open);\n    kaku at = 0;\n    aida (at < len(item.children)) {\n        moshi (at > 0) { string.write_string(output, \",\"); }\n        moshi (object) { string.write_string(output, string.concat(quote(item.keys[at]), \":\")); }\n        string.write_string(output, render(document, item.children[at]));\n        at = at + 1;\n    }\n    string.write_string(output, close);\n    kaesu string.builder_string(output);\n}\n" }; }
waza data_76() -> File { kaesu File { path: "kiso/encoding/mochi/decode.mio", version: "Bunko-v2.1.1", length: 25745, sha256: "db729b7feb398953d2e3ef61a4fa3359fc144e2f3b26292406ac176d8f2466ff", source: "yobu \"kiso/array\";\nyobu \"kiso/encoding/win64c\";\nyobu \"kiso/encoding/binary\";\nyobu \"kiso/string\";\nyobu \"kiso/utf8\";\n\nkoukai teisu VERSION: int64 = 16;\nkoukai teisu MAX_FILE_SIZE: int64 = 67108864;\nkoukai teisu MAX_CONSTANTS: int64 = 65536;\nkoukai teisu MAX_GLOBALS: int64 = 65536;\nkoukai teisu MAX_STRING_BYTES: int64 = 16777216;\nkoukai teisu MAX_INSTRUCTION_BYTES: int64 = 16777216;\nkoukai teisu MAX_FUNCTIONS: int64 = 65536;\nkoukai teisu MAX_FUNCTION_SLOTS: int64 = 65536;\n\nkoukai sentaku DecodeErrorKind {\n    Truncated;\n    InvalidMagic;\n    UnsupportedVersion;\n    LimitExceeded;\n    InvalidConstant;\n    InvalidUtf8;\n    InvalidFunction;\n    InvalidInstruction;\n    InvalidIndex;\n    InvalidJump;\n    TrailingData;\n    IoFailure;\n}\n\nkoukai kata DecodeError {\n    kind: DecodeErrorKind;\n    offset: int64;\n    detail: int64;\n}\nkoukai kata Constant {\n    tag: uint8;\n    bits: binary.U64;\n    data: []uint8;\n}\nkoukai kata Capture {\n    local: bool;\n    index: int64;\n}\nkoukai kata Function {\n    id: int64;\n    name: string;\n    name_bytes: []uint8;\n    parameter_count: int64;\n    local_count: int64;\n    returns_value: bool;\n    captures: []Capture;\n    instructions: []uint8;\n}\nkoukai kata File {\n    version: int64;\n    constants: []Constant;\n    global_count: int64;\n    instructions: []uint8;\n    functions: []Function;\n}\nkoukai kata DecodeResult {\n    value: File?;\n    error: DecodeError?;\n}\n\nkoukai waza has_win64_c(file: File) -> bool {\n    kaku i = 0;\n    aida (i < len(file.functions)) { moshi (win64c.is_external(file.functions[i].name)) { kaesu hai; } i = i + 1; }\n    kaesu iie;\n}\n\nwaza failure(kind: DecodeErrorKind, offset: int64, detail: int64) -> DecodeResult {\n    kaesu DecodeResult { value: mu, error: DecodeError { kind: kind, offset: offset, detail: detail } };\n}\n\nwaza empty_file() -> File {\n    kaesu File { version: 0, constants: array.with_capacity[Constant](0), global_count: 0,\n        instructions: array.with_capacity[uint8](0), functions: array.with_capacity[Function](0) };\n}\n\nwaza instruction_width(opcode: int64) -> int64 {\n    moshi (opcode == 38) { kaesu 5; }\n    moshi (opcode == 54) { kaesu 3; }\n    moshi (opcode == 56 || opcode == 67) { kaesu 4; }\n    moshi ((opcode >= 1 && opcode <= 1) || (opcode >= 17 && opcode <= 20) ||\n        (opcode >= 23 && opcode <= 25) || opcode == 30 || opcode == 36 || opcode == 37 ||\n        opcode == 40 || (opcode >= 44 && opcode <= 49)) { kaesu 3; }\n    moshi (opcode == 55 || opcode == 57 || opcode == 58 || opcode == 65 || opcode == 66) { kaesu 2; }\n    moshi (opcode >= 2 && opcode <= 16) { kaesu 1; }\n    moshi (opcode >= 21 && opcode <= 22) { kaesu 1; }\n    moshi (opcode >= 26 && opcode <= 29) { kaesu 1; }\n    moshi (opcode >= 31 && opcode <= 35) { kaesu 1; }\n    moshi (opcode == 39 || (opcode >= 41 && opcode <= 43)) { kaesu 1; }\n    moshi (opcode >= 50 && opcode <= 53) { kaesu 1; }\n    moshi (opcode >= 59 && opcode <= 64) { kaesu 1; }\n    kaesu 0;\n}\n\nwaza version_allows(opcode: int64, version: int64) -> bool {\n    moshi (opcode == 67 && version<16) { kaesu iie; }\n    moshi ((opcode == 28 || opcode == 29) && version < 4) { kaesu iie; }\n    moshi ((opcode == 30 || opcode == 31) && version < 5) { kaesu iie; }\n    moshi ((opcode == 32 || opcode == 33) && version < 6) { kaesu iie; }\n    moshi ((opcode == 34 || opcode == 35) && version < 7) { kaesu iie; }\n    moshi (opcode >= 36 && opcode <= 45 && version < 8) { kaesu iie; }\n    moshi (opcode >= 46 && opcode <= 49 && version < 9) { kaesu iie; }\n    moshi (opcode >= 50 && opcode <= 54 && version < 10) { kaesu iie; }\n    moshi (opcode == 55 && version < 11) { kaesu iie; }\n    moshi (opcode >= 56 && opcode <= 62 && version < 12) { kaesu iie; }\n    moshi ((opcode == 63 || opcode == 64) && version < 13) { kaesu iie; }\n    moshi (opcode == 65 && version < 14) { kaesu iie; }\n    moshi (opcode == 66 && version < 15) { kaesu iie; }\n    kaesu hai;\n}\n\nwaza valid_descriptor(value: int64) -> bool {\n    moshi (value == 0) { kaesu hai; }\n    kaku base = value;\n    moshi (base >= 128) { base = base - 128; }\n    moshi (base == 1 || base == 2 || base == 3 || base == 4 || base == 5 ||\n        base == 7 || base == 8 || base == 9 || base == 10 || base == 11 ||\n        (base >= 12 && base <= 17)) { kaesu hai; }\n    kaesu iie;\n}\n\nwaza read_operand_u16(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset]) * 256 + int64(data[offset + 1]);\n}\n\nwaza validate_instructions(file: File, data: []uint8, function_index: int64) -> DecodeError? {\n    kaku boundaries = array.make[bool](len(data) + 1, iie);\n    boundaries[len(data)] = hai;\n    kaku jump_offsets = array.with_capacity[int64](8);\n    kaku jump_targets = array.with_capacity[int64](8);\n    kaku offset = 0;\n    aida (offset < len(data)) {\n        boundaries[offset] = hai;\n        kaku opcode = int64(data[offset]);\n        kaku width = instruction_width(opcode);\n        moshi (width == 0 || !version_allows(opcode, file.version)) {\n            kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: opcode };\n        }\n        moshi (width > len(data) - offset) {\n            kaesu DecodeError { kind: DecodeErrorKind.Truncated(), offset: offset, detail: opcode };\n        }\n        kaku first = 0;\n        kaku second = 0;\n        moshi (width >= 3 && opcode != 54) { first = read_operand_u16(data, offset + 1); }\n        moshi (width == 2) { first = int64(data[offset + 1]); }\n        moshi (opcode == 54) {\n            first = int64(data[offset + 1]);\n            second = int64(data[offset + 2]);\n        }\n        moshi (opcode == 56 || opcode == 67) {\n            first = read_operand_u16(data, offset + 1);\n            second = int64(data[offset + 3]);\n        }\n        moshi (opcode == 38) {\n            first = read_operand_u16(data, offset + 1);\n            second = read_operand_u16(data, offset + 3);\n        }\n        moshi (opcode == 67 && second>1) { kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: second }; }\n        moshi (opcode == 66 && (first == 0 || first >= 128 || !valid_descriptor(first))) {\n            kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: first };\n        }\n\n        moshi (opcode == 1 && first >= len(file.constants)) {\n            kaesu DecodeError { kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: first };\n        }\n        moshi ((opcode == 19 || opcode == 20) && first >= file.global_count) {\n            kaesu DecodeError { kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: first };\n        }\n        moshi (opcode == 23 || opcode == 24 || opcode == 49) {\n            moshi (function_index < 0 || first >= file.functions[function_index].local_count) {\n                kaesu DecodeError { kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: first };\n            }\n        }\n        moshi (opcode == 25 || opcode == 44 || opcode == 46) {\n            moshi (first >= len(file.functions)) {\n                kaesu DecodeError {\n                    kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: first };\n            }\n            moshi ((opcode == 25 || opcode == 44) && len(file.functions[first].captures) != 0) {\n                kaesu DecodeError { kind: DecodeErrorKind.InvalidFunction(), offset: offset, detail: first };\n            }\n            moshi (opcode == 46) {\n                // A capture-free closure may be constructed at module scope.\n                // Only actual captures require an enclosing function frame.\n                moshi (function_index < 0 && len(file.functions[first].captures) != 0) {\n                    kaesu DecodeError {\n                        kind: DecodeErrorKind.InvalidFunction(), offset: offset, detail: first };\n                }\n                kaku capture_index = 0;\n                aida (capture_index < len(file.functions[first].captures)) {\n                    kaku capture = file.functions[first].captures[capture_index];\n                    kaku limit = len(file.functions[function_index].captures);\n                    moshi (capture.local) { limit = file.functions[function_index].local_count; }\n                    moshi (capture.index >= limit) {\n                        kaesu DecodeError {\n                            kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: capture.index };\n                    }\n                    capture_index = capture_index + 1;\n                }\n            }\n        }\n        moshi (opcode == 47 || opcode == 48) {\n            moshi (function_index < 0 || first >= len(file.functions[function_index].captures)) {\n                kaesu DecodeError { kind: DecodeErrorKind.InvalidIndex(), offset: offset, detail: first };\n            }\n        }\n        moshi (opcode == 26 || opcode == 27) {\n            moshi (function_index < 0) { kaesu DecodeError { kind: DecodeErrorKind.InvalidFunction(), offset: offset, detail: opcode }; }\n            moshi ((opcode == 26 && file.functions[function_index].returns_value) ||\n                (opcode == 27 && !file.functions[function_index].returns_value)) {\n                kaesu DecodeError { kind: DecodeErrorKind.InvalidFunction(), offset: offset, detail: opcode };\n            }\n        }\n        moshi (opcode == 54) {\n            moshi (first < 1 || first > 13) {\n                kaesu DecodeError {\n                    kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: first };\n            }\n            kaku expected = 1;\n            moshi (first == 10) {\n                expected = 2;\n            }\n            moshi (second != expected) { kaesu DecodeError { kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: second }; }\n        }\n        moshi (opcode == 55 && (first < 1 || first > 7)) {\n            kaesu DecodeError {\n                kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: first };\n        }\n        moshi (opcode == 65 && (first < 1 || first > 2)) {\n            kaesu DecodeError {\n                kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: first };\n        }\n        moshi (opcode == 56 && !valid_descriptor(second)) {\n            kaesu DecodeError {\n                kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: second };\n        }\n        moshi ((opcode == 57 || opcode == 58) && !valid_descriptor(first)) {\n            kaesu DecodeError {\n                kind: DecodeErrorKind.InvalidInstruction(), offset: offset, detail: first };\n        }\n        moshi (opcode == 17 || opcode == 18) {\n            array.push(jump_offsets, offset);\n            array.push(jump_targets, first);\n        }\n        offset = offset + width;\n    }\n    kaku index = 0;\n    aida (index < len(jump_targets)) {\n        kaku target = jump_targets[index];\n        moshi (target > len(data) || !boundaries[target]) {\n            kaesu DecodeError { kind: DecodeErrorKind.InvalidJump(), offset: jump_offsets[index], detail: target };\n        }\n        index = index + 1;\n    }\n    kaesu mu;\n}\n\nwaza read_constant(input: binary.BinaryReader, version: int64) -> DecodeResult {\n    kaku tag_offset = binary.reader_offset(input);\n    kaku tag_result = binary.reader_read_u8(input);\n    moshi (tag_result.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), tag_offset, 1); }\n    kaku tag = tag_result.value;\n    moshi (tag == uint8(1) || tag == uint8(3)) {\n        moshi (tag == uint8(3) && version < 3) { kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag)); }\n        kaku wide = binary.reader_read_u64_be(input);\n        moshi (wide.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 8); }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: wide.value, data: [] });\n        kaesu DecodeResult { value: File { version: version, constants: constants, global_count: 0,\n                instructions: [], functions: [] }, error: mu };\n    }\n    moshi (tag == uint8(2)) {\n        kaku length_at = binary.reader_offset(input);\n        kaku length = binary.reader_read_u32_be(input);\n        moshi (length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), length_at, 4); }\n        moshi (int64(length.value) > MAX_STRING_BYTES) { kaesu failure(DecodeErrorKind.LimitExceeded(), length_at, int64(length.value)); }\n        kaku bytes_result = binary.reader_read_bytes(input, int64(length.value));\n        moshi (bytes_result.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), int64(length.value)); }\n        moshi (!utf8.valid(bytes_result.data)) { kaesu failure(DecodeErrorKind.InvalidUtf8(), length_at + 4, int64(length.value)); }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: binary.U64 { high: uint32(0), low: uint32(0) }, data: bytes_result.data });\n        kaesu DecodeResult { value: File { version: version, constants: constants, global_count: 0,\n                instructions: [], functions: [] }, error: mu };\n    }\n    moshi (tag == uint8(4)) {\n        moshi (version < 10) { kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag)); }\n        kaku raw = binary.reader_read_u32_be(input);\n        moshi (raw.error != mu) {\n            kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 4);\n        }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: binary.U64 { high: uint32(0), low: raw.value }, data: [] });\n        kaesu DecodeResult {\n            value: File {\n                version: version, constants: constants, global_count: 0, instructions: [], functions: [] }, error: mu };\n    }\n    moshi (tag == uint8(5) || tag == uint8(8)) {\n        moshi (version < 11) { kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag)); }\n        kaku raw = binary.reader_read_u8(input);\n        moshi (raw.error != mu) {\n            kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 1);\n        }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: binary.U64 { high: uint32(0), low: uint32(raw.value) }, data: [] });\n        kaesu DecodeResult {\n            value: File {\n                version: version, constants: constants, global_count: 0, instructions: [], functions: [] }, error: mu };\n    }\n    moshi (tag == uint8(6) || tag == uint8(9)) {\n        moshi (version < 11) { kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag)); }\n        kaku raw = binary.reader_read_u16_be(input);\n        moshi (raw.error != mu) {\n            kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 2);\n        }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: binary.U64 { high: uint32(0), low: uint32(raw.value) }, data: [] });\n        kaesu DecodeResult {\n            value: File {\n                version: version, constants: constants, global_count: 0, instructions: [], functions: [] }, error: mu };\n    }\n    moshi (tag == uint8(7) || tag == uint8(10)) {\n        moshi (version < 11) { kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag)); }\n        kaku raw = binary.reader_read_u32_be(input);\n        moshi (raw.error != mu) {\n            kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 4);\n        }\n        kaku constants = array.with_capacity[Constant](1);\n        array.push(constants, Constant { tag: tag, bits: binary.U64 { high: uint32(0), low: raw.value }, data: [] });\n        kaesu DecodeResult {\n            value: File {\n                version: version, constants: constants, global_count: 0, instructions: [], functions: [] }, error: mu };\n    }\n    kaesu failure(DecodeErrorKind.InvalidConstant(), tag_offset, int64(tag));\n}\n\nkoukai waza decode(data: []uint8) -> DecodeResult {\n    moshi (len(data) > MAX_FILE_SIZE) { kaesu failure(DecodeErrorKind.LimitExceeded(), 0, len(data)); }\n    kaku input = binary.reader(data);\n    kaku magic = binary.reader_read_bytes(input, 5);\n    moshi (magic.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), 0, 5); }\n    moshi (magic.data[0] != uint8(77) || magic.data[1] != uint8(79) || magic.data[2] != uint8(67) || magic.data[3] != uint8(72) || magic.data[4] != uint8(73)) {\n        kaesu failure(DecodeErrorKind.InvalidMagic(), 0, 0);\n    }\n    kaku version_result = binary.reader_read_u16_be(input);\n    moshi (version_result.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), 5, 2); }\n    kaku version = int64(version_result.value);\n    moshi (version < 1 || version > VERSION) { kaesu failure(DecodeErrorKind.UnsupportedVersion(), 5, version); }\n    kaku count_at = binary.reader_offset(input);\n    kaku constant_count = binary.reader_read_u32_be(input);\n    moshi (constant_count.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), count_at, 4); }\n    moshi (int64(constant_count.value) > MAX_CONSTANTS) {\n        kaesu failure(DecodeErrorKind.LimitExceeded(), count_at, int64(constant_count.value));\n    }\n    kaku constants = array.with_capacity[Constant](int64(constant_count.value));\n    kaku index = 0;\n    aida (index < int64(constant_count.value)) {\n        kaku decoded = read_constant(input, version);\n        kaku decoded_error = decoded.error;\n        moshi (decoded_error != mu) { kaesu DecodeResult { value: mu, error: decoded_error }; }\n        kaku part = decoded.value;\n        moshi (part != mu) { array.push(constants, part.constants[0]); }\n        sore { kaesu failure(DecodeErrorKind.InvalidConstant(), binary.reader_offset(input), index); }\n        index = index + 1;\n    }\n    kaku globals_at = binary.reader_offset(input);\n    kaku globals = binary.reader_read_u32_be(input);\n    moshi (globals.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), globals_at, 4); }\n    moshi (int64(globals.value) > MAX_GLOBALS) { kaesu failure(DecodeErrorKind.LimitExceeded(), globals_at, int64(globals.value)); }\n    kaku instructions_at = binary.reader_offset(input);\n    kaku instruction_length = binary.reader_read_u32_be(input);\n    moshi (instruction_length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), instructions_at, 4); }\n    moshi (int64(instruction_length.value) > MAX_INSTRUCTION_BYTES) {\n        kaesu failure(DecodeErrorKind.LimitExceeded(), instructions_at, int64(instruction_length.value));\n    }\n    kaku instruction_data = binary.reader_read_bytes(input, int64(instruction_length.value));\n    moshi (instruction_data.error != mu) {\n        kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), int64(instruction_length.value));\n    }\n    kaku functions = array.with_capacity[Function](0);\n    moshi (version >= 2) {\n        kaku functions_at = binary.reader_offset(input);\n        kaku function_count = binary.reader_read_u32_be(input);\n        moshi (function_count.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), functions_at, 4); }\n        moshi (int64(function_count.value) > MAX_FUNCTIONS) {\n            kaesu failure(DecodeErrorKind.LimitExceeded(), functions_at, int64(function_count.value));\n        }\n        functions = array.with_capacity[Function](int64(function_count.value));\n        index = 0;\n        aida (index < int64(function_count.value)) {\n            kaku function_at = binary.reader_offset(input);\n            kaku id = binary.reader_read_u16_be(input);\n            kaku name_length = binary.reader_read_u16_be(input);\n            moshi (id.error != mu || name_length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), function_at, 4); }\n            moshi (int64(id.value) != index) { kaesu failure(DecodeErrorKind.InvalidFunction(), function_at, int64(id.value)); }\n            kaku name_data = binary.reader_read_bytes(input, int64(name_length.value));\n            moshi (name_data.error != mu) {\n                kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), int64(name_length.value));\n            }\n            moshi (len(name_data.data) == 0) { kaesu failure(DecodeErrorKind.InvalidFunction(), function_at + 4, 0); }\n            moshi (!utf8.valid(name_data.data)) { kaesu failure(DecodeErrorKind.InvalidUtf8(), function_at + 4, len(name_data.data)); }\n            kaku name = string.from_utf8(name_data.data);\n            moshi (name == mu) { kaesu failure(DecodeErrorKind.InvalidUtf8(), function_at + 4, len(name_data.data)); }\n            kaku parameter_at = binary.reader_offset(input);\n            kaku parameters = binary.reader_read_u32_be(input);\n            kaku locals = binary.reader_read_u32_be(input);\n            kaku flags = binary.reader_read_u8(input);\n            moshi (parameters.error != mu || locals.error != mu || flags.error != mu) {\n                kaesu failure(DecodeErrorKind.Truncated(), parameter_at, 9);\n            }\n            moshi (int64(parameters.value) > MAX_FUNCTION_SLOTS || int64(locals.value) < int64(parameters.value) || int64(locals.value) > MAX_FUNCTION_SLOTS || flags.value > uint8(1)) {\n                kaesu failure(DecodeErrorKind.InvalidFunction(), parameter_at, index);\n            }\n            kaku captures = array.with_capacity[Capture](0);\n            moshi (version >= 9) {\n                kaku capture_at = binary.reader_offset(input);\n                kaku capture_count = binary.reader_read_u32_be(input);\n                moshi (capture_count.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), capture_at, 4); }\n                moshi (int64(capture_count.value) > MAX_FUNCTION_SLOTS) {\n                    kaesu failure(DecodeErrorKind.LimitExceeded(), capture_at, int64(capture_count.value));\n                }\n                captures = array.with_capacity[Capture](int64(capture_count.value));\n                kaku capture_index = 0;\n                aida (capture_index < int64(capture_count.value)) {\n                    kaku source = binary.reader_read_u8(input);\n                    kaku capture_slot = binary.reader_read_u32_be(input);\n                    moshi (source.error != mu || capture_slot.error != mu) {\n                        kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 5);\n                    }\n                    moshi (source.value > uint8(1) || int64(capture_slot.value) >= MAX_FUNCTION_SLOTS) {\n                        kaesu failure(DecodeErrorKind.InvalidFunction(), capture_at, capture_index);\n                    }\n                    array.push(captures, Capture { local: source.value == uint8(1), index: int64(capture_slot.value) });\n                    capture_index = capture_index + 1;\n                }\n            }\n            kaku length_at = binary.reader_offset(input);\n            kaku length = binary.reader_read_u32_be(input);\n            moshi (length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), length_at, 4); }\n            moshi (int64(length.value) > MAX_INSTRUCTION_BYTES) {\n                kaesu failure(DecodeErrorKind.LimitExceeded(), length_at, int64(length.value));\n            }\n            kaku body = binary.reader_read_bytes(input, int64(length.value));\n            moshi (body.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), int64(length.value)); }\n            array.push(functions, Function { id: int64(id.value), name: name, name_bytes: name_data.data,\n                    parameter_count: int64(parameters.value), local_count: int64(locals.value), returns_value: flags.value == uint8(1),\n                    captures: captures, instructions: body.data });\n            index = index + 1;\n        }\n    }\n    moshi (!binary.reader_eof(input)) {\n        kaesu failure(DecodeErrorKind.TrailingData(), binary.reader_offset(input), binary.reader_remaining(input));\n    }\n    kaku file = File { version: version, constants: constants, global_count: int64(globals.value),\n        instructions: instruction_data.data, functions: functions };\n    kaku validation = validate_instructions(file, file.instructions, -1);\n    moshi (validation != mu) { kaesu DecodeResult { value: mu, error: validation }; }\n    index = 0;\n    aida (index < len(file.functions)) {\n        kaku f = file.functions[index];\n        moshi (win64c.is_external(f.name)) {\n            moshi (win64c.validate(f.name, f.parameter_count, f.returns_value) != \"\" || len(f.instructions) != 0 || len(f.captures) != 0 || f.local_count != f.parameter_count) { kaesu failure(DecodeErrorKind.InvalidFunction(), index, 0); }\n        }\n        validation = validate_instructions(file, file.functions[index].instructions, index);\n        moshi (validation != mu) { kaesu DecodeResult { value: mu, error: validation }; }\n        index = index + 1;\n    }\n    kaesu DecodeResult { value: file, error: mu };\n}\n\nkoukai waza error_code(error: DecodeError) -> int64 {\n    awase (error.kind) {\n        baai Truncated {\n            kaesu 1;\n        }\n        baai InvalidMagic {\n            kaesu 2;\n        }\n        baai UnsupportedVersion {\n            kaesu 3;\n        }\n        baai LimitExceeded {\n            kaesu 4;\n        }\n        baai InvalidConstant {\n            kaesu 5;\n        }\n        baai InvalidUtf8 {\n            kaesu 6;\n        }\n        baai InvalidFunction {\n            kaesu 7;\n        }\n        baai InvalidInstruction {\n            kaesu 8;\n        }\n        baai InvalidIndex {\n            kaesu 9;\n        }\n        baai InvalidJump {\n            kaesu 10;\n        }\n        baai TrailingData {\n            kaesu 11;\n        }\n        baai IoFailure {\n            kaesu 12;\n        }\n    }\n    kaesu 0;\n}\n" }; }
waza data_77() -> File { kaesu File { path: "kiso/encoding/mochi/encode.mio", version: "Bunko-v2.1.1", length: 3837, sha256: "eff6ac3cf16e3e61c5645439cd9847d1878e594a8b8e82c04e691a8c64cf0053", source: "yobu \"kiso/encoding/binary\";\n\nwaza write_constant(output: binary.BinaryWriter, value: Constant) -> unit {\n    binary.writer_write_u8(output, value.tag);\n    moshi (value.tag == uint8(1) || value.tag == uint8(3)) {\n        binary.writer_write_u64_be(output, value.bits);\n        kaesu;\n    }\n    moshi (value.tag == uint8(2)) {\n        binary.writer_write_length_prefixed(output, value.data);\n        kaesu;\n    }\n    moshi (value.tag == uint8(4) || value.tag == uint8(7) || value.tag == uint8(10)) {\n        binary.writer_write_u32_be(output, value.bits.low);\n        kaesu;\n    }\n    moshi (value.tag == uint8(6) || value.tag == uint8(9)) {\n        binary.writer_write_u16_be(output, uint16(value.bits.low));\n        kaesu;\n    }\n    binary.writer_write_u8(output, uint8(value.bits.low));\n}\n\n// canonical_bytes deterministically serializes every decoded field.  For a valid\n// Mochi file this is a structural normalization, not a copy of the input buffer.\nkoukai waza canonical_bytes(value: File) -> []uint8 {\n    kaku output = binary.writer(MAX_FILE_SIZE);\n    binary.writer_write_bytes(output, [77, 79, 67, 72, 73]);\n    binary.writer_write_u16_be(output, uint16(value.version));\n    binary.writer_write_u32_be(output, uint32(len(value.constants)));\n    kaku index = 0;\n    aida (index < len(value.constants)) {\n        write_constant(output, value.constants[index]);\n        index = index + 1;\n    }\n    binary.writer_write_u32_be(output, uint32(value.global_count));\n    binary.writer_write_length_prefixed(output, value.instructions);\n    moshi (value.version >= 2) {\n        binary.writer_write_u32_be(output, uint32(len(value.functions)));\n        index = 0;\n        aida (index < len(value.functions)) {\n            kaku function = value.functions[index];\n            binary.writer_write_u16_be(output, uint16(function.id));\n            binary.writer_write_u16_be(output, uint16(len(function.name_bytes)));\n            binary.writer_write_bytes(output, function.name_bytes);\n            binary.writer_write_u32_be(output, uint32(function.parameter_count));\n            binary.writer_write_u32_be(output, uint32(function.local_count));\n            kaku flags = uint8(0);\n            moshi (function.returns_value) {\n                flags = uint8(1);\n            }\n            binary.writer_write_u8(output, flags);\n            moshi (value.version >= 9) {\n                binary.writer_write_u32_be(output, uint32(len(function.captures)));\n                kaku capture_index = 0;\n                aida (capture_index < len(function.captures)) {\n                    kaku source = uint8(0);\n                    moshi (function.captures[capture_index].local) {\n                        source = uint8(1);\n                    }\n                    binary.writer_write_u8(output, source);\n                    binary.writer_write_u32_be(output, uint32(function.captures[capture_index].index));\n                    capture_index = capture_index + 1;\n                }\n            }\n            binary.writer_write_length_prefixed(output, function.instructions);\n            index = index + 1;\n        }\n    }\n    kaesu binary.writer_bytes(output);\n}\n\nkoukai kata Summary {\n    version: int64;\n    constants: int64;\n    functions: int64;\n    globals: int64;\n    instruction_bytes: int64;\n    canonical_size: int64;\n}\n\nkoukai waza summarize(value: File) -> Summary {\n    kaku instruction_bytes = len(value.instructions);\n    kaku index = 0;\n    aida (index < len(value.functions)) {\n        instruction_bytes = instruction_bytes + len(value.functions[index].instructions);\n        index = index + 1;\n    }\n    kaesu Summary { version: value.version, constants: len(value.constants), functions: len(value.functions),\n        globals: value.global_count, instruction_bytes: instruction_bytes, canonical_size: len(canonical_bytes(value)) };\n}\n" }; }
waza data_78() -> File { kaesu File { path: "kiso/encoding/mochi/file.mio", version: "Bunko-v2.1.1", length: 1557, sha256: "3ea2d479d025d1b15184ba14d41c8ca1a082af8e5a03d0aa1a7881f83f05a22c", source: "yobu \"kiso/array\";\nyobu \"kiso/fs\";\n\n// decode_file enforces the Mochi file ceiling while reading, before an attacker-\n// controlled file can cause an unbounded destination allocation.\nkoukai waza decode_file(path: string) -> DecodeResult {\n    kaku opened = fs.open_read(path);\n    kaku open_error = opened.error;\n    moshi (open_error != mu) { kaesu failure(DecodeErrorKind.IoFailure(), 0, 0); }\n    kaku file = opened.file;\n    moshi (file == mu) { kaesu failure(DecodeErrorKind.IoFailure(), 0, 0); }\n    kaku output = array.with_capacity[uint8](32768);\n    kaku buffer = array.make[uint8](32768, uint8(0));\n    aida (hai) {\n        kaku result = fs.read(file, buffer, 0, len(buffer));\n        kaku read_error = result.error;\n        moshi (read_error != mu) {\n            fs.close(file);\n            kaesu failure(DecodeErrorKind.IoFailure(), len(output), 0);\n        }\n        moshi (result.count > MAX_FILE_SIZE - len(output)) {\n            fs.close(file);\n            kaesu failure(DecodeErrorKind.LimitExceeded(), len(output), result.count);\n        }\n        kaku index = 0;\n        aida (index < result.count) {\n            array.push(output, buffer[index]);\n            index = index + 1;\n        }\n        moshi (result.eof) { nukeru; }\n        moshi (result.count == 0) {\n            fs.close(file);\n            kaesu failure(DecodeErrorKind.IoFailure(), len(output), 0);\n        }\n    }\n    kaku closed = fs.close(file);\n    moshi (closed.error != mu) { kaesu failure(DecodeErrorKind.IoFailure(), len(output), 0); }\n    kaesu decode(output);\n}\n" }; }
waza data_79() -> File { kaesu File { path: "kiso/encoding/win64c/prototype.mio", version: "Bunko-v2.1.1", length: 5194, sha256: "d049e064e68e98e12bf1b033aa3b6609b32319de647ca048149c28113d292ccb", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// 显式的空指令 native stub 协议：DLL、导出名、返回类型、参数类型。\n// 复用 Mochi 名称槽，不改变文件版本、普通调用指令或 Runtime ABI。\nkoukai teisu prefix = \"$win64c|\";\nkoukai waza is_external(name: string) -> bool { kaesu string.has_prefix(name, prefix); }\nkoukai waza parts(name: string) -> []string {\n    kaku result: []string = []; kaku word: []uint8 = [];\n    kaku bytes = string.to_bytes(name); kaku i = 0;\n    aida (i < len(bytes)) {\n        moshi (bytes[i] == uint8(124)) {\n            kaku text = string.from_utf8(word); moshi (text != mu) { array.push(result, text); }\n            word = [];\n        } sore { array.push(word, bytes[i]); }\n        i = i + 1;\n    }\n    kaku last = string.from_utf8(word); moshi (last != mu) { array.push(result, last); }\n    kaesu result;\n}\nkoukai waza valid_name(name: string, dll: bool) -> bool {\n    kaku bytes = string.to_bytes(name); kaku i = 0;\n    moshi (len(bytes) == 0 || len(bytes) > 255) { kaesu iie; }\n    aida (i < len(bytes)) {\n        kaku c = int64(bytes[i]);\n        moshi (c < 33 || c > 126 || c == 124 || c == 47 || c == 92 || c == 58) { kaesu iie; }\n        i = i + 1;\n    }\n    moshi (dll) {\n        kaku n = len(bytes);\n        moshi (n <= 4 || bytes[n - 4] != uint8(46)) { kaesu iie; }\n        moshi (bytes[n - 3] != uint8(100) && bytes[n - 3] != uint8(68)) { kaesu iie; }\n        moshi (bytes[n - 2] != uint8(108) && bytes[n - 2] != uint8(76)) { kaesu iie; }\n        moshi (bytes[n - 1] != uint8(108) && bytes[n - 1] != uint8(76)) { kaesu iie; }\n    }\n    kaesu hai;\n}\n// 描述符与既有 Mio 标量表示一致；uint64/cptr 是不受 GC 管理的完整 64 位。\nkoukai waza descriptor(name: string) -> int64 {\n    moshi (name == \"unit\") { kaesu 0; }\n    moshi (name == \"int64\" || name == \"uint64\" || name == \"cptr\") { kaesu 1; }\n    moshi (name == \"float64\") { kaesu 2; }\n    moshi (name == \"float32\") { kaesu 3; }\n    moshi (name == \"int8\") { kaesu 12; }\n    moshi (name == \"int16\") { kaesu 13; }\n    moshi (name == \"int32\") { kaesu 14; }\n    moshi (name == \"uint8\") { kaesu 15; }\n    moshi (name == \"uint16\") { kaesu 16; }\n    moshi (name == \"uint32\") { kaesu 17; }\n    kaesu -1;\n}\nkoukai waza validate(name: string, count: int64, returns: bool) -> string {\n    kaku p = parts(name);\n    moshi (len(p) != 4 + count || count > 256) { kaesu \"E_FFI_PROTOTYPE invalid Windows AMD64 C prototype\"; }\n    moshi (p[0] != \"$win64c\" || !valid_name(p[1], hai) || !valid_name(p[2], iie)) { kaesu \"E_FFI_NAME invalid DLL or export name\"; }\n    moshi (descriptor(p[3]) < 0 || (p[3] != \"unit\") != returns) { kaesu \"E_FFI_TYPE unsupported C return type\"; }\n    kaku i = 4;\n    aida (i < len(p)) { moshi (descriptor(p[i]) <= 0) { kaesu \"E_FFI_TYPE unsupported C parameter type\"; } i = i + 1; }\n    moshi (dll_identity(p[1]) == \"mio.dynamic.dll\") {\n        moshi (count < 1 || count > 13) { kaesu \"E_FFI_PROTOTYPE dynamic calls require a uint64 function token and at most 12 native arguments\"; }\n        moshi (p[4] != \"uint64\") { kaesu \"E_FFI_PROTOTYPE dynamic calls require a uint64 function token and at most 12 native arguments\"; }\n    }\n    kaesu \"\";\n}\n\n// Exact (not hashed) fixed signature: return nibble, then up to 12 parameter\n// nibbles; argument count lives at bit 56. Distinct source types stay distinct.\nkoukai waza native_tag(name: string) -> int64 {\n    kaku names: []string = [\"unit\", \"int64\", \"uint64\", \"cptr\", \"float64\", \"float32\", \"int8\", \"uint8\", \"int16\", \"uint16\", \"int32\", \"uint32\"];\n    kaku i = 0; aida (i < len(names)) { moshi (names[i] == name) { kaesu i; } i = i + 1; } kaesu -1;\n}\nkoukai waza native_signature(result: string, parameters: []string) -> int64 {\n    kaku value = native_tag(result); moshi (value < 0 || len(parameters) > 12) { kaesu -1; }\n    kaku factor = 16; kaku i = 0;\n    aida (i < len(parameters)) {\n        kaku tag = native_tag(parameters[i]); moshi (tag <= 0) { kaesu -1; }\n        value = value + tag * factor; factor = factor * 16; i = i + 1;\n    }\n    kaesu value + len(parameters) * 72057594037927936;\n}\nkoukai waza key(dll: string, symbol: string, result: string, parameters: []string) -> string {\n    kaku name = string.concat(prefix, string.concat(dll, string.concat(\"|\", string.concat(symbol, string.concat(\"|\", result)))));\n    kaku i = 0; aida (i < len(parameters)) { name = string.concat(name, string.concat(\"|\", parameters[i])); i = i + 1; }\n    kaesu name;\n}\n\nkoukai waza dll_identity(name: string) -> string {\n    kaku bytes = string.to_bytes(name); kaku i = 0;\n    aida (i < len(bytes)) { moshi (bytes[i] >= uint8(65) && bytes[i] <= uint8(90)) { bytes[i] = uint8(int64(bytes[i]) + 32); } i = i + 1; }\n    kaku result = string.from_utf8(bytes); moshi (result != mu) { kaesu result; } kaesu \"\";\n}\nkoukai waza conflicts(left: string, right: string) -> bool {\n    kaku p = parts(left); kaku q = parts(right);\n    moshi (len(p) < 4 || len(q) < 4) { kaesu iie; }\n    moshi (dll_identity(p[1]) != dll_identity(q[1]) || p[2] != q[2]) { kaesu iie; }\n    moshi (len(p) != len(q)) { kaesu hai; }\n    kaku i = 3; aida (i < len(p)) { moshi (p[i] != q[i]) { kaesu hai; } i = i + 1; }\n    kaesu iie;\n}\n" }; }
waza data_80() -> File { kaesu File { path: "kiso/ffi/darwin/ffi.mio", version: "Bunko-v2.1.1", length: 10182, sha256: "5ae7ac37aacac3c668814be2abf1845f0e861039b1faf47fd0d24917f680cc39", source: "yobu \"kiso/aot/cabi\";\nyobu \"kiso/array\";\nyobu \"kiso/string\";\n\nwaza dlopen(path: cptr, flags: int32) -> cptr = c \"dlopen\";\nwaza dlsym(image: cptr, name: cptr) -> cptr = c \"dlsym\";\nwaza dlclose(image: cptr) -> int32 = c \"dlclose\";\nwaza dlerror() -> cptr = c \"dlerror\";\nwaza malloc(size: uint64) -> cptr = c \"malloc\";\nwaza free(pointer: cptr) -> unit = c \"free\";\nwaza dladdr(address: cptr, info: cptr) -> int32 = c \"dladdr\";\nwaza getsectiondata(image: cptr, segment: cptr, section: cptr, size: cptr) -> cptr = c \"getsectiondata\";\nwaza load_pointer(pointer: cptr, offset: uint64) -> cptr = c \"mio_ffi_load_pointer\";\nwaza pointer_offset(address: cptr, base: cptr) -> int64 = c \"mio_ffi_pointer_offset\";\nwaza load_word(pointer: cptr) -> int64 = c \"mio_ffi_load_word\";\nwaza store_byte(pointer: cptr, offset: uint64, value: uint8) -> unit = c \"mio_ffi_store_byte\";\nwaza load_byte(pointer: cptr, offset: uint64) -> uint8 = c \"mio_ffi_load_byte\";\nwaza call_g(address: cptr) -> int64 = c \"mio_ffi_call_g\";\nwaza call_gg(address: cptr, a: int64) -> int64 = c \"mio_ffi_call_gg\";\nwaza call_ggg(address: cptr, a: int64, b: int64) -> int64 = c \"mio_ffi_call_ggg\";\nwaza call_jj(address: cptr, a: float64) -> float64 = c \"mio_ffi_call_jj\";\nwaza call_jgg(address: cptr, a: int64, b: int64) -> float64 = c \"mio_ffi_call_jgg\";\nwaza call_lg(address: cptr, a: int64) -> bool = c \"mio_ffi_call_lg\";\n\nkata Ticket { id: int64; }\nkoukai kata Library { ticket: Ticket; }\nkoukai kata Function { ticket: Ticket; }\nkoukai kata OpenResult { library: Library?; error: string; }\nkoukai kata SymbolResult { function: Function?; error: string; }\nkoukai kata IntResult { value: int64; error: string; }\nkoukai kata FloatResult { value: float64; error: string; }\nkoukai kata BoolResult { value: bool; error: string; }\n\nkoukai sentaku Prototype {\n    Int64;\n    Int64FromInt64;\n    Int64FromTwoInt64;\n    Float64FromFloat64;\n    Float64FromTwoInt64;\n    BoolFromInt64;\n}\n\nkata LibraryEntry { id: int64; address: cptr; }\nkata FunctionEntry { id: int64; owner: int64; address: cptr; prototype: Prototype; }\nkaku libraries: []LibraryEntry = [];\nkaku functions: []FunctionEntry = [];\nkaku next_id: int64 = 1;\n\nwaza c_string(value: string) -> cptr {\n    kaku bytes = string.to_bytes(value);\n    moshi (len(bytes) == 0 || len(bytes) > 4096) { kaesu cptr(0); }\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        moshi (bytes[at] == uint8(0)) { kaesu cptr(0); }\n        at = at + 1;\n    }\n    kaku buffer = malloc(uint64(len(bytes) + 1));\n    moshi (buffer == cptr(0)) { kaesu buffer; }\n    at = 0;\n    aida (at < len(bytes)) {\n        store_byte(buffer, uint64(at), bytes[at]);\n        at = at + 1;\n    }\n    store_byte(buffer, uint64(at), uint8(0));\n    kaesu buffer;\n}\n\nwaza error_text(address: cptr, fallback: string) -> string {\n    moshi (address == cptr(0)) { kaesu fallback; }\n    kaku bytes: []uint8 = [];\n    kaku at = 0;\n    aida (at < 4096) {\n        kaku byte = load_byte(address, uint64(at));\n        moshi (byte == uint8(0)) { nukeru; }\n        array.push(bytes, byte);\n        at = at + 1;\n    }\n    kaku value = string.from_utf8(bytes);\n    moshi (value == mu) { kaesu fallback; }\n    moshi (at == 0) { kaesu fallback; }\n    kaesu value;\n}\n\nwaza library_slot(library: Library) -> int64 {\n    kaku at = 0;\n    aida (at < len(libraries)) {\n        moshi (libraries[at].id == library.ticket.id) { kaesu at; }\n        at = at + 1;\n    }\n    kaesu -1;\n}\n\nkata LookupResult { address: cptr; error: string; }\nwaza lookup(image: cptr, name: string) -> LookupResult {\n    kaku buffer = c_string(name);\n    moshi (buffer == cptr(0)) { kaesu LookupResult { address: cptr(0), error: \"invalid or unallocatable symbol name\" }; }\n    dlerror();\n    kaku address = dlsym(image, buffer);\n    kaku problem = dlerror();\n    kaku error = \"\";\n    moshi (problem != cptr(0) || address == cptr(0)) { error = error_text(problem, \"symbol has no address\"); }\n    free(buffer);\n    kaesu LookupResult { address: address, error: error };\n}\n\nkoukai waza open(path: string) -> OpenResult {\n    kaku buffer = c_string(path);\n    moshi (buffer == cptr(0)) { kaesu OpenResult { library: mu, error: \"invalid or unallocatable library path\" }; }\n    dlerror();\n    // RTLD_FIRST scopes dlsym to this image rather than its dependencies.\n    kaku image = dlopen(buffer, int32(262));\n    kaku error = \"\";\n    moshi (image == cptr(0)) { error = error_text(dlerror(), \"cannot open dynamic library\"); }\n    free(buffer);\n    moshi (error != \"\") { kaesu OpenResult { library: mu, error: error }; }\n    kaku id = next_id; next_id = next_id + 1;\n    array.push(libraries, LibraryEntry { id: id, address: image });\n    kaesu OpenResult { library: Library { ticket: Ticket { id: id } }, error: \"\" };\n}\n\nwaza prototype_code(prototype: Prototype) -> string {\n    awase (prototype) {\n        baai Int64 { kaesu \"g\"; }\n        baai Int64FromInt64 { kaesu \"gg\"; }\n        baai Int64FromTwoInt64 { kaesu \"ggg\"; }\n        baai Float64FromFloat64 { kaesu \"jj\"; }\n        baai Float64FromTwoInt64 { kaesu \"jgg\"; }\n        baai BoolFromInt64 { kaesu \"lg\"; }\n    }\n    kaesu \"\";\n}\n\nwaza text_entry(address: cptr) -> bool {\n    kaku info = malloc(uint64(32));\n    moshi (info == cptr(0)) { kaesu iie; }\n    moshi (dladdr(address, info) == int32(0)) { free(info); kaesu iie; }\n    // Dl_info's second pointer is the image header. Reuse the allocation for\n    // getsectiondata's size_t output after fetching that pointer.\n    kaku image = load_pointer(info, uint64(8));\n    kaku segment = c_string(\"__TEXT\");\n    kaku section = c_string(\"__text\");\n    kaku valid = iie;\n    moshi (image != cptr(0) && segment != cptr(0) && section != cptr(0)) {\n        kaku text = getsectiondata(image, segment, section, info);\n        moshi (text != cptr(0)) {\n            kaku offset = pointer_offset(address, text);\n            valid = offset >= 0 && offset < load_word(info) && offset - (offset / 4) * 4 == 0;\n        }\n    }\n    free(section);\n    free(segment);\n    free(info);\n    kaesu valid;\n}\n\nkoukai waza symbol(library: Library, name: string, prototype: Prototype) -> SymbolResult {\n    kaku slot = library_slot(library);\n    moshi (slot < 0) { kaesu SymbolResult { function: mu, error: \"library is closed\" }; }\n    moshi (!cabi.valid_symbol(name) || !string.has_prefix(name, \"mio_\")) {\n        kaesu SymbolResult { function: mu, error: \"invalid Mio FFI symbol\" };\n    }\n    kaku image = libraries[slot].address;\n    kaku found = lookup(image, name);\n    moshi (found.error != \"\") { kaesu SymbolResult { function: mu, error: found.error }; }\n    kaku marker = lookup(image, cabi.dylib_marker(name, prototype_code(prototype), \"\"));\n    moshi (marker.error != \"\" || marker.address != found.address) {\n        kaesu SymbolResult { function: mu, error: \"Mio FFI function signature mismatch\" };\n    }\n    moshi (!text_entry(found.address)) {\n        kaesu SymbolResult { function: mu, error: \"symbol does not identify an ARM64 text entry\" };\n    }\n    kaku id = next_id; next_id = next_id + 1;\n    array.push(functions, FunctionEntry { id: id, owner: library.ticket.id, address: found.address, prototype: prototype });\n    kaesu SymbolResult { function: Function { ticket: Ticket { id: id } }, error: \"\" };\n}\n\nkoukai waza close(library: Library) -> string {\n    kaku slot = library_slot(library);\n    moshi (slot < 0) { kaesu \"library is closed\"; }\n    dlerror();\n    moshi (dlclose(libraries[slot].address) != int32(0)) {\n        kaesu error_text(dlerror(), \"cannot close dynamic library\");\n    }\n    libraries[slot] = libraries[len(libraries) - 1];\n    array.truncate(libraries, len(libraries) - 1);\n    kaku at = 0;\n    aida (at < len(functions)) {\n        moshi (functions[at].owner == library.ticket.id) {\n            functions[at] = functions[len(functions) - 1];\n            array.truncate(functions, len(functions) - 1);\n        } sore { at = at + 1; }\n    }\n    kaesu \"\";\n}\n\nwaza function_address(function: Function, prototype: Prototype) -> cptr {\n    kaku at = 0;\n    aida (at < len(functions)) {\n        kaku entry = functions[at];\n        moshi (entry.id == function.ticket.id && prototype_code(entry.prototype) == prototype_code(prototype)) { kaesu entry.address; }\n        at = at + 1;\n    }\n    kaesu cptr(0);\n}\n\nkoukai waza invoke_int64(function: Function) -> IntResult {\n    kaku address = function_address(function, Prototype.Int64());\n    moshi (address == cptr(0)) { kaesu IntResult { value: 0, error: \"invalid function or signature\" }; }\n    kaesu IntResult { value: call_g(address), error: \"\" };\n}\n\nkoukai waza invoke_int64_1(function: Function, a: int64) -> IntResult {\n    kaku address = function_address(function, Prototype.Int64FromInt64());\n    moshi (address == cptr(0)) { kaesu IntResult { value: 0, error: \"invalid function or signature\" }; }\n    kaesu IntResult { value: call_gg(address, a), error: \"\" };\n}\n\nkoukai waza invoke_int64_2(function: Function, a: int64, b: int64) -> IntResult {\n    kaku address = function_address(function, Prototype.Int64FromTwoInt64());\n    moshi (address == cptr(0)) { kaesu IntResult { value: 0, error: \"invalid function or signature\" }; }\n    kaesu IntResult { value: call_ggg(address, a, b), error: \"\" };\n}\n\nkoukai waza invoke_float64(function: Function, a: float64) -> FloatResult {\n    kaku address = function_address(function, Prototype.Float64FromFloat64());\n    moshi (address == cptr(0)) { kaesu FloatResult { value: 0.0, error: \"invalid function or signature\" }; }\n    kaesu FloatResult { value: call_jj(address, a), error: \"\" };\n}\n\nkoukai waza invoke_float64_from_ints(function: Function, a: int64, b: int64) -> FloatResult {\n    kaku address = function_address(function, Prototype.Float64FromTwoInt64());\n    moshi (address == cptr(0)) { kaesu FloatResult { value: 0.0, error: \"invalid function or signature\" }; }\n    kaesu FloatResult { value: call_jgg(address, a, b), error: \"\" };\n}\n\nkoukai waza invoke_bool(function: Function, a: int64) -> BoolResult {\n    kaku address = function_address(function, Prototype.BoolFromInt64());\n    moshi (address == cptr(0)) { kaesu BoolResult { value: iie, error: \"invalid function or signature\" }; }\n    kaesu BoolResult { value: call_lg(address, a), error: \"\" };\n}\n" }; }
waza data_81() -> File { kaesu File { path: "kiso/ffi/ffi.mio", version: "Bunko-v2.1.1", length: 3024, sha256: "7050f019b4615d66cf56169a0e81a9ad96f20403c997e9e11d58df2ff591c40b", source: "yobu \"kiso/string\";\nyobu \"kiso/encoding/win64c\";\n\n// Explicit native ownership. All handles are generation-checked uint64 tokens.\nkoukai waza buffer_new(size: uint64) -> uint64 = c \"mio_native_ffi.dll\" \"mio_ffi_buffer_new\";\nkoukai waza buffer_free(buffer: uint64) -> uint32 = c \"mio_native_ffi.dll\" \"mio_ffi_buffer_free\";\nkoukai waza buffer_data(buffer: uint64) -> cptr = c \"mio_native_ffi.dll\" \"mio_ffi_buffer_data\";\nkoukai waza buffer_pointer(buffer: uint64) -> cptr = c \"mio_native_ffi.dll\" \"mio_ffi_buffer_pointer\";\nkoukai waza buffer_set(buffer: uint64, index: uint64, value: uint8) -> uint32 = c \"mio_native_ffi.dll\" \"mio_ffi_buffer_set\";\nkoukai waza buffer_get(buffer: uint64, index: uint64) -> uint8 = c \"mio_native_ffi.dll\" \"mio_ffi_buffer_get\";\nwaza open_native(path: uint64) -> uint64 = c \"mio_native_ffi.dll\" \"mio_ffi_open\";\nwaza symbol_native(library: uint64, name: uint64, signature: uint64) -> uint64 = c \"mio_native_ffi.dll\" \"mio_ffi_symbol\";\nkoukai waza close(library: uint64) -> uint32 = c \"mio_native_ffi.dll\" \"mio_ffi_close\";\nkoukai waza release(function: uint64) -> uint32 = c \"mio_native_ffi.dll\" \"mio_ffi_release\";\nkoukai waza check(function: uint64, signature: uint64) -> uint32 = c \"mio_native_ffi.dll\" \"mio_ffi_check\";\nkoukai waza error() -> uint32 = c \"mio_native_ffi.dll\" \"mio_ffi_error\";\nkoukai waza os_error() -> uint32 = c \"mio_native_ffi.dll\" \"mio_ffi_os_error\";\nkoukai waza address(function: uint64) -> cptr = c \"mio_native_ffi.dll\" \"mio_ffi_address\";\nkoukai waza resources() -> uint32 = c \"mio_native_ffi.dll\" \"mio_ffi_resources\";\n\nkoukai kata Result { handle: uint64; error: uint32; os_error: uint32; }\nkoukai waza signature(result: string, parameters: []string) -> uint64 {\n    kaesu uint64(win64c.native_signature(result, parameters));\n}\nkoukai waza bytes(data: []uint8) -> uint64 {\n    kaku buffer = buffer_new(uint64(len(data)));\n    moshi (buffer == uint64(0)) { kaesu buffer; }\n    kaku i = 0; aida (i < len(data)) { buffer_set(buffer, uint64(i), data[i]); i = i + 1; }\n    kaesu buffer;\n}\nkoukai waza open(path: string) -> Result {\n    kaku buffer = bytes(string.to_bytes(path));\n    moshi (buffer == uint64(0)) { kaesu Result { handle: uint64(0), error: error(), os_error: os_error() }; }\n    kaku handle = open_native(buffer);\n    kaku result = Result { handle: handle, error: error(), os_error: os_error() };\n    buffer_free(buffer); kaesu result;\n}\nkoukai waza symbol(library: uint64, name: string, result: string, parameters: []string) -> Result {\n    kaku descriptor = win64c.native_signature(result, parameters);\n    moshi (descriptor < 0) { kaesu Result { handle: uint64(0), error: uint32(4), os_error: uint32(0) }; }\n    kaku buffer = bytes(string.to_bytes(name));\n    moshi (buffer == uint64(0)) { kaesu Result { handle: uint64(0), error: error(), os_error: os_error() }; }\n    kaku handle = symbol_native(library, buffer, uint64(descriptor));\n    kaku resolved = Result { handle: handle, error: error(), os_error: os_error() };\n    buffer_free(buffer); kaesu resolved;\n}\n" }; }
waza data_82() -> File { kaesu File { path: "kiso/ffi/linux/ffi.mio", version: "Bunko-v2.1.1", length: 26845, sha256: "eeecbcb41c0d8f715c5a72a293a03cdf6da0d96a441155bf6a49f600c41e5969", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// kiso/ffi/linux: run-time loading of ELF shared objects on Linux x86-64 (System V AMD64 ABI).\n// See docs/linux-dynamic-libraries.md.\n//\n// Libraries and functions are opaque, generation-checked handles. A handle names a slot in a\n// module-private table together with the unique id the slot held when the handle was issued; ids are\n// never reused, so a handle whose slot was freed and reused stays invalid. Closing a library frees every\n// function resolved from it. Every typed call validates the handle and the resolved signature before\n// the native call is issued: an invalid, released, stale or mismatched call returns zero and records\n// the reason in last_error(); foreign code is never entered for it.\n//\n// Signature letters (result \":\" parameters): v void, i int32, u uint32, l int64, z uint64/size_t,\n// f float32, d float64, b bool (C uint8_t 0/1), p pointer/handle (opaque cptr),\n// n buffer: the data of a []uint8, passed as the address of its first byte for the duration of the\n// call. A signature has at most 16 letters, exactly one result letter and v only as the result.\n//\n// Threads: programs that declare C functions cannot use OS threads on Linux AMD64 (the compiler rejects\n// them), so the tables below are only ever touched by one thread.\n\nteisu rtld_now = 2;\nteisu rtld_local = 0;\nteisu max_signature = 16;\nteisu max_text = 65536;\n\nwaza c_dlopen(path: []uint8, flags: int32) -> cptr = c \"dlopen\";\nwaza c_dlsym(handle: cptr, name: []uint8) -> cptr = c \"dlsym\";\nwaza c_dlclose(handle: cptr) -> int32 = c \"dlclose\";\nwaza c_dlerror() -> cptr = c \"dlerror\";\n\nkata Ticket { slot: int64; id: int64; }\n\n// A Library or Function whose error is not \"\" is a failed result; it never names a live slot.\nkoukai kata Library { ticket: Ticket; error: string; }\nkoukai kata Function { ticket: Ticket; owner: Ticket; error: string; }\n\n// closing: dlclose failed; the slot keeps the dlopen handle so close can retry, and nothing in it is callable.\nkata LibrarySlot { id: int64; handle: cptr; path: string; closing: bool; }\nkata FunctionSlot { id: int64; owner: Ticket; address: cptr; shape: int64; name: string; signature: string; }\n\nkaku libraries: []LibrarySlot = [];\nkaku functions: []FunctionSlot = [];\nkaku free_libraries: []int64 = [];\nkaku free_functions: []int64 = [];\n// owned[slot]: live functions resolved from the library in that slot, so close scans only when it must.\nkaku owned: []int64 = [];\nkaku live_library_count: int64 = 0;\nkaku live_function_count: int64 = 0;\nkaku pending_close_count: int64 = 0;\nkaku next_id: int64 = 1;\nkaku call_error: string = \"\";\n\nwaza no_ticket() -> Ticket { kaesu Ticket { slot: -1, id: 0 }; }\nwaza failed_library(error: string) -> Library { kaesu Library { ticket: no_ticket(), error: error }; }\nwaza failed_function(owner: Ticket, error: string) -> Function { kaesu Function { ticket: no_ticket(), owner: owner, error: error }; }\n\nwaza fresh_id() -> int64 {\n    kaku id = next_id;\n    next_id = next_id + 1;\n    kaesu id;\n}\n\n// ---------------------------------------------------------------------------------------------------\n// Text helpers\n\n// cstring returns a fresh NUL-terminated copy of text's UTF-8 bytes. It does not alias the string.\nkoukai waza cstring(text: string) -> []uint8 {\n    kaku bytes = string.to_bytes(text);\n    array.push(bytes, uint8(0));\n    kaesu bytes;\n}\n\nwaza has_nul(text: string) -> bool {\n    kaku bytes = string.to_bytes(text);\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        moshi (bytes[at] == uint8(0)) { kaesu hai; }\n        at = at + 1;\n    }\n    kaesu iie;\n}\n\n// The message dlerror() holds, or fallback when there is none. Bounded: never reads past max_text bytes.\nwaza loader_error(fallback: string) -> string {\n    kaku message = c_dlerror();\n    moshi (message == cptr(0) || !native_resolved()) { kaesu fallback; }\n    kaku size = native_strnlen(message, max_text);\n    moshi (size <= 0) { kaesu fallback; }\n    kaku text = string.from_utf8(read_native(message, size));\n    moshi (text == mu) { kaesu fallback; }\n    kaesu text;\n}\n\n// ---------------------------------------------------------------------------------------------------\n// Signatures\n\n// valid_signature reports whether signature is a well-formed signature string (see the letters above).\nkoukai waza valid_signature(signature: string) -> bool {\n    kaku bytes = string.to_bytes(signature);\n    moshi (len(bytes) < 2 || len(bytes) > max_signature) { kaesu iie; }\n    kaku colon = 0 - 1;\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        kaku letter = int64(bytes[at]);\n        moshi (letter == 58) {\n            moshi (colon >= 0) { kaesu iie; }\n            colon = at;\n        } sore {\n            moshi (letter_code(letter) == 0) { kaesu iie; }\n            // v is only a result; n is only a parameter\n            moshi (letter == 118 && at != 0) { kaesu iie; }\n            moshi (letter == 110 && colon < 0) { kaesu iie; }\n        }\n        at = at + 1;\n    }\n    kaesu colon == 1;\n}\n\nwaza letter_code(letter: int64) -> int64 {\n    moshi (letter == 118) { kaesu 2; }  // v\n    moshi (letter == 105) { kaesu 3; }  // i\n    moshi (letter == 117) { kaesu 4; }  // u\n    moshi (letter == 108) { kaesu 5; }  // l\n    moshi (letter == 122) { kaesu 6; }  // z\n    moshi (letter == 102) { kaesu 7; }  // f\n    moshi (letter == 100) { kaesu 8; }  // d\n    moshi (letter == 98) { kaesu 9; }   // b\n    moshi (letter == 112) { kaesu 10; } // p\n    moshi (letter == 110) { kaesu 11; } // n\n    kaesu 0;\n}\n\n// shape_of is the injective base-12 code of a valid signature (\":\" is 1, letters 2..11), so a call compares\n// one integer instead of two strings. It is -1 for an invalid signature.\nkoukai waza shape_of(signature: string) -> int64 {\n    moshi (!valid_signature(signature)) { kaesu -1; }\n    kaku bytes = string.to_bytes(signature);\n    kaku value = 0;\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        kaku letter = int64(bytes[at]);\n        kaku code = 1;\n        moshi (letter != 58) { code = letter_code(letter); }\n        value = value * 12 + code;\n        at = at + 1;\n    }\n    kaesu value;\n}\n\n// ---------------------------------------------------------------------------------------------------\n// Libraries\n\nwaza add_library(handle: cptr, path: string) -> Library {\n    kaku id = fresh_id();\n    kaku entry = LibrarySlot { id: id, handle: handle, path: path, closing: iie };\n    kaku slot = 0;\n    moshi (len(free_libraries) > 0) {\n        slot = free_libraries[len(free_libraries) - 1];\n        array.truncate(free_libraries, len(free_libraries) - 1);\n        libraries[slot] = entry;\n        owned[slot] = 0;\n    } sore {\n        slot = len(libraries);\n        array.push(libraries, entry);\n        array.push(owned, 0);\n    }\n    live_library_count = live_library_count + 1;\n    kaesu Library { ticket: Ticket { slot: slot, id: id }, error: \"\" };\n}\n\nwaza load(path: string, request: string) -> Library {\n    // Resolve the helpers first: any dlsym after a failed dlopen would clear its dlerror message.\n    native_ready();\n    c_dlerror();\n    kaku handle = c_dlopen(cstring(request), int32(rtld_now + rtld_local));\n    moshi (handle == cptr(0)) { kaesu failed_library(string.concat(\"E_FFI_LOAD \", loader_error(\"dlopen failed\"))); }\n    invalidate_maps();\n    kaesu add_library(handle, path);\n}\n\n// open loads the shared object at path with RTLD_NOW | RTLD_LOCAL: every undefined symbol is bound before\n// open returns and the library's symbols do not satisfy later loads. The path must be absolute or contain a\n// \"/\" (for example \"./libfoo.so\"); a bare name is rejected instead of silently searching the system library\n// path (use open_system for that).\nkoukai waza open(path: string) -> Library {\n    moshi (len(string.to_bytes(path)) == 0) { kaesu failed_library(\"E_FFI_PATH empty library path\"); }\n    moshi (has_nul(path)) { kaesu failed_library(\"E_FFI_PATH library path contains a NUL byte\"); }\n    moshi (!string.contains(path, \"/\")) {\n        kaesu failed_library(\"E_FFI_PATH library path must be absolute or contain a directory part such as ./libname.so\");\n    }\n    kaesu load(path, path);\n}\n\n// open_system loads a library by file name through the system loader's search (LD_LIBRARY_PATH, the cache\n// and the default directories), for example \"libz.so.1\". The name must not contain \"/\".\nkoukai waza open_system(name: string) -> Library {\n    moshi (len(string.to_bytes(name)) == 0) { kaesu failed_library(\"E_FFI_PATH empty library name\"); }\n    moshi (has_nul(name)) { kaesu failed_library(\"E_FFI_PATH library name contains a NUL byte\"); }\n    moshi (string.contains(name, \"/\")) { kaesu failed_library(\"E_FFI_PATH a system library name must not contain /; use open for paths\"); }\n    kaesu load(name, name);\n}\n\n// The slot of an open library, or -1 (closed, closing after a failed dlclose, or never opened).\nwaza library_slot(ticket: Ticket) -> int64 {\n    kaku slot = any_library_slot(ticket);\n    moshi (slot < 0 || libraries[slot].closing) { kaesu -1; }\n    kaesu slot;\n}\n\nwaza any_library_slot(ticket: Ticket) -> int64 {\n    moshi (ticket.slot < 0 || ticket.slot >= len(libraries)) { kaesu -1; }\n    moshi (libraries[ticket.slot].id != ticket.id) { kaesu -1; }\n    kaesu ticket.slot;\n}\n\n// close_pending reports whether an earlier close invalidated library but dlclose failed. Its functions are not\n// callable; calling close again retries dlclose.\nkoukai waza close_pending(library: Library) -> bool {\n    kaku slot = any_library_slot(library.ticket);\n    kaesu slot >= 0 && libraries[slot].closing;\n}\n\n// libraries_pending_close counts libraries whose dlclose failed and has not been retried successfully.\nkoukai waza libraries_pending_close() -> int64 { kaesu pending_close_count; }\n\n// failed reports whether open or open_system failed for this library.\nkoukai waza failed(library: Library) -> bool { kaesu library.error != \"\"; }\n\n// library_error is the reason open failed, or \"\".\nkoukai waza library_error(library: Library) -> string { kaesu library.error; }\n\n// is_open reports whether library loaded and has not been closed.\nkoukai waza is_open(library: Library) -> bool { kaesu library.error == \"\" && library_slot(library.ticket) >= 0; }\n\n// path is the path or name the library was opened with; \"\" when it is not open.\nkoukai waza path(library: Library) -> string {\n    kaku slot = library_slot(library.ticket);\n    moshi (slot < 0) { kaesu \"\"; }\n    kaesu libraries[slot].path;\n}\n\n// close invalidates library and every function resolved from it, then unloads it with dlclose. It returns \"\"\n// on success. Closing twice, or closing a library that never loaded, returns an error and does nothing.\n// When dlclose fails the invalidation stands (no function of the library becomes callable again), the result is\n// E_FFI_CLOSE and the library stays pending (close_pending); a later close retries dlclose and returns \"\" once it\n// succeeds.\nkoukai waza close(library: Library) -> string {\n    moshi (failed(library)) { kaesu \"E_FFI_STATE the library did not load\"; }\n    kaku pending = any_library_slot(library.ticket);\n    moshi (pending >= 0 && libraries[pending].closing) { kaesu finish_close(pending, iie); }\n    kaku slot = library_slot(library.ticket);\n    moshi (slot < 0) { kaesu \"E_FFI_CLOSED the library is already closed\"; }\n    kaku handle = libraries[slot].handle;\n    // Invalidate first: no handle of this library can reach native code once close has started.\n    kaku at = 0;\n    aida (owned[slot] > 0 && at < len(functions)) {\n        kaku entry = functions[at];\n        moshi (entry.id != 0 && entry.owner.slot == slot && entry.owner.id == library.ticket.id) { free_function(at); }\n        at = at + 1;\n    }\n    live_library_count = live_library_count - 1;\n    kaku entry = libraries[slot];\n    libraries[slot] = LibrarySlot { id: entry.id, handle: handle, path: entry.path, closing: hai };\n    pending_close_count = pending_close_count + 1;\n    kaesu finish_close(slot, hai);\n}\n\n// dlclose of a closing slot; frees the slot on success, keeps it pending on failure.\nwaza finish_close(slot: int64, first: bool) -> string {\n    native_ready();\n    c_dlerror();\n    moshi (c_dlclose(libraries[slot].handle) != int32(0)) {\n        kaku reason = loader_error(\"dlclose failed\");\n        moshi (first) { kaesu string.concat(\"E_FFI_CLOSE \", reason); }\n        kaesu string.concat(\"E_FFI_CLOSE retry failed: \", reason);\n    }\n    libraries[slot] = LibrarySlot { id: 0, handle: cptr(0), path: \"\", closing: iie };\n    array.push(free_libraries, slot);\n    pending_close_count = pending_close_count - 1;\n    invalidate_maps();\n    kaesu \"\";\n}\n\n// ---------------------------------------------------------------------------------------------------\n// Functions\n\nwaza free_function(slot: int64) -> unit {\n    kaku owner = functions[slot].owner.slot;\n    owned[owner] = owned[owner] - 1;\n    functions[slot] = FunctionSlot { id: 0, owner: no_ticket(), address: cptr(0), shape: 0, name: \"\", signature: \"\" };\n    array.push(free_functions, slot);\n    live_function_count = live_function_count - 1;\n}\n\n// symbol resolves name in library. signature records the C prototype the caller claims for it; every call\n// through the returned Function must use a wrapper of exactly that signature.\nkoukai waza symbol(library: Library, name: string, signature: string) -> Function {\n    moshi (failed(library)) { kaesu failed_function(library.ticket, \"E_FFI_STATE the library did not load\"); }\n    kaku owner = library_slot(library.ticket);\n    moshi (owner < 0) { kaesu failed_function(library.ticket, \"E_FFI_CLOSED the library is closed\"); }\n    moshi (len(string.to_bytes(name)) == 0 || has_nul(name)) { kaesu failed_function(library.ticket, \"E_FFI_SYMBOL invalid symbol name\"); }\n    moshi (!valid_signature(signature)) { kaesu failed_function(library.ticket, string.concat(\"E_FFI_SIGNATURE invalid signature \", signature)); }\n    // dlerror() must be cleared first: NULL is a legal symbol value in general, an error is not. The helpers are\n    // resolved before, because their dlsym calls would clear a failure message.\n    native_ready();\n    c_dlerror();\n    kaku address = c_dlsym(libraries[owner].handle, cstring(name));\n    moshi (address == cptr(0)) {\n        kaesu failed_function(library.ticket, string.concat(\"E_FFI_SYMBOL \", loader_error(string.concat(\"symbol has no address: \", name))));\n    }\n    kaku code = code_check(address, name);\n    moshi (code != \"\") { kaesu failed_function(library.ticket, code); }\n    kaku id = fresh_id();\n    kaku entry = FunctionSlot { id: id, owner: library.ticket, address: address, shape: shape_of(signature), name: name, signature: signature };\n    kaku slot = 0;\n    moshi (len(free_functions) > 0) {\n        slot = free_functions[len(free_functions) - 1];\n        array.truncate(free_functions, len(free_functions) - 1);\n        functions[slot] = entry;\n    } sore {\n        slot = len(functions);\n        array.push(functions, entry);\n    }\n    live_function_count = live_function_count + 1;\n    owned[owner] = owned[owner] + 1;\n    kaesu Function { ticket: Ticket { slot: slot, id: id }, owner: library.ticket, error: \"\" };\n}\n\nwaza function_slot(ticket: Ticket) -> int64 {\n    moshi (ticket.slot < 0 || ticket.slot >= len(functions)) { kaesu -1; }\n    moshi (functions[ticket.slot].id != ticket.id) { kaesu -1; }\n    kaesu ticket.slot;\n}\n\n// error is the reason symbol failed, or \"\".\nkoukai waza error(function: Function) -> string { kaesu function.error; }\n\n// resolved reports whether symbol succeeded for this function (it may have been released or closed since).\nkoukai waza resolved(function: Function) -> bool { kaesu function.error == \"\"; }\n\n// is_live reports whether function can still be called: it resolved, it was not released and its library\n// is still open.\nkoukai waza is_live(function: Function) -> bool { kaesu function.error == \"\" && function_slot(function.ticket) >= 0; }\n\n// signature is the signature function was resolved with; \"\" when it is not live.\nkoukai waza signature(function: Function) -> string {\n    kaku slot = function_slot(function.ticket);\n    moshi (slot < 0) { kaesu \"\"; }\n    kaesu functions[slot].signature;\n}\n\n// release frees one function handle. Its library stays open. Returns \"\" or the reason it was not live.\nkoukai waza release(function: Function) -> string {\n    kaku slot = function_slot(function.ticket);\n    moshi (slot < 0) { kaesu dead_reason(function); }\n    free_function(slot);\n    kaesu \"\";\n}\n\nwaza dead_reason(function: Function) -> string {\n    moshi (function.error != \"\") { kaesu \"E_FFI_STATE the symbol was not resolved\"; }\n    moshi (library_slot(function.owner) < 0) { kaesu \"E_FFI_CLOSED the library was closed\"; }\n    kaesu \"E_FFI_STALE the function handle was released\";\n}\n\n// check returns \"\" when function is live and was resolved with exactly signature, otherwise the reason a call\n// of that signature would be refused.\nkoukai waza check(function: Function, signature: string) -> string {\n    moshi (!valid_signature(signature)) { kaesu string.concat(\"E_FFI_SIGNATURE invalid signature \", signature); }\n    kaku slot = function_slot(function.ticket);\n    moshi (slot < 0) { kaesu dead_reason(function); }\n    moshi (functions[slot].shape != shape_of(signature)) {\n        kaesu string.concat(\"E_FFI_SIGNATURE resolved as \", string.concat(functions[slot].signature, string.concat(\", called as \", signature)));\n    }\n    kaesu \"\";\n}\n\n// last_error is \"\" after a typed call that reached native code, otherwise the reason the most recent typed\n// call (or unsafe_address) was refused.\nkoukai waza last_error() -> string { kaesu call_error; }\n\n// last_call_ok reports whether the most recent typed call reached native code. A refused call returns zero, and zero\n// can also be a real result, so this (or last_error) is how a caller tells them apart.\nkoukai waza last_call_ok() -> bool { kaesu call_error == \"\"; }\n\n// Records the outcome of an operation of another file of this package for last_error / last_call_ok.\nwaza set_call_error(text: string) -> unit { call_error = text; }\n\n// The gate in front of every native call: the function's address when the call may proceed, otherwise\n// cptr(0) with the reason in last_error().\nwaza gate(function: Function, shape: int64) -> cptr {\n    kaku slot = function.ticket.slot;\n    moshi (slot < 0 || slot >= len(functions)) { call_error = dead_reason(function); kaesu cptr(0); }\n    kaku entry = functions[slot];\n    moshi (entry.id != function.ticket.id) { call_error = dead_reason(function); kaesu cptr(0); }\n    moshi (entry.shape != shape) {\n        call_error = \"E_FFI_SIGNATURE the call does not match the resolved signature\";\n        kaesu cptr(0);\n    }\n    call_error = \"\";\n    kaesu entry.address;\n}\n\n// UNSAFE. unsafe_address returns the raw native address of function for a hand-written\n// `= c \"mio_ffi_indirect\"` declaration, after the same validation as a typed call; cptr(0) (with last_error() set)\n// when it would be refused. An indirect call through cptr(0) traps with a nil-reference error instead of jumping to\n// address 0. The returned address is a plain integer-like value: it does not own or pin the library, and close or\n// release cannot invalidate a copy of it. Call unsafe_address at the call site; never cache the address. The\n// declaration must match the real C prototype: the signature only records what the caller claims.\nkoukai waza unsafe_address(function: Function, signature: string) -> cptr { kaesu address(function, signature); }\n\n// address is the earlier name of unsafe_address, kept for compatibility. It is exactly as unsafe.\nkoukai waza address(function: Function, signature: string) -> cptr {\n    kaku shape = shape_of(signature);\n    moshi (shape < 0) { call_error = string.concat(\"E_FFI_SIGNATURE invalid signature \", signature); kaesu cptr(0); }\n    kaesu gate(function, shape);\n}\n\n// libraries_open and functions_live count the live handles in this process (for leak checks).\nkoukai waza libraries_open() -> int64 { kaesu live_library_count; }\nkoukai waza functions_live() -> int64 { kaesu live_function_count; }\n\n// ---------------------------------------------------------------------------------------------------\n// Typed calls. Each wrapper is one fixed System V AMD64 prototype; its name spells the signature\n// (call_<result>_<parameters>). A refused call returns zero (iie, cptr(0)) and sets last_error().\n\nteisu s_v = 25;           // \"v:\"\nteisu s_i = 37;           // \"i:\"\nteisu s_l = 61;           // \"l:\"\nteisu s_p = 121;          // \"p:\"\nteisu s_z = 73;           // \"z:\"\nteisu s_i_i = 447;        // \"i:i\"\nteisu s_l_l = 737;        // \"l:l\"\nteisu s_d_d = 1172;       // \"d:d\"\nteisu s_b_i = 1311;       // \"b:i\"\nteisu s_i_p = 454;        // \"i:p\"\nteisu s_v_p = 310;        // \"v:p\"\nteisu s_p_n = 1463;       // \"p:n\"\nteisu s_i_ii = 5367;      // \"i:ii\"\nteisu s_l_ll = 8849;      // \"l:ll\"\nteisu s_f_ff = 12331;     // \"f:ff\"\nteisu s_d_dd = 14072;     // \"d:dd\"\nteisu s_z_nz = 10650;     // \"z:nz\"\nteisu s_u_nz = 7194;      // \"u:nz\"\nteisu s_l_pn = 8915;      // \"l:pn\"\nteisu s_i_pn = 5459;      // \"i:pn\"\nteisu s_i_nzn = 65603;    // \"i:nzn\"\nteisu s_l_pnnz = 1283898; // \"l:pnnz\"\nteisu s_l_nznz = 1284906; // \"l:nznz\"\n\nwaza raw_v(f: cptr) -> unit = c \"mio_ffi_indirect\";\nwaza raw_i(f: cptr) -> int32 = c \"mio_ffi_indirect\";\nwaza raw_l(f: cptr) -> int64 = c \"mio_ffi_indirect\";\nwaza raw_p(f: cptr) -> cptr = c \"mio_ffi_indirect\";\nwaza raw_z(f: cptr) -> uint64 = c \"mio_ffi_indirect\";\nwaza raw_i_i(f: cptr, a: int32) -> int32 = c \"mio_ffi_indirect\";\nwaza raw_l_l(f: cptr, a: int64) -> int64 = c \"mio_ffi_indirect\";\nwaza raw_d_d(f: cptr, a: float64) -> float64 = c \"mio_ffi_indirect\";\nwaza raw_b_i(f: cptr, a: int32) -> bool = c \"mio_ffi_indirect\";\nwaza raw_i_p(f: cptr, handle: cptr) -> int32 = c \"mio_ffi_indirect\";\nwaza raw_v_p(f: cptr, handle: cptr) -> unit = c \"mio_ffi_indirect\";\nwaza raw_p_n(f: cptr, data: []uint8) -> cptr = c \"mio_ffi_indirect\";\nwaza raw_i_ii(f: cptr, a: int32, b: int32) -> int32 = c \"mio_ffi_indirect\";\nwaza raw_l_ll(f: cptr, a: int64, b: int64) -> int64 = c \"mio_ffi_indirect\";\nwaza raw_f_ff(f: cptr, a: float32, b: float32) -> float32 = c \"mio_ffi_indirect\";\nwaza raw_d_dd(f: cptr, a: float64, b: float64) -> float64 = c \"mio_ffi_indirect\";\nwaza raw_z_nz(f: cptr, data: []uint8, size: uint64) -> uint64 = c \"mio_ffi_indirect\";\nwaza raw_u_nz(f: cptr, data: []uint8, size: uint64) -> uint32 = c \"mio_ffi_indirect\";\nwaza raw_l_pn(f: cptr, handle: cptr, text: []uint8) -> int64 = c \"mio_ffi_indirect\";\nwaza raw_i_pn(f: cptr, handle: cptr, text: []uint8) -> int32 = c \"mio_ffi_indirect\";\nwaza raw_i_nzn(f: cptr, data: []uint8, size: uint64, out: []uint8) -> int32 = c \"mio_ffi_indirect\";\nwaza raw_l_pnnz(f: cptr, handle: cptr, text: []uint8, out: []uint8, size: uint64) -> int64 = c \"mio_ffi_indirect\";\nwaza raw_l_nznz(f: cptr, a: []uint8, an: uint64, b: []uint8, bn: uint64) -> int64 = c \"mio_ffi_indirect\";\n\nkoukai waza call_v_(s: Function) -> unit { kaku f = gate(s, s_v); moshi (f == cptr(0)) { kaesu; } raw_v(f); }\nkoukai waza call_i_(s: Function) -> int32 { kaku f = gate(s, s_i); moshi (f == cptr(0)) { kaesu int32(0); } kaesu raw_i(f); }\nkoukai waza call_l_(s: Function) -> int64 { kaku f = gate(s, s_l); moshi (f == cptr(0)) { kaesu 0; } kaesu raw_l(f); }\nkoukai waza call_p_(s: Function) -> cptr { kaku f = gate(s, s_p); moshi (f == cptr(0)) { kaesu cptr(0); } kaesu raw_p(f); }\nkoukai waza call_z_(s: Function) -> uint64 { kaku f = gate(s, s_z); moshi (f == cptr(0)) { kaesu uint64(0); } kaesu raw_z(f); }\nkoukai waza call_i_i(s: Function, a: int32) -> int32 { kaku f = gate(s, s_i_i); moshi (f == cptr(0)) { kaesu int32(0); } kaesu raw_i_i(f, a); }\nkoukai waza call_l_l(s: Function, a: int64) -> int64 { kaku f = gate(s, s_l_l); moshi (f == cptr(0)) { kaesu 0; } kaesu raw_l_l(f, a); }\nkoukai waza call_d_d(s: Function, a: float64) -> float64 { kaku f = gate(s, s_d_d); moshi (f == cptr(0)) { kaesu 0.0; } kaesu raw_d_d(f, a); }\nkoukai waza call_b_i(s: Function, a: int32) -> bool { kaku f = gate(s, s_b_i); moshi (f == cptr(0)) { kaesu iie; } kaesu raw_b_i(f, a); }\nkoukai waza call_i_p(s: Function, handle: cptr) -> int32 { kaku f = gate(s, s_i_p); moshi (f == cptr(0)) { kaesu int32(0); } kaesu raw_i_p(f, handle); }\nkoukai waza call_v_p(s: Function, handle: cptr) -> unit { kaku f = gate(s, s_v_p); moshi (f == cptr(0)) { kaesu; } raw_v_p(f, handle); }\n// (buffer) -> pointer, typically a NUL-terminated name made with cstring\nkoukai waza call_p_n(s: Function, data: []uint8) -> cptr { kaku f = gate(s, s_p_n); moshi (f == cptr(0)) { kaesu cptr(0); } kaesu raw_p_n(f, data); }\nkoukai waza call_i_ii(s: Function, a: int32, b: int32) -> int32 { kaku f = gate(s, s_i_ii); moshi (f == cptr(0)) { kaesu int32(0); } kaesu raw_i_ii(f, a, b); }\nkoukai waza call_l_ll(s: Function, a: int64, b: int64) -> int64 { kaku f = gate(s, s_l_ll); moshi (f == cptr(0)) { kaesu 0; } kaesu raw_l_ll(f, a, b); }\nkoukai waza call_f_ff(s: Function, a: float32, b: float32) -> float32 { kaku f = gate(s, s_f_ff); moshi (f == cptr(0)) { kaesu float32(0.0); } kaesu raw_f_ff(f, a, b); }\nkoukai waza call_d_dd(s: Function, a: float64, b: float64) -> float64 { kaku f = gate(s, s_d_dd); moshi (f == cptr(0)) { kaesu 0.0; } kaesu raw_d_dd(f, a, b); }\n// (buffer, its length) wrappers pass len(data) as the size_t argument.\nkoukai waza call_z_nz(s: Function, data: []uint8) -> uint64 { kaku f = gate(s, s_z_nz); moshi (f == cptr(0)) { kaesu uint64(0); } kaesu raw_z_nz(f, data, uint64(len(data))); }\nkoukai waza call_u_nz(s: Function, data: []uint8) -> uint32 { kaku f = gate(s, s_u_nz); moshi (f == cptr(0)) { kaesu uint32(0); } kaesu raw_u_nz(f, data, uint64(len(data))); }\nkoukai waza call_l_pn(s: Function, handle: cptr, text: []uint8) -> int64 { kaku f = gate(s, s_l_pn); moshi (f == cptr(0)) { kaesu 0; } kaesu raw_l_pn(f, handle, text); }\nkoukai waza call_i_pn(s: Function, handle: cptr, text: []uint8) -> int32 { kaku f = gate(s, s_i_pn); moshi (f == cptr(0)) { kaesu int32(0); } kaesu raw_i_pn(f, handle, text); }\n// (input, its length, output): the output buffer's size is part of the C function's contract\nkoukai waza call_i_nzn(s: Function, data: []uint8, out: []uint8) -> int32 {\n    kaku f = gate(s, s_i_nzn); moshi (f == cptr(0)) { kaesu int32(0); }\n    kaesu raw_i_nzn(f, data, uint64(len(data)), out);\n}\n// (handle, text, output, its length)\nkoukai waza call_l_pnnz(s: Function, handle: cptr, text: []uint8, out: []uint8) -> int64 {\n    kaku f = gate(s, s_l_pnnz); moshi (f == cptr(0)) { kaesu 0; }\n    kaesu raw_l_pnnz(f, handle, text, out, uint64(len(out)));\n}\n// (input, its length, output, its length), for example compress / decompress\nkoukai waza call_l_nznz(s: Function, a: []uint8, b: []uint8) -> int64 {\n    kaku f = gate(s, s_l_nznz); moshi (f == cptr(0)) { kaesu 0; }\n    kaesu raw_l_nznz(f, a, uint64(len(a)), b, uint64(len(b)));\n}\n" }; }
waza data_83() -> File { kaesu File { path: "kiso/ffi/linux/memory.mio", version: "Bunko-v2.1.1", length: 23983, sha256: "2737333b0335e87869b4f3c1263c428cc42e4da18c9682407590b7d1d5f86a57", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// Native memory for kiso/ffi/linux: bounded, generation-checked buffers in C memory.\n//\n// A Buffer is an opaque handle like Library and Function. Resource categories:\n//   owned     alloc / alloc_zeroed / alloc_aligned / c_string_buffer; this package's malloc family allocated it and\n//             only free (or resize) releases it. free makes the buffer and every view of it stale.\n//   view      slice / read_only of a live buffer; borrows its root, never frees it; release drops the handle.\n//   borrowed  unsafe_borrow of foreign memory (for example a pointer a C library returned): the caller asserts\n//             the address and length; free is refused (release the memory with the library's own destructor);\n//             release drops the handle.\n// Every read, write and copy checks the handle, its root and the byte range (no integer overflow: offsets and\n// lengths are checked against the length before any addition) and refuses writes through read-only buffers.\n// Results that are values (read, get_*, c_string) record failures in last_error(); check last_call_ok().\n// Mio arrays never become native buffers: data is copied in and out, so C can never retain a managed object.\n\nteisu max_buffer = 1099511627776; // 1 TiB: far above any real allocation, far below int64 overflow\nteisu max_alignment = 1048576;\n\nkoukai kata Buffer { ticket: Ticket; error: string; }\n\n// root_slot/root_id: the owned or borrowed allocation this buffer lives in (itself for roots).\nkata BufferSlot { id: int64; bits: int64; length: int64; writable: bool; owned: bool; borrowed: bool; root_slot: int64; root_id: int64; }\n\nkaku buffers: []BufferSlot = [];\nkaku free_buffers: []int64 = [];\nkaku live_owned_count: int64 = 0;\n\nwaza dead_slot() -> BufferSlot { kaesu BufferSlot { id: 0, bits: 0, length: 0, writable: iie, owned: iie, borrowed: iie, root_slot: -1, root_id: 0 }; }\nwaza failed_buffer(error: string) -> Buffer { set_call_error(error); kaesu Buffer { ticket: no_ticket(), error: error }; }\n\nwaza new_buffer_slot(bits: int64, length: int64, writable: bool, owned: bool, borrowed: bool, root_slot: int64, root_id: int64) -> Buffer {\n    kaku id = fresh_id();\n    kaku slot = 0;\n    moshi (len(free_buffers) > 0) {\n        slot = free_buffers[len(free_buffers) - 1];\n        array.truncate(free_buffers, len(free_buffers) - 1);\n    } sore {\n        slot = len(buffers);\n        array.push(buffers, dead_slot());\n    }\n    kaku root = root_slot;\n    kaku rid = root_id;\n    moshi (root < 0) { root = slot; rid = id; }\n    buffers[slot] = BufferSlot { id: id, bits: bits, length: length, writable: writable, owned: owned, borrowed: borrowed, root_slot: root, root_id: rid };\n    moshi (owned) { live_owned_count = live_owned_count + 1; }\n    set_call_error(\"\");\n    kaesu Buffer { ticket: Ticket { slot: slot, id: id }, error: \"\" };\n}\n\n// The slot of a live buffer whose root is still live, or -1.\nwaza buffer_slot(buffer: Buffer) -> int64 {\n    kaku slot = buffer.ticket.slot;\n    moshi (buffer.error != \"\" || slot < 0 || slot >= len(buffers)) { kaesu -1; }\n    kaku entry = buffers[slot];\n    moshi (entry.id != buffer.ticket.id || entry.id == 0) { kaesu -1; }\n    moshi (entry.root_slot < 0 || entry.root_slot >= len(buffers) || buffers[entry.root_slot].id != entry.root_id) { kaesu -1; }\n    kaesu slot;\n}\n\nwaza stale_reason(buffer: Buffer) -> string {\n    moshi (buffer.error != \"\") { kaesu \"E_FFI_STATE the buffer was never created\"; }\n    kaesu \"E_FFI_STALE the buffer was freed, resized or released\";\n}\n\nwaza drop_slot(slot: int64) -> unit {\n    moshi (buffers[slot].owned) { live_owned_count = live_owned_count - 1; }\n    buffers[slot] = dead_slot();\n    array.push(free_buffers, slot);\n}\n\n// Range check without overflow: 0 <= offset <= length and 0 <= size <= length - offset.\nwaza in_range(length: int64, offset: int64, size: int64) -> bool {\n    kaesu offset >= 0 && size >= 0 && offset <= length && size <= length - offset;\n}\n\nwaza bounds_error(offset: int64, size: int64, length: int64) -> string {\n    kaku text = string.concat(\"E_FFI_BOUNDS offset \", int_text(offset));\n    text = string.concat(text, string.concat(\" length \", int_text(size)));\n    kaesu string.concat(text, string.concat(\" outside a buffer of \", string.concat(int_text(length), \" bytes\")));\n}\n\nwaza int_text(value: int64) -> string {\n    moshi (value == 0) { kaesu \"0\"; }\n    kaku negative = value < 0;\n    kaku x = value;\n    kaku digits: []uint8 = [];\n    aida (x != 0) {\n        kaku d = x - (x / 10) * 10;\n        moshi (d < 0) { d = -d; }\n        array.push(digits, uint8(48 + d));\n        x = x / 10;\n    }\n    kaku out: []uint8 = [];\n    moshi (negative) { array.push(out, uint8(45)); }\n    kaku at = len(digits) - 1;\n    aida (at >= 0) { array.push(out, digits[at]); at = at - 1; }\n    kaku text = string.from_utf8(out);\n    moshi (text == mu) { kaesu \"?\"; }\n    kaesu text;\n}\n\n// A checked access: the slot, or -1 with last_error() set.\nwaza access(buffer: Buffer, offset: int64, size: int64, write: bool) -> int64 {\n    kaku slot = buffer_slot(buffer);\n    moshi (slot < 0) { set_call_error(stale_reason(buffer)); kaesu -1; }\n    kaku entry = buffers[slot];\n    moshi (!in_range(entry.length, offset, size)) { set_call_error(bounds_error(offset, size, entry.length)); kaesu -1; }\n    moshi (write && !entry.writable) { set_call_error(\"E_FFI_READONLY the buffer is read-only\"); kaesu -1; }\n    set_call_error(\"\");\n    kaesu slot;\n}\n\nwaza at_offset(slot: int64, offset: int64) -> cptr { kaesu pointer_at(buffers[slot].bits + offset); }\n\n// ---------------------------------------------------------------------------------------------------\n// Allocation\n\nwaza allocated(pointer: cptr, size: int64) -> Buffer {\n    moshi (pointer == cptr(0)) { kaesu failed_buffer(string.concat(\"E_FFI_NOMEM cannot allocate \", string.concat(int_text(size), \" bytes\"))); }\n    kaesu new_buffer_slot(address_bits(pointer), size, hai, hai, iie, -1, 0);\n}\n\nwaza size_error(size: int64) -> string {\n    moshi (size < 0 || size > max_buffer) { kaesu string.concat(\"E_FFI_SIZE invalid buffer size \", int_text(size)); }\n    moshi (!native_ready()) { kaesu \"E_FFI_STATE the libc memory functions are unavailable\"; }\n    kaesu \"\";\n}\n\n// alloc returns an owned, writable buffer of size bytes (contents unspecified). A zero size is valid.\nkoukai waza alloc(size: int64) -> Buffer {\n    kaku problem = size_error(size);\n    moshi (problem != \"\") { kaesu failed_buffer(problem); }\n    kaku request = size;\n    moshi (request == 0) { request = 1; }\n    kaesu allocated(native_malloc(request), size);\n}\n\n// alloc_zeroed returns an owned buffer whose bytes are all zero.\nkoukai waza alloc_zeroed(size: int64) -> Buffer {\n    kaku problem = size_error(size);\n    moshi (problem != \"\") { kaesu failed_buffer(problem); }\n    kaku request = size;\n    moshi (request == 0) { request = 1; }\n    kaesu allocated(native_calloc(request), size);\n}\n\n// alloc_aligned returns an owned buffer whose address is a multiple of alignment (a power of two, 8 to 1 MiB).\nkoukai waza alloc_aligned(size: int64, alignment: int64) -> Buffer {\n    kaku problem = size_error(size);\n    moshi (problem != \"\") { kaesu failed_buffer(problem); }\n    kaku power = 8;\n    aida (power < alignment && power < max_alignment) { power = power * 2; }\n    moshi (alignment < 8 || alignment > max_alignment || power != alignment) {\n        kaesu failed_buffer(string.concat(\"E_FFI_ALIGNMENT invalid alignment \", int_text(alignment)));\n    }\n    kaku request = size;\n    moshi (request == 0) { request = 1; }\n    kaesu allocated(native_aligned(alignment, request), size);\n}\n\n// free releases an owned buffer and invalidates every view of it. Freeing twice, freeing a view or freeing borrowed\n// memory is an error and does nothing.\nkoukai waza free(buffer: Buffer) -> string {\n    kaku slot = buffer_slot(buffer);\n    moshi (slot < 0) { kaku reason = stale_reason(buffer); set_call_error(reason); kaesu reason; }\n    kaku entry = buffers[slot];\n    moshi (entry.borrowed) { set_call_error(\"E_FFI_BORROWED borrowed memory is released by its owner; use release\"); kaesu \"E_FFI_BORROWED borrowed memory is released by its owner; use release\"; }\n    moshi (!entry.owned) { set_call_error(\"E_FFI_NOT_OWNER a view cannot be freed; free its owner or release the view\"); kaesu \"E_FFI_NOT_OWNER a view cannot be freed; free its owner or release the view\"; }\n    native_free(pointer_at(entry.bits));\n    drop_slot(slot);\n    set_call_error(\"\");\n    kaesu \"\";\n}\n\n// resize changes the size of an owned buffer (realloc). On success the old handle and its views are stale and the\n// returned buffer replaces them; on failure the old buffer is unchanged and the result has an error.\nkoukai waza resize(buffer: Buffer, size: int64) -> Buffer {\n    kaku slot = buffer_slot(buffer);\n    moshi (slot < 0) { kaesu failed_buffer(stale_reason(buffer)); }\n    kaku entry = buffers[slot];\n    moshi (!entry.owned) { kaesu failed_buffer(\"E_FFI_NOT_OWNER only an owned buffer can be resized\"); }\n    kaku problem = size_error(size);\n    moshi (problem != \"\") { kaesu failed_buffer(problem); }\n    kaku request = size;\n    moshi (request == 0) { request = 1; }\n    kaku moved = native_realloc(pointer_at(entry.bits), request);\n    moshi (moved == cptr(0)) { kaesu failed_buffer(string.concat(\"E_FFI_NOMEM cannot resize to \", string.concat(int_text(size), \" bytes\"))); }\n    drop_slot(slot);\n    kaesu new_buffer_slot(address_bits(moved), size, hai, hai, iie, -1, 0);\n}\n\n// UNSAFE. unsafe_borrow wraps foreign memory the caller asserts is valid for length bytes for as long as the handle\n// is used (for example a buffer a C library returned and still owns). It is never freed by this package.\nkoukai waza unsafe_borrow(pointer: cptr, length: int64, writable: bool) -> Buffer {\n    moshi (!native_ready()) { kaesu failed_buffer(\"E_FFI_STATE the libc memory functions are unavailable\"); }\n    moshi (pointer == cptr(0)) { kaesu failed_buffer(\"E_FFI_NULL cannot borrow a null pointer\"); }\n    moshi (length < 0 || length > max_buffer) { kaesu failed_buffer(string.concat(\"E_FFI_SIZE invalid buffer size \", int_text(length))); }\n    kaesu new_buffer_slot(address_bits(pointer), length, writable, iie, hai, -1, 0);\n}\n\n// slice returns a view of length bytes at offset; it has the writability of buffer and dies with its root.\nkoukai waza slice(buffer: Buffer, offset: int64, length: int64) -> Buffer {\n    kaku slot = access(buffer, offset, length, iie);\n    moshi (slot < 0) { kaesu failed_buffer(last_error()); }\n    kaku entry = buffers[slot];\n    kaesu new_buffer_slot(entry.bits + offset, length, entry.writable, iie, iie, entry.root_slot, entry.root_id);\n}\n\n// read_only returns a view of the whole buffer that refuses every write.\nkoukai waza read_only(buffer: Buffer) -> Buffer {\n    kaku slot = access(buffer, 0, 0, iie);\n    moshi (slot < 0) { kaesu failed_buffer(last_error()); }\n    kaku entry = buffers[slot];\n    kaesu new_buffer_slot(entry.bits, entry.length, iie, iie, iie, entry.root_slot, entry.root_id);\n}\n\n// release drops a view or a borrowed buffer. An owned buffer must be freed instead.\nkoukai waza release_buffer(buffer: Buffer) -> string {\n    kaku slot = buffer_slot(buffer);\n    moshi (slot < 0) { kaku reason = stale_reason(buffer); set_call_error(reason); kaesu reason; }\n    moshi (buffers[slot].owned) { set_call_error(\"E_FFI_OWNER an owned buffer is released with free\"); kaesu \"E_FFI_OWNER an owned buffer is released with free\"; }\n    // a borrowed root takes its views with it\n    drop_slot(slot);\n    set_call_error(\"\");\n    kaesu \"\";\n}\n\nkoukai waza buffer_error(buffer: Buffer) -> string { kaesu buffer.error; }\nkoukai waza buffer_live(buffer: Buffer) -> bool { kaesu buffer_slot(buffer) >= 0; }\nkoukai waza buffer_length(buffer: Buffer) -> int64 {\n    kaku slot = buffer_slot(buffer);\n    moshi (slot < 0) { kaesu -1; }\n    kaesu buffers[slot].length;\n}\nkoukai waza buffer_writable(buffer: Buffer) -> bool { kaku slot = buffer_slot(buffer); kaesu slot >= 0 && buffers[slot].writable; }\nkoukai waza buffer_owned(buffer: Buffer) -> bool { kaku slot = buffer_slot(buffer); kaesu slot >= 0 && buffers[slot].owned; }\nkoukai waza buffers_owned() -> int64 { kaesu live_owned_count; }\n\n// pointer is the address to pass to C for a `p` parameter; cptr(0) (with last_error) when the buffer is not live.\n// The address is borrowed: it is valid until the buffer is freed or resized, and C must not keep it longer.\nkoukai waza pointer(buffer: Buffer) -> cptr {\n    kaku slot = access(buffer, 0, 0, iie);\n    moshi (slot < 0) { kaesu cptr(0); }\n    kaesu pointer_at(buffers[slot].bits);\n}\n\n// ---------------------------------------------------------------------------------------------------\n// Bytes\n\n// read copies length bytes at offset into a new Mio array; [] with last_error set when refused.\nkoukai waza read(buffer: Buffer, offset: int64, length: int64) -> []uint8 {\n    kaku slot = access(buffer, offset, length, iie);\n    moshi (slot < 0) { kaesu []; }\n    kaesu read_native(at_offset(slot, offset), length);\n}\n\n// write copies all of data into the buffer at offset.\nkoukai waza write(buffer: Buffer, offset: int64, data: []uint8) -> string {\n    kaku slot = access(buffer, offset, len(data), hai);\n    moshi (slot < 0) { kaesu last_error(); }\n    native_write(at_offset(slot, offset), data, len(data));\n    kaesu \"\";\n}\n\n// fill sets length bytes at offset to value.\nkoukai waza fill(buffer: Buffer, offset: int64, length: int64, value: uint8) -> string {\n    kaku slot = access(buffer, offset, length, hai);\n    moshi (slot < 0) { kaesu last_error(); }\n    native_fill(at_offset(slot, offset), int64(value), length);\n    kaesu \"\";\n}\n\n// copy moves length bytes between (possibly overlapping) buffers.\nkoukai waza copy(destination: Buffer, destination_offset: int64, source: Buffer, source_offset: int64, length: int64) -> string {\n    kaku from = access(source, source_offset, length, iie);\n    moshi (from < 0) { kaesu last_error(); }\n    kaku to = access(destination, destination_offset, length, hai);\n    moshi (to < 0) { kaesu last_error(); }\n    native_move(at_offset(to, destination_offset), at_offset(from, source_offset), length);\n    kaesu \"\";\n}\n\n// ---------------------------------------------------------------------------------------------------\n// Scalars (little endian, any alignment)\n\nwaza unsigned_at(buffer: Buffer, offset: int64, width: int64) -> int64 {\n    kaku bytes = read(buffer, offset, width);\n    moshi (len(bytes) != width) { kaesu 0; }\n    kaesu word_le(bytes, 0, width);\n}\n\nwaza signed(value: int64, width: int64) -> int64 {\n    moshi (width == 8) { kaesu value; }\n    kaku limit = 1;\n    kaku i = 0;\n    aida (i < width) { limit = limit * 256; i = i + 1; }\n    moshi (value >= limit / 2) { kaesu value - limit; }\n    kaesu value;\n}\n\n// Little-endian bytes of a two's-complement value of width bytes (width 8 handles negative int64).\nwaza le_bytes(value: int64, width: int64) -> []uint8 {\n    kaku out: []uint8 = [];\n    kaku x = value;\n    kaku negative = x < 0;\n    moshi (negative) { x = -(x + 1); }\n    kaku i = 0;\n    aida (i < width) {\n        kaku b = x - (x / 256) * 256;\n        moshi (negative) { b = 255 - b; }\n        array.push(out, uint8(b));\n        x = x / 256;\n        i = i + 1;\n    }\n    kaesu out;\n}\n\nwaza store(buffer: Buffer, offset: int64, value: int64, width: int64) -> string { kaesu write(buffer, offset, le_bytes(value, width)); }\n\nkoukai waza get_uint8(buffer: Buffer, offset: int64) -> uint8 { kaesu uint8(unsigned_at(buffer, offset, 1)); }\nkoukai waza get_int8(buffer: Buffer, offset: int64) -> int8 { kaesu int8(signed(unsigned_at(buffer, offset, 1), 1)); }\nkoukai waza get_uint16(buffer: Buffer, offset: int64) -> uint16 { kaesu uint16(unsigned_at(buffer, offset, 2)); }\nkoukai waza get_int16(buffer: Buffer, offset: int64) -> int16 { kaesu int16(signed(unsigned_at(buffer, offset, 2), 2)); }\nkoukai waza get_uint32(buffer: Buffer, offset: int64) -> uint32 { kaesu uint32(unsigned_at(buffer, offset, 4)); }\nkoukai waza get_int32(buffer: Buffer, offset: int64) -> int32 { kaesu int32(signed(unsigned_at(buffer, offset, 4), 4)); }\nkoukai waza get_int64(buffer: Buffer, offset: int64) -> int64 { kaesu signed_word8(read(buffer, offset, 8)); }\nkoukai waza get_uint64(buffer: Buffer, offset: int64) -> uint64 { kaesu uint64(signed_word8(read(buffer, offset, 8))); }\nkoukai waza get_pointer(buffer: Buffer, offset: int64) -> cptr {\n    kaku bits = signed_word8(read(buffer, offset, 8));\n    moshi (!last_call_ok() || bits == 0) { kaesu cptr(0); }\n    kaesu pointer_at(bits);\n}\n\n// Two's-complement int64 from 8 little-endian bytes (0 for a refused read).\nwaza signed_word8(bytes: []uint8) -> int64 {\n    moshi (len(bytes) != 8) { kaesu 0; }\n    moshi (int64(bytes[7]) < 128) { kaesu word_le(bytes, 0, 8); }\n    // negative: -(~x + 1) computed bytewise without overflow\n    kaku value = 0;\n    kaku scale = 1;\n    kaku i = 0;\n    aida (i < 8) {\n        value = value + (255 - int64(bytes[i])) * scale;\n        moshi (i < 7) { scale = scale * 256; }\n        i = i + 1;\n    }\n    kaesu -value - 1;\n}\n\nkoukai waza set_uint8(buffer: Buffer, offset: int64, value: uint8) -> string { kaesu store(buffer, offset, int64(value), 1); }\nkoukai waza set_int8(buffer: Buffer, offset: int64, value: int8) -> string { kaesu store(buffer, offset, int64(value), 1); }\nkoukai waza set_uint16(buffer: Buffer, offset: int64, value: uint16) -> string { kaesu store(buffer, offset, int64(value), 2); }\nkoukai waza set_int16(buffer: Buffer, offset: int64, value: int16) -> string { kaesu store(buffer, offset, int64(value), 2); }\nkoukai waza set_uint32(buffer: Buffer, offset: int64, value: uint32) -> string { kaesu store(buffer, offset, int64(value), 4); }\nkoukai waza set_int32(buffer: Buffer, offset: int64, value: int32) -> string { kaesu store(buffer, offset, int64(value), 4); }\nkoukai waza set_int64(buffer: Buffer, offset: int64, value: int64) -> string { kaesu store(buffer, offset, value, 8); }\nkoukai waza set_uint64(buffer: Buffer, offset: int64, value: uint64) -> string { kaesu store(buffer, offset, int64(value), 8); }\nkoukai waza set_pointer(buffer: Buffer, offset: int64, value: cptr) -> string {\n    moshi (!native_ready()) { kaesu \"E_FFI_STATE the libc memory functions are unavailable\"; }\n    kaesu store(buffer, offset, address_bits(value), 8);\n}\n\n// IEEE 754 binary64 / binary32 from and to their bit patterns, exactly (subnormals, signed zero, infinities, NaN).\nwaza power2(exponent: int64) -> float64 {\n    kaku value = 1.0;\n    kaku e = exponent;\n    aida (e > 0) { value = value * 2.0; e = e - 1; }\n    aida (e < 0) { value = value / 2.0; e = e + 1; }\n    kaesu value;\n}\n\nwaza decode_float(bytes: []uint8, width: int64) -> float64 {\n    moshi (len(bytes) != width) { kaesu 0.0; }\n    kaku top = int64(bytes[width - 1]);\n    kaku negative = top >= 128;\n    kaku exponent_bits = 11;\n    kaku fraction_bits = 52;\n    moshi (width == 4) { exponent_bits = 8; fraction_bits = 23; }\n    // magnitude bits without the sign\n    kaku magnitude = word_le(bytes, 0, width - 1) + (top - (top / 128) * 128) * power_int(256, width - 1);\n    kaku fraction_scale = power_int(2, fraction_bits);\n    kaku exponent = magnitude / fraction_scale;\n    kaku fraction = magnitude - exponent * fraction_scale;\n    kaku max_exponent = power_int(2, exponent_bits) - 1;\n    kaku bias = max_exponent / 2;\n    kaku zero = 0.0;\n    kaku value = 0.0;\n    moshi (exponent == max_exponent) {\n        moshi (fraction == 0) { value = 1.0 / zero; } sore { value = zero / zero; }\n    } sore {\n        moshi (exponent == 0) { value = float64(fraction) * power2(1 - bias - fraction_bits); }\n        sore { value = float64(fraction + fraction_scale) * power2(exponent - bias - fraction_bits); }\n    }\n    moshi (negative) { kaesu -value; }\n    kaesu value;\n}\n\nwaza power_int(base: int64, exponent: int64) -> int64 {\n    kaku value = 1;\n    kaku i = 0;\n    aida (i < exponent) { value = value * base; i = i + 1; }\n    kaesu value;\n}\n\n// Bit pattern of value as width bytes (4: value must already be exactly representable as binary32).\nwaza encode_float(value: float64, width: int64) -> []uint8 {\n    kaku exponent_bits = 11;\n    kaku fraction_bits = 52;\n    moshi (width == 4) { exponent_bits = 8; fraction_bits = 23; }\n    kaku max_exponent = power_int(2, exponent_bits) - 1;\n    kaku bias = max_exponent / 2;\n    kaku fraction_scale = power_int(2, fraction_bits);\n    kaku negative = value < 0.0 || (value == 0.0 && 1.0 / value < 0.0);\n    kaku magnitude = value;\n    moshi (negative) { magnitude = -value; }\n    kaku exponent = 0;\n    kaku fraction = 0;\n    moshi (value != value) {\n        exponent = max_exponent; fraction = fraction_scale / 2; negative = iie;\n    } sore {\n        moshi (magnitude - magnitude != 0.0) { exponent = max_exponent; } sore {\n            moshi (magnitude != 0.0) {\n                kaku e = 0;\n                kaku m = magnitude;\n                aida (m >= 2.0) { m = m / 2.0; e = e + 1; }\n                aida (m < 1.0) { m = m * 2.0; e = e - 1; }\n                moshi (e + bias >= max_exponent) { exponent = max_exponent; } sore {\n                    moshi (e + bias <= 0) {\n                        // subnormal: fraction = magnitude / 2^(1 - bias - fraction_bits)\n                        fraction = int64(magnitude / power2(1 - bias - fraction_bits));\n                    } sore {\n                        exponent = e + bias;\n                        fraction = int64((m - 1.0) * float64(fraction_scale));\n                    }\n                }\n            }\n        }\n    }\n    kaku bits = exponent * fraction_scale + fraction;\n    moshi (width == 8 && negative) {\n        // sign bit 63: build the bytes directly to stay inside int64\n        kaku out = le_bytes(bits, 8);\n        out[7] = uint8(int64(out[7]) + 128);\n        kaesu out;\n    }\n    moshi (negative) { bits = bits + power_int(2, 31); }\n    kaesu le_bytes(bits, width);\n}\n\nkoukai waza get_float64(buffer: Buffer, offset: int64) -> float64 { kaesu decode_float(read(buffer, offset, 8), 8); }\nkoukai waza get_float32(buffer: Buffer, offset: int64) -> float32 { kaesu float32(decode_float(read(buffer, offset, 4), 4)); }\nkoukai waza set_float64(buffer: Buffer, offset: int64, value: float64) -> string { kaesu write(buffer, offset, encode_float(value, 8)); }\nkoukai waza set_float32(buffer: Buffer, offset: int64, value: float32) -> string { kaesu write(buffer, offset, encode_float(float64(value), 4)); }\n\n// ---------------------------------------------------------------------------------------------------\n// C strings\n\n// c_string_buffer returns an owned buffer holding the UTF-8 bytes of text and a terminating NUL. Text containing NUL\n// is refused (it could not be read back as the same C string).\nkoukai waza c_string_buffer(text: string) -> Buffer {\n    kaku bytes = string.to_bytes(text);\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        moshi (bytes[at] == uint8(0)) { kaesu failed_buffer(\"E_FFI_NUL the text contains a NUL byte\"); }\n        at = at + 1;\n    }\n    kaku buffer = alloc(len(bytes) + 1);\n    moshi (buffer.error != \"\") { kaesu buffer; }\n    array.push(bytes, uint8(0));\n    write(buffer, 0, bytes);\n    kaesu buffer;\n}\n\n// c_string reads the NUL-terminated UTF-8 string starting at offset. The NUL must lie inside the buffer; mu (with\n// last_error) when there is none or the bytes are not UTF-8.\nkoukai waza c_string(buffer: Buffer, offset: int64) -> string? {\n    kaku slot = access(buffer, offset, 0, iie);\n    moshi (slot < 0) { kaesu mu; }\n    kaku available = buffers[slot].length - offset;\n    kaku size = native_strnlen(at_offset(slot, offset), available);\n    moshi (size >= available) { set_call_error(\"E_FFI_BOUNDS no NUL terminator inside the buffer\"); kaesu mu; }\n    kaku text = string.from_utf8(read_native(at_offset(slot, offset), size));\n    moshi (text == mu) { set_call_error(\"E_FFI_UTF8 the C string is not valid UTF-8\"); kaesu mu; }\n    kaesu text;\n}\n" }; }
waza data_84() -> File { kaesu File { path: "kiso/ffi/linux/native.mio", version: "Bunko-v2.1.1", length: 10428, sha256: "d2955264af1c5b30da41572145879628094b1f0fc47688fafa177e1eb7fbf284", source: "yobu \"kiso/array\";\nyobu \"kiso/fs\";\nyobu \"kiso/string\";\n\n// Package-internal native helpers of kiso/ffi/linux.\n//\n// The libc functions used for raw memory access (memset, memcpy, strnlen, dladdr, dladdr1) are resolved once through\n// dlsym(RTLD_DEFAULT) and called through the System V indirect bridge. A C symbol can have only one prototype per\n// program, so declaring them with `= c \"memcpy\"` here would make every user program that declares memcpy with another\n// prototype fail to build; the indirect bridge has no such conflict. Only the dl* entry points are direct declarations.\n//\n// Pointer bits: memset(p, 0, 0) returns p and touches no memory, so calling it with a cptr argument and an int64 result\n// (or the reverse) converts between a pointer and its address bits exactly. User-space x86-64 addresses are below\n// 2^47, so the bits are a non-negative int64. These conversions never leave this package.\n\nwaza n_bits(f: cptr, p: cptr, c: int32, n: uint64) -> int64 = c \"mio_ffi_indirect\";\nwaza n_pointer(f: cptr, p: int64, c: int32, n: uint64) -> cptr = c \"mio_ffi_indirect\";\nwaza n_copy_out(f: cptr, destination: []uint8, source: cptr, size: uint64) -> cptr = c \"mio_ffi_indirect\";\nwaza n_strnlen(f: cptr, text: cptr, limit: uint64) -> uint64 = c \"mio_ffi_indirect\";\nwaza n_dladdr(f: cptr, address: cptr, info: []uint8) -> int32 = c \"mio_ffi_indirect\";\nwaza n_dladdr1(f: cptr, address: cptr, info: []uint8, extra: []uint8, flags: int32) -> int32 = c \"mio_ffi_indirect\";\nwaza n_copy_in(f: cptr, destination: cptr, source: []uint8, size: uint64) -> cptr = c \"mio_ffi_indirect\";\nwaza n_move(f: cptr, destination: cptr, source: cptr, size: uint64) -> cptr = c \"mio_ffi_indirect\";\nwaza n_fill(f: cptr, destination: cptr, value: int32, size: uint64) -> cptr = c \"mio_ffi_indirect\";\nwaza n_malloc(f: cptr, size: uint64) -> cptr = c \"mio_ffi_indirect\";\nwaza n_calloc(f: cptr, count: uint64, size: uint64) -> cptr = c \"mio_ffi_indirect\";\nwaza n_realloc(f: cptr, pointer: cptr, size: uint64) -> cptr = c \"mio_ffi_indirect\";\nwaza n_free(f: cptr, pointer: cptr) -> unit = c \"mio_ffi_indirect\";\nwaza n_memalign(f: cptr, out: []uint8, alignment: uint64, size: uint64) -> int32 = c \"mio_ffi_indirect\";\n\nkaku native_state: int64 = 0;   // 0 not resolved, 1 ready, -1 unavailable\nkaku p_memset: cptr = cptr(0);\nkaku p_memcpy: cptr = cptr(0);\nkaku p_strnlen: cptr = cptr(0);\nkaku p_dladdr: cptr = cptr(0);\nkaku p_dladdr1: cptr = cptr(0);\nkaku p_memmove: cptr = cptr(0);\nkaku p_malloc: cptr = cptr(0);\nkaku p_calloc: cptr = cptr(0);\nkaku p_realloc: cptr = cptr(0);\nkaku p_free: cptr = cptr(0);\nkaku p_memalign: cptr = cptr(0);\n\nkata MapRange { start: int64; end: int64; readable: bool; executable: bool; }\nkaku map_ranges: []MapRange = [];\nkaku maps_valid: bool = iie;\n\nwaza default_symbol(name: string) -> cptr {\n    c_dlerror();\n    kaesu c_dlsym(cptr(0), cstring(name));\n}\n\nwaza native_ready() -> bool {\n    moshi (native_state == 0) {\n        p_memset = default_symbol(\"memset\");\n        p_memcpy = default_symbol(\"memcpy\");\n        p_strnlen = default_symbol(\"strnlen\");\n        p_dladdr = default_symbol(\"dladdr\");\n        // dladdr1 is a glibc extension; without it the ELF symbol-type check is skipped (see code_check).\n        p_dladdr1 = default_symbol(\"dladdr1\");\n        p_memmove = default_symbol(\"memmove\");\n        p_malloc = default_symbol(\"malloc\");\n        p_calloc = default_symbol(\"calloc\");\n        p_realloc = default_symbol(\"realloc\");\n        p_free = default_symbol(\"free\");\n        p_memalign = default_symbol(\"posix_memalign\");\n        native_state = -1;\n        moshi (p_memset != cptr(0) && p_memcpy != cptr(0) && p_strnlen != cptr(0) && p_dladdr != cptr(0) && p_memmove != cptr(0) &&\n            p_malloc != cptr(0) && p_calloc != cptr(0) && p_realloc != cptr(0) && p_free != cptr(0) && p_memalign != cptr(0)) { native_state = 1; }\n    }\n    kaesu native_state == 1;\n}\n\n// Whether native_ready already succeeded (no dl call is made).\nwaza native_resolved() -> bool { kaesu native_state == 1; }\n\nwaza address_bits(pointer: cptr) -> int64 { kaesu n_bits(p_memset, pointer, int32(0), uint64(0)); }\nwaza pointer_at(bits: int64) -> cptr { kaesu n_pointer(p_memset, bits, int32(0), uint64(0)); }\n\n// Copies size bytes at pointer into a fresh array. The caller guarantees the range is readable.\nwaza read_native(pointer: cptr, size: int64) -> []uint8 {\n    kaku copy: []uint8 = array.make[uint8](size, uint8(0));\n    moshi (size > 0) { n_copy_out(p_memcpy, copy, pointer, uint64(size)); }\n    kaesu copy;\n}\n\n// Raw memory primitives for memory.mio. Callers validate every range first.\nwaza native_write(pointer: cptr, data: []uint8, size: int64) -> unit { moshi (size > 0) { n_copy_in(p_memcpy, pointer, data, uint64(size)); } }\nwaza native_move(destination: cptr, source: cptr, size: int64) -> unit { moshi (size > 0) { n_move(p_memmove, destination, source, uint64(size)); } }\nwaza native_fill(destination: cptr, value: int64, size: int64) -> unit { moshi (size > 0) { n_fill(p_memset, destination, int32(value), uint64(size)); } }\nwaza native_malloc(size: int64) -> cptr { kaesu n_malloc(p_malloc, uint64(size)); }\nwaza native_calloc(size: int64) -> cptr { kaesu n_calloc(p_calloc, uint64(1), uint64(size)); }\nwaza native_realloc(pointer: cptr, size: int64) -> cptr { kaesu n_realloc(p_realloc, pointer, uint64(size)); }\nwaza native_free(pointer: cptr) -> unit { n_free(p_free, pointer); }\nwaza native_aligned(alignment: int64, size: int64) -> cptr {\n    kaku out: []uint8 = array.make[uint8](8, uint8(0));\n    moshi (n_memalign(p_memalign, out, uint64(alignment), uint64(size)) != int32(0)) { kaesu cptr(0); }\n    kaesu pointer_at(word_le(out, 0, 8));\n}\n\nwaza native_strnlen(text: cptr, limit: int64) -> int64 { kaesu int64(n_strnlen(p_strnlen, text, uint64(limit))); }\n\nwaza word_le(bytes: []uint8, at: int64, width: int64) -> int64 {\n    kaku value = 0;\n    kaku scale = 1;\n    kaku i = 0;\n    aida (i < width) { value = value + int64(bytes[at + i]) * scale; scale = scale * 256; i = i + 1; }\n    kaesu value;\n}\n\n// ---------------------------------------------------------------------------------------------------\n// /proc/self/maps\n\nwaza hex_digit(byte: int64) -> int64 {\n    moshi (byte >= 48 && byte <= 57) { kaesu byte - 48; }\n    moshi (byte >= 97 && byte <= 102) { kaesu byte - 87; }\n    kaesu -1;\n}\n\nwaza load_maps() -> bool {\n    kaku read = fs.read_all(\"/proc/self/maps\");\n    moshi (read.error != mu) { kaesu iie; }\n    kaku data = read.data;\n    kaku ranges: []MapRange = [];\n    kaku at = 0;\n    aida (at < len(data)) {\n        kaku start = 0;\n        kaku digits = 0;\n        aida (at < len(data) && hex_digit(int64(data[at])) >= 0) { start = start * 16 + hex_digit(int64(data[at])); at = at + 1; digits = digits + 1; }\n        kaku valid = digits > 0 && digits <= 12 && at < len(data) && data[at] == uint8(45);\n        kaku end = 0;\n        moshi (valid) {\n            at = at + 1;\n            digits = 0;\n            aida (at < len(data) && hex_digit(int64(data[at])) >= 0) { end = end * 16 + hex_digit(int64(data[at])); at = at + 1; digits = digits + 1; }\n            valid = digits > 0 && digits <= 12 && at + 4 < len(data) && data[at] == uint8(32);\n        }\n        moshi (valid) {\n            // perms: r w x p|s; the third letter is x for executable mappings\n            array.push(ranges, MapRange { start: start, end: end, readable: data[at + 1] == uint8(114), executable: data[at + 3] == uint8(120) });\n        }\n        aida (at < len(data) && data[at] != uint8(10)) { at = at + 1; }\n        at = at + 1;\n    }\n    map_ranges = ranges;\n    maps_valid = hai;\n    kaesu len(ranges) > 0;\n}\n\n// 1 when bits lies in an executable mapping, 0 in a non-executable one, -1 when unmapped or unknown.\nwaza mapping_kind(bits: int64) -> int64 { kaesu mapping(bits, iie); }\n\n// Whether [bits, bits + size) lies inside one readable mapping.\nwaza readable_range(bits: int64, size: int64) -> bool { kaesu mapping(bits, hai) == 1 && mapping(bits + size - 1, hai) == 1; }\n\nwaza mapping(bits: int64, need_read: bool) -> int64 {\n    kaku attempt = 0;\n    aida (attempt < 2) {\n        moshi (!maps_valid || attempt == 1) {\n            moshi (!load_maps()) { kaesu -1; }\n        }\n        kaku at = 0;\n        aida (at < len(map_ranges)) {\n            kaku range = map_ranges[at];\n            moshi (bits >= range.start && bits < range.end) {\n                moshi (need_read) { moshi (range.readable) { kaesu 1; } kaesu 0; }\n                moshi (range.executable) { kaesu 1; }\n                kaesu 0;\n            }\n            at = at + 1;\n        }\n        attempt = attempt + 1;\n    }\n    kaesu -1;\n}\n\nwaza invalidate_maps() -> unit { maps_valid = iie; }\n\n// The executable-code check in front of every resolved function. It rejects addresses outside an executable mapping\n// and, where dladdr1 is available, exported ELF symbols whose type is a data type (STT_OBJECT, STT_COMMON, STT_TLS).\n// It does not prove that the declared prototype is right.\nwaza code_check(address: cptr, name: string) -> string {\n    moshi (!native_ready()) { kaesu \"E_FFI_STATE the libc helpers memset, memcpy, strnlen and dladdr are unavailable\"; }\n    kaku bits = address_bits(address);\n    kaku kind = mapping_kind(bits);\n    moshi (kind < 0) { kaesu string.concat(\"E_FFI_NOT_FUNCTION the address of \", string.concat(name, \" is not in a mapped image\")); }\n    moshi (kind == 0) { kaesu string.concat(\"E_FFI_NOT_FUNCTION \", string.concat(name, \" is not in an executable mapping (a data symbol?)\")); }\n    moshi (p_dladdr1 != cptr(0)) {\n        kaku info: []uint8 = array.make[uint8](32, uint8(0));\n        kaku extra: []uint8 = array.make[uint8](8, uint8(0));\n        // RTLD_DL_SYMENT = 1: extra receives the ElfW(Sym) * of the symbol dladdr matched\n        moshi (n_dladdr1(p_dladdr1, address, info, extra, int32(1)) != int32(0)) {\n            kaku symbol_address = word_le(info, 24, 8);\n            kaku entry = word_le(extra, 0, 8);\n            moshi (symbol_address == bits && entry > 0 && readable_range(entry, 24)) {\n                kaku sym = read_native(pointer_at(entry), 24);\n                kaku kind_code = int64(sym[4]) - (int64(sym[4]) / 16) * 16;\n                moshi (kind_code == 1 || kind_code == 5 || kind_code == 6) {\n                    kaesu string.concat(\"E_FFI_NOT_FUNCTION \", string.concat(name, \" is an ELF data symbol\"));\n                }\n            }\n        }\n    }\n    kaesu \"\";\n}\n" }; }
waza data_85() -> File { kaesu File { path: "kiso/fs/fs.mio", version: "Bunko-v2.1.1", length: 11142, sha256: "fca192cce4701f7d6a6ca16714b85f7a7827dd47ce0a90be266ab885cd5564e0", source: "yobu \"kiso/array\";\nyobu \"kiso/io\";\nyobu \"mio/fs/runtime\";\n\nkoukai sentaku FsError {\n    NotFound(string);\n    PermissionDenied(string);\n    Closed(string);\n    InvalidArgument(string);\n    NoSpace(string);\n    InvalidPath(string);\n    IOFailure(string);\n}\n\nkoukai kata File { handle: resource; }\nkoukai kata FileResult {\n    file: File?;\n    error: FsError?;\n}\nkoukai kata ReadAllResult {\n    data: []uint8;\n    error: FsError?;\n}\nkoukai kata UnitResult { error: FsError?; }\nkoukai kata StatResult {\n    exists: bool;\n    is_file: bool;\n    is_dir: bool;\n    error: FsError?;\n}\nkoukai kata DirEntry {\n    name: string;\n    is_file: bool;\n    is_dir: bool;\n}\nkoukai kata DirResult {\n    entries: []DirEntry;\n    error: FsError?;\n}\n\nwaza error_from(code: uint8, message: string) -> FsError? {\n    moshi (code == uint8(0)) { kaesu mu; }\n    moshi (code == uint8(1)) { kaesu FsError.NotFound(message); }\n    moshi (code == uint8(2)) { kaesu FsError.PermissionDenied(message); }\n    moshi (code == uint8(3)) { kaesu FsError.Closed(message); }\n    moshi (code == uint8(4)) { kaesu FsError.InvalidArgument(message); }\n    moshi (code == uint8(6)) { kaesu FsError.NoSpace(message); }\n    moshi (code == uint8(7)) { kaesu FsError.InvalidPath(message); }\n    kaesu FsError.IOFailure(message);\n}\n\nwaza decode_count(status: []uint8) -> int64 {\n    kaku result = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 8) {\n        result = result + int64(status[index]) * factor;\n        factor = factor * 256;\n        index = index + 1;\n    }\n    kaesu result;\n}\n\nwaza open_mode(path: string, mode: int64) -> FileResult {\n    kaku handle = runtime.open(path, mode);\n    kaku status: []uint8 = [0];\n    kaku message = runtime.file_status(handle, status);\n    kaku open_error = error_from(status[0], message);\n    moshi (open_error != mu) {\n        kaku close_status: []uint8 = [0];\n        runtime.close(handle, close_status);\n        kaesu FileResult { file: mu, error: open_error };\n    }\n    kaesu FileResult { file: File { handle: handle }, error: mu };\n}\n\nkoukai waza open_read(path: string) -> FileResult { kaesu open_mode(path, 0); }\nkoukai waza open_write(path: string) -> FileResult { kaesu open_mode(path, 1); }\nkoukai waza open_append(path: string) -> FileResult { kaesu open_mode(path, 2); }\n\nkoukai waza read(file: File, destination: []uint8, offset: int64, length: int64) -> io.ReadResult {\n    moshi (offset < 0 || length < 0 || offset > len(destination) || length > len(destination) - offset) {\n        kaesu io.ReadResult { count: 0, eof: iie, error: io.IoError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = runtime.read(file.handle, destination, offset, length, status);\n    kaku failure = error_from(status[9], message);\n    moshi (failure == mu) {\n        kaesu io.ReadResult { count: decode_count(status), eof: status[8] != uint8(0), error: mu };\n    }\n    awase (failure) {\n        baai Closed(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Closed() }; }\n        baai InvalidArgument(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.InvalidArgument() }; }\n        baai IOFailure(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai NotFound(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai PermissionDenied(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai NoSpace(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai InvalidPath(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n    }\n    kaesu io.ReadResult { count: 0, eof: iie, error: io.IoError.Other(message) };\n}\n\nkoukai waza write(file: File, source: []uint8, offset: int64, length: int64) -> io.WriteResult {\n    moshi (offset < 0 || length < 0 || offset > len(source) || length > len(source) - offset) {\n        kaesu io.WriteResult { count: 0, error: io.IoError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = runtime.write(file.handle, source, offset, length, status);\n    kaku failure = error_from(status[9], message);\n    moshi (failure == mu) { kaesu io.WriteResult { count: decode_count(status), error: mu }; }\n    awase (failure) {\n        baai Closed(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Closed() }; }\n        baai InvalidArgument(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.InvalidArgument() }; }\n        baai IOFailure(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai NotFound(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai PermissionDenied(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai NoSpace(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai InvalidPath(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n    }\n    kaesu io.WriteResult { count: 0, error: io.IoError.Other(message) };\n}\n\nkoukai waza close(file: File) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = runtime.close(file.handle, status);\n    kaesu UnitResult { error: error_from(status[0], message) };\n}\n\nkoukai waza reader(file: File) -> io.Reader {\n    kaesu io.Reader { read: waza (destination: []uint8, offset: int64, length: int64) -> io.ReadResult {\n            kaesu read(file, destination, offset, length);\n        } };\n}\n\nkoukai waza writer(file: File) -> io.Writer {\n    kaesu io.Writer { write: waza (source: []uint8, offset: int64, length: int64) -> io.WriteResult {\n            kaesu write(file, source, offset, length);\n        } };\n}\n\nkoukai waza read_all(path: string) -> ReadAllResult {\n    kaku opened = open_read(path);\n    kaku open_error = opened.error;\n    moshi (open_error != mu) { kaesu ReadAllResult { data: [], error: open_error }; }\n    kaku file = opened.file;\n    moshi (file == mu) { kaesu ReadAllResult { data: [], error: FsError.IOFailure(\"missing file handle\") }; }\n    kaku output = array.with_capacity[uint8](32768);\n    kaku buffer = array.make[uint8](32768, uint8(0));\n    aida (hai) {\n        kaku result = read(file, buffer, 0, len(buffer));\n        kaku index = 0;\n        aida (index < result.count) {\n            array.push(output, buffer[index]);\n            index = index + 1;\n        }\n        kaku read_error = result.error;\n        moshi (read_error != mu) {\n            close(file);\n            awase (read_error) {\n                baai Closed { kaesu ReadAllResult { data: output, error: FsError.Closed(\"file is closed\") }; }\n                baai InvalidArgument { kaesu ReadAllResult { data: output, error: FsError.InvalidArgument(\"invalid read range\") }; }\n                baai NoProgress { kaesu ReadAllResult { data: output, error: FsError.IOFailure(\"read made no progress\") }; }\n                baai UnexpectedEOF { kaesu ReadAllResult { data: output, error: FsError.IOFailure(\"unexpected EOF\") }; }\n                baai Other(message) { kaesu ReadAllResult { data: output, error: FsError.IOFailure(message) }; }\n            }\n        }\n        moshi (result.eof) { nukeru; }\n        moshi (result.count == 0) {\n            close(file);\n            kaesu ReadAllResult { data: output, error: FsError.IOFailure(\"read made no progress\") };\n        }\n    }\n    kaku closed = close(file);\n    kaesu ReadAllResult { data: output, error: closed.error };\n}\n\nkoukai waza write_all(path: string, data: []uint8) -> UnitResult {\n    kaku opened = open_write(path);\n    kaku open_error = opened.error;\n    moshi (open_error != mu) { kaesu UnitResult { error: open_error }; }\n    kaku file = opened.file;\n    moshi (file == mu) { kaesu UnitResult { error: FsError.IOFailure(\"missing file handle\") }; }\n    kaku result = io.write_all(writer(file), data, 0, len(data));\n    kaku write_error = result.error;\n    kaku closed = close(file);\n    moshi (write_error != mu) {\n        awase (write_error) {\n            baai Closed { kaesu UnitResult { error: FsError.Closed(\"file is closed\") }; }\n            baai InvalidArgument { kaesu UnitResult { error: FsError.InvalidArgument(\"invalid write range\") }; }\n            baai NoProgress { kaesu UnitResult { error: FsError.IOFailure(\"write made no progress\") }; }\n            baai UnexpectedEOF { kaesu UnitResult { error: FsError.IOFailure(\"unexpected EOF\") }; }\n            baai Other(message) { kaesu UnitResult { error: FsError.IOFailure(message) }; }\n        }\n    }\n    kaesu closed;\n}\n\nkoukai waza stat(path: string) -> StatResult {\n    kaku status: []uint8 = [0, 0];\n    kaku message = runtime.stat(path, status);\n    kaku stat_error = error_from(status[1], message);\n    moshi (status[1] == uint8(1)) {\n        kaesu StatResult { exists: iie, is_file: iie, is_dir: iie, error: mu };\n    }\n    kaesu StatResult { exists: stat_error == mu, is_file: status[0] == uint8(1), is_dir: status[0] == uint8(2), error: stat_error };\n}\n\nkoukai waza exists(path: string) -> bool { kaesu stat(path).exists; }\nkoukai waza is_file(path: string) -> bool { kaesu stat(path).is_file; }\nkoukai waza is_dir(path: string) -> bool { kaesu stat(path).is_dir; }\n\nkoukai waza create_dir(path: string) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = runtime.mkdir(path, status);\n    kaesu UnitResult { error: error_from(status[0], message) };\n}\n\nkoukai waza read_dir(path: string) -> DirResult {\n    kaku iterator = runtime.open_dir(path);\n    kaku status: []uint8 = [0];\n    kaku message = runtime.dir_status(iterator, status);\n    kaku directory_error = error_from(status[0], message);\n    kaku entries = array.with_capacity[DirEntry](0);\n    moshi (directory_error != mu) {\n        runtime.dir_close(iterator, status);\n        kaesu DirResult { entries: entries, error: directory_error };\n    }\n    aida (runtime.dir_next(iterator)) {\n        kaku directory = runtime.dir_is_dir(iterator);\n        array.push(entries, DirEntry { name: runtime.dir_name(iterator), is_file: runtime.dir_is_file(iterator), is_dir: directory });\n    }\n    message = runtime.dir_status(iterator, status);\n    directory_error = error_from(status[0], message);\n    message = runtime.dir_close(iterator, status);\n    moshi (directory_error == mu) { directory_error = error_from(status[0], message); }\n    kaesu DirResult { entries: entries, error: directory_error };\n}\n\n// Optional third status byte extends the existing NativeFS stat protocol.\n// The original existence/file/directory and error bytes remain unchanged.\nkoukai waza is_character_device(path: string) -> bool {\n    kaku status: []uint8 = [0, 0, 0];\n    runtime.stat(path, status);\n    kaesu status[1] == uint8(0) && status[2] == uint8(1);\n}\n" }; }
waza data_86() -> File { kaesu File { path: "kiso/io/io.mio", version: "Bunko-v2.1.1", length: 6063, sha256: "9fd89953da27ae5cf822fd6ac24e1e6278b506aa2c3dadef7a432bc02caa3df9", source: "yobu \"kiso/array\";\nyobu \"kiso/bytes\";\n\nkoukai sentaku IoError {\n    Closed;\n    InvalidArgument;\n    NoProgress;\n    UnexpectedEOF;\n    Other(string);\n}\n\nkoukai kata ReadResult {\n    count: int64;\n    eof: bool;\n    error: IoError?;\n}\nkoukai kata WriteResult {\n    count: int64;\n    error: IoError?;\n}\nkoukai kata CopyResult {\n    count: int64;\n    error: IoError?;\n}\n\nkoukai kata Reader { read: ([]uint8, int64, int64) -> ReadResult; }\nkoukai kata Writer { write: ([]uint8, int64, int64) -> WriteResult; }\n\nwaza valid_range(values: []uint8, offset: int64, length: int64) -> bool {\n    kaesu offset >= 0 && length >= 0 && offset <= len(values) && length <= len(values) - offset;\n}\n\nkoukai waza read(reader: Reader, destination: []uint8, offset: int64, length: int64) -> ReadResult {\n    moshi (!valid_range(destination, offset, length)) {\n        kaesu ReadResult { count: 0, eof: iie, error: IoError.InvalidArgument() };\n    }\n    kaesu reader.read(destination, offset, length);\n}\n\nkoukai waza write(writer: Writer, source: []uint8, offset: int64, length: int64) -> WriteResult {\n    moshi (!valid_range(source, offset, length)) {\n        kaesu WriteResult { count: 0, error: IoError.InvalidArgument() };\n    }\n    kaesu writer.write(source, offset, length);\n}\n\nkoukai waza read_full(reader: Reader, destination: []uint8, offset: int64, length: int64) -> ReadResult {\n    moshi (!valid_range(destination, offset, length)) {\n        kaesu ReadResult { count: 0, eof: iie, error: IoError.InvalidArgument() };\n    }\n    kaku total = 0;\n    aida (total < length) {\n        kaku result = reader.read(destination, offset + total, length - total);\n        moshi (result.count < 0 || result.count > length - total) {\n            kaesu ReadResult { count: total, eof: iie, error: IoError.InvalidArgument() };\n        }\n        total = total + result.count;\n        kaku read_error = result.error;\n        moshi (read_error != mu) {\n            kaesu ReadResult { count: total, eof: result.eof, error: result.error };\n        }\n        moshi (total == length) {\n            kaesu ReadResult { count: total, eof: result.eof, error: mu };\n        }\n        moshi (result.eof) {\n            kaesu ReadResult { count: total, eof: hai, error: IoError.UnexpectedEOF() };\n        }\n        moshi (result.count == 0) {\n            kaesu ReadResult { count: total, eof: iie, error: IoError.NoProgress() };\n        }\n    }\n    kaesu ReadResult { count: total, eof: iie, error: mu };\n}\n\nkoukai waza write_all(writer: Writer, source: []uint8, offset: int64, length: int64) -> WriteResult {\n    moshi (!valid_range(source, offset, length)) {\n        kaesu WriteResult { count: 0, error: IoError.InvalidArgument() };\n    }\n    kaku total = 0;\n    aida (total < length) {\n        kaku result = writer.write(source, offset + total, length - total);\n        moshi (result.count < 0 || result.count > length - total) {\n            kaesu WriteResult { count: total, error: IoError.InvalidArgument() };\n        }\n        total = total + result.count;\n        kaku write_error = result.error;\n        moshi (write_error != mu) {\n            kaesu WriteResult { count: total, error: result.error };\n        }\n        moshi (result.count == 0) {\n            kaesu WriteResult { count: total, error: IoError.NoProgress() };\n        }\n    }\n    kaesu WriteResult { count: total, error: mu };\n}\n\nkoukai waza copy_stream(reader: Reader, writer: Writer) -> CopyResult {\n    kaku buffer = array.make[uint8](32768, uint8(0));\n    kaku total = 0;\n    aida (hai) {\n        kaku read_result = reader.read(buffer, 0, len(buffer));\n        moshi (read_result.count < 0 || read_result.count > len(buffer)) {\n            kaesu CopyResult { count: total, error: IoError.InvalidArgument() };\n        }\n        moshi (read_result.count > 0) {\n            kaku write_result = write_all(writer, buffer, 0, read_result.count);\n            total = total + write_result.count;\n            kaku stream_write_error = write_result.error;\n            moshi (stream_write_error != mu) {\n                kaesu CopyResult { count: total, error: write_result.error };\n            }\n        }\n        kaku stream_read_error = read_result.error;\n        moshi (stream_read_error != mu) {\n            kaesu CopyResult { count: total, error: read_result.error };\n        }\n        moshi (read_result.eof) {\n            kaesu CopyResult { count: total, error: mu };\n        }\n        moshi (read_result.count == 0) {\n            kaesu CopyResult { count: total, error: IoError.NoProgress() };\n        }\n    }\n    kaesu CopyResult { count: total, error: mu };\n}\n\nkoukai waza reader_from_bytes(source: []uint8) -> Reader {\n    kaku position = 0;\n    kaesu Reader { read: waza (destination: []uint8, offset: int64, length: int64) -> ReadResult {\n            moshi (!valid_range(destination, offset, length)) {\n                kaesu ReadResult { count: 0, eof: iie, error: IoError.InvalidArgument() };\n            }\n            moshi (position > len(source)) { position = len(source); }\n            kaku remaining = len(source) - position;\n            kaku count = length;\n            moshi (remaining < count) { count = remaining; }\n            kaku index = 0;\n            aida (index < count) {\n                destination[offset + index] = source[position + index];\n                index = index + 1;\n            }\n            position = position + count;\n            kaesu ReadResult { count: count, eof: position == len(source), error: mu };\n        } };\n}\n\nkoukai waza writer_to_buffer(buffer: bytes.ByteBuffer) -> Writer {\n    kaesu Writer { write: waza (source: []uint8, offset: int64, length: int64) -> WriteResult {\n            moshi (!valid_range(source, offset, length)) {\n                kaesu WriteResult { count: 0, error: IoError.InvalidArgument() };\n            }\n            kaku index = 0;\n            aida (index < length) {\n                array.push(buffer.data, source[offset + index]);\n                index = index + 1;\n            }\n            kaesu WriteResult { count: length, error: mu };\n        } };\n}\n" }; }
waza data_87() -> File { kaesu File { path: "kiso/math/compare.mio", version: "Bunko-v2.1.1", length: 1176, sha256: "7cadb689838a1fcf48bb31ec69a52d683482706e7fde1c94bd2820590412b27e", source: "koukai waza min<T: Number>(left: T, right: T) -> T {\n    moshi (left != left) { kaesu left; }\n    moshi (right != right) { kaesu right; }\n    moshi (left < right) { kaesu left; }\n    moshi (right < left) { kaesu right; }\n    moshi (__is_negative(left)) { kaesu left; }\n    kaesu right;\n}\n\nkoukai waza max<T: Number>(left: T, right: T) -> T {\n    moshi (left != left) { kaesu left; }\n    moshi (right != right) { kaesu right; }\n    moshi (left > right) { kaesu left; }\n    moshi (right > left) { kaesu right; }\n    moshi (__is_negative(left)) { kaesu right; }\n    kaesu left;\n}\n\nkoukai waza checked_abs<T: Signed>(value: T) -> T? {\n    moshi (__neg_overflows(value)) { kaesu mu; }\n    moshi (__is_negative(value)) { kaesu -value; }\n    kaesu value;\n}\n\nkoukai waza abs<T: Signed>(value: T) -> T {\n    kaku result: T? = checked_abs(value);\n    moshi (result != mu) { kaesu result; }\n    __math_error(\"kiso/math.abs: int64 overflow\");\n    kaesu value;\n}\n\nkoukai waza clamp<T: Number>(value: T, lower: T, upper: T) -> T {\n    moshi (lower > upper) {\n        __math_error(\"kiso/math.clamp: lower bound is greater than upper bound\");\n    }\n    kaesu min(max(value, lower), upper);\n}\n" }; }
waza data_88() -> File { kaesu File { path: "kiso/math/constants.mio", version: "Bunko-v2.1.1", length: 334, sha256: "e346e50367337bf9b32a3f4a2a814d05628945955302a3dae441c94b4b87dc02", source: "koukai teisu pi32: float32 = 3.14159265358979323846264338327950288419716939937510;\nkoukai teisu pi64: float64 = 3.14159265358979323846264338327950288419716939937510;\nkoukai teisu tau32: float32 = 6.28318530717958647692528676655900576839433879875021;\nkoukai teisu tau64: float64 = 6.28318530717958647692528676655900576839433879875021;\n" }; }
waza data_89() -> File { kaesu File { path: "kiso/math/fail.mio", version: "Bunko-v2.1.1", length: 230, sha256: "abaf8a60a2e150d5401bb30ce2c103c0a70e30bd2870e279e074ba3bb0cda888", source: "// Raise the existing checked runtime failure with a caller-supplied message.\n// Native tooling writes its structured diagnostic to stderr before this call.\nkoukai waza fail(message: string) -> unit {\n    __math_error(message);\n}\n" }; }
waza data_90() -> File { kaesu File { path: "kiso/math/float.mio", version: "Bunko-v2.1.1", length: 581, sha256: "e2e16c03416c7bea5e45a2deedea531afd05df6186a64fabeb40373fcfcdc5ab", source: "koukai waza sqrt<T: Float>(value: T) -> T { kaesu __sqrt(value); }\n\nkoukai waza floor<T: Float>(value: T) -> T { kaesu __floor(value); }\n\nkoukai waza ceil<T: Float>(value: T) -> T { kaesu __ceil(value); }\n\nkoukai waza round<T: Float>(value: T) -> T { kaesu __round_even(value); }\n\nkoukai waza trunc<T: Float>(value: T) -> T { kaesu __trunc(value); }\n\nkoukai waza is_nan<T: Float>(value: T) -> bool { kaesu __is_nan(value); }\n\nkoukai waza is_inf<T: Float>(value: T) -> bool { kaesu __is_inf(value); }\n\nkoukai waza is_finite<T: Float>(value: T) -> bool { kaesu __is_finite(value); }\n" }; }
waza data_91() -> File { kaesu File { path: "kiso/math/integer.mio", version: "Bunko-v2.1.1", length: 1408, sha256: "3e0b4bc2a8a3d6080d605e54c88fd03bc091feb410ff01d39358a28ef845e6bb", source: "koukai waza checked_gcd(left: int64, right: int64) -> int64? {\n    kaku a = left;\n    kaku b = right;\n    moshi (a > 0) { a = -a; }\n    moshi (b > 0) { b = -b; }\n    aida (b != 0) {\n        kaku remainder = a - (a / b) * b;\n        a = b;\n        b = remainder;\n    }\n    moshi (__neg_overflows(a)) { kaesu mu; }\n    kaesu -a;\n}\n\nkoukai waza gcd(left: int64, right: int64) -> int64 {\n    kaku result: int64? = checked_gcd(left, right);\n    moshi (result != mu) { kaesu result; }\n    __math_error(\"kiso/math.gcd: result does not fit int64\");\n    kaesu 0;\n}\n\nkoukai waza checked_lcm(left: int64, right: int64) -> int64? {\n    moshi (left == 0 || right == 0) { kaesu 0; }\n    kaku divisor: int64? = checked_gcd(left, right);\n    moshi (divisor != mu) {\n        kaku absolute_left: int64? = checked_abs(left);\n        moshi (absolute_left != mu) {\n            kaku absolute_right: int64? = checked_abs(right);\n            moshi (absolute_right != mu) {\n                kaku factor = absolute_left / divisor;\n                moshi (factor > 9223372036854775807 / absolute_right) { kaesu mu; }\n                kaesu factor * absolute_right;\n            }\n        }\n    }\n    kaesu mu;\n}\n\nkoukai waza lcm(left: int64, right: int64) -> int64 {\n    kaku result: int64? = checked_lcm(left, right);\n    moshi (result != mu) { kaesu result; }\n    __math_error(\"kiso/math.lcm: result does not fit int64\");\n    kaesu 0;\n}\n" }; }
waza data_92() -> File { kaesu File { path: "kiso/net/tcp/tcp.mio", version: "Bunko-v2.1.1", length: 8730, sha256: "9615817592a7ad76411ecf5c5866f4c5cf97d0a8c41847f1ee594938aa54bffa", source: "yobu \"kiso/array\";\nyobu \"kiso/io\";\nyobu \"mio/sys/socket\";\n\n// Blocking IPv4 TCP. Socket operations are primitive system calls; connection\n// policy, error translation, buffering and I/O adapters are written in Mio.\nkoukai sentaku TcpError {\n    InvalidArgument;\n    Closed;\n    TimedOut;\n    ConnectionRefused;\n    ConnectionReset;\n    AddressInUse;\n    PermissionDenied;\n    WouldBlock;\n    Other(string);\n}\n\nkoukai kata IPv4Address {\n    octets: []uint8;\n    port: int64;\n}\nkoukai kata Connection { handle: resource; }\nkoukai kata Listener { handle: resource; }\nkoukai kata ConnectionResult {\n    connection: Connection?;\n    error: TcpError?;\n}\nkoukai kata ListenerResult {\n    listener: Listener?;\n    error: TcpError?;\n}\nkoukai kata ReadResult {\n    count: int64;\n    eof: bool;\n    error: TcpError?;\n}\nkoukai kata WriteResult {\n    count: int64;\n    error: TcpError?;\n}\nkoukai kata UnitResult { error: TcpError?; }\n\nkoukai waza ipv4(a: uint8, b: uint8, c: uint8, d: uint8, port: int64) -> IPv4Address {\n    kaesu IPv4Address { octets: [a, b, c, d], port: port };\n}\n\nwaza valid_address(address: IPv4Address) -> bool {\n    kaesu len(address.octets) == 4 && address.port >= 0 && address.port <= 65535;\n}\n\nwaza valid_range(values: []uint8, offset: int64, length: int64) -> bool {\n    kaesu offset >= 0 && length >= 0 && offset <= len(values) && length <= len(values) - offset;\n}\n\nwaza error_from(code: uint8, message: string) -> TcpError? {\n    moshi (code == uint8(0)) { kaesu mu; }\n    moshi (code == uint8(1)) { kaesu TcpError.InvalidArgument(); }\n    moshi (code == uint8(2)) { kaesu TcpError.Closed(); }\n    moshi (code == uint8(3)) { kaesu TcpError.TimedOut(); }\n    moshi (code == uint8(4)) { kaesu TcpError.ConnectionRefused(); }\n    moshi (code == uint8(5)) { kaesu TcpError.ConnectionReset(); }\n    moshi (code == uint8(6)) { kaesu TcpError.AddressInUse(); }\n    moshi (code == uint8(7)) { kaesu TcpError.PermissionDenied(); }\n    moshi (code == uint8(8)) { kaesu TcpError.WouldBlock(); }\n    kaesu TcpError.Other(message);\n}\n\nwaza decode_count(status: []uint8) -> int64 {\n    kaku result = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 8) {\n        result = result + int64(status[index]) * factor;\n        index = index + 1;\n        moshi (index < 8) { factor = factor * 256; }\n    }\n    kaesu result;\n}\n\n// connect deliberately accepts only a literal IPv4 address; DNS and IPv6\n// will be separate pure-Mio layers, rather than hidden OS-dependent behavior.\nkoukai waza connect(address: IPv4Address) -> ConnectionResult {\n    moshi (!valid_address(address)) {\n        kaesu ConnectionResult { connection: mu, error: TcpError.InvalidArgument() };\n    }\n    kaku handle = socket.open();\n    kaku status: []uint8 = [0];\n    kaku message = socket.status(handle, status);\n    kaku failure = error_from(status[0], message);\n    moshi (failure == mu) {\n        message = socket.connect_ipv4(handle, address.octets, address.port, status);\n        failure = error_from(status[0], message);\n    }\n    moshi (failure != mu) {\n        socket.close(handle, status);\n        kaesu ConnectionResult { connection: mu, error: failure };\n    }\n    kaesu ConnectionResult { connection: Connection { handle: handle }, error: mu };\n}\n\nkoukai waza listen(address: IPv4Address) -> ListenerResult {\n    kaesu listen_with_backlog(address, 128);\n}\n\nkoukai waza listen_with_backlog(address: IPv4Address, backlog: int64) -> ListenerResult {\n    moshi (!valid_address(address) || backlog < 0 || backlog > 65535) {\n        kaesu ListenerResult { listener: mu, error: TcpError.InvalidArgument() };\n    }\n    kaku handle = socket.open();\n    kaku status: []uint8 = [0];\n    kaku message = socket.status(handle, status);\n    kaku failure = error_from(status[0], message);\n    moshi (failure == mu) {\n        message = socket.bind_ipv4(handle, address.octets, address.port, status);\n        failure = error_from(status[0], message);\n    }\n    moshi (failure == mu) {\n        message = socket.listen(handle, backlog, status);\n        failure = error_from(status[0], message);\n    }\n    moshi (failure != mu) {\n        socket.close(handle, status);\n        kaesu ListenerResult { listener: mu, error: failure };\n    }\n    kaesu ListenerResult { listener: Listener { handle: handle }, error: mu };\n}\n\nkoukai waza accept(listener: Listener) -> ConnectionResult {\n    kaku handle = socket.accept(listener.handle);\n    kaku status: []uint8 = [0];\n    kaku message = socket.status(handle, status);\n    kaku failure = error_from(status[0], message);\n    moshi (failure != mu) {\n        socket.close(handle, status);\n        kaesu ConnectionResult { connection: mu, error: failure };\n    }\n    kaesu ConnectionResult { connection: Connection { handle: handle }, error: mu };\n}\n\nkoukai waza read(connection: Connection, destination: []uint8, offset: int64, length: int64) -> ReadResult {\n    moshi (!valid_range(destination, offset, length)) {\n        kaesu ReadResult { count: 0, eof: iie, error: TcpError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = socket.read(connection.handle, destination, offset, length, status);\n    kaesu ReadResult { count: decode_count(status), eof: status[8] != uint8(0), error: error_from(status[9], message) };\n}\n\nkoukai waza write(connection: Connection, source: []uint8, offset: int64, length: int64) -> WriteResult {\n    moshi (!valid_range(source, offset, length)) {\n        kaesu WriteResult { count: 0, error: TcpError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = socket.write(connection.handle, source, offset, length, status);\n    kaesu WriteResult { count: decode_count(status), error: error_from(status[9], message) };\n}\n\n// TCP writes may be partial. This helper retains progress when a later call\n// fails, and never loops forever after a zero-byte write.\nkoukai waza write_all(connection: Connection, source: []uint8, offset: int64, length: int64) -> WriteResult {\n    moshi (!valid_range(source, offset, length)) {\n        kaesu WriteResult { count: 0, error: TcpError.InvalidArgument() };\n    }\n    kaku total = 0;\n    aida (total < length) {\n        kaku result = write(connection, source, offset + total, length - total);\n        moshi (result.count < 0 || result.count > length - total) {\n            kaesu WriteResult { count: total, error: TcpError.InvalidArgument() };\n        }\n        total = total + result.count;\n        kaku failure = result.error;\n        moshi (failure != mu) { kaesu WriteResult { count: total, error: failure }; }\n        moshi (result.count == 0) {\n            kaesu WriteResult { count: total, error: TcpError.Other(\"write made no progress\") };\n        }\n    }\n    kaesu WriteResult { count: total, error: mu };\n}\n\nkoukai waza close(connection: Connection) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = socket.close(connection.handle, status);\n    kaesu UnitResult { error: error_from(status[0], message) };\n}\n\nkoukai waza close_listener(listener: Listener) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = socket.close(listener.handle, status);\n    kaesu UnitResult { error: error_from(status[0], message) };\n}\n\nwaza io_error(failure: TcpError?) -> io.IoError? {\n    moshi (failure == mu) { kaesu mu; }\n    awase (failure) {\n        baai InvalidArgument { kaesu io.IoError.InvalidArgument(); }\n        baai Closed { kaesu io.IoError.Closed(); }\n        baai TimedOut { kaesu io.IoError.Other(\"TCP timed out\"); }\n        baai ConnectionRefused { kaesu io.IoError.Other(\"TCP connection refused\"); }\n        baai ConnectionReset { kaesu io.IoError.Other(\"TCP connection reset\"); }\n        baai AddressInUse { kaesu io.IoError.Other(\"TCP address in use\"); }\n        baai PermissionDenied { kaesu io.IoError.Other(\"TCP permission denied\"); }\n        baai WouldBlock { kaesu io.IoError.Other(\"TCP would block\"); }\n        baai Other(message) { kaesu io.IoError.Other(message); }\n    }\n    kaesu io.IoError.Other(\"unknown TCP error\");\n}\n\nkoukai waza reader(connection: Connection) -> io.Reader {\n    kaesu io.Reader { read: waza (destination: []uint8, offset: int64, length: int64) -> io.ReadResult {\n            kaku result = read(connection, destination, offset, length);\n            kaesu io.ReadResult { count: result.count, eof: result.eof, error: io_error(result.error) };\n        } };\n}\n\nkoukai waza writer(connection: Connection) -> io.Writer {\n    kaesu io.Writer { write: waza (source: []uint8, offset: int64, length: int64) -> io.WriteResult {\n            kaku result = write(connection, source, offset, length);\n            kaesu io.WriteResult { count: result.count, error: io_error(result.error) };\n        } };\n}\n" }; }
waza data_93() -> File { kaesu File { path: "kiso/net/tcp_async/tcp_async.mio", version: "Bunko-v2.1.1", length: 10149, sha256: "5803c5b5e0f9abf34b44900e7b11aac15973b5928075e5e36710fde2651e7159", source: "yobu \"kiso/array\";\nyobu \"kiso/net/tcp\";\nyobu \"mio/sys/socket\";\n\n// Nonblocking IPv4 TCP: the additive counterpart of kiso/net/tcp (which stays blocking and unchanged).\n//\n// Every operation returns immediately and never waits for the network. An operation that cannot make progress yet\n// reports pending = hai with no other effect (nothing consumed, nothing lost) and may simply be called again; a future\n// reactor decides *when* to call it again, this module only provides the readiness-free primitives.\n//\n// Contracts shared by all operations:\n//  * Partial progress is exact: read/write report the bytes actually transferred (count), never more.\n//  * pending, eof and error are mutually exclusive outcomes of one call; count is 0 unless the call transferred bytes.\n//  * EINTR is retried inside the primitive; EAGAIN/EWOULDBLOCK become pending; EINPROGRESS (connect) becomes pending.\n//  * A handle that is returned inside a result is owned by the caller and must be closed with close/close_listener.\n//    A handle that is not returned has already been closed by this module, on every error path.\n//  * Closing is idempotent-safe: closing twice (or using a closed handle) reports Closed and never touches another\n//    socket, even when the operating system has reused the descriptor (the handle table is generation checked).\nkoukai sentaku AsyncError {\n    InvalidArgument;\n    Closed;\n    TimedOut;\n    ConnectionRefused;\n    ConnectionReset;\n    AddressInUse;\n    PermissionDenied;\n    Other(string);\n}\n\nkoukai kata AsyncConnection { handle: resource; }\nkoukai kata AsyncListener { handle: resource; }\nkoukai kata ListenResult {\n    listener: AsyncListener?;\n    error: AsyncError?;\n}\n// connection is set when the socket exists: pending = hai means the connect is still in progress (finish_connect\n// completes it); pending = iie and error = mu means connected.\nkoukai kata ConnectResult {\n    connection: AsyncConnection?;\n    pending: bool;\n    error: AsyncError?;\n}\nkoukai kata AcceptResult {\n    connection: AsyncConnection?;\n    pending: bool;\n    error: AsyncError?;\n}\nkoukai kata ReadResult {\n    count: int64;\n    eof: bool;\n    pending: bool;\n    error: AsyncError?;\n}\nkoukai kata WriteResult {\n    count: int64;\n    pending: bool;\n    error: AsyncError?;\n}\nkoukai kata UnitResult {\n    pending: bool;\n    error: AsyncError?;\n}\n\nwaza valid_address(address: tcp.IPv4Address) -> bool {\n    kaesu len(address.octets) == 4 && address.port >= 0 && address.port <= 65535;\n}\n\nwaza valid_range(values: []uint8, offset: int64, length: int64) -> bool {\n    kaesu offset >= 0 && length >= 0 && offset <= len(values) && length <= len(values) - offset;\n}\n\n// Status codes shared with the socket primitives: 0 ok, 1 invalid argument, 2 closed, 3 timed out, 4 refused, 5 reset,\n// 6 address in use, 7 permission denied, 8 would block, 9 other, 10 in progress.\nwaza error_from(code: uint8, message: string) -> AsyncError? {\n    moshi (code == uint8(0)) { kaesu mu; }\n    moshi (code == uint8(1)) { kaesu AsyncError.InvalidArgument(); }\n    moshi (code == uint8(2)) { kaesu AsyncError.Closed(); }\n    moshi (code == uint8(3)) { kaesu AsyncError.TimedOut(); }\n    moshi (code == uint8(4)) { kaesu AsyncError.ConnectionRefused(); }\n    moshi (code == uint8(5)) { kaesu AsyncError.ConnectionReset(); }\n    moshi (code == uint8(6)) { kaesu AsyncError.AddressInUse(); }\n    moshi (code == uint8(7)) { kaesu AsyncError.PermissionDenied(); }\n    kaesu AsyncError.Other(message);\n}\n\nwaza is_pending(code: uint8) -> bool {\n    kaesu code == uint8(8) || code == uint8(10);\n}\n\nwaza decode_count(status: []uint8) -> int64 {\n    kaku result = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 8) {\n        result = result + int64(status[index]) * factor;\n        index = index + 1;\n        moshi (index < 8) { factor = factor * 256; }\n    }\n    kaesu result;\n}\n\nwaza release(handle: resource) -> unit {\n    kaku status: []uint8 = [0];\n    socket.close(handle, status);\n}\n\n// listen binds and listens; the socket is nonblocking, so accept never waits.\nkoukai waza listen(address: tcp.IPv4Address, backlog: int64) -> ListenResult {\n    moshi (!valid_address(address) || backlog < 0 || backlog > 65535) {\n        kaesu ListenResult { listener: mu, error: AsyncError.InvalidArgument() };\n    }\n    kaku handle = socket.open();\n    kaku status: []uint8 = [0];\n    kaku message = socket.status(handle, status);\n    kaku failure = error_from(status[0], message);\n    moshi (failure == mu) {\n        message = socket.set_nonblocking(handle, 1, status);\n        failure = error_from(status[0], message);\n    }\n    moshi (failure == mu) {\n        message = socket.bind_ipv4(handle, address.octets, address.port, status);\n        failure = error_from(status[0], message);\n    }\n    moshi (failure == mu) {\n        message = socket.listen(handle, backlog, status);\n        failure = error_from(status[0], message);\n    }\n    moshi (failure != mu) {\n        release(handle);\n        kaesu ListenResult { listener: mu, error: failure };\n    }\n    kaesu ListenResult { listener: AsyncListener { handle: handle }, error: mu };\n}\n\n// accept returns pending = hai when no connection is waiting. The accepted socket is switched to nonblocking mode\n// before it is returned; if that fails it is closed and the error is reported.\nkoukai waza accept(listener: AsyncListener) -> AcceptResult {\n    kaku handle = socket.accept(listener.handle);\n    kaku status: []uint8 = [0];\n    kaku message = socket.status(handle, status);\n    kaku code = status[0];\n    moshi (code != uint8(0)) {\n        release(handle);\n        moshi (is_pending(code)) { kaesu AcceptResult { connection: mu, pending: hai, error: mu }; }\n        kaesu AcceptResult { connection: mu, pending: iie, error: error_from(code, message) };\n    }\n    message = socket.set_nonblocking(handle, 1, status);\n    kaku failure = error_from(status[0], message);\n    moshi (failure != mu) {\n        release(handle);\n        kaesu AcceptResult { connection: mu, pending: iie, error: failure };\n    }\n    kaesu AcceptResult { connection: AsyncConnection { handle: handle }, pending: iie, error: mu };\n}\n\n// connect starts a connection to a literal IPv4 address. Loopback connects usually complete at once; otherwise the\n// result carries pending = hai and the caller must call finish_connect until it stops reporting pending.\nkoukai waza connect(address: tcp.IPv4Address) -> ConnectResult {\n    moshi (!valid_address(address)) {\n        kaesu ConnectResult { connection: mu, pending: iie, error: AsyncError.InvalidArgument() };\n    }\n    kaku handle = socket.open();\n    kaku status: []uint8 = [0];\n    kaku message = socket.status(handle, status);\n    kaku failure = error_from(status[0], message);\n    moshi (failure == mu) {\n        message = socket.set_nonblocking(handle, 1, status);\n        failure = error_from(status[0], message);\n    }\n    kaku pending = iie;\n    moshi (failure == mu) {\n        message = socket.connect_ipv4(handle, address.octets, address.port, status);\n        pending = status[0] == uint8(10);\n        moshi (!pending) { failure = error_from(status[0], message); }\n    }\n    moshi (failure != mu) {\n        release(handle);\n        kaesu ConnectResult { connection: mu, pending: iie, error: failure };\n    }\n    kaesu ConnectResult { connection: AsyncConnection { handle: handle }, pending: pending, error: mu };\n}\n\n// finish_connect completes a connect that reported pending. It only ever reports pending while the connection is\n// genuinely still being established; once it fails the socket is closed (a later close reports Closed). It must only be\n// called on a connection returned by connect() with pending = hai.\nkoukai waza finish_connect(connection: AsyncConnection) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = socket.finish_connect(connection.handle, status);\n    kaku code = status[0];\n    moshi (code == uint8(10)) { kaesu UnitResult { pending: hai, error: mu }; }\n    kaku failure = error_from(code, message);\n    moshi (failure != mu) {\n        release(connection.handle);\n        kaesu UnitResult { pending: iie, error: failure };\n    }\n    kaesu UnitResult { pending: iie, error: mu };\n}\n\nkoukai waza read(connection: AsyncConnection, destination: []uint8, offset: int64, length: int64) -> ReadResult {\n    moshi (!valid_range(destination, offset, length)) {\n        kaesu ReadResult { count: 0, eof: iie, pending: iie, error: AsyncError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = socket.read(connection.handle, destination, offset, length, status);\n    kaku code = status[9];\n    moshi (is_pending(code)) { kaesu ReadResult { count: 0, eof: iie, pending: hai, error: mu }; }\n    kaesu ReadResult { count: decode_count(status), eof: status[8] != uint8(0), pending: iie, error: error_from(code, message) };\n}\n\n// write transfers as many bytes as the kernel accepts right now (possibly fewer than length, possibly zero with\n// pending = hai). The caller keeps its own progress: resume at offset + count.\nkoukai waza write(connection: AsyncConnection, source: []uint8, offset: int64, length: int64) -> WriteResult {\n    moshi (!valid_range(source, offset, length)) {\n        kaesu WriteResult { count: 0, pending: iie, error: AsyncError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = socket.write(connection.handle, source, offset, length, status);\n    kaku code = status[9];\n    moshi (is_pending(code)) { kaesu WriteResult { count: 0, pending: hai, error: mu }; }\n    kaesu WriteResult { count: decode_count(status), pending: iie, error: error_from(code, message) };\n}\n\nkoukai waza close(connection: AsyncConnection) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = socket.close(connection.handle, status);\n    kaesu UnitResult { pending: iie, error: error_from(status[0], message) };\n}\n\nkoukai waza close_listener(listener: AsyncListener) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = socket.close(listener.handle, status);\n    kaesu UnitResult { pending: iie, error: error_from(status[0], message) };\n}\n" }; }
waza data_94() -> File { kaesu File { path: "kiso/os/os.mio", version: "Bunko-v2.1.1", length: 4013, sha256: "7f482f8232b270ac3460b6fff484e67ab90d815227b1e3a0d147b69cd892937f", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\nyobu \"kiso/math\";\nyobu \"mio/os/runtime\";\n\nkoukai waza argument(index: int64) -> string? {\n    kaku size = runtime.arg_size(index);\n    moshi (size < 0) { kaesu mu; }\n    kaku bytes = array.make[uint8](size, uint8(0));\n    moshi (runtime.arg_copy(index, bytes) != size) { kaesu mu; }\n    kaesu string.from_utf8(bytes);\n}\nkoukai waza arguments() -> []string {\n    kaku result: []string = [];\n    kaku count = runtime.argc();\n    kaku index = 0;\n    aida (index < count) {\n        kaku value = argument(index);\n        moshi (value == mu) {\n            math.fail(\"invalid OS argument encoding\");\n            kaesu [];\n        }\n        array.push(result, value);\n        index = index + 1;\n    }\n    kaesu result;\n}\nkoukai waza chmod(path: string, mode: int64) -> int64 { kaesu runtime.chmod(path, mode); }\nkoukai waza exit(status: int64) -> unit { runtime.exit(status); }\n\n// Arguments include argv[0], matching the OS ABI. Negative values report a\n// system errno; spawned child exits and signals become shell-compatible codes.\nkoukai waza spawn(path: string, arguments: []string) -> int64 { kaesu runtime.spawn(path, arguments); }\nkoukai waza exec(path: string, arguments: []string) -> int64 { kaesu runtime.exec(path, arguments); }\nkoukai waza pid() -> int64 { kaesu runtime.pid(); }\nkoukai waza remove(path: string) -> int64 { kaesu runtime.remove(path); }\n\nkoukai waza remove_dir(path: string) -> int64 { kaesu runtime.rmdir(path); }\n\n// Test-only child isolation: capture stdout, stderr and assertion packets into\n// private files; the positive CPU and wall budgets terminate only the child process.\nkoukai waza spawn_test(path: string, arguments: []string, stdout: string, stderr: string, records: string, cpu_seconds: int64) -> int64 {\n    kaesu runtime.spawn_test(path, arguments, stdout, stderr, records, cpu_seconds);\n}\n\n// Milliseconds from the OS-accessible ARM64 virtual counter; not wall time.\nkoukai waza monotonic_ms() -> int64 { kaesu runtime.monotonic_ms(); }\n\n// Missing, malformed or non-UTF8 environment values return mu; an existing\n// empty value remains an empty string. No ambient compiler/Bunko path fallback.\nkoukai waza environment(name: string) -> string? {\n    kaku size = runtime.env_size(name);\n    moshi (size<0) {\n        kaesu mu;\n    }\n    kaku bytes = array.make[uint8](size, uint8(0));\n    moshi (runtime.env_copy(name, bytes) != size) {\n        kaesu mu;\n    }\n    kaesu string.from_utf8(bytes);\n}\nkoukai waza getenv(name: string) -> string {\n    kaku value = environment(name);\n    moshi (value == mu) {\n        kaesu \"\";\n    }\n    kaesu value;\n}\n\n// Nonblocking stdin readiness: positive for data/EOF, zero while idle, negative errno.\nkoukai waza stdin_ready() -> int64 { kaesu runtime.stdin_ready(); }\n\n// Millisecond timeout, or -1 to wait without a deadline. Other negative values\n// and values above INT32_MAX return -EINVAL without blocking.\nkoukai waza stdin_wait(timeout_ms: int64) -> int64 { kaesu runtime.stdin_wait(timeout_ms); }\n\n// Physical absolute identity for existing paths. Unresolvable/non-UTF8 paths\n// return mu; callers retain memory-only source identities separately.\nkoukai waza canonical_path(path: string) -> string? {\n    moshi (path == \"\") { kaesu mu; }\n    kaku bytes = array.make[uint8](1024, uint8(0));\n    kaku size = runtime.real_path(path, bytes);\n    moshi (size<0 || size >= len(bytes)) {\n        kaesu mu;\n    }\n    array.truncate(bytes, size);\n    kaesu string.from_utf8(bytes);\n}\n\n// The empty real_path request is reserved for the OS image identity. This keeps\n// the RA-1 calling convention and existing native binding signature unchanged.\nkoukai waza executable_path() -> string? {\n    kaku bytes = array.make[uint8](4096, uint8(0));\n    kaku size = runtime.real_path(\"\", bytes);\n    moshi (size <= 0 || size >= len(bytes)) {\n        kaesu mu;\n    }\n    moshi (bytes[size - 1] == uint8(0)) {\n        size = size - 1;\n    }\n    array.truncate(bytes, size);\n    kaesu string.from_utf8(bytes);\n}\n" }; }
waza data_95() -> File { kaesu File { path: "kiso/path/path.mio", version: "Bunko-v2.1.1", length: 4403, sha256: "3072b906a66517ddfc78d238f0256c6bdce7206bdde34097753aee32ca193c61", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\nkoukai kata SplitResult {\n    dir: string;\n    base: string;\n}\n\nwaza bytes_to_string(data: []uint8) -> string {\n    kaku result = string.from_utf8(data);\n    moshi (result != mu) { kaesu result; }\n    kaesu \"\";\n}\n\nwaza byte_range(data: []uint8, start: int64, end: int64) -> string {\n    kaku output = array.with_capacity[uint8](end - start);\n    kaku index = start;\n    aida (index < end) {\n        array.push(output, data[index]);\n        index = index + 1;\n    }\n    kaesu bytes_to_string(output);\n}\n\nwaza push_segment(segments: []string, data: []uint8, start: int64, end: int64, absolute: bool) -> unit {\n    moshi (end == start) { kaesu; }\n    kaku segment = byte_range(data, start, end);\n    moshi (segment == \".\") { kaesu; }\n    moshi (segment == \"..\") {\n        moshi (len(segments) > 0 && segments[len(segments) - 1] != \"..\") {\n            array.truncate(segments, len(segments) - 1);\n            kaesu;\n        }\n        moshi (!absolute) { array.push(segments, segment); }\n        kaesu;\n    }\n    array.push(segments, segment);\n}\n\nkoukai waza clean(value: string) -> string {\n    kaku data = string.to_bytes(value);\n    kaku absolute = len(data) > 0 && data[0] == uint8(47);\n    kaku segments = array.with_capacity[string](8);\n    kaku start = 0;\n    kaku index = 0;\n    aida (index <= len(data)) {\n        moshi (index == len(data) || data[index] == uint8(47)) {\n            push_segment(segments, data, start, index, absolute);\n            start = index + 1;\n        }\n        index = index + 1;\n    }\n    moshi (len(segments) == 0) {\n        moshi (absolute) { kaesu \"/\"; }\n        kaesu \".\";\n    }\n    kaku builder = string.new_builder();\n    moshi (absolute) { string.write_string(builder, \"/\"); }\n    index = 0;\n    aida (index < len(segments)) {\n        moshi (index > 0) { string.write_string(builder, \"/\"); }\n        string.write_string(builder, segments[index]);\n        index = index + 1;\n    }\n    kaesu string.builder_string(builder);\n}\n\nkoukai waza join(left: string, right: string) -> string {\n    moshi (left == \"\") { kaesu clean(right); }\n    moshi (right == \"\") { kaesu clean(left); }\n    kaku builder = string.builder_with_capacity(string.byte_len(left) + string.byte_len(right) + 1);\n    string.write_string(builder, left);\n    string.write_string(builder, \"/\");\n    string.write_string(builder, right);\n    kaesu clean(string.builder_string(builder));\n}\n\nkoukai waza join_all(parts: []string) -> string {\n    kaku capacity = 0;\n    kaku index = 0;\n    aida (index < len(parts)) {\n        capacity = capacity + string.byte_len(parts[index]) + 1;\n        index = index + 1;\n    }\n    kaku builder = string.builder_with_capacity(capacity);\n    index = 0;\n    aida (index < len(parts)) {\n        moshi (index > 0) { string.write_string(builder, \"/\"); }\n        string.write_string(builder, parts[index]);\n        index = index + 1;\n    }\n    kaesu clean(string.builder_string(builder));\n}\n\nkoukai waza is_abs(value: string) -> bool {\n    kaku data = string.to_bytes(value);\n    kaesu len(data) > 0 && data[0] == uint8(47);\n}\n\nkoukai waza base(value: string) -> string {\n    kaku normalized = clean(value);\n    moshi (normalized == \"/\" || normalized == \".\" || normalized == \"..\") { kaesu normalized; }\n    kaku data = string.to_bytes(normalized);\n    kaku index = len(data) - 1;\n    aida (index >= 0) {\n        moshi (data[index] == uint8(47)) { kaesu byte_range(data, index + 1, len(data)); }\n        index = index - 1;\n    }\n    kaesu normalized;\n}\n\nkoukai waza dir(value: string) -> string {\n    kaku normalized = clean(value);\n    moshi (normalized == \"/\") { kaesu \"/\"; }\n    kaku data = string.to_bytes(normalized);\n    kaku index = len(data) - 1;\n    aida (index >= 0) {\n        moshi (data[index] == uint8(47)) {\n            moshi (index == 0) { kaesu \"/\"; }\n            kaesu byte_range(data, 0, index);\n        }\n        index = index - 1;\n    }\n    kaesu \".\";\n}\n\nkoukai waza ext(value: string) -> string {\n    kaku name = base(value);\n    kaku data = string.to_bytes(name);\n    kaku index = len(data) - 1;\n    aida (index > 0) {\n        moshi (data[index] == uint8(46)) { kaesu byte_range(data, index, len(data)); }\n        index = index - 1;\n    }\n    kaesu \"\";\n}\n\nkoukai waza split(value: string) -> SplitResult {\n    kaku normalized = clean(value);\n    kaesu SplitResult { dir: dir(normalized), base: base(normalized) };\n}\n" }; }
waza data_96() -> File { kaesu File { path: "kiso/reactor/reactor.mio", version: "Bunko-v2.1.1", length: 12914, sha256: "9eb62619cec0999ec04d9cba75808de5dcf3bb476df2b074e93bace012bc2089", source: "yobu \"kiso/array\";\nyobu \"mio/sys/socket\";\n\n// 跨平台就绪态事件反应器（Readiness Reactor）：\n// 提供 submit / update / poll / cancel / wake / close 五项核心契约。\n// Linux 后端使用 epoll，Darwin 后端使用 kqueue，均为水平触发（参见 docs/async-networking.md）；\n// 其余未实现平台在 open() 时安全失败（返回 ReactorError.Unsupported）。\n// 每个 Operation 绑定唯一 id 与单调递增的 generation（slot 可复用，generation 永不回绕复用），\n// 从而在 poll/cancel 竞态下自动丢弃过期内核事件（计入 PollResult.stale），避免误投递。\n\nkoukai teisu readable = 1;\nkoukai teisu writable = 2;\nkoukai teisu max_events = 64;\nkoukai teisu slot_limit = 1048576;\n\nkoukai sentaku ReactorError {\n    InvalidArgument;\n    Closed;\n    Exhausted;\n    Unsupported;\n    Other(string);\n}\n\n// ids: the id of the live operation in each slot; counter[0]: the last id handed out; handles: the watched handle per slot\n// (a managed reference that keeps the socket reachable while the operation is pending; a free slot holds the reactor's own poll\n// handle as a placeholder).\nkoukai kata Watched { handle: resource; }\nkoukai kata Reactor {\n    poll_handle: resource;\n    wake_handle: resource;\n    generations: []int64;\n    active: []bool;\n    free: []int64;\n    ids: []int64;\n    counter: []int64;\n    handles: []Watched;\n}\nkoukai kata Operation {\n    id: int64;\n    slot: int64;\n    generation: int64;\n}\n// interest events: readable/writable report readiness; error and hangup are reported whatever the interest was.\nkoukai kata Event {\n    operation: int64;\n    slot: int64;\n    generation: int64;\n    readable: bool;\n    writable: bool;\n    error: bool;\n    hangup: bool;\n}\nkoukai kata OpenResult {\n    reactor: Reactor?;\n    error: ReactorError?;\n}\nkoukai kata SubmitResult {\n    operation: Operation?;\n    error: ReactorError?;\n}\nkoukai kata PollResult {\n    events: []Event;\n    woken: bool;\n    stale: int64;\n    error: ReactorError?;\n}\nkoukai kata UnitResult { error: ReactorError?; }\n\nwaza error_from(code: uint8, message: string) -> ReactorError? {\n    moshi (code == uint8(0)) { kaesu mu; }\n    moshi (code == uint8(1)) { kaesu ReactorError.InvalidArgument(); }\n    moshi (code == uint8(2)) { kaesu ReactorError.Closed(); }\n    // status 11: the target's kernel call is not available (ENOSYS), e.g. kqueue through an adapter that does not translate it\n    moshi (code == uint8(11)) { kaesu ReactorError.Unsupported(); }\n    kaesu ReactorError.Other(message);\n}\n\nwaza pack(op: int64, interest: int64, token: int64) -> int64 {\n    kaesu op + interest * 256 + token * 65536;\n}\n\nwaza decode(bytes: []uint8, offset: int64) -> int64 {\n    kaku result = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 8) {\n        result = result + int64(bytes[offset + index]) * factor;\n        index = index + 1;\n        moshi (index < 8) { factor = factor * 256; }\n    }\n    kaesu result;\n}\n\nwaza release(handle: resource) -> unit {\n    kaku status: []uint8 = [0];\n    socket.close(handle, status);\n}\n\n// A target has a reactor backend iff it rejects an invalid kind as an invalid argument; the fail-closed stubs of the other\n// targets report a generic error for every call.\nwaza has_backend() -> bool {\n    kaku status: []uint8 = [0];\n    kaku probe = socket.reactor_open(7);\n    socket.status(probe, status);\n    kaku code = status[0];\n    release(probe);\n    kaesu code == uint8(1);\n}\n\n// open creates the epoll instance and the wake-up eventfd. On targets without a backend it fails with Unsupported.\nkoukai waza open() -> OpenResult {\n    kaku status: []uint8 = [0];\n    kaku poll_handle = socket.reactor_open(0);\n    kaku message = socket.status(poll_handle, status);\n    kaku failure = error_from(status[0], message);\n    moshi (failure != mu) {\n        release(poll_handle);\n        moshi (!has_backend()) { kaesu OpenResult { reactor: mu, error: ReactorError.Unsupported() }; }\n        kaesu OpenResult { reactor: mu, error: failure };\n    }\n    kaku wake_handle = socket.reactor_open(1);\n    message = socket.status(wake_handle, status);\n    failure = error_from(status[0], message);\n    moshi (failure != mu) {\n        release(poll_handle);\n        release(wake_handle);\n        kaesu OpenResult {\n            reactor: mu, error: failure };\n    }\n    message = socket.reactor_ctl(poll_handle, wake_handle, pack(1, readable, 0), status);\n    failure = error_from(status[0], message);\n    moshi (failure != mu) {\n        release(poll_handle);\n        release(wake_handle);\n        kaesu OpenResult {\n            reactor: mu, error: failure };\n    }\n    kaku generations: []int64 = [];\n    kaku active: []bool = [];\n    kaku free: []int64 = [];\n    kaku ids: []int64 = [];\n    kaku counter: []int64 = [0];\n    kaku handles: []Watched = [];\n    kaesu OpenResult {\n        reactor: Reactor {\n            poll_handle: poll_handle, wake_handle: wake_handle, generations: generations, active: active, free: free, ids: ids, counter: counter, handles: handles }, error: mu };\n}\n\n// An operation is live while its slot is active and both generation and id match.\nkoukai waza live(reactor: Reactor, operation: Operation) -> bool {\n    kaesu operation.slot >= 0 && operation.slot < len(reactor.generations)\n    && reactor.active[operation.slot] && reactor.generations[operation.slot] == operation.generation\n    && reactor.ids[operation.slot] == operation.id;\n}\n\n// current reports whether an Event returned by poll still belongs to a live operation (it may have been cancelled since).\nkoukai waza current(reactor: Reactor, event: Event) -> bool {\n    kaesu live(reactor, Operation { id: event.operation, slot: event.slot, generation: event.generation });\n}\n\nwaza take_slot(reactor: Reactor, handle: resource) -> int64 {\n    kaku count = len(reactor.free);\n    moshi (count > 0) {\n        kaku slot = reactor.free[count - 1];\n        array.truncate(reactor.free, count - 1);\n        reactor.active[slot] = hai;\n        reactor.handles[slot] = Watched { handle: handle };\n        kaesu slot;\n    }\n    kaku slot = len(reactor.generations);\n    moshi (slot >= slot_limit) { kaesu -1; }\n    array.push(reactor.generations, 1);\n    array.push(reactor.active, hai);\n    array.push(reactor.ids, 0);\n    array.push(reactor.handles, Watched { handle: handle });\n    kaesu slot;\n}\n\n// Frees the slot for reuse and invalidates every Operation and in-flight kernel event of the old generation.\nwaza release_slot(reactor: Reactor, slot: int64) -> unit {\n    reactor.active[slot] = iie;\n    reactor.generations[slot] = reactor.generations[slot] + 1;\n    reactor.ids[slot] = 0;\n    reactor.handles[slot] = Watched { handle: reactor.poll_handle };\n    array.push(reactor.free, slot);\n}\n\nwaza token_of(operation: Operation) -> int64 {\n    kaesu operation.generation * slot_limit + operation.slot + 1;\n}\n\nwaza control(reactor: Reactor, handle: resource, op: int64, interest: int64, token: int64) -> ReactorError? {\n    kaku status: []uint8 = [0];\n    kaku message = socket.reactor_ctl(reactor.poll_handle, handle, pack(op, interest, token), status);\n    kaesu error_from(status[0], message);\n}\n\n// submit watches a socket handle for interest: readable = 1, writable = 2, or 3.\n// A reactor allows one live subscription per socket, with both interests on that operation.\n// A duplicate returns an error and leaves the existing operation and its interests intact.\nkoukai waza submit(reactor: Reactor, handle: resource, interest: int64) -> SubmitResult {\n    moshi (interest < 1 || interest > 3) {\n        kaesu SubmitResult { operation: mu, error: ReactorError.InvalidArgument() };\n    }\n    kaku slot = take_slot(reactor, handle);\n    moshi (slot < 0) { kaesu SubmitResult { operation: mu, error: ReactorError.Exhausted() }; }\n    reactor.counter[0] = reactor.counter[0] + 1;\n    reactor.ids[slot] = reactor.counter[0];\n    kaku operation = Operation { id: reactor.counter[0], slot: slot, generation: reactor.generations[slot] };\n    kaku failure = control(reactor, handle, 1, interest, token_of(operation));\n    moshi (failure != mu) {\n        release_slot(reactor, slot);\n        kaesu SubmitResult { operation: mu, error: failure };\n    }\n    kaesu SubmitResult { operation: operation, error: mu };\n}\n\n// Pass the handle originally submitted for this operation.\nkoukai waza update(reactor: Reactor, operation: Operation, handle: resource, interest: int64) -> UnitResult {\n    moshi (interest < 1 || interest > 3) { kaesu UnitResult { error: ReactorError.InvalidArgument() }; }\n    moshi (!live(reactor, operation)) { kaesu UnitResult { error: ReactorError.Closed() }; }\n    kaesu UnitResult { error: control(reactor, handle, 3, interest, token_of(operation)) };\n}\n\n// Pass the handle originally submitted for this operation. A socket that was already closed is not an error.\n// cancel releases the slot whatever happens to the kernel registration.\n// A cancelled or stale Operation reports Closed and never affects the slot's new owner.\nkoukai waza cancel(reactor: Reactor, operation: Operation, handle: resource) -> UnitResult {\n    moshi (!live(reactor, operation)) { kaesu UnitResult { error: ReactorError.Closed() }; }\n    kaku failure = control(reactor, handle, 2, 0, 0);\n    release_slot(reactor, operation.slot);\n    moshi (failure != mu) {\n        awase (failure) {\n            baai Closed { kaesu UnitResult { error: mu }; }\n            baai InvalidArgument { kaesu UnitResult { error: failure }; }\n            baai Exhausted { kaesu UnitResult { error: failure }; }\n            baai Unsupported { kaesu UnitResult { error: failure }; }\n            baai Other(message) { kaesu UnitResult { error: failure }; }\n        }\n    }\n    kaesu UnitResult { error: mu };\n}\n\n// poll blocks for at most timeout_ms (-1: until an event or a wake, 0: no wait) and returns up to max ready events.\nkoukai waza poll(reactor: Reactor, timeout_ms: int64, max: int64) -> PollResult {\n    kaku none: []Event = [];\n    moshi (max < 1 || max > max_events || timeout_ms < -1) {\n        kaesu PollResult { events: none, woken: iie, stale: 0, error: ReactorError.InvalidArgument() };\n    }\n    kaku buffer = array.make[uint8](16 * max, uint8(0));\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = socket.reactor_wait(reactor.poll_handle, buffer, max, timeout_ms, status);\n    kaku failure = error_from(status[9], message);\n    moshi (failure != mu) { kaesu PollResult { events: none, woken: iie, stale: 0, error: failure }; }\n    kaku count = decode(status, 0);\n    kaku events: []Event = [];\n    kaku woken = iie;\n    kaku stale = 0;\n    kaku index = 0;\n    aida (index < count) {\n        kaku token = decode(buffer, 16 * index);\n        kaku mask = decode(buffer, 16 * index + 8);\n        moshi (token == 0) {\n            woken = hai;\n        }\n        moshi (token != 0) {\n            kaku value = token - 1;\n            kaku generation = value / slot_limit;\n            kaku slot = value - generation * slot_limit;\n            moshi (slot >= len(reactor.generations)) { stale = stale + 1; }\n            moshi (slot < len(reactor.generations)) {\n                kaku operation = Operation { id: reactor.ids[slot], slot: slot, generation: generation };\n                moshi (!live(reactor, operation)) { stale = stale + 1; }\n                moshi (live(reactor, operation)) {\n                    array.push(events, Event { operation: operation.id, slot: slot, generation: generation, readable: mask - (mask / 2) * 2 == 1,\n                            writable: (mask / 2) - (mask / 4) * 2 == 1, error: (mask / 4) - (mask / 8) * 2 == 1, hangup: (mask / 8) - (mask / 16) * 2 == 1 });\n                }\n            }\n        }\n        index = index + 1;\n    }\n    moshi (woken) {\n        kaku ack: []uint8 = [0];\n        socket.reactor_ack(reactor.wake_handle, ack);\n    }\n    kaesu PollResult { events: events, woken: woken, stale: stale, error: mu };\n}\n\n// wake interrupts a poll (now or the next one). Safe to call repeatedly and from another thread; wakes coalesce.\nkoukai waza wake(reactor: Reactor) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = socket.reactor_signal(reactor.wake_handle, status);\n    kaesu UnitResult { error: error_from(status[0], message) };\n}\n\nkoukai waza close(reactor: Reactor) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = socket.close(reactor.poll_handle, status);\n    kaku failure = error_from(status[0], message);\n    release(reactor.wake_handle);\n    kaku slot = 0;\n    aida (slot < len(reactor.generations)) {\n        moshi (reactor.active[slot]) {\n            reactor.active[slot] = iie;\n            reactor.generations[slot] = reactor.generations[slot] + 1;\n            reactor.ids[slot] = 0;\n            reactor.handles[slot] = Watched {\n                handle: reactor.poll_handle };\n        }\n        slot = slot + 1;\n    }\n    kaesu UnitResult { error: failure };\n}\n" }; }
waza data_97() -> File { kaesu File { path: "kiso/regexp/regexp.mio", version: "Bunko-v2.1.1", length: 35055, sha256: "aeca79cc35cf833a8d3be0683f232bd170370e85bff50a12d87f87f3f9bb58bf", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\nyobu \"kiso/utf8\";\nyobu \"kiso/regexp/unicode_data\";\n\n// Thompson NFA 布尔正则匹配器：无回溯解释器，也不依赖宿主正则引擎，线性时间保证。\n// Unicode 15 字符属性与简单大小写折叠直接查表使用预生成的 Mio 区间表（unicode_data）。\nkoukai kata State {\n    op: int64;\n    out: int64;\n    other: int64;\n    ranges: []int64;\n}\nkoukai kata Program {\n    states: []State;\n    start: int64;\n    error: string;\n}\nkata Node {\n    op: int64;\n    a: int64;\n    b: int64;\n    low: int64;\n    high: int64;\n    ranges: []int64;\n}\nkata Parser {\n    input: []int64;\n    at: []int64;\n    flags: []int64;\n    quoted: []bool;\n    nodes: []Node;\n    heights: []int64;\n    folds: []int64;\n    error: []string;\n}\nkata Term {\n    ranges: []int64;\n    scalar: int64;\n}\nkata Fragment {\n    start: int64;\n    ends: []int64;\n}\nkata Count {\n    valid: bool;\n    low: int64;\n    high: int64;\n    end: int64;\n}\nkata Frame {\n    items: []int64;\n    alternatives: []int64;\n    flags: int64;\n    capture: bool;\n}\n\nwaza runes(text: string) -> []int64 {\n    kaku bytes = string.to_bytes(text);\n    kaku output: []int64 = [];\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        kaku decoded = utf8.decode_one(bytes, at);\n        moshi (!decoded.valid) {\n            kaesu [];\n        }\n        array.push(output, int64(decoded.value));\n        at = at + decoded.width;\n    }\n    kaesu output;\n}\nwaza current(p: Parser) -> int64 {\n    moshi (p.at[0] >= len(p.input)) {\n        kaesu -1;\n    }\n    kaesu p.input[p.at[0]];\n}\nwaza look(p: Parser, distance: int64) -> int64 {\n    moshi (p.at[0] + distance >= len(p.input)) {\n        kaesu -1;\n    }\n    kaesu p.input[p.at[0] + distance];\n}\nwaza fail(p: Parser, error: string) -> unit { moshi (p.error[0] == \"\") { p.error[0] = error; } }\nwaza flag(flags: int64, power: int64) -> bool {\n    kaku value = flags / power;\n    kaesu value - (value / 2) * 2 == 1;\n}\nwaza quotes(p: Parser) -> unit {\n    kaku changed = hai;\n    aida (changed) {\n        changed = iie;\n        moshi (current(p) == 92 && ((!p.quoted[0] && look(p, 1) == 81) || (p.quoted[0] && look(p, 1) == 69))) {\n            p.quoted[0] = !p.quoted[0];\n            p.at[0] = p.at[0] + 2;\n            changed = hai;\n        }\n    }\n}\nwaza node(p: Parser, op: int64, a: int64, b: int64, low: int64, high: int64, ranges: []int64) -> int64 {\n    moshi (len(p.nodes) >= 3355443) {\n        fail(p, \"regexp syntax size limit\");\n        kaesu -1;\n    }\n    kaku height = 1;\n    moshi ((op == 11 || op == 12 || op == 13 || op == 14) && a >= 0) { height = p.heights[a] + 1; }\n    moshi ((op == 11 || op == 12) && b >= 0) { moshi (height < p.heights[b] + 1) { height = p.heights[b] + 1; } }\n    moshi (height > 1000) {\n        fail(p, \"regexp tree nesting limit\");\n        kaesu -1;\n    }\n    array.push(p.heights, height);\n    kaku id = len(p.nodes);\n    array.push(p.nodes, Node {\n            op: op, a: a, b: b, low: low, high: high, ranges: ranges });\n    kaesu id;\n}\nwaza clean(ranges: []int64) -> []int64 {\n    kaku sorted: []int64 = [];\n    kaku at = 0;\n    aida (at < len(ranges)) {\n        kaku low = ranges[at];\n        kaku high = ranges[at + 1];\n        array.push(sorted, low);\n        array.push(sorted, high);\n        kaku i = len(sorted) - 2;\n        aida (i > 0 && sorted[i] < sorted[i - 2]) {\n            kaku a = sorted[i - 2];\n            kaku b = sorted[i - 1];\n            sorted[i - 2] = sorted[i];\n            sorted[i - 1] = sorted[i + 1];\n            sorted[i] = a;\n            sorted[i + 1] = b;\n            i = i - 2;\n        }\n        at = at + 2;\n    }\n    kaku result: []int64 = [];\n    at = 0;\n    aida (at < len(sorted)) {\n        moshi (len(result) > 0 && sorted[at] <= result[len(result) - 1] + 1) {\n            moshi (sorted[at + 1] > result[len(result) - 1]) {\n                result[len(result) - 1] = sorted[at + 1];\n            }\n        }\n        sore {\n            array.push(result, sorted[at]);\n            array.push(result, sorted[at + 1]);\n        }\n        at = at + 2;\n    }\n    kaesu result;\n}\nwaza contains(ranges: []int64, value: int64) -> bool {\n    kaku low = 0;\n    kaku high = len(ranges) / 2;\n    aida (low < high) {\n        kaku mid = low + (high - low) / 2;\n        moshi (value < ranges[mid * 2]) {\n            high = mid;\n        } sore {\n            moshi (value > ranges[mid * 2 + 1]) {\n                low = mid + 1;\n            } sore {\n                kaesu hai;\n            }\n        }\n    }\n    kaesu iie;\n}\nwaza invert(ranges: []int64) -> []int64 {\n    kaku ordered = clean(ranges);\n    kaku output: []int64 = [];\n    kaku next = 0;\n    kaku at = 0;\n    aida (at < len(ordered)) {\n        moshi (next < ordered[at]) {\n            array.push(output, next);\n            array.push(output, ordered[at] - 1);\n        }\n        next = ordered[at + 1] + 1;\n        at = at + 2;\n    }\n    moshi (next <= 1114111) {\n        array.push(output, next);\n        array.push(output, 1114111);\n    }\n    kaesu output;\n}\nwaza folded(p: Parser, ranges: []int64) -> []int64 {\n    moshi (!flag(p.flags[0], 1)) { kaesu ranges; }\n    moshi (len(p.folds) == 0) { array.append_all(p.folds, unicode_data.lookup(\"fold\")); }\n    kaku result = clean(ranges);\n    kaku pass = 0;\n    kaku changed = hai;\n    aida (changed && pass < 4) {\n        changed = iie;\n        kaku next = array.clone(result);\n        kaku at = 0;\n        aida (at < len(p.folds)) {\n            moshi (contains(result, p.folds[at]) && !contains(result, p.folds[at + 1])) {\n                array.push(next, p.folds[at + 1]);\n                array.push(next, p.folds[at + 1]);\n                changed = hai;\n            }\n            at = at + 2;\n        }\n        result = clean(next);\n        pass = pass + 1;\n    }\n    kaesu result;\n}\nwaza unicode_name(value: []int64) -> string {\n    kaku bytes: []uint8 = [];\n    kaku at = 0;\n    aida (at < len(value)) { kaku byte = value[at];\n        moshi (byte != 95 && byte != 45 && byte != 32) {\n            moshi (byte >= 65 && byte <= 90) {\n                byte = byte + 32;\n            }\n            moshi (byte < 0 || byte > 127) {\n                kaesu \"\";\n            }\n            array.push(bytes, uint8(byte));\n        }\n        at = at + 1;\n    }\n    kaku decoded = string.from_utf8(bytes);\n    moshi (decoded == mu) {\n        kaesu \"\";\n    }\n    kaesu decoded;\n}\nwaza unicode_class(p: Parser, negative: bool) -> Term {\n    kaku name: []int64 = [];\n    kaku inverse = negative;\n    moshi (current(p) == 123) {\n        p.at[0] = p.at[0] + 1;\n        moshi (current(p) == 94) {\n            inverse = !inverse;\n            p.at[0] = p.at[0] + 1;\n        }\n        aida (current(p) >= 0 && current(p) != 125) {\n            array.push(name, current(p));\n            p.at[0] = p.at[0] + 1;\n        }\n        moshi (current(p) != 125) {\n            fail(p, \"unterminated Unicode class\");\n        } sore {\n            p.at[0] = p.at[0] + 1;\n        }\n    } sore {\n        moshi (current(p) >= 0) {\n            array.push(name, current(p));\n            p.at[0] = p.at[0] + 1;\n        }\n    }\n    kaku key = unicode_name(name);\n    kaku ranges: []int64 = [];\n    moshi (key == \"any\") { ranges = [0, 1114111]; }\n    sore { moshi (key == \"ascii\") { ranges = [0, 127]; }\n        sore {\n            moshi (key == \"assigned\") {\n                key = \"cn\";\n                inverse = !inverse;\n            }\n            kaku triples = unicode_data.lookup(key);\n            moshi (len(triples) == 0) {\n                fail(p, \"invalid Unicode character class\");\n                kaesu Term {\n                    ranges: [], scalar: -1 };\n            }\n            kaku at = 0;\n            aida (at < len(triples)) {\n                kaku low = triples[at];\n                kaku high = triples[at + 1];\n                kaku stride = triples[at + 2];\n                moshi (stride == 1) {\n                    array.push(ranges, low);\n                    array.push(ranges, high);\n                }\n                sore {\n                    aida (low <= high) {\n                        array.push(ranges, low);\n                        array.push(ranges, low);\n                        low = low + stride;\n                    }\n                }\n                at = at + 3;\n            }\n        } }\n    ranges = folded(p, ranges);\n    moshi (inverse) {\n        ranges = invert(ranges);\n    }\n    kaesu Term { ranges: ranges, scalar: -1 };\n}\nwaza ascii(name: string) -> []int64 {\n    moshi (name == \"alnum\") { kaesu [48, 57, 65, 90, 97, 122]; }\n    moshi (name == \"alpha\") { kaesu [65, 90, 97, 122]; }\n    moshi (name == \"ascii\") { kaesu [0, 127]; }\n    moshi (name == \"blank\") { kaesu [9, 9, 32, 32]; }\n    moshi (name == \"cntrl\") { kaesu [0, 31, 127, 127]; }\n    moshi (name == \"digit\") { kaesu [48, 57]; }\n    moshi (name == \"graph\") { kaesu [33, 126]; }\n    moshi (name == \"lower\") { kaesu [97, 122]; }\n    moshi (name == \"print\") { kaesu [32, 126]; }\n    moshi (name == \"punct\") { kaesu [33, 47, 58, 64, 91, 96, 123, 126]; }\n    moshi (name == \"space\") { kaesu [9, 13, 32, 32]; }\n    moshi (name == \"upper\") { kaesu [65, 90]; }\n    moshi (name == \"word\") { kaesu [48, 57, 65, 90, 95, 95, 97, 122]; }\n    moshi (name == \"xdigit\") {\n        kaesu [48, 57, 65, 70, 97, 102];\n    }\n    kaesu [];\n}\nwaza is_digit(value: int64) -> bool { kaesu value >= 48 && value <= 57; }\nwaza hex(value: int64) -> int64 {\n    moshi (is_digit(value)) {\n        kaesu value - 48;\n    }\n    moshi (value >= 65 && value <= 70) {\n        kaesu value - 55;\n    }\n    moshi (value >= 97 && value <= 102) {\n        kaesu value - 87;\n    }\n    kaesu -1;\n}\nwaza escaped(p: Parser) -> Term {\n    p.at[0] = p.at[0] + 1;\n    kaku value = current(p);\n    p.at[0] = p.at[0] + 1;\n    kaku name = \"\";\n    kaku negative = iie;\n    moshi (value == 100 || value == 68) {\n        name = \"digit\";\n        negative = value == 68;\n    }\n    moshi (value == 119 || value == 87) {\n        name = \"word\";\n        negative = value == 87;\n    }\n    moshi (value == 115 || value == 83) {\n        name = \"space\";\n        negative = value == 83;\n    }\n    moshi (name != \"\") {\n        kaku ranges = ascii(name);\n        moshi (name == \"space\") {\n            ranges = [9, 10, 12, 13, 32, 32];\n        }\n        ranges = folded(p, ranges);\n        moshi (negative) {\n            ranges = invert(ranges);\n        }\n        kaesu Term { ranges: ranges, scalar: -1 };\n    }\n    moshi (value == 112 || value == 80) { kaesu unicode_class(p, value == 80); }\n    moshi (value == 97) { value = 7; }\n    sore { moshi (value == 102) { value = 12; }\n        sore { moshi (value == 110) { value = 10; }\n            sore { moshi (value == 114) { value = 13; }\n                sore { moshi (value == 116) { value = 9; }\n                    sore { moshi (value == 118) { value = 11; }\n                        sore { moshi (value >= 48 && value <= 55) {\n                                moshi (value != 48 && (current(p) < 48 || current(p) > 55)) { fail(p, \"backreferences are not supported\"); }\n                                value = value - 48;\n                                kaku at = 1;\n                                aida (at < 3 && current(p) >= 48 && current(p) <= 55) {\n                                    value = value * 8 + current(p) - 48;\n                                    p.at[0] = p.at[0] + 1;\n                                    at = at + 1;\n                                }\n                            }\n                            sore { moshi (value == 120) {\n                                    value = 0;\n                                    kaku count = 0;\n                                    kaku braced = current(p) == 123;\n                                    moshi (braced) {\n                                        p.at[0] = p.at[0] + 1;\n                                    }\n                                    aida (hex(current(p)) >= 0 && (braced || count < 2)) {\n                                        value = value * 16 + hex(current(p));\n                                        p.at[0] = p.at[0] + 1;\n                                        count = count + 1;\n                                        moshi (value > 1114111) {\n                                            fail(p, \"hex escape exceeds Unicode range\");\n                                            nukeru;\n                                        }\n                                    }\n                                    moshi ((!braced && count != 2) || (braced && (count == 0 || current(p) != 125))) { fail(p, \"invalid hex escape\"); }\n                                    moshi (braced && current(p) == 125) { p.at[0] = p.at[0] + 1; }\n                                }\n                                sore {\n                                    moshi (value < 0 || value >= 128 || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || is_digit(value)) {\n                                        fail(p, \"invalid regexp escape\");\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n    kaesu Term { ranges: [value, value], scalar: value };\n}\nwaza balanced(p: Parser, items: []int64, op: int64) -> int64 {\n    moshi (len(items) == 0) { kaesu node(p, 0, -1, -1, 0, 0, []); }\n    kaku work = items;\n    aida (len(work) > 1) {\n        kaku next: []int64 = [];\n        kaku at = 0;\n        aida (at < len(work)) {\n            kaku id = work[at];\n            moshi (at + 1 < len(work)) {\n                id = node(p, op, id, work[at + 1], 0, 0, []);\n            }\n            array.push(next, id);\n            at = at + 2;\n        }\n        work = next;\n    }\n    kaesu work[0];\n}\nwaza bracket(p: Parser) -> int64 {\n    p.at[0] = p.at[0] + 1;\n    kaku negative = current(p) == 94;\n    moshi (negative) {\n        p.at[0] = p.at[0] + 1;\n    }\n    kaku ranges: []int64 = [];\n    kaku first = hai;\n    aida (p.error[0] == \"\" && (current(p) != 93 || first)) {\n        moshi (current(p) < 0) {\n            fail(p, \"unterminated character class\");\n            nukeru;\n        }\n        first = iie;\n        moshi (current(p) == 91 && look(p, 1) == 58) {\n            kaku end = p.at[0] + 2;\n            aida (end + 1 < len(p.input) && !(p.input[end] == 58 && p.input[end + 1] == 93)) { end = end + 1; }\n            moshi (end + 1 < len(p.input)) {\n                kaku bytes: []uint8 = [];\n                kaku at = p.at[0] + 2;\n                kaku neg = iie;\n                moshi (p.input[at] == 94) {\n                    neg = hai;\n                    at = at + 1;\n                }\n                aida (at < end) {\n                    utf8.append_rune(bytes, rune(p.input[at]));\n                    at = at + 1;\n                }\n                kaku text = string.from_utf8(bytes);\n                kaku named: []int64 = [];\n                moshi (text != mu) {\n                    named = ascii(text);\n                }\n                moshi (len(named) == 0) {\n                    fail(p, \"invalid ASCII character class\");\n                    nukeru;\n                }\n                named = folded(p, named);\n                moshi (neg) {\n                    named = invert(named);\n                }\n                array.append_all(ranges, named);\n                p.at[0] = end + 2;\n                tsuzuku;\n            }\n        }\n        kaku term = Term { ranges: [], scalar: -1 };\n        moshi (current(p) == 92) { term = escaped(p); }\n        sore {\n            kaku value = current(p);\n            p.at[0] = p.at[0] + 1;\n            term = Term {\n                ranges: [value, value], scalar: value };\n        }\n        moshi (term.scalar < 0) {\n            array.append_all(ranges, term.ranges);\n            tsuzuku;\n        }\n        kaku low = term.scalar;\n        kaku high = low;\n        moshi (current(p) == 45 && look(p, 1) != 93 && look(p, 1) >= 0) {\n            p.at[0] = p.at[0] + 1;\n            moshi (current(p) == 92) {\n                kaku last = escaped(p);\n                high = last.scalar;\n            }\n            sore {\n                high = current(p);\n                p.at[0] = p.at[0] + 1;\n            }\n            moshi (high < low) {\n                fail(p, \"invalid character range\");\n                nukeru;\n            }\n        }\n        array.append_all(ranges, folded(p, [low, high]));\n    }\n    moshi (current(p) != 93) {\n        fail(p, \"unterminated character class\");\n    } sore {\n        p.at[0] = p.at[0] + 1;\n    }\n    ranges = clean(ranges);\n    moshi (negative) {\n        ranges = invert(ranges);\n    }\n    kaesu node(p, 1, -1, -1, 0, 0, ranges);\n}\nwaza group_header(p: Parser) -> int64 {\n    kaku capturing = hai;\n    p.at[0] = p.at[0] + 1;\n    moshi (current(p) == 63) {\n        capturing = iie;\n        p.at[0] = p.at[0] + 1;\n        moshi (current(p) == 80 && look(p, 1) == 60) { p.at[0] = p.at[0] + 1; }\n        moshi (current(p) == 60) {\n            capturing = hai;\n            p.at[0] = p.at[0] + 1;\n            kaku count = 0;\n            aida (current(p) != 62 && current(p) >= 0) {\n                kaku value = current(p);\n                moshi (!(is_digit(value) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95)) {\n                    fail(p, \"invalid capture name\");\n                    nukeru;\n                }\n                p.at[0] = p.at[0] + 1;\n                count = count + 1;\n            }\n            moshi (count == 0 || current(p) != 62) {\n                fail(p, \"invalid capture name\");\n            } sore {\n                p.at[0] = p.at[0] + 1;\n            }\n        }\n        sore {\n            kaku clear = iie;\n            kaku count = 0;\n            kaku hyphen = iie;\n            kaku cleared = 0;\n            aida (current(p) != 58 && current(p) != 41 && p.error[0] == \"\") {\n                kaku value = current(p);\n                moshi (value == 45 && !hyphen) {\n                    clear = hai;\n                    hyphen = hai;\n                    p.at[0] = p.at[0] + 1;\n                    tsuzuku;\n                }\n                kaku power = 0;\n                moshi (value == 105) {\n                    power = 1;\n                }\n                moshi (value == 109) {\n                    power = 2;\n                }\n                moshi (value == 115) {\n                    power = 4;\n                }\n                moshi (value == 85) {\n                    power = 8;\n                }\n                moshi (power == 0) {\n                    fail(p, \"invalid regexp group or flags\");\n                    nukeru;\n                }\n                moshi (flag(p.flags[0], power) != !clear) {\n                    moshi (clear) {\n                        p.flags[0] = p.flags[0] - power;\n                    } sore {\n                        p.flags[0] = p.flags[0] + power;\n                    }\n                }\n                p.at[0] = p.at[0] + 1;\n                count = count + 1;\n                moshi (clear) {\n                    cleared = cleared + 1;\n                }\n            }\n            moshi (hyphen && cleared == 0) { fail(p, \"invalid regexp flags after hyphen\"); }\n            moshi (current(p) == 41 && count > 0) {\n                p.at[0] = p.at[0] + 1;\n                kaesu -2;\n            }\n            moshi (current(p) != 58) {\n                fail(p, \"invalid regexp group\");\n            } sore {\n                p.at[0] = p.at[0] + 1;\n            }\n        }\n    }\n    moshi (capturing) {\n        kaesu 1;\n    }\n    kaesu 0;\n}\nwaza atom(p: Parser) -> int64 {\n    quotes(p);\n    kaku value = current(p);\n    moshi (!p.quoted[0] && value == 123) {\n        kaku count = repetition_count(p);\n        moshi (count.valid) {\n            fail(p, \"repetition has no operand\");\n            kaesu -1;\n        }\n    }\n    moshi (p.quoted[0]) {\n        p.at[0] = p.at[0] + 1;\n        kaesu node(p, 1, -1, -1, 0, 0, folded(p, [value, value]));\n    }\n    moshi (value == 91) { kaesu bracket(p); }\n    p.at[0] = p.at[0] + 1;\n    moshi (value == 46) {\n        kaku op = 2;\n        moshi (flag(p.flags[0], 4)) {\n            op = 3;\n        }\n        kaesu node(p, op, -1, -1, 0, 0, []);\n    }\n    moshi (value == 94 || value == 36) {\n        kaku op = 5;\n        moshi (value == 36) {\n            op = 6;\n        }\n        moshi (flag(p.flags[0], 2)) {\n            op = op + 2;\n        }\n        kaesu node(p, op, -1, -1, 0, 0, []);\n    }\n    moshi (value == 92) {\n        kaku escaped_value = current(p);\n        moshi (escaped_value == 65 || escaped_value == 122 || escaped_value == 98 || escaped_value == 66) {\n            p.at[0] = p.at[0] + 1;\n            kaku op = 5;\n            moshi (escaped_value == 122) {\n                op = 6;\n            }\n            moshi (escaped_value == 98) {\n                op = 9;\n            }\n            moshi (escaped_value == 66) {\n                op = 10;\n            }\n            kaesu node(p, op, -1, -1, 0, 0, []);\n        }\n        p.at[0] = p.at[0] - 1;\n        kaku term = escaped(p);\n        kaku ranges = term.ranges;\n        moshi (term.scalar >= 0) { ranges = folded(p, ranges); }\n        kaesu node(p, 1, -1, -1, 0, 0, ranges);\n    }\n    moshi (value < 0 || value == 42 || value == 43 || value == 63) {\n        fail(p, \"repetition has no operand\");\n        kaesu -1;\n    }\n    kaesu node(p, 1, -1, -1, 0, 0, folded(p, [value, value]));\n}\n// A malformed count is a literal brace, including multi-digit leading zeros.\nwaza repetition_count(p: Parser) -> Count {\n    kaku bad = Count { valid: iie, low: -1, high: -1, end: p.at[0] };\n    moshi (current(p) != 123) { kaesu bad; }\n    kaku at = p.at[0] + 1;\n    kaku low = 0;\n    kaku high = -1;\n    moshi (at >= len(p.input)) { kaesu bad; }\n    moshi (!is_digit(p.input[at])) { kaesu bad; }\n    moshi (p.input[at] == 48 && at + 1 < len(p.input)) { moshi (is_digit(p.input[at + 1])) { kaesu bad; } }\n    aida (at < len(p.input)) {\n        moshi (!is_digit(p.input[at])) {\n            nukeru;\n        }\n        moshi (low < 100000) {\n            low = low * 10 + p.input[at] - 48;\n        }\n        at = at + 1;\n    }\n    high = low;\n    moshi (at < len(p.input)) { moshi (p.input[at] == 44) {\n            at = at + 1;\n            high = -1;\n            moshi (at < len(p.input)) { moshi (is_digit(p.input[at])) {\n                    moshi (p.input[at] == 48 && at + 1 < len(p.input)) { moshi (is_digit(p.input[at + 1])) { kaesu bad; } }\n                    high = 0;\n                    aida (at < len(p.input)) {\n                        moshi (!is_digit(p.input[at])) {\n                            nukeru;\n                        }\n                        moshi (high < 100000) {\n                            high = high * 10 + p.input[at] - 48;\n                        }\n                        at = at + 1;\n                    }\n                } }\n        } }\n    moshi (at >= len(p.input)) { kaesu bad; }\n    moshi (p.input[at] != 125) { kaesu bad; }\n    kaesu Count { valid: hai, low: low, high: high, end: at + 1 };\n}\nwaza repeat_valid(p: Parser, root: int64) -> bool {\n    kaku nodes: []int64 = [root];\n    kaku limits: []int64 = [1000];\n    aida (len(nodes) > 0) {\n        kaku last = len(nodes) - 1;\n        kaku id = nodes[last];\n        kaku limit = limits[last];\n        array.truncate(nodes, last);\n        array.truncate(limits, last);\n        kaku item = p.nodes[id];\n        moshi (item.op == 13 && item.b == 1) {\n            kaku count = item.high;\n            moshi (count == 0) {\n                tsuzuku;\n            }\n            moshi (count < 0) {\n                count = item.low;\n            }\n            moshi (count > limit) {\n                kaesu iie;\n            }\n            moshi (count > 0) {\n                limit = limit / count;\n            }\n        }\n        moshi (item.op == 11 || item.op == 12 || item.op == 13 || item.op == 14) {\n            array.push(nodes, item.a);\n            array.push(limits, limit);\n        }\n        moshi (item.op == 11 || item.op == 12) {\n            array.push(nodes, item.b);\n            array.push(limits, limit);\n        }\n    }\n    kaesu hai;\n}\nwaza repetition(p: Parser, child: int64) -> int64 {\n    quotes(p);\n    moshi (p.quoted[0]) {\n        kaesu child;\n    }\n    kaku value = current(p);\n    kaku low = -1;\n    kaku high = -1;\n    kaku first = p.at[0];\n    moshi (value == 42) { low = 0; }\n    moshi (value == 43) { low = 1; }\n    moshi (value == 63) {\n        low = 0;\n        high = 1;\n    }\n    moshi (value == 42 || value == 43 || value == 63) { p.at[0] = p.at[0] + 1; }\n    sore { moshi (value == 123) {\n            kaku count = repetition_count(p);\n            moshi (count.valid) {\n                low = count.low;\n                high = count.high;\n                p.at[0] = count.end;\n                moshi (low > 1000 || high > 1000 || (high >= 0 && high < low)) { fail(p, \"invalid repetition count\"); }\n            }\n        } }\n    moshi (low < 0) { kaesu child; }\n    moshi (current(p) == 63) { p.at[0] = p.at[0] + 1; }\n    moshi (current(p) == 42 || current(p) == 43 || current(p) == 63) { fail(p, \"nested repetition operator\"); }\n    moshi (current(p) == 123) {\n        kaku count = repetition_count(p);\n        moshi (count.valid) {\n            fail(p, \"nested repetition operator\");\n        }\n    }\n    kaku counted = 0;\n    moshi (value == 123) {\n        counted = 1;\n    }\n    kaku result = node(p, 13, child, counted, low, high, []);\n    moshi (result >= 0 && counted == 1 && (low >= 2 || high >= 2)) {\n        moshi (!repeat_valid(p, result)) {\n            fail(p, \"invalid nested repetition count\");\n        }\n    }\n    kaesu result;\n}\n// Explicit parse frames preserve scoped flags without consuming the native\n// call stack for nested parentheses. Concatenation and alternation stay balanced.\nwaza parse_expression(p: Parser) -> int64 {\n    kaku frames: []Frame = [Frame { items: [], alternatives: [], flags: p.flags[0], capture: iie }];\n    aida (p.error[0] == \"\") {\n        quotes(p);\n        kaku value = current(p);\n        kaku index = len(frames) - 1;\n        kaku frame = frames[index];\n        moshi (value < 0) {\n            moshi (len(frames) != 1) {\n                fail(p, \"missing closing parenthesis\");\n                kaesu -1;\n            }\n            array.push(frame.alternatives, balanced(p, frame.items, 11));\n            kaesu balanced(p, frame.alternatives, 12);\n        }\n        moshi (!p.quoted[0] && value == 124) {\n            array.push(frame.alternatives, balanced(p, frame.items, 11));\n            frames[index] = Frame {\n                items: [], alternatives: frame.alternatives, flags: frame.flags, capture: frame.capture };\n            p.at[0] = p.at[0] + 1;\n            tsuzuku;\n        }\n        moshi (!p.quoted[0] && value == 40) {\n            kaku saved = p.flags[0];\n            kaku header = group_header(p);\n            moshi (header == -2) {\n                tsuzuku;\n            }\n            array.push(frames,