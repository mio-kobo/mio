waza data_17() -> File { kaesu File { path: "kiso/aot/lower/observation.mio", version: "Bunko-v2.1.1", length: 10491, sha256: "c359c0ab678108c1d4e05cb9827ecf2a13d657a320386744176f67305352b772", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/string\";\nyobu \"kiso/convert\";\n\n// Observation metadata is outside the managed arena. M19b reserves 3072\n// bytes in both modes, including generation state and separate pause histograms.\n// All values are uint64 native words; no GC path allocates or writes stderr.\n// 288 objects, 296 physical allocation bytes, 304 occupied bytes, 312 peak,\n// 320 start counter, 328 last pause, 336 total pause, 344 max pause, 352 Hz,\n// 360..871 histogram, 872 before, 880 after, 888 cumulative reclaimed,\n// 896 current collection start. The runtime is currently single-threaded.\nteisu observation_metadata_bytes = 3072;\n\nwaza observation_word(code: arm64.Assembler, word: int64) -> unit {\n    emit(code, arm64.Instruction { word: uint32(word), error: mu });\n}\n\nwaza emit_observation_init(code: arm64.Assembler) -> unit {\n    observation_word(code, 3577471049); // MRS x9, CNTVCT_EL0 (0xd53be049)\n    emit(code, arm64.str_x(9, 23, 320));\n    observation_word(code, 3577470985); // MRS x9, CNTFRQ_EL0\n    emit(code, arm64.str_x(9, 23, 352));\n}\n\nwaza emit_observation_alloc(code: arm64.Assembler) -> unit {\n    arm64.assembler_cbz_x(code, 0, \"observation_alloc_done\");\n    // Read the actual block span: a reused block can contain unsplit padding.\n    emit(code, arm64.sub_imm_x(9, 0, 16, iie)); emit(code, arm64.ldr_x(9, 9, 8));\n    emit(code, arm64.add_imm_x(9, 9, 31, iie)); emit(code, arm64.movn_x(10, 15, 0)); emit(code, arm64.and_x(9, 9, 10));\n    emit(code, arm64.ldr_x(10, 23, 288)); emit(code, arm64.add_imm_x(10, 10, 1, iie)); emit(code, arm64.str_x(10, 23, 288));\n    emit(code, arm64.ldr_x(10, 23, 296)); emit(code, arm64.add_x(10, 10, 9)); emit(code, arm64.str_x(10, 23, 296));\n    emit(code, arm64.ldr_x(10, 23, 304)); emit(code, arm64.add_x(10, 10, 9)); emit(code, arm64.str_x(10, 23, 304));\n    emit(code, arm64.ldr_x(9, 23, 312)); emit(code, arm64.cmp_x(10, 9)); arm64.assembler_b_cond(code, 9, \"observation_alloc_done\");\n    emit(code, arm64.str_x(10, 23, 312));\n    arm64.assembler_label(code, \"observation_alloc_done\");\n}\n\nwaza emit_observation_gc_start(code: arm64.Assembler) -> unit {\n    emit(code, arm64.stp_pre_x(25, 26, 31, -16));\n    observation_word(code, 3577471049);\n    emit(code, arm64.str_x(9, 23, 896));\n    emit(code, arm64.ldr_x(9, 23, 304)); emit(code, arm64.str_x(9, 23, 872));\n    emit(code, arm64.movz_x(25, 0, 0));\n}\n\nwaza emit_observation_gc_end(code: arm64.Assembler) -> unit {\n    observation_word(code, 3577471049);\n    emit(code, arm64.ldr_x(10, 23, 896)); emit(code, arm64.sub_x(9, 9, 10));\n    emit(code, arm64.ldr_x(10, 23, gen_MajorTicks)); emit(code, arm64.add_x(10, 10, 9)); emit(code, arm64.str_x(10, 23, gen_MajorTicks));\n    emit(code, arm64.ldr_x(10, 23, gen_MajorMax)); emit(code, arm64.cmp_x(9, 10)); arm64.assembler_b_cond(code, 9, \"gen_major_kindmax\");\n    emit(code, arm64.str_x(9, 23, gen_MajorMax)); arm64.assembler_label(code, \"gen_major_kindmax\");\n    emit(code, arm64.str_x(9, 23, 328));\n    emit(code, arm64.ldr_x(10, 23, 336)); emit(code, arm64.add_x(10, 10, 9)); emit(code, arm64.str_x(10, 23, 336));\n    emit(code, arm64.ldr_x(10, 23, 344)); emit(code, arm64.cmp_x(9, 10)); arm64.assembler_b_cond(code, 9, \"observation_gc_max_done\");\n    emit(code, arm64.str_x(9, 23, 344));\n    arm64.assembler_label(code, \"observation_gc_max_done\");\n    // Bucket i has inclusive upper bound 2^i ticks. Bucket 63 also holds\n    // overflow. Zero and one tick use bucket 0; no samples are dropped.\n    emit(code, arm64.movz_x(11, 0, 0)); arm64.assembler_cbz_x(code, 9, \"observation_gc_bucket_done\");\n    emit(code, arm64.sub_imm_x(10, 9, 1, iie));\n    arm64.assembler_label(code, \"observation_gc_bucket\");\n    arm64.assembler_cbz_x(code, 10