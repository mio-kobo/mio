program(iie);array.append_all(functions,gc.safepoint_program(wr_snapshot_capacity));array.append_all(functions,gc.stopped_heap_program(wr_snapshot_capacity));array.append_all(functions,gc.mutator_program());array.append_all(functions,darwin.worker_platform_program());\n    moshi(old_mark_proto_enabled(c)){array.append_all(functions,gc.old_mark_program());functions=gc.old_heap_epoch_program(functions,8704,wr_stride);moshi(old_sweep_enabled(c)){functions=gc.concurrent_sweep_program(functions,8704,wr_stride);}}\n    kaku bindings=darwin.worker_bindings();array.push(bindings,ir.Binding {operation:gc.gc_visit_root_operation,slot:25,arguments:[0,1,2],result_bits:64});array.push(bindings,ir.Binding {operation:gc.gc_collect_stopped_operation,slot:26,arguments:[0,1,2],result_bits:64});array.push(bindings,ir.Binding {operation:gc.gc_allocate_stopped_operation,slot:27,arguments:[0,1,2,3],result_bits:64});\n    moshi(old_sweep_enabled(c)){array.push(bindings,ir.Binding {operation:gc.sweep_account_operation,slot:28,arguments:[0],result_bits:64});array.push(bindings,ir.Binding {operation:gc.sweep_unmap_operation,slot:29,arguments:[0,1],result_bits:64});}\n    emit_word_natives(c,p,first);\n    kaku error=aarch64.emit_program(c,functions,bindings,worker_import_slots(c),\"attached\");moshi(error!=\"\"){kaesu error;}\n    i=0;aida(i<len(callbacks)){kaku target=arm64.assembler_label_word(c,callbacks[i]);kaku ins=arm64.adr(9,(target-relocations[i])*4);moshi(ins.error!=mu){kaesu \"WORKER_CALLBACK_RANGE\";}c.words[relocations[i]]=ins.word;i=i+1;}\n    kaku target=arm64.assembler_label_word(c,\"worker_user_entry\");kaku entry=arm64.adr(9,(target-worker_address)*4);moshi(entry.error!=mu){kaesu \"WORKER_ENTRY_RANGE\";}c.words[worker_address]=entry.word;\n    kaesu \"\";\n}\n" }; }
waza data_36() -> File { kaesu File { path: "kiso/aot/lowerlinux/cabi_sysv.mio", version: "Bunko-v2.1.1", length: 9186, sha256: "679640c4c1300c24aec344ccf2dfc1496447c97f545cbaa57d53a00decaa8758", source: "yobu \"kiso/aot/cabi\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\n\n// Linux x86-64 的 C ABI 后端：System V AMD64 psABI，只覆盖 Mio → C 的定参标量调用。\n//\n// 与 Darwin ARM64 后端（kiso/aot/lower/cabi_darwin.mio）刻意分开，原因如下：\n//   * 整数参数寄存器是 RDI、RSI、RDX、RCX、R8、R9（6 个），而不是 x0–x7；\n//   * 浮点参数寄存器是 XMM0–XMM7（8 个），两个寄存器组独立耗尽；\n//   * 栈参数每个固定占 8 字节槽，不按类型大小紧凑排列（Darwin ARM64 按自然大小排列）；\n//   * 窄整数的扩展由调用者负责到至少 32 位，被调用者可以依赖；本后端总是扩展到完整 64 位；\n//   * 调用点（CALL 之前）RSP 必须 16 字节对齐，CALL 压入返回地址后被调用者入口处 RSP+8 对齐；\n//   * 返回值在 RAX（整数、指针、bool）或 XMM0（float、double）。\n// Mio 内部调用约定保持不变：参数由调用者压栈，返回值在 RAX，浮点以位模式存放在 64 位槽中。\n\n// 参数分类：System V 把标量归为 INTEGER（通用寄存器）或 SSE（XMM），寄存器用尽后转为 MEMORY（栈）。\nkoukai teisu class_integer = 0;\nkoukai teisu class_sse = 1;\nkoukai teisu class_memory = 2;\n\nkoukai kata Placement {\n    class: int64;\n    // INTEGER/SSE 为寄存器序号（INTEGER 按 RDI,RSI,RDX,RCX,R8,R9 排列），MEMORY 为栈槽序号（每槽 8 字节）。\n    index: int64;\n}\n\nkoukai kata Layout {\n    placements: []Placement;\n    gp_registers: int64;\n    sse_registers: int64;\n    stack_slots: int64;\n}\n\nkoukai waza integer_registers() -> []int64 {\n    kaesu [x86_64.rdi, x86_64.rsi, x86_64.rdx, x86_64.rcx, x86_64.r8, x86_64.r9];\n}\n\nkoukai waza is_sse(kind: int64) -> bool { kaesu kind == 105 || kind == 106; }\n\n// 两个寄存器组各自计数：整数参数耗尽 6 个寄存器后只有整数参数上栈，浮点参数仍可使用 XMM，反之亦然。\n// 栈槽按参数顺序分配，第一个栈参数位于调用点 RSP+0。\nkoukai waza classify(signature: cabi.Signature) -> Layout {\n    kaku placements: []Placement = [];\n    kaku gp = 0; kaku sse = 0; kaku stack = 0; kaku at = 0;\n    aida (at < len(signature.parameters)) {\n        kaku kind = signature.parameters[at];\n        moshi (is_sse(kind) && sse < 8) {\n            array.push(placements, Placement { class: class_sse, index: sse });\n            sse = sse + 1;\n        } sore { moshi (!is_sse(kind) && gp < 6) {\n            array.push(placements, Placement { class: class_integer, index: gp });\n            gp = gp + 1;\n        } sore {\n            array.push(placements, Placement { class: class_memory, index: stack });\n            stack = stack + 1;\n        } }\n        at = at + 1;\n    }\n    kaesu Layout { placements: placements, gp_registers: gp, sse_registers: sse, stack_slots: stack };\n}\n\n// 栈参数区大小：每个槽 8 字节，整体向上取整到 16 字节，保证 CALL 处 RSP 对齐。\nkoukai waza stack_bytes(layout: Layout) -> int64 {\n    kaesu ((layout.stack_slots * 8 + 15) / 16) * 16;\n}\n\n// 窄整数在 Mio 中的槽描述符（与 types.constrain_c_scalar 一致）：12/13/14 为有符号 8/16/32 位，15/16/17 为无符号。\n// 0 表示无需扩展（64 位整数、指针、浮点）。bool 按无符号 8 位处理。\nkoukai waza extension(kind: int64) -> int64 {\n    moshi (kind == 97) { kaesu 12; }\n    moshi (kind == 99) { kaesu 13; }\n    moshi (kind == 101) { kaesu 14; }\n    moshi (kind == 98 || kind == 108) { kaesu 15; }\n    moshi (kind == 100) { kaesu 16; }\n    moshi (kind == 102) { kaesu 17; }\n    kaesu 0;\n}\n\n// 把 reg 中的窄整数扩展到完整 64 位：有符号用算术右移，无符号用逻辑右移。\nwaza emit_extend(code: x86_64.Assembler, reg: int64, descriptor: int64) -> unit {\n    moshi (descriptor < 12 || descriptor > 17) { kaesu; }\n    kaku width = 8;\n    moshi (descriptor == 13 || descriptor == 16) { width = 16; }\n    moshi (descriptor == 14 || descriptor == 17) { width = 32; }\n    x86_64.shl_ri(code, reg, 64 - width);\n    moshi (descriptor <= 14) { x86_64.sar_ri(code, reg, 64 - width); }\n    moshi (descriptor > 14) { x86_64.shr_ri(code, reg, 64 - width); }\n}\n\n// Mio 外部函数的桥接体。进入时已有标准 Mio 帧（push rbp; mov rbp, rsp），参数位于\n// [rbp + local_disp(n, i)]。桥接体不是 GC 安全点：C 无法回调 Mio，调用期间没有 Mio 轮询，\n// 因此不需要帧描述符；Mio 栈帧上的根在调用期间保持原位。\n//\n// 栈对齐：Mio 的操作数栈随意推进 RSP，进入桥接体时 RSP 没有对齐保证，所以用 `and rsp, -16`\n// 动态对齐，再预留 16 字节倍数的栈参数区；此时 CALL 处 RSP 为 16 的倍数，返回地址压入后\n// 被调用者入口处 (RSP + 8) 为 16 的倍数，符合 psABI。返回后用 `mov rsp, rbp` 恢复，所以无需\n// 记录原 RSP，嵌套调用同样正确。128 字节红区：Mio 不在 RSP 以下保存数据，被调用者看到的\n// RSP 以下都是死区。\n//\n// 寄存器：RBX、RBP、R12–R15 由 C 保存；RAX、RCX、RDX、RSI、RDI、R8–R11 和全部 XMM 可能被\n// C 破坏，Mio 本身从不跨调用把值留在寄存器中，值都在栈帧里，所以无需额外保存。\n// 可变参数函数不生成（定参声明是唯一入口），否则调用点必须把 AL 设为用到的向量寄存器数。\nkoukai waza emit_c_bridge(code: x86_64.Assembler, signature: cabi.Signature, parameter_count: int64) -> string {\n    moshi (!signature.valid || len(signature.parameters) != parameter_count) { kaesu \"INVALID_C_PROTOTYPE\"; }\n    // 间接调用：第一个参数是函数指针，其余参数按普通 C 参数分类；Mio 帧中的参数下标整体后移一位。\n    kaku skip = 0;\n    kaku kinds = signature.parameters;\n    moshi (signature.indirect) {\n        moshi (parameter_count < 1 || signature.parameters[0] != 107) { kaesu \"INVALID_C_PROTOTYPE\"; }\n        skip = 1;\n        kinds = [];\n        kaku k = 1;\n        aida (k < parameter_count) { array.push(kinds, signature.parameters[k]); k = k + 1; }\n    }\n    kaku effective = cabi.Signature { symbol: signature.symbol, result: signature.result, parameters: kinds, valid: hai, indirect: iie };\n    kaku layout = classify(effective);\n    kaku registers = integer_registers();\n    kaku frame = stack_bytes(layout);\n    // 目标函数指针在对齐之前读取并检查：空指针以 nil 陷阱结束，不会跳转到地址 0。\n    moshi (skip == 1) {\n        x86_64.mov_load(code, x86_64.r11, x86_64.rbp, local_disp(parameter_count, 0));\n        x86_64.test_rr(code, x86_64.r11, x86_64.r11);\n        x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    }\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    moshi (frame > 0) { x86_64.sub_ri(code, x86_64.rsp, frame); }\n    // 先写栈参数，再装寄存器；RAX 只作搬运暂存，不是参数寄存器（AL 仅变参调用使用）。\n    kaku at = 0;\n    aida (at < len(kinds)) {\n        kaku place = layout.placements[at];\n        kaku kind = kinds[at];\n        kaku disp = local_disp(parameter_count, at + skip);\n        moshi (place.class == class_memory) {\n            x86_64.mov_load(code, x86_64.rax, x86_64.rbp, disp);\n            moshi (kind == 109) { emit_buffer_pointer(code, x86_64.rax); }\n            emit_extend(code, x86_64.rax, extension(kind));\n            x86_64.mov_store(code, x86_64.rsp, place.index * 8, x86_64.rax);\n        }\n        moshi (place.class == class_sse) {\n            x86_64.mov_load(code, x86_64.rax, x86_64.rbp, disp);\n            moshi (kind == 105) { x86_64.movd_xmm_r(code, place.index, x86_64.rax); }\n            sore { x86_64.movq_xmm_r(code, place.index, x86_64.rax); }\n        }\n        moshi (place.class == class_integer) {\n            x86_64.mov_load(code, registers[place.index], x86_64.rbp, disp);\n            moshi (kind == 109) { emit_buffer_pointer(code, registers[place.index]); }\n            emit_extend(code, registers[place.index], extension(kind));\n        }\n        at = at + 1;\n    }\n    moshi (skip == 1) { x86_64.call_r(code, x86_64.r11); }\n    sore { x86_64.call_external(code, signature.symbol); }\n    // 返回值：窄整数按符号扩展或零扩展回完整的 Mio 槽；float 的位模式原样搬回 RAX；bool 规范为 0/1。\n    kaku result = signature.result;\n    moshi (result == 105) { x86_64.movd_r_xmm(code, x86_64.rax, 0); }\n    moshi (result == 106) { x86_64.movq_r_xmm(code, x86_64.rax, 0); }\n    moshi (result == 108) {\n        emit_extend(code, x86_64.rax, 15);\n        x86_64.cmp_ri(code, x86_64.rax, 0);\n        x86_64.setcc_rax(code, x86_64.cc_ne);\n    }\n    moshi (result != 108 && result != 118) { emit_extend(code, x86_64.rax, extension(result)); }\n    kaesu \"\";\n}\n\n// []uint8 参数：寄存器中是 Mio 数组对象，换成它的数据首地址（数组对象偏移 40）。\n// nil 数组以 nil 陷阱结束；数据区不会被移动（回收器不整理堆），调用期间也没有回收。\nwaza emit_buffer_pointer(code: x86_64.Assembler, reg: int64) -> unit {\n    x86_64.test_rr(code, reg, reg);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, reg, reg, 40);\n}\n" }; }
waza data_37() -> File { kaesu File { path: "kiso/aot/lowerlinux/darwinabi.mio", version: "Bunko-v2.1.1", length: 21805, sha256: "71c12b7d95a721c80efff52f9615d6e1325917acbf9442469cbe2f8440f6385a", source: "yobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// macOS x86-64 operating-system adapter for the Linux x86-64 lowering.\n//\n// The Linux lowering reaches the kernel only through x86_64.syscall (number in eax, arguments in rdi rsi rdx r10 r8 r9,\n// result or -errno in rax, all other registers except rcx and r11 preserved). With the label `darwin_abi` defined (see\n// x86_64.syscall) each such instruction becomes `call darwin_syscall`, emitted here. The routine performs the equivalent\n// Darwin BSD call (number | 0x2000000; error = carry flag set and a positive Darwin errno in rax) and returns the Linux\n// convention: it translates numbers, open/mmap flags, the stat and directory-entry layouts, sockaddr_in, the fork result\n// and the errno values; /proc/self/exe and /proc/self/fd/N are answered with proc_info and fcntl(F_GETPATH);\n// CLOCK_MONOTONIC is served from gettimeofday (a documented approximation). Signals (rt_sigaction/rt_sigreturn: the crash\n// reporter reads Linux ucontext offsets) and every unknown call fail explicitly with ENOSYS (-38).\n// All registers except rax, rcx and r11 are preserved, as on Linux.\n//\n// Frame: 200 bytes of scratch at rsp+0, saved r10 r9 r8 rdx rsi rdi r15 r14 r13 r12 rbx at rsp+200 .. rsp+280.\n\nwaza dx_jmp(c: x86_64.Assembler, name: string) -> unit { x86_64.jmp(c, name); }\nwaza dx_jcc(c: x86_64.Assembler, cc: int64, name: string) -> unit { x86_64.jcc(c, cc, name); }\nwaza dx_name(prefix: string, index: int64) -> string { kaesu string.concat(prefix, convert.format_int(index)); }\nwaza dx_class(number: int64) -> int64 { kaesu 33554432 + number; }\n\n// Linux call `linux` -> Darwin call `darwin`, same arguments and result convention.\nwaza dx_direct(c: x86_64.Assembler, linux: int64, darwin: int64, index: int64) -> unit {\n    kaku next = dx_name(\"dx_direct_next_\", index);\n    x86_64.cmp_ri(c, x86_64.rax, linux);\n    dx_jcc(c, x86_64.cc_ne, next);\n    x86_64.mov_eax_imm(c, dx_class(darwin));\n    dx_jmp(c, \"dx_svc\");\n    x86_64.label(c, next);\n}\n\nwaza dx_dispatch(c: x86_64.Assembler, linux: int64, target: string, index: int64) -> unit {\n    kaku next = dx_name(\"dx_dispatch_next_\", index);\n    x86_64.cmp_ri(c, x86_64.rax, linux);\n    dx_jcc(c, x86_64.cc_ne, next);\n    dx_jmp(c, target);\n    x86_64.label(c, next);\n}\n\n// dst = (src & mask_low) | translated bits; pairs (from mask, to mask). Uses rcx and r14.\nwaza dx_flags(c: x86_64.Assembler, src: int64, dst: int64, low_mask: int64, pairs: []int64, prefix: string) -> unit {\n    x86_64.mov_rr(c, dst, src);\n    x86_64.and_ri(c, dst, low_mask);\n    kaku at = 0;\n    aida (at < len(pairs)) {\n        kaku skip = dx_name(prefix, at);\n        x86_64.mov_rr(c, x86_64.rcx, src);\n        x86_64.and_ri(c, x86_64.rcx, pairs[at]);\n        dx_jcc(c, x86_64.cc_e, skip);\n        x86_64.mov_ri(c, x86_64.r14, pairs[at + 1]);\n        x86_64.or_rr(c, dst, x86_64.r14);\n        x86_64.label(c, skip);\n        at = at + 2;\n    }\n}\n\n// Compare the bytes of `text` at [reg] and jump to `fail` on the first difference. Uses rax.\nwaza dx_prefix(c: x86_64.Assembler, reg: int64, text: string, fail: string) -> unit {\n    kaku bytes = string.to_bytes(text);\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        x86_64.mov_load8(c, x86_64.rax, reg, at);\n        x86_64.cmp_ri(c, x86_64.rax, int64(bytes[at]));\n        dx_jcc(c, x86_64.cc_ne, fail);\n        at = at + 1;\n    }\n}\n\n// Store `text` and a NUL at [rsp + offset].\nwaza dx_store_text(c: x86_64.Assembler, offset: int64, text: string) -> int64 {\n    kaku bytes = string.to_bytes(text);\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        x86_64.mov_ri(c, x86_64.rax, int64(bytes[at]));\n        x86_64.mov_store8(c, x86_64.rsp, offset + at, x86_64.rax);\n        at = at + 1;\n    }\n    x86_64.mov_ri(c, x86_64.rax, 0);\n    x86_64.mov_store8(c, x86_64.rsp, offset + len(bytes), x86_64.rax);\n    kaesu offset + len(bytes);\n}\n\n// Length of the NUL-terminated string at [reg] (at most 1023) into rax; clobbers rcx.\nwaza dx_strlen(c: x86_64.Assembler, reg: int64, label: string) -> unit {\n    x86_64.mov_ri(c, x86_64.rax, 0);\n    x86_64.label(c, label);\n    x86_64.mov_rr(c, x86_64.rcx, reg);\n    x86_64.add_rr(c, x86_64.rcx, x86_64.rax);\n    x86_64.mov_load8(c, x86_64.rcx, x86_64.rcx, 0);\n    x86_64.test_rr(c, x86_64.rcx, x86_64.rcx);\n    dx_jcc(c, x86_64.cc_e, string.concat(label, \"_done\"));\n    x86_64.add_ri(c, x86_64.rax, 1);\n    x86_64.cmp_ri(c, x86_64.rax, 1023);\n    dx_jcc(c, x86_64.cc_b, label);\n    x86_64.label(c, string.concat(label, \"_done\"));\n}\n\n// The syscall instruction proper, then the carry-flag test: success returns rax, failure maps the Darwin errno.\nwaza dx_tail(c: x86_64.Assembler) -> unit {\n    x86_64.label(c, \"dx_svc\");\n    x86_64.syscall_raw(c);\n    dx_jcc(c, x86_64.cc_ae, \"dx_return\");\n    x86_64.label(c, \"dx_fail\");\n    x86_64.call(c, \"dx_errno\");\n    x86_64.neg_r(c, x86_64.rax);\n    x86_64.label(c, \"dx_return\");\n    x86_64.add_ri(c, x86_64.rsp, 200);\n    x86_64.pop_r(c, x86_64.r10);\n    x86_64.pop_r(c, x86_64.r9);\n    x86_64.pop_r(c, x86_64.r8);\n    x86_64.pop_r(c, x86_64.rdx);\n    x86_64.pop_r(c, x86_64.rsi);\n    x86_64.pop_r(c, x86_64.rdi);\n    x86_64.pop_r(c, x86_64.r15);\n    x86_64.pop_r(c, x86_64.r14);\n    x86_64.pop_r(c, x86_64.r13);\n    x86_64.pop_r(c, x86_64.r12);\n    x86_64.pop_r(c, x86_64.rbx);\n    x86_64.ret(c);\n}\n\n// Darwin errno (rax) -> Linux errno for the values that differ.\nwaza dx_errno(c: x86_64.Assembler) -> unit {\n    x86_64.label(c, \"dx_errno\");\n    kaku pairs = [35, 11, 36, 115, 37, 114, 38, 88, 39, 89, 40, 90, 41, 91, 42, 92, 43, 93, 45, 95, 47, 97, 48, 98, 49, 99, 50, 100,\n        51, 101, 53, 103, 54, 104, 55, 105, 56, 106, 57, 107, 60, 110, 61, 111, 65, 113, 66, 39, 62, 40, 63, 36, 78, 38];\n    kaku at = 0;\n    aida (at < len(pairs)) {\n        kaku next = dx_name(\"dx_errno_next_\", at);\n        x86_64.cmp_ri(c, x86_64.rax, pairs[at]);\n        dx_jcc(c, x86_64.cc_ne, next);\n        x86_64.mov_ri(c, x86_64.rax, pairs[at + 1]);\n        x86_64.ret(c);\n        x86_64.label(c, next);\n        at = at + 2;\n    }\n    x86_64.ret(c);\n}\n\nkoukai waza emit_darwin_abi_runtime(c: x86_64.Assembler) -> unit {\n    x86_64.label(c, \"darwin_syscall\");\n    x86_64.push_r(c, x86_64.rbx);\n    x86_64.push_r(c, x86_64.r12);\n    x86_64.push_r(c, x86_64.r13);\n    x86_64.push_r(c, x86_64.r14);\n    x86_64.push_r(c, x86_64.r15);\n    x86_64.push_r(c, x86_64.rdi);\n    x86_64.push_r(c, x86_64.rsi);\n    x86_64.push_r(c, x86_64.rdx);\n    x86_64.push_r(c, x86_64.r8);\n    x86_64.push_r(c, x86_64.r9);\n    x86_64.push_r(c, x86_64.r10);\n    x86_64.sub_ri(c, x86_64.rsp, 200);\n    // ---- direct translations: (Linux, Darwin)\n    kaku direct = [0, 3, 1, 4, 3, 6, 7, 230, 33, 90, 38, 83, 39, 20, 43, 30, 50, 106, 59, 59, 61, 7, 83, 136, 84, 137, 87, 10, 90, 15, 160, 195, 231, 1, 362, 362, 363, 363];\n    kaku at = 0;\n    aida (at < len(direct)) {\n        dx_direct(c, direct[at], direct[at + 1], at);\n        at = at + 2;\n    }\n    // ---- translated calls\n    kaku calls = [2, 9, 4, 217, 89, 57, 228, 44, 54, 49, 42, 41, 13, 15, 16, 55];\n    kaku names = [\"dx_open\", \"dx_mmap\", \"dx_stat\", \"dx_dirents\", \"dx_readlink\", \"dx_fork\", \"dx_clock\", \"dx_sendto\", \"dx_setsockopt\", \"dx_bind\", \"dx_connect\", \"dx_socket\", \"dx_unsupported\", \"dx_unsupported\", \"dx_ioctl\", \"dx_getsockopt\"];\n    at = 0;\n    aida (at < len(calls)) {\n        dx_dispatch(c, calls[at], names[at], at);\n        at = at + 1;\n    }\n    x86_64.label(c, \"dx_unsupported\");\n    x86_64.mov_ri(c, x86_64.rax, -38);\n    dx_jmp(c, \"dx_return\");\n\n    // ---- open(path, flags, mode): Linux flag bits -> Darwin\n    x86_64.label(c, \"dx_open\");\n    dx_flags(c, x86_64.rsi, x86_64.r13, 3, [64, 512, 128, 2048, 512, 1024, 1024, 8, 2048, 4, 65536, 1048576, 524288, 16777216, 131072, 256, 2097152, 32768], \"dx_open_skip_\");\n    x86_64.mov_rr(c, x86_64.rsi, x86_64.r13);\n    x86_64.mov_eax_imm(c, dx_class(5));\n    dx_jmp(c, \"dx_svc\");\n\n    // ---- mmap: MAP_ANONYMOUS 0x20 -> 0x1000, MAP_NORESERVE 0x4000 -> 0x40; MAP_SHARED/PRIVATE/FIXED are equal\n    x86_64.label(c, \"dx_mmap\");\n    x86_64.mov_rr(c, x86_64.r13, x86_64.r10);\n    x86_64.and_ri(c, x86_64.r13, 19);\n    x86_64.mov_rr(c, x86_64.rcx, x86_64.r10);\n    x86_64.and_ri(c, x86_64.rcx, 32);\n    dx_jcc(c, x86_64.cc_e, \"dx_mmap_anon_done\");\n    x86_64.mov_ri(c, x86_64.r14, 4096);\n    x86_64.or_rr(c, x86_64.r13, x86_64.r14);\n    x86_64.label(c, \"dx_mmap_anon_done\");\n    x86_64.mov_rr(c, x86_64.rcx, x86_64.r10);\n    x86_64.and_ri(c, x86_64.rcx, 16384);\n    dx_jcc(c, x86_64.cc_e, \"dx_mmap_go\");\n    x86_64.mov_ri(c, x86_64.r14, 64);\n    x86_64.or_rr(c, x86_64.r13, x86_64.r14);\n    x86_64.label(c, \"dx_mmap_go\");\n    x86_64.mov_rr(c, x86_64.r10, x86_64.r13);\n    x86_64.mov_eax_imm(c, dx_class(197));\n    dx_jmp(c, \"dx_svc\");\n\n    // ---- stat(path, buf): Darwin stat64 into scratch, then the Linux x86-64 struct stat layout (144 bytes)\n    x86_64.label(c, \"dx_stat\");\n    x86_64.mov_rr(c, x86_64.r12, x86_64.rsi);\n    x86_64.mov_rr(c, x86_64.rsi, x86_64.rsp);\n    x86_64.mov_eax_imm(c, dx_class(338));\n    x86_64.syscall_raw(c);\n    dx_jcc(c, x86_64.cc_ae, \"dx_stat_ok\");\n    dx_jmp(c, \"dx_fail\");\n    x86_64.label(c, \"dx_stat_ok\");\n    x86_64.mov_ri(c, x86_64.rax, 0);\n    kaku zero = 0;\n    aida (zero < 144) {\n        x86_64.mov_store(c, x86_64.r12, zero, x86_64.rax);\n        zero = zero + 8;\n    }\n    // Darwin: dev 0 (u32), mode 4 (u16), nlink 6 (u16), ino 8, uid 16, gid 20, rdev 24 (u32), atime 32/40, mtime 48/56,\n    // ctime 64/72, size 96, blocks 104, blksize 112 (u32).  Linux: dev 0, ino 8, nlink 16, mode 24 (u32), uid 28, gid 32,\n    // rdev 40, size 48, blksize 56, blocks 64, atime 72/80, mtime 88/96, ctime 104/112.\n    x86_64.mov_load32(c, x86_64.rax, x86_64.rsp, 0);\n    x86_64.mov_store(c, x86_64.r12, 0, x86_64.rax);\n    x86_64.mov_load(c, x86_64.rax, x86_64.rsp, 8);\n    x86_64.mov_store(c, x86_64.r12, 8, x86_64.rax);\n    x86_64.mov_load16(c, x86_64.rax, x86_64.rsp, 6);\n    x86_64.mov_store(c, x86_64.r12, 16, x86_64.rax);\n    x86_64.mov_load16(c, x86_64.rax, x86_64.rsp, 4);\n    x86_64.mov_store32(c, x86_64.r12, 24, x86_64.rax);\n    x86_64.mov_load32(c, x86_64.rax, x86_64.rsp, 16);\n    x86_64.mov_store32(c, x86_64.r12, 28, x86_64.rax);\n    x86_64.mov_load32(c, x86_64.rax, x86_64.rsp, 20);\n    x86_64.mov_store32(c, x86_64.r12, 32, x86_64.rax);\n    x86_64.mov_load32(c, x86_64.rax, x86_64.rsp, 24);\n    x86_64.mov_store(c, x86_64.r12, 40, x86_64.rax);\n    x86_64.mov_load(c, x86_64.rax, x86_64.rsp, 96);\n    x86_64.mov_store(c, x86_64.r12, 48, x86_64.rax);\n    x86_64.mov_load32(c, x86_64.rax, x86_64.rsp, 112);\n    x86_64.mov_store(c, x86_64.r12, 56, x86_64.rax);\n    x86_64.mov_load(c, x86_64.rax, x86_64.rsp, 104);\n    x86_64.mov_store(c, x86_64.r12, 64, x86_64.rax);\n    kaku times = [32, 72, 40, 80, 48, 88, 56, 96, 64, 104, 72, 112];\n    at = 0;\n    aida (at < len(times)) {\n        x86_64.mov_load(c, x86_64.rax, x86_64.rsp, times[at]);\n        x86_64.mov_store(c, x86_64.r12, times[at + 1], x86_64.rax);\n        at = at + 2;\n    }\n    x86_64.mov_ri(c, x86_64.rax, 0);\n    dx_jmp(c, \"dx_return\");\n\n    // ---- getdents64(fd, buf, count >= 8192) -> getdirentries64 into a 4 KiB stack buffer, converted to linux_dirent64\n    // (Darwin: ino 0, seekoff 8, reclen 16, namlen 18, type 20, name 21; Linux: ino 0, off 8, reclen 16, type 18, name 19)\n    x86_64.label(c, \"dx_dirents\");\n    x86_64.cmp_ri(c, x86_64.rdx, 8192);\n    dx_jcc(c, x86_64.cc_ae, \"dx_dirents_ok