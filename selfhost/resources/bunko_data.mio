  x86_64.sub_ri(code, x86_64.rdx, 1);\n    x86_64.jmp(code, \"rt.win_args.bs_half\");\n    x86_64.label(code, \"rt.win_args.bs_half_done\");\n    x86_64.and_ri(code, x86_64.rcx, 1);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.win_args.quote\");\n    x86_64.mov_ri(code, x86_64.rax, 34);\n    x86_64.mov_store8(code, x86_64.rdi, 0, x86_64.rax);\n    x86_64.add_ri(code, x86_64.rdi, 1);\n    x86_64.add_ri(code, x86_64.rsi, 1);\n    x86_64.jmp(code, \"rt.win_args.char\");\n    x86_64.label(code, \"rt.win_args.bs_literal\");\n    x86_64.mov_ri(code, x86_64.rax, 92);\n    x86_64.label(code, \"rt.win_args.bs_literal_loop\");\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.win_args.char\");\n    x86_64.mov_store8(code, x86_64.rdi, 0, x86_64.rax);\n    x86_64.add_ri(code, x86_64.rdi, 1);\n    x86_64.sub_ri(code, x86_64.rcx, 1);\n    x86_64.jmp(code, \"rt.win_args.bs_literal_loop\");\n    x86_64.label(code, \"rt.win_args.space\");\n    x86_64.add_ri(code, x86_64.rsi, 1);\n    x86_64.label(code, \"rt.win_args.end\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store8(code, x86_64.rdi, 0, x86_64.rax);\n    x86_64.add_ri(code, x86_64.rdi, 1);\n    x86_64.jmp(code, \"rt.win_args.next\");\n    x86_64.label(code, \"rt.win_args.args_done\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.r9, 0, x86_64.rax);\n    x86_64.add_ri(code, x86_64.r9, 8);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 64);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.r8);\n    x86_64.mov_store(code, x86_64.rsp, 80, x86_64.r9);\n    // environment: every \"NAME=value\" entry that does not start with '=' becomes a UTF-8 string\n    import_call(code, ctx, import_environment_strings);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.win_args.env_done\");\n    x86_64.mov_store(code, x86_64.rsp, 88, x86_64.rax);\n    x86_64.label(code, \"rt.win_args.env_next\");\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rsp, 88);\n    x86_64.mov_load8(code, x86_64.rax, x86_64.rsi, 0);\n    x86_64.mov_load8(code, x86_64.rcx, x86_64.rsi, 1);\n    x86_64.or_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.win_args.env_done\");\n    // length in wide characters (incl. NUL) -> advance the cursor after converting\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rsi);\n    x86_64.label(code, \"rt.win_args.env_len\");\n    x86_64.mov_load8(code, x86_64.rax, x86_64.rdi, 0);\n    x86_64.mov_load8(code, x86_64.rcx, x86_64.rdi, 1);\n    x86_64.add_ri(code, x86_64.rdi, 2);\n    x86_64.or_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.win_args.env_len\");\n    x86_64.mov_store(code, x86_64.rsp, 88, x86_64.rdi);\n    x86_64.mov_load8(code, x86_64.rax, x86_64.rsi, 0);\n    x86_64.cmp_ri(code, x86_64.rax, 61);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.win_args.env_next\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 72);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 80);\n    x86_64.mov_store(code, x86_64.rdx, 0, x86_64.rax);\n    x86_64.add_ri(code, x86_64.rdx, 8);\n    x86_64.mov_store(code, x86_64.rsp, 80, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rcx, 65001);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rsi);\n    x86_64.mov_ri(code, x86_64.r9, -1);\n    x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 64);\n    x86_64.mov_ri(code, x86_64.rdi, 4194304);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rdi);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rsp, 72);\n    x86_64.sub_rr(code, x86_64.rax, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_be, \"rt.trap.memory\");\n    x86_64.mov_store(code, x86_64.rsp, 40, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rsp, 48, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rax);\n    import_call(code, ctx, import_wide_to_multibyte);\n    x86_64.zero_extend_eax(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.memory\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 72);\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 72, x86_64.rdx);\n    x86_64.jmp(code, \"rt.win_args.env_next\");\n    x86_64.label(code, \"rt.win_args.env_done\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 80);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rdx, 0, x86_64.rax);\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\nwaza emit_win_runtime(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    emit_win_args(code, ctx);\n    emit_win_syscall(code, ctx);\n    emit_win_exit(code, ctx);\n    emit_win_write(code, ctx);\n    emit_win_virtual_alloc(code, ctx);\n    emit_win_commit(code, ctx);\n    emit_win_init(code, ctx);\n    emit_win_heap_grow(code, ctx);\n    emit_win_process(code, ctx);\n    emit_win_testing(code, ctx);\n    // Body-less native functions without a Windows implementation yet stop with an explicit runtime error.\n    x86_64.label(code, \"rt.os_exit\");\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rdi);\n    x86_64.jmp(code, \"rt.exit\");\n    x86_64.label(code, \"rt.os_unsupported\");\n    x86_64.jmp(code, \"rt.trap.unreachable\");\n}\n\n// Body-less native functions: kiso/fs operations go through runtime_fs.mio (Linux protocol layer over rt.syscall);\n// of the os operations only exit exists. Everything else stops at call time with the explicit runtime error\n// \"unsupported operation\" (rt.os_unsupported).\nwaza os_routine(operation: string) -> string {\n    moshi (operation == \"argc\") { kaesu \"rt.os_argc\"; }\n    moshi (operation == \"arg_size\") { kaesu \"rt.os_arg_size\"; }\n    moshi (operation == \"arg_copy\") { kaesu \"rt.os_arg_copy\"; }\n    moshi (operation == \"exit\") { kaesu \"rt.os_exit\"; }\n    moshi (operation == \"chmod\") { kaesu \"rt.os_chmod\"; }\n    moshi (operation == \"remove\") { kaesu \"rt.os_remove\"; }\n    moshi (operation == \"rmdir\") { kaesu \"rt.os_rmdir\"; }\n    moshi (operation == \"pid\") { kaesu \"rt.os_pid\"; }\n    moshi (operation == \"real_path\") { kaesu \"rt.os_real_path\"; }\n    moshi (operation == \"env_size\") { kaesu \"rt.os_env_size\"; }\n    moshi (operation == \"env_copy\") { kaesu \"rt.os_env_copy\"; }\n    moshi (operation == \"monotonic_ms\") { kaesu \"rt.os_monotonic_ms\"; }\n    moshi (operation == \"spawn\") { kaesu \"rt.os_spawn\"; }\n    moshi (operation == \"exec\") { kaesu \"rt.os_exec\"; }\n    moshi (operation == \"spawn_test\") { kaesu \"rt.os_spawn_test\"; }\n    moshi (operation == \"stdin_ready\") { kaesu \"rt.os_stdin_ready\"; }\n    moshi (operation == \"stdin_wait\") { kaesu \"rt.os_stdin_wait\"; }\n    kaesu \"\";\n}\nwaza initial_sp_cell() -> int64 { kaesu gc_state() + 72; }\n" }; }
waza data_58() -> File { kaesu File { path: "kiso/aot/lowerwinrt/winprocess.mio", version: "Bunko-v2.1.1", length: 40984, sha256: "40fd8fd5700b8da1fb90e5a570f7e84c3dc9cb1a2d3e190b620d6334cec51fba", source: "yobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// Windows process layer: the body-less \"mio/os/runtime\" process operations (spawn, exec, spawn_test, stdin readiness)\n// and the kiso/testing report channel, with the observable contract of the Linux runtime (kiso/aot/lowerlinux):\n//  * spawn(path, argv): argv (argv[0] included) is joined into one command line with the CommandLineToArgvW quoting\n//    rules, so the child's rt.win_args sees exactly the same argument strings. The program path is used as is (no PATH\n//    search, no extension added), like execve. The result is the child's exit code; a program that cannot be started\n//    returns 127, the status of a failed exec in the Linux child. Exit codes are the Windows 32-bit codes (an exception\n//    ends a process with its NTSTATUS); a Mio program exiting with 0..255 gives the same status on every platform.\n//  * exec(path, argv): Windows has no exec. The program is started, waited for, and this process exits with its\n//    status, so the caller observes the same exit status as after execve; a start failure returns -errno.\n//  * spawn_test: stdout/stderr redirected to private files (create/truncate), the records file is the child's \"fd 3\",\n//    handed over with the C runtime's STARTUPINFO lpReserved2 descriptor table (count, flags, handles); the child's\n//    testing runtime reads it back with GetStartupInfoW. The child is stopped after the wall deadline (cpu_seconds);\n//    a single-threaded Mio test cannot use more CPU time than wall time, so this also bounds its CPU time. A stopped\n//    child reports 142 (the Linux SIGALRM status); a budget outside 1..3600 or a file that cannot be opened is 126 and a