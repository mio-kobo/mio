waza data_86() -> File { kaesu File { path: "kiso/runtime/gc/old_overflow.mio", version: "Bunko-v2.1.1", length: 3240, sha256: "36112ab253e25d44367f1c39e7f0fb0ea378f0e93b91d850681f942f3de065e3", source: "// Deferred-task compensation, under native validation. A full queue\n// retains its discovered object as a deferred exact task in the OWNED header.\n// No pointer buffer is dropped or fabricated. Counter104 is published before\n// pending bit42; the independent marker retries a real heap walk if publication\n// is still in flight. Mutator pause protects heap-layout changes during walks.\nkoukai teisu old_deferred_bit=4398046511104;\nwaza old_defer_program() -> ir.Function {\n kaku f=ir.function(\"gc_old_defer\");ir.put(f,ir.address,20,0,0,104);tconstant(f,21,1);array.push(f.steps,ir.Step {kind:ir.fetch_add,destination:22,left:20,right:21,immediate:0,name:\"\",arguments:[],order:acq_rel,failure_order:relaxed});\n tconstant(f,6,16);ir.put(f,ir.subtract,10,1,6,0);tconstant(f,14,0);\n ir.branch(f,ir.label,0,\"defer_cas\");ir.put(f,ir.acquire_load,11,10,0,0);old_bit(f,11,12,old_deferred_bit);ir.branch(f,ir.nonzero,12,\"invalid\");tconstant(f,12,old_deferred_bit);ir.put(f,ir.add,12,11,12,0);\n array.push(f.steps,ir.Step {kind:ir.compare_exchange,destination:13,left:10,right:12,immediate:0,name:\"\",arguments:[11],order:acq_rel,failure_order:acquire});ir.put(f,ir.equal,13,13,11,0);ir.branch(f,ir.nonzero,13,\"done\");tconstant(f,6,1);ir.put(f,ir.add,14,14,6,0);tconstant(f,6,1024);ir.put(f,ir.less_unsigned,6,14,6,0);ir.branch(f,ir.nonzero,6,\"defer_cas\");\n ir.branch(f,ir.label,0,\"invalid\");tconstant(f,5,4);old_error(f,5);treturn(f,4);\n ir.branch(f,ir.label,0,\"done\");treturn(f,0);kaesu f;\n}\nwaza old_reoffer_program() -> ir.Function {\n // ctx,owned header. The only marker calls this during a real overflow walk.\n // Clear bit42 only after successful queue publication. No other consumer can\n // revisit this header until this function returns, so it cannot duplicate it.\n kaku f=ir.function(\"gc_old_reoffer\");ir.put(f,ir.acquire_load,10,1,0,0);old_bit(f,10,11,old_deferred_bit);ir.branch(f,ir.zero,11,\"done\");\n ir.put(f,ir.load,16,0,0,112);ir.put(f,ir.address,17,1,0,16);ir.invoke_function(f,\"gc_work_offer\",5,[0,16,17]);ir.branch(f,ir.zero,5,\"published\");tcheck(f,5,1,\"done\");tcheck(f,5,2,\"done\");ir.branch(f,ir.jump,0,\"failed\");\n ir.branch(f,ir.label,0,\"published\");tconstant(f,14,0);\n ir.branch(f,ir.label,0,\"clear_cas\");ir.put(f,ir.acquire_load,10,1,0,0);old_bit(f,10,11,old_deferred_bit);ir.branch(f,ir.zero,11,\"invalid\");tconstant(f,11,old_deferred_bit);ir.put(f,ir.subtract,11,10,11,0);\n array.push(f.steps,ir.Step {kind:ir.compare_exchange,destination:12,left:1,right:11,immediate:0,name:\"\",arguments:[10],order:acq_rel,failure_order:acquire});ir.put(f,ir.equal,12,12,10,0);ir.branch(f,ir.nonzero,12,\"cleared\");tconstant(f,6,1);ir.put(f,ir.add,14,14,6,0);tconstant(f,6,1024);ir.put(f,ir.less_unsigned,6,14,6,0);ir.branch(f,ir.nonzero,6,\"clear_cas\");ir.branch(f,ir.jump,0,\"invalid\");\n ir.branch(f,ir.label,0,\"cleared\");ir.put(f,ir.address,20,0,0,104);tconstant(f,21,-1);array.push(f.steps,ir.Step {kind:ir.fetch_add,destination:22,left:20,right:21,immediate:0,name:\"\",arguments:[],order:acq_rel,failure_order:relaxed});ir.branch(f,ir.zero,22,\"invalid\");\n ir.branch(f,ir.label,0,\"done\");treturn(f,0);\n ir.branch(f,ir.label,0,\"invalid\");tconstant(f,5,4);ir.branch(f,ir.label,0,\"failed\");old_error(f,5);ir.put(f,ir.result,0,5,0,0);kaesu f;\n}\n" }; }
waza data_87() -> File { kaesu File { path: "kiso/runtime/gc/old_pause.mio", version: "Bunko-v2.1.1", length: 8043, sha256: "5bdb2b9e9d287c59197a8f5764adfe940db470823696917df3cac136735bee42", source: "// Experimental allocation/Minor protocol, under native validation. The executing Mutator owns\n// the heap epoch. request448/ack456/released464 are monotonic; depth496 is\n// private to that owner. Never accept a stale acknowledgment after reuse.\nwaza old_pause_program() -> ir.Function {\n kaku f=ir.function(\"gc_old_pause\");ir.put(f,ir.acquire_load,5,0,0,144);tcheck(f,5,old_phase_abort,\"abort\");tconstant(f,6,old_phase_mark);ir.put(f,ir.equal,6,5,6,0);ir.branch(f,ir.zero,6,\"done\");\n ir.put(f,ir.load,10,0,0,496);ir.branch(f,ir.zero,10,\"request\");tconstant(f,11,1024);ir.put(f,ir.less_unsigned,11,10,11,0);ir.branch(f,ir.zero,11,\"invalid\");tconstant(f,11,1);ir.put(f,ir.add,10,10,11,0);ir.put(f,ir.store,0,0,10,496);ir.branch(f,ir.jump,0,\"done\");\n ir.branch(f,ir.label,0,\"request\");ir.put(f,ir.acquire_load,10,0,0,448);tconstant(f,11,1);ir.put(f,ir.add,10,10,11,0);ir.branch(f,ir.zero,10,\"invalid\");ir.put(f,ir.release_store,0,0,10,448);old_deadline(f,20,10000000000,\"invalid\");\n ir.branch(f,ir.label,0,\"wait\");ir.put(f,ir.acquire_load,5,0,0,144);tcheck(f,5,old_phase_abort,\"abort\");ir.put(f,ir.acquire_load,11,0,0,456);ir.put(f,ir.equal,11,11,10,0);ir.branch(f,ir.nonzero,11,\"acknowledged\");ir.invoke_function(f,\"platform_now\",5,[]);ir.branch(f,ir.zero,5,\"invalid\");ir.put(f,ir.less_unsigned,5,5,20,0);ir.branch(f,ir.nonzero,5,\"wait\");\n ir.branch(f,ir.label,0,\"invalid\");tconstant(f,5,4);old_error(f,5);\n ir.branch(f,ir.label,0,\"abort\");ir.invoke_function(f,\"gc_old_abort_join\",5,[0]);ir.put(f,ir.result,0,5,0,0);\n ir.branch(f,ir.label,0,\"acknowledged\");tconstant(f,5,1);ir.put(f,ir.store,0,0,5,496);old_add(f,472);\n ir.branch(f,ir.label,0,\"done\");treturn(f,0);kaesu f;\n}\nwaza old_resume_program() -> ir.Function {\n kaku f=ir.function(\"gc_old