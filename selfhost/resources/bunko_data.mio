; fixups: []Fixup; errors: []EncodeError; }\nkoukai kata AssembleResult { words: []uint32; error: EncodeError?; }\n\nkoukai waza assembler() -> Assembler {\n    kaesu Assembler { words: array.with_capacity[uint32](32), labels: array.with_capacity[Label](8), label_index: [array.make[int64](32, 0)], fixups: array.with_capacity[Fixup](8), errors: array.with_capacity[EncodeError](1) };\n}\n\n// Linux ABI mode (opt-in, chosen by defining the label \"linux_abi\" before any code is emitted): the Darwin system-call\n// instruction SVC #128 (number in x16) becomes `stp x30, xzr, [sp, #-16]!; bl linux_syscall; ldp x30, xzr, [sp], #16`.\n// linux_syscall is a runtime routine that translates the Darwin call into the Linux AArch64 call and restores the Darwin\n// result convention (carry flag set and a positive Darwin errno in x0 on failure). Without the label nothing changes, so\n// Darwin images stay byte-identical.\nkoukai waza assembler_emit(value: Assembler, encoded: Instruction) -> EncodeError? {\n    kaku failure = encoded.error;\n    moshi (failure != mu) { array.push(value.errors, failure); kaesu failure; }\n    moshi (encoded.word == uint32(3556773889) && find_label(value, \"linux_abi\") >= 0) {\n        array.push(value.words, stp_pre_x(30, 31, 31, -16).word);\n        kaku called = assembler_fixup(value, \"linux_syscall\", 1, 0);\n        array.push(value.words, ldp_post_x(30, 31, 31, 16).word);\n        kaesu called;\n    }\n    array.push(value.words, encoded.word);\n    kaesu mu;\n}\n\nwaza label_hash(name: string, capacity: int64) -> int64 {\n    kaku hash = 0; kaku i = 0; kaku data = string.to_bytes(name);\n    aida (i < len(data)) { hash = hash * 131 + int64(data[i]); hash = hash - (hash / capacity) * capacity; i = i + 1; }\n    kaesu hash;\n}\n\nwaza index_label(table: []int64, labels: []Label, index: int64) -> unit {\n    kaku slot = label_hash(labels[index].name, len(table));\n    aida (table[slot] != 0) { slot = slot + 1; moshi (slot == len(table)) { slot = 0; } }\n    table[slot] = index + 1;\n}\n\nwaza find_label(value: Assembler, name: string) -> int64 {\n    kaku table = value.label_index[0]; kaku slot = label_hash(name, len(table)); kaku probes = 0;\n    aida (probes < len(table)) {\n        kaku index = table[slot] - 1; moshi (index < 0) { kaesu -1; }\n        moshi (value.labels[index].name == name) { kaesu value.labels[index].word; }\n        slot = slot + 1; moshi (slot == len(table)) { slot = 0; } probes = probes + 1;\n    }\n    kaesu -1;\n}\n\nkoukai waza assembler_label(value: Assembler, name: string) -> EncodeError? {\n    moshi (find_label(value, name) >= 0) {\n        kaku failure = EncodeError.DuplicateLabel(name); array.push(value.errors, failure); kaesu failure;\n    }\n    kaku table = value.label_index[0];\n    moshi ((len(value.labels) + 1) * 2 >= len(table)) {\n        table = array.make[int64](len(table) * 2, 0); kaku i = 0;\n        aida (i < len(value.labels)) { index_label(table, value.labels, i); i = i + 1; }\n        value.label_index[0] = table;\n    }\n    array.push(value.labels, Label { name: name, word: len(value.words) });\n    index_label(table, value.labels, len(value.labels) - 1);\n    kaesu mu;\n}\n\nwaza assembler_fixup(value: Assembler, target: string, kind: int64, operand: int64) -> EncodeError? {\n    array.push(value.fixups, Fixup { at_word: len(value.words), target: target, kind: kind, operand: operand });\n    array.push(value.words, uint32(0));\n    // Reserve before any later label or AddressPatch captures a word index.\n    // Short branches retain their original encoding followed by NOP. Far\n    // branches use the inverted condition over B, without touching NZCV or GPRs.\n    moshi (kind >= 2 && kind <= 4) { array.push(value.words, uint32(3573751839)); }\n    kaesu mu;\n}\n\nkoukai waza assembler_b(value: Assembler, target: string) -> EncodeError? { kaesu assembler_fixup(value, target, 0, 0); }\nkoukai waza assembler_bl(value: Assembler, target: string) -> EncodeError? { kaesu assembler_fixup(value, target, 1, 0); }\nkoukai waza assembler_b_cond(value: Assembler, condition: int64, target: string) -> EncodeError? {\n    moshi (condition < 0 || condition > 15) { kaku failure = EncodeError.InvalidCondition(); array.push(value.errors, failure); kaesu failure; }\n    kaesu assembler_fixup(value, target, 2, condition);\n}\nkoukai waza assembler_cbz_x(value: Assembler, reg: int64, target: string) -> EncodeError? {\n    kaku failure = register_error(reg); moshi (failure != mu) { array.push(value.errors, failure); kaesu failure; }\n    kaesu assembler_fixup(value, target, 3, reg);\n}\nkoukai waza assembler_cbnz_x(value: Assembler, reg: int64, target: string) -> EncodeError? {\n    kaku failure = register_error(reg); moshi (failure != mu) { array.push(value.errors, failure); kaesu failure; }\n    kaesu assembler_fixup(value, target, 4, reg);\n}\n\nkoukai waza assembler_assemble(value: Assembler) -> AssembleResult {\n    moshi (len(value.errors) > 0) { kaesu AssembleResult { words: [], error: value.errors[0] }; }\n    kaku output = array.clone(value.words);\n    kaku index = 0;\n    aida (index < len(value.fixups)) {\n        kaku fix = value.fixups[index];\n        kaku target = find_label(value, fix.target);\n        moshi (target < 0) { kaesu AssembleResult { words: [], error: EncodeError.UndefinedLabel(fix.target) }; }\n        kaku delta = target - fix.at_word;\n        kaku encoded = b(delta);\n        moshi (fix.kind == 1) { encoded = bl(delta); }\n        moshi (fix.kind == 2) { encoded = b_cond(fix.operand, delta); }\n        moshi (fix.kind == 3) { encoded = cbz_x(fix.operand, delta); }\n        moshi (fix.kind == 4) { encoded = cbnz_x(fix.operand, delta); }\n        moshi (fix.kind < 0 || fix.kind > 4) { kaesu AssembleResult { words: [], error: EncodeError.InvalidPatch() }; }\n        moshi (fix.kind >= 2 && (delta < -262144 || delta > 262143)) {\n            // AL and NV both mean always for B.cond; they are not inverses.\n            moshi (fix.kind == 2 && fix.operand >= 14) { encoded = b(delta); }\n            sore {\n                kaku inverse = fix.operand + 1;\n                moshi (fix.operand - (fix.operand / 2) * 2 == 1) { inverse = fix.operand - 1; }\n                kaku skip = b_cond(inverse, 2);\n                moshi (fix.kind == 3) { skip = cbnz_x(fix.operand, 2); }\n                moshi (fix.kind == 4) { skip = cbz_x(fix.operand, 2); }\n                moshi (skip.error != mu) { kaesu AssembleResult { words: [], error: skip.error }; }\n                // B's PC is the second word, not the conditional branch's PC.\n                kaku jump = b(delta - 1);\n                moshi (jump.error != mu) { kaesu AssembleResult { words: [], error: jump.error }; }\n                output[fix.at_word + 1] = jump.word;\n                encoded = skip;\n            }\n        }\n        kaku failure = encoded.error;\n        moshi (failure != mu) { kaesu AssembleResult { words: [], error: failure }; }\n        output[fix.at_word] = encoded.word;\n        index = index + 1;\n    }\n    kaesu AssembleResult { words: output, error: mu };\n}\n\n// Resolve a label through the assembler index for lowering diagnostics/patches.\nkoukai waza assembler_label_word(value: Assembler, name: string) -> int64 { kaesu find_label(value, name); }\n" }; }
waza data_1() -> File { kaesu File { path: "kiso/aot/arm64/atomic.mio", version: "Bunko-v2.1.1", length: 2194, sha256: "b4a71f156ab29f7cc58a2d5055f6bb482ec88f5189449432631ea598c73b7f45", source: "// A64 base ISA atomics: no dependency on optional LSE instructions.\n// LDAR/STLR provide acquire/release. LL/SC loops live in the CPU adapter.\n// Encodings follow Arm A64 ISA (load/store exclusive and barrier classes).\nkoukai waza read_nzcv(rt:int64) -> Instruction {\n    kaku error=register_error(rt);moshi(error!=mu){kaesu Instruction {word:uint32(0),error:error};}\n    kaesu instruction(3577430528+rt);\n}\nkoukai waza write_nzcv(rt:int64) -> Instruction {\n    kaku error=register_error(rt);moshi(error!=mu){kaesu Instruction {word:uint32(0),error:error};}\n    kaesu instruction(3575333376+rt);\n}\nkoukai waza ldar_x(rt: int64, rn: int64) -> Instruction {\n    kaku error = register_error(rt); moshi (error == mu) { error = register_error(rn); }\n    moshi (error != mu) { kaesu Instruction {word:uint32(0),error:error}; }\n    kaesu instruction(3370122240 + rn * 32 + rt);\n}\nkoukai waza stlr_x(rt: int64, rn: int64) -> Instruction {\n    kaku error = register_error(rt); moshi (error == mu) { error = register_error(rn); }\n    moshi (error != mu) { kaesu Instruction {word:uint32(0),error:error}; }\n    kaesu instruction(3365927936 + rn * 32 + rt);\n}\nkoukai waza ldxr_x(rt: int64, rn: int64, acquire: bool) -> Instruction {\n    kaku error = register_error(rt); moshi (error == mu) { error = register_error(rn); }\n    moshi (error != mu) { kaesu Instruction {word:uint32(0),error:error}; }\n    kaku base = 3361700864; moshi (acquire) { base = base + 32768; }\n    kaesu instruction(base + rn * 32 + rt);\n}\nkoukai waza stxr_x(status: int64, rt: int64, rn: int64, release: bool) -> Instruction {\n    kaku error = three_registers(status, rt, rn);\n    // Status may not alias source/base (architecturally unpredictable).\n    moshi (error != mu) { kaesu Instruction {word:uint32(0),error:error}; }\n    moshi (status == rt || (status == rn && rn != 31)) { kaesu Instruction {word:uint32(0),error:EncodeError.InvalidRegister()}; }\n    kaku base = 3355474944; moshi (release) { base = base + 32768; }\n    kaesu instruction(base + status * 65536 + rn * 32 + rt);\n}\nkoukai waza dmb_ish() -> Instruction { kaesu instruction(3573758911); }\nkoukai waza clrex() -> Instruction { kaesu instruction(3573759839); }\n" }; }
waza data_2() -> File { kaesu File { path: "kiso/aot/elf/elf.mio", version: "Bunko-v2.1.1", length: 5757, sha256: "3a2218e5ed3c3b52c5959efec1c95c9bd0d67f2f649e5464343af00da8a6cb36", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// Pure Mio Linux x86-64 ELF64 (ET_EXEC) writer. Layout:\n//   0x0000 ELF header + program headers (inside the RX segment)\n//   0x1000 code; entry = image_base + 0x1000 + entry_offset\n//   after  .shstrtab + section headers (.text/.bss/.shstrtab), not loaded\n//   data   one RW PT_LOAD at the fixed address data_base with filesz 0 (zero-filled bss);\n//          it is omitted when bss_size is 0 (a zero-length PT_LOAD is pointless and\n//          loaders are not required to accept it)\n//   PT_GNU_STACK is RW and non-executable.\nkoukai kata ImageSpec { code: []uint8; entry_offset: int64; bss_size: int64; }\nkoukai kata ImageResult { bytes: []uint8; error: string; }\n\nkoukai teisu image_base = 4194304;\nkoukai teisu code_offset = 4096;\nkoukai teisu data_base = 268435456;\nteisu header_size = 64;\nteisu program_header_size = 56;\nteisu section_header_size = 64;\nteisu maximum_bss_size = 268435456;\n// The RX segment maps file bytes [0, text_end) at image_base, so it ends at image_base + text_end.\n// The RW segment starts at data_base. To keep the two mappings from overlapping, text_end must satisfy\n// image_base + text_end <= data_base, i.e. text_end <= data_base - image_base (252 MiB).\nteisu maximum_text_end = 264241152;\n\nwaza put(out: []uint8, value: int64, width: int64) -> unit {\n    kaku x = value; kaku i = 0;\n    aida (i < width) { array.push(out, uint8(x - (x / 256) * 256)); x = x / 256; i = i + 1; }\n}\nwaza align(value: int64, boundary: int64) -> int64 {\n    kaku r = value - (value / boundary) * boundary;\n    moshi (r == 0) { kaesu value; }\n    kaesu value + boundary - r;\n}\nwaza program_header(out: []uint8, kind: int64, flags: int64, offset: int64, address: int64, file_size: int64, memory_size: int64, alignment: int64) -> unit {\n    put(out, kind, 4); put(out, flags, 4); put(out, offset, 8); put(out, address, 8); put(out, address, 8);\n    put(out, file_size, 8); put(out, memory_size, 8); put(out, alignment, 8);\n}\nwaza section_header(out: []uint8, name: int64, kind: int64, flags: int64, address: int64, offset: int64, size: int64, alignment: int64) -> unit {\n    put(out, name, 4); put(out, kind, 4); put(out, flags, 8); put(out, address, 8); put(out, offset, 8);\n    put(out, size, 8); put(out, 0, 4); put(out, 0, 4); put(out, alignment, 8); put(out, 0, 8);\n}\n\n// e_machine values (ELF specification): EM_X86_64 and EM_AARCH64.\nkoukai teisu machine_x86_64 = 62;\nkoukai teisu machine_aarch64 = 183;\n\nkoukai waza executable(spec: ImageSpec) -> ImageResult { kaesu executable_for(spec, machine_x86_64); }\n\n// AArch64 Linux images use 64 KiB PT_LOAD alignment so they load on 4 KiB, 16 KiB and 64 KiB page kernels.\nkoukai waza executable_aarch64(spec: ImageSpec) -> ImageResult { kaesu executable_for(spec, machine_aarch64); }\n\n// Any other e_machine fails closed (UNSUPPORTED_MACHINE); no silent fallback to another architecture.\nkoukai waza executable_for(spec: ImageSpec, machine: int64) -> ImageResult {\n    moshi (machine != machine_x86_64 && machine != machine_aarch64) { kaesu ImageResult { bytes: [], error: \"UNSUPPORTED_MACHINE\" }; }\n    kaku load_align = 4096; moshi (machine == machine_aarch64) { load_align = 65536; }\n    moshi (len(spec.code) == 0) { kaesu ImageResult { bytes: [], error: \"EMPTY_TEXT\" }; }\n    moshi (spec.entry_offset < 0 || spec.entry_offset >= len(spec.code)) { kaesu ImageResult { bytes: [], error: \"INVALID_ENTRY\" }; }\n    moshi (spec.bss_size < 0 || spec.bss_size > maximum_bss_size) { kaesu ImageResult { bytes: [], error: \"INVALID_BSS\" }; }\n    kaku phnum = 3; moshi (spec.bss_size == 0) { phnum = 2; }\n    kaku text_end = code_offset + len(spec.code);\n    moshi (text_end > maximum_text_end) { kaesu ImageResult { bytes: [], error: \"IMAGE_TOO_LARGE\" }; }\n    // .shstrtab: \"\\0.text\\0.bss\\0.shstrtab\\0\"\n    kaku names: []uint8 = [uint8(0)];\n    array.append_all(names, string.to_bytes(\".text\")); array.push(names, uint8(0));\n    array.append_all(names, string.to_bytes(\".bss\")); array.push(names, uint8(0));\n    array.append_all(names, string.to_bytes(\".shstrtab\")); array.push(names, uint8(0));\n    kaku names_offset = align(text_end, 8);\n    kaku sections_offset = align(names_offset + len(names), 8);\n    kaku out: []uint8 = array.with_capacity[uint8](sections_offset + 4 * section_header_size);\n    // ELF header\n    array.push(out, uint8(127)); array.push(out, uint8(69)); array.push(out, uint8(76)); array.push(out, uint8(70));\n    array.push(out, uint8(2)); array.push(out, uint8(1)); array.push(out, uint8(1)); array.push(out, uint8(0));\n    put(out, 0, 8);\n    put(out, 2, 2); put(out, machine, 2); put(out, 1, 4);\n    put(out, image_base + code_offset + spec.entry_offset, 8);\n    put(out, header_size, 8); put(out, sections_offset, 8);\n    put(out, 0, 4); put(out, header_size, 2); put(out, program_header_size, 2); put(out, phnum, 2);\n    put(out, section_header_size, 2); put(out, 4, 2); put(out, 3, 2);\n    program_header(out, 1, 5, 0, image_base, text_end, text_end, load_align);\n    moshi (spec.bss_size > 0) { program_header(out, 1, 6, 0, data_base, 0, spec.bss_size, load_align); }\n    program_header(out, 1685382481, 6, 0, 0, 0, 0, 16);\n    aida (len(out) < code_offset) { array.push(out, uint8(0)); }\n    array.append_all(out, spec.code);\n    aida (len(out) < names_offset) { array.push(out, uint8(0)); }\n    array.append_all(out, names);\n    aida (len(out) < sections_offset) { array.push(out, uint8(0)); }\n    section_header(out, 0, 0, 0, 0, 0, 0, 0);\n    section_header(out, 1, 1, 6, image_base + code_offset, code_offset, len(spec.code), 16);\n    section_header(out, 7, 8, 3, data_base, text_end, spec.bss_size, 8);\n    section_header(out, 12, 3, 0, 0, names_offset, len(names), 1);\n    kaesu ImageResult { bytes: out, error: \"\" };\n}\n" }; }
waza data_3() -> File { kaesu File { path: "kiso/aot/linuxarm64/linuxarm64.mio", version: "Bunko-v2.1.1", length: 6797, sha256: "624af8bfbe2b462ea4198fdd3d2703cdb8ff55c22844f68ac2bb15ef3a4f020c", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/elf\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// Linux AArch64 (generic syscall table, AAPCS64 registers) static image builder. First backend slice: it emits the\n// smallest genuine native program (write + exit_group). There is no libc, no loader and no fallback to another CPU.\n// Syscall numbers are from the Linux generic table used by arm64 (not the x86-64 table): write=64, exit_group=94.\nkoukai teisu syscall_write = 64;\nkoukai teisu syscall_exit_group = 94;\n\nkoukai kata Program { code: []uint8; error: string; }\n\nwaza push_word(out: []uint8, word: uint32) -> unit {\n    kaku value = int64(word); kaku i = 0;\n    aida (i < 4) { array.push(out, uint8(value - (value / 256) * 256)); value = value / 256; i = i + 1; }\n}\n\n// write(1, message, len(message)); exit_group(status). The message bytes follow the code in the same RX segment and are\n// addressed PC-relative with ADR, so the image needs no relocation.\nkoukai waza hello_program(message: string, status: int64) -> Program {\n    kaku text = string.to_bytes(message);\n    moshi (len(text) == 0 || len(text) > 65535) { kaesu Program { code: [], error: \"INVALID_MESSAGE\" }; }\n    moshi (status < 0 || status > 255) { kaesu Program { code: [], error: \"INVALID_STATUS\" }; }\n    kaku c = arm64.assembler();\n    // eight instructions; ADR is instruction 1 (byte 4) and the message starts at byte 32\n    kaku failure = arm64.assembler_emit(c, arm64.movz_x(0, 1, 0));\n    arm64.assembler_emit(c, arm64.adr(1, 28));\n    arm64.assembler_emit(c, arm64.movz_x(2, len(text), 0));\n    arm64.assembler_emit(c, arm64.movz_x(8, syscall_write, 0));\n    arm64.assembler_emit(c, arm64.svc(0));\n    arm64.assembler_emit(c, arm64.movz_x(0, status, 0));\n    arm64.assembler_emit(c, arm64.movz_x(8, syscall_exit_group, 0));\n    arm64.assembler_emit(c, arm64.svc(0));\n    kaku assembled = arm64.assembler_assemble(c);\n    moshi (assembled.error != mu) { kaesu Program { code: [], error: \"ENCODE\" }; }\n    kaku code: []uint8 = [];\n    kaku i = 0;\n    aida (i < len(assembled.words)) { push_word(code, assembled.words[i]); i = i + 1; }\n    array.append_all(code, text);\n    aida (len(code) - (len(code) / 4) * 4 != 0) { array.push(code, uint8(0)); }\n    kaesu Program { code: code, error: \"\" };\n}\n\n// A complete Linux AArch64 ELF64 executable for hello_program.\nkoukai waza hello_image(message: string, status: int64) -> elf.ImageResult {\n    kaku program = hello_program(message, status);\n    moshi (program.error != \"\") { kaesu elf.ImageResult { bytes: [], error: program.error }; }\n    kaesu elf.executable_aarch64(elf.ImageSpec { code: program.code, entry_offset: 0, bss_size: 0 });\n}\n\n// ---- Image for lowered Mochi programs (kiso/aot/lower, compile_linux_arm64)\n//\n// The lowered words use the Darwin entry convention main(argc, argv, envp) in x0-x2 and address constants and globals\n// through ADRP/ADD patches. This container lays the image out as: [words][pad to 8][constants][pad to 4][_start], and\n// reserves globals*8 bytes in the zero-filled data segment (elf.data_base). `_start` converts the Linux initial stack\n// (argc, argv[], NULL, envp[]) into x0-x2 and branches to word 0. Addresses are absolute, so ADRP page deltas are\n// computed from the real code and data addresses.\nteisu maximum_globals = 10244;\nteisu maximum_image_size = 67108864;\n\nwaza align(value: int64, boundary: int64) -> int64 {\n    kaku remainder = value - (value / boundary) * boundary;\n    moshi (remainder == 0) { kaesu value; }\n    kaesu value + boundary - remainder;\n}\n\nwaza image_failed(message: string) -> elf.ImageResult { kaesu elf.ImageResult { bytes: [], error: message }; }\n\nkoukai waza image(spec: macho.ImageSpec) -> elf.ImageResult {\n    moshi (len(spec.words) == 0) { kaesu image_failed(\"EMPTY_TEXT\"); }\n    moshi (spec.globals < 0 || spec.globals > maximum_globals) { kaesu image_failed(\"TOO_MANY_GLOBALS\"); }\n    moshi (len(spec.words) > maximum_image_size / 4 || len(spec.constants) > maximum_image_size) { kaesu image_failed(\"IMAGE_TOO_LARGE\"); }\n    kaku code_base = elf.image_base + elf.code_offset;\n    kaku const_offset = align(len(spec.words) * 4, 8);\n    kaku words = array.clone(spec.words);\n    kaku index = 0;\n    aida (index < len(spec.patches)) {\n        kaku patch = spec.patches[index];\n        moshi (patch.at_word < 0 || patch.at_word >= len(words) || patch.target_offset < 0 || patch.target.kind < 0 || patch.target.kind > 2) { kaesu image_failed(\"INVALID_PATCH\"); }\n        kaku target = code_base + patch.target_offset;\n        moshi (patch.target.kind == 0 && patch.target_offset >= len(spec.words) * 4) { kaesu image_failed(\"INVALID_PATCH\"); }\n        moshi (patch.target.kind == 1) {\n            moshi (patch.target_offset >= len(spec.constants)) { kaesu image_failed(\"INVALID_PATCH\"); }\n            target = code_base + const_offset + patch.target_offset;\n        }\n        moshi (patch.target.kind == 2) {\n            moshi (patch.target_offset >= spec.globals * 8) { kaesu image_failed(\"INVALID_PATCH\"); }\n            target = elf.data_base + patch.target_offset;\n        }\n        kaku encoded = arm64.adrp_offset(patch.register, code_base + patch.at_word * 4, target);\n        moshi (encoded.error != mu) { kaesu image_failed(\"ENCODE\"); }\n        words[patch.at_word] = encoded.word;\n        moshi (patch.add_at_word >= 0) {\n            moshi (patch.add_at_word >= len(words) || patch.add_at_word == patch.at_word) { kaesu image_failed(\"INVALID_PATCH\"); }\n            kaku addition = arm64.add_imm_x(patch.register, patch.register, target - (target / 4096) * 4096, iie);\n            moshi (addition.error != mu) { kaesu image_failed(\"ENCODE\"); }\n            words[patch.add_at_word] = addition.word;\n        }\n        index = index + 1;\n    }\n    kaku code: []uint8 = array.with_capacity[uint8](len(spec.words) * 4 + len(spec.constants) + 64);\n    index = 0;\n    aida (index < len(words)) { push_word(code, words[index]); index = index + 1; }\n    aida (len(code) < const_offset) { array.push(code, uint8(0)); }\n    array.append_all(code, spec.constants);\n    aida (len(code) - (len(code) / 4) * 4 != 0) { array.push(code, uint8(0)); }\n    kaku start = len(code);\n    // _start: x0 = argc, x1 = &argv[0], x2 = &envp[0] = argv + 8 * (argc + 1); then branch to word 0.\n    kaku sequence = [arm64.ldr_x(0, 31, 0), arm64.add_imm_x(1, 31, 8, iie), arm64.add_imm_x(3, 0, 1, iie), arm64.lsl_x(3, 3, 3),\n        arm64.add_x(2, 1, 3), arm64.b(-(start / 4) - 5)];\n    index = 0;\n    aida (index < len(sequence)) {\n        moshi (sequence[index].error != mu) { kaesu image_failed(\"ENCODE\"); }\n        push_word(code, sequence[index].word); index = index + 1;\n    }\n    kaesu elf.executable_aarch64(elf.ImageSpec { code: code, entry_offset: start, bss_size: spec.globals * 8 });\n}\n" }; }
