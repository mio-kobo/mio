x86_64.jcc(code, x86_64.cc_e, \"rt.word_wait.ready\");\n    x86_64.mov_load(code, x86_64.r10, x86_64.rax, rec_rbp);\n    x86_64.mov_load(code, x86_64.r11, x86_64.rax, rec_ret);\n    x86_64.call(code, \"rt.gc.park\");\n    x86_64.label(code, \"rt.word_wait.ready\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.pop_r(code, x86_64.r13);\n    x86_64.pop_r(code, x86_64.r12);\n    x86_64.ret(code);\n}\n\nkoukai waza emit_mutator_support(code: x86_64.Assembler) -> unit {\n    emit_lock_routines(code);\n    emit_alloc_wrapper(code);\n    emit_mut_init(code);\n    emit_park(code);\n    emit_blocking_region(code);\n    emit_chain_scan(code);\n    emit_unlink(code);\n    emit_slot_routines(code);\n    emit_thread_start(code);\n    emit_thread_join(code);\n    emit_word_natives(code);\n}\n" }; }
waza data_42() -> File { kaesu File { path: "kiso/aot/lowerlinux/runtime_fs.mio", version: "Bunko-v2.1.1", length: 39209, sha256: "55c4895b47379f655a2ca9a941a7a73615f87a37055833537f2ada919857f8e6", source: "yobu \"kiso/aot/elf\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// Linux NativeFS bridge for the body-less \"mio/fs/runtime\" functions of kiso/fs.\n// Resource token = generation << 16 | (slot + 1). The 4096-slot handle table lives in the data segment, after the directory\n// buffers (see gc.mio): 3 words per slot: fd, state (0 free, 1 open, 10 + code failed), generation. Directory handles\n// (the directory table and buffers below are sized for 64 entries) are only ever allocated in slots 0..63.\n// Status codes follow kiso/fs: 0 ok, 1 not found, 2 permission, 3 closed, 4 invalid argument, 5 I/O, 6 no space, 7 invalid path.\nwaza handle_table_base() -> int64 { kaesu elf.data_base + 8192 + 2097152; }\nwaza handle_slots() -> int64 { kaesu 4096; }\nwaza directory_slots() -> int64 { kaesu 64; }\n\nwaza emit_string_object(code: x86_64.Assembler, label: string, text: string) -> unit {\n    x86_64.label(code, label);\n    kaku bytes = string.to_bytes(text);\n    kaku size = 24 + len(bytes);\n    size = size + 7 - ((size + 7) - ((size + 7) / 8) * 8);\n    emit_word(code, 256 * size + 6);\n    emit_word(code, 0);\n    emit_word(code, len(bytes));\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        x86_64.byte(code, int64(bytes[at]));\n        at = at + 1;\n    }\n}\n\nwaza message_for(code: int64) -> string {\n    moshi (code == 1) { kaesu \"no such file or directory\"; }\n    moshi (code == 2) { kaesu \"permission denied\"; }\n    moshi (code == 3) { kaesu \"file already closed\"; }\n    moshi (code == 4) { kaesu \"invalid argument\"; }\n    moshi (code == 6) { kaesu \"no space left on device\"; }\n    moshi (code == 7) { kaesu \"invalid path\"; }\n    kaesu \"input/output error\";\n}\n\nwaza message_label(code: int64) -> string { kaesu string.concat(\"rt.fs.message.\", convert.format_int(code)); }\n\nwaza leave_frame(code: x86_64.Assembler) -> unit {\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n}\n\nwaza emit_fs_support(code: x86_64.Assembler) -> unit {\n    // rt.fs_classify: rax = errno -> rax = status code\n    x86_64.label(code, \"rt.fs_classify\");\n    kaku errnos: []int64 = [2, 13, 1, 9, 28, 22];\n    kaku codes: []int64 = [1, 2, 2, 3, 6, 4];\n    kaku at = 0;\n    aida (at < len(errnos)) {\n        kaku next = string.concat(\"rt.fs_classify.next.\", convert.format_int(at));\n        x86_64.cmp_ri(code, x86_64.rax, errnos[at]);\n        x86_64.jcc(code, x86_64.cc_ne, next);\n        x86_64.mov_ri(code, x86_64.rax, codes[at]);\n        x86_64.ret(code);\n        x86_64.label(code, next);\n        at = at + 1;\n    }\n    x86_64.mov_ri(code, x86_64.rax, 5);\n    x86_64.ret(code);\n\n    // rt.fs_message: rax = status code -> rax = message string\n    x86_64.label(code, \"rt.fs_message\");\n    at = 0;\n    aida (at < 8) {\n        kaku next = string.concat(\"rt.fs_message.next.\", convert.format_int(at));\n        x86_64.cmp_ri(code, x86_64.rax, at);\n        x86_64.jcc(code, x86_64.cc_ne, next);\n        x86_64.lea_label(code, x86_64.rax, message_label(at));\n        x86_64.ret(code);\n        x86_64.label(code, next);\n        at = at + 1;\n    }\n    x86_64.lea_label(code, x86_64.rax, message_label(5));\n    x86_64.ret(code);\n\n    // rt.fs_alloc: rdi = fd, rsi = state -> rax = token (0 when the table is full)\n    x86_64.label(code, \"rt.fs_alloc\");\n    x86_64.mov_ri(code, x86_64.r10, handle_slots());\n    x86_64.jmp(code, \"rt.fs_alloc.start\");\n    // rt.fs_alloc_dir: same, but only slots 0..63 (the directory table and buffers have 64 entries)\n    x86_64.label(code, \"rt.fs_alloc_dir\");\n    x86_64.mov_ri(code, x86_64.r10, directory_slots());\n    x86_64.label(code, \"rt.fs_alloc.start