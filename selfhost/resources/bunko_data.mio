    wx_label(c, \"wx_fcntl_failed\");\n    wx_fail_last(c, patches, 2304);\n    wx_label(c, \"wx_fcntl_badfd\");\n    wx_free(c, 2304);\n    wx_b(c, \"wx_badfd\");\n    wx_label(c, \"wx_fcntl_other\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n\n    // ---- proc_info(PIDINFO = 2, pid, PIDPATHINFO = 11, 0, buffer, size) -> GetModuleFileNameW(NULL) as UTF-8\n    wx_label(c, \"wx_procinfo\");\n    wx_cmpi(c, 0, 2);\n    wx_bcc(c, 1, \"wx_unsupported\");\n    wx_cmpi(c, 2, 11);\n    wx_bcc(c, 1, \"wx_unsupported\");\n    wx_alloc(c, 2304);\n    wx_str(c, 4, 2048);\n    wx_str(c, 5, 2056);\n    wx_li(c, 0, 0);\n    wx(c, arm64.add_imm_x(1, 31, 0, iie));\n    wx_li(c, 2, 1024);\n    wx_call(c, patches, \"GetModuleFileNameW\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"wx_procinfo_failed\");\n    wx_li(c, 0, 65001);\n    wx_li(c, 1, 0);\n    wx(c, arm64.add_imm_x(2, 31, 0, iie));\n    wx(c, arm64.movn_x(3, 0, 0));\n    wx_ldr(c, 4, 2048);\n    wx_ldr(c, 5, 2056);\n    wx_li(c, 6, 0);\n    wx_li(c, 7, 0);\n    wx_call(c, patches, \"WideCharToMultiByte\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"wx_procinfo_failed\");\n    wx_slashes(c, 2048, \"wx_procinfo_slashes\");\n    wx_free(c, 2304);\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_procinfo_failed\");\n    wx_fail_last(c, patches, 2304);\n\n    // ---- system queries: physical memory is unavailable, the memory-pressure level is optional, no resource limits\n    wx_label(c, \"wx_sysctl\");\n    wx_li(c, 0, 2);\n    wx_b(c, \"wx_error\");\n    wx_label(c, \"wx_sysctlbyname\");\n    wx_li(c, 0, 2);\n    wx_b(c, \"wx_error\");\n    wx_label(c, \"wx_getrlimit\");\n    wx(c, arm64.movn_x(9, 0, 0));\n    wx(c, arm64.lsr_x(9, 9, 1));\n    wx(c, arm64.str_x(9, 1, 0));\n    wx(c, arm64.str_x(9, 1, 8));\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n\n    // ================= process emulation =================\n    // Windows has no fork. The Darwin runtime's spawn is fork; (redirect fds, set limits); execve in the child; wait4 in the\n    // parent. fork saves the caller's context and returns as the \"child\" in this same process; the child path only touches the\n    // descriptor table (dup2/close/open), the limits (setitimer/setrlimit, recorded) and then calls execve, which performs the\n    // real CreateProcessW, waits (killing the process with status 142 after the timeout), restores the descriptor table and\n    // resumes the parent at the saved context with the child's status for wait4. exit() in the child resumes the parent too.\n    wx_label(c, \"wx_fork\");\n    wx(c, arm64.add_imm_x(9, 31, 288, iie));\n    wx_put(c, patches, base, 9, 132);\n    wx(c, arm64.ldr_x(9, 31, 120));\n    wx_put(c, patches, base, 9, 133);\n    wx(c, arm64.ldr_x(9, 31, 288));\n    wx_put(c, patches, base, 9, 134);\n    wx_data(c, patches, base, 11, 136);\n    kaku reg = 0;\n    aida (reg < 14) {\n        wx(c, arm64.ldr_x(9, 31, reg * 8));\n        wx(c, arm64.str_x(9, 11, reg * 8));\n        reg = reg + 1;\n    }\n    wx(c, arm64.ldr_x(9, 31, 112));\n    wx(c, arm64.str_x(9, 11, 112));\n    // the callee-saved registers and the frame pointer: the emulated child path enters routines that never unwind\n    wx(c, arm64.stp_x(19, 20, 11, 120));\n    wx(c, arm64.stp_x(21, 22, 11, 136));\n    wx(c, arm64.stp_x(23, 24, 11, 152));\n    wx(c, arm64.stp_x(25, 26, 11, 168));\n    wx(c, arm64.stp_x(27, 28, 11, 184));\n    wx(c, arm64.str_x(29, 11, 200));\n    wx_data(c, patches, base, 11, 0);\n    wx_data(c, patches, base, 12, 192);\n    wx_li(c, 13, 0);\n    wx_label(c, \"wx_fork_snapshot\");\n    wx(c, arm64.lsl_x(14, 13, 3));\n    wx(c, arm64.add_x(15, 11, 14));\n    wx(c, arm64.ldr_x(9, 15, 0));\n    wx(c, arm64.add_x(15, 12, 14));\n    wx(c, arm64.str_x(9, 15, 0));\n    wx(c, arm64.add_imm_x(13, 13, 1, iie));\n    wx_cmpi(c, 13, 64);\n    wx_bcc(c, 3, \"wx_fork_snapshot\");\n    wx_li(c, 9, 1);\n    wx_put(c, patches, base, 9, 128);\n    wx_li(c, 9, 0);\n    wx_put(c, patches, base, 9, 129);\n    wx_li(c, 9, 1);\n    wx(c, arm64.str_x(9, 31, 128));\n    wx_li(c, 0, 4243);\n    wx_b(c, \"wx_ok\");\n\n    // resume the parent after fork: x0 = child pid (x1 = 0, carry clear, x2-x15 and x17 restored, caller's lr slot rebuilt)\n    wx_label(c, \"wx_resume\");\n    wx_data(c, patches, base, 16, 132);\n    wx(c, arm64.ldr_x(9, 16, 0));\n    wx(c, arm64.add_imm_x(31, 9, 0, iie));\n    wx_data(c, patches, base, 16, 134);\n    wx(c, arm64.ldr_x(9, 16, 0));\n    wx(c, arm64.str_x(9, 31, 0));\n    wx(c, arm64.str_x(31, 31, 8));\n    wx_data(c, patches, base, 16, 136);\n    wx(c, arm64.ldp_x(2, 3, 16, 0));\n    wx(c, arm64.ldp_x(4, 5, 16, 16));\n    wx(c, arm64.ldp_x(6, 7, 16, 32));\n    wx(c, arm64.ldp_x(8, 9, 16, 48));\n    wx(c, arm64.ldp_x(10, 11, 16, 64));\n    wx(c, arm64.ldp_x(12, 13, 16, 80));\n    wx(c, arm64.ldp_x(14, 15, 16, 96));\n    wx(c, arm64.ldr_x(17, 16, 112));\n    wx(c, arm64.ldp_x(19, 20, 16, 120));\n    wx(c, arm64.ldp_x(21, 22, 16, 136));\n    wx(c, arm64.ldp_x(23, 24, 16, 152));\n    wx(c, arm64.ldp_x(25, 26, 16, 168));\n    wx(c, arm64.ldp_x(27, 28, 16, 184));\n    wx(c, arm64.ldr_x(29, 16, 200));\n    wx_data(c, patches, base, 16, 133);\n    wx(c, arm64.ldr_x(30, 16, 0));\n    wx_li(c, 1, 0);\n    wx(c, arm64.cmn_imm_x(0, 0, iie));\n    wx(c, arm64.ret());\n\n    // the emulated child finished with exit code x0: record it, restore the descriptor table, resume the parent\n    wx_label(c, \"wx_child_done\");\n    wx_put(c, patches, base, 0, 130);\n    wx_li(c, 9, 4243);\n    wx_put(c, patches, base, 9, 131);\n    wx(c, arm64.str_x(31, 31, 152));\n    wx_label(c, \"wx_child_restore\");\n    wx(c, arm64.ldr_x(9, 31, 152));\n    wx_cmpi(c, 9, 64);\n    wx_bcc(c, 2, \"wx_child_restored\");\n    wx_data(c, patches, base, 11, 0);\n    wx_data(c, patches, base, 12, 192);\n    wx(c, arm64.ldr_x(9, 31, 152));\n    wx(c, arm64.lsl_x(13, 9, 3));\n    wx(c, arm64.add_x(14, 11, 13));\n    wx(c, arm64.ldr_x(15, 14, 0));\n    wx(c, arm64.add_x(16, 12, 13));