");\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    kaesu f;\n}\nwaza sweep_old_prepare_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_prepare\");\n    ir.invoke_function(f, \"gc_sweep_abort_join\", 6, [0]);\n    ir.branch(f, ir.nonzero, 6, \"failed\");\n    ir.invoke_function(f, \"gc_old_prepare_mark_base\", 6, [0, 1, 2, 3, 4, 5]);\n    ir.branch(f, ir.label, 0, \"failed\");\n    ir.put(f, ir.result, 0, 6, 0, 0);\n    kaesu f;\n}\nwaza sweep_old_remark_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_remark\");\n    ir.invoke_function(f, \"gc_old_remark_mark_base\", 5, [0, 1]);\n    ir.branch(f, ir.nonzero, 5, \"failed\");\n    ir.invoke_function(f, \"gc_sweep_prepare\", 5, [0]);\n    ir.branch(f, ir.nonzero, 5, \"failed\");\n    ir.invoke_function(f, \"gc_sweep_launch\", 5, [0]);\n    ir.branch(f, ir.label, 0, \"failed\");\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    kaesu f;\n}\nwaza sweep_old_abort_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_abort_join\");\n    ir.invoke_function(f, \"gc_old_abort_mark_join\", 10, [0]);\n    ir.invoke_function(f, \"gc_sweep_abort_join\", 5, [0]);\n    ir.branch(f, ir.nonzero, 5, \"failed\");\n    ir.put(f, ir.copy, 5, 10, 0, 0);\n    ir.branch(f, ir.label, 0, \"failed\");\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    kaesu f;\n}\nkoukai waza concurrent_sweep_program(functions: []ir.Function, control_link_offset: int64, owned_context_bytes: int64) -> []ir.Function {\n    kaku result: []ir.Function = [];\n    moshi (control_link_offset<thread_context_bytes || owned_context_bytes<8 || control_link_offset>owned_context_bytes - 8 || control_link_offset - (control_link_offset / 8) * 8 != 0) {\n        kaesu result;\n    }\n    kaku names = [\"gc_old_inspect\", \"gc_old_prepare\", \"gc_old_remark\", \"gc_old_abort_join\", \"gc_heap_enter\", \"gc_end\", \"gc_old_note_minor\", \"gc_old_promoted\", \"gc_old_cancel\"];\n    kaku bases = [\"gc_old_inspect_base\", \"gc_old_prepare_mark_base\", \"gc_old_remark_mark_base\", \"gc_old_abort_mark_join\", \"gc_heap_enter_base\", \"gc_end_mark_base\", \"gc_old_note_minor_mark_base\", \"gc_old_promoted_mark_base\", \"gc_old_cancel_mark_base\"];\n    kaku found = 0;\n    kaku i = 0;\n    aida (i<len(functions)) {\n        kaku f = functions[i];\n        kaku j = 0;\n        kaku which = -1;\n        aida (j<len(names)) {\n            moshi (f.name == names[j]) {\n                which = j;\n            }\n            j = j + 1;\n        }\n        moshi (which<0) {\n            array.push(result, f);\n        } sore {\n            array.push(result, ir.Function {\n                    name: bases[which], steps: f.steps });\n            found = found + 1;\n        }\n        i = i + 1;\n    }\n    moshi (found != len(names)) {\n        kaku invalid: []ir.Function = [];\n        kaesu invalid;\n    }\n    array.append_all(result, [sweep_lock_program(), sweep_unlock_program(), sweep_side_program(), sweep_inspect_program(), sweep_remembered_program(), sweep_step_program(), sweep_worker_program(), sweep_join_program(), sweep_clear_claims_program(), sweep_abort_program(), sweep_prepare_program(), sweep_launch_program(), sweep_resumed_program(), sweep_observe_program(), sweep_finish_program(), sweep_retry_program(), sweep_heap_enter_program(control_link_offset), sweep_end_epoch_program(control_link_offset), sweep_old_prepare_program(), sweep_old_remark_program(), sweep_old_abort_program(), sweep_minor_note_program(), sweep_promotion_note_program(), sweep_reused_program(), sweep_cancel_old_program()]);\n    kaesu result;\n}\n\n// Actual collection/promotion hooks; final totals alone cannot prove they\n// occurred while Sweep was running. A Mutator must own the same allocator lock.\nwaza sweep_minor_note_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_note_minor\");\n    ir.invoke_function(f, \"gc_old_note_minor_mark_base\", 5, [0]);\n    ir.branch(f, ir.nonzero, 5, \"failed\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 712);\n    tconstant(f, 6, 2);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"done\");\n    ir.put(f, ir.acquire_load, 6, 0, 0, 512);\n    ir.branch(f, ir.zero, 6, \"invalid\");\n    tcheck(f, 6, 1, \"invalid\");\n    tconstant(f, 5, 1);\n    sweep_add(f, 768, 5);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    ir.branch(f, ir.label, 0, \"invalid\");\n    tconstant(f, 5, 4);\n    sweep_fail(f, 5);\n    ir.branch(f, ir.label, 0, \"failed\");\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    kaesu f;\n}\nwaza sweep_promotion_note_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_promoted\");\n    ir.invoke_function(f, \"gc_old_promoted_mark_base\", 5, [0, 1]);\n    ir.branch(f, ir.nonzero, 5, \"failed\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 712);\n    tconstant(f, 6, 2);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"done\");\n    ir.put(f, ir.acquire_load, 6, 0, 0, 512);\n    ir.branch(f, ir.zero, 6, \"invalid\");\n    tcheck(f, 6, 1, \"invalid\");\n    ir.branch(f, ir.zero, 1, \"invalid\");\n    tconstant(f, 6, 16);\n    ir.put(f, ir.subtract, 10, 1, 6, 0);\n    ir.put(f, ir.acquire_load, 10, 10, 0, 0);\n    old_bit(f, 10, 11, sweep_claim_bit);\n    ir.branch(f, ir.nonzero, 11, \"invalid\");\n    old_bit(f, 10, 11, old_generation_bit);\n    ir.branch(f, ir.zero, 11, \"invalid\");\n    tconstant(f, 5, 1);\n    sweep_add(f, 776, 5);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    ir.branch(f, ir.label, 0, \"invalid\");\n    tconstant(f, 5, 4);\n    sweep_fail(f, 5);\n    ir.branch(f, ir.label, 0, \"failed\");\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    kaesu f;\n}\n\n// Called only from the actual native allocator free-bin take, before the new\n// object header overwrites the free span. side.rememberedNext is unused on a\n// free header and records this exact Sweep epoch; gen_register clears it.\nwaza sweep_reused_program() -> ir.Function {\n    kaku f = ir.function(\"gc_sweep_reused\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 512);\n    ir.branch(f, ir.zero, 5, \"invalid\");\n    tcheck(f, 5, 1, \"invalid\");\n    ir.put(f, ir.acquire_load, 10, 1, 0, 0);\n    ir.branch(f, ir.nonzero, 10, \"invalid\");\n    ir.invoke_function(f, \"gc_sweep_side\", 10, [0, 1]);\n    ir.put(f, ir.load, 11, 10, 0, 8);\n    ir.put(f, ir.load, 12, 0, 0, 704);\n    ir.branch(f, ir.zero, 12, \"done\");\n    ir.put(f, ir.equal, 13, 11, 12, 0);\n    ir.branch(f, ir.zero, 13, \"done\");\n    tconstant(f, 5, 1);\n    sweep_add(f, 816, 5);\n    ir.put(f, ir.acquire_load, 5, 0, 0, 712);\n    tconstant(f, 6, 2);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"done\");\n    tconstant(f, 5, 1);\n    sweep_add(f, 808, 5);\n    ir.put(f, ir.load, 5, 0, 0, 824);\n    ir.branch(f, ir.nonzero, 5, \"done\");\n    ir.put(f, ir.release_store, 0, 0, 1, 824);\n    ir.put(f, ir.release_store, 0, 0, 12, 832);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    ir.branch(f, ir.label, 0, \"invalid\");\n    tconstant(f, 5, 4);\n    sweep_fail(f, 5);\n    treturn(f, 4);\n    kaesu f;\n}\n\nwaza sweep_cancel_old_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_cancel\");\n    ir.invoke_function(f, \"gc_old_cancel_mark_base\", 5, [0]);\n    ir.put(f, ir.acquire_load, 5, 0, 0, 712);\n    ir.branch(f, ir.zero, 5, \"done\");\n    tcheck(f, 5, 3, \"done\");\n    tcheck(f, 5, 4, \"done\");\n    tconstant(f, 5, 4);\n    ir.put(f, ir.release_store, 0, 0, 5, 712);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    kaesu f;\n}\n" }; }
waza data_113() -> File { kaesu File { path: "kiso/runtime/gc/operations.mio", version: "Bunko-v2.1.1", length: 3650, sha256: "d5ac8a1c83dca12a3d8075b9ae5570f62ba38ac8d6aab2d423777e6a89d6c40a", source: "// Semantic runtime IR. Operands are virtual values, never CPU registers.\n// Operations return status explicitly; failure may not be silently discarded.\nkoukai teisu relaxed = 0;\nkoukai teisu acquire = 1;\nkoukai teisu release = 2;\nkoukai teisu acq_rel = 3;\nkoukai teisu seq_cst = 4;\nkoukai teisu atomic_load = 1;\nkoukai teisu atomic_store = 2;\nkoukai teisu atomic_cas = 3;\nkoukai teisu atomic_add = 4;\nkoukai teisu fence = 5;\nkoukai teisu thread_start = 6;\nkoukai teisu thread_join = 7;\nkoukai teisu thread_identity = 8;\nkoukai teisu tls_get = 9;\nkoukai teisu tls_set = 10;\nkoukai teisu park = 11;\nkoukai teisu wake = 12;\nkoukai teisu reserve = 13;\nkoukai teisu commit = 14;\nkoukai teisu decommit = 15;\nkoukai teisu memory_release = 16;\nkoukai teisu clock = 17;\nkoukai teisu pressure = 18;\nkoukai teisu roots = 19;\nkoukai teisu safepoint = 20;\nkoukai teisu write_barrier = 21;\nkoukai teisu protect = 22;\nkoukai teisu tls_create = ir.tls_create;\nkoukai teisu tls_destroy = ir.tls_destroy;\nkoukai teisu mutex_create = ir.mutex_create;\nkoukai teisu mutex_destroy = ir.mutex_destroy;\nkoukai teisu mutex_lock = ir.mutex_lock;\nkoukai teisu mutex_unlock = ir.mutex_unlock;\nkoukai teisu condition_create = ir.condition_create;\nkoukai teisu condition_destroy = ir.condition_destroy;\nkoukai teisu abort_runtime = ir.abort_runtime;\n\n// CAS returns the observed old value. On failure no store occurs. Failure\n// order cannot release or exceed success order. Strong CAS retries spurious\n// failure. RMW arithmetic wraps at 64 bits. Addresses must be 8-byte aligned.\n// Park compares the wait word with expected while holding the wait protocol's\n// lock, atomically releases it while sleeping and rechecks after every wake.\n// Deadlines use monotonic nanoseconds; timeout/failure is distinct from wake.\n// Roots requires a completed handshake for this epoch, never a running frame.\n// Barrier preserves overwritten references BEFORE publishing the new edge and\n// records Old->Young AFTER it. Its operands must carry precise layout identity.\nkoukai kata RuntimeOp {\n    kind: int64;\n    address: int64;\n    value: int64;\n    expected: int64;\n    result: int64;\n    status: int64;\n    order: int64;\n    failure_order: int64;\n    alignment: int64;\n    epoch: int64;\n}\nkoukai waza operation(kind: int64) -> RuntimeOp {\n    kaesu RuntimeOp { kind: kind, address: 0, value: 1, expected: 2,\n        result: 3, status: 4, order: relaxed, failure_order: relaxed,\n        alignment: 8, epoch: 0 };\n}\nkoukai waza valid_operation(op: RuntimeOp) -> bool {\n    moshi (op.kind < atomic_load || op.kind > abort_runtime || op.address < 0 ||\n        op.value < 0 || op.expected < 0 || op.result < 0 || op.status < 0 ||\n        op.epoch < 0 || op.order < relaxed || op.order > seq_cst ||\n        op.failure_order < relaxed || op.failure_order > seq_cst) { kaesu iie; }\n    moshi (op.kind <= atomic_add && (op.alignment < 8 || op.alignment - (op.alignment / 8) * 8 != 0)) { kaesu iie; }\n    moshi (op.kind == atomic_load && op.order != relaxed && op.order != acquire && op.order != seq_cst) { kaesu iie; }\n    moshi (op.kind == atomic_store && op.order != relaxed && op.order != release && op.order != seq_cst) { kaesu iie; }\n    moshi (op.kind == atomic_cas) {\n        moshi (op.failure_order != relaxed && op.failure_order != acquire && op.failure_order != seq_cst) { kaesu iie; }\n        moshi (op.failure_order == acquire && op.order != acquire && op.order != acq_rel && op.order != seq_cst) { kaesu iie; }\n        moshi (op.failure_order == seq_cst && op.order != seq_cst) { kaesu iie; }\n    }\n    moshi (op.kind == fence && op.order == relaxed) { kaesu iie; }\n    kaesu hai;\n}\n" }; }
waza data_114() -> File { kaesu File { path: "kiso/runtime/gc/protocol.mio", version: "Bunko-v2.1.1", length: 2558, sha256: "2be016d971b766eeacbb211967db9201020508beef30696fb4a03838d87fe473", source: "// Platform-independent collector phase protocol. Scalar-only functions can be\n// compiled without managed allocation. Backend integration is gated separately:\n// these predicates do not by themselves stop threads or publish roots.\nkoukai teisu idle = 0;\nkoukai teisu init_handshake = 1;\nkoukai teisu concurrent_mark = 2;\nkoukai teisu remark_handshake = 3;\nkoukai teisu concurrent_sweep = 4;\nkoukai teisu aborted = 5;\n// Every predicate describes the CURRENT epoch. Callers must acquire the epoch\n// snapshot before evaluating; stale acknowledgements cannot count as parked.\n// A failure enters a non-reclaiming terminal phase. Recovery requires a full\n// join + stop + reinitialize protocol, never a transition directly back to Idle.\nkoukai waza next_phase(phase: int64, requested: bool, all_parked: bool,\n    roots_complete: bool, queues_empty: bool, producers_quiet: bool,\n    sweep_complete: bool, readers_quiet: bool, failed: bool) -> int64 {\n    moshi (phase<idle || phase>aborted) { kaesu -1; }\n    moshi (failed || phase == aborted) { kaesu aborted; }\n    moshi (phase == idle) {\n        moshi (requested) {\n            kaesu init_handshake;\n        }\n        kaesu idle;\n    }\n    moshi (phase == init_handshake) {\n        moshi (all_parked && roots_complete) {\n            kaesu concurrent_mark;\n        }\n        kaesu init_handshake;\n    }\n    moshi (phase == concurrent_mark) {\n        moshi (queues_empty && producers_quiet) {\n            kaesu remark_handshake;\n        }\n        kaesu concurrent_mark;\n    }\n    moshi (phase == remark_handshake) {\n        moshi (all_parked && roots_complete && queues_empty && producers_quiet) { kaesu concurrent_sweep; }\n        kaesu remark_handshake;\n    }\n    moshi (sweep_complete && readers_quiet) { kaesu idle; }\n    kaesu concurrent_sweep;\n}\nkoukai waza minor_allowed(phase: int64) -> bool { kaesu phase == idle; }\nkoukai waza may_reclaim(phase: int64, proven_dead: bool, readers_quiet: bool, epoch_matches: bool) -> bool {\n    kaesu phase == concurrent_sweep && proven_dead && readers_quiet && epoch_matches;\n}\nkoukai waza needs_satb(phase: int64, pointer_slot: bool) -> bool {\n    kaesu pointer_slot && (phase == concurrent_mark || phase == remark_handshake);\n}\n// Queue exhaustion must request remark/backpressure before overwriting a slot.\n// Until the old reference has been published/drained, the pointer store is held.\nkoukai waza pointer_store_allowed(phase: int64, pointer_slot: bool, old_reference_saved: bool) -> bool {\n    kaesu !needs_satb(phase, pointer_slot) || old_reference_saved;\n}\n" }; }
waza data_115() -> File { kaesu File { path: "kiso/runtime/gc/safepoints.mio", version: "Bunko-v2.1.1", length: 13167, sha256: "5bff968f9d7d92e7a832eca9e5885c29a457b71058bdde8cea0e79f215860c1f", source: "// Shadow descriptor v2 为增量扩展：直接帧保留原有 ABI。\nkoukai teisu shadow_indirect_factor = 4294967296;\n\n// 协作式线程/注册表 ABI v3 在 v2 注册表基础上扩展了两个字；对象堆 ABI 保持不变。\n// 此处所有算法均生成中立 Runtime IR。\nkoukai teisu gc_registry_bytes = 80;\nkoukai teisu gc_registry_epoch = 48;\nkoukai teisu gc_registry_owner = 56;\nkoukai teisu gc_registry_heartbeat = 64;\nkoukai teisu gc_registry_phase = 72;\nkoukai teisu gc_handshake = 1;\nkoukai teisu gc_stopped = 2;\nkoukai teisu thread_gc_parked = 3;\nkoukai teisu gc_visit_root_operation = 200;\n\nwaza gc_heartbeat(f: ir.Function, registry: int64) -> unit {\n    ir.put(f, ir.load, 29, registry, 0, gc_registry_heartbeat);\n    tconstant(f, 30, 1);\n    ir.put(f, ir.add, 29, 29, 30, 0);\n    ir.put(f, ir.release_store, 0, registry, 29, gc_registry_heartbeat);\n}\n\nwaza gc_park_locked_program() -> ir.Function {\n    // 并发前置条件：调用方必须已持有本上下文的 thread_mutex，返回时仍保持持有该锁。\n    // 若返回错误，绝不允许在收集器仍处于活跃状态时恢复执行；\n    // 若收集器持有者卡死（600 秒无心跳推进），将直接中止进程（abort_runtime），避免释放仍在使用中的根帧。\n    kaku f = ir.function(\"gc_park_locked\");\n    tprepare(f);\n    tload(f, 10, thread_registry);\n    ir.put(f, ir.acquire_load, 11, 10, 0, gc_registry_owner);\n    ir.branch(f, ir.zero, 11, \"idle\");\n    ir.put(f, ir.equal, 12, 11, 0, 0);\n    ir.branch(f, ir.nonzero, 12, \"idle\");\n\n    tload(f, 13, thread_progress);\n    ir.put(f, ir.acquire_load, 12, 10, 0, gc_registry_epoch);\n    ir.put(f, ir.release_store, 0, 0, 12, thread_ack_epoch);\n    ir.put(f, ir.copy, 19, 12, 0, 0);\n    tpublish(f, thread_progress, thread_gc_parked);\n\n    ir.put(f, ir.acquire_load, 15, 10, 0, gc_registry_heartbeat);\n    ir.invoke_function(f, \"platform_now\", 14, []);\n    tconstant(f, 16, 600000000000);\n    ir.put(f, ir.add, 14, 14, 16, 0);\n\n    ir.branch(f, ir.label, 0, \"wait\");\n    ir.put(f, ir.acquire_load, 11, 10, 0, gc_registry_owner);\n    ir.branch(f, ir.zero, 11, \"resumed\");\n    ir.put(f, ir.acquire_load, 12, 10, 0, gc_registry_epoch);\n    ir.put(f, ir.release_store, 0, 0, 12, thread_ack_epoch);\n    ir.put(f, ir.copy, 19, 12, 0, 0);\n\n    ir.put(f, ir.acquire_load, 12, 10, 0, gc_registry_heartbeat);\n    ir.put(f, ir.equal, 17, 12, 15, 0);\n    ir.branch(f, ir.nonzero, 17, \"check_deadline\");\n    ir.put(f, ir.copy, 15, 12, 0, 0);\n    ir.invoke_function(f, \"platform_now\", 14, []);\n    ir.put(f, ir.add, 14, 14, 16, 0);\n\n    ir.branch(f, ir.label, 0, \"check_deadline\");\n    ir.invoke_function(f, \"platform_now\", 17, []);\n    ir.put(f, ir.less_unsigned, 18, 17, 14, 0);\n    ir.branch(f, ir.zero, 18, \"fatal\");\n\n    tload(f, 2, thread_mutex);\n    tload(f, 3, thread_condition);\n    tconstant(f, 4, 10000000);\n    ir.invoke_function(f, \"platform_wait\", 5, [3, 2, 4]);\n    ir.branch(f, ir.zero, 5, \"wait\");\n    tcheck(f, 5, 1, \"wait\");\n    terror(f, 5);\n    ir.branch(f, ir.jump, 0, \"wait\");\n\n    // 仅发布在停靠期间实际确认过的 Epoch：在读取到 owner 为 0 之后，新的收集器可能立即发起下一轮 Epoch，\n    // 不能把尚未确认的新请求误标记为已完成停靠。\n    ir.branch(f, ir.label, 0, \"resumed\");\n    ir.put(f, ir.release_store, 0, 0, 19, thread_seen_epoch);\n    ir.put(f, ir.release_store, 0, 0, 13, thread_progress);\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"idle\");\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"fatal\");\n    tconstant(f, 1, 81);\n    ir.call(f, abort_runtime, 1, [1]);\n    treturn(f, 3);\n    kaesu f;\n}\n\nwaza gc_poll_program() -> ir.Function {\n    kaku f = ir.function(\"gc_poll\");\n    tprepare(f);\n    ir.put(f, ir.release_store, 0, 0, 1, thread_shadow);\n\n    tload(f, 10, thread_registry);\n    ir.put(f, ir.acquire_load, 11, 10, 0, gc_registry_owner);\n    ir.branch(f, ir.zero, 11, \"done\");\n    ir.put(f, ir.equal, 12, 11, 0, 0);\n    ir.branch(f, ir.nonzero, 12, \"done\");\n\n    tload(f, 2, thread_mutex);\n    ir.call(f, ir.mutex_lock, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"fatal\");\n    ir.invoke_function(f, \"gc_park_locked\", 3, [0]);\n    ir.call(f, ir.mutex_unlock, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"fatal\");\n    ir.put(f, ir.result, 0, 3, 0, 0);\n\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"fatal\");\n    tconstant(f, 1, 82);\n    ir.call(f, abort_runtime, 1, [1]);\n    treturn(f, 3);\n    kaesu f;\n}\n\nwaza gc_end_program() -> ir.Function {\n    // 收集器在整个根扫描与回收期间始终持有注册表锁。\n    // 必须先清除 phase 与 owner 再逐个唤醒等待线程；即便唤醒丢失，等待线程的 10 ms 周期性检查也会观察到释放。\n    kaku f = ir.function(\"gc_end\");\n    tprepare(f);\n    tload(f, 10, thread_registry);\n    ir.put(f, ir.acquire_load, 11, 10, 0, gc_registry_owner);\n    ir.put(f, ir.equal, 12, 11, 0, 0);\n    ir.branch(f, ir.zero, 12, \"not_owner\");\n\n    tconstant(f, 12, 0);\n    ir.put(f, ir.release_store, 0, 10, 12, gc_registry_phase);\n    ir.put(f, ir.release_store, 0, 10, 12, gc_registry_owner);\n    ir.put(f, ir.load, 11, 10, 0, 32);\n\n    ir.branch(f, ir.label, 0, \"wake\");\n    ir.branch(f, ir.zero, 11, \"unlock\");\n    ir.put(f, ir.load, 12, 11, 0, thread_condition);\n    ir.invoke_function(f, \"platform_wake_all\", 1, [12]);\n    ir.put(f, ir.load, 11, 11, 0, thread_next);\n    ir.branch(f, ir.jump, 0, \"wake\");\n\n    ir.branch(f, ir.label, 0, \"unlock\");\n    ir.invoke_function(f, \"registry_unlock\", 1, [0]);\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"not_owner\");\n    treturn(f, 4);\n    kaesu f;\n}\n\nwaza gc_begin_program() -> ir.Function {\n    kaku f = ir.function(\"gc_begin\");\n    tprepare(f);\n    ir.invoke_function(f, \"gc_poll\", 2, [0, 1]);\n    ir.invoke_function(f, \"registry_lock\", 2, [0]);\n    ir.branch(f, ir.nonzero, 2, \"failed_lock\");\n\n    tload(f, 10, thread_registry);\n    ir.put(f, ir.acquire_load, 11, 10, 0, gc_registry_owner);\n    ir.branch(f, ir.nonzero, 11, \"unlock_failed\");\n    ir.put(f, ir.load, 11, 10, 0, gc_registry_epoch);\n    tconstant(f, 12, -1);\n    ir.put(f, ir.equal, 12, 11, 12, 0);\n    ir.branch(f, ir.nonzero, 12, \"unlock_failed\");\n\n    tconstant(f, 12, 1);\n    ir.put(f, ir.add, 11, 11, 12, 0);\n    ir.put(f, ir.release_store, 0, 10, 11, gc_registry_epoch);\n    ir.put(f, ir.release_store, 0, 0, 11, thread_ack_epoch);\n    ir.put(f, ir.release_store, 0, 10, 12, gc_registry_phase);\n    ir.put(f, ir.release_store, 0, 10, 0, gc_registry_owner);\n    gc_heartbeat(f, 10);\n\n    // 给予所有线程 120 秒到达 Safepoint：过载机器上线程可能数秒得不到调度\n    ir.invoke_function(f, \"platform_now\", 20, []);\n    tconstant(f, 21, 120000000000);\n    ir.put(f, ir.add, 20, 20, 21, 0);\n\n    ir.branch(f, ir.label, 0, \"retry\");\n    ir.put(f, ir.load, 13, 10, 0, 32);\n    tconstant(f, 14, 0);\n\n    ir.branch(f, ir.label, 0, \"member\");\n    ir.branch(f, ir.zero, 13, \"check_all\");\n    ir.put(f, ir.equal, 15, 13, 0, 0);\n    ir.branch(f, ir.nonzero, 15, \"next\");\n\n    ir.put(f, ir.acquire_load, 15, 13, 0, thread_error);\n    ir.branch(f, ir.nonzero, 15, \"abort\");\n    ir.put(f, ir.load, 16, 13, 0, thread_mutex);\n    ir.invoke_function(f, \"platform_trylock\", 17, [16]);\n    tcheck(f, 17, 1, \"not_ready\");\n    ir.branch(f, ir.nonzero, 17, \"abort\");\n\n    ir.put(f, ir.acquire_load, 18, 13, 0, thread_progress);\n    tcheck(f, 18, thread_parked, \"ack_blocked\");\n    tcheck(f, 18, thread_finished, \"ack_blocked\");\n    tcheck(f, 18, thread_gc_parked, \"check_parked_ack\");\n    ir.branch(f, ir.jump, 0, \"not_ready_unlock\");\n\n    ir.branch(f, ir.label, 0, \"check_parked_ack\");\n    ir.put(f, ir.acquire_load, 18, 13, 0, thread_ack_epoch);\n    ir.put(f, ir.equal, 18, 18, 11, 0);\n    ir.branch(f, ir.nonzero, 18, \"ready_unlock\");\n\n    ir.branch(f, ir.label, 0, \"not_ready_unlock\");\n    tconstant(f, 14, 1);\n    ir.branch(f, ir.jump, 0, \"ready_unlock\");\n\n    ir.branch(f, ir.label, 0, \"ack_blocked\");\n    ir.put(f, ir.release_store, 0, 13, 11, thread_ack_epoch);\n\n    ir.branch(f, ir.label, 0, \"ready_unlock\");\n    ir.call(f, ir.mutex_unlock, 17, [16]);\n    ir.branch(f, ir.nonzero, 17, \"abort\");\n    ir.branch(f, ir.jump, 0, \"next\");\n\n    ir.branch(f, ir.label, 0, \"not_ready\");\n    tconstant(f, 14, 1);\n\n    ir.branch(f, ir.label, 0, \"next\");\n    ir.put(f, ir.load, 13, 13, 0, thread_next);\n    ir.branch(f, ir.jump, 0, \"member\");\n\n    ir.branch(f, ir.label, 0, \"check_all\");\n    ir.branch(f, ir.zero, 14, \"stopped\");\n    ir.invoke_function(f, \"platform_now\", 21, []);\n    ir.put(f, ir.less_unsigned, 21, 21, 20, 0);\n    ir.branch(f, ir.nonzero, 21, \"retry\");\n\n    ir.branch(f, ir.label, 0, \"abort\");\n    ir.invoke_function(f, \"gc_end\", 2, [0]);\n    treturn(f, 2);\n\n    ir.branch(f, ir.label, 0, \"stopped\");\n    tconstant(f, 12, gc_stopped);\n    ir.put(f, ir.release_store, 0, 10, 12, gc_registry_phase);\n    gc_heartbeat(f, 10);\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"unlock_failed\");\n    ir.invoke_function(f, \"registry_unlock\", 2, [0]);\n    treturn(f, 4);\n\n    ir.branch(f, ir.label, 0, \"failed_lock\");\n    ir.put(f, ir.result, 0, 2, 0, 0);\n    kaesu f;\n}\n\nwaza gc_scan_frames_program(max_roots: int64) -> ir.Function {\n    // arg0 为协调器句柄，arg1 为编译器生成的精确 Shadow Frame 链头。\n    // 描述符低 32 位为总条目数，高 32 位为前导间接全局槽位计数（旧直接帧保持高 32 位为 0）。\n    // 仅在 gc_scan_roots 验证已持有 stopped 所有权及全部线程 Epoch 后，才解引用全局槽位。\n    kaku f = ir.function(\"gc_scan_frames\");\n    tprepare(f);\n    ir.put(f, ir.copy, 10, 1, 0, 0);\n    tconstant(f, 11, 0);\n\n    ir.branch(f, ir.label, 0, \"frame\");\n    ir.branch(f, ir.zero, 10, \"done\");\n    tconstant(f, 12, 1024);\n    ir.put(f, ir.less_unsigned, 12, 11, 12, 0);\n    ir.branch(f, ir.zero, 12, \"invalid\");\n    tconstant(f, 12, 1);\n    ir.put(f, ir.add, 11, 11, 12, 0);\n\n    ir.put(f, ir.load, 12, 10, 0, 8);\n    tconstant(f, 20, shadow_indirect_factor);\n    ir.put(f, ir.divide_unsigned, 19, 12, 20, 0);\n    ir.put(f, ir.multiply, 20, 19, 20, 0);\n    ir.put(f, ir.subtract, 12, 12, 20, 0);\n    ir.put(f, ir.less_unsigned, 20, 12, 19, 0);\n    ir.branch(f, ir.nonzero, 20, \"invalid\");\n    tconstant(f, 13, max_roots + 1);\n    ir.put(f, ir.less_unsigned, 13, 12, 13, 0);\n    ir.branch(f, ir.zero, 13, \"invalid\");\n    tconstant(f, 13, 0);\n    ir.put(f, ir.address, 14, 10, 0, 16);\n    tconstant(f, 15, 8);\n\n    ir.branch(f, ir.label, 0, \"value\");\n    ir.put(f, ir.equal, 16, 13, 12, 0);\n    ir.branch(f, ir.nonzero, 16, \"next_frame\");\n    ir.put(f, ir.multiply, 16, 13, 15, 0);\n    ir.put(f, ir.add, 16, 14, 16, 0);\n    ir.put(f, ir.load, 17, 16, 0, 0);\n    ir.put(f, ir.less_unsigned, 20, 13, 19, 0);\n    ir.branch(f, ir.zero, 20, \"direct_value\");\n    ir.branch(f, ir.zero, 17, \"invalid\");\n    ir.put(f, ir.load, 17, 17, 0, 0);\n\n    ir.branch(f, ir.label, 0, \"direct_value\");\n    ir.call(f, gc_visit_root_operation, 18, [0, 17, 2]);\n    ir.branch(f, ir.nonzero, 18, \"invalid\");\n    tconstant(f, 16, 1);\n    ir.put(f, ir.add, 13, 13, 16, 0);\n    ir.branch(f, ir.jump, 0, \"value\");\n\n    ir.branch(f, ir.label, 0, \"next_frame\");\n    ir.put(f, ir.load, 10, 10, 0, 0);\n    ir.branch(f, ir.jump, 0, \"frame\");\n\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"invalid\");\n    treturn(f, 4);\n    kaesu f;\n}\n\nwaza gc_scan_roots_program() -> ir.Function {\n    kaku f = ir.function(\"gc_scan_roots\");\n    tprepare(f);\n    tload(f, 10, thread_registry);\n    ir.put(f, ir.acquire_load, 11, 10, 0, gc_registry_owner);\n    ir.put(f, ir.equal, 12, 11, 0, 0);\n    ir.branch(f, ir.zero, 12, \"invalid\");\n    ir.put(f, ir.acquire_load, 11, 10, 0, gc_registry_phase);\n    tcheck(f, 11, gc_stopped, \"scan\");\n    treturn(f, 4);\n\n    ir.branch(f, ir.label, 0, \"scan\");\n    tload(f, 13, thread_member);\n    ir.branch(f, ir.nonzero, 13, \"members\");\n    tload(f, 14, thread_shadow);\n    ir.invoke_function(f, \"gc_scan_frames\", 15, [0, 14, 1]);\n    ir.branch(f, ir.nonzero, 15, \"invalid\");\n\n    ir.branch(f, ir.label, 0, \"members\");\n    ir.put(f, ir.load, 11, 10, 0, 32);\n    ir.put(f, ir.acquire_load, 12, 10, 0, gc_registry_epoch);\n\n    ir.branch(f, ir.label, 0, \"member\");\n    ir.branch(f, ir.zero, 11, \"done\");\n    ir.put(f, ir.acquire_load, 13, 11, 0, thread_ack_epoch);\n    ir.put(f, ir.equal, 13, 13, 12, 0);\n    ir.branch(f, ir.zero, 13, \"invalid\");\n    ir.put(f, ir.acquire_load, 14, 11, 0, thread_shadow);\n    ir.invoke_function(f, \"gc_scan_frames\", 15, [0, 14, 1]);\n    ir.branch(f, ir.nonzero, 15, \"invalid\");\n    gc_heartbeat(f, 10);\n    ir.put(f, ir.load, 11, 11, 0, thread_next);\n    ir.branch(f, ir.jump, 0, \"member\");\n\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"invalid\");\n    treturn(f, 4);\n    kaesu f;\n}\n\nkoukai waza safepoint_program(max_roots_per_frame: int64) -> []ir.Function {\n    kaesu [\n        gc_park_locked_program(),\n        gc_poll_program(),\n        gc_begin_program(),\n        gc_end_program(),\n        gc_scan_frames_program(max_roots_per_frame),\n        gc_scan_roots_program()\n    ];\n}\n" }; }
waza data_116() -> File { kaesu File { path: "kiso/runtime/gc/stw.mio", version: "Bunko-v2.1.1", length: 2711, sha256: "14795270b5aea980afd7f097932e15ac4aebffa66bff1df0437f2c29907073c0", source: "// Transitional bridge to the existing exact generational collector. The caller\n// owns gc_begin/gc_end; no frame is read after gc_end. Snapshot storage is owned\n// by that coordinator and must contain (capacity+2) words. Overflow fails closed\n// BEFORE invoking the heap operation. No foreign stack links are modified.\nkoukai teisu gc_collect_stopped_operation = 201;\nkoukai teisu gc_heap_initialize_operation = 202;\nkoukai teisu gc_allocate_stopped_operation = 203;\nwaza gc_snapshot_root_program(capacity: int64) -> ir.Function {\n    // ctx, value, snapshot. The third visitor argument is opaque to the walker.\n    kaku f = ir.function(\"gc_snapshot_root\");\n    ir.put(f, ir.load, 10, 2, 0, 8);\n    tconstant(f, 11, capacity);\n    ir.put(f, ir.less_unsigned, 11, 10, 11, 0);\n    ir.branch(f, ir.zero, 11, \"overflow\");\n    tconstant(f, 11, 8);\n    ir.put(f, ir.multiply, 11, 10, 11, 0);\n    ir.put(f, ir.add, 11, 2, 11, 0);\n    ir.put(f, ir.store, 0, 11, 1, 16);\n    tconstant(f, 11, 1);\n    ir.put(f, ir.add, 10, 10, 11, 0);\n    ir.put(f, ir.store, 0, 2, 10, 8);\n    treturn(f, 0);\n    ir.branch(f, ir.label, 0, \"overflow\");\n    treturn(f, 5);\n    kaesu f;\n}\nwaza gc_collect_stopped_program() -> ir.Function {\n    // ctx, heap, snapshot, major. This does NOT acquire the handshake itself:\n    // the caller may need to inspect/modify the stopped heap in the same epoch.\n    kaku f = ir.function(\"gc_collect_stopped\");\n    tprepare(f);\n    tconstant(f, 10, 0);\n    ir.put(f, ir.store, 0, 2, 10, 0);\n    ir.put(f, ir.store, 0, 2, 10, 8);\n    ir.invoke_function(f, \"gc_scan_roots\", 10, [0, 2]);\n    ir.branch(f, ir.nonzero, 10, \"failed\");\n    ir.call(f, gc_collect_stopped_operation, 10, [1, 2, 3]);\n    ir.branch(f, ir.label, 0, \"failed\");\n    ir.put(f, ir.result, 0, 10, 0, 0);\n    kaesu f;\n}\nwaza gc_allocate_stopped_program() -> ir.Function {\n    // ctx, heap, snapshot, payload bytes, layout. Initialization/publication of\n    // the returned object must finish before the caller releases this epoch.\n    kaku f = ir.function(\"gc_allocate_stopped\");\n    tprepare(f);\n    tconstant(f, 10, 0);\n    ir.put(f, ir.store, 0, 2, 10, 0);\n    ir.put(f, ir.store, 0, 2, 10, 8);\n    ir.invoke_function(f, \"gc_scan_roots\", 10, [0, 2]);\n    ir.branch(f, ir.nonzero, 10, \"failed\");\n    ir.call(f, gc_allocate_stopped_operation, 10, [1, 2, 3, 4]);\n    ir.put(f, ir.result, 0, 10, 0, 0);\n    // Allocation failure is NULL, never an error code that resembles a pointer.\n    ir.branch(f, ir.label, 0, \"failed\");\n    treturn(f, 0);\n    kaesu f;\n}\nkoukai waza stopped_heap_program(capacity: int64) -> []ir.Function {\n    kaesu [gc_snapshot_root_program(capacity), gc_collect_stopped_program(), gc_allocate_stopped_program()];\n}\n" }; }
waza data_117() -> File { kaesu File { path: "kiso/runtime/gc/threads.mio", version: "Bunko-v2.1.1", length: 28909, sha256: "82faef82e64ce53039e0fd058a927e5b7a0a792442035f88c34ff02a9f8b7aeb", source: "yobu \"kiso/runtime/ir\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// 线程扩展 ABI v2：独立于冻结堆元数据单独分配。\n// 所有字段均为原生标量字；操作系统不透明存储（mutex/condition）通过指针传递。\nkoukai teisu thread_context_bytes = 288;\nkoukai teisu thread_version = 0;\nkoukai teisu thread_imports = 8;\nkoukai teisu thread_handle = 16;\nkoukai teisu thread_key = 24;\nkoukai teisu thread_mutex = 32;\nkoukai teisu thread_condition = 40;\nkoukai teisu thread_state = 48;\nkoukai teisu thread_stop = 56;\nkoukai teisu thread_error = 64;\nkoukai teisu thread_owns_key = 72;\nkoukai teisu thread_owns_mutex = 80;\nkoukai teisu thread_owns_condition = 88;\nkoukai teisu thread_owns_handle = 96;\nkoukai teisu thread_registered = 104;\nkoukai teisu thread_starts = 112;\nkoukai teisu thread_joins = 120;\nkoukai teisu thread_registrations = 128;\nkoukai teisu thread_exits = 136;\nkoukai teisu thread_fault_operation = 144;\nkoukai teisu thread_fault_error = 152;\nkoukai teisu thread_fault_count = 160;\nkoukai teisu thread_shadow = 168;\nkoukai teisu thread_identity_value = 176;\nkoukai teisu thread_wakes = 184;\nkoukai teisu thread_waits = 192;\nkoukai teisu thread_join_retries = 200;\nkoukai teisu thread_registry = 208;\nkoukai teisu thread_progress = 216;\nkoukai teisu thread_waiting = thread_progress;\nkoukai teisu thread_at_work = 0;\nkoukai teisu thread_parked = 1;\nkoukai teisu thread_finished = 2;\nkoukai teisu thread_entry = 224;\nkoukai teisu thread_user = 232;\nkoukai teisu thread_acquisitions = 240;\nkoukai teisu thread_releases = 248;\nkoukai teisu thread_new = 0;\nkoukai teisu thread_starting = 1;\nkoukai teisu thread_running = 2;\nkoukai teisu thread_stopping = 3;\nkoukai teisu thread_exited = 4;\nkoukai teisu thread_joined = 5;\nkoukai teisu thread_closed = 6;\nkoukai teisu thread_failed = 7;\nkoukai teisu thread_quarantined = 8;\nkoukai teisu thread_next = 256;\nkoukai teisu thread_member = 264;\nkoukai teisu thread_ack_epoch = 272;\nkoukai teisu thread_seen_epoch = 280;\n\n// 共享注册表 v2：version、active、registrations、exits、head、lock、requested epoch、coordinator state。\n// 遍历链表时必须持有注册表锁；所有存储直到所有句柄均完成 join 之前保持归属权；计数器使用 AcqRel RMW。\nkoukai teisu thread_registry_bytes = 64;\n\nwaza tload(f: ir.Function, dst: int64, offset: int64) -> unit {\n    ir.put(f, ir.load, dst, 0, 0, offset);\n}\n\nwaza tstore(f: ir.Function, offset: int64, src: int64) -> unit {\n    ir.put(f, ir.store, 0, 0, src, offset);\n}\n\nwaza tconstant(f: ir.Function, dst: int64, value: int64) -> unit {\n    ir.put(f, ir.constant, dst, 0, 0, value);\n}\n\nwaza tset(f: ir.Function, offset: int64, value: int64) -> unit {\n    tconstant(f, 31, value);\n    tstore(f, offset, 31);\n}\n\nwaza tpublish(f: ir.Function, offset: int64, value: int64) -> unit {\n    tconstant(f, 31, value);\n    ir.put(f, ir.release_store, 0, 0, 31, offset);\n}\n\nwaza tinc(f: ir.Function, offset: int64) -> unit {\n    tload(f, 29, offset);\n    tconstant(f, 30, 1);\n    ir.put(f, ir.add, 29, 29, 30, 0);\n    tstore(f, offset, 29);\n}\n\nwaza tcheck(f: ir.Function, value: int64, expected: int64, label: string) -> unit {\n    tconstant(f, 30, expected);\n    ir.put(f, ir.equal, 30, value, 30, 0);\n    ir.branch(f, ir.nonzero, 30, label);\n}\n\nwaza treturn(f: ir.Function, value: int64) -> unit {\n    tconstant(f, 31, value);\n    ir.put(f, ir.result, 0, 31, 0, 0);\n}\n\nwaza terror(f: ir.Function, src: int64) -> unit {\n    kaku done = string.concat(\"error_saved_\", convert.format_int(len(f.steps)));\n    ir.branch(f, ir.zero, src, done);\n    ir.put(f, ir.address, 27, 0, 0, thread_error);\n    tconstant(f, 28, 0);\n    array.push(f.steps, ir.Step {\n        kind: ir.compare_exchange,\n        destination: 26,\n        left: 27,\n        right: src,\n        immediate: 0,\n        name: \"\",\n        arguments: [28],\n        order: acq_rel,\n        failure_order: acquire\n    });\n    ir.branch(f, ir.label, 0, done);\n}\n\nwaza tprepare(f: ir.Function) -> unit {\n    tload(f, 31, thread_imports);\n    ir.put(f, ir.imports, 0, 31, 0, 0);\n}\n\n// 一次性故障注入仅编译进显式验证程序中：在资源获取之前替换操作结果，然后沿用与生产环境完全一致的错误/清理路径。\n// 默认生产函数不包含该钩子。\nwaza tcall(f: ir.Function, operation: int64, dst: int64, args: []int64, faults: bool) -> unit {\n    moshi (!faults) {\n        ir.call(f, operation, dst, args);\n        kaesu;\n    }\n    kaku tag = convert.format_int(len(f.steps));\n    kaku actual = string.concat(\"actual_\", tag);\n    kaku done = string.concat(\"call_done_\", tag);\n    tload(f, 30, thread_fault_operation);\n    tconstant(f, 31, operation);\n    ir.put(f, ir.equal, 30, 30, 31, 0);\n    ir.branch(f, ir.zero, 30, actual);\n    tload(f, dst, thread_fault_error);\n    tset(f, thread_fault_operation, 0);\n    tinc(f, thread_fault_count);\n    ir.branch(f, ir.jump, 0, done);\n    ir.branch(f, ir.label, 0, actual);\n    ir.call(f, operation, dst, args);\n    ir.branch(f, ir.label, 0, done);\n}\n\nwaza registry_add(f: ir.Function, offset: int64, delta: int64) -> unit {\n    tload(f, 27, thread_registry);\n    ir.put(f, ir.address, 27, 27, 0, offset);\n    tconstant(f, 28, delta);\n    array.push(f.steps, ir.Step {\n        kind: ir.fetch_add,\n        destination: 26,\n        left: 27,\n        right: 28,\n        immediate: 0,\n        name: \"\",\n        arguments: [],\n        order: acq_rel,\n        failure_order: relaxed\n    });\n}\n\nwaza thread_open_program(faults: bool, cooperative: bool) -> ir.Function {\n    kaesu thread_open_options(faults, cooperative, iie);\n}\n\nwaza thread_open_options(faults: bool, cooperative: bool, shared_key: bool) -> ir.Function {\n    kaku version = 2;\n    moshi (cooperative) { version = 3; }\n    kaku name = \"thread_open\";\n    moshi (shared_key) { name = \"thread_open_shared\"; }\n\n    kaku f = ir.function(name);\n    tprepare(f);\n    tload(f, 1, thread_version);\n    tcheck(f, 1, version, \"version_ok\");\n    treturn(f, 1);\n\n    ir.branch(f, ir.label, 0, \"version_ok\");\n    tload(f, 2, thread_registry);\n    ir.branch(f, ir.zero, 2, \"invalid_registry\");\n    ir.put(f, ir.load, 3, 2, 0, 0);\n    tcheck(f, 3, version, \"registry_ok\");\n\n    ir.branch(f, ir.label, 0, \"invalid_registry\");\n    treturn(f, 1);\n\n    ir.branch(f, ir.label, 0, \"registry_ok\");\n    tload(f, 1, thread_member);\n    ir.branch(f, ir.zero, 1, \"not_member\");\n    treturn(f, 1);\n\n    ir.branch(f, ir.label, 0, \"not_member\");\n    tload(f, 1, thread_state);\n    tcheck(f, 1, thread_new, \"start\");\n    tcheck(f, 1, thread_closed, \"start\");\n    treturn(f, 1);\n\n    ir.branch(f, ir.label, 0, \"start\");\n    tset(f, thread_version, version);\n    tset(f, thread_error, 0);\n    tset(f, thread_stop, 0);\n    moshi (!cooperative) { tset(f, thread_shadow, 0); }\n    tset(f, thread_registered, 0);\n    tset(f, thread_progress, thread_at_work);\n\n    // 共享 TLS Key 模式下，调用方一直持有 Key 直到所有子线程 join 完毕，子线程 close 绝不会删除借用的 Key。\n    // 每个实际 Worker 的上下文/互斥锁/条件变量与线程句柄归属权仍保持独立。\n    moshi (shared_key) {\n        tset(f, thread_owns_key, 0);\n    } sore {\n        ir.put(f, ir.address, 2, 0, 0, thread_key);\n        tcall(f, ir.tls_create, 1, [2], faults);\n        ir.branch(f, ir.nonzero, 1, \"failed\");\n        tset(f, thread_owns_key, 1);\n        tinc(f, thread_acquisitions);\n    }\n\n    tload(f, 2, thread_mutex);\n    tcall(f, ir.mutex_create, 1, [2], faults);\n    ir.branch(f, ir.nonzero, 1, \"failed\");\n    tset(f, thread_owns_mutex, 1);\n    tinc(f, thread_acquisitions);\n\n    tload(f, 2, thread_condition);\n    tcall(f, ir.condition_create, 1, [2], faults);\n    ir.branch(f, ir.nonzero, 1, \"failed\");\n    tset(f, thread_owns_condition, 1);\n    tinc(f, thread_acquisitions);\n\n    tpublish(f, thread_state, thread_starting);\n    ir.put(f, ir.address, 2, 0, 0, thread_handle);\n    tload(f, 3, thread_entry);\n    moshi (shared_key) {\n        ir.put(f, ir.address, 4, 0, 0, thread_error);\n        ir.invoke_function(f, \"platform_thread_start\", 1, [2, 3, 0, 4]);\n    } sore {\n        tcall(f, thread_start, 1, [2, 3, 0], faults);\n    }\n    ir.branch(f, ir.nonzero, 1, \"failed\");\n    tset(f, thread_owns_handle, 1);\n    tinc(f, thread_acquisitions);\n    tinc(f, thread_starts);\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"failed\");\n    terror(f, 1);\n    ir.invoke_function(f, \"thread_close\", 2, [0]);\n    tload(f, 1, thread_error);\n    ir.put(f, ir.result, 0, 1, 0, 0);\n    kaesu f;\n}\n\nwaza thread_enter_program(faults: bool, cooperative: bool) -> ir.Function {\n    kaku f = ir.function(\"thread_enter\");\n    tprepare(f);\n    tload(f, 2, thread_key);\n    tconstant(f, 4, 0);\n    tcall(f, tls_set, 1, [2, 0], faults);\n    ir.branch(f, ir.nonzero, 1, \"failed\");\n\n    tconstant(f, 4, 1);\n    tcall(f, tls_get, 1, [2], faults);\n    ir.put(f, ir.equal, 3, 1, 0, 0);\n    ir.branch(f, ir.nonzero, 3, \"registered\");\n    tconstant(f, 1, 3);\n    ir.branch(f, ir.jump, 0, \"failed\");\n\n    ir.branch(f, ir.label, 0, \"registered\");\n    ir.invoke_function(f, \"registry_enter\", 1, [0]);\n    ir.branch(f, ir.nonzero, 1, \"failed\");\n    tinc(f, thread_registrations);\n    tpublish(f, thread_registered, 1);\n\n    ir.call(f, thread_identity, 1, []);\n    tstore(f, thread_identity_value, 1);\n\n    tload(f, 2, thread_mutex);\n    ir.call(f, ir.mutex_lock, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"failed_registered\");\n\n    ir.put(f, ir.acquire_load, 3, 0, 0, thread_stop);\n    ir.branch(f, ir.nonzero, 3, \"stopping\");\n    tpublish(f, thread_state, thread_running);\n    ir.branch(f, ir.jump, 0, \"publish\");\n\n    ir.branch(f, ir.label, 0, \"stopping\");\n    tpublish(f, thread_state, thread_stopping);\n\n    ir.branch(f, ir.label, 0, \"publish\");\n    tload(f, 3, thread_condition);\n    ir.call(f, wake, 1, [3]);\n    terror(f, 1);\n    tinc(f, thread_wakes);\n    ir.call(f, ir.mutex_unlock, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"failed_registered\");\n\n    moshi (cooperative) {\n        tload(f, 2, thread_shadow);\n        ir.invoke_function(f, \"gc_poll\", 1, [0, 2]);\n        ir.branch(f, ir.nonzero, 1, \"failed_registered\");\n    }\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"failed_registered\");\n    terror(f, 1);\n    ir.invoke_function(f, \"thread_leave\", 2, [0]);\n    tload(f, 1, thread_error);\n    ir.put(f, ir.result, 0, 1, 0, 0);\n\n    ir.branch(f, ir.label, 0, \"failed\");\n    ir.branch(f, ir.zero, 4, \"failure_publish\");\n    tconstant(f, 3, 0);\n    ir.call(f, tls_set, 5, [2, 3]);\n\n    ir.branch(f, ir.label, 0, \"failure_publish\");\n    terror(f, 1);\n    tpublish(f, thread_state, thread_failed);\n    tpublish(f, thread_progress, thread_finished);\n    treturn(f, 1);\n    kaesu f;\n}\n\n// 将当前调用线程附加到协作式注册表（不创建/join pthread）。\n// 上下文由调用方持有并清零初始化，已配置 imports/registry 与不透明互斥锁/条件变量存储；\n// 仅在完全 close 后才允许复用。资源获取与回滚沿用与 thread_open 相同的归属计数规则。\nwaza thread_attach_program(faults: bool) -> ir.Function {\n    kaku f = ir.function(\"thread_attach\");\n    tprepare(f);\n    tload(f, 1, thread_version);\n    tcheck(f, 1, 3, \"version_ok\");\n    treturn(f, 1);\n\n    ir.branch(f, ir.label, 0, \"version_ok\");\n    tload(f, 2, thread_registry);\n    ir.branch(f, ir.zero, 2, \"invalid\");\n    ir.put(f, ir.load, 3, 2, 0, 0);\n    tcheck(f, 3, 3, \"registry_ok\");\n\n    ir.branch(f, ir.label, 0, \"invalid\");\n    treturn(f, 1);\n\n    ir.branch(f, ir.label, 0, \"registry_ok\");\n    tload(f, 1, thread_member);\n    ir.branch(f, ir.nonzero, 1, \"invalid\");\n\n    tload(f, 1, thread_state);\n    tcheck(f, 1, thread_new, \"acquire\");\n    tcheck(f, 1, thread_closed, \"acquire\");\n    treturn(f, 1);\n\n    ir.branch(f, ir.label, 0, \"acquire\");\n    tset(f, thread_error, 0);\n    tset(f, thread_stop, 0);\n    tset(f, thread_shadow, 0);\n    tset(f, thread_progress, thread_at_work);\n\n    ir.put(f, ir.address, 2, 0, 0, thread_key);\n    tcall(f, ir.tls_create, 1, [2], faults);\n    ir.branch(f, ir.nonzero, 1, \"failed\");\n    tset(f, thread_owns_key, 1);\n    tinc(f, thread_acquisitions);\n\n    tload(f, 2, thread_mutex);\n    tcall(f, ir.mutex_create, 1, [2], faults);\n    ir.branch(f, ir.nonzero, 1, \"failed\");\n    tset(f, thread_owns_mutex, 1);\n    tinc(f, thread_acquisitions);\n\n    tload(f, 2, thread_condition);\n    tcall(f, ir.condition_create, 1, [2], faults);\n    ir.branch(f, ir.nonzero, 1, \"failed\");\n    tset(f, thread_owns_condition, 1);\n    tinc(f, thread_acquisitions);\n\n    tpublish(f, thread_state, thread_starting);\n    ir.invoke_function(f, \"thread_enter\", 1, [0]);\n    ir.branch(f, ir.nonzero, 1, \"failed\");\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"failed\");\n    terror(f, 1);\n    ir.invoke_function(f, \"thread_close\", 2, [0]);\n    tload(f, 1, thread_error);\n    ir.put(f, ir.result, 0, 1, 0, 0);\n    kaesu f;\n}\n\nwaza thread_leave_program(cooperative: bool) -> ir.Function {\n    kaku f = ir.function(\"thread_leave\");\n    tprepare(f);\n    moshi (cooperative) {\n        tload(f, 2, thread_shadow);\n        ir.invoke_function(f, \"gc_poll\", 1, [0, 2]);\n        terror(f, 1);\n    }\n\n    tload(f, 1, thread_registered);\n    ir.branch(f, ir.zero, 1, \"publish\");\n\n    tload(f, 2, thread_key);\n    tconstant(f, 3, 0);\n    ir.call(f, tls_set, 1, [2, 3]);\n    terror(f, 1);\n\n    ir.invoke_function(f, \"registry_leave\", 1, [0]);\n    ir.branch(f, ir.zero, 1, \"unlinked\");\n    terror(f, 1);\n    ir.branch(f, ir.jump, 0, \"publish\");\n\n    ir.branch(f, ir.label, 0, \"unlinked\");\n    tinc(f, thread_exits);\n    tpublish(f, thread_registered, 0);\n    tpublish(f, thread_shadow, 0);\n\n    ir.branch(f, ir.label, 0, \"publish\");\n    tload(f, 2, thread_mutex);\n    ir.call(f, ir.mutex_lock, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"bad_lock\");\n\n    tpublish(f, thread_state, thread_exited);\n    tpublish(f, thread_progress, thread_finished);\n    tload(f, 3, thread_condition);\n    ir.call(f, wake, 1, [3]);\n    terror(f, 1);\n    tinc(f, thread_wakes);\n    ir.call(f, ir.mutex_unlock, 1, [2]);\n    terror(f, 1);\n    tload(f, 1, thread_error);\n    ir.put(f, ir.result, 0, 1, 0, 0);\n\n    ir.branch(f, ir.label, 0, \"bad_lock\");\n    terror(f, 1);\n    tpublish(f, thread_state, thread_exited);\n    tpublish(f, thread_progress, thread_finished);\n    tload(f, 1, thread_error);\n    ir.put(f, ir.result, 0, 1, 0, 0);\n    kaesu f;\n}\n\nwaza thread_wait_program(faults: bool, cooperative: bool) -> ir.Function {\n    // 有界 GC 等待：arg1 为 0..1s（纳秒），0 表示已到期。\n    // 唤醒仅作提示：每次唤醒后必须在同一把互斥锁下重新检查 thread_stop；\n    // 绝对截止时间不会因虚假唤醒而延长。\n    kaku f = ir.function(\"thread_wait\");\n    tprepare(f);\n    ir.put(f, ir.copy, 5, 1, 0, 0);\n    tconstant(f, 7, 1000000001);\n    ir.put(f, ir.less_unsigned, 7, 5, 7, 0);\n    ir.branch(f, ir.zero, 7, \"bad_timeout\");\n\n    ir.invoke_function(f, \"platform_now\", 6, []);\n    ir.branch(f, ir.zero, 6, \"bad_timeout\");\n    ir.put(f, ir.copy, 8, 6, 0, 0);\n    ir.put(f, ir.add, 6, 6, 5, 0);\n    ir.put(f, ir.less_unsigned, 8, 6, 8, 0);\n    ir.branch(f, ir.nonzero, 8, \"bad_timeout\");\n\n    tload(f, 2, thread_mutex);\n    ir.call(f, ir.mutex_lock, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"lock_failed\");\n\n    ir.branch(f, ir.label, 0, \"predicate\");\n    moshi (cooperative) {\n        ir.invoke_function(f, \"gc_park_locked\", 9, [0]);\n        ir.branch(f, ir.nonzero, 9, \"gc_failed\");\n    }\n    ir.put(f, ir.acquire_load, 3, 0, 0, thread_stop);\n    ir.branch(f, ir.nonzero, 3, \"stopped\");\n\n    ir.invoke_function(f, \"platform_now\", 7, []);\n    ir.branch(f, ir.zero, 7, \"clock_failed\");\n    ir.put(f, ir.less_unsigned, 8, 7, 6, 0);\n    ir.branch(f, ir.zero, 8, \"timed_out\");\n    ir.put(f, ir.subtract, 5, 6, 7, 0);\n\n    moshi (faults) {\n        tload(f, 3, thread_fault_operation);\n        tcheck(f, 3, park, \"inject\");\n    }\n    tpublish(f, thread_progress, thread_parked);\n    tload(f, 3, thread_condition);\n    ir.invoke_function(f, \"platform_wait\", 4, [3, 2, 5]);\n    tinc(f, thread_waits);\n    ir.branch(f, ir.zero, 4, \"predicate\");\n    ir.branch(f, ir.jump, 0, \"unlock\");\n\n    moshi (faults) {\n        ir.branch(f, ir.label, 0, \"inject\");\n        tload(f, 4, thread_fault_error);\n        tset(f, thread_fault_operation, 0);\n        tinc(f, thread_fault_count);\n        ir.branch(f, ir.jump, 0, \"unlock\");\n    }\n\n    ir.branch(f, ir.label, 0, \"stopped\");\n    tconstant(f, 4, 0);\n    ir.branch(f, ir.jump, 0, \"unlock\");\n\n    ir.branch(f, ir.label, 0, \"timed_out\");\n    tconstant(f, 4, 1);\n    ir.branch(f, ir.jump, 0, \"unlock\");\n\n    ir.branch(f, ir.label, 0, \"gc_failed\");\n    ir.branch(f, ir.label, 0, \"clock_failed\");\n    tconstant(f, 4, -2);\n\n    ir.branch(f, ir.label, 0, \"unlock\");\n    moshi (cooperative) { ir.invoke_function(f, \"gc_park_locked\", 9, [0]); }\n    tpublish(f, thread_progress, thread_at_work);\n    ir.call(f, ir.mutex_unlock, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"lock_failed\");\n    ir.put(f, ir.result, 0, 4, 0, 0);\n\n    ir.branch(f, ir.label, 0, \"lock_failed\");\n    tconstant(f, 3, 0);\n    ir.put(f, ir.subtract, 1, 3, 1, 0);\n    ir.put(f, ir.result, 0, 1, 0, 0);\n\n    ir.branch(f, ir.label, 0, \"bad_timeout\");\n    treturn(f, -2);\n    kaesu f;\n}\n\nwaza thread_close_program(faults: bool) -> ir.Function {\n    kaku f = ir.function(\"thread_close\");\n    tprepare(f);\n    tload(f, 1, thread_owns_handle);\n    ir.branch(f, ir.zero, 1, \"destroy\");\n\n    tload(f, 2, thread_mutex);\n    ir.call(f, ir.mutex_lock, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"quarantine\");\n\n    tpublish(f, thread_stop, 1);\n    tload(f, 3, thread_condition);\n    ir.call(f, wake, 1, [3]);\n    terror(f, 1);\n\n    ir.invoke_function(f, \"platform_now\", 6, []);\n    ir.branch(f, ir.zero, 6, \"unlock_quarantine\");\n    tconstant(f, 7, 1000000000);\n    ir.put(f, ir.copy, 8, 6, 0, 0);\n    ir.put(f, ir.add, 6, 6, 7, 0);\n    ir.put(f, ir.less_unsigned, 8, 6, 8, 0);\n    ir.branch(f, ir.nonzero, 8, \"unlock_quarantine\");\n\n    ir.branch(f, ir.label, 0, \"wait_exit\");\n    ir.put(f, ir.acquire_load, 4, 0, 0, thread_state);\n    tcheck(f, 4, thread_exited, \"exited\");\n    tcheck(f, 4, thread_failed, \"exited\");\n    ir.put(f, ir.acquire_load, 4, 0, 0, thread_progress);\n    tcheck(f, 4, thread_finished, \"exited\");\n\n    ir.invoke_function(f, \"platform_now\", 4, []);\n    ir.branch(f, ir.zero, 4, \"unlock_quarantine\");\n    ir.put(f, ir.less_unsigned, 5, 4, 6, 0);\n    ir.branch(f, ir.zero, 5, \"unlock_quarantine\");\n\n    tconstant(f, 5, 10000000);\n    ir.invoke_function(f, \"platform_wait\", 4, [3, 2, 5]);\n    ir.branch(f, ir.zero, 4, \"wait_exit\");\n    tcheck(f, 4, 1, \"wait_exit\");\n    terror(f, 4);\n    ir.branch(f, ir.jump, 0, \"unlock_quarantine\");\n\n    ir.branch(f, ir.label, 0, \"exited\");\n    ir.call(f, ir.mutex_unlock, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"quarantine\");\n\n    tload(f, 2, thread_handle);\n    tconstant(f, 3, 0);\n    tcall(f, thread_join, 1, [2, 3], faults);\n    ir.branch(f, ir.zero, 1, \"joined\");\n    terror(f, 1);\n    tinc(f, thread_join_retries);\n\n    // 绕过故障注入重试：在真正的 join 成功之前，所有原生资源仍归当前上下文所有，绝不能释放或复用该上下文。\n    ir.call(f, thread_join, 1, [2, 3]);\n    ir.branch(f, ir.nonzero, 1, \"quarantine\");\n\n    ir.branch(f, ir.label, 0, \"joined\");\n    tset(f, thread_owns_handle, 0);\n    tinc(f, thread_joins);\n    tinc(f, thread_releases);\n    tpublish(f, thread_state, thread_joined);\n\n    ir.branch(f, ir.label, 0, \"destroy\");\n    tload(f, 1, thread_member);\n    ir.branch(f, ir.nonzero, 1, \"quarantine\");\n\n    tload(f, 1, thread_owns_condition);\n    ir.branch(f, ir.zero, 1, \"destroy_mutex\");\n    tload(f, 2, thread_condition);\n    ir.call(f, ir.condition_destroy, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"quarantine\");\n    tset(f, thread_owns_condition, 0);\n    tinc(f, thread_releases);\n\n    ir.branch(f, ir.label, 0, \"destroy_mutex\");\n    tload(f, 1, thread_owns_mutex);\n    ir.branch(f, ir.zero, 1, \"destroy_key\");\n    tload(f, 2, thread_mutex);\n    ir.call(f, ir.mutex_destroy, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"quarantine\");\n    tset(f, thread_owns_mutex, 0);\n    tinc(f, thread_releases);\n\n    ir.branch(f, ir.label, 0, \"destroy_key\");\n    tload(f, 1, thread_owns_key);\n    ir.branch(f, ir.zero, 1, \"closed\");\n    tload(f, 2, thread_key);\n    ir.call(f, ir.tls_destroy, 1, [2]);\n    ir.branch(f, ir.nonzero, 1, \"quarantine\");\n    tset(f, thread_owns_key, 0);\n    tinc(f, thread_releases);\n\n    ir.branch(f, ir.label, 0, \"closed\");\n    tpublish(f, thread_state, thread_closed);\n    tload(f, 1, thread_error);\n    ir.put(f, ir.result, 0, 1, 0, 0);\n\n    ir.branch(f, ir.label, 0, \"unlock_quarantine\");\n    tconstant(f, 1, 2);\n    terror(f, 1);\n    ir.call(f, ir.mutex_unlock, 1, [2]);\n\n    ir.branch(f, ir.label, 0, \"quarantine\");\n    terror(f, 1);\n    tpublish(f, thread_state, thread_quarantined);\n    tload(f, 1, thread_error);\n    ir.branch(f, ir.nonzero, 1, \"return_error\");\n    tset(f, thread_error, 2);\n    tconstant(f, 1, 2);\n\n    ir.branch(f, ir.label, 0, \"return_error\");\n    ir.put(f, ir.result, 0, 1, 0, 0);\n    kaesu f;\n}\n\nwaza thread_error_program() -> ir.Function {\n    kaku f = ir.function(\"thread_record_error\");\n    tprepare(f);\n    terror(f, 1);\n    tload(f, 1, thread_error);\n    ir.put(f, ir.result, 0, 1, 0, 0);\n    kaesu f;\n}\n\nwaza registry_lock_program(cooperative: bool) -> ir.Function {\n    kaku f = ir.function(\"registry_lock\");\n    tprepare(f);\n    ir.invoke_function(f, \"platform_now\", 4, []);\n    ir.branch(f, ir.zero, 4, \"timeout\");\n    tconstant(f, 6, 120000000000);\n    ir.put(f, ir.copy, 8, 4, 0, 0);\n    ir.put(f, ir.add, 4, 4, 6, 0);\n    ir.put(f, ir.less_unsigned, 8, 4, 8, 0);\n    ir.branch(f, ir.nonzero, 8, \"timeout\");\n\n    // 协作式注册表锁获取会区分真正的 GC 推进与锁卡死：gc_poll 可能会合法停靠超过 120 秒的软期限，\n    // 只有当心跳（heartbeat）确实推进时才续期，从而避免误判超时；同时 600 秒的独立总上限仍能防止在持续 GC 下无限饥饿。\n    moshi (cooperative) {\n        tload(f, 10, thread_registry);\n        ir.put(f, ir.acquire_load, 11, 10, 0, gc_registry_heartbeat);\n        tconstant(f, 12, 600000000000);\n        ir.put(f, ir.add, 12, 4, 12, 0);\n        ir.put(f, ir.less_unsigned, 7, 12, 4, 0);\n        ir.branch(f, ir.nonzero, 7, \"timeout\");\n    }\n\n    tload(f, 2, thread_registry);\n    ir.put(f, ir.address, 2, 2, 0, 40);\n    tconstant(f, 3, 1);\n    tconstant(f, 5, 0);\n\n    ir.branch(f, ir.label, 0, \"retry\");\n    moshi (cooperative) { tconstant(f, 19, 0); }\n    array.push(f.steps, ir.Step {\n        kind: ir.compare_exchange,\n        destination: 1,\n        left: 2,\n        right: 3,\n        immediate: 0,\n        name: \"\",\n        arguments: [5],\n        order: acq_rel,\n        failure_order: acquire\n    });\n    ir.branch(f, ir.zero, 1, \"acquired\");\n\n    moshi (cooperative) {\n        tload(f, 9, thread_registered);\n        ir.branch(f, ir.zero, 9, \"not_registered\");\n        ir.put(f, ir.acquire_load, 15, 0, 0, thread_seen_epoch);\n        tload(f, 9, thread_shadow);\n        ir.invoke_function(f, \"gc_poll\", 1, [0, 9]);\n        ir.branch(f, ir.nonzero, 1, \"poll_failed\");\n        ir.put(f, ir.acquire_load, 16, 0, 0, thread_seen_epoch);\n        ir.put(f, ir.equal, 17, 16, 15, 0);\n        ir.branch(f, ir.nonzero, 17, \"not_registered\");\n        tconstant(f, 19, 1);\n        ir.branch(f, ir.label, 0, \"not_registered\");\n    }\n\n    ir.invoke_function(f, \"platform_now\", 6, []);\n    ir.branch(f, ir.zero, 6, \"timeout\");\n\n    moshi (cooperative) {\n        ir.put(f, ir.less_unsigned, 7, 6, 12, 0);\n        ir.branch(f, ir.zero, 7, \"timeout\");\n\n        // gc_poll 可能在软期限之后才完成一次已确认停靠的 Epoch（期间该次堆操作本身未触发心跳变化）。\n        // 仅当确实完成了停靠 Epoch 时才将软期限续期 120 秒，600 秒的绝对总上限保持不变。\n        ir.branch(f, ir.zero, 19, \"no_completed_park\");\n        tconstant(f, 14, 120000000000);\n        ir.put(f, ir.add, 4, 6, 14, 0);\n        ir.put(f, ir.less_unsigned, 7, 4, 6, 0);\n        ir.branch(f, ir.nonzero, 7, \"timeout\");\n\n        ir.branch(f, ir.label, 0, \"no_completed_park\");\n        ir.put(f, ir.acquire_load, 13, 10, 0, gc_registry_heartbeat);\n        ir.put(f, ir.equal, 14, 13, 11, 0);\n        ir.branch(f, ir.nonzero, 14, \"no_registry_progress\");\n        ir.put(f, ir.copy, 11, 13, 0, 0);\n        tconstant(f, 14, 120000000000);\n        ir.put(f, ir.add, 4, 6, 14, 0);\n        ir.put(f, ir.less_unsigned, 7, 4, 6, 0);\n        ir.branch(f, ir.nonzero, 7, \"timeout\");\n        ir.branch(f, ir.label, 0, \"no_registry_progress\");\n    }\n\n    ir.put(f, ir.less_unsigned, 7, 6, 4, 0);\n    ir.branch(f, ir.nonzero, 7, \"retry\");\n\n    ir.branch(f, ir.label, 0, \"timeout\");\n    treturn(f, 2);\n\n    ir.branch(f, ir.label, 0, \"acquired\");\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"poll_failed\");\n    ir.put(f, ir.result, 0, 1, 0, 0);\n    kaesu f;\n}\n\nwaza registry_unlock_program() -> ir.Function {\n    kaku f = ir.function(\"registry_unlock\");\n    tload(f, 2, thread_registry);\n    tconstant(f, 3, 0);\n    ir.put(f, ir.release_store, 0, 2, 3, 40);\n    treturn(f, 0);\n    kaesu f;\n}\n\nwaza registry_enter_program() -> ir.Function {\n    kaku f = ir.function(\"registry_enter\");\n    ir.invoke_function(f, \"registry_lock\", 1, [0]);\n    ir.branch(f, ir.nonzero, 1, \"done\");\n\n    tload(f, 6, thread_member);\n    ir.branch(f, ir.nonzero, 6, \"duplicate\");\n\n    tload(f, 2, thread_registry);\n    ir.put(f, ir.load, 3, 2, 0, 32);\n    tstore(f, thread_next, 3);\n    tpublish(f, thread_member, 1);\n    ir.put(f, ir.release_store, 0, 2, 0, 32);\n    registry_add(f, 8, 1);\n    registry_add(f, 16, 1);\n\n    ir.invoke_function(f, \"registry_unlock\", 1, [0]);\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"duplicate\");\n    ir.invoke_function(f, \"registry_unlock\", 1, [0]);\n    tconstant(f, 1, 4);\n\n    ir.branch(f, ir.label, 0, \"done\");\n    ir.put(f, ir.result, 0, 1, 0, 0);\n    kaesu f;\n}\n\nwaza registry_leave_program() -> ir.Function {\n    kaku f = ir.function(\"registry_leave\");\n    ir.invoke_function(f, \"registry_lock\", 1, [0]);\n    ir.branch(f, ir.nonzero, 1, \"done\");\n\n    tload(f, 2, thread_registry);\n    ir.put(f, ir.load, 3, 2, 0, 32);\n    ir.put(f, ir.load, 6, 2, 0, 8);\n    tconstant(f, 4, 0);\n    tconstant(f, 7, 0);\n\n    ir.branch(f, ir.label, 0, \"find\");\n    ir.put(f, ir.less_unsigned, 8, 7, 6, 0);\n    ir.branch(f, ir.zero, 8, \"missing\");\n    ir.branch(f, ir.zero, 3, \"missing\");\n    ir.put(f, ir.equal, 8, 3, 0, 0);\n    ir.branch(f, ir.nonzero, 8, \"found\");\n    ir.put(f, ir.copy, 4, 3, 0, 0);\n    ir.put(f, ir.load, 3, 3, 0, thread_next);\n    tconstant(f, 9, 1);\n    ir.put(f, ir.add, 7, 7, 9, 0);\n    ir.branch(f, ir.jump, 0, \"find\");\n\n    ir.branch(f, ir.label, 0, \"found\");\n    ir.put(f, ir.load, 5, 3, 0, thread_next);\n    ir.branch(f, ir.nonzero, 4, \"predecessor\");\n    ir.put(f, ir.release_store, 0, 2, 5, 32);\n    ir.branch(f, ir.jump, 0, \"removed\");\n\n    ir.branch(f, ir.label, 0, \"predecessor\");\n    ir.put(f, ir.store, 0, 4, 5, thread_next);\n\n    ir.branch(f, ir.label, 0, \"removed\");\n    tset(f, thread_next, 0);\n    tpublish(f, thread_member, 0);\n    registry_add(f, 8, -1);\n    registry_add(f, 24, 1);\n    ir.invoke_function(f, \"registry_unlock\", 1, [0]);\n    treturn(f, 0);\n\n    ir.branch(f, ir.label, 0, \"missing\");\n    ir.invoke_function(f, \"registry_unlock\", 1, [0]);\n    tconstant(f, 1, 4);\n\n    ir.branch(f, ir.label, 0, \"done\");\n    ir.put(f, ir.result, 0, 1, 0, 0);\n    kaesu f;\n}\n\nkoukai waza thread_program(faults: bool) -> []ir.Function {\n    kaesu thread_program_options(faults, iie);\n}\n\n// 协作式 ABI v3 保留调用方提供的引导根链，且仅可加入拥有心跳与握手阶段的 v3 GC 注册表。\nkoukai waza cooperative_thread_program(faults: bool) -> []ir.Function {\n    kaesu thread_program_options(faults, hai);\n}\n\n// 托管 Worker 需要支持显式栈配置的启动原语；底层原语与生命周期测试沿用原有默认启动 ABI。\nkoukai waza worker_thread_program(faults: bool) -> []ir.Function {\n    kaku functions = thread_program_options(faults, hai);\n    array.push(functions, thread_open_options(faults, hai, hai));\n    kaesu functions;\n}\n\nwaza thread_program_options(faults: bool, cooperative: bool) -> []ir.Function {\n    kaku functions = [\n        thread_open_program(faults, cooperative),\n        thread_enter_program(faults, cooperative),\n        thread_leave_program(cooperative),\n        thread_wait_program(faults, cooperative),\n        thread_close_program(faults),\n        thread_error_program(),\n        registry_lock_program(cooperative),\n        registry_unlock_program(),\n        registry_enter_program(),\n        registry_leave_program()\n    ];\n    moshi (cooperative) {\n        array.push(functions, thread_attach_program(faults));\n    }\n    kaesu functions;\n}\n" }; }
waza data_118() -> File { kaesu File { path: "kiso/runtime/gc/trace.mio", version: "Bunko-v2.1.1", length: 7956, sha256: "83a145d52037b35652939e0f42dda3c3c23e33ab4d9de59486d535792a0a1e33", source: "// Exact object-edge enumeration, independent of CPU/OS and collector policy.\n// The caller owns the mapped object and its lifetime. args: visitor context,\n// payload pointer, maximum owned payload bytes. No Root or integer guessing.\n// Visitor failure or malformed layout returns4 before further payload reads.\nkoukai teisu gc_trace_edge_operation = 205;\nwaza trace_minimum(f: ir.Function, bytes: int64) -> unit {\n    tconstant(f, 30, bytes);\n    ir.put(f, ir.less_unsigned, 29, 4, 30, 0);\n    ir.branch(f, ir.nonzero, 29, \"invalid\");\n}\nwaza trace_kind(f: ir.Function, expected: int64) -> unit {\n    ir.put(f, ir.load, 29, 1, 0, 0);\n    tconstant(f, 30, expected);\n    ir.put(f, ir.equal, 29, 29, 30, 0);\n    ir.branch(f, ir.zero, 29, \"invalid\");\n}\nwaza trace_edge(f: ir.Function, value: int64, visitor: string) -> unit {\n    moshi (visitor == \"\") { ir.call(f, gc_trace_edge_operation, 15, [0, value]); }\n    sore {\n        ir.invoke_function(f, visitor, 15, [0, value]);\n    }\n    ir.branch(f, ir.nonzero, 15, \"visitor_failed\");\n}\nwaza trace_object_program(visitor: string) -> ir.Function {\n    kaku f = ir.function(\"gc_trace_object\");\n    tconstant(f, 6, 16);\n    ir.put(f, ir.less_unsigned, 29, 1, 6, 0);\n    ir.branch(f, ir.nonzero, 29, \"invalid\");\n    ir.put(f, ir.divide_unsigned, 29, 1, 6, 0);\n    ir.put(f, ir.multiply, 29, 29, 6, 0);\n    ir.put(f, ir.equal, 29, 29, 1, 0);\n    ir.branch(f, ir.zero, 29, \"invalid\");\n    ir.put(f, ir.subtract, 3, 1, 6, 0);\n    ir.put(f, ir.load, 4, 3, 0, 8);\n    ir.put(f, ir.less_unsigned, 29, 2, 4, 0);\n    ir.branch(f, ir.nonzero, 29, \"invalid\");\n    ir.put(f, ir.acquire_load, 5, 3, 0, 0);\n    tconstant(f, 6, 4294967296);\n    ir.put(f, ir.divide_unsigned, 29, 5, 6, 0);\n    ir.put(f, ir.multiply, 29, 29, 6, 0);\n    ir.put(f, ir.subtract, 5, 5, 29, 0);\n    tcheck(f, 5, 100, \"structure\");\n    tcheck(f, 5, 101, \"array\");\n    tcheck(f, 5, 102, \"storage\");\n    tcheck(f, 5, 103, \"closure\");\n    tcheck(f, 5, 104, \"environment\");\n    tcheck(f, 5, 105, \"cell\");\n    tcheck(f, 5, 106, \"done\");\n    tcheck(f, 5, 107, \"enumeration\");\n    ir.branch(f, ir.jump, 0, \"invalid\");\n    ir.branch(f, ir.label, 0, \"array\");\n    trace_minimum(f, 48);\n    // Array payload kind occupies only low8; width/reference flags live above.\n    ir.put(f, ir.load, 29, 1, 0, 0);\n    tconstant(f, 30, 256);\n    ir.put(f, ir.divide_unsigned, 7, 29, 30, 0);\n    ir.put(f, ir.multiply, 7, 7, 30, 0);\n    ir.put(f, ir.subtract, 29, 29, 7, 0);\n    tconstant(f, 30, 2);\n    ir.put(f, ir.equal, 29, 29, 30, 0);\n    ir.branch(f, ir.zero, 29, \"invalid\");\n    ir.put(f, ir.acquire_load, 14, 1, 0, 40);\n    trace_edge(f, 14, visitor);\n    ir.branch(f, ir.jump, 0, \"done\");\n    ir.branch(f, ir.label, 0, \"closure\");\n    trace_minimum(f, 48);\n    trace_kind(f, 4);\n    ir.put(f, ir.acquire_load, 14, 1, 0, 40);\n    trace_edge(f, 14, visitor);\n    ir.branch(f, ir.jump, 0, \"done\");\n    ir.branch(f, ir.label, 0, \"cell\");\n    trace_minimum(f, 16);\n    ir.put(f, ir.load, 7, 1, 0, 0);\n    tconstant(f, 6, 256);\n    ir.put(f, ir.divide_unsigned, 7, 7, 6, 0);\n    ir.branch(f, ir.zero, 7, \"done\");\n    ir.put(f, ir.acquire_load, 14, 1, 0, 8);\n    trace_edge(f, 14, visitor);\n    ir.branch(f, ir.jump, 0, \"done\");\n    ir.branch(f, ir.label, 0, \"environment\");\n    trace_minimum(f, 16);\n    trace_kind(f, 5);\n    ir.put(f, ir.load, 8, 1, 0, 8);\n    tconstant(f, 6, 16);\n    ir.put(f, ir.subtract, 17, 4, 6, 0);\n    tconstant(f, 6, 8);\n    ir.put(f, ir.divide_unsigned, 17, 17, 6, 0);\n    ir.put(f, ir.less_unsigned, 29, 17, 8, 0);\n    ir.branch(f, ir.nonzero, 29, \"invalid\");\n    ir.put(f, ir.address, 11, 1, 0, 16);\n    ir.branch(f, ir.jump, 0, \"linear\");\n    ir.branch(f, ir.label, 0, \"storage\");\n    trace_minimum(f, 32);\n    ir.put(f, ir.load, 7, 1, 0, 24);\n    ir.branch(f, ir.zero, 7, \"done\");\n    ir.put(f, ir.load, 8, 1, 0, 8);\n    tconstant(f, 6, 32);\n    ir.put(f, ir.subtract, 17, 4, 6, 0);\n    tconstant(f, 6, 8);\n    ir.put(f, ir.divide_unsigned, 17, 17, 6, 0);\n    ir.put(f, ir.less_unsigned, 29, 17, 8, 0);\n    ir.branch(f, ir.nonzero, 29, \"invalid\");\n    ir.put(f, ir.address, 11, 1, 0, 32);\n    ir.branch(f, ir.label, 0, \"linear\");\n    tconstant(f, 12, 0);\n    tconstant(f, 6, 8);\n    ir.branch(f, ir.label, 0, \"linear_item\");\n    ir.put(f, ir.equal, 29, 12, 8, 0);\n    ir.branch(f, ir.nonzero, 29, \"done\");\n    ir.put(f, ir.multiply, 13, 12, 6, 0);\n    ir.put(f, ir.add, 13, 11, 13, 0);\n    ir.put(f, ir.acquire_load, 14, 13, 0, 0);\n    trace_edge(f, 14, visitor);\n    tconstant(f, 29, 1);\n    ir.put(f, ir.add, 12, 12, 29, 0);\n    ir.branch(f, ir.jump, 0, \"linear_item\");\n    ir.branch(f, ir.label, 0, \"structure\");\n    trace_minimum(f, 32);\n    trace_kind(f, 1);\n    ir.put(f, ir.load, 8, 1, 0, 8);\n    ir.put(f, ir.load, 29, 1, 0, 16);\n    ir.put(f, ir.equal, 29, 8, 29, 0);\n    ir.branch(f, ir.zero, 29, \"invalid\");\n    ir.branch(f, ir.jump, 0, \"bitmap\");\n    ir.branch(f, ir.label, 0, \"enumeration\");\n    trace_minimum(f, 32);\n    trace_kind(f, 8);\n    ir.put(f, ir.load, 8, 1, 0, 16);\n    ir.branch(f, ir.label, 0, \"bitmap\");\n    ir.put(f, ir.load, 9, 1, 0, 24);\n    tconstant(f, 6, 32);\n    ir.put(f, ir.subtract, 17, 4, 6, 0);\n    tconstant(f, 6, 8);\n    ir.put(f, ir.divide_unsigned, 17, 17, 6, 0);\n    // Subtract first, avoiding overflow of bitmapWords+fieldCount.\n    ir.put(f, ir.less_unsigned, 29, 17, 9, 0);\n    ir.branch(f, ir.nonzero, 29, \"invalid\");\n    ir.put(f, ir.subtract, 17, 17, 9, 0);\n    ir.put(f, ir.less_unsigned, 29, 17, 8, 0);\n    ir.branch(f, ir.nonzero, 29, \"invalid\");\n    // ceil(count/64), with no count+63 overflow.\n    tconstant(f, 6, 64);\n    ir.put(f, ir.divide_unsigned, 16, 8, 6, 0);\n    ir.put(f, ir.multiply, 29, 16, 6, 0);\n    ir.put(f, ir.subtract, 29, 8, 29, 0);\n    ir.branch(f, ir.zero, 29, \"bitmap_words\");\n    tconstant(f, 29, 1);\n    ir.put(f, ir.add, 16, 16, 29, 0);\n    ir.branch(f, ir.label, 0, \"bitmap_words\");\n    ir.put(f, ir.equal, 29, 16, 9, 0);\n    ir.branch(f, ir.zero, 29, \"invalid\");\n    ir.put(f, ir.address, 10, 1, 0, 32);\n    tconstant(f, 6, 8);\n    ir.put(f, ir.multiply, 11, 9, 6, 0);\n    ir.put(f, ir.add, 11, 10, 11, 0);\n    tconstant(f, 12, 0);\n    ir.branch(f, ir.label, 0, \"bitmap_item\");\n    ir.put(f, ir.equal, 29, 12, 8, 0);\n    ir.branch(f, ir.nonzero, 29, \"done\");\n    tconstant(f, 6, 64);\n    ir.put(f, ir.divide_unsigned, 13, 12, 6, 0);\n    ir.put(f, ir.multiply, 20, 13, 6, 0);\n    ir.put(f, ir.subtract, 20, 12, 20, 0);\n    tconstant(f, 6, 8);\n    ir.put(f, ir.multiply, 13, 13, 6, 0);\n    ir.put(f, ir.add, 13, 10, 13, 0);\n    ir.put(f, ir.load, 18, 13, 0, 0);\n    tconstant(f, 6, 2);\n    ir.branch(f, ir.label, 0, \"shift\");\n    ir.branch(f, ir.zero, 20, \"bit\");\n    ir.put(f, ir.divide_unsigned, 18, 18, 6, 0);\n    tconstant(f, 29, 1);\n    ir.put(f, ir.subtract, 20, 20, 29, 0);\n    ir.branch(f, ir.jump, 0, \"shift\");\n    ir.branch(f, ir.label, 0, \"bit\");\n    ir.put(f, ir.divide_unsigned, 29, 18, 6, 0);\n    ir.put(f, ir.multiply, 29, 29, 6, 0);\n    ir.put(f, ir.subtract, 29, 18, 29, 0);\n    ir.branch(f, ir.zero, 29, \"bitmap_next\");\n    tconstant(f, 6, 8);\n    ir.put(f, ir.multiply, 13, 12, 6, 0);\n    ir.put(f, ir.add, 13, 11, 13, 0);\n    ir.put(f, ir.acquire_load, 14, 13, 0, 0);\n    trace_edge(f, 14, visitor);\n    ir.branch(f, ir.label, 0, \"bitmap_next\");\n    tconstant(f, 29, 1);\n    ir.put(f, ir.add, 12, 12, 29, 0);\n    ir.branch(f, ir.jump, 0, \"bitmap_item\");\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    ir.branch(f, ir.label, 0, \"invalid\");\n    treturn(f, 4);\n    ir.branch(f, ir.label, 0, \"visitor_failed\");\n    ir.put(f, ir.result, 0, 15, 0, 0);\n    kaesu f;\n}\nkoukai waza trace_program() -> []ir.Function { kaesu trace_program_with_visitor(\"\"); }\n// Internal neutral visitor calls preserve the Runtime IR imports ABI, without\n// requiring a foreign native callback to carry a hidden import-table register.\nkoukai waza trace_program_with_visitor(visitor: string) -> []ir.Function { kaesu [trace_object_program(visitor)]; }\n" }; }
waza data_119() -> File { kaesu File { path: "kiso/runtime/gc/work_queue.mio", version: "Bunko-v2.1.1", length: 9123, sha256: "8db84e2114657aec7c4c37c66e6ad1d786bea1c6253d270c263d03a100a75357", source: "// Epoch-scoped bounded collector work queue. Neutral IR only. Caller owns\n// ctx(128B), aligned buffer and object lifetimes until every worker joins.\n// Lock0, buffer8, capacity16, head24, tail32, count40, active48, closed56,\n// error64, published72, taken80, completed88, overflow96, optional exact deferred-task count104, epoch112.\n// Results:0 success,1 full/empty,2 lock contention,4 protocol error. No item\n// is silently dropped. A full offer leaves the overwritten reference owned by\n// its caller, which must retry or Abort the entire GC without reclaiming.\nkoukai teisu gc_work_context_bytes = 128;\nwaza work_lock_program() -> ir.Function {\n    kaku f = ir.function(\"gc_work_lock\");\n    tconstant(f, 10, 0);\n    tconstant(f, 11, 1);\n    tconstant(f, 12, 0);\n    tconstant(f, 13, 1024);\n    ir.branch(f, ir.label, 0, \"retry\");\n    array.push(f.steps, ir.Step {\n            kind: ir.compare_exchange, destination: 14, left: 0, right: 11, immediate: 0, name: \"\", arguments: [10], order: acq_rel, failure_order: acquire });\n    ir.branch(f, ir.zero, 14, \"locked\");\n    ir.put(f, ir.add, 12, 12, 11, 0);\n    ir.put(f, ir.less_unsigned, 14, 12, 13, 0);\n    ir.branch(f, ir.nonzero, 14, \"retry\");\n    treturn(f, 2);\n    ir.branch(f, ir.label, 0, \"locked\");\n    treturn(f, 0);\n    kaesu f;\n}\nwaza work_unlock(f: ir.Function) -> unit {\n    tconstant(f, 31, 0);\n    ir.put(f, ir.release_store, 0, 0, 31, 0);\n}\nwaza work_enter(f: ir.Function) -> unit {\n    ir.invoke_function(f, \"gc_work_lock\", 5, [0]);\n    ir.branch(f, ir.nonzero, 5, \"busy\");\n    ir.branch(f, ir.zero, 1, \"invalid\");\n    ir.put(f, ir.load, 6, 0, 0, 8);\n    ir.branch(f, ir.zero, 6, \"invalid\");\n    ir.put(f, ir.load, 6, 0, 0, 16);\n    ir.branch(f, ir.zero, 6, \"invalid\");\n    ir.put(f, ir.load, 6, 0, 0, 112);\n    ir.put(f, ir.equal, 6, 6, 1, 0);\n    ir.branch(f, ir.zero, 6, \"invalid\");\n    ir.put(f, ir.load, 6, 0, 0, 64);\n    ir.branch(f, ir.nonzero, 6, \"invalid\");\n}\nwaza work_tails(f: ir.Function) -> unit {\n    ir.branch(f, ir.label, 0, \"invalid\");\n    work_unlock(f);\n    treturn(f, 4);\n    ir.branch(f, ir.label, 0, \"busy\");\n    treturn(f, 2);\n}\nwaza work_increment(f: ir.Function, off: int64) -> unit {\n    ir.put(f, ir.load, 28, 0, 0, off);\n    tconstant(f, 29, 1);\n    ir.put(f, ir.add, 28, 28, 29, 0);\n    ir.put(f, ir.release_store, 0, 0, 28, off);\n}\nwaza work_configure_program() -> ir.Function {\n    // ctx,buffer,capacity,buffer_bytes,epoch. Reuse requires closed+quiet and a\n    // strictly newer Epoch. A stale caller cannot access a reconfigured buffer.\n    kaku f = ir.function(\"gc_work_configure\");\n    ir.invoke_function(f, \"gc_work_lock\", 5, [0]);\n    ir.branch(f, ir.nonzero, 5, \"busy\");\n    ir.branch(f, ir.zero, 1, \"invalid\");\n    ir.branch(f, ir.zero, 2, \"invalid\");\n    ir.branch(f, ir.zero, 4, \"invalid\");\n    tconstant(f, 6, 8);\n    ir.put(f, ir.divide_unsigned, 7, 1, 6, 0);\n    ir.put(f, ir.multiply, 7, 7, 6, 0);\n    ir.put(f, ir.equal, 7, 7, 1, 0);\n    ir.branch(f, ir.zero, 7, \"invalid\");\n    ir.put(f, ir.divide_unsigned, 7, 3, 6, 0);\n    ir.put(f, ir.less_unsigned, 7, 7, 2, 0);\n    ir.branch(f, ir.nonzero, 7, \"invalid\");\n    ir.put(f, ir.add, 7, 1, 3, 0);\n    ir.put(f, ir.less_unsigned, 7, 7, 1, 0);\n    ir.branch(f, ir.nonzero, 7, \"invalid\");\n    ir.put(f, ir.load, 6, 0, 0, 112);\n    ir.put(f, ir.less_unsigned, 7, 6, 4, 0);\n    ir.branch(f, ir.zero, 7, \"invalid\");\n    ir.branch(f, ir.zero, 6, \"configure\");\n    ir.put(f, ir.load, 7, 0, 0, 56);\n    ir.branch(f, ir.zero, 7, \"invalid\");\n    ir.put(f, ir.load, 7, 0, 0, 40);\n    ir.branch(f, ir.nonzero, 7, \"invalid\");\n    ir.put(f, ir.load, 7, 0, 0, 48);\n    ir.branch(f, ir.nonzero, 7, \"invalid\");\n    ir.branch(f, ir.label, 0, \"configure\");\n    ir.put(f, ir.store, 0, 0, 1, 8);\n    ir.put(f, ir.store, 0, 0, 2, 16);\n    ir.put(f, ir.store, 0, 0, 4, 112);\n    tconstant(f, 6, 0);\n    kaku off = 24;\n    aida (off <= 104) {\n        ir.put(f, ir.store, 0, 0, 6, off);\n        off = off + 8;\n    }\n    work_unlock(f);\n    treturn(f, 0);\n    work_tails(f);\n    kaesu f;\n}\nwaza work_offer_program() -> ir.Function {\n    // ctx,epoch,non-null exact reference. It never guesses numeric values.\n    kaku f = ir.function(\"gc_work_offer\");\n    work_enter(f);\n    ir.branch(f, ir.zero, 2, \"invalid\");\n    tconstant(f, 6, 16);\n    ir.put(f, ir.divide_unsigned, 7, 2, 6, 0);\n    ir.put(f, ir.multiply, 7, 7, 6, 0);\n    ir.put(f, ir.equal, 7, 7, 2, 0);\n    ir.branch(f, ir.zero, 7, \"invalid\");\n    ir.put(f, ir.load, 6, 0, 0, 56);\n    ir.branch(f, ir.nonzero, 6, \"invalid\");\n    ir.put(f, ir.load, 7, 0, 0, 40);\n    ir.put(f, ir.load, 8, 0, 0, 16);\n    ir.put(f, ir.less_unsigned, 6, 7, 8, 0);\n    ir.branch(f, ir.zero, 6, \"full\");\n    ir.put(f, ir.load, 9, 0, 0, 32);\n    ir.put(f, ir.load, 10, 0, 0, 8);\n    tconstant(f, 11, 8);\n    ir.put(f, ir.multiply, 11, 9, 11, 0);\n    ir.put(f, ir.add, 10, 10, 11, 0);\n    ir.put(f, ir.store, 0, 10, 2, 0);\n    tconstant(f, 11, 1);\n    ir.put(f, ir.add, 9, 9, 11, 0);\n    ir.put(f, ir.equal, 6, 9, 8, 0);\n    ir.branch(f, ir.zero, 6, \"tail_ready\");\n    tconstant(f, 9, 0);\n    ir.branch(f, ir.label, 0, \"tail_ready\");\n    ir.put(f, ir.store, 0, 0, 9, 32);\n    ir.put(f, ir.add, 7, 7, 11, 0);\n    ir.put(f, ir.store, 0, 0, 7, 40);\n    work_increment(f, 72);\n    work_unlock(f);\n    treturn(f, 0);\n    ir.branch(f, ir.label, 0, \"full\");\n    work_increment(f, 96);\n    work_unlock(f);\n    treturn(f, 1);\n    work_tails(f);\n    kaesu f;\n}\nwaza work_take_program() -> ir.Function {\n    // ctx,epoch,out*. Return status separately from a potential pointer value.\n    kaku f = ir.function(\"gc_work_take\");\n    ir.branch(f, ir.zero, 2, \"bad_out\");\n    tconstant(f, 6, 0);\n    ir.put(f, ir.store, 0, 2, 6, 0);\n    work_enter(f);\n    ir.put(f, ir.load, 7, 0, 0, 40);\n    ir.branch(f, ir.zero, 7, \"empty\");\n    ir.put(f, ir.load, 8, 0, 0, 16);\n    ir.put(f, ir.load, 9, 0, 0, 24);\n    ir.put(f, ir.load, 10, 0, 0, 8);\n    tconstant(f, 11, 8);\n    ir.put(f, ir.multiply, 11, 9, 11, 0);\n    ir.put(f, ir.add, 10, 10, 11, 0);\n    ir.put(f, ir.load, 12, 10, 0, 0);\n    ir.put(f, ir.store, 0, 2, 12, 0);\n    tconstant(f, 12, 0);\n    ir.put(f, ir.store, 0, 10, 12, 0);\n    tconstant(f, 11, 1);\n    ir.put(f, ir.add, 9, 9, 11, 0);\n    ir.put(f, ir.equal, 6, 9, 8, 0);\n    ir.branch(f, ir.zero, 6, \"head_ready\");\n    tconstant(f, 9, 0);\n    ir.branch(f, ir.label, 0, \"head_ready\");\n    ir.put(f, ir.store, 0, 0, 9, 24);\n    ir.put(f, ir.subtract, 7, 7, 11, 0);\n    ir.put(f, ir.store, 0, 0, 7, 40);\n    work_increment(f, 48);\n    work_increment(f, 80);\n    work_unlock(f);\n    treturn(f, 0);\n    ir.branch(f, ir.label, 0, \"empty\");\n    work_unlock(f);\n    treturn(f, 1);\n    ir.branch(f, ir.label, 0, \"bad_out\");\n    treturn(f, 4);\n    work_tails(f);\n    kaesu f;\n}\nwaza work_complete_program() -> ir.Function {\n    kaku f = ir.function(\"gc_work_complete\");\n    work_enter(f);\n    ir.put(f, ir.load, 7, 0, 0, 48);\n    ir.branch(f, ir.zero, 7, \"invalid\");\n    tconstant(f, 8, 1);\n    ir.put(f, ir.subtract, 7, 7, 8, 0);\n    ir.put(f, ir.store, 0, 0, 7, 48);\n    work_increment(f, 88);\n    work_unlock(f);\n    treturn(f, 0);\n    work_tails(f);\n    kaesu f;\n}\nwaza work_close_program() -> ir.Function {\n    kaku f = ir.function(\"gc_work_close\");\n    work_enter(f);\n    tconstant(f, 6, 1);\n    ir.put(f, ir.store, 0, 0, 6, 56);\n    work_unlock(f);\n    treturn(f, 0);\n    work_tails(f);\n    kaesu f;\n}\nwaza work_quiet_program() -> ir.Function {\n    // Quiescence requires closed producer input AND no queued/in-flight work.\n    // This queue condition does not replace an all-Mutator Remark handshake.\n    kaku f = ir.function(\"gc_work_quiet\");\n    work_enter(f);\n    ir.put(f, ir.load, 6, 0, 0, 56);\n    ir.branch(f, ir.zero, 6, \"no\");\n    ir.put(f, ir.load, 6, 0, 0, 40);\n    ir.branch(f, ir.nonzero, 6, \"no\");\n    ir.put(f, ir.load, 6, 0, 0, 48);\n    ir.branch(f, ir.nonzero, 6, \"no\");\n    ir.put(f, ir.acquire_load, 6, 0, 0, 104);\n    ir.branch(f, ir.nonzero, 6, \"no\");\n    work_unlock(f);\n    treturn(f, 1);\n    ir.branch(f, ir.label, 0, \"no\");\n    work_unlock(f);\n    treturn(f, 0);\n    work_tails(f);\n    kaesu f;\n}\nwaza work_abort_program() -> ir.Function {\n    // Abort closes input and preserves the first error. It never frees queued\n    // objects/buffers, and quiet cannot be mistaken for permission to reclaim.\n    kaku f = ir.function(\"gc_work_abort\");\n    ir.invoke_function(f, \"gc_work_lock\", 5, [0]);\n    ir.branch(f, ir.nonzero, 5, \"busy\");\n    ir.put(f, ir.load, 6, 0, 0, 112);\n    ir.put(f, ir.equal, 6, 6, 1, 0);\n    ir.branch(f, ir.zero, 6, \"invalid\");\n    ir.branch(f, ir.zero, 2, \"invalid\");\n    ir.put(f, ir.load, 6, 0, 0, 64);\n    ir.branch(f, ir.nonzero, 6, \"closed\");\n    ir.put(f, ir.store, 0, 0, 2, 64);\n    ir.branch(f, ir.label, 0, \"closed\");\n    tconstant(f, 6, 1);\n    ir.put(f, ir.store, 0, 0, 6, 56);\n    work_unlock(f);\n    treturn(f, 0);\n    work_tails(f);\n    kaesu f;\n}\nkoukai waza work_queue_program() -> []ir.Function {\n    kaesu [work_lock_program(), work_configure_program(), work_offer_program(), work_take_program(), work_complete_program(), work_close_program(), work_quiet_program(), work_abort_program()];\n}\n" }; }
waza data_120() -> File { kaesu File { path: "kiso/runtime/ir/ir.mio", version: "Bunko-v2.1.1", length: 4126, sha256: "931ad81692fd0d5120cdcc0ab89a6afbece81c6a1ab3b9ad4771e825d168a38e", source: "yobu \"kiso/array\";\n// Target-neutral scalar runtime IR. Virtual registers hold native words, not\n// managed Mio values. Building a program happens in the compiler; executing it\n// requires no managed allocation. Labels/functions are symbolic, never PCs.\nkoukai teisu constant = 1;\nkoukai teisu copy = 2;\nkoukai teisu address = 3;\nkoukai teisu load = 4;\nkoukai teisu store = 5;\nkoukai teisu add = 6;\nkoukai teisu subtract = 7;\nkoukai teisu multiply = 8;\nkoukai teisu divide_unsigned = 9;\nkoukai teisu equal = 10;\nkoukai teisu less_unsigned = 11;\nkoukai teisu label = 12;\nkoukai teisu jump = 13;\nkoukai teisu zero = 14;\nkoukai teisu nonzero = 15;\nkoukai teisu system = 16;\nkoukai teisu invoke = 17;\nkoukai teisu function_address = 18;\nkoukai teisu result = 19;\nkoukai teisu acquire_load = 20;\nkoukai teisu release_store = 21;\nkoukai teisu fetch_add = 22;\nkoukai teisu compare_exchange = 23;\nkoukai teisu imports = 24;\nkoukai teisu scratch_address = 25;\n// Extra portable OS services; 1..22 retain RuntimeOp's original identities.\nkoukai teisu tls_create = 23;\nkoukai teisu tls_destroy = 24;\nkoukai teisu mutex_create = 25;\nkoukai teisu mutex_destroy = 26;\nkoukai teisu mutex_lock = 27;\nkoukai teisu mutex_unlock = 28;\nkoukai teisu condition_create = 29;\nkoukai teisu condition_destroy = 30;\nkoukai teisu abort_runtime = 31;\n// A binding maps abstract operands to a public native ABI. Negative selectors\n// denote literal (-selector-1), e.g. -1 is NULL. Core code never names symbols.\nkoukai kata Binding {\n    operation: int64;\n    slot: int64;\n    arguments: []int64;\n    result_bits: int64;\n}\nkoukai kata Step {\n    kind: int64;\n    destination: int64;\n    left: int64;\n    right: int64;\n    immediate: int64;\n    name: string;\n    arguments: []int64;\n    order: int64;\n    failure_order: int64;\n}\nkoukai kata Function {\n    name: string;\n    steps: []Step;\n}\nkoukai waza function(name: string) -> Function { kaesu Function { name: name, steps: [] }; }\nkoukai waza step(kind: int64, destination: int64, left: int64, right: int64, immediate: int64, name: string, arguments: []int64) -> Step {\n    kaesu Step {\n        kind: kind, destination: destination, left: left, right: right, immediate: immediate, name: name, arguments: arguments, order: 0, failure_order: 0 };\n}\nkoukai waza put(f: Function, kind: int64, destination: int64, left: int64, right: int64, immediate: int64) -> unit {\n    array.push(f.steps, step(kind, destination, left, right, immediate, \"\", []));\n}\nkoukai waza branch(f: Function, kind: int64, value: int64, name: string) -> unit { array.push(f.steps, step(kind, 0, value, 0, 0, name, [])); }\nkoukai waza call(f: Function, operation: int64, destination: int64, arguments: []int64) -> unit {\n    array.push(f.steps, step(system, destination, 0, 0, operation, \"\", arguments));\n}\nkoukai waza invoke_function(f: Function, name: string, destination: int64, arguments: []int64) -> unit {\n    array.push(f.steps, step(invoke, destination, 0, 0, 0, name, arguments));\n}\nkoukai waza function_pointer(f: Function, name: string, destination: int64) -> unit {\n    array.push(f.steps, step(function_address, destination, 0, 0, 0, name, []));\n}\nkoukai waza valid_step(s: Step) -> bool {\n    moshi (s.kind<constant || s.kind>scratch_address || s.destination<0 || s.destination >= 32 || s.left<0 || s.left >= 32 || s.right<0 || s.right >= 32 || len(s.arguments)>7) {\n        kaesu iie;\n    }\n    moshi ((s.kind == load || s.kind == store || s.kind == acquire_load || s.kind == release_store || s.kind == address) && (s.immediate<0 || s.immediate>32760 || s.immediate - (s.immediate / 8) * 8 != 0)) {\n        kaesu iie;\n    }\n    moshi (s.kind == scratch_address && (s.immediate<0 || s.immediate>56 || s.immediate - (s.immediate / 8) * 8 != 0)) { kaesu iie; }\n    moshi ((s.kind == label || s.kind == jump || s.kind == zero || s.kind == nonzero || s.kind == invoke || s.kind == function_address) && s.name == \"\") {\n        kaesu iie;\n    }\n    kaku i = 0;\n    aida (i<len(s.arguments)) {\n        moshi (s.arguments[i]<0 || s.arguments[i] >= 32) {\n            kaesu iie;\n        }\n        i = i + 1;\n    }\n    kaesu hai;\n}\n" }; }
waza data_121() -> File { kaesu File { path: "kiso/runtime/os/darwin/link.mio", version: "Bunko-v2.1.1", length: 4768, sha256: "f948fda72c811820850f4ef3ad46b3fcbea9ea67894815a9f1910d6999f1de54", source: "yobu \"kiso/aot/macho\";\nyobu \"kiso/array\";\nyobu \"kiso/string\";\n// Public libSystem ABI bridge. Reuses the established Mach-O writer without\n// changing its static executable format. Replace the two empty symbol-table\n// commands with LC_LOAD_DYLIB and LC_DYLD_INFO_ONLY of identical total size.\n// Each import binds one 8-byte __DATA slot. No C compiler or external linker.\nkoukai kata LinkedImage {\n    bytes: []uint8;\n    error: string;\n}\nwaza get32(bytes: []uint8, at: int64) -> int64 {\n    kaesu int64(bytes[at]) + int64(bytes[at + 1]) * 256 + int64(bytes[at + 2]) * 65536 + int64(bytes[at + 3]) * 16777216;\n}\nwaza put32(bytes: []uint8, at: int64, value: int64) -> unit {\n    kaku x = value;\n    kaku i = 0;\n    aida (i<4) {\n        bytes[at + i] = uint8(x - (x / 256) * 256);\n        x = x / 256;\n        i = i + 1;\n    }\n}\nwaza uleb(bytes: []uint8, value: int64) -> unit {\n    kaku x = value;\n    aida (x >= 128) {\n        array.push(bytes, uint8(x - (x / 128) * 128 + 128));\n        x = x / 128;\n    }\n    array.push(bytes, uint8(x));\n}\n// Legacy raw fixtures explicitly reserve the initial data slots.\nkoukai waza executable(spec: macho.ImageSpec, symbols: []string) -> LinkedImage {\n    moshi (len(symbols) == 0 || len(symbols)>spec.globals) { kaesu LinkedImage { bytes: [], error: \"invalid import slots\" }; }\n    kaesu bind_image(macho.executable(spec), symbols, 0);\n}\n// Production placement: append imports AFTER all user and existing private words.\n// Source global capacity and indices are unchanged. Additional runtime words are\n// also appended and never interpreted as managed roots by source type analysis.\nkoukai waza executable_appended(spec: macho.ImageSpec, symbols: []string, runtime_words: int64) -> LinkedImage {\n    moshi (len(symbols) == 0 || len(symbols)>4096 || runtime_words<0 || runtime_words>1048576) {\n        kaesu LinkedImage { bytes: [], error: \"invalid appended runtime layout\" };\n    }\n    kaesu bind_image(macho.executable_with_runtime_data(spec, len(symbols) + runtime_words), symbols, spec.globals);\n}\nwaza bind_image(base: macho.ImageResult, symbols: []string, first_word: int64) -> LinkedImage {\n    moshi (base.error != mu) { kaesu LinkedImage { bytes: [], error: \"Mach-O image failure\" }; }\n    kaku bytes = base.bytes;\n    kaku at = 32;\n    kaku index = 0;\n    kaku sym = -1;\n    kaku link = -1;\n    aida (index<get32(bytes, 16)) {\n        kaku cmd = get32(bytes, at);\n        kaku size = get32(bytes, at + 4);\n        moshi (cmd == 2) { sym = at; }\n        moshi (cmd == 25 && bytes[at + 10] == uint8(76)) { link = at; }\n        at = at + size;\n        index = index + 1;\n    }\n    moshi (sym<0 || link<0 || get32(bytes, sym + 24) != 11 || get32(bytes, sym + 28) != 80) {\n        kaesu LinkedImage {\n            bytes: [], error: \"unexpected static commands\" };\n    }\n    // dylib_command + path incl NUL, padded to 56 bytes.\n    index = 0;\n    aida (index<104) {\n        bytes[sym + index] = uint8(0);\n        index = index + 1;\n    }\n    put32(bytes, sym, 12);\n    put32(bytes, sym + 4, 56);\n    put32(bytes, sym + 8, 24);\n    put32(bytes, sym + 16, 65536);\n    put32(bytes, sym + 20, 65536);\n    kaku path = string.to_bytes(\"/usr/lib/libSystem.B.dylib\");\n    index = 0;\n    aida (index<len(path)) {\n        bytes[sym + 24 + index] = path[index];\n        index = index + 1;\n    }\n    kaku info = sym + 56;\n    put32(bytes, info, 2147483682);\n    put32(bytes, info + 4, 48);\n    kaku stream: []uint8 = [];\n    array.push(stream, uint8(17));\n    array.push(stream, uint8(81)); // ordinal 1, pointer\n    index = 0;\n    aida (index<len(symbols)) {\n        kaku name = string.to_bytes(symbols[index]);\n        moshi (len(name)<2 || name[0] != uint8(95)) { kaesu LinkedImage { bytes: [], error: \"invalid public ABI symbol\" }; }\n        kaku ni = 0;\n        array.push(stream, uint8(64));\n        aida (ni<len(name)) {\n            moshi (name[ni] == uint8(0)) {\n                kaesu LinkedImage {\n                    bytes: [], error: \"embedded NUL symbol\" };\n            }\n            array.push(stream, name[ni]);\n            ni = ni + 1;\n        }\n        array.push(stream, uint8(0));\n        array.push(stream, uint8(114));\n        uleb(stream, (first_word + index) * 8); // DATA segment 2\n        array.push(stream, uint8(144));\n        index = index + 1;\n    }\n    array.push(stream, uint8(0));\n    kaku offset = len(bytes);\n    put32(bytes, info + 16, offset);\n    put32(bytes, info + 20, len(stream));\n    array.append_all(bytes, stream);\n    aida (len(bytes) - (len(bytes) / 16) * 16 != 0) {\n        array.push(bytes, uint8(0));\n    }\n    put32(bytes, link + 32, ((len(bytes) - offset + 16383) / 16384) * 16384);\n    put32(bytes, link + 48, len(bytes) - offset);\n    kaesu LinkedImage { bytes: bytes, error: \"\" };\n}\n" }; }
waza data_122() -> File { kaesu File { path: "kiso/runtime/os/darwin/operations.mio", version: "Bunko-v2.1.1", length: 4499, sha256: "da5697ee423118cd5e67a7e3cc92a67c76363932f6863928d2be17ca49ec2a2f", source: "yobu \"kiso/runtime/ir\";\nyobu \"kiso/array\";\n// Public ABI mapping data only. CPU code generation is a separate consumer.\n// 100/101 are adapter-private raw wait/clock calls; portable core calls the\n// platform_wait/platform_now functions whose units/results are target-neutral.\nkoukai waza thread_bindings() -> []ir.Binding {\n    kaesu [\n        ir.Binding { operation: 6, slot: 0, arguments: [0, -1, 1, 2], result_bits: 32 },\n        ir.Binding { operation: 7, slot: 1, arguments: [0, 1], result_bits: 32 },\n        ir.Binding { operation: 8, slot: 2, arguments: [], result_bits: 64 },\n        ir.Binding { operation: 9, slot: 5, arguments: [0], result_bits: 64 },\n        ir.Binding { operation: 10, slot: 4, arguments: [0, 1], result_bits: 32 },\n        ir.Binding { operation: 12, slot: 14, arguments: [0], result_bits: 32 },\n        ir.Binding { operation: 23, slot: 3, arguments: [0, -1], result_bits: 32 },\n        ir.Binding { operation: 24, slot: 6, arguments: [0], result_bits: 32 },\n        ir.Binding { operation: 25, slot: 9, arguments: [0, -1], result_bits: 32 },\n        ir.Binding { operation: 26, slot: 16, arguments: [0], result_bits: 32 },\n        ir.Binding { operation: 27, slot: 10, arguments: [0], result_bits: 32 },\n        ir.Binding { operation: 28, slot: 11, arguments: [0], result_bits: 32 },\n        ir.Binding { operation: 29, slot: 12, arguments: [0, -1], result_bits: 32 },\n        ir.Binding { operation: 30, slot: 15, arguments: [0], result_bits: 32 },\n        ir.Binding { operation: 31, slot: 7, arguments: [0], result_bits: 64 },\n        ir.Binding { operation: 100, slot: 13, arguments: [0, 1, 2], result_bits: 32 },\n        ir.Binding { operation: 101, slot: 17, arguments: [-7, 0], result_bits: 32 },\n        ir.Binding { operation: 102, slot: 7, arguments: [0], result_bits: 64 },\n        ir.Binding { operation: 103, slot: 8, arguments: [-2, 0, 1], result_bits: 64 },\n        ir.Binding { operation: 104, slot: 19, arguments: [0], result_bits: 32 },\n        ir.Binding { operation: 105, slot: 20, arguments: [0], result_bits: 32 }\n    ];\n}\nkoukai waza thread_platform_program() -> []ir.Function {\n    kaku wait = ir.function(\"platform_wait\");\n    ir.put(wait, ir.scratch_address, 3, 0, 0, 0);\n    ir.put(wait, ir.constant, 4, 0, 0, 1000000000);\n    ir.put(wait, ir.divide_unsigned, 5, 2, 4, 0);\n    ir.put(wait, ir.multiply, 6, 5, 4, 0);\n    ir.put(wait, ir.subtract, 6, 2, 6, 0);\n    ir.put(wait, ir.store, 0, 3, 5, 0);\n    ir.put(wait, ir.store, 0, 3, 6, 8);\n    ir.call(wait, 100, 4, [0, 1, 3]);\n    ir.branch(wait, ir.zero, 4, \"return\");\n    // Darwin ETIMEDOUT=60 is confined to this adapter. Generic wait result is\n    // zero for wake, one for timeout, negative native errno for other errors.\n    ir.put(wait, ir.constant, 5, 0, 0, 60);\n    ir.put(wait, ir.equal, 5, 4, 5, 0);\n    ir.branch(wait, ir.zero, 5, \"error\");\n    ir.put(wait, ir.constant, 4, 0, 0, 1);\n    ir.branch(wait, ir.jump, 0, \"return\");\n    ir.branch(wait, ir.label, 0, \"error\");\n    ir.put(wait, ir.constant, 5, 0, 0, 0);\n    ir.put(wait, ir.subtract, 4, 5, 4, 0);\n    ir.branch(wait, ir.label, 0, \"return\");\n    ir.put(wait, ir.result, 0, 4, 0, 0);\n    kaku clock = ir.function(\"platform_now\");\n    ir.put(clock, ir.scratch_address, 1, 0, 0, 0);\n    ir.call(clock, 101, 2, [1]);\n    ir.branch(clock, ir.nonzero, 2, \"error\");\n    ir.put(clock, ir.load, 2, 1, 0, 0);\n    ir.put(clock, ir.load, 3, 1, 0, 8);\n    ir.put(clock, ir.constant, 4, 0, 0, 1000000000);\n    ir.put(clock, ir.multiply, 2, 2, 4, 0);\n    ir.put(clock, ir.add, 2, 2, 3, 0);\n    ir.put(clock, ir.result, 0, 2, 0, 0);\n    ir.branch(clock, ir.label, 0, \"error\");\n    ir.put(clock, ir.constant, 2, 0, 0, 0);\n    ir.put(clock, ir.result, 0, 2, 0, 0);\n    kaku trylock = ir.function(\"platform_trylock\");\n    ir.call(trylock, 104, 1, [0]);\n    ir.branch(trylock, ir.zero, 1, \"done\");\n    ir.put(trylock, ir.constant, 2, 0, 0, 16);\n    ir.put(trylock, ir.equal, 2, 1, 2, 0);\n    ir.branch(trylock, ir.zero, 2, \"error\");\n    ir.put(trylock, ir.constant, 1, 0, 0, 1);\n    ir.branch(trylock, ir.jump, 0, \"done\");\n    ir.branch(trylock, ir.label, 0, \"error\");\n    ir.put(trylock, ir.constant, 2, 0, 0, 0);\n    ir.put(trylock, ir.subtract, 1, 2, 1, 0);\n    ir.branch(trylock, ir.label, 0, \"done\");\n    ir.put(trylock, ir.result, 0, 1, 0, 0);\n    kaku broadcast = ir.function(\"platform_wake_all\");\n    ir.call(broadcast, 105, 1, [0]);\n    ir.put(broadcast, ir.result, 0, 1, 0, 0);\n    kaesu [wait, clock, trylock, broadcast];\n}\n" }; }
waza data_123() -> File { kaesu File { path: "kiso/runtime/os/darwin/thread.mio", version: "Bunko-v2.1.1", length: 1274, sha256: "e69bfc0fa1ade5cf412b41a98b1404cea84cb16d889ea9cebc4767f74aa1ae6e", source: "yobu \"kiso/runtime/target\";\n// Stable import table for the first public Darwin thread bridge. Native code\n// calls the documented ABI; pthread opaque sizes belong only to this adapter.\nkoukai teisu thread_symbol_count = 21;\nkoukai teisu mutex_bytes = 64;\nkoukai teisu condition_bytes = 48;\nkoukai waza thread_symbols() -> []string {\n    kaesu [\"_pthread_create\",\"_pthread_join\",\"_pthread_self\",\"_pthread_key_create\",\n        \"_pthread_setspecific\",\"_pthread_getspecific\",\"_pthread_key_delete\",\"_exit\",\"_write\",\n        \"_pthread_mutex_init\",\"_pthread_mutex_lock\",\"_pthread_mutex_unlock\",\n        \"_pthread_cond_init\",\"_pthread_cond_timedwait_relative_np\",\"_pthread_cond_signal\",\n        \"_pthread_cond_destroy\",\"_pthread_mutex_destroy\",\"_clock_gettime\",\"_getpagesize\",\"_pthread_mutex_trylock\",\"_pthread_cond_broadcast\"];\n}\nkoukai waza capabilities() -> target.TargetInfo {\n    // Thread primitive witnesses do NOT establish multi-mutator root safety.\n    kaesu target.TargetInfo {os:\"darwin\",arch:\"arm64\",abi:\"aapcs64-darwin\",pointer_bits:64,\n        little_endian:hai,page_size_query:hai,atomic64:hai,threads:hai,tls:hai,park_wake:hai,\n        monotonic_clock:hai,virtual_memory:iie,precise_roots:iie,stack_alignment:16,\n        concurrent_collector:iie,executable:hai};\n}\n" }; }
waza data_124() -> File { kaesu File { path: "kiso/runtime/os/darwin/worker.mio", version: "Bunko-v2.1.1", length: 3010, sha256: "897bd7c3500d8da43aa2c94d52e66e45d3adef078f3fd2602daa0c1b0af9eb71", source: "// Public pthread attributes ABI. LP64 Darwin pthread_attr_t is 64 bytes\n// (long signature + 56 opaque bytes), contained in the IR's 64-byte scratch.\n// Stack policy belongs to this adapter, never to the portable GC algorithms.\nkoukai teisu worker_stack_bytes = 8388608;\nkoukai waza worker_symbols() -> []string {\n    kaku symbols = thread_symbols();\n    array.append_all(symbols, [\"_pthread_attr_init\", \"_pthread_attr_setstacksize\", \"_pthread_attr_destroy\", \"_posix_spawn\"]);\n    kaesu symbols;\n}\nkoukai waza worker_bindings() -> []ir.Binding {\n    kaku bindings = thread_bindings();\n    array.push(bindings, ir.Binding { operation: 106, slot: 21, arguments: [0], result_bits: 32 });\n    array.push(bindings, ir.Binding { operation: 107, slot: 22, arguments: [0, 1], result_bits: 32 });\n    array.push(bindings, ir.Binding { operation: 108, slot: 23, arguments: [0], result_bits: 32 });\n    array.push(bindings, ir.Binding { operation: 109, slot: 0, arguments: [0, 1, 2, 3], result_bits: 32 });\n    array.push(bindings, ir.Binding {\n            operation: 110, slot: 24, arguments: [0, 1, 2, 3, 4, 5], result_bits: 32 });\n    kaesu bindings;\n}\nkoukai waza worker_platform_program() -> []ir.Function {\n    kaku f = ir.function(\"platform_thread_start\");\n    // handle*, entry, argument, first-cleanup-error*. A successful create must\n    // remain success even if attribute cleanup fails: the parent owns a real\n    // handle and must not lose it. Cleanup errors are independently CAS-latched.\n    ir.put(f, ir.scratch_address, 4, 0, 0, 0);\n    ir.call(f, 106, 5, [4]);\n    ir.branch(f, ir.nonzero, 5, \"init_failed\");\n    ir.put(f, ir.constant, 6, 0, 0, worker_stack_bytes);\n    ir.call(f, 107, 5, [4, 6]);\n    ir.branch(f, ir.nonzero, 5, \"configuration_failed\");\n    ir.call(f, 109, 7, [0, 4, 1, 2]);\n    ir.branch(f, ir.jump, 0, \"destroy\");\n    ir.branch(f, ir.label, 0, \"configuration_failed\");\n    ir.put(f, ir.copy, 7, 5, 0, 0);\n    ir.branch(f, ir.label, 0, \"destroy\");\n    ir.branch(f, ir.zero, 7, \"cleanup\");\n    ir.put(f, ir.constant, 8, 0, 0, 0);\n    array.push(f.steps, ir.Step {\n            kind: ir.compare_exchange, destination: 9, left: 3, right: 7, immediate: 0, name: \"\", arguments: [8], order: 3, failure_order: 1 });\n    ir.branch(f, ir.label, 0, \"cleanup\");\n    ir.call(f, 108, 5, [4]);\n    ir.branch(f, ir.zero, 5, \"result\");\n    ir.put(f, ir.constant, 8, 0, 0, 0);\n    array.push(f.steps, ir.Step {\n            kind: ir.compare_exchange, destination: 9, left: 3, right: 5, immediate: 0, name: \"\", arguments: [8], order: 3, failure_order: 1 });\n    ir.branch(f, ir.label, 0, \"result\");\n    ir.put(f, ir.result, 0, 7, 0, 0);\n    ir.branch(f, ir.label, 0, \"init_failed\");\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    kaku functions = thread_platform_program();\n    array.push(functions, f);\n    kaku spawn = ir.function(\"platform_process_spawn\");\n    ir.call(spawn, 110, 6, [0, 1, 2, 3, 4, 5]);\n    ir.put(spawn, ir.result, 0, 6, 0, 0);\n    array.push(functions, spawn);\n    kaesu functions;\n}\n" }; }
waza data_125() -> File { kaesu File { path: "kiso/runtime/os/linux/link.mio", version: "Bunko-v2.1.1", length: 3568, sha256: "612a454d2096f146f50654279563a7f9c70d5f6b0fadbf0155fe2227de283212", source: "yobu \"kiso/aot/x86_64\";\nyobu \"kiso/aot/elf\";\nyobu \"kiso/runtime/ir\";\nyobu \"kiso/runtime/cpu/amd64\";\nyobu \"kiso/string\";\nyobu \"kiso/convert\";\n// Static Linux image builder. Layout of the code segment:\n//   _start (fills the import table with stub addresses, calls `entry`, exit_group)\n//   one syscall stub per slot, then the lowered runtime-IR functions.\n// The import table lives at the start of the fixed RW segment (elf.data_base).\n// No loader, no external linker, no libc.\nkoukai kata LinkedImage {\n    bytes: []uint8;\n    error: string;\n}\n\nkoukai waza executable(functions: []ir.Function, bindings: []ir.Binding, entry: string, extra_data: int64) -> LinkedImage {\n    kaku numbers = syscall_numbers();\n    moshi (extra_data < 0 || extra_data > 134217728) { kaesu LinkedImage { bytes: [], error: \"INVALID_RUNTIME_DATA\" }; }\n    kaku found = iie;\n    kaku fi = 0;\n    aida (fi < len(functions)) {\n        moshi (functions[fi].name == entry) {\n            found = hai;\n        }\n        fi = fi + 1;\n    }\n    moshi (!found) { kaesu LinkedImage { bytes: [], error: \"UNDEFINED_RUNTIME_ENTRY\" }; }\n    kaku c = x86_64.assembler();\n    // _start\n    kaku slot = 0;\n    x86_64.mov_ri(c, x86_64.rcx, elf.data_base);\n    aida (slot < len(numbers)) {\n        x86_64.lea_label(c, x86_64.rax, string_stub(slot));\n        x86_64.mov_store(c, x86_64.rcx, slot * 8, x86_64.rax);\n        slot = slot + 1;\n    }\n    x86_64.mov_rr(c, x86_64.r11, x86_64.rcx);\n    x86_64.call(c, string_function(\"rt\", entry));\n    x86_64.mov_rr(c, x86_64.rdi, x86_64.rax);\n    x86_64.mov_eax_imm(c, 231);\n    x86_64.syscall(c);\n    slot = 0;\n    aida (slot < len(numbers)) {\n        x86_64.label(c, string_stub(slot));\n        x86_64.mov_eax_imm(c, numbers[slot]);\n        x86_64.mov_rr(c, x86_64.r10, x86_64.rcx);\n        x86_64.syscall(c);\n        moshi (slot == slot_clone) {\n            // clone: the parent returns the child id (or -errno). The child starts here with rax = 0 on the stack the caller built\n            // ([entry][argument] at its top): install the import table, call entry(argument), then end only this thread (exit, 60).\n            x86_64.test_rr(c, x86_64.rax, x86_64.rax);\n            x86_64.jcc(c, x86_64.cc_ne, string_clone_parent());\n            x86_64.xor_rr(c, x86_64.rbp, x86_64.rbp);\n            x86_64.mov_ri(c, x86_64.r11, elf.data_base);\n            x86_64.pop_r(c, x86_64.rax);\n            x86_64.pop_r(c, x86_64.rdi);\n            x86_64.call_r(c, x86_64.rax);\n            x86_64.mov_rr(c, x86_64.rdi, x86_64.rax);\n            x86_64.mov_eax_imm(c, 60);\n            x86_64.syscall(c);\n            x86_64.label(c, string_clone_parent());\n        }\n        x86_64.ret(c);\n        slot = slot + 1;\n    }\n    kaku failure = amd64.emit_program(c, functions, bindings, len(numbers), \"rt\");\n    moshi (failure != \"\") { kaesu LinkedImage { bytes: [], error: failure }; }\n    kaku assembled = x86_64.assemble(c);\n    moshi (assembled.error != \"\") { kaesu LinkedImage { bytes: [], error: assembled.error }; }\n    kaku image = elf.executable(elf.ImageSpec { code: assembled.bytes, entry_offset: 0, bss_size: len(numbers) * 8 + extra_data });\n    moshi (image.error != \"\") { kaesu LinkedImage { bytes: [], error: image.error }; }\n    kaesu LinkedImage { bytes: image.bytes, error: \"\" };\n}\n\nwaza string_clone_parent() -> string { kaesu \"clone_parent\"; }\nwaza string_stub(slot: int64) -> string { kaesu string.concat(\"stub_\", convert.format_int(slot)); }\nwaza string_function(prefix: string, name: string) -> string { kaesu string.concat(prefix, string.concat(\"_\", name)); }\n" }; }
waza data_126() -> File { kaesu File { path: "kiso/runtime/os/linux/operations.mio", version: "Bunko-v2.1.1", length: 15205, sha256: "c543624948ef80ec6d6743a2a6b77b4259b1f069d1a0ffefd938ba628b3555e0", source: "yobu \"kiso/runtime/ir\";\nyobu \"kiso/runtime/target\";\n// Linux x86-64 (System V) OS adapter. There is no dynamic loader and no libc:\n// every OS service is a raw system call reached through a tiny in-image stub\n// (`mov eax,N; mov r10,rcx; syscall; ret`). Stub addresses fill the import table\n// that cpu/amd64 calls through (the same Binding/slot mechanism as os/darwin), so\n// the portable runtime-IR functions are lowered identically for the two targets.\n// Raw system calls return -errno; this adapter confines Linux errno values.\n//\n// What is NOT the same as os/darwin. Darwin's platform_wait(condition, mutex, timeout_ns),\n// platform_wake_all(condition) and platform_trylock(mutex) are pthread-condition/mutex\n// operations: the caller holds the mutex, which is released atomically while waiting. Linux has\n// no such layer yet (it would be built on futex words and is not implemented), so these three\n// functions are deliberately NOT defined here: portable code that calls them fails validation\n// (UNDEFINED_RUNTIME_FUNCTION / NOT_SUPPORTED_RUNTIME_OPERATION) instead of silently passing a\n// mutex pointer where a futex value is expected. Only the raw futex wait/wake below exist, under\n// their own names (platform_futex_*), and `capabilities().park_wake` is therefore false.\n//\n// Slot -> system call number. Slot order is part of the image contract.\nkoukai teisu slot_write = 0;\nkoukai teisu slot_exit = 1;\nkoukai teisu slot_mmap = 2;\nkoukai teisu slot_munmap = 3;\nkoukai teisu slot_mprotect = 4;\nkoukai teisu slot_madvise = 5;\nkoukai teisu slot_clock_gettime = 6;\nkoukai teisu slot_futex = 7;\nkoukai teisu slot_clone = 8;\nkoukai teisu slot_arch_prctl = 9;\nkoukai teisu slot_gettid = 10;\nkoukai teisu slot_count = 11;\n// Slot 8 (clone, number 56) is not a plain stub: the child resumes on the new stack and runs its entry function (link.mio).\nkoukai waza syscall_numbers() -> []int64 { kaesu [1, 231, 9, 11, 10, 28, 228, 202, 56, 158, 186]; }\nkoukai teisu clone_thread_flags = 4001536;   // VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|SETTLS|PARENT_SETTID|CHILD_CLEARTID (0x3D0F00)\nkoukai teisu arch_set_fs = 4098;             // ARCH_SET_FS 0x1002\nkoukai teisu arch_get_fs = 4099;             // ARCH_GET_FS 0x1003\nkoukai teisu thread_guard_bytes = 4096;\n\nkoukai teisu clock_monotonic = 1;\nkoukai teisu futex_wait_private = 128;\nkoukai teisu futex_wake_private = 129;\nkoukai teisu page_bytes = 4096;\n\n// Operation numbers. 31 (abort), 101 (clock_gettime(CLOCK_MONOTONIC) into a timespec, 0 on success),\n// 102 (exit) and 103 (write(1, buffer, length)) mean the same as in os/darwin. Darwin's 12, 100, 104\n// and 105 are pthread condition/mutex calls with no Linux equivalent here, so they are not bound.\n// 200..203 are Linux-private virtual-memory calls whose six arguments all come from virtual registers\n// (a literal fd = -1 is not encodable in a Binding); 204/205 are the Linux-private futex wait/wake.\nkoukai waza bindings() -> []ir.Binding {\n    kaesu [\n        ir.Binding { operation: 31, slot: 1, arguments: [0], result_bits: 64 },\n        ir.Binding { operation: 101, slot: 6, arguments: [-2, 0], result_bits: 64 },\n        ir.Binding { operation: 102, slot: 1, arguments: [0], result_bits: 64 },\n        ir.Binding { operation: 103, slot: 0, arguments: [-2, 0, 1], result_bits: 64 },\n        ir.Binding { operation: 200, slot: 2, arguments: [0, 1, 2, 3, 4, 5], result_bits: 64 },\n        ir.Binding { operation: 201, slot: 3, arguments: [0, 1], result_bits: 64 },\n        ir.Binding { operation: 202, slot: 4, arguments: [0, 1, 2], result_bits: 64 },\n        ir.Binding { operation: 203, slot: 5, arguments: [0, 1, 2], result_bits: 64 },\n        ir.Binding { operation: 204, slot: 7, arguments: [0, -129, 1, 2], result_bits: 64 },\n        ir.Binding { operation: 205, slot: 7, arguments: [0, -130, 1], result_bits: 64 },\n        // 206 clone(flags, child_stack, parent_tid*, child_tid*, tls); 207 arch_prctl(code, address); 208 gettid()\n        ir.Binding { operation: 206, slot: 8, arguments: [0, 1, 2, 3, 4], result_bits: 64 },\n        ir.Binding { operation: 207, slot: 9, arguments: [0, 1], result_bits: 64 },\n        ir.Binding { operation: 208, slot: 10, arguments: [], result_bits: 64 }\n    ];\n}\n\n// What this adapter really provides. OS thread primitives now exist (raw clone with a guarded stack, futex join on the\n// kernel-cleared tid word, FS-base TLS: platform_thread_*, platform_tls_*; witnessed natively by check_threads.py), but a thread\n// started this way is NOT known to the collector: there is no root registry, no safepoint handshake and no multi-mutator heap\n// on this target, so managed code must not run on it. The capability descriptor therefore still claims no threads, no tls, no\n// precise roots and no park_wake (that capability means the portable condition/mutex protocol, of which only raw futex wait/wake\n// exist). The target keeps failing closed for the concurrent collector and for mutex/condition/park/wake operations; the flags\n// change only in the PR that integrates the threads with the collector and passes its safety witnesses (docs/concurrency.md).\nkoukai waza capabilities() -> target.TargetInfo {\n    kaesu target.TargetInfo { os: \"linux\", arch: \"amd64\", abi: \"sysv\", pointer_bits: 64, little_endian: hai,\n        page_size_query: hai, atomic64: hai, threads: iie, tls: iie, park_wake: iie,\n        monotonic_clock: hai, virtual_memory: hai, precise_roots: iie, stack_alignment: 16,\n        concurrent_collector: iie, executable: hai };\n}\n\n// platform_now() -> monotonic nanoseconds, 0 on failure: the same contract as os/darwin.\n//\n// platform_futex_wait(address, expected, timeout_ns) -> 0, 1 or a negative errno:\n//   0  woken, or the word no longer matched (EAGAIN) or the call was interrupted (EINTR): the portable\n//      contract allows spurious wake-ups, so callers must re-check their predicate;\n//   1  the relative timeout elapsed (ETIMEDOUT); a timeout of 0 returns 1 at once when the word still\n//      matches (it never waits forever);\n//   <0 any other failure, as -errno.\n//   Linux compares a 32-bit word: only the low 32 bits (little endian) of the 64-bit word at `address`\n//   are compared with the low 32 bits of `expected`; callers must keep the state they wait on in those\n//   bits. `address` is a process-private futex word (FUTEX_WAIT_PRIVATE), 4-byte aligned.\n// platform_futex_wake(address, count) -> number of waiters woken, or -errno.\n// platform_futex_wake_all(address) -> platform_futex_wake(address, INT_MAX).\n// platform_reserve(length) -> the mapping address, or -errno; every other memory function returns 0 or\n//   -errno. An error is a value in [2^64 - 4095, 2^64 - 1] viewed unsigned, which is never a user address.\nkoukai waza platform_program() -> []ir.Function {\n    kaku wait = ir.function(\"platform_futex_wait\");\n    // (address, expected, timeout_ns): build the relative timespec {sec, nsec} in scratch.\n    ir.put(wait, ir.scratch_address, 3, 0, 0, 0);\n    ir.put(wait, ir.constant, 4, 0, 0, 1000000000);\n    ir.put(wait, ir.divide_unsigned, 5, 2, 4, 0);\n    ir.put(wait, ir.multiply, 6, 5, 4, 0);\n    ir.put(wait, ir.subtract, 6, 2, 6, 0);\n    ir.put(wait, ir.store, 0, 3, 5, 0);\n    ir.put(wait, ir.store, 0, 3, 6, 8);\n    ir.call(wait, 204, 4, [0, 1, 3]);\n    ir.branch(wait, ir.zero, 4, \"return\");\n    // ETIMEDOUT=110 -> timeout(1). EAGAIN=11 (value changed) and EINTR=4 are\n    // legitimate wakeups from the portable point of view -> 0. Other errors are negative errno.\n    ir.put(wait, ir.constant, 5, 0, 0, -110);\n    ir.put(wait, ir.equal, 5, 4, 5, 0);\n    ir.branch(wait, ir.zero, 5, \"again\");\n    ir.put(wait, ir.constant, 4, 0, 0, 1);\n    ir.branch(wait, ir.jump, 0, \"return\");\n    ir.branch(wait, ir.label, 0, \"again\");\n    ir.put(wait, ir.constant, 5, 0, 0, -11);\n    ir.put(wait, ir.equal, 5, 4, 5, 0);\n    ir.branch(wait, ir.nonzero, 5, \"woken\");\n    ir.put(wait, ir.constant, 5, 0, 0, -4);\n    ir.put(wait, ir.equal, 5, 4, 5, 0);\n    ir.branch(wait, ir.zero, 5, \"return\");\n    ir.branch(wait, ir.label, 0, \"woken\");\n    ir.put(wait, ir.constant, 4, 0, 0, 0);\n    ir.branch(wait, ir.label, 0, \"return\");\n    ir.put(wait, ir.result, 0, 4, 0, 0);\n\n    kaku clock = ir.function(\"platform_now\");\n    ir.put(clock, ir.scratch_address, 1, 0, 0, 0);\n    ir.call(clock, 101, 2, [1]);\n    ir.branch(clock, ir.nonzero, 2, \"error\");\n    ir.put(clock, ir.load, 2, 1, 0, 0);\n    ir.put(clock, ir.load, 3, 1, 0, 8);\n    ir.put(clock, ir.constant, 4, 0, 0, 1000000000);\n    ir.put(clock, ir.multiply, 2, 2, 4, 0);\n    ir.put(clock, ir.add, 2, 2, 3, 0);\n    ir.put(clock, ir.result, 0, 2, 0, 0);\n    ir.branch(clock, ir.label, 0, \"error\");\n    ir.put(clock, ir.constant, 2, 0, 0, 0);\n    ir.put(clock, ir.result, 0, 2, 0, 0);\n\n    kaku wake = ir.function(\"platform_futex_wake\");\n    ir.call(wake, 205, 2, [0, 1]);\n    ir.put(wake, ir.result, 0, 2, 0, 0);\n    kaku wake_all = ir.function(\"platform_futex_wake_all\");\n    ir.put(wake_all, ir.constant, 1, 0, 0, 2147483647);\n    ir.call(wake_all, 205, 2, [0, 1]);\n    ir.put(wake_all, ir.result, 0, 2, 0, 0);\n\n    // Virtual memory. reserve: PROT_NONE private anonymous NORESERVE mapping.\n    kaku reserve = ir.function(\"platform_reserve\");\n    // virtual registers: 0=length (argument) 1=addr(NULL) 2=PROT_NONE 3=flags 4=fd(-1) 5=offset\n    ir.put(reserve, ir.constant, 1, 0, 0, 0);\n    ir.put(reserve, ir.constant, 2, 0, 0, 0);\n    ir.put(reserve, ir.constant, 3, 0, 0, 16418);\n    ir.put(reserve, ir.constant, 4, 0, 0, -1);\n    ir.put(reserve, ir.constant, 5, 0, 0, 0);\n    ir.call(reserve, 200, 7, [1, 0, 2, 3, 4, 5]);\n    ir.put(reserve, ir.result, 0, 7, 0, 0);\n    // commit(addr,len): PROT_READ|PROT_WRITE (3)\n    kaku commit = ir.function(\"platform_commit\");\n    ir.put(commit, ir.constant, 2, 0, 0, 3);\n    ir.call(commit, 202, 3, [0, 1, 2]);\n    ir.put(commit, ir.result, 0, 3, 0, 0);\n    // decommit(addr,len): MADV_DONTNEED (4) drops pages; then PROT_NONE (0)\n    kaku decommit = ir.function(\"platform_decommit\");\n    ir.put(decommit, ir.constant, 2, 0, 0, 4);\n    ir.call(decommit, 203, 3, [0, 1, 2]);\n    ir.branch(decommit, ir.nonzero, 3, \"done\");\n    ir.put(decommit, ir.constant, 2, 0, 0, 0);\n    ir.call(decommit, 202, 3, [0, 1, 2]);\n    ir.branch(decommit, ir.label, 0, \"done\");\n    ir.put(decommit, ir.result, 0, 3, 0, 0);\n    kaku release = ir.function(\"platform_release\");\n    ir.call(release, 201, 2, [0, 1]);\n    ir.put(release, ir.result, 0, 2, 0, 0);\n    kaku protect = ir.function(\"platform_protect\");\n    ir.call(protect, 202, 3, [0, 1, 2]);\n    ir.put(protect, ir.result, 0, 3, 0, 0);\n\n    // ---- Native threads (raw clone, no libc). These are OS primitives only: the thread is NOT registered with the\n    // collector and must not run managed code (capabilities() keeps threads/tls false until that is integrated).\n    // platform_thread_stack(size) -> usable stack start or -errno: a PROT_NONE guard page followed by `size` RW bytes.\n    kaku thread_stack = ir.function(\"platform_thread_stack\");\n    ir.put(thread_stack, ir.constant, 1, 0, 0, thread_guard_bytes);\n    ir.put(thread_stack, ir.add, 2, 0, 1, 0);\n    ir.invoke_function(thread_stack, \"platform_reserve\", 3, [2]);\n    ir.put(thread_stack, ir.constant, 4, 0, 0, -4095);\n    ir.put(thread_stack, ir.less_unsigned, 5, 3, 4, 0);\n    ir.branch(thread_stack, ir.zero, 5, \"done\");\n    ir.put(thread_stack, ir.add, 6, 3, 1, 0);\n    ir.invoke_function(thread_stack, \"platform_commit\", 7, [6, 0]);\n    ir.branch(thread_stack, ir.zero, 7, \"ready\");\n    ir.invoke_function(thread_stack, \"platform_release\", 8, [3, 2]);\n    ir.put(thread_stack, ir.copy, 3, 7, 0, 0);\n    ir.branch(thread_stack, ir.jump, 0, \"done\");\n    ir.branch(thread_stack, ir.label, 0, \"ready\");\n    ir.put(thread_stack, ir.copy, 3, 6, 0, 0);\n    ir.branch(thread_stack, ir.label, 0, \"done\");\n    ir.put(thread_stack, ir.result, 0, 3, 0, 0);\n    // platform_thread_stack_release(usable_start, size) -> 0 or -errno\n    kaku thread_stack_release = ir.function(\"platform_thread_stack_release\");\n    ir.put(thread_stack_release, ir.constant, 2, 0, 0, thread_guard_bytes);\n    ir.put(thread_stack_release, ir.subtract, 3, 0, 2, 0);\n    ir.put(thread_stack_release, ir.add, 4, 1, 2, 0);\n    ir.invoke_function(thread_stack_release, \"platform_release\", 5, [3, 4]);\n    ir.put(thread_stack_release, ir.result, 0, 5, 0, 0);\n    // platform_thread_create(entry, argument, stack_start, stack_size, tid_word*, tls) -> thread id or -errno.\n    // The child runs entry(argument) on the given stack with the import table installed, then exits the thread. The kernel stores\n    // the id in *tid_word before either side runs and clears it (waking futex waiters) when the thread ends: that is the join word.\n    kaku thread_create = ir.function(\"platform_thread_create\");\n    ir.put(thread_create, ir.add, 6, 2, 3, 0);\n    ir.put(thread_create, ir.constant, 7, 0, 0, 16);\n    ir.put(thread_create, ir.divide_unsigned, 6, 6, 7, 0);\n    ir.put(thread_create, ir.multiply, 6, 6, 7, 0);\n    ir.put(thread_create, ir.subtract, 6, 6, 7, 0);\n    ir.put(thread_create, ir.store, 0, 6, 0, 0);\n    ir.put(thread_create, ir.store, 0, 6, 1, 8);\n    ir.put(thread_create, ir.constant, 8, 0, 0, clone_thread_flags);\n    ir.call(thread_create, 206, 9, [8, 6, 4, 4, 5]);\n    ir.put(thread_create, ir.result, 0, 9, 0, 0);\n    // platform_thread_join(tid_word*) -> 0 once the thread has ended, or -errno. Waits on the kernel-cleared id word.\n    kaku thread_join = ir.function(\"platform_thread_join\");\n    ir.put(thread_join, ir.constant, 3, 0, 0, 1000000000);\n    ir.branch(thread_join, ir.label, 0, \"again\");\n    ir.put(thread_join, ir.acquire_load, 1, 0, 0, 0);\n    ir.branch(thread_join, ir.zero, 1, \"done\");\n    ir.invoke_function(thread_join, \"platform_futex_wait\", 2, [0, 1, 3]);\n    ir.put(thread_join, ir.constant, 4, 0, 0, -4095);\n    ir.put(thread_join, ir.less_unsigned, 5, 2, 4, 0);\n    ir.branch(thread_join, ir.nonzero, 5, \"again\");\n    ir.put(thread_join, ir.result, 0, 2, 0, 0);\n    ir.branch(thread_join, ir.label, 0, \"done\");\n    ir.put(thread_join, ir.constant, 1, 0, 0, 0);\n    ir.put(thread_join, ir.result, 0, 1, 0, 0);\n    kaku thread_id = ir.function(\"platform_thread_id\");\n    ir.call(thread_id, 208, 0, []);\n    ir.put(thread_id, ir.result, 0, 0, 0, 0);\n    // TLS: the FS base. platform_tls_set(address) -> 0/-errno; platform_tls_get() -> address (0 on failure).\n    kaku tls_set = ir.function(\"platform_tls_set\");\n    ir.put(tls_set, ir.constant, 1, 0, 0, arch_set_fs);\n    ir.call(tls_set, 207, 2, [1, 0]);\n    ir.put(tls_set, ir.result, 0, 2, 0, 0);\n    kaku tls_get = ir.function(\"platform_tls_get\");\n    ir.put(tls_get, ir.scratch_address, 1, 0, 0, 0);\n    ir.put(tls_get, ir.constant, 2, 0, 0, arch_get_fs);\n    ir.call(tls_get, 207, 3, [2, 1]);\n    ir.branch(tls_get, ir.nonzero, 3, \"failed\");\n    ir.put(tls_get, ir.load, 4, 1, 0, 0);\n    ir.put(tls_get, ir.result, 0, 4, 0, 0);\n    ir.branch(tls_get, ir.label, 0, \"failed\");\n    ir.put(tls_get, ir.constant, 4, 0, 0, 0);\n    ir.put(tls_get, ir.result, 0, 4, 0, 0);\n    kaesu [wait, clock, wake, wake_all, reserve, commit, decommit, release, protect, thread_stack, thread_stack_release, thread_create, thread_join, thread_id, tls_set, tls_get];\n}\n" }; }
waza data_127() -> File { kaesu File { path: "kiso/runtime/target/target.mio", version: "Bunko-v2.1.1", length: 2580, sha256: "1096118caaac85a1fb94a8f2251eac44254f869eef1e6b590e7ac60af31a2ee8", source: "yobu \"kiso/runtime/gc\";\n\n// ABI descriptors describe capabilities, not optimistic platform names.\n// Unknown pressure and unavailable memory limits are valid optional inputs.\nkoukai kata TargetInfo {\n    os: string;\n    arch: string;\n    abi: string;\n    pointer_bits: int64;\n    little_endian: bool;\n    page_size_query: bool;\n    atomic64: bool;\n    threads: bool;\n    tls: bool;\n    park_wake: bool;\n    monotonic_clock: bool;\n    virtual_memory: bool;\n    precise_roots: bool;\n    stack_alignment: int64;\n    concurrent_collector: bool;\n    executable: bool;\n}\nkoukai waza descriptor(os: string, arch: string, abi: string) -> TargetInfo {\n    kaesu TargetInfo { os: os, arch: arch, abi: abi, pointer_bits: 64,\n        little_endian: hai, page_size_query: iie, atomic64: iie, threads: iie,\n        tls: iie, park_wake: iie, monotonic_clock: iie, virtual_memory: iie,\n        precise_roots: iie, stack_alignment: 16, concurrent_collector: iie, executable: iie };\n}\nkoukai waza concurrent_error(t: TargetInfo) -> string {\n    moshi (t.pointer_bits != 64 || t.stack_alignment < 16 || !t.page_size_query ||\n        !t.atomic64 || !t.threads || !t.tls || !t.park_wake || !t.monotonic_clock ||\n        !t.virtual_memory || !t.precise_roots || !t.concurrent_collector || !t.executable) {\n        kaesu \"NOT_SUPPORTED: concurrent collector target contract incomplete\";\n    }\n    kaesu \"\";\n}\nkoukai waza operation_error(t: TargetInfo, op: gc.RuntimeOp) -> string {\n    moshi (!gc.valid_operation(op)) { kaesu \"INVALID_RUNTIME_OP\"; }\n    moshi (op.kind <= gc.fence && !t.atomic64) { kaesu \"NOT_SUPPORTED: atomic64\"; }\n    moshi (op.kind >= gc.thread_start && op.kind <= gc.thread_identity && !t.threads) { kaesu \"NOT_SUPPORTED: threads\"; }\n    moshi ((op.kind == gc.tls_get || op.kind == gc.tls_set || op.kind == gc.tls_create || op.kind == gc.tls_destroy) && !t.tls) {\n        kaesu \"NOT_SUPPORTED: TLS\";\n    }\n    moshi ((op.kind == gc.park || op.kind == gc.wake) && !t.park_wake) { kaesu \"NOT_SUPPORTED: park/wake\"; }\n    moshi (((op.kind >= gc.reserve && op.kind <= gc.memory_release) || op.kind == gc.protect) && !t.virtual_memory) {\n        kaesu \"NOT_SUPPORTED: virtual memory\";\n    }\n    moshi (op.kind >= gc.mutex_create && op.kind <= gc.condition_destroy && !t.park_wake) {\n        kaesu \"NOT_SUPPORTED: synchronization lifecycle\";\n    }\n    moshi (op.kind == gc.clock && !t.monotonic_clock) { kaesu \"NOT_SUPPORTED: monotonic clock\"; }\n    moshi (op.kind >= gc.roots && op.kind <= gc.write_barrier && !t.precise_roots) { kaesu \"NOT_SUPPORTED: roots/barrier\"; }\n    kaesu \"\";\n}\n" }; }
waza data_128() -> File { kaesu File { path: "kiso/string/string.mio", version: "Bunko-v2.1.1", length: 4267, sha256: "97f830c72c18519bee44dbb94cdec84c27859a82c66eabdffd80040951925560", source: "yobu \"kiso/array\";\nyobu \"kiso/bytes\";\nyobu \"kiso/utf8\";\n\nkoukai kata StringBuilder { buffer: bytes.ByteBuffer; }\n\nkoukai waza to_bytes(value: string) -> []uint8 {\n    kaesu __string_to_bytes(value);\n}\n\nkoukai waza from_utf8(data: []uint8) -> string? {\n    moshi (!utf8.valid(data)) { kaesu mu; }\n    kaesu __string_from_utf8(data);\n}\n\nkoukai waza byte_len(value: string) -> int64 {\n    kaesu __string_byte_len(value);\n}\n\nkoukai waza rune_count(value: string) -> int64 {\n    kaku count = utf8.rune_count(to_bytes(value));\n    moshi (count != mu) { kaesu count; }\n    __math_error(\"kiso/string.rune_count: string contains invalid UTF-8\");\n    kaesu 0;\n}\n\nkoukai waza has_prefix(value: string, prefix: string) -> bool {\n    kaesu bytes.has_prefix(to_bytes(value), to_bytes(prefix));\n}\n\nkoukai waza has_suffix(value: string, suffix: string) -> bool {\n    kaesu bytes.has_suffix(to_bytes(value), to_bytes(suffix));\n}\n\nkoukai waza index(value: string, pattern: string) -> int64 {\n    kaku data = to_bytes(value);\n    kaku target = to_bytes(pattern);\n    moshi (len(target) == 0) { kaesu 0; }\n    moshi (len(target) > len(data)) { kaesu -1; }\n    kaku offset = 0;\n    kaku limit = len(data) - len(target);\n    aida (offset <= limit) {\n        kaku matched = hai;\n        kaku current = 0;\n        aida (current < len(target)) {\n            moshi (data[offset + current] != target[current]) {\n                matched = iie;\n                nukeru;\n            }\n            current = current + 1;\n        }\n        moshi (matched) { kaesu offset; }\n        offset = offset + 1;\n    }\n    kaesu -1;\n}\n\nkoukai waza contains(value: string, pattern: string) -> bool {\n    kaesu index(value, pattern) >= 0;\n}\n\nkoukai waza concat(left: string, right: string) -> string {\n    kaku builder = builder_with_capacity(byte_len(left) + byte_len(right));\n    write_string(builder, left);\n    write_string(builder, right);\n    kaesu builder_string(builder);\n}\n\nkoukai waza new_builder() -> StringBuilder {\n    kaesu StringBuilder { buffer: bytes.new_buffer() };\n}\n\nkoukai waza builder_with_capacity(capacity: int64) -> StringBuilder {\n    kaesu StringBuilder { buffer: bytes.buffer_with_capacity(capacity) };\n}\n\nkoukai waza write_string(builder: StringBuilder, value: string) -> unit {\n    bytes.write(builder.buffer, to_bytes(value));\n}\n\nkoukai waza write_rune(builder: StringBuilder, value: rune) -> unit {\n    utf8.append_rune(builder.buffer.data, value);\n}\n\nkoukai waza builder_len(builder: StringBuilder) -> int64 {\n    kaesu bytes.buffer_len(builder.buffer);\n}\n\nkoukai waza builder_capacity(builder: StringBuilder) -> int64 {\n    kaesu bytes.buffer_capacity(builder.buffer);\n}\n\nkoukai waza builder_reset(builder: StringBuilder) -> unit {\n    bytes.reset(builder.buffer);\n}\n\nkoukai waza builder_string(builder: StringBuilder) -> string {\n    kaku result = from_utf8(builder.buffer.data);\n    moshi (result != mu) { kaesu result; }\n    __math_error(\"kiso/string.builder_string: builder contains invalid UTF-8\");\n    kaesu \"\";\n}\n\nwaza whitespace_rune(value: rune) -> bool {\n    kaku code = int64(value);\n    kaesu (code >= 9 && code <= 13) || code == 32 || code == 133 || code == 160 || code == 5760 || (code >= 8192 && code <= 8202) || code == 8232 || code == 8233 || code == 8239 || code == 8287 || code == 12288;\n}\nkoukai waza trim_space(value: string) -> string {\n    kaku data = to_bytes(value);\n    kaku low = 0;\n    kaku high = len(data);\n    aida (low<high) {\n        kaku decoded = utf8.decode_one(data, low);\n        moshi (!decoded.valid || !whitespace_rune(decoded.value)) {\n            nukeru;\n        }\n        low = low + decoded.width;\n    }\n    aida (high>low) {\n        kaku start = high - 1;\n        aida (start>low && data[start] >= uint8(128) && data[start]<uint8(192)) {\n            start = start - 1;\n        }\n        kaku decoded = utf8.decode_one(data, start);\n        moshi (!decoded.valid || start + decoded.width != high || !whitespace_rune(decoded.value)) {\n            nukeru;\n        }\n        high = start;\n    }\n    kaku output: []uint8 = [];\n    kaku at = low;\n    aida (at<high) {\n        array.push(output, data[at]);\n        at = at + 1;\n    }\n    kaku text = from_utf8(output);\n    moshi (text == mu) {\n        kaesu value;\n    }\n    kaesu text;\n}\n" }; }
waza data_129() -> File { kaesu File { path: "kiso/testing/testing.mio", version: "Bunko-v2.1.1", length: 562, sha256: "3bdbe2c2b556ad19b6d658d07319f77493ecda8eb73b454f81383faebea68d2f", source: "yobu \"mio/testing/runtime\";\n\nkoukai waza expect(condition: bool, message: string) -> unit {\n    runtime.report(condition, message);\n}\n\n// A skipped test is neither a pass nor a failure: the runner reports it as SKIP with the reason and counts it\n// separately. A skip is two records: the fixed marker, then the reason. Call it before any other expectation.\nkoukai waza skip(reason: string) -> unit {\n    runtime.report(iie, \"@@mio-test-skip@@\");\n    runtime.report(iie, reason);\n}\n\nkoukai waza fail(message: string) -> unit {\n    runtime.report(iie, message);\n}\n" }; }
waza data_130() -> File { kaesu File { path: "kiso/thread/thread.mio", version: "Bunko-v2.1.1", length: 12185, sha256: "99d657bebe26b9a323e9a44e69f7b832688e352465dfbd8e59d7af905fa1c13f", source: "yobu \"mio/thread/runtime\";\nyobu \"kiso/array\";\n\n// 原生操作系统线程与零拷贝通道（Channel）。\n// 目前相关名称仍为临时接口（见 docs/concurrency.md 中的决策 D-2）。\n//\n// 通道在线程间直接转移对象图的所有权：发送方将引用写入环形缓冲区槽位，接收方取出该引用，\n// 全程不发生深拷贝。配合发送点处的 `yuzuru` 运算符，编译器静态保证发送方无法再访问已移交的对象图，\n// 从而由接收方成为唯一拥有者。若发送因通道已关闭而失败，原对象图会通过 SendResult.back 归还给发送方，\n// 确保任何尝试转移的路径都不会丢失所有权。\n\n// 启动一个新线程执行 entry。成功时返回正整数句柄；若创建或注册失败则返回负 errno：\n// -11 表示存活（未 join）的线程数已达上限，-12 表示运行时内存不足，其余为底层系统错误码。\n// 失败时不会残留任何已注册上下文或映射内存。\nkoukai waza start(entry: () -> int64) -> int64 { kaesu runtime.start(entry); }\n\n// 等待目标线程结束并返回 entry 的返回值。\n// 无效句柄、正在被另一线程 join 的句柄或调用者自己的句柄均返回 -22。\n// 注意：若 entry 本身可能返回负数，无法仅凭返回值区分 -22 与正常业务返回值，此时请使用 join_checked。\nkoukai waza join(handle: int64) -> int64 { kaesu runtime.join(handle); }\n\n// ok == iie 表示句柄不是有效的存活线程句柄（此时 value 固定为 0）；否则 value 为 entry 的返回值。\nkoukai kata JoinResult {\n    ok: bool;\n    value: int64;\n}\n\nkoukai waza join_checked(handle: int64) -> JoinResult {\n    kaku value = runtime.join(handle);\n    moshi (runtime.join_status() != 0) { kaesu JoinResult { ok: iie, value: 0 }; }\n    kaesu JoinResult { ok: hai, value: value };\n}\n\n// 有界多生产者多消费者（MPMC）通道。\n// - words：离堆（off-heap）控制块句柄，包含 8 个 64 位原子控制字（GC 不扫描该区域）。\n// - ring：普通 Mio 数组，存放载荷引用，使在途对象图成为 GC 可追踪的常规堆引用。\n// - filler：T 类型的占位值，用于在取出元素或销毁通道时清空槽位，避免已消费对象被环形数组滞留导致无法回收。\nkoukai kata Channel<T> {\n    words: int64;\n    ring: []T;\n    filler: T;\n    capacity: int64;\n}\n\n// sent == hai 表示写入成功；通道已关闭或不可用时，back 为原封不动退回的传入对象。\nkoukai kata SendResult<T> {\n    sent: bool;\n    back: T;\n}\n\n// closed == hai 表示通道已关闭且队列已排空，或通道不可用（此时 item 为 filler）。\nkoukai kata Received<T> {\n    item: T;\n    closed: bool;\n}\n\n// 离堆控制块（8 个 64 位字）的字下标布局：\nteisu word_lock = 0;      // 互斥锁状态：0 空闲，1 已加锁（无等待者），2 已加锁（可能有等待者）\nteisu word_head = 1;      // 环形缓冲区读指针（下一个待接收槽位）\nteisu word_tail = 2;      // 环形缓冲区写指针（下一个待发送槽位）\nteisu word_count = 3;     // 当前队列中的元素数量\nteisu word_closed = 4;    // 关闭标志：0 开放，非 0 已关闭\nteisu word_recv_seq = 5;  // 接收端唤醒序列号（每次入队或关闭时递增）\nteisu word_send_seq = 6;  // 发送端唤醒序列号（每次出队或关闭时递增）\nteisu word_waiters = 7;   // 睡眠等待者计数：低 32 位为接收者，高 32 位为发送者\n\n// 等待者计数打包常量：低 32 位步长为 1，高 32 位步长为 2^32。\nteisu receiver_unit = 1;\nteisu sender_unit = 4294967296;\n\n// 唤醒全部等待者时使用的唤醒上限（覆盖所有可能并发阻塞的线程数）。\nteisu wake_all_count = 1000000;\n\n// 保留原有构造接口。分配失败时创建不可用的通道，close/destroy 返回分配错误。\n// 需要在构造时处理错误的调用者应使用 channel_new_checked。\nkoukai waza channel_new<T>(capacity: int64, filler: T) -> Channel<T> {\n    kaku words = runtime.words_new(8);\n    moshi (words <= 0) {\n        kaesu Channel[T] { words: words, ring: [], filler: filler, capacity: 0 };\n    }\n    kaku slots = capacity;\n    moshi (slots < 1) { slots = 1; }\n    kaesu Channel[T] { words: words, ring: array.make[T](slots, filler), filler: filler, capacity: slots };\n}\n\nkoukai kata ChannelResult<T> {\n    channel: Channel<T>?;\n    error: int64;\n}\n\n// 成功时 error 为 0，失败时 channel 为 mu，error 为负 errno（Darwin ARM64 控制块池耗尽时为 -12）。\nkoukai waza channel_new_checked<T>(capacity: int64, filler: T) -> ChannelResult<T> {\n    kaku channel = channel_new[T](capacity, filler);\n    moshi (channel.words < 0) { kaesu ChannelResult[T] { channel: mu, error: channel.words }; }\n    moshi (channel.words == 0) { kaesu ChannelResult[T] { channel: mu, error: -22 }; }\n    kaesu ChannelResult[T] { channel: channel, error: 0 };\n}\n\n// 基于三态互斥字的通道锁：0 空闲，1 已加锁，2 已加锁且存在等待者。\n// 竞争失败的线程通过 word_wait 进入内核休眠（该调用为 GC Safepoint），避免在锁上长时间自旋阻碍 STW 回收。\nwaza lock<T>(channel: Channel<T>) -> int64 {\n    moshi (channel.words < 0) { kaesu channel.words; }\n    moshi (channel.words == 0) { kaesu -22; }\n    kaku c = runtime.word_cas(channel.words, word_lock, 0, 1);\n    aida (c == 1 || c == 2) {\n        moshi (c != 2) { c = runtime.word_cas(channel.words, word_lock, 1, 2); }\n        moshi (c < 0) { kaesu c; }\n        moshi (c > 2) { kaesu -22; }\n        moshi (c != 0) {\n            kaku status = runtime.word_wait(channel.words, word_lock, 2);\n            moshi (status < 0) { kaesu status; }\n        }\n        c = runtime.word_cas(channel.words, word_lock, 0, 2);\n    }\n    moshi (c <= 0) { kaesu c; }\n    kaesu -22;\n}\n\nwaza unlock<T>(channel: Channel<T>) -> int64 {\n    kaku before = runtime.word_add(channel.words, word_lock, -1);\n    moshi (before != 1) {\n        runtime.word_set(channel.words, word_lock, 0);\n        runtime.word_wake(channel.words, word_lock, 1);\n    }\n    kaesu 0;\n}\n\n// 防止丢失唤醒（Lost Wakeup）的等待/唤醒协议：\n// 1. 准备休眠的线程在调用内核 word_wait 比较序列号之前，先通过原子加法（全屏障）在 word_waiters 中登记自身；\n// 2. 修改队列并递增序列号的线程在序列号更新（全屏障）之后，再读取 word_waiters。\n// 由此保证：要么休眠线程看到新序列号而直接返回不休眠，要么唤醒线程看到等待者计数并执行唤醒。\n// 当没有线程等待时，普通发送/接收可完全跳过唤醒系统调用。\nwaza sleep_on<T>(channel: Channel<T>, sequence: int64, seen: int64, unit: int64) -> int64 {\n    runtime.word_add(channel.words, word_waiters, unit);\n    kaku status = runtime.word_wait(channel.words, sequence, seen);\n    runtime.word_add(channel.words, word_waiters, 0 - unit);\n    kaesu status;\n}\n\n// 若存在正在休眠的接收者，则唤醒其中之一（被唤醒者在持锁后会重新检查队列，因此每次入队唤醒一个即可）。\nwaza wake_receiver<T>(channel: Channel<T>) -> int64 {\n    kaku counts = runtime.word_get(channel.words, word_waiters);\n    kaku receivers = counts - (counts / sender_unit) * sender_unit;\n    moshi (receivers != 0) { runtime.word_wake(channel.words, word_recv_seq, 1); }\n    kaesu 0;\n}\n\n// 若存在正在休眠的发送者，则唤醒其中之一。\nwaza wake_sender<T>(channel: Channel<T>) -> int64 {\n    kaku counts = runtime.word_get(channel.words, word_waiters);\n    moshi (counts / sender_unit != 0) { runtime.word_wake(channel.words, word_send_seq, 1); }\n    kaesu 0;\n}\n\n// 递增序列号并唤醒所有阻塞在接收/发送队列上的线程（用于 close 与 destroy）。\nwaza wake_all_waiters<T>(channel: Channel<T>) -> unit {\n    runtime.word_add(channel.words, word_recv_seq, 1);\n    runtime.word_add(channel.words, word_send_seq, 1);\n    runtime.word_wake(channel.words, word_recv_seq, wake_all_count);\n    runtime.word_wake(channel.words, word_send_seq, wake_all_count);\n}\n\nwaza next_slot(index: int64, capacity: int64) -> int64 { kaesu (index + 1) - ((index + 1) / capacity) * capacity; }\n\n// 向通道发送元素；若通道已满则阻塞等待。调用时应配合 yuzuru 移交所有权：`thread.send[Graph](channel, yuzuru graph)`。\nkoukai waza send<T>(channel: Channel<T>, value: T) -> SendResult<T> {\n    aida (hai) {\n        moshi (lock[T](channel) != 0) { nukeru; }\n        moshi (runtime.word_get(channel.words, word_closed) != 0) {\n            unlock[T](channel);\n            kaesu SendResult[T] {\n                sent: iie, back: value };\n        }\n        kaku count = runtime.word_get(channel.words, word_count);\n        moshi (count < channel.capacity) {\n            kaku tail = runtime.word_get(channel.words, word_tail);\n            channel.ring[tail] = value;\n            runtime.word_set(channel.words, word_tail, next_slot(tail, channel.capacity));\n            runtime.word_set(channel.words, word_count, count + 1);\n            runtime.word_add(channel.words, word_recv_seq, 1);\n            unlock[T](channel);\n            wake_receiver[T](channel);\n            kaesu SendResult[T] { sent: hai, back: channel.filler };\n        }\n        kaku seen = runtime.word_get(channel.words, word_send_seq);\n        unlock[T](channel);\n        moshi (sleep_on[T](channel, word_send_seq, seen, sender_unit) < 0) { nukeru; }\n    }\n    kaesu SendResult[T] { sent: iie, back: value };\n}\n\n// 从通道接收元素；若通道为空且尚未关闭则阻塞等待。\nkoukai waza receive<T>(channel: Channel<T>) -> Received<T> {\n    aida (hai) {\n        moshi (lock[T](channel) != 0) { nukeru; }\n        kaku count = runtime.word_get(channel.words, word_count);\n        moshi (count > 0) {\n            kaku head = runtime.word_get(channel.words, word_head);\n            kaku item = channel.ring[head];\n            channel.ring[head] = channel.filler;\n            runtime.word_set(channel.words, word_head, next_slot(head, channel.capacity));\n            runtime.word_set(channel.words, word_count, count - 1);\n            runtime.word_add(channel.words, word_send_seq, 1);\n            unlock[T](channel);\n            wake_sender[T](channel);\n            kaesu Received[T] { item: item, closed: iie };\n        }\n        moshi (runtime.word_get(channel.words, word_closed) != 0) {\n            unlock[T](channel);\n            kaesu Received[T] {\n                item: channel.filler, closed: hai };\n        }\n        kaku seen = runtime.word_get(channel.words, word_recv_seq);\n        unlock[T](channel);\n        moshi (sleep_on[T](channel, word_recv_seq, seen, receiver_unit) < 0) { nukeru; }\n    }\n    kaesu Received[T] { item: channel.filler, closed: hai };\n}\n\n// 关闭通道：拒绝后续发送（并将传入值退回给发送方），已入队的元素仍可由接收方继续排空，排空后返回 closed == hai。\nkoukai waza close<T>(channel: Channel<T>) -> int64 {\n    kaku status = lock[T](channel);\n    moshi (status != 0) { kaesu status; }\n    runtime.word_set(channel.words, word_closed, 1);\n    unlock[T](channel);\n    wake_all_waiters[T](channel);\n    kaesu 0;\n}\n\n// 彻底关闭通道并立即丢弃所有尚未消费的排队元素（若需保留排队元素请使用 close 并通过 receive 排空）。\n// 支持从任意线程多次调用；对已销毁通道执行 send/receive 的行为与已关闭通道完全一致。\n// 离堆控制块保留至进程退出。旧通道别名和在途操作仍可使用该块；Darwin ARM64 的分配上限因此按进程累计。\nkoukai waza destroy<T>(channel: Channel<T>) -> int64 {\n    kaku status = lock[T](channel);\n    moshi (status != 0) { kaesu status; }\n    runtime.word_set(channel.words, word_closed, 1);\n    runtime.word_set(channel.words, word_count, 0);\n    runtime.word_set(channel.words, word_head, 0);\n    runtime.word_set(channel.words, word_tail, 0);\n    kaku i = 0;\n    aida (i < channel.capacity) {\n        channel.ring[i] = channel.filler;\n        i = i + 1;\n    }\n    unlock[T](channel);\n    wake_all_waiters[T](channel);\n    kaesu 0;\n}\n" }; }
waza data_131() -> File { kaesu File { path: "kiso/utf8/utf8.mio", version: "Bunko-v2.1.1", length: 5540, sha256: "61c91357b2a5de3de4de54b5fa2f2e215d27d82fe5289aa90a76f400f8d67f06", source: "yobu \"kiso/array\";\nyobu \"kiso/bytes\";\n\nkoukai kata DecodeResult {\n    value: rune;\n    width: int64;\n    valid: bool;\n}\n\nwaza invalid_decode() -> DecodeResult {\n    kaesu DecodeResult { value: '\\uFFFD', width: 1, valid: iie };\n}\n\nwaza decode_packed(data: []uint8, offset: int64) -> int64 {\n    moshi (offset == len(data)) { kaesu -2; }\n    moshi (offset < 0 || offset > len(data)) {\n        data[offset];\n    }\n\n    kaku first = int64(data[offset]);\n    moshi (first <= 127) {\n        kaesu first + 1114112;\n    }\n    moshi (first >= 194 && first <= 223) {\n        moshi (offset + 2 > len(data)) { kaesu -1; }\n        kaku second = int64(data[offset + 1]);\n        moshi (second < 128 || second > 191) { kaesu -1; }\n        kaesu (first - 192) * 64 + second - 128 + 2228224;\n    }\n    moshi (first >= 224 && first <= 239) {\n        moshi (offset + 3 > len(data)) { kaesu -1; }\n        kaku second = int64(data[offset + 1]);\n        kaku third = int64(data[offset + 2]);\n        moshi (second < 128 || second > 191 || third < 128 || third > 191) {\n            kaesu -1;\n        }\n        moshi (first == 224 && second < 160) { kaesu -1; }\n        moshi (first == 237 && second > 159) { kaesu -1; }\n        kaesu (first - 224) * 4096 + (second - 128) * 64 + third - 128 + 3342336;\n    }\n    moshi (first >= 240 && first <= 244) {\n        moshi (offset + 4 > len(data)) { kaesu -1; }\n        kaku second = int64(data[offset + 1]);\n        kaku third = int64(data[offset + 2]);\n        kaku fourth = int64(data[offset + 3]);\n        moshi (second < 128 || second > 191 || third < 128 || third > 191 || fourth < 128 || fourth > 191) {\n            kaesu -1;\n        }\n        moshi (first == 240 && second < 144) { kaesu -1; }\n        moshi (first == 244 && second > 143) { kaesu -1; }\n        kaesu (first - 240) * 262144 + (second - 128) * 4096 + (third - 128) * 64 + fourth - 128 + 4456448;\n    }\n    kaesu -1;\n}\n\nwaza append_valid(destination: []uint8, code: int64) -> unit {\n    moshi (code <= 127) {\n        array.push(destination, uint8(code));\n        kaesu;\n    }\n    moshi (code <= 2047) {\n        array.push(destination, uint8(192 + code / 64));\n        array.push(destination, uint8(128 + code - (code / 64) * 64));\n        kaesu;\n    }\n    moshi (code <= 65535) {\n        array.push(destination, uint8(224 + code / 4096));\n        array.push(destination, uint8(128 + (code / 64) - (code / 4096) * 64));\n        array.push(destination, uint8(128 + code - (code / 64) * 64));\n        kaesu;\n    }\n    array.push(destination, uint8(240 + code / 262144));\n    array.push(destination, uint8(128 + (code / 4096) - (code / 262144) * 64));\n    array.push(destination, uint8(128 + (code / 64) - (code / 4096) * 64));\n    array.push(destination, uint8(128 + code - (code / 64) * 64));\n}\n\nkoukai waza is_valid_rune(value: rune) -> bool {\n    kaku code = int64(value);\n    kaesu code >= 0 && code <= 1114111 && (code < 55296 || code > 57343);\n}\n\nkoukai waza rune_width(value: rune) -> int64 {\n    moshi (!is_valid_rune(value)) {\n        __math_error(\"kiso/utf8.rune_width: invalid Unicode scalar value\");\n        kaesu 0;\n    }\n    kaku code = int64(value);\n    moshi (code <= 127) { kaesu 1; }\n    moshi (code <= 2047) { kaesu 2; }\n    moshi (code <= 65535) { kaesu 3; }\n    kaesu 4;\n}\n\nkoukai waza decode_one(data: []uint8, offset: int64) -> DecodeResult {\n    kaku packed = decode_packed(data, offset);\n    moshi (packed == -2) {\n        kaesu DecodeResult { value: '\\uFFFD', width: 0, valid: iie };\n    }\n    moshi (packed == -1) { kaesu invalid_decode(); }\n    kaku width = 1;\n    moshi (packed >= 2228224) {\n        width = 2;\n        moshi (packed >= 3342336) {\n            width = 3;\n            moshi (packed >= 4456448) { width = 4; }\n        }\n    }\n    kaesu DecodeResult { value: rune(packed - width * 1114112), width: width, valid: hai };\n}\n\nkoukai waza encode_rune(value: rune) -> []uint8 {\n    kaku width = rune_width(value);\n    kaku buffer = bytes.buffer_with_capacity(width);\n    append_valid(buffer.data, int64(value));\n    kaesu buffer.data;\n}\n\nkoukai waza append_rune(destination: []uint8, value: rune) -> unit {\n    moshi (!is_valid_rune(value)) {\n        __math_error(\"kiso/utf8.append_rune: invalid Unicode scalar value\");\n        kaesu;\n    }\n    append_valid(destination, int64(value));\n}\n\nkoukai waza valid(data: []uint8) -> bool {\n    kaku offset = 0;\n    aida (offset < len(data)) {\n        kaku packed = decode_packed(data, offset);\n        moshi (packed < 0) { kaesu iie; }\n        moshi (packed < 2228224) {\n            offset = offset + 1;\n        } sore {\n            moshi (packed < 3342336) {\n                offset = offset + 2;\n            } sore {\n                moshi (packed < 4456448) {\n                    offset = offset + 3;\n                } sore {\n                    offset = offset + 4;\n                }\n            }\n        }\n    }\n    kaesu hai;\n}\n\nkoukai waza rune_count(data: []uint8) -> int64? {\n    kaku offset = 0;\n    kaku count = 0;\n    aida (offset < len(data)) {\n        kaku packed = decode_packed(data, offset);\n        moshi (packed < 0) { kaesu mu; }\n        moshi (packed < 2228224) {\n            offset = offset + 1;\n        } sore {\n            moshi (packed < 3342336) {\n                offset = offset + 2;\n            } sore {\n                moshi (packed < 4456448) {\n                    offset = offset + 3;\n                } sore {\n                    offset = offset + 4;\n                }\n            }\n        }\n        count = count + 1;\n    }\n    kaesu count;\n}\n" }; }
waza data_available() -> bool { kaesu hai; }
