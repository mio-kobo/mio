waza data_4() -> File { kaesu File { path: "kiso/aot/lower/lower.mio", version: "Bunko-GF3-v0.2", length: 147426, sha256: "4b5b788bde9381a1b7a817de9285d3e9aa650869fc35a8119220dafc51e5cfc6", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/lower/nativefs\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// M17e's native lowering tier. It accepts all v14 constant encodings and the\n// scalar opcode subset listed below plus typed Nullable and Struct operations.\n// A bounded managed region, exact Shadow Frames, mark/sweep and 32-bin reuse\n// provide GC-safe Struct, Array and Enum allocation plus NativeFS calls.\n// Closures use the M15b Cell/Environment protocol; unresolved layouts fail closed. Each generated call frame has a bounded\n// 4,080-byte local/operand area and uses the established one-word ABI.\nkoukai sentaku LowerError {\n    UnsupportedConstant;\n    UnsupportedOpcode(int64);\n    UnsupportedClosure;\n    InvalidFunction;\n    InvalidOperand(int64);\n    FrameTooLarge;\n    EncodeFailure;\n    UnsafeType(int64);\n    UnsupportedNative(int64);\n    BranchOutOfRange(int64);\n}\n\nkoukai kata LowerResult {\n    words: []uint32;\n    constants: []uint8;\n    patches: []macho.AddressPatch;\n    globals: int64;\n    error: LowerError?;\n}\n\nkoukai waza error_code(value: LowerError) -> int64 {\n    awase (value) {\n        baai UnsupportedConstant { kaesu 1; }\n        baai UnsupportedOpcode(detail) { kaesu 2; }\n        baai UnsupportedClosure { kaesu 3; }\n        baai InvalidFunction { kaesu 4; }\n        baai InvalidOperand(detail) { kaesu 5000 + detail; }\n        baai FrameTooLarge { kaesu 6; }\n        baai EncodeFailure { kaesu 7; }\n        baai UnsafeType(detail) { kaesu 8; }\n        baai UnsupportedNative(detail) { kaesu 9; }\n        baai BranchOutOfRange(detail) { kaesu 10; }\n    }\n    kaesu 0;\n}\n\n// For UnsupportedOpcode the detail packs (functionID+1, byteOffset, opcode)\n// as FFFFF*1_000_000 + offset*100 + opcode.  Main uses functionID -1 and\n// therefore has no leading function component. BranchOutOfRange instead\n// reports the generated machine-word index, after all bytecode lowering.\nkoukai waza error_detail(value: LowerError) -> int64 {\n    awase (value) {\n        baai UnsupportedOpcode(detail) { kaesu detail; }\n        baai InvalidOperand(detail) { kaesu detail; }\n        baai UnsupportedConstant { kaesu 0; }\n        baai UnsupportedClosure { kaesu 0; }\n        baai InvalidFunction { kaesu 0; }\n        baai FrameTooLarge { kaesu 0; }\n        baai EncodeFailure { kaesu 0; }\n        baai UnsafeType(detail) { kaesu detail; }\n        baai UnsupportedNative(detail) { kaesu detail; }\n        baai BranchOutOfRange(detail) { kaesu detail; }\n    }\n    kaesu 0;\n}\n\nwaza failed(kind: LowerError) -> LowerResult {\n    kaesu LowerResult { words: [], constants: [], patches: [], globals: 0, error: kind };\n}\n\nwaza same_bytes(left: []uint8, right: []uint8) -> bool {\n    moshi (len(left) != len(right)) { kaesu iie; }\n    kaku index = 0;\n    aida (index < len(left)) {\n        moshi (left[index] != right[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\n// Intern once in first-occurrence order. IDs are shared by instruction\n// lowering, the constant image and NativeFS's empty string.\nwaza string_ids(constants: []mochi.Constant) -> []int64 {\n    kaku ids = array.make[int64](len(constants), -1); kaku unique: []int64 = [];\n    kaku i = 0;\n    aida (i < len(constants)) {\n        moshi (constants[i].tag == uint8(2)) {\n            kaku id = 0;\n            aida (id < len(unique) && !same_bytes(constants[unique[id]].data, constants[i].data)) { id = id + 1; }\n            moshi (id == len(unique)) { array.push(unique, i); }\n            ids[i] = id;\n        }\n        i = i + 1;\n    }\n    kaesu ids;\n}\n\nwaza put_u32_le(data: []uint8, at: int64, value: int64) -> unit {\n    data[at] = uint8(value - (value / 256) * 256);\n    data[at + 1] = uint8((value / 256) - (value / 65536) * 256);\n    data[at + 2] = uint8((value / 65536) - (value / 16777216) * 256);\n    data[at + 3] = uint8(value / 16777216);\n}\n\n// The table matches the established Go runtime: one little-endian\n// (offset,length) entry per interned string, followed by the exact UTF-8 bytes.\nwaza constant_image(constants: []mochi.Constant, ids: []int64, add_empty: bool) -> []uint8 {\n    kaku unique = 0;\n    kaku has_empty = iie;\n    kaku index = 0;\n    aida (index < len(constants)) {\n        moshi (constants[index].tag == uint8(2)) {\n            moshi (len(constants[index].data) == 0) { has_empty = hai; }\n            moshi (ids[index] == unique) { unique = unique + 1; }\n        }\n        index = index + 1;\n    }\n    kaku table_count = unique; moshi (add_empty && !has_empty) { table_count = table_count + 1; }\n    kaku output = array.make[uint8](table_count * 8, uint8(0));\n    kaku cursor = table_count * 8;\n    index = 0; kaku next_id = 0;\n    aida (index < len(constants)) {\n        moshi (constants[index].tag == uint8(2)) {\n            kaku id = ids[index];\n            moshi (id == next_id) {\n                next_id = next_id + 1;\n                put_u32_le(output, id * 8, cursor);\n                put_u32_le(output, id * 8 + 4, len(constants[index].data));\n                array.append_all(output, constants[index].data);\n                cursor = cursor + len(constants[index].data);\n            }\n        }\n        index = index + 1;\n    }\n    kaesu output;\n}\n\nwaza empty_string_id(constants: []mochi.Constant, ids: []int64) -> int64 {\n    kaku unique = 0; kaku index = 0;\n    aida (index < len(constants)) {\n        moshi (constants[index].tag == uint8(2) && ids[index] == unique) {\n            moshi (len(constants[index].data) == 0) { kaesu unique; }\n            unique = unique + 1;\n        }\n        index = index + 1;\n    }\n    kaesu unique;\n}\n\nwaza emit_constant(code: arm64.Assembler, constants: []mochi.Constant, ids: []int64, at: int64) -> LowerError? {\n    moshi (at < 0 || at >= len(constants)) { kaesu LowerError.InvalidOperand(3000 + at); }\n    kaku constant = constants[at];\n    kaku high = constant.bits.high;\n    kaku low = constant.bits.low;\n    // Signed fixed-width constants are serialized as their exact 8/16/32-bit\n    // payload and occupy a sign-extended raw runtime slot.\n    moshi (constant.tag == uint8(5) && low >= uint32(128)) { high = uint32(4294967295); low = low + uint32(4294967040); }\n    moshi (constant.tag == uint8(6) && low >= uint32(32768)) { high = uint32(4294967295); low = low + uint32(4294901760); }\n    moshi (constant.tag == uint8(7) && low >= uint32(2147483648)) { high = uint32(4294967295); }\n    moshi (constant.tag == uint8(2)) {\n        kaku tagged = ids[at] * 2 + 1;\n        high = uint32(0); low = uint32(tagged);\n    }\n    moshi (constant.tag < uint8(1) || constant.tag > uint8(10)) { kaesu LowerError.UnsupportedConstant(); }\n    move_bits(code, 9, high, low); push_register(code, 9);\n    kaesu mu;\n}\n\nwaza operand_u16(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset + 1]) * 256 + int64(data[offset + 2]);\n}\n\nwaza width(opcode: int64) -> int64 {\n    moshi (opcode == 1 || (opcode >= 17 && opcode <= 20) ||\n        (opcode >= 23 && opcode <= 25) || opcode == 30 || opcode == 36 || opcode == 37 || opcode == 40 || (opcode >= 44 && opcode <= 49)) { kaesu 3; }\n    moshi (opcode >= 2 && opcode <= 16) { kaesu 1; }\n    moshi (opcode == 54) { kaesu 3; }\n    moshi (opcode == 38) { kaesu 5; }\n    moshi (opcode == 39 || opcode == 41 || opcode == 42 || opcode == 43) { kaesu 1; }\n    moshi (opcode == 56 || opcode == 67) { kaesu 4; }\n    moshi (opcode == 55 || opcode == 57 || opcode == 58 || opcode == 65 || opcode == 66) { kaesu 2; }\n    moshi (opcode == 59 || opcode == 64 || opcode == 60 || opcode == 61 || opcode == 62 || opcode == 63) { kaesu 1; }\n    moshi (opcode == 21 || opcode == 22 || opcode == 26 || opcode == 27 || opcode == 28 || opcode == 29 || (opcode >= 50 && opcode <= 53) || opcode == 31 || opcode == 32 || opcode == 33 || opcode == 34 || opcode == 35) { kaesu 1; }\n    kaesu 0;\n}\n\n// Struct fields are not at a fixed offset.  The M12/M16b payload is\n// {kind,fieldCount,fieldCount,bitmapWords,bitmap...,fields...}; consequently\n// even the same field index moves when a struct crosses a 64-field bitmap\n// boundary.  Load bitmapWords from the receiver and form the address at run\n// time.  OpGetField is allocation-free and has no helper call, so replacing\n// the receiver slot in place does not introduce a GC safepoint.\nwaza emit_get_field(code: arm64.Assembler, index: int64) -> unit {\n    pop_register(code, 9);\n    kaku receiver_ok = string.concat(\"get_field_receiver_\", convert.format_int(len(code.words)));\n    arm64.assembler_cbnz_x(code, 9, receiver_ok);\n    arm64.assembler_b(code, \"runtime_error\");\n    arm64.assembler_label(code, receiver_ok);\n    // Validate the self-describing struct kind and field bound before using\n    // its variable part.  Static type/root analysis remains responsible for\n    // proving that the receiver is a managed reference.\n    emit(code, arm64.ldr_x(10, 9, 0));\n    emit(code, arm64.cmp_imm_x(10, 1, iie));\n    kaku kind_ok = string.concat(\"get_field_kind_\", convert.format_int(len(code.words)));\n    arm64.assembler_b_cond(code, 0, kind_ok);\n    arm64.assembler_b(code, \"runtime_error\");\n    arm64.assembler_label(code, kind_ok);\n    emit(code, arm64.ldr_x(10, 9, 8));\n    move_bits(code, 11, uint32(0), uint32(index));\n    emit(code, arm64.cmp_x(11, 10));\n    kaku bounds_ok = string.concat(\"get_field_bounds_\", convert.format_int(len(code.words)));\n    arm64.assembler_b_cond(code, 3, bounds_ok);\n    arm64.assembler_b(code, \"runtime_error\");\n    arm64.assembler_label(code, bounds_ok);\n    emit(code, arm64.ldr_x(10, 9, 24));\n    emit(code, arm64.ldr_x(12, 9, 8)); emit(code, arm64.add_imm_x(13, 12, 63, iie)); emit(code, arm64.lsr_x(13, 13, 6)); emit(code, arm64.cmp_x(13, 10));\n    kaku bitmap_ok = string.concat(\"get_field_bitmap_\", convert.format_int(len(code.words)));\n    arm64.assembler_b_cond(code, 0, bitmap_ok); arm64.assembler_b(code, \"runtime_error\"); arm64.assembler_label(code, bitmap_ok);\n    emit(code, arm64.add_x(13, 10, 12)); emit(code, arm64.lsl_x(13, 13, 3)); emit(code, arm64.add_imm_x(13, 13, 32, iie));\n    emit(code, arm64.sub_imm_x(14, 9, 16, iie)); emit(code, arm64.ldr_x(14, 14, 8)); emit(code, arm64.cmp_x(13, 14));\n    kaku payload_ok = string.concat(\"get_field_payload_\", convert.format_int(len(code.words)));\n    arm64.assembler_b_cond(code, 9, payload_ok); arm64.assembler_b(code, \"runtime_error\"); arm64.assembler_label(code, payload_ok);\n    emit(code, arm64.lsl_x(10, 10, 3));\n    emit(code, arm64.add_x(9, 9, 10));\n    emit(code, arm64.lsl_x(11, 11, 3));\n    emit(code, arm64.add_x(9, 9, 11));\n    emit(code, arm64.ldr_x(9, 9, 32));\n    push_register(code, 9);\n}\n\nwaza emit_len(code: arm64.Assembler, kind: int64) -> bool {\n    pop_register(code, 9);\n    moshi (kind == types.type_unknown || kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.movz_x(10, 1, 0)); emit(code, arm64.and_x(10, 9, 10)); emit(code, arm64.cmp_imm_x(10, 0, iie));\n        kaku dynamic_label = string.concat(\"len_dynamic_\", convert.format_int(len(code.words))); kaku done_label = string.concat(\"len_done_\", convert.format_int(len(code.words)));\n        arm64.assembler_b_cond(code, 0, dynamic_label); emit(code, arm64.lsr_x(10, 9, 1)); emit(code, arm64.lsl_x(10, 10, 3)); emit(code, arm64.add_x(10, 28, 10)); emit(code, arm64.ldr_x(10, 10, 0)); emit(code, arm64.lsr_x(9, 10, 32)); arm64.assembler_b(code, done_label);\n        arm64.assembler_label(code, dynamic_label); emit(code, arm64.ldr_x(9, 9, 8)); arm64.assembler_label(code, done_label); push_register(code, 9); kaesu hai;\n    }\n    moshi (kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\");\n        emit(code, arm64.lsr_x(10, 9, 1)); emit(code, arm64.lsl_x(10, 10, 3)); emit(code, arm64.add_x(10, 28, 10)); emit(code, arm64.ldr_x(10, 10, 0)); emit(code, arm64.lsr_x(9, 10, 32)); push_register(code, 9); kaesu hai;\n    }\n    moshi (kind == types.type_array_ref) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.ldr_x(9, 9, 8)); push_register(code, 9); kaesu hai;\n    }\n    kaesu iie;\n}\n\nwaza emit_index(code: arm64.Assembler, analysis: types.TypeAnalysis, index_node: int64, kind: int64) -> bool {\n    pop_register(code, 10); pop_register(code, 9);\n    emit_unbox_register(code, analysis, index_node, 10);\n    emit(code, arm64.cmp_imm_x(10, 0, iie)); arm64.assembler_b_cond(code, 11, \"runtime_error\");\n    moshi (kind == types.type_unknown || kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.movz_x(11, 1, 0)); emit(code, arm64.and_x(11, 9, 11)); emit(code, arm64.cmp_imm_x(11, 0, iie));\n        kaku array_label = string.concat(\"index_array_\", convert.format_int(len(code.words))); kaku done_label = string.concat(\"index_unknown_done_\", convert.format_int(len(code.words)));\n        arm64.assembler_b_cond(code, 0, array_label); emit(code, arm64.lsr_x(11, 9, 1)); emit(code, arm64.lsl_x(11, 11, 3)); emit(code, arm64.add_x(11, 28, 11)); emit(code, arm64.ldr_x(12, 11, 0)); emit(code, arm64.lsr_x(13, 12, 32)); emit(code, arm64.cmp_x(10, 13)); arm64.assembler_b_cond(code, 2, \"runtime_error\"); move_bits(code, 13, uint32(0), uint32(4294967295)); emit(code, arm64.and_x(12, 12, 13)); emit(code, arm64.add_x(12, 28, 12)); emit(code, arm64.add_x(12, 12, 10)); emit(code, arm64.ldrb_w(9, 12, 0)); arm64.assembler_b(code, done_label);\n        arm64.assembler_label(code, array_label); emit(code, arm64.ldr_x(11, 9, 8)); emit(code, arm64.cmp_x(10, 11)); arm64.assembler_b_cond(code, 2, \"runtime_error\"); emit(code, arm64.ldr_x(11, 9, 0)); emit(code, arm64.lsr_x(11, 11, 8)); move_bits(code, 12, uint32(0), uint32(255)); emit(code, arm64.and_x(11, 11, 12)); emit(code, arm64.ldr_x(12, 9, 40)); emit(code, arm64.add_imm_x(12, 12, 32, iie)); emit(code, arm64.cmp_imm_x(11, 1, iie)); kaku byte_label = string.concat(\"index_unknown_byte_\", convert.format_int(len(code.words))); arm64.assembler_b_cond(code, 0, byte_label); emit(code, arm64.cmp_imm_x(11, 8, iie)); arm64.assembler_b_cond(code, 1, \"runtime_error\"); emit(code, arm64.lsl_x(10, 10, 3)); emit(code, arm64.add_x(12, 12, 10)); emit(code, arm64.ldr_x(9, 12, 0)); arm64.assembler_b(code, done_label); arm64.assembler_label(code, byte_label); emit(code, arm64.add_x(12, 12, 10)); emit(code, arm64.ldrb_w(9, 12, 0)); arm64.assembler_label(code, done_label); push_register(code, 9); kaesu hai;\n    }\n    moshi (kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.lsr_x(11, 9, 1)); emit(code, arm64.lsl_x(11, 11, 3)); emit(code, arm64.add_x(11, 28, 11)); emit(code, arm64.ldr_x(12, 11, 0)); emit(code, arm64.lsr_x(13, 12, 32)); emit(code, arm64.cmp_x(10, 13)); arm64.assembler_b_cond(code, 2, \"runtime_error\");\n        move_bits(code, 13, uint32(0), uint32(4294967295)); emit(code, arm64.and_x(12, 12, 13)); emit(code, arm64.add_x(12, 28, 12)); emit(code, arm64.add_x(12, 12, 10)); emit(code, arm64.ldrb_w(9, 12, 0)); push_register(code, 9); kaesu hai;\n    }\n    moshi (kind == types.type_array_ref) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.ldr_x(11, 9, 8)); emit(code, arm64.cmp_x(10, 11)); arm64.assembler_b_cond(code, 2, \"runtime_error\"); emit(code, arm64.ldr_x(11, 9, 0)); emit(code, arm64.lsr_x(11, 11, 8)); move_bits(code, 12, uint32(0), uint32(255)); emit(code, arm64.and_x(11, 11, 12)); emit(code, arm64.ldr_x(12, 9, 40)); emit(code, arm64.add_imm_x(12, 12, 32, iie)); emit(code, arm64.cmp_imm_x(11, 1, iie));\n        kaku byte_label = string.concat(\"index_byte_\", convert.format_int(len(code.words))); kaku done_label = string.concat(\"index_done_\", convert.format_int(len(code.words)));\n        arm64.assembler_b_cond(code, 0, byte_label); emit(code, arm64.cmp_imm_x(11, 8, iie)); arm64.assembler_b_cond(code, 1, \"runtime_error\"); emit(code, arm64.lsl_x(10, 10, 3)); emit(code, arm64.add_x(12, 12, 10)); emit(code, arm64.ldr_x(9, 12, 0)); arm64.assembler_b(code, done_label);\n        arm64.assembler_label(code, byte_label); emit(code, arm64.add_x(12, 12, 10)); emit(code, arm64.ldrb_w(9, 12, 0)); arm64.assembler_label(code, done_label); push_register(code, 9); kaesu hai;\n    }\n    kaesu iie;\n}\n\n// Globals remain in Mach-O __DATA. A separate zero-filled anonymous mapping\n// owns metadata followed by a contiguous, non-moving managed arena. OS page\n// boundaries are not object boundaries; mark/sweep walks object headers.\nteisu runtime_default_heap_bytes = 134217728;\nteisu runtime_max_heap_bytes = 1073741824;\nteisu runtime_max_storage_bytes = 1073741792;\nteisu runtime_metadata_bytes = 3072;\n\nwaza adjust_sp(code: arm64.Assembler, bytes: int64, subtract: bool) -> unit {\n    kaku left = bytes;\n    aida (left > 0) {\n        kaku part = left; moshi (part > 4080) { part = 4080; }\n        moshi (subtract) { emit(code, arm64.sub_imm_x(31, 31, part, iie)); }\n        sore { emit(code, arm64.add_imm_x(31, 31, part, iie)); }\n        left = left - part;\n    }\n}\n\nwaza root_node_ok(type_result: types.TypeAnalysis, node: int64) -> bool {\n    kaesu types.type_kind(type_result, node) != types.type_unknown;\n}\n\n// Materialize the exact live reference vector immediately before a safepoint.\n// record = {previous,count,values...}.  Locals/globals use their solved slot\n// types; operand roots use the precise entry state for this opcode.\nwaza emit_shadow_push(code: arm64.Assembler, patches: []macho.AddressPatch,\n    type_result: types.TypeAnalysis, function_id: int64, entries: []int64) -> int64 {\n    kaku roots = 0;\n    kaku index = 0;\n    aida (index < len(type_result.globals)) {\n        moshi (!root_node_ok(type_result, type_result.globals[index])) { kaesu -1; }\n        moshi (types.type_is_heap_reference(type_result, type_result.globals[index])) { roots = roots + 1; }\n        index = index + 1;\n    }\n    moshi (function_id >= 0) {\n        moshi (len(type_result.upvalues[function_id]) > 0) { roots = roots + 1; }\n        index = 0;\n        aida (index < len(type_result.cells[function_id])) { moshi (type_result.cells[function_id][index]) { roots = roots + 1; } index = index + 1; }\n        index = 0;\n        aida (index < len(type_result.locals[function_id])) {\n            moshi (!root_node_ok(type_result, type_result.locals[function_id][index])) { kaesu -1; }\n            moshi (types.type_is_heap_reference(type_result, type_result.locals[function_id][index])) { roots = roots + 1; }\n            index = index + 1;\n        }\n    }\n    index = 0;\n    aida (index < len(entries)) {\n        moshi (!root_node_ok(type_result, entries[index])) { kaesu -1; }\n        moshi (types.type_is_heap_reference(type_result, entries[index])) { roots = roots + 1; }\n        index = index + 1;\n    }\n    kaku bytes = (roots + 2) * 8;\n    moshi (bytes - (bytes / 16) * 16 != 0) { bytes = bytes + 8; }\n    adjust_sp(code, bytes, hai);\n    emit(code, arm64.str_x(24, 31, 0));\n    move_bits(code, 9, uint32(0), uint32(roots)); emit(code, arm64.str_x(9, 31, 8));\n    kaku root = 0;\n    index = 0;\n    aida (index < len(type_result.globals)) {\n        moshi (types.type_is_heap_reference(type_result, type_result.globals[index])) {\n            kaku at = len(code.words);\n            emit(code, arm64.Instruction { word: uint32(0), error: mu });\n            emit(code, arm64.Instruction { word: uint32(0), error: mu });\n            array.push(patches, macho.AddressPatch { at_word: at, add_at_word: at + 1,\n                target: macho.data_target(), target_offset: index * 8, register: 8 });\n            emit(code, arm64.ldr_x(9, 8, 0)); emit(code, arm64.str_x(9, 31, 16 + root * 8)); root = root + 1;\n        }\n        index = index + 1;\n    }\n    moshi (function_id >= 0) {\n        moshi (len(type_result.upvalues[function_id]) > 0) { emit(code, arm64.str_x(25, 31, 16 + root * 8)); root = root + 1; }\n        index = 0;\n        aida (index < len(type_result.cells[function_id])) {\n            moshi (type_result.cells[function_id][index]) { cell_address(code, index); emit(code, arm64.ldr_x(9, 8, 0)); emit(code, arm64.str_x(9, 31, 16 + root * 8)); root = root + 1; }\n            index = index + 1;\n        }\n        index = 0;\n        aida (index < len(type_result.locals[function_id])) {\n            moshi (types.type_is_heap_reference(type_result, type_result.locals[function_id][index])) {\n                emit(code, arm64.ldr_x(9, 21, index * 8)); emit(code, arm64.str_x(9, 31, 16 + root * 8)); root = root + 1;\n            }\n            index = index + 1;\n        }\n    }\n    index = 0;\n    aida (index < len(entries)) {\n        moshi (types.type_is_heap_reference(type_result, entries[index])) {\n            emit(code, arm64.ldr_x(9, 19, index * 8)); emit(code, arm64.str_x(9, 31, 16 + root * 8)); root = root + 1;\n        }\n        index = index + 1;\n    }\n    emit(code, arm64.add_imm_x(24, 31, 0, iie));\n    kaesu bytes;\n}\n\nwaza emit_shadow_pop(code: arm64.Assembler, bytes: int64) -> unit {\n    emit(code, arm64.ldr_x(24, 31, 0));\n    adjust_sp(code, bytes, iie);\n}\n\nwaza emit_runtime_init(code: arm64.Assembler, capacity: int64, metadata_bytes: int64) -> unit {\n emit_runtime_init_policy(code,capacity,metadata_bytes,iie);\n}\nwaza emit_runtime_init_policy(code: arm64.Assembler, capacity: int64, metadata_bytes: int64, adaptive: bool) -> unit {\n    // Darwin mmap(NULL, metadata+capacity, RW, MAP