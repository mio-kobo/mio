 emit_observation_metric(code, \"gc_before_bytes\", 872);\n    emit_observation_metric(code, \"gc_after_bytes\", 880);\n    emit_observation_metric(code, \"gc_total_reclaimed_bytes\", 888);\n    emit_observation_metric(code, \"gc_last_ticks\", 328);\n    emit_observation_metric(code, \"gc_total_ticks\", 336);\n    emit_observation_metric(code, \"gc_max_ticks\", 344);\n    emit_observation_metric(code, \"timer_frequency_hz\", 352);\n    emit_observation_metric(code, \"runtime_ticks\", 912);\n    kaku i = 0;\n    aida (i < 64) {\n        emit_observation_metric(code, string.concat(\"gc_pause_bucket_\", convert.format_int(i)), 360 + i * 8);\n        i = i + 1;\n    }\n    emit_observation_metric(code, \"minor_gc_max_ticks\", gen_MinorMax);\n    emit_observation_metric(code, \"major_gc_max_ticks\", gen_MajorMax);\n    emit_observation_metric(code, \"minor_gc_count\", gen_MinorCount);\n    emit_observation_metric(code, \"major_gc_count\", gen_MajorCount);\n    emit_observation_metric(code, \"minor_gc_total_ticks\", gen_MinorTicks);\n    emit_observation_metric(code, \"major_gc_total_ticks\", gen_MajorTicks);\n    emit_observation_metric(code, \"young_live_bytes\", gen_YoungBytes);\n    emit_observation_metric(code, \"old_live_bytes\", gen_OldBytes);\n    emit_observation_metric(code, \"promoted_objects\", gen_PromotedObjects);\n    emit_observation_metric(code, \"promoted_bytes\", gen_PromotedBytes);\n    emit_observation_metric(code, \"promotion_threshold\", gen_Threshold);\n    emit_observation_metric(code, \"remembered_set_entries\", gen_RememberedCount);\n    emit_observation_metric(code, \"minor_scanned_old_objects\", gen_ScannedOld);\n    i = 0;\n    aida (i < 64) {\n        emit_observation_metric(code, string.concat(\"minor_gc_pause_bucket_\", convert.format_int(i)), 1536 + i * 8);\n        emit_observation_metric(code, string.concat(\"major_gc_pause_bucket_\", convert.format_int(i)), 2048 + i * 8);\n        i = i + 1;\n    }\n    arm64.assembler_label(code, \"ob