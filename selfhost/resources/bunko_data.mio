waza data_46() -> File { kaesu File { path: "kiso/aot/lowerlinux/runtime_socket.mio", version: "Bunko-v2.1.1", length: 42444, sha256: "f03953e05aad5e6b7b01e4e0318a8a04204e76697ad2ae76c1c61348c64e952d", source: "yobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// Linux IPv4 stream sockets for the body-less \"mio/sys/socket\" functions (kiso/net/tcp). Sockets share the NativeFS\n// generation-checked handle table. Status codes: 0 ok, 1 invalid argument, 2 closed, 3 timed out, 4 connection refused,\n// 5 connection reset, 6 address in use, 7 permission denied, 8 would block, 9 other, 10 operation in progress\n// (a nonblocking connect that has not completed yet; only produced for EINPROGRESS).\n// Blocking region around one syscall that can block for an unbounded time. Only multi-mutator programs (the `mutators` label exists) need\n// it: the thread then leaves the running state with its managed frame chain published and the heap references the native still needs\n// (the arrays at rbp-slot0 / rbp-slot1, 0 = none) pinned, so a stop-the-world collection does not wait for it (see rt.blk_enter in\n// mutators.mio). saved_frame: the native pushed rbp, so the wrapper frame is the saved one at [rbp]; otherwise rbp is the wrapper frame.\n// blocking_enter clobbers rax, rcx, rdx, rsi, rdi; blocking_leave clobbers everything but rax, r8 and r9. Nothing may touch the managed\n// heap between the two.\nwaza blocking_enter(code: x86_64.Assembler, saved_frame: bool, slot0: int64, slot1: int64) -> unit {\n    moshi (!mutators_enabled(code)) { kaesu; }\n    moshi (saved_frame) { x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, 0); }\n    sore { x86_64.mov_rr(code, x86_64.rdi, x86_64.rbp); }\n    moshi (slot0 != 0) { x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, slot0); } sore { x86_64.mov_ri(code, x86_64.rsi, 0); }\n    moshi (slot1 != 0) { x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, slot1); } sore { x86_64.mov_ri(code, x86_64.rdx, 0); }\n    x86_64.call(code, \"rt.blk_enter\");\n}\n\nwaza blocking_leave(code: x86_64.Assembler) -> unit {\n    moshi (mutators_enabled(code)) { x86_64.call(code, \"rt.blk_leave\"); }\n}\n\nwaza socket_message_text(code: int64) -> string {\n    moshi (code == 1) { kaesu \"invalid argument\"; }\n    moshi (code == 2) { kaesu \"socket closed\"; }\n    moshi (code == 3) { kaesu \"connection timed out\"; }\n    moshi (code == 4) { kaesu \"connection refused\"; }\n    moshi (code == 5) { kaesu \"connection reset\"; }\n    moshi (code == 6) { kaesu \"address already in use\"; }\n    moshi (code == 7) { kaesu \"permission denied\"; }\n    moshi (code == 8) { kaesu \"operation would block\"; }\n    moshi (code == 10) { kaesu \"operation in progress\"; }\n    kaesu \"socket error\";\n}\nwaza socket_message_label(code: int64) -> string { kaesu string.concat(\"rt.sock.message.\", convert.format_int(code)); }\n\nwaza emit_socket_runtime(code: x86_64.Assembler) -> unit {\n    kaku code_number = 0;\n    aida (code_number < 11) {\n        kaku text = \"\";\n        moshi (code_number != 0) { text = socket_message_text(code_number); }\n        emit_string_object(code, socket_message_label(code_number), text);\n        code_number = code_number + 1;\n    }\n    // rt.sock_classify: rax = positive errno -> rax = socket status code\n    x86_64.label(code, \"rt.sock_classify\");\n    kaku errnos: []int64 = [22, 97, 9, 88, 110, 111, 104, 32, 98, 13, 1, 11, 115];\n    kaku codes: []int64 = [1, 1, 2, 2, 3, 4, 5, 5, 6, 7, 7, 8, 10];\n    kaku at = 0;\n    aida (at < len(errnos)) {\n        kaku next = string.concat(\"rt.sock_classify.next.\", convert.format_int(at));\n        x86_64.cmp_ri(code, x86_64.rax, errnos[at]);\n        x86_64.jcc(code, x86_64.cc_ne, next);\n        x86_64.mov_ri(code, x86_64.rax, codes[at]);\n        x86_64.ret(code);\n        x86_64.label(code, next);\n        at = at + 1;\n    }\n    x86_64.mov_ri(code, x86_64.rax, 9);\n    x86_64.ret(code);\n\n    // rt.sock_mess