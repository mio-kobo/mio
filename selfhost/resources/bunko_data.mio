 binary.reader_read_u16_be(input);\n    moshi (version_result.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), 5, 2); }\n    kaku version = int64(version_result.value);\n    moshi (version < 1 || version > VERSION) { kaesu failure(DecodeErrorKind.UnsupportedVersion(), 5, version); }\n    kaku count_at = binary.reader_offset(input);\n    kaku constant_count = binary.reader_read_u32_be(input);\n    moshi (constant_count.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), count_at, 4); }\n    moshi (int64(constant_count.value) > MAX_CONSTANTS) { kaesu failure(DecodeErrorKind.LimitExceeded(), count_at, int64(constant_count.value)); }\n    kaku constants = array.with_capacity[Constant](int64(constant_count.value));\n    kaku index = 0;\n    aida (index < int64(constant_count.value)) {\n        kaku decoded = read_constant(input, version);\n        kaku decoded_error = decoded.error;\n        moshi (decoded_error != mu) { kaesu DecodeResult { value: mu, error: decoded_error }; }\n        kaku part = decoded.value;\n        moshi (part != mu) { array.push(constants, part.constants[0]); }\n        sore { kaesu failure(DecodeErrorKind.InvalidConstant(), binary.reader_offset(input), index); }\n        index = index + 1;\n    }\n    kaku globals_at = binary.reader_offset(input);\n    kaku globals = binary.reader_read_u32_be(input);\n    moshi (globals.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), globals_at, 4); }\n    moshi (int64(globals.value) > MAX_GLOBALS) { kaesu failure(DecodeErrorKind.LimitExceeded(), globals_at, int64(globals.value)); }\n    kaku instructions_at = binary.reader_offset(input);\n    kaku instruction_length = binary.reader_read_u32_be(input);\n    moshi (instruction_length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), instructions_at, 4); }\n    moshi (int64(instruction_length.value) > MAX_INSTRUCTION_BYTES) { kaesu failure(DecodeErrorKind.LimitExceeded(), instructions_at, int64(instruction_length.value)); }\n    kaku instruction_data = binary.reader_read_bytes(input, int64(instruction_length.value));\n    moshi (instruction_data.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), int64(instruction_length.value)); }\n    kaku functions = array.with_capacity[Function](0);\n    moshi (version >= 2) {\n        kaku functions_at = binary.reader_offset(input);\n        kaku function_count = binary.reader_read_u32_be(input);\n        moshi (function_count.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), functions_at, 4); }\n        moshi (int64(function_count.value) > MAX_FUNCTIONS) { kaesu failure(DecodeErrorKind.LimitExceeded(), functions_at, int64(function_count.value)); }\n        functions = array.with_capacity[Function](int64(function_count.value));\n        index = 0;\n        aida (index < int64(function_count.value)) {\n            kaku function_at = binary.reader_offset(input);\n            kaku id = binary.reader_read_u16_be(input);\n            kaku name_length = binary.reader_read_u16_be(input);\n            moshi (id.error != mu || name_length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), function_at, 4); }\n            moshi (int64(id.value) != index) { kaesu failure(DecodeErrorKind.InvalidFunction(), function_at, int64(id.value)); }\n            kaku name_data = binary.reader_read_bytes(input, int64(name_length.value));\n            moshi (name_data.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), int64(name_length.value)); }\n            moshi (len(name_data.data) == 0) { kaesu failure(DecodeErrorKind.InvalidFunction(), function_at + 4, 0); }\n            moshi (!utf8.valid(name_data.data)) { kaesu failure(DecodeErrorKind.InvalidUtf8(), function_at + 4, len(name_data.data)); }\n            kaku name = string.from_utf8(name_data.data);\n            moshi (name == mu) { kaesu failure(DecodeErrorKind.InvalidUtf8(), function_at + 4, len(name_data.data)); }\n            kaku parameter_at = binary.reader_offset(input);\n            kaku parameters = binary.reader_read_u32_be(input);\n            kaku locals = binary.reader_read_u32_be(input);\n            kaku flags = binary.reader_read_u8(input);\n            moshi (parameters.error != mu || locals.error != mu || flags.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), parameter_at, 9); }\n            moshi (int64(parameters.value) > MAX_FUNCTION_SLOTS || int64(locals.value) < int64(parameters.value) || int64(locals.value) > MAX_FUNCTION_SLOTS || flags.value > uint8(1)) {\n                kaesu failure(DecodeErrorKind.InvalidFunction(), parameter_at, index);\n            }\n            kaku captures = array.with_capacity[Capture](0);\n            moshi (version >= 9) {\n                kaku capture_at = binary.reader_offset(input);\n                kaku capture_count = binary.reader_read_u32_be(input);\n                moshi (capture_count.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), capture_at, 4); }\n                moshi (int64(capture_count.value) > MAX_FUNCTION_SLOTS) { kaesu failure(DecodeErrorKind.LimitExceeded(), capture_at, int64(capture_count.value)); }\n                captures = array.with_capacity[Capture](int64(capture_count.value));\n                kaku capture_index = 0;\n                aida (capture_index < int64(capture_count.value)) {\n                    kaku source = binary.reader_read_u8(input);\n                    kaku capture_slot = binary.reader_read_u32_be(input);\n                    moshi (source.error != mu || capture_slot.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), 5); }\n                    moshi (source.value > uint8(1) || int64(capture_slot.value) >= MAX_FUNCTION_SLOTS) { kaesu failure(DecodeErrorKind.InvalidFunction(), capture_at, capture_index); }\n                    array.push(captures, Capture { local: source.value == uint8(1), index: int64(capture_slot.value) });\n                    capture_index = capture_index + 1;\n                }\n            }\n            kaku length_at = binary.reader_offset(input);\n            kaku length = binary.reader_read_u32_be(input);\n            moshi (length.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), length_at, 4); }\n            moshi (int64(length.value) > MAX_INSTRUCTION_BYTES) { kaesu failure(DecodeErrorKind.LimitExceeded(), length_at, int64(length.value)); }\n            kaku body = binary.reader_read_bytes(input, int64(length.value));\n            moshi (body.error != mu) { kaesu failure(DecodeErrorKind.Truncated(), binary.reader_offset(input), int64(length.value)); }\n            array.push(functions, Function { id: int64(id.value), name: name, name_bytes: name_data.data,\n                parameter_count: int64(parameters.value), local_count: int64(locals.value), returns_value: flags.value == uint8(1),\n                captures: captures, instructions: body.data });\n            index = index + 1;\n        }\n    }\n    moshi (!binary.reader_eof(input)) { kaesu failure(DecodeErrorKind.TrailingData(), binary.reader_offset(input), binary.reader_remaining(input)); }\n    kaku file = File { version: version, constants: constants, global_count: int64(globals.value),\n        instructions: instruction_data.data, functions: functions };\n    kaku validation = validate_instructions(file, file.instructions, -1);\n    moshi (validation != mu) { kaesu DecodeResult { value: mu, error: validation }; }\n    index = 0;\n    aida (index < len(file.functions)) {\n        validation = validate_instructions(file, file.functions[index].instructions, index);\n        moshi (validation != mu) { kaesu DecodeResult { value: mu, error: validation }; }\n        index = index + 1;\n    }\n    kaesu DecodeResult { value: file, error: mu };\n}\n\nkoukai waza error_code(error: DecodeError) -> int64 {\n    awase (error.kind) {\n        baai Truncated { kaesu 1; } baai InvalidMagic { kaesu 2; } baai UnsupportedVersion { kaesu 3; }\n        baai LimitExceeded { kaesu 4; } baai InvalidConstant { kaesu 5; } baai InvalidUtf8 { kaesu 6; }\n        baai InvalidFunction { kaesu 7; } baai InvalidInstruction { kaesu 8; } baai InvalidIndex { kaesu 9; }\n        baai InvalidJump { kaesu 10; } baai TrailingData { kaesu 11; } baai IoFailure { kaesu 12; }\n    }\n    kaesu 0;\n}\n" }; }
waza data_62() -> File { kaesu File { path: "kiso/encoding/mochi/encode.mio", version: "Bunko-v2.1.1", length: 3613, sha256: "754e2241e08a97da95bd3809e8ef30ff956b7f599178e77ba6e5f5e853961867", source: "yobu \"kiso/encoding/binary\";\n\nwaza write_constant(output: binary.BinaryWriter, value: Constant) -> unit {\n    binary.writer_write_u8(output, value.tag);\n    moshi (value.tag == uint8(1) || value.tag == uint8(3)) { binary.writer_write_u64_be(output, value.bits); kaesu; }\n    moshi (value.tag == uint8(2)) { binary.writer_write_length_prefixed(output, value.data); kaesu; }\n    moshi (value.tag == uint8(4) || value.tag == uint8(7) || value.tag == uint8(10)) { binary.writer_write_u32_be(output, value.bits.low); kaesu; }\n    moshi (value.tag == uint8(6) || value.tag == uint8(9)) { binary.writer_write_u16_be(output, uint16(value.bits.low)); kaesu; }\n    binary.writer_write_u8(output, uint8(value.bits.low));\n}\n\n// canonical_bytes deterministically serializes every decoded field.  For a valid\n// Mochi file this is a structural normalization, not a copy of the input buffer.\nkoukai waza canonical_bytes(value: File) -> []uint8 {\n    kaku output = binary.writer(MAX_FILE_SIZE);\n    binary.writer_write_bytes(output, [77, 79, 67, 72, 73]);\n    binary.writer_write_u16_be(output, uint16(value.version));\n    binary.writer_write_u32_be(output, uint32(len(value.constants)));\n    kaku index = 0;\n    aida (index < len(value.constants)) { write_constant(output, value.constants[index]); index = index + 1; }\n    binary.writer_write_u32_be(output, uint32(value.global_count));\n    binary.writer_write_length_prefixed(output, value.instructions);\n    moshi (value.version >= 2) {\n        binary.writer_write_u32_be(output, uint32(len(value.functions)));\n        index = 0;\n        aida (index < len(value.functions)) {\n            kaku function = value.functions[index];\n            binary.writer_write_u16_be(output, uint16(function.id));\n            binary.writer_write_u16_be(output, uint16(len(function.name_bytes)));\n            binary.writer_write_bytes(output, function.name_bytes);\n            binary.writer_write_u32_be(output, uint32(function.parameter_count));\n            binary.writer_write_u32_be(output, uint32(function.local_count));\n            kaku flags = uint8(0); moshi (function.returns_value) { flags = uint8(1); }\n            binary.writer_write_u8(output, flags);\n            moshi (value.version >= 9) {\n                binary.writer_write_u32_be(output, uint32(len(function.captures)));\n                kaku capture_index = 0;\n                aida (capture_index < len(function.captures)) {\n                    kaku source = uint8(0); moshi (function.captures[capture_index].local) { source = uint8(1); }\n                    binary.writer_write_u8(output, source);\n                    binary.writer_write_u32_be(output, uint32(function.captures[capture_index].index));\n                    capture_index = capture_index + 1;\n                }\n            }\n            binary.writer_write_length_prefixed(output, function.instructions);\n            index = index + 1;\n        }\n    }\n    kaesu binary.writer_bytes(output);\n}\n\nkoukai kata Summary {\n    version: int64;\n    constants: int64;\n    functions: int64;\n    globals: int64;\n    instruction_bytes: int64;\n    canonical_size: int64;\n}\n\nkoukai waza summarize(value: File) -> Summary {\n    kaku instruction_bytes = len(value.instructions);\n    kaku index = 0;\n    aida (index < len(value.functions)) { instruction_bytes = instruction_bytes + len(value.functions[index].instructions); index = index + 1; }\n    kaesu Summary { version: value.version, constants: len(value.constants), functions: len(value.functions),\n        globals: value.global_count, instruction_bytes: instruction_bytes, canonical_size: len(canonical_bytes(value)) };\n}\n" }; }
waza data_63() -> File { kaesu File { path: "kiso/encoding/mochi/file.mio", version: "Bunko-v2.1.1", length: 1429, sha256: "d30815c4c97ed744552f5d705e4313875b087428df8546608f97fe63b5835ed1", source: "yobu \"kiso/array\";\nyobu \"kiso/fs\";\n\n// decode_file enforces the Mochi file ceiling while reading, before an attacker-\n// controlled file can cause an unbounded destination allocation.\nkoukai waza decode_file(path: string) -> DecodeResult {\n    kaku opened = fs.open_read(path);\n    kaku open_error = opened.error;\n    moshi (open_error != mu) { kaesu failure(DecodeErrorKind.IoFailure(), 0, 0); }\n    kaku file = opened.file;\n    moshi (file == mu) { kaesu failure(DecodeErrorKind.IoFailure(), 0, 0); }\n    kaku output = array.with_capacity[uint8](32768);\n    kaku buffer = array.make[uint8](32768, uint8(0));\n    aida (hai) {\n        kaku result = fs.read(file, buffer, 0, len(buffer));\n        kaku read_error = result.error;\n        moshi (read_error != mu) { fs.close(file); kaesu failure(DecodeErrorKind.IoFailure(), len(output), 0); }\n        moshi (result.count > MAX_FILE_SIZE - len(output)) { fs.close(file); kaesu failure(DecodeErrorKind.LimitExceeded(), len(output), result.count); }\n        kaku index = 0;\n        aida (index < result.count) { array.push(output, buffer[index]); index = index + 1; }\n        moshi (result.eof) { nukeru; }\n        moshi (result.count == 0) { fs.close(file); kaesu failure(DecodeErrorKind.IoFailure(), len(output), 0); }\n    }\n    kaku closed = fs.close(file);\n    moshi (closed.error != mu) { kaesu failure(DecodeErrorKind.IoFailure(), len(output), 0); }\n    kaesu decode(output);\n}\n" }; }
waza data_64() -> File { kaesu File { path: "kiso/fs/fs.mio", version: "Bunko-v2.1.1", length: 11060, sha256: "50d8e1cf5aa2fbbd30fd67df5a1a0aa654275e5359d74aa70e4442c6656ed775", source: "yobu \"kiso/array\";\nyobu \"kiso/io\";\nyobu \"mio/fs/runtime\";\n\nkoukai sentaku FsError {\n    NotFound(string);\n    PermissionDenied(string);\n    Closed(string);\n    InvalidArgument(string);\n    NoSpace(string);\n    InvalidPath(string);\n    IOFailure(string);\n}\n\nkoukai kata File { handle: resource; }\nkoukai kata FileResult { file: File?; error: FsError?; }\nkoukai kata ReadAllResult { data: []uint8; error: FsError?; }\nkoukai kata UnitResult { error: FsError?; }\nkoukai kata StatResult { exists: bool; is_file: bool; is_dir: bool; error: FsError?; }\nkoukai kata DirEntry { name: string; is_file: bool; is_dir: bool; }\nkoukai kata DirResult { entries: []DirEntry; error: FsError?; }\n\nwaza error_from(code: uint8, message: string) -> FsError? {\n    moshi (code == uint8(0)) { kaesu mu; }\n    moshi (code == uint8(1)) { kaesu FsError.NotFound(message); }\n    moshi (code == uint8(2)) { kaesu FsError.PermissionDenied(message); }\n    moshi (code == uint8(3)) { kaesu FsError.Closed(message); }\n    moshi (code == uint8(4)) { kaesu FsError.InvalidArgument(message); }\n    moshi (code == uint8(6)) { kaesu FsError.NoSpace(message); }\n    moshi (code == uint8(7)) { kaesu FsError.InvalidPath(message); }\n    kaesu FsError.IOFailure(message);\n}\n\nwaza decode_count(status: []uint8) -> int64 {\n    kaku result = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 8) {\n        result = result + int64(status[index]) * factor;\n        factor = factor * 256;\n        index = index + 1;\n    }\n    kaesu result;\n}\n\nwaza open_mode(path: string, mode: int64) -> FileResult {\n    kaku handle = runtime.open(path, mode);\n    kaku status: []uint8 = [0];\n    kaku message = runtime.file_status(handle, status);\n    kaku open_error = error_from(status[0], message);\n    moshi (open_error != mu) {\n        kaku close_status: []uint8 = [0];\n        runtime.close(handle, close_status);\n        kaesu FileResult { file: mu, error: open_error };\n    }\n    kaesu FileResult { file: File { handle: handle }, error: mu };\n}\n\nkoukai waza open_read(path: string) -> FileResult { kaesu open_mode(path, 0); }\nkoukai waza open_write(path: string) -> FileResult { kaesu open_mode(path, 1); }\nkoukai waza open_append(path: string) -> FileResult { kaesu open_mode(path, 2); }\n\nkoukai waza read(file: File, destination: []uint8, offset: int64, length: int64) -> io.ReadResult {\n    moshi (offset < 0 || length < 0 || offset > len(destination) || length > len(destination) - offset) {\n        kaesu io.ReadResult { count: 0, eof: iie, error: io.IoError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = runtime.read(file.handle, destination, offset, length, status);\n    kaku failure = error_from(status[9], message);\n    moshi (failure == mu) {\n        kaesu io.ReadResult { count: decode_count(status), eof: status[8] != uint8(0), error: mu };\n    }\n    awase (failure) {\n        baai Closed(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Closed() }; }\n        baai InvalidArgument(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.InvalidArgument() }; }\n        baai IOFailure(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai NotFound(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai PermissionDenied(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai NoSpace(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n        baai InvalidPath(detail) { kaesu io.ReadResult { count: decode_count(status), eof: iie, error: io.IoError.Other(detail) }; }\n    }\n    kaesu io.ReadResult { count: 0, eof: iie, error: io.IoError.Other(message) };\n}\n\nkoukai waza write(file: File, source: []uint8, offset: int64, length: int64) -> io.WriteResult {\n    moshi (offset < 0 || length < 0 || offset > len(source) || length > len(source) - offset) {\n        kaesu io.WriteResult { count: 0, error: io.IoError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = runtime.write(file.handle, source, offset, length, status);\n    kaku failure = error_from(status[9], message);\n    moshi (failure == mu) { kaesu io.WriteResult { count: decode_count(status), error: mu }; }\n    awase (failure) {\n        baai Closed(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Closed() }; }\n        baai InvalidArgument(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.InvalidArgument() }; }\n        baai IOFailure(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai NotFound(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai PermissionDenied(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai NoSpace(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n        baai InvalidPath(detail) { kaesu io.WriteResult { count: decode_count(status), error: io.IoError.Other(detail) }; }\n    }\n    kaesu io.WriteResult { count: 0, error: io.IoError.Other(message) };\n}\n\nkoukai waza close(file: File) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = runtime.close(file.handle, status);\n    kaesu UnitResult { error: error_from(status[0], message) };\n}\n\nkoukai waza reader(file: File) -> io.Reader {\n    kaesu io.Reader { read: waza (destination: []uint8, offset: int64, length: int64) -> io.ReadResult {\n        kaesu read(file, destination, offset, length);\n    } };\n}\n\nkoukai waza writer(file: File) -> io.Writer {\n    kaesu io.Writer { write: waza (source: []uint8, offset: int64, length: int64) -> io.WriteResult {\n        kaesu write(file, source, offset, length);\n    } };\n}\n\nkoukai waza read_all(path: string) -> ReadAllResult {\n    kaku opened = open_read(path);\n    kaku open_error = opened.error;\n    moshi (open_error != mu) { kaesu ReadAllResult { data: [], error: open_error }; }\n    kaku file = opened.file;\n    moshi (file == mu) { kaesu ReadAllResult { data: [], error: FsError.IOFailure(\"missing file handle\") }; }\n    kaku output = array.with_capacity[uint8](32768);\n    kaku buffer = array.make[uint8](32768, uint8(0));\n    aida (hai) {\n        kaku result = read(file, buffer, 0, len(buffer));\n        kaku index = 0;\n        aida (index < result.count) {\n            array.push(output, buffer[index]);\n            index = index + 1;\n        }\n        kaku read_error = result.error;\n        moshi (read_error != mu) {\n            close(file);\n            awase (read_error) {\n                baai Closed { kaesu ReadAllResult { data: output, error: FsError.Closed(\"file is closed\") }; }\n                baai InvalidArgument { kaesu ReadAllResult { data: output, error: FsError.InvalidArgument(\"invalid read range\") }; }\n                baai NoProgress { kaesu ReadAllResult { data: output, error: FsError.IOFailure(\"read made no progress\") }; }\n                baai UnexpectedEOF { kaesu ReadAllResult { data: output, error: FsError.IOFailure(\"unexpected EOF\") }; }\n                baai Other(message) { kaesu ReadAllResult { data: output, error: FsError.IOFailure(message) }; }\n            }\n        }\n        moshi (result.eof) { nukeru; }\n        moshi (result.count == 0) {\n            close(file);\n            kaesu ReadAllResult { data: output, error: FsError.IOFailure(\"read made no progress\") };\n        }\n    }\n    kaku closed = close(file);\n    kaesu ReadAllResult { data: output, error: closed.error };\n}\n\nkoukai waza write_all(path: string, data: []uint8) -> UnitResult {\n    kaku opened = open_write(path);\n    kaku open_error = opened.error;\n    moshi (open_error != mu) { kaesu UnitResult { error: open_error }; }\n    kaku file = opened.file;\n    moshi (file == mu) { kaesu UnitResult { error: FsError.IOFailure(\"missing file handle\") }; }\n    kaku result = io.write_all(writer(file), data, 0, len(data));\n    kaku write_error = result.error;\n    kaku closed = close(file);\n    moshi (write_error != mu) {\n        awase (write_error) {\n            baai Closed { kaesu UnitResult { error: FsError.Closed(\"file is closed\") }; }\n            baai InvalidArgument { kaesu UnitResult { error: FsError.InvalidArgument(\"invalid write range\") }; }\n            baai NoProgress { kaesu UnitResult { error: FsError.IOFailure(\"write made no progress\") }; }\n            baai UnexpectedEOF { kaesu UnitResult { error: FsError.IOFailure(\"unexpected EOF\") }; }\n            baai Other(message) { kaesu UnitResult { error: FsError.IOFailure(message) }; }\n        }\n    }\n    kaesu closed;\n}\n\nkoukai waza stat(path: string) -> StatResult {\n    kaku status: []uint8 = [0, 0];\n    kaku message = runtime.stat(path, status);\n    kaku stat_error = error_from(status[1], message);\n    moshi (status[1] == uint8(1)) {\n        kaesu StatResult { exists: iie, is_file: iie, is_dir: iie, error: mu };\n    }\n    kaesu StatResult { exists: stat_error == mu, is_file: status[0] == uint8(1), is_dir: status[0] == uint8(2), error: stat_error };\n}\n\nkoukai waza exists(path: string) -> bool { kaesu stat(path).exists; }\nkoukai waza is_file(path: string) -> bool { kaesu stat(path).is_file; }\nkoukai waza is_dir(path: string) -> bool { kaesu stat(path).is_dir; }\n\nkoukai waza create_dir(path: string) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = runtime.mkdir(path, status);\n    kaesu UnitResult { error: error_from(status[0], message) };\n}\n\nkoukai waza read_dir(path: string) -> DirResult {\n    kaku iterator = runtime.open_dir(path);\n    kaku status: []uint8 = [0];\n    kaku message = runtime.dir_status(iterator, status);\n    kaku directory_error = error_from(status[0], message);\n    kaku entries = array.with_capacity[DirEntry](0);\n    moshi (directory_error != mu) {\n        runtime.dir_close(iterator, status);\n        kaesu DirResult { entries: entries, error: directory_error };\n    }\n    aida (runtime.dir_next(iterator)) {\n        kaku directory = runtime.dir_is_dir(iterator);\n        array.push(entries, DirEntry { name: runtime.dir_name(iterator), is_file: runtime.dir_is_file(iterator), is_dir: directory });\n    }\n    message = runtime.dir_status(iterator, status);\n    directory_error = error_from(status[0], message);\n    message = runtime.dir_close(iterator, status);\n    moshi (directory_error == mu) { directory_error = error_from(status[0], message); }\n    kaesu DirResult { entries: entries, error: directory_error };\n}\n\n// Optional third status byte extends the existing NativeFS stat protocol.\n// The original existence/file/directory and error bytes remain unchanged.\nkoukai waza is_character_device(path: string) -> bool {\n    kaku status: []uint8=[0,0,0];runtime.stat(path,status);\n    kaesu status[1]==uint8(0) && status[2]==uint8(1);\n}\n" }; }
waza data_65() -> File { kaesu File { path: "kiso/io/io.mio", version: "Bunko-v2.1.1", length: 5935, sha256: "68e0e56e765a262092db578cd9dfaf25c40271d0b3489af6abff18609e9ace67", source: "yobu \"kiso/array\";\nyobu \"kiso/bytes\";\n\nkoukai sentaku IoError {\n    Closed;\n    InvalidArgument;\n    NoProgress;\n    UnexpectedEOF;\n    Other(string);\n}\n\nkoukai kata ReadResult { count: int64; eof: bool; error: IoError?; }\nkoukai kata WriteResult { count: int64; error: IoError?; }\nkoukai kata CopyResult { count: int64; error: IoError?; }\n\nkoukai kata Reader { read: ([]uint8, int64, int64) -> ReadResult; }\nkoukai kata Writer { write: ([]uint8, int64, int64) -> WriteResult; }\n\nwaza valid_range(values: []uint8, offset: int64, length: int64) -> bool {\n    kaesu offset >= 0 && length >= 0 && offset <= len(values) && length <= len(values) - offset;\n}\n\nkoukai waza read(reader: Reader, destination: []uint8, offset: int64, length: int64) -> ReadResult {\n    moshi (!valid_range(destination, offset, length)) {\n        kaesu ReadResult { count: 0, eof: iie, error: IoError.InvalidArgument() };\n    }\n    kaesu reader.read(destination, offset, length);\n}\n\nkoukai waza write(writer: Writer, source: []uint8, offset: int64, length: int64) -> WriteResult {\n    moshi (!valid_range(source, offset, length)) {\n        kaesu WriteResult { count: 0, error: IoError.InvalidArgument() };\n    }\n    kaesu writer.write(source, offset, length);\n}\n\nkoukai waza read_full(reader: Reader, destination: []uint8, offset: int64, length: int64) -> ReadResult {\n    moshi (!valid_range(destination, offset, length)) {\n        kaesu ReadResult { count: 0, eof: iie, error: IoError.InvalidArgument() };\n    }\n    kaku total = 0;\n    aida (total < length) {\n        kaku result = reader.read(destination, offset + total, length - total);\n        moshi (result.count < 0 || result.count > length - total) {\n            kaesu ReadResult { count: total, eof: iie, error: IoError.InvalidArgument() };\n        }\n        total = total + result.count;\n        kaku read_error = result.error;\n        moshi (read_error != mu) {\n            kaesu ReadResult { count: total, eof: result.eof, error: result.error };\n        }\n        moshi (total == length) {\n            kaesu ReadResult { count: total, eof: result.eof, error: mu };\n        }\n        moshi (result.eof) {\n            kaesu ReadResult { count: total, eof: hai, error: IoError.UnexpectedEOF() };\n        }\n        moshi (result.count == 0) {\n            kaesu ReadResult { count: total, eof: iie, error: IoError.NoProgress() };\n        }\n    }\n    kaesu ReadResult { count: total, eof: iie, error: mu };\n}\n\nkoukai waza write_all(writer: Writer, source: []uint8, offset: int64, length: int64) -> WriteResult {\n    moshi (!valid_range(source, offset, length)) {\n        kaesu WriteResult { count: 0, error: IoError.InvalidArgument() };\n    }\n    kaku total = 0;\n    aida (total < length) {\n        kaku result = writer.write(source, offset + total, length - total);\n        moshi (result.count < 0 || result.count > length - total) {\n            kaesu WriteResult { count: total, error: IoError.InvalidArgument() };\n        }\n        total = total + result.count;\n        kaku write_error = result.error;\n        moshi (write_error != mu) {\n            kaesu WriteResult { count: total, error: result.error };\n        }\n        moshi (result.count == 0) {\n            kaesu WriteResult { count: total, error: IoError.NoProgress() };\n        }\n    }\n    kaesu WriteResult { count: total, error: mu };\n}\n\nkoukai waza copy_stream(reader: Reader, writer: Writer) -> CopyResult {\n    kaku buffer = array.make[uint8](32768, uint8(0));\n    kaku total = 0;\n    aida (hai) {\n        kaku read_result = reader.read(buffer, 0, len(buffer));\n        moshi (read_result.count < 0 || read_result.count > len(buffer)) {\n            kaesu CopyResult { count: total, error: IoError.InvalidArgument() };\n        }\n        moshi (read_result.count > 0) {\n            kaku write_result = write_all(writer, buffer, 0, read_result.count);\n            total = total + write_result.count;\n            kaku stream_write_error = write_result.error;\n            moshi (stream_write_error != mu) {\n                kaesu CopyResult { count: total, error: write_result.error };\n            }\n        }\n        kaku stream_read_error = read_result.error;\n        moshi (stream_read_error != mu) {\n            kaesu CopyResult { count: total, error: read_result.error };\n        }\n        moshi (read_result.eof) {\n            kaesu CopyResult { count: total, error: mu };\n        }\n        moshi (read_result.count == 0) {\n            kaesu CopyResult { count: total, error: IoError.NoProgress() };\n        }\n    }\n    kaesu CopyResult { count: total, error: mu };\n}\n\nkoukai waza reader_from_bytes(source: []uint8) -> Reader {\n    kaku position = 0;\n    kaesu Reader { read: waza (destination: []uint8, offset: int64, length: int64) -> ReadResult {\n        moshi (!valid_range(destination, offset, length)) {\n            kaesu ReadResult { count: 0, eof: iie, error: IoError.InvalidArgument() };\n        }\n        moshi (position > len(source)) { position = len(source); }\n        kaku remaining = len(source) - position;\n        kaku count = length;\n        moshi (remaining < count) { count = remaining; }\n        kaku index = 0;\n        aida (index < count) {\n            destination[offset + index] = source[position + index];\n            index = index + 1;\n        }\n        position = position + count;\n        kaesu ReadResult { count: count, eof: position == len(source), error: mu };\n    } };\n}\n\nkoukai waza writer_to_buffer(buffer: bytes.ByteBuffer) -> Writer {\n    kaesu Writer { write: waza (source: []uint8, offset: int64, length: int64) -> WriteResult {\n        moshi (!valid_range(source, offset, length)) {\n            kaesu WriteResult { count: 0, error: IoError.InvalidArgument() };\n        }\n        kaku index = 0;\n        aida (index < length) {\n            array.push(buffer.data, source[offset + index]);\n            index = index + 1;\n        }\n        kaesu WriteResult { count: length, error: mu };\n    } };\n}\n" }; }
waza data_66() -> File { kaesu File { path: "kiso/math/compare.mio", version: "Bunko-v2.1.1", length: 1176, sha256: "7cadb689838a1fcf48bb31ec69a52d683482706e7fde1c94bd2820590412b27e", source: "koukai waza min<T: Number>(left: T, right: T) -> T {\n    moshi (left != left) { kaesu left; }\n    moshi (right != right) { kaesu right; }\n    moshi (left < right) { kaesu left; }\n    moshi (right < left) { kaesu right; }\n    moshi (__is_negative(left)) { kaesu left; }\n    kaesu right;\n}\n\nkoukai waza max<T: Number>(left: T, right: T) -> T {\n    moshi (left != left) { kaesu left; }\n    moshi (right != right) { kaesu right; }\n    moshi (left > right) { kaesu left; }\n    moshi (right > left) { kaesu right; }\n    moshi (__is_negative(left)) { kaesu right; }\n    kaesu left;\n}\n\nkoukai waza checked_abs<T: Signed>(value: T) -> T? {\n    moshi (__neg_overflows(value)) { kaesu mu; }\n    moshi (__is_negative(value)) { kaesu -value; }\n    kaesu value;\n}\n\nkoukai waza abs<T: Signed>(value: T) -> T {\n    kaku result: T? = checked_abs(value);\n    moshi (result != mu) { kaesu result; }\n    __math_error(\"kiso/math.abs: int64 overflow\");\n    kaesu value;\n}\n\nkoukai waza clamp<T: Number>(value: T, lower: T, upper: T) -> T {\n    moshi (lower > upper) {\n        __math_error(\"kiso/math.clamp: lower bound is greater than upper bound\");\n    }\n    kaesu min(max(value, lower), upper);\n}\n" }; }
waza data_67() -> File { kaesu File { path: "kiso/math/constants.mio", version: "Bunko-v2.1.1", length: 334, sha256: "e346e50367337bf9b32a3f4a2a814d05628945955302a3dae441c94b4b87dc02", source: "koukai teisu pi32: float32 = 3.14159265358979323846264338327950288419716939937510;\nkoukai teisu pi64: float64 = 3.14159265358979323846264338327950288419716939937510;\nkoukai teisu tau32: float32 = 6.28318530717958647692528676655900576839433879875021;\nkoukai teisu tau64: float64 = 6.28318530717958647692528676655900576839433879875021;\n" }; }
waza data_68() -> File { kaesu File { path: "kiso/math/fail.mio", version: "Bunko-v2.1.1", length: 230, sha256: "abaf8a60a2e150d5401bb30ce2c103c0a70e30bd2870e279e074ba3bb0cda888", source: "// Raise the existing checked runtime failure with a caller-supplied message.\n// Native tooling writes its structured diagnostic to stderr before this call.\nkoukai waza fail(message: string) -> unit {\n    __math_error(message);\n}\n" }; }
waza data_69() -> File { kaesu File { path: "kiso/math/float.mio", version: "Bunko-v2.1.1", length: 581, sha256: "e2e16c03416c7bea5e45a2deedea531afd05df6186a64fabeb40373fcfcdc5ab", source: "koukai waza sqrt<T: Float>(value: T) -> T { kaesu __sqrt(value); }\n\nkoukai waza floor<T: Float>(value: T) -> T { kaesu __floor(value); }\n\nkoukai waza ceil<T: Float>(value: T) -> T { kaesu __ceil(value); }\n\nkoukai waza round<T: Float>(value: T) -> T { kaesu __round_even(value); }\n\nkoukai waza trunc<T: Float>(value: T) -> T { kaesu __trunc(value); }\n\nkoukai waza is_nan<T: Float>(value: T) -> bool { kaesu __is_nan(value); }\n\nkoukai waza is_inf<T: Float>(value: T) -> bool { kaesu __is_inf(value); }\n\nkoukai waza is_finite<T: Float>(value: T) -> bool { kaesu __is_finite(value); }\n" }; }
waza data_70() -> File { kaesu File { path: "kiso/math/integer.mio", version: "Bunko-v2.1.1", length: 1408, sha256: "3e0b4bc2a8a3d6080d605e54c88fd03bc091feb410ff01d39358a28ef845e6bb", source: "koukai waza checked_gcd(left: int64, right: int64) -> int64? {\n    kaku a = left;\n    kaku b = right;\n    moshi (a > 0) { a = -a; }\n    moshi (b > 0) { b = -b; }\n    aida (b != 0) {\n        kaku remainder = a - (a / b) * b;\n        a = b;\n        b = remainder;\n    }\n    moshi (__neg_overflows(a)) { kaesu mu; }\n    kaesu -a;\n}\n\nkoukai waza gcd(left: int64, right: int64) -> int64 {\n    kaku result: int64? = checked_gcd(left, right);\n    moshi (result != mu) { kaesu result; }\n    __math_error(\"kiso/math.gcd: result does not fit int64\");\n    kaesu 0;\n}\n\nkoukai waza checked_lcm(left: int64, right: int64) -> int64? {\n    moshi (left == 0 || right == 0) { kaesu 0; }\n    kaku divisor: int64? = checked_gcd(left, right);\n    moshi (divisor != mu) {\n        kaku absolute_left: int64? = checked_abs(left);\n        moshi (absolute_left != mu) {\n            kaku absolute_right: int64? = checked_abs(right);\n            moshi (absolute_right != mu) {\n                kaku factor = absolute_left / divisor;\n                moshi (factor > 9223372036854775807 / absolute_right) { kaesu mu; }\n                kaesu factor * absolute_right;\n            }\n        }\n    }\n    kaesu mu;\n}\n\nkoukai waza lcm(left: int64, right: int64) -> int64 {\n    kaku result: int64? = checked_lcm(left, right);\n    moshi (result != mu) { kaesu result; }\n    __math_error(\"kiso/math.lcm: result does not fit int64\");\n    kaesu 0;\n}\n" }; }
waza data_71() -> File { kaesu File { path: "kiso/net/tcp/tcp.mio", version: "Bunko-v2.1.1", length: 8662, sha256: "d5c229b724571f3e4994a9f6ad5f3fb4ae2d9a81878c9b69f1d3cb17ec5c4e1d", source: "yobu \"kiso/array\";\nyobu \"kiso/io\";\nyobu \"mio/sys/socket\";\n\n// Blocking IPv4 TCP. Socket operations are primitive system calls; connection\n// policy, error translation, buffering and I/O adapters are written in Mio.\nkoukai sentaku TcpError {\n    InvalidArgument;\n    Closed;\n    TimedOut;\n    ConnectionRefused;\n    ConnectionReset;\n    AddressInUse;\n    PermissionDenied;\n    WouldBlock;\n    Other(string);\n}\n\nkoukai kata IPv4Address { octets: []uint8; port: int64; }\nkoukai kata Connection { handle: resource; }\nkoukai kata Listener { handle: resource; }\nkoukai kata ConnectionResult { connection: Connection?; error: TcpError?; }\nkoukai kata ListenerResult { listener: Listener?; error: TcpError?; }\nkoukai kata ReadResult { count: int64; eof: bool; error: TcpError?; }\nkoukai kata WriteResult { count: int64; error: TcpError?; }\nkoukai kata UnitResult { error: TcpError?; }\n\nkoukai waza ipv4(a: uint8, b: uint8, c: uint8, d: uint8, port: int64) -> IPv4Address {\n    kaesu IPv4Address { octets: [a, b, c, d], port: port };\n}\n\nwaza valid_address(address: IPv4Address) -> bool {\n    kaesu len(address.octets) == 4 && address.port >= 0 && address.port <= 65535;\n}\n\nwaza valid_range(values: []uint8, offset: int64, length: int64) -> bool {\n    kaesu offset >= 0 && length >= 0 && offset <= len(values) && length <= len(values) - offset;\n}\n\nwaza error_from(code: uint8, message: string) -> TcpError? {\n    moshi (code == uint8(0)) { kaesu mu; }\n    moshi (code == uint8(1)) { kaesu TcpError.InvalidArgument(); }\n    moshi (code == uint8(2)) { kaesu TcpError.Closed(); }\n    moshi (code == uint8(3)) { kaesu TcpError.TimedOut(); }\n    moshi (code == uint8(4)) { kaesu TcpError.ConnectionRefused(); }\n    moshi (code == uint8(5)) { kaesu TcpError.ConnectionReset(); }\n    moshi (code == uint8(6)) { kaesu TcpError.AddressInUse(); }\n    moshi (code == uint8(7)) { kaesu TcpError.PermissionDenied(); }\n    moshi (code == uint8(8)) { kaesu TcpError.WouldBlock(); }\n    kaesu TcpError.Other(message);\n}\n\nwaza decode_count(status: []uint8) -> int64 {\n    kaku result = 0;\n    kaku factor = 1;\n    kaku index = 0;\n    aida (index < 8) {\n        result = result + int64(status[index]) * factor;\n        index = index + 1;\n        moshi (index < 8) { factor = factor * 256; }\n    }\n    kaesu result;\n}\n\n// connect deliberately accepts only a literal IPv4 address; DNS and IPv6\n// will be separate pure-Mio layers, rather than hidden OS-dependent behavior.\nkoukai waza connect(address: IPv4Address) -> ConnectionResult {\n    moshi (!valid_address(address)) {\n        kaesu ConnectionResult { connection: mu, error: TcpError.InvalidArgument() };\n    }\n    kaku handle = socket.open();\n    kaku status: []uint8 = [0];\n    kaku message = socket.status(handle, status);\n    kaku failure = error_from(status[0], message);\n    moshi (failure == mu) {\n        message = socket.connect_ipv4(handle, address.octets, address.port, status);\n        failure = error_from(status[0], message);\n    }\n    moshi (failure != mu) {\n        socket.close(handle, status);\n        kaesu ConnectionResult { connection: mu, error: failure };\n    }\n    kaesu ConnectionResult { connection: Connection { handle: handle }, error: mu };\n}\n\nkoukai waza listen(address: IPv4Address) -> ListenerResult {\n    kaesu listen_with_backlog(address, 128);\n}\n\nkoukai waza listen_with_backlog(address: IPv4Address, backlog: int64) -> ListenerResult {\n    moshi (!valid_address(address) || backlog < 0 || backlog > 65535) {\n        kaesu ListenerResult { listener: mu, error: TcpError.InvalidArgument() };\n    }\n    kaku handle = socket.open();\n    kaku status: []uint8 = [0];\n    kaku message = socket.status(handle, status);\n    kaku failure = error_from(status[0], message);\n    moshi (failure == mu) {\n        message = socket.bind_ipv4(handle, address.octets, address.port, status);\n        failure = error_from(status[0], message);\n    }\n    moshi (failure == mu) {\n        message = socket.listen(handle, backlog, status);\n        failure = error_from(status[0], message);\n    }\n    moshi (failure != mu) {\n        socket.close(handle, status);\n        kaesu ListenerResult { listener: mu, error: failure };\n    }\n    kaesu ListenerResult { listener: Listener { handle: handle }, error: mu };\n}\n\nkoukai waza accept(listener: Listener) -> ConnectionResult {\n    kaku handle = socket.accept(listener.handle);\n    kaku status: []uint8 = [0];\n    kaku message = socket.status(handle, status);\n    kaku failure = error_from(status[0], message);\n    moshi (failure != mu) {\n        socket.close(handle, status);\n        kaesu ConnectionResult { connection: mu, error: failure };\n    }\n    kaesu ConnectionResult { connection: Connection { handle: handle }, error: mu };\n}\n\nkoukai waza read(connection: Connection, destination: []uint8, offset: int64, length: int64) -> ReadResult {\n    moshi (!valid_range(destination, offset, length)) {\n        kaesu ReadResult { count: 0, eof: iie, error: TcpError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = socket.read(connection.handle, destination, offset, length, status);\n    kaesu ReadResult { count: decode_count(status), eof: status[8] != uint8(0), error: error_from(status[9], message) };\n}\n\nkoukai waza write(connection: Connection, source: []uint8, offset: int64, length: int64) -> WriteResult {\n    moshi (!valid_range(source, offset, length)) {\n        kaesu WriteResult { count: 0, error: TcpError.InvalidArgument() };\n    }\n    kaku status = array.make[uint8](10, uint8(0));\n    kaku message = socket.write(connection.handle, source, offset, length, status);\n    kaesu WriteResult { count: decode_count(status), error: error_from(status[9], message) };\n}\n\n// TCP writes may be partial. This helper retains progress when a later call\n// fails, and never loops forever after a zero-byte write.\nkoukai waza write_all(connection: Connection, source: []uint8, offset: int64, length: int64) -> WriteResult {\n    moshi (!valid_range(source, offset, length)) {\n        kaesu WriteResult { count: 0, error: TcpError.InvalidArgument() };\n    }\n    kaku total = 0;\n    aida (total < length) {\n        kaku result = write(connection, source, offset + total, length - total);\n        moshi (result.count < 0 || result.count > length - total) {\n            kaesu WriteResult { count: total, error: TcpError.InvalidArgument() };\n        }\n        total = total + result.count;\n        kaku failure = result.error;\n        moshi (failure != mu) { kaesu WriteResult { count: total, error: failure }; }\n        moshi (result.count == 0) {\n            kaesu WriteResult { count: total, error: TcpError.Other(\"write made no progress\") };\n        }\n    }\n    kaesu WriteResult { count: total, error: mu };\n}\n\nkoukai waza close(connection: Connection) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = socket.close(connection.handle, status);\n    kaesu UnitResult { error: error_from(status[0], message) };\n}\n\nkoukai waza close_listener(listener: Listener) -> UnitResult {\n    kaku status: []uint8 = [0];\n    kaku message = socket.close(listener.handle, status);\n    kaesu UnitResult { error: error_from(status[0], message) };\n}\n\nwaza io_error(failure: TcpError?) -> io.IoError? {\n    moshi (failure == mu) { kaesu mu; }\n    awase (failure) {\n        baai InvalidArgument { kaesu io.IoError.InvalidArgument(); }\n        baai Closed { kaesu io.IoError.Closed(); }\n        baai TimedOut { kaesu io.IoError.Other(\"TCP timed out\"); }\n        baai ConnectionRefused { kaesu io.IoError.Other(\"TCP connection refused\"); }\n        baai ConnectionReset { kaesu io.IoError.Other(\"TCP connection reset\"); }\n        baai AddressInUse { kaesu io.IoError.Other(\"TCP address in use\"); }\n        baai PermissionDenied { kaesu io.IoError.Other(\"TCP permission denied\"); }\n        baai WouldBlock { kaesu io.IoError.Other(\"TCP would block\"); }\n        baai Other(message) { kaesu io.IoError.Other(message); }\n    }\n    kaesu io.IoError.Other(\"unknown TCP error\");\n}\n\nkoukai waza reader(connection: Connection) -> io.Reader {\n    kaesu io.Reader { read: waza (destination: []uint8, offset: int64, length: int64) -> io.ReadResult {\n        kaku result = read(connection, destination, offset, length);\n        kaesu io.ReadResult { count: result.count, eof: result.eof, error: io_error(result.error) };\n    } };\n}\n\nkoukai waza writer(connection: Connection) -> io.Writer {\n    kaesu io.Writer { write: waza (source: []uint8, offset: int64, length: int64) -> io.WriteResult {\n        kaku result = write(connection, source, offset, length);\n        kaesu io.WriteResult { count: result.count, error: io_error(result.error) };\n    } };\n}\n" }; }
waza data_72() -> File { kaesu File { path: "kiso/os/os.mio", version: "Bunko-v2.1.1", length: 3751, sha256: "f97707105370d6dea2b23c9f8ebcc4039bbdff201fd534ab120115b1b65a8ad3", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\nyobu \"kiso/math\";\nyobu \"mio/os/runtime\";\n\nkoukai waza argument(index: int64) -> string? {\n    kaku size = runtime.arg_size(index);\n    moshi (size < 0) { kaesu mu; }\n    kaku bytes = array.make[uint8](size, uint8(0));\n    moshi (runtime.arg_copy(index, bytes) != size) { kaesu mu; }\n    kaesu string.from_utf8(bytes);\n}\nkoukai waza arguments() -> []string {\n    kaku result: []string = []; kaku count = runtime.argc(); kaku index = 0;\n    aida (index < count) {\n        kaku value = argument(index); moshi (value == mu) { math.fail(\"invalid OS argument encoding\"); kaesu []; }\n        array.push(result, value); index = index + 1;\n    }\n    kaesu result;\n}\nkoukai waza chmod(path: string, mode: int64) -> int64 { kaesu runtime.chmod(path, mode); }\nkoukai waza exit(status: int64) -> unit { runtime.exit(status); }\n\n// Arguments include argv[0], matching the OS ABI. Negative values report a\n// system errno; spawned child exits and signals become shell-compatible codes.\nkoukai waza spawn(path: string, arguments: []string) -> int64 { kaesu runtime.spawn(path, arguments); }\nkoukai waza exec(path: string, arguments: []string) -> int64 { kaesu runtime.exec(path, arguments); }\nkoukai waza pid() -> int64 { kaesu runtime.pid(); }\nkoukai waza remove(path: string) -> int64 { kaesu runtime.remove(path); }\n\nkoukai waza remove_dir(path: string) -> int64 { kaesu runtime.rmdir(path); }\n\n// Test-only child isolation: capture stdout, stderr and assertion packets into\n// private files; the positive CPU and wall budgets terminate only the child process.\nkoukai waza spawn_test(path: string, arguments: []string, stdout: string, stderr: string, records: string, cpu_seconds: int64) -> int64 {\n    kaesu runtime.spawn_test(path, arguments, stdout, stderr, records, cpu_seconds);\n}\n\n// Milliseconds from the OS-accessible ARM64 virtual counter; not wall time.\nkoukai waza monotonic_ms() -> int64 { kaesu runtime.monotonic_ms(); }\n\n// Missing, malformed or non-UTF8 environment values return mu; an existing\n// empty value remains an empty string. No ambient compiler/Bunko path fallback.\nkoukai waza environment(name: string) -> string? {\n    kaku size=runtime.env_size(name);moshi(size<0){kaesu mu;}\n    kaku bytes=array.make[uint8](size,uint8(0));moshi(runtime.env_copy(name,bytes)!=size){kaesu mu;}kaesu string.from_utf8(bytes);\n}\nkoukai waza getenv(name: string) -> string { kaku value=environment(name);moshi(value==mu){kaesu \"\";}kaesu value; }\n\n// Nonblocking stdin readiness: positive for data/EOF, zero while idle, negative errno.\nkoukai waza stdin_ready() -> int64 { kaesu runtime.stdin_ready(); }\n\n// Millisecond timeout, or -1 to wait without a deadline. Other negative values\n// and values above INT32_MAX return -EINVAL without blocking.\nkoukai waza stdin_wait(timeout_ms: int64) -> int64 { kaesu runtime.stdin_wait(timeout_ms); }\n\n// Physical absolute identity for existing paths. Unresolvable/non-UTF8 paths\n// return mu; callers retain memory-only source identities separately.\nkoukai waza canonical_path(path: string) -> string? {\n    moshi(path==\"\"){kaesu mu;}\n    kaku bytes=array.make[uint8](1024,uint8(0));kaku size=runtime.real_path(path,bytes);\n    moshi(size<0 || size>=len(bytes)){kaesu mu;}array.truncate(bytes,size);kaesu string.from_utf8(bytes);\n}\n\n// The empty real_path request is reserved for the OS image identity. This keeps\n// the RA-1 calling convention and existing native binding signature unchanged.\nkoukai waza executable_path() -> string? {\n    kaku bytes=array.make[uint8](4096,uint8(0));kaku size=runtime.real_path(\"\",bytes);\n    moshi(size<=0 || size>=len(bytes)){kaesu mu;}moshi(bytes[size-1]==uint8(0)){size=size-1;}array.truncate(bytes,size);kaesu string.from_utf8(bytes);\n}\n" }; }
waza data_73() -> File { kaesu File { path: "kiso/path/path.mio", version: "Bunko-v2.1.1", length: 4395, sha256: "92306d1fa6f0fa6f7d5180e93e0e27313ce18f4cdacf05201aa9cd07a3dc66bd", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\n\nkoukai kata SplitResult { dir: string; base: string; }\n\nwaza bytes_to_string(data: []uint8) -> string {\n    kaku result = string.from_utf8(data);\n    moshi (result != mu) { kaesu result; }\n    kaesu \"\";\n}\n\nwaza byte_range(data: []uint8, start: int64, end: int64) -> string {\n    kaku output = array.with_capacity[uint8](end - start);\n    kaku index = start;\n    aida (index < end) {\n        array.push(output, data[index]);\n        index = index + 1;\n    }\n    kaesu bytes_to_string(output);\n}\n\nwaza push_segment(segments: []string, data: []uint8, start: int64, end: int64, absolute: bool) -> unit {\n    moshi (end == start) { kaesu; }\n    kaku segment = byte_range(data, start, end);\n    moshi (segment == \".\") { kaesu; }\n    moshi (segment == \"..\") {\n        moshi (len(segments) > 0 && segments[len(segments) - 1] != \"..\") {\n            array.truncate(segments, len(segments) - 1);\n            kaesu;\n        }\n        moshi (!absolute) { array.push(segments, segment); }\n        kaesu;\n    }\n    array.push(segments, segment);\n}\n\nkoukai waza clean(value: string) -> string {\n    kaku data = string.to_bytes(value);\n    kaku absolute = len(data) > 0 && data[0] == uint8(47);\n    kaku segments = array.with_capacity[string](8);\n    kaku start = 0;\n    kaku index = 0;\n    aida (index <= len(data)) {\n        moshi (index == len(data) || data[index] == uint8(47)) {\n            push_segment(segments, data, start, index, absolute);\n            start = index + 1;\n        }\n        index = index + 1;\n    }\n    moshi (len(segments) == 0) {\n        moshi (absolute) { kaesu \"/\"; }\n        kaesu \".\";\n    }\n    kaku builder = string.new_builder();\n    moshi (absolute) { string.write_string(builder, \"/\"); }\n    index = 0;\n    aida (index < len(segments)) {\n        moshi (index > 0) { string.write_string(builder, \"/\"); }\n        string.write_string(builder, segments[index]);\n        index = index + 1;\n    }\n    kaesu string.builder_string(builder);\n}\n\nkoukai waza join(left: string, right: string) -> string {\n    moshi (left == \"\") { kaesu clean(right); }\n    moshi (right == \"\") { kaesu clean(left); }\n    kaku builder = string.builder_with_capacity(string.byte_len(left) + string.byte_len(right) + 1);\n    string.write_string(builder, left);\n    string.write_string(builder, \"/\");\n    string.write_string(builder, right);\n    kaesu clean(string.builder_string(builder));\n}\n\nkoukai waza join_all(parts: []string) -> string {\n    kaku capacity = 0;\n    kaku index = 0;\n    aida (index < len(parts)) {\n        capacity = capacity + string.byte_len(parts[index]) + 1;\n        index = index + 1;\n    }\n    kaku builder = string.builder_with_capacity(capacity);\n    index = 0;\n    aida (index < len(parts)) {\n        moshi (index > 0) { string.write_string(builder, \"/\"); }\n        string.write_string(builder, parts[index]);\n        index = index + 1;\n    }\n    kaesu clean(string.builder_string(builder));\n}\n\nkoukai waza is_abs(value: string) -> bool {\n    kaku data = string.to_bytes(value);\n    kaesu len(data) > 0 && data[0] == uint8(47);\n}\n\nkoukai waza base(value: string) -> string {\n    kaku normalized = clean(value);\n    moshi (normalized == \"/\" || normalized == \".\" || normalized == \"..\") { kaesu normalized; }\n    kaku data = string.to_bytes(normalized);\n    kaku index = len(data) - 1;\n    aida (index >= 0) {\n        moshi (data[index] == uint8(47)) { kaesu byte_range(data, index + 1, len(data)); }\n        index = index - 1;\n    }\n    kaesu normalized;\n}\n\nkoukai waza dir(value: string) -> string {\n    kaku normalized = clean(value);\n    moshi (normalized == \"/\") { kaesu \"/\"; }\n    kaku data = string.to_bytes(normalized);\n    kaku index = len(data) - 1;\n    aida (index >= 0) {\n        moshi (data[index] == uint8(47)) {\n            moshi (index == 0) { kaesu \"/\"; }\n            kaesu byte_range(data, 0, index);\n        }\n        index = index - 1;\n    }\n    kaesu \".\";\n}\n\nkoukai waza ext(value: string) -> string {\n    kaku name = base(value);\n    kaku data = string.to_bytes(name);\n    kaku index = len(data) - 1;\n    aida (index > 0) {\n        moshi (data[index] == uint8(46)) { kaesu byte_range(data, index, len(data)); }\n        index = index - 1;\n    }\n    kaesu \"\";\n}\n\nkoukai waza split(value: string) -> SplitResult {\n    kaku normalized = clean(value);\n    kaesu SplitResult { dir: dir(normalized), base: base(normalized) };\n}\n" }; }
waza data_74() -> File { kaesu File { path: "kiso/regexp/regexp.mio", version: "Bunko-v2.1.1", length: 27662, sha256: "4c66cfb48e7d7343322ddaede749acaf598732ecfa786c4bf0ed7e49bbc9d37c", source: "yobu \"kiso/array\";\nyobu \"kiso/string\";\nyobu \"kiso/utf8\";\nyobu \"kiso/regexp/unicode_data\";\n\n// Thompson NFA boolean matching; no backtracking interpreter or host regex.\n// Unicode 15 properties and simple folding use generated Mio range tables.\nkoukai kata State { op: int64; out: int64; other: int64; ranges: []int64; }\nkoukai kata Program { states: []State; start: int64; error: string; }\nkata Node { op: int64; a: int64; b: int64; low: int64; high: int64; ranges: []int64; }\nkata Parser { input: []int64; at: []int64; flags: []int64; quoted: []bool; nodes: []Node; heights: []int64; folds: []int64; error: []string; }\nkata Term { ranges: []int64; scalar: int64; }\nkata Fragment { start: int64; ends: []int64; }\nkata Count { valid: bool; low: int64; high: int64; end: int64; }\nkata Frame { items: []int64; alternatives: []int64; flags: int64; capture: bool; }\n\nwaza runes(text: string) -> []int64 {\n    kaku bytes = string.to_bytes(text); kaku output: []int64 = []; kaku at = 0;\n    aida (at < len(bytes)) { kaku decoded = utf8.decode_one(bytes, at); moshi (!decoded.valid) { kaesu []; } array.push(output, int64(decoded.value)); at = at + decoded.width; }\n    kaesu output;\n}\nwaza current(p: Parser) -> int64 { moshi (p.at[0] >= len(p.input)) { kaesu -1; } kaesu p.input[p.at[0]]; }\nwaza look(p: Parser, distance: int64) -> int64 { moshi (p.at[0] + distance >= len(p.input)) { kaesu -1; } kaesu p.input[p.at[0] + distance]; }\nwaza fail(p: Parser, error: string) -> unit { moshi (p.error[0] == \"\") { p.error[0] = error; } }\nwaza flag(flags: int64, power: int64) -> bool { kaku value = flags / power; kaesu value - (value / 2) * 2 == 1; }\nwaza quotes(p: Parser) -> unit {\n    kaku changed = hai;\n    aida (changed) {\n        changed = iie;\n        moshi (current(p) == 92 && ((!p.quoted[0] && look(p, 1) == 81) || (p.quoted[0] && look(p, 1) == 69))) {\n            p.quoted[0] = !p.quoted[0]; p.at[0] = p.at[0] + 2; changed = hai;\n        }\n    }\n}\nwaza node(p: Parser, op: int64, a: int64, b: int64, low: int64, high: int64, ranges: []int64) -> int64 {\n    moshi (len(p.nodes) >= 3355443) { fail(p, \"regexp syntax size limit\"); kaesu -1; }\n    kaku height = 1;\n    moshi ((op == 11 || op == 12 || op == 13 || op == 14) && a >= 0) { height = p.heights[a] + 1; }\n    moshi ((op == 11 || op == 12) && b >= 0) { moshi (height < p.heights[b] + 1) { height = p.heights[b] + 1; } }\n    moshi (height > 1000) { fail(p, \"regexp tree nesting limit\"); kaesu -1; }\n    array.push(p.heights, height);\n    kaku id = len(p.nodes); array.push(p.nodes, Node { op: op, a: a, b: b, low: low, high: high, ranges: ranges }); kaesu id;\n}\nwaza clean(ranges: []int64) -> []int64 {\n    kaku sorted: []int64 = []; kaku at = 0;\n    aida (at < len(ranges)) {\n        kaku low = ranges[at]; kaku high = ranges[at + 1]; array.push(sorted, low); array.push(sorted, high); kaku i = len(sorted) - 2;\n        aida (i > 0 && sorted[i] < sorted[i - 2]) { kaku a = sorted[i - 2]; kaku b = sorted[i - 1]; sorted[i - 2] = sorted[i]; sorted[i - 1] = sorted[i + 1]; sorted[i] = a; sorted[i + 1] = b; i = i - 2; }\n        at = at + 2;\n    }\n    kaku result: []int64 = []; at = 0;\n    aida (at < len(sorted)) {\n        moshi (len(result) > 0 && sorted[at] <= result[len(result) - 1] + 1) { moshi (sorted[at + 1] > result[len(result) - 1]) { result[len(result) - 1] = sorted[at + 1]; } }\n        sore { array.push(result, sorted[at]); array.push(result, sorted[at + 1]); }\n        at = at + 2;\n    }\n    kaesu result;\n}\nwaza contains(ranges: []int64, value: int64) -> bool {\n    kaku low = 0; kaku high = len(ranges) / 2;\n    aida (low < high) { kaku mid = low + (high - low) / 2; moshi (value < ranges[mid * 2]) { high = mid; } sore { moshi (value > ranges[mid * 2 + 1]) { low = mid + 1; } sore { kaesu hai; } } } kaesu iie;\n}\nwaza invert(ranges: []int64) -> []int64 {\n    kaku ordered = clean(ranges); kaku output: []int64 = []; kaku next = 0; kaku at = 0;\n    aida (at < len(ordered)) { moshi (next < ordered[at]) { array.push(output, next); array.push(output, ordered[at] - 1); } next = ordered[at + 1] + 1; at = at + 2; }\n    moshi (next <= 1114111) { array.push(output, next); array.push(output, 1114111); } kaesu output;\n}\nwaza folded(p: Parser, ranges: []int64) -> []int64 {\n    moshi (!flag(p.flags[0], 1)) { kaesu ranges; }\n    moshi (len(p.folds) == 0) { array.append_all(p.folds, unicode_data.lookup(\"fold\")); }\n    kaku result = clean(ranges); kaku pass = 0; kaku changed = hai;\n    aida (changed && pass < 4) {\n        changed = iie; kaku next = array.clone(result); kaku at = 0;\n        aida (at < len(p.folds)) {\n            moshi (contains(result, p.folds[at]) && !contains(result, p.folds[at + 1])) { array.push(next, p.folds[at + 1]); array.push(next, p.folds[at + 1]); changed = hai; } at = at + 2;\n        }\n        result = clean(next); pass = pass + 1;\n    }\n    kaesu result;\n}\nwaza unicode_name(value: []int64) -> string {\n    kaku bytes: []uint8 = []; kaku at = 0;\n    aida (at < len(value)) { kaku byte = value[at];\n        moshi (byte != 95 && byte != 45 && byte != 32) { moshi (byte >= 65 && byte <= 90) { byte = byte + 32; } moshi (byte < 0 || byte > 127) { kaesu \"\"; } array.push(bytes, uint8(byte)); } at = at + 1;\n    }\n    kaku decoded = string.from_utf8(bytes); moshi (decoded == mu) { kaesu \"\"; } kaesu decoded;\n}\nwaza unicode_class(p: Parser, negative: bool) -> Term {\n    kaku name: []int64 = []; kaku inverse = negative;\n    moshi (current(p) == 123) {\n        p.at[0] = p.at[0] + 1;\n        moshi (current(p) == 94) { inverse = !inverse; p.at[0] = p.at[0] + 1; }\n        aida (current(p) >= 0 && current(p) != 125) { array.push(name, current(p)); p.at[0] = p.at[0] + 1; }\n        moshi (current(p) != 125) { fail(p, \"unterminated Unicode class\"); } sore { p.at[0] = p.at[0] + 1; }\n    } sore { moshi (current(p) >= 0) { array.push(name, current(p)); p.at[0] = p.at[0] + 1; } }\n    kaku key = unicode_name(name); kaku ranges: []int64 = [];\n    moshi (key == \"any\") { ranges = [0,1114111]; }\n    sore { moshi (key == \"ascii\") { ranges = [0,127]; }\n    sore {\n        moshi (key == \"assigned\") { key = \"cn\"; inverse = !inverse; }\n        kaku triples = unicode_data.lookup(key);\n        moshi (len(triples) == 0) { fail(p, \"invalid Unicode character class\"); kaesu Term { ranges: [], scalar: -1 }; }\n        kaku at = 0;\n        aida (at < len(triples)) {\n            kaku low = triples[at]; kaku high = triples[at + 1]; kaku stride = triples[at + 2];\n            moshi (stride == 1) { array.push(ranges, low); array.push(ranges, high); }\n            sore { aida (low <= high) { array.push(ranges, low); array.push(ranges, low); low = low + stride; } }\n            at = at + 3;\n        }\n    } }\n    ranges = folded(p, ranges); moshi (inverse) { ranges = invert(ranges); }\n    kaesu Term { ranges: ranges, scalar: -1 };\n}\nwaza ascii(name: string) -> []int64 {\n    moshi (name == \"alnum\") { kaesu [48,57,65,90,97,122]; }\n    moshi (name == \"alpha\") { kaesu [65,90,97,122]; }\n    moshi (name == \"ascii\") { kaesu [0,127]; }\n    moshi (name == \"blank\") { kaesu [9,9,32,32]; }\n    moshi (name == \"cntrl\") { kaesu [0,31,127,127]; }\n    moshi (name == \"digit\") { kaesu [48,57]; }\n    moshi (name == \"graph\") { kaesu [33,126]; }\n    moshi (name == \"lower\") { kaesu [97,122]; }\n    moshi (name == \"print\") { kaesu [32,126]; }\n    moshi (name == \"punct\") { kaesu [33,47,58,64,91,96,123,126]; }\n    moshi (name == \"space\") { kaesu [9,13,32,32]; }\n    moshi (name == \"upper\") { kaesu [65,90]; }\n    moshi (name == \"word\") { kaesu [48,57,65,90,95,95,97,122]; }\n    moshi (name == \"xdigit\") { kaesu [48,57,65,70,97,102]; } kaesu [];\n}\nwaza is_digit(value: int64) -> bool { kaesu value >= 48 && value <= 57; }\nwaza hex(value: int64) -> int64 {\n    moshi (is_digit(value)) { kaesu value - 48; } moshi (value >= 65 && value <= 70) { kaesu value - 55; } moshi (value >= 97 && value <= 102) { kaesu value - 87; } kaesu -1;\n}\nwaza escaped(p: Parser) -> Term {\n    p.at[0] = p.at[0] + 1; kaku value = current(p); p.at[0] = p.at[0] + 1;\n    kaku name = \"\"; kaku negative = iie;\n    moshi (value == 100 || value == 68) { name = \"digit\"; negative = value == 68; }\n    moshi (value == 119 || value == 87) { name = \"word\"; negative = value == 87; }\n    moshi (value == 115 || value == 83) { name = \"space\"; negative = value == 83; }\n    moshi (name != \"\") {\n        kaku ranges = ascii(name); moshi (name == \"space\") { ranges = [9,10,12,13,32,32]; } ranges = folded(p, ranges); moshi (negative) { ranges = invert(ranges); }\n        kaesu Term { ranges: ranges, scalar: -1 };\n    }\n    moshi (value == 112 || value == 80) { kaesu unicode_class(p, value == 80); }\n    moshi (value == 97) { value = 7; }\n    sore { moshi (value == 102) { value = 12; }\n    sore { moshi (value == 110) { value = 10; }\n    sore { moshi (value == 114) { value = 13; }\n    sore { moshi (value == 116) { value = 9; }\n    sore { moshi (value == 118) { value = 11; }\n    sore { moshi (value >= 48 && value <= 55) {\n        moshi (value != 48 && (current(p) < 48 || current(p) > 55)) { fail(p, \"backreferences are not supported\"); }\n        value = value - 48; kaku at = 1;\n        aida (at < 3 && current(p) >= 48 && current(p) <= 55) { value = value * 8 + current(p) - 48; p.at[0] = p.at[0] + 1; at = at + 1; }\n    }\n    sore { moshi (value == 120) {\n        value = 0; kaku count = 0; kaku braced = current(p) == 123; moshi (braced) { p.at[0] = p.at[0] + 1; }\n        aida (hex(current(p)) >= 0 && (braced || count < 2)) {\n            value = value * 16 + hex(current(p)); p.at[0] = p.at[0] + 1; count = count + 1;\n            mos