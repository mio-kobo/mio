waza data_10() -> File { kaesu File { path: "kiso/aot/lower/observation.mio", version: "Bunko-GF3-v0.2", length: 10491, sha256: "c359c0ab678108c1d4e05cb9827ecf2a13d657a320386744176f67305352b772", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/string\";\nyobu \"kiso/convert\";\n\n// Observation metadata is outside the managed arena. M19b reserves 3072\n// bytes in both modes, including generation state and separate pause histograms.\n// All values are uint64 native words; no GC path allocates or writes stderr.\n// 288 objects, 296 physical allocation bytes, 304 occupied bytes, 312 peak,\n// 320 start counter, 328 last pause, 336 total pause, 344 max pause, 352 Hz,\n// 360..871 histogram, 872 before, 880 after, 888 cumulative reclaimed,\n// 896 current collection start. The runtime is currently single-threaded.\nteisu observation_metadata_bytes = 3072;\n\nwaza observation_word(code: arm64.Assembler, word: int64) -> unit {\n    emit(code, arm64.Instruction { word: uint32(word), error: mu });\n}\n\nwaza emit_observation_init(code: arm64.Assembler) -> unit {\n    observation_word(code, 3577471049); // MRS x9, CNTVCT_EL0 (0xd53be049)\n    emit(code, arm64.str_x(9, 23, 320));\n    observation_word(code, 3577470985); // MRS x9, CNTFRQ_EL0\n    emit(code, arm64.str_x(9, 23, 352));\n}\n\nwaza emit_observation_alloc(code: arm64.Assembler) -> unit {\n    arm64.assembler_cbz_x(code, 0, \"observation_alloc_done\");\n    // Read the actual block span: a reused block can contain unsplit padding.\n    emit(code, arm64.sub_imm_x(9, 0, 16, iie)); emit(code, arm64.ldr_x(9, 9, 8));\n    emit(code, arm64.add_imm_x(9, 9, 31, iie)); emit(code, arm64.movn_x(10, 15, 0)); emit(code, arm64.and_x(9, 9, 10));\n    emit(code, arm64.ldr_x(10, 23, 288)); emit(code, arm64.add_imm_x(10, 10, 1, iie)); emit(code, arm64.str_x(10, 23, 288));\n    emit(code, arm64.ldr_x(10, 23, 296)); emit(code, arm64.add_x(10, 10, 9)); emit(code, arm64.str_x(10, 23, 296));\n    emit(code, arm64.ldr_x(10, 23, 304)); emit(code, arm64.add_x(10, 10, 9)); emit(code, arm64.str_x(10, 23, 304));\n    emit(code, arm64.ldr_x(9, 23, 312)); emit(code, arm64.cmp_x(10, 9)); arm64.assembler_b_cond(code, 9, \"observation_alloc_done\");\n    emit(code, arm64.str_x(10, 23, 312));\n    arm64.assembler_label(code, \"observation_alloc_done\");\n}\n\nwaza emit_observation_gc_start(code: arm64.Assembler) -> unit {\n    emit(code, arm64.stp_pre_x(25, 26, 31, -16));\n    observation_word(code, 3577471049);\n    emit(code, arm64.str_x(9, 23, 896));\n    emit(code, arm64.ldr_x(9, 23, 304)); emit(code, arm64.str_x(9, 23, 872));\n    emit(code, arm64.movz_x(25, 0, 0));\n}\n\nwaza emit_observation_gc_end(code: arm64.Assembler) -> unit {\n    observation_word(code, 3577471049);\n    emit(code, arm64.ldr_x(10, 23, 896)); emit(code, arm64.sub_x(9, 9, 10));\n    emit(code, arm64.ldr_x(10, 23, gen_MajorTicks)); emit(code, arm64.add_x(10, 10, 9)); emit(code, arm64.str_x(10, 23, gen_MajorTicks));\n    emit(code, arm64.ldr_x(10, 23, gen_MajorMax)); emit(code, arm64.cmp_x(9, 10)); arm64.assembler_b_cond(code, 9, \"gen_major_kindmax\");\n    emit(code, arm64.str_x(9, 23, gen_MajorMax)); arm64.assembler_label(code, \"gen_major_kindmax\");\n    emit(code, arm64.str_x(9, 23, 328));\n    emit(code, arm64.ldr_x(10, 23, 336)); emit(code, arm64.add_x(10, 10, 9)); emit(code, arm64.str_x(10, 23, 336));\n    emit(code, arm64.ldr_x(10, 23, 344)); emit(code, arm64.cmp_x(9, 10)); arm64.assembler_b_cond(code, 9, \"observation_gc_max_done\");\n    emit(code, arm64.str_x(9, 23, 344));\n    arm64.assembler_label(code, \"observation_gc_max_done\");\n    // Bucket i has inclusive upper bound 2^i ticks. Bucket 63 also holds\n    // overflow. Zero and one tick use bucket 0; no samples are dropped.\n    emit(code, arm64.movz_x(11, 0, 0)); arm64.assembler_cbz_x(code, 9, \"observation_gc_bucket_done\");\n    emit(code, arm64.sub_imm_x(10, 9, 1, iie));\n    arm64.assembler_label(code, \"observation_gc_bucket\");\n    arm64.assembler_cbz_x(code, 10, \"observation_gc_bucket_done\");\n    emit(code, arm64.cmp_imm_x(11, 63, iie)); arm64.assembler_b_cond(code, 0, \"observation_gc_bucket_done\");\n    emit(code, arm64.lsr_x(10, 10, 1)); emit(code, arm64.add_imm_x(11, 11, 1, iie)); arm64.assembler_b(code, \"observation_gc_bucket\");\n    arm64.assembler_label(code, \"observation_gc_bucket_done\");\n    emit(code, arm64.lsl_x(11, 11, 3)); emit(code, arm64.add_x(11, 23, 11));\n    emit(code, arm64.ldr_x(10, 11, 360)); emit(code, arm64.add_imm_x(10, 10, 1, iie)); emit(code, arm64.str_x(10, 11, 360));\n    emit(code, arm64.ldr_x(10, 11, 2048)); emit(code, arm64.add_imm_x(10, 10, 1, iie)); emit(code, arm64.str_x(10, 11, 2048));\n    emit(code, arm64.str_x(25, 23, 304)); emit(code, arm64.str_x(25, 23, 880));\n    emit(code, arm64.ldr_x(9, 23, 872)); emit(code, arm64.sub_x(9, 9, 25));\n    emit(code, arm64.ldr_x(10, 23, 888)); emit(code, arm64.add_x(10, 10, 9)); emit(code, arm64.str_x(10, 23, 888));\n    emit(code, arm64.ldp_post_x(25, 26, 31, 16));\n}\n\n// Emit a compile-time ASCII prefix, then print x0 as an unsigned integer.\n// Runtime output only happens on exit, after the measured GC has returned.\nwaza emit_observation_metric(code: arm64.Assembler, name: string, offset: int64) -> unit {\n    kaku prefix = string.to_bytes(string.concat(string.concat(\"mio-gc \", name), \"=\"));\n    kaku bytes = ((len(prefix) + 15) / 16) * 16;\n    emit(code, arm64.sub_imm_x(31, 31, bytes, iie));\n    kaku i = 0;\n    aida (i < len(prefix)) {\n        emit(code, arm64.movz_w(9, int64(prefix[i]))); emit(code, arm64.strb_w(9, 31, i)); i = i + 1;\n    }\n    emit(code, arm64.movz_x(0, 2, 0)); emit(code, arm64.add_imm_x(1, 31, 0, iie));\n    emit(code, arm64.movz_x(2, len(prefix), 0)); emit(code, arm64.movz_x(16, 4, 0)); emit(code, arm64.svc(128));\n    emit(code, arm64.add_imm_x(31, 31, bytes, iie));\n    emit(code, arm64.ldr_x(0, 23, offset)); arm64.assembler_bl(code, \"observation_print_uint\");\n}\n\nwaza emit_observation_runtime(code: arm64.Assembler, metadata_bytes: int64) -> unit {\n    arm64.assembler_label(code, \"observation_dump\");\n    emit(code, arm64.stp_pre_x(29, 30, 31, -16));\n    arm64.assembler_cbz_x(code, 23, \"observation_dump_done\");\n    observation_word(code, 3577471049);\n    emit(code, arm64.ldr_x(10, 23, 320)); emit(code, arm64.sub_x(9, 9, 10)); emit(code, arm64.str_x(9, 23, 912));\n    emit(code, arm64.ldr_x(9, 23, 8)); emit(code, arm64.add_imm_x(10, 23, metadata_bytes, iie));\n    emit(code, arm64.sub_x(9, 9, 10)); emit(code, arm64.str_x(9, 23, 904));\n    emit(code, arm64.ldr_x(9, 23, 0)); emit(code, arm64.sub_x(9, 9, 10)); emit(code, arm64.str_x(9, 23, 920));\n    emit_observation_metric(code,\"oom_request_bytes\",2816);\n    emit_observation_metric(code,\"pressure_transitions\",2808);\n    emit_observation_metric(code,\"heap_goal\",memory_Goal); emit_observation_metric(code,\"heap_limit\",memory_Limit); emit_observation_metric(code,\"heap_committed\",memory_Committed); emit_observation_metric(code,\"heap_reserved\",memory_Reserved); emit_observation_metric(code,\"pressure_level\",memory_Level); emit_observation_metric(code,\"pressure_reason\",memory_Reason); emit_observation_metric(code,\"pressure_sequence\",memory_Sequence); emit_observation_metric(code,\"allocation_rate\",memory_Rate); emit_observation_metric(code,\"system_pressure_available\",2752);\n    emit_observation_metric(code,\"los_live_bytes\",los_Bytes); emit_observation_metric(code,\"los_objects\",los_Count); emit_observation_metric(code,\"los_reclaimed_bytes\",los_Reclaimed);\n    emit_observation_metric(code, \"heap_capacity\", 904);\n    emit_observation_metric(code, \"heap_cursor\", 920);\n    emit_observation_metric(code, \"heap_live_bytes\", 304);\n    emit_observation_metric(code, \"heap_peak_live_bytes\", 312);\n    emit_observation_metric(code, \"allocated_objects\", 288);\n    emit_observation_metric(code, \"allocated_bytes\", 296);\n    emit_observation_metric(code, \"gc_count\", 16);\n    emit_observation_metric(code, \"gc_before_bytes\", 872);\n    emit_observation_metric(code, \"gc_after_bytes\", 880);\n    emit_observation_metric(code, \"gc_total_reclaimed_bytes\", 888);\n    emit_observation_metric(code, \"gc_last_ticks\", 328);\n    emit_observation_metric(code, \"gc_total_ticks\", 336);\n    emit_observation_metric(code, \"gc_max_ticks\", 344);\n    emit_observation_metric(code, \"timer_frequency_hz\", 352);\n    emit_observation_metric(code, \"runtime_ticks\", 912);\n    kaku i = 0;\n    aida (i < 64) {\n        emit_observation_metric(code, string.concat(\"gc_pause_bucket_\", convert.format_int(i)), 360 + i * 8);\n        i = i + 1;\n    }\n    emit_observation_metric(code, \"minor_gc_max_ticks\", gen_MinorMax);\n    emit_observation_metric(code, \"major_gc_max_ticks\", gen_MajorMax);\n    emit_observation_metric(code, \"minor_gc_count\", gen_MinorCount);\n    emit_observation_metric(code, \"major_gc_count\", gen_MajorCount);\n    emit_observation_metric(code, \"minor_gc_total_ticks\", gen_MinorTicks);\n    emit_observation_metric(code, \"major_gc_total_ticks\", gen_MajorTicks);\n    emit_observation_metric(code, \"young_live_bytes\", gen_YoungBytes);\n    emit_observation_metric(code, \"old_live_bytes\", gen_OldBytes);\n    emit_observation_metric(code, \"promoted_objects\", gen_PromotedObjects);\n    emit_observation_metric(code, \"promoted_bytes\", gen_PromotedBytes);\n    emit_observation_metric(code, \"promotion_threshold\", gen_Threshold);\n    emit_observation_metric(code, \"remembered_set_entries\", gen_RememberedCount);\n    emit_observation_metric(code, \"minor_scanned_old_objects\", gen_ScannedOld);\n    i = 0;\n    aida (i < 64) {\n        emit_observation_metric(code, string.concat(\"minor_gc_pause_bucket_\", convert.format_int(i)), 1536 + i * 8);\n        emit_observation_metric(code, string.concat(\"major_gc_pause_bucket_\", convert.format_int(i)), 2048 + i * 8);\n        i = i + 1;\n    }\n    arm64.assembler_label(code, \"observation_dump_done\");\n    emit(code, arm64.ldp_post_x(29, 30, 31, 16)); emit(code, arm64.ret());\n\n    arm64.assembler_label(code, \"observation_print_uint\");\n    emit(code, arm64.sub_imm_x(31, 31, 32, iie)); emit(code, arm64.add_imm_x(1, 31, 31, iie));\n    emit(code, arm64.movz_w(4, 10)); emit(code, arm64.strb_w(4, 1, 0));\n    emit(code, arm64.movz_x(2, 1, 0)); emit(code, arm64.movz_x(6, 10, 0));\n    arm64.assembler_label(code, \"observation_print_digit\");\n    emit(code, arm64.udiv_x(3, 0, 6)); emit(code, arm64.msub_x(4, 3, 6, 0));\n    emit(code, arm64.add_imm_w(4, 4, 48)); emit(code, arm64.sub_imm_x(1, 1, 1, iie));\n    emit(code, arm64.strb_w(4, 1, 0)); emit(code, arm64.add_imm_x(2, 2, 1, iie));\n    move_x(code, 0, 3); arm64.assembler_cbnz_x(code, 0, \"observation_print_digit\");\n    emit(code, arm64.movz_x(0, 2, 0)); emit(code, arm64.movz_x(16, 4, 0)); emit(code, arm64.svc(128));\n    emit(code, arm64.add_imm_x(31, 31, 32, iie)); emit(code, arm64.ret());\n}\n" }; }
waza data_11() -> File { kaesu File { path: "kiso/aot/lower/specialize.mio", version: "Bunko-GF3-v0.2", length: 4129, sha256: "56a65569228240d20c60bfa2538565b7147576bc337ffdd0bd0372143943a3ab", source: "yobu \"kiso/array\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/encoding/mochi\";\n\nkata Specialization { file: mochi.File; analysis: types.TypeAnalysis; }\n\nwaza instance_function(source: mochi.Function, id: int64, data: []uint8) -> mochi.Function {\n    // Each specialization owns its mutable metadata arrays. Explicitly typed\n    // copies also retain the array representation when the input function list\n    // is empty and no reachable constructor supplies an element witness.\n    kaku name_bytes: []uint8 = [];\n    array.append_all(name_bytes, source.name_bytes);\n    kaku captures: []mochi.Capture = [];\n    array.append_all(captures, source.captures);\n    kaesu mochi.Function { id: id, name: source.name, name_bytes: name_bytes,\n        parameter_count: source.parameter_count, local_count: source.local_count,\n        returns_value: source.returns_value, captures: captures, instructions: data };\n}\n\nwaza retarget_call(data: []uint8, at: int64, id: int64) -> unit {\n    data[at + 1] = uint8(id / 256); data[at + 2] = uint8(id - (id / 256) * 256);\n}\n\n// v14 erases generic type arguments. Recover separate representations only\n// when the unchanged strict solver rejects a direct call's shared signature.\n// The complete callee is cloned, retaining its control flow and GC analysis.\n// A call site is split at most once; an actual per-instance type/layout failure\n// stays a failure. Bounds prevent recursive specialization from running away.\nwaza specialize(file: mochi.File) -> Specialization {\n    kaku work = mochi.File { version: file.version, constants: file.constants,\n        global_count: file.global_count, instructions: file.instructions,\n        functions: array.clone(file.functions) };\n    kaku attempted: []int64 = []; kaku count = 0;\n    kaku analysis = types.analyze_types(work);\n    aida (analysis.error_detail != 0 && count < 256 && len(work.functions) < 65536) {\n        kaku detail = analysis.error_detail;\n        moshi (detail - (detail / 100) * 100 != 25) { nukeru; }\n        kaku owner = detail / 1000000 - 1;\n        kaku offset = (detail - (owner + 1) * 1000000) / 100;\n        kaku repeated = iie; kaku index = 0;\n        aida (index < len(attempted)) { moshi (attempted[index] == detail) { repeated = hai; } index = index + 1; }\n        moshi (repeated || owner >= len(work.functions)) { nukeru; }\n        array.push(attempted, detail);\n        kaku caller = work.instructions; moshi (owner >= 0) { caller = work.functions[owner].instructions; }\n        moshi (offset < 0 || offset + 3 > len(caller) || caller[offset] != uint8(25)) { nukeru; }\n        kaku target = int64(caller[offset + 1]) * 256 + int64(caller[offset + 2]);\n        moshi (target >= len(work.functions)) { nukeru; }\n        kaku source = work.functions[target];\n        // Captured environments have separate identity/representation edges.\n        // Do not clone them without specializing those edges as well.\n        moshi (len(source.captures) != 0 || len(source.instructions) == 0) { nukeru; }\n        kaku id = len(work.functions); kaku body = array.clone(source.instructions);\n        kaku at = 0;\n        aida (at < len(body)) {\n            kaku opcode = int64(body[at]); kaku width = types.type_instruction_width(opcode);\n            moshi (width <= 0 || at + width > len(body)) { kaesu Specialization { file: work, analysis: analysis }; }\n            moshi (opcode == 25 && int64(body[at + 1]) * 256 + int64(body[at + 2]) == target) { retarget_call(body, at, id); }\n            at = at + width;\n        }\n        array.push(work.functions, instance_function(source, id, body));\n        kaku patched = array.clone(caller); retarget_call(patched, offset, id);\n        moshi (owner < 0) {\n            work = mochi.File { version: work.version, constants: work.constants,\n                global_count: work.global_count, instructions: patched, functions: work.functions };\n        }\n        sore { work.functions[owner] = instance_function(work.functions[owner], owner, patched); }\n        count = count + 1;\n        analysis = types.analyze_types(work);\n    }\n    kaesu Specialization { file: work, analysis: analysis };\n}\n" }; }
waza data_12() -> File { kaesu File { path: "kiso/aot/lower/testing.mio", version: "Bunko-GF3-v0.2", length: 3656, sha256: "8f3b4b859cdf23923569ad0acb42f3db5cf8e16be0451eaf75ebc7fc77ac03e6", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/array\";\n\nwaza uses_testing(file: mochi.File) -> bool {\n    kaku index = 0;\n    aida (index < len(file.functions)) {\n        moshi (types.is_testing_report(file.functions[index].name)) { kaesu hai; }\n        index = index + 1;\n    }\n    kaesu iie;\n}\n\nwaza testing_counter_address(code: arm64.Assembler, patches: []macho.AddressPatch, slot: int64) -> unit {\n    kaku at = len(code.words);\n    emit(code, arm64.Instruction { word: uint32(0), error: mu });\n    emit(code, arm64.Instruction { word: uint32(0), error: mu });\n    array.push(patches, macho.AddressPatch { at_word: at, add_at_word: at + 1,\n        target: macho.data_target(), target_offset: slot * 8, register: 8 });\n}\n\n// report records every failure and returns normally, as the reference recorder\n// does. Program exit reflects the accumulated result; it does not stop after\n// the first failed expectation or turn a failed assertion into success.\nwaza emit_testing_report(code: arm64.Assembler, patches: []macho.AddressPatch, slot: int64,\n    analysis: types.TypeAnalysis, function_id: int64, packet: bool) -> unit {\n    emit(code, arm64.ldr_x(9, 21, 0)); emit_unbox_register(code, analysis, analysis.locals[function_id][0], 9);\n    arm64.assembler_cbnz_x(code, 9, \"testing_report_done\");\n    testing_counter_address(code, patches, slot);\n    emit(code, arm64.ldr_x(9, 8, 0)); emit(code, arm64.add_imm_x(9, 9, 1, iie)); emit(code, arm64.str_x(9, 8, 0));\n    emit(code, arm64.ldr_x(9, 21, 8)); emit_string_view(code);\n    moshi (packet) {\n        emit(code, arm64.sub_imm_x(31, 31, 32, iie)); emit(code, arm64.str_x(13, 31, 0)); emit(code, arm64.str_x(10, 31, 8));\n        // Length-prefixed bytes preserve newlines/NUL and distinguish assertion\n        // data from user stderr. Only test-linked images ever write fd 3.\n        emit(code, arm64.movz_x(0, 3, 0)); emit(code, arm64.add_imm_x(1, 31, 8, iie)); emit(code, arm64.movz_x(2, 8, 0)); emit(code, arm64.movz_x(16, 4, 0)); emit(code, arm64.svc(128));\n        emit(code, arm64.movz_x(0, 3, 0)); emit(code, arm64.ldr_x(1, 31, 0)); emit(code, arm64.ldr_x(2, 31, 8)); emit(code, arm64.movz_x(16, 4, 0)); emit(code, arm64.svc(128));\n        emit(code, arm64.ldr_x(13, 31, 0)); emit(code, arm64.ldr_x(10, 31, 8)); emit(code, arm64.add_imm_x(31, 31, 32, iie));\n    }\n    emit(code, arm64.movz_x(0, 2, 0)); move_x(code, 1, 13); move_x(code, 2, 10);\n    emit(code, arm64.movz_x(16, 4, 0)); emit(code, arm64.svc(128));\n    // A separate stack byte supplies the newline without an embedded string.\n    emit(code, arm64.sub_imm_x(31, 31, 16, iie)); emit(code, arm64.movz_x(9, 10, 0)); emit(code, arm64.strb_w(9, 31, 0));\n    emit(code, arm64.movz_x(0, 2, 0)); emit(code, arm64.add_imm_x(1, 31, 0, iie)); emit(code, arm64.movz_x(2, 1, 0));\n    emit(code, arm64.movz_x(16, 4, 0)); emit(code, arm64.svc(128)); emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    arm64.assembler_label(code, \"testing_report_done\");\n}\n\nwaza uses_testing_packet(file: mochi.File) -> bool {\n    kaku at = 0;\n    aida (at < len(file.functions)) { moshi (types.is_testing_packet(file.functions[at].name)) { kaesu hai; } at = at + 1; }\n    kaesu iie;\n}\nwaza emit_testing_completion(code: arm64.Assembler) -> unit {\n    emit(code, arm64.sub_imm_x(31, 31, 16, iie)); emit(code, arm64.movn_x(9, 0, 0)); emit(code, arm64.str_x(9, 31, 0));\n    emit(code, arm64.movz_x(0, 3, 0)); emit(code, arm64.add_imm_x(1, 31, 0, iie)); emit(code, arm64.movz_x(2, 8, 0)); emit(code, arm64.movz_x(16, 4, 0)); emit(code, arm64.svc(128)); emit(code, arm64.add_imm_x(31, 31, 16, iie));\n}\n" }; }
waza data_13() -> File { kaesu File { path: "kiso/aot/lower/types/types.mio", version: "Bunko-GF3-v0.2", length: 76133, sha256: "4bb948ceef808057d9dc3ed12b4a8399dcc2cd77711364fb331b3f14d0c71a7c", source: "yobu \"kiso/array\";\nyobu \"kiso/aot/lower/nativefs\";\nyobu \"kiso/encoding/mochi\";\n\n// Closed value categories used by the pure-Mio lowering pass.  These are\n// representation categories rather than source-language names: in\n// particular, strings are tagged IDs or managed dynamic descriptors. Exact\n// string slots are published as tagged-union Roots; marking skips tagged IDs.\nkoukai teisu type_unknown = 0;\nkoukai teisu type_integer = 1;\nkoukai teisu type_float32 = 2;\nkoukai teisu type_float64 = 3;\nkoukai teisu type_bool = 4;\nkoukai teisu type_string_id = 5;\nkoukai teisu type_array_ref = 6;\nkoukai teisu type_struct_ref = 7;\nkoukai teisu type_enum_ref = 8;\nkoukai teisu type_function_ref = 9;\nkoukai teisu type_nil = 10;\nkoukai teisu type_float_any = 11;\nkoukai teisu type_map_ref = 12;\n\nkoukai waza is_testing_report(name: string) -> bool {\n    kaesu name == \"$mma::mio/testing/runtime::report::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967\" || is_testing_packet(name);\n}\n\nkoukai waza is_testing_packet(name: string) -> bool {\n    kaesu name == \"$mma::mio/testing/runtime::report_packet::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967\";\n}\n\nkoukai kata TypeArena {\n    parent: []int64;\n    revision: []int64;\n    kind: []int64;\n    nullable: []bool;\n    struct_arity: []int64;\n    struct_exact: []bool;\n    fields: [][]int64;\n    array_width: []int64;\n    array_descriptor: []int64;\n    integer_descriptor: []int64;\n    map_written: []bool;\n    targets: [][]int64;\n    variants: [][][]int64;\n    trace: []bool;\n    context: []int64;\n    nullable_origins: [][]int64;\n}\n\nkoukai kata TypeBlock {\n    data: []uint8;\n    function_id: int64;\n    entry: [][]int64;\n    reachable: []bool;\n}\n\nkoukai kata TypeAnalysis {\n    arena: TypeArena;\n    globals: []int64;\n    locals: [][]int64;\n    returns: []int64;\n    upvalues: [][]int64;\n    cells: [][]bool;\n    blocks: []TypeBlock;\n    error_detail: int64;\n}\n\nwaza type_arena() -> TypeArena {\n    kaesu TypeArena { parent: [], revision: [0], kind: [], nullable: [], struct_arity: [],\n        struct_exact: [], fields: [], array_width: [], array_descriptor: [], integer_descriptor: [], map_written: [], targets: [], variants: [], trace: [iie], context: [0], nullable_origins: [] };\n}\n\nwaza type_new(arena: TypeArena, kind: int64) -> int64 {\n    kaku id = len(arena.parent);\n    array.push(arena.parent, id);\n    array.push(arena.kind, kind);\n    array.push(arena.array_width, 0); array.push(arena.array_descriptor, 0); array.push(arena.integer_descriptor, 0);\n    array.push(arena.map_written, iie);\n    array.push(arena.nullable, iie);\n    array.push(arena.struct_arity, -1);\n    array.push(arena.struct_exact, iie);\n    kaku empty: []int64 = [];\n    array.push(arena.fields, empty);\n    kaku targets: []int64 = []; array.push(arena.targets, targets);\n    kaku variants: [][]int64 = []; array.push(arena.variants, variants);\n    kaesu id;\n}\n\nwaza type_root(arena: TypeArena, node: int64) -> int64 {\n    kaku root = node;\n    aida (arena.parent[root] != root) { root = arena.parent[root]; }\n    kaku cursor = node;\n    aida (arena.parent[cursor] != cursor) {\n        kaku next = arena.parent[cursor];\n        arena.parent[cursor] = root;\n        cursor = next;\n    }\n    kaesu root;\n}\n\nkoukai waza type_kind(analysis: TypeAnalysis, node: int64) -> int64 {\n    kaesu analysis.arena.kind[type_root(analysis.arena, node)];\n}\n\nkoukai waza integer_descriptor(analysis: TypeAnalysis, node: int64) -> int64 {\n    kaesu analysis.arena.integer_descriptor[type_root(analysis.arena, node)];\n}\n\nkoukai waza type_nullable(analysis: TypeAnalysis, node: int64) -> bool {\n    kaesu analysis.arena.nullable[type_root(analysis.arena, node)];\n}\n\nkoukai waza type_is_heap_reference(analysis: TypeAnalysis, node: int64) -> bool {\n    kaku kind = type_kind(analysis, node);\n    kaesu kind == type_string_id || kind == type_array_ref || kind == type_struct_ref || kind == type_enum_ref ||\n        kind == type_function_ref || kind == type_map_ref || (type_nullable(analysis, node) && type_is_scalar_kind(kind));\n}\n\nwaza type_is_scalar_kind(kind: int64) -> bool {\n    kaesu kind == type_integer || kind == type_float32 || kind == type_float64 || kind == type_float_any ||\n        kind == type_bool || kind == type_string_id;\n}\n\nwaza type_merge_fields(arena: TypeArena, left: int64, right: int64) -> bool {\n    kaku left_fields = arena.fields[left];\n    kaku right_fields = arena.fields[right];\n    kaku index = 0;\n    aida (index < len(right_fields)) {\n        moshi (index < len(left_fields)) {\n            moshi (!type_join(arena, left_fields[index], right_fields[index])) { kaesu iie; }\n        }\n        sore { array.push(left_fields, right_fields[index]); }\n        index = index + 1;\n    }\n    arena.fields[left] = left_fields;\n    kaesu hai;\n}\n\n// Union is deliberately strict.  Unknown is a constraint variable, while Nil\n// only adds nullability to a concrete representation.  Two different concrete\n// representations never silently collapse to \"maybe a pointer\".\nwaza type_join(arena: TypeArena, a: int64, b: int64) -> bool {\n    moshi (a < 0 || b < 0 || a >= len(arena.parent) || b >= len(arena.parent)) { kaesu iie; }\n    kaku left = type_root(arena, a);\n    kaku right = type_root(arena, b);\n    moshi (left == right) { kaesu hai; }\n    kaku left_kind = arena.kind[left];\n    moshi (arena.trace[0] && arena.nullable[left] != arena.nullable[right]) { array.push(arena.nullable_origins, [arena.context[0], a, b, 1]); }\n    moshi (arena.trace[0] && ((arena.kind[left] == type_nil && arena.kind[right] != type_nil && arena.kind[right] != type_unknown) || (arena.kind[right] == type_nil && arena.kind[left] != type_nil && arena.kind[left] != type_unknown))) { array.push(arena.nullable_origins, [arena.context[0], a, b, 2]); }\n    kaku right_kind = arena.kind[right];\n    kaku resolved = iie;\n    moshi ((left_kind == type_float_any && (right_kind == type_float32 || right_kind == type_float64)) ||\n        (right_kind == type_float_any && (left_kind == type_float32 || left_kind == type_float64))) {\n        arena.kind[left] = type_float_any;\n        resolved = hai;\n    }\n    moshi (left_kind == type_nil && right_kind != type_nil && right_kind != type_unknown) {\n        arena.kind[left] = right_kind;\n        arena.nullable[left] = hai;\n        resolved = hai;\n    }\n    moshi (!resolved && right_kind == type_nil && left_kind != type_nil && left_kind != type_unknown) {\n        arena.nullable[left] = hai;\n        resolved = hai;\n    }\n    moshi (!resolved && left_kind == type_unknown) { arena.kind[left] = right_kind; resolved = hai; }\n    moshi (!resolved && right_kind != type_unknown && left_kind != right_kind) { kaesu iie; }\n\n    moshi (arena.struct_exact[left] && arena.struct_exact[right] &&\n        arena.struct_arity[left] != arena.struct_arity[right]) { kaesu iie; }\n    moshi (arena.integer_descriptor[left] != 0 && arena.integer_descriptor[right] != 0 && arena.integer_descriptor[left] != arena.integer_descriptor[right]) { kaesu iie; }\n    moshi (arena.integer_descriptor[left] == 0) { arena.integer_descriptor[left] = arena.integer_descriptor[right]; }\n    moshi (arena.array_descriptor[left] != 0 && arena.array_descriptor[right] != 0 && arena.array_descriptor[left] != arena.array_descriptor[right]) { kaesu iie; }\n    moshi (arena.array_descriptor[left] == 0) { arena.array_descriptor[left] = arena.array_descriptor[right]; }\n    arena.map_written[left] = arena.map_written[left] || arena.map_written[right];\n    arena.parent[right] = left; arena.revision[0] = arena.revision[0] + 1;\n    moshi (!type_merge_fields(arena, left, right)) { kaesu iie; }\n    moshi (arena.array_width[left] != 0 && arena.array_width[right] != 0 && arena.array_width[left] != arena.array_width[right]) { kaesu iie; }\n    moshi (arena.array_width[left] == 0) { arena.array_width[left] = arena.array_width[right]; }\n    kaku variants = arena.variants[left]; kaku vi = 0;\n    aida (vi < len(arena.variants[right])) {\n        aida (len(variants) <= vi) { kaku empty: []int64 = []; array.push(variants, empty); }\n        kaku incoming = arena.variants[right][vi]; kaku current = variants[vi];\n        moshi (len(incoming) > 0) {\n            moshi (len(current) == 0) { variants[vi] = incoming; }\n            sore {\n                moshi (len(current) != len(incoming)) { kaesu iie; }\n                kaku fi = 1; aida (fi < len(current)) { moshi (!type_join(arena, current[fi], incoming[fi])) { kaesu iie; } fi = fi + 1; }\n            }\n        }\n        vi = vi + 1;\n    }\n    arena.variants[left] = variants;\n    kaku targets = arena.targets[left];\n    kaku ti = 0;\n    aida (ti < len(arena.targets[right])) {\n        kaku target = arena.targets[right][ti]; kaku found = iie; kaku tj = 0;\n        aida (tj < len(targets)) { moshi (targets[tj] == target) { found = hai; } tj = tj + 1; }\n        moshi (!found) { array.push(targets, target); } ti = ti + 1;\n    }\n    arena.targets[left] = targets;\n    arena.parent[right] = left;\n    arena.nullable[left] = arena.nullable[left] || arena.nullable[right];\n    moshi (!arena.struct_exact[left] && arena.struct_exact[right]) {\n        arena.struct_exact[left] = hai;\n        arena.struct_arity[left] = arena.struct_arity[right];\n    }\n    moshi (!arena.struct_exact[left] && arena.struct_arity[left] < arena.struct_arity[right]) {\n        arena.struct_arity[left] = arena.struct_arity[right];\n    }\n    kaesu hai;\n}\n\nwaza type_require(arena: TypeArena, node: int64, kind: int64) -> bool {\n    kaesu type_join(arena, node, type_new(arena, kind));\n}\n\nwaza type_mark_nullable(arena: TypeArena, node: int64) -> unit {\n    moshi (node < 0 || node >= len(arena.parent)) { kaesu; }\n    moshi (arena.trace[0]) { array.push(arena.nullable_origins, [arena.context[0], node, node, 3]); }\n    arena.nullable[type_root(arena, node)] = hai;\n}\n\nwaza type_new_struct(arena: TypeArena, fields: []int64) -> int64 {\n    kaku node = type_new(arena, type_struct_ref);\n    arena.struct_arity[node] = len(fields);\n    arena.struct_exact[node] = hai;\n    arena.fields[node] = fields;\n    kaesu node;\n}\n\nwaza type_struct_field(arena: TypeArena, node: int64, index: int64) -> int64 {\n    kaku root = type_root(arena, node);\n    moshi (arena.kind[root] == type_unknown) { arena.kind[root] = type_struct_ref; }\n    moshi (arena.kind[root] != type_struct_ref || index < 0) { kaesu -1; }\n    moshi (arena.struct_exact[root] && index >= arena.struct_arity[root]) { kaesu -1; }\n    kaku fields = arena.fields[root];\n    aida (len(fields) <= index) { array.push(fields, type_new(arena, type_unknown)); }\n    arena.fields[root] = fields;\n    moshi (arena.struct_arity[root] < index + 1) { arena.struct_arity[root] = index + 1; }\n    kaesu fields[index];\n}\n\n// Arrays reuse the constraint edge vector with one element edge. The node\n// kind distinguishes these edges from Struct fields.\nkoukai waza type_array_element(arena: TypeArena, node: int64) -> int64 {\n    kaku root = type_root(arena, node);\n    moshi (arena.kind[root] == type_unknown) { arena.kind[root] = type_array_ref; arena.revision[0] = arena.revision[0] + 1; }\n    moshi (arena.kind[root] != type_array_ref) { kaesu -1; }\n    kaku fields = arena.fields[root];\n    moshi (len(fields) == 0) { array.push(fields, type_new(arena, type_unknown)); arena.fields[root] = fields; }\n    kaesu fields[0];\n}\n\n// Map edges describe key and stored nullable value independently of the\n// descriptor's physical linked-entry layout. Scalar values use existing boxes.\nkoukai waza map_field(arena: TypeArena, node: int64, index: int64) -> int64 {\n    moshi (!type_require(arena, node, type_map_ref)) { kaesu -1; }\n    kaku root = type_root(arena, node); kaku fields = arena.fields[root];\n    aida (len(fields) < 2) { array.push(fields, type_new(arena, type_unknown)); }\n    arena.fields[root] = fields;\n    type_mark_nullable(arena, fields[1]);\n    kaesu fields[index];\n}\n\nwaza type_descriptor_kind(descriptor: int64) -> int64 {\n    kaku kind = descriptor - (descriptor / 128) * 128;\n    moshi (kind == 0) { kaesu type_unknown; }\n    moshi (kind == 2) { kaesu type_float64; }\n    moshi (kind == 3) { kaesu type_float32; }\n    moshi (kind == 4) { kaesu type_bool; }\n    moshi (kind == 5) { kaesu type_string_id; }\n    moshi (kind == 7) { kaesu type_array_ref; }\n    moshi (kind == 8) { kaesu type_struct_ref; }\n    moshi (kind == 9) { kaesu type_enum_ref; }\n    moshi (kind == 10) { kaesu type_map_ref; }\n    moshi (kind == 11) { kaesu type_function_ref; }\n    kaesu type_integer;\n}\n\nkoukai waza type_instruction_width(opcode: int64) -> int64 {\n    moshi (opcode == 1 || (opcode >= 17 && opcode <= 20) ||\n        (opcode >= 23 && opcode <= 25) || opcode == 30 || opcode == 36 || opcode == 37 ||\n        opcode == 40 || (opcode >= 44 && opcode <= 49)) { kaesu 3; }\n    moshi (opcode == 38) { kaesu 5; }\n    moshi (opcode == 56 || opcode == 67) { kaesu 4; }\n    moshi (opcode == 54) { kaesu 3; }\n    moshi (opcode == 55 || opcode == 57 || opcode == 58 || opcode == 65 || opcode == 66) { kaesu 2; }\n    moshi ((opcode >= 2 && opcode <= 16) || opcode == 21 || opcode == 22 ||\n        (opcode >= 26 && opcode <= 35) || (opcode >= 39 && opcode <= 43) ||\n        (opcode >= 50 && opcode <= 53) || (opcode >= 59 && opcode <= 64)) { kaesu 1; }\n    kaesu 0;\n}\n\nwaza type_u16(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset + 1]) * 256 + int64(data[offset + 2]);\n}\n\nwaza type_operand2(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset + 3]) * 256 + int64(data[offset + 4]);\n}\n\nwaza type_constant_kind(constant: mochi.Constant) -> int64 {\n    moshi (constant.tag == uint8(2)) { kaesu type_string_id; }\n    moshi (constant.tag == uint8(3)) { kaesu type_float64; }\n    moshi (constant.tag == uint8(4)) { kaesu type_float32; }\n    moshi (constant.tag >= uint8(1) && constant.tag <= uint8(10)) { kaesu type_integer; }\n    kaesu type_unknown;\n}\n\nwaza type_stack_effect(file: mochi.File, opcode: int64, operand: int64, operand2: int64) -> []int64 {\n    kaku need = 0;\n    kaku push = 0;\n    kaku handled = iie;\n    moshi (opcode == 1 || opcode == 8 || opcode == 9 || opcode == 20 || opcode == 21 ||\n        opcode == 24 || opcode == 44 || opcode == 46 || opcode == 47) { push = 1; handled = hai; }\n    moshi (!handled && (opcode == 3 || opcode == 18 || opcode == 19 || opcode == 22 || opcode == 23 ||\n        opcode == 48 || opcode == 49 || opcode == 27)) { need = 1; handled = hai; }\n    moshi (!handled && (opcode == 7 || opcode == 10 || (opcode >= 28 && opcode <= 29) || opcode == 32 ||\n        opcode == 34 || opcode == 39 || opcode == 40 || (opcode >= 50 && opcode <= 53) ||\n        opcode == 55 || opcode == 60 || opcode == 62 || opcode == 65 || opcode == 66)) { need = 1; push = 1; handled = hai; }\n    moshi (!handled && ((opcode >= 2 && opcode <= 6) || (opcode >= 11 && opcode <= 16) || opcode == 31 ||\n        opcode == 42 || opcode == 57)) { need = 2; push = 1; handled = hai; }\n    moshi (!handled && (opcode == 33 || opcode == 35 || opcode == 43)) { need = 3; handled = hai; }\n    moshi (!handled && (opcode == 30 || opcode == 36 || opcode == 56)) { need = operand; push = 1; handled = hai; }\n    moshi (!handled && opcode == 38) { need = operand2; push = 1; handled = hai; }\n    moshi (!handled && opcode == 41) { push = 1; handled = hai; }\n    moshi (!handled && opcode == 58) { need = 1; push = 1; handled = hai; }\n    moshi (!handled && (opcode == 59 || opcode == 61 || opcode == 63 || opcode == 64)) { need = 2; handled = hai; }\n    moshi (!handled && opcode == 54) { need = operand2; moshi (operand != 13) { push = 1; } handled = hai; }\n    moshi (!handled && opcode == 25) {\n        moshi (operand < 0 || operand >= len(file.functions)) { kaesu [-1,-1]; }\n        need = file.functions[operand].parameter_count;\n        moshi (file.functions[operand].returns_value) { push = 1; }\n        handled = hai;\n    }\n    moshi (!handled && opcode == 45) { need = operand + 1; push = 1; }\n    moshi (!handled && opcode == 67) {moshi(file.version<16 || operand2<0 || operand2>1){kaesu [-1,-1];}need=operand+1;push=operand2;}\n    kaesu [need,push];\n}\n\nwaza call_push(file: mochi.File, data: []uint8, offset: int64, count: int64) -> int64 {\n    // Exact targets validate this provisional shape after graph construction.\n    kaku shape = -1; kaku i = 0;\n    aida (i < len(file.functions)) {\n        kaku fn = file.functions[i];\n        moshi (fn.parameter_count == count) {\n            kaku value = 0; moshi (fn.returns_value) { value = 1; }\n            moshi (shape == -1) { shape = value; } sore { moshi (shape != value) { shape = 2; } }\n        }\n        i = i + 1;\n    }\n    moshi (shape < 2 && shape >= 0) { kaesu shape; }\n    // A directly preceding literal has no intervening arguments for arity 0.\n    moshi (count == 0 && offset >= 3 && (data[offset - 3] == uint8(44) || data[offset - 3] == uint8(46))) {\n        kaku id = type_u16(data, offset - 3);\n        moshi (id < len(file.functions)) { moshi (file.functions[id].returns_value) { kaesu 1; } kaesu 0; }\n    }\n    moshi (offset + 3 < len(data)) {\n        kaku next = int64(data[offset + 3]);\n        moshi (next == 3 || next == 19 || next == 22 || next == 23 || next == 27 || next == 48 || next == 49) { kaesu 1; }\n    }\n    moshi (offset + 3 == len(data) || (offset + 3 < len(data) && data[offset + 3] == uint8(26))) { kaesu 0; }\n    kaesu -1;\n}\n\n// Recognize the compiler's exact awase prologue and binding triples.\n// Other control flow stays unresolved rather than merging unrelated variants.\nkoukai waza enum_read_tag(file: mochi.File, data: []uint8, at: int64) -> int64 {\n    kaku cursor = 0; kaku tag = -1; kaku binding = -1;\n    aida (cursor < at) {\n        kaku op = int64(data[cursor]); kaku width = type_instruction_width(op);\n        moshi (width == 0) { kaesu -1; }\n        moshi ((op == 20 || op == 24) && cursor + 11 <= len(data) && data[cursor + 3] == uint8(39) &&\n            data[cursor + 4] == uint8(1) && data[cursor + 7] == uint8(11) && data[cursor + 8] == uint8(18)) {\n            kaku id = type_u16(data, cursor + 4);\n            moshi (id < len(file.constants) && file.constants[id].tag == uint8(1) && file.constants[id].bits.high == uint32(0) && file.constants[id].bits.low <= uint32(65535)) {\n                tag = int64(file.constants[id].bits.low); binding = cursor + 11;\n            }\n        }\n        moshi (binding >= 0 && cursor == binding) {\n            moshi (cursor + 9 <= len(data) && (op == 20 || op == 24) && data[cursor + 3] == uint8(40) &&\n                (data[cursor + 6] == uint8(19) || data[cursor + 6] == uint8(23))) {\n                moshi (at == cursor + 3) { kaesu tag; } binding = cursor + 9;\n            } sore { binding = -1; }\n        }\n        cursor = cursor + width;\n    }\n    kaesu -1;\n}\n\nwaza merge_targets(destination: []int64, source: []int64) -> bool {\n    kaku changed = iie; kaku i = 0;\n    aida (i < len(source)) {\n        kaku j = 0; kaku found = iie;\n        aida (j < len(destination)) { moshi (destination[j] == source[i]) { found = hai; } j = j + 1; }\n        moshi (!found) { array.push(destination, source[i]); changed = hai; } i = i + 1;\n    }\n    kaesu changed;\n}\n\n// Return-shape hints mirror M15b's branchless literal/local/factory analysis.\n// They decide only provisional stack depths; the full graph validates targets.\nwaza call_hints(file: mochi.File) -> [][]int64 {\n    kaku hints: [][]int64 = []; kaku results: [][]int64 = []; kaku globals: [][]int64 = [];\n    kaku i = 0;\n    aida (i < file.global_count) { kaku empty: []int64 = []; array.push(globals, empty); i = i + 1; }\n    i = -1;\n    aida (i < len(file.functions)) {\n        kaku data = file.instructions; moshi (i >= 0) { data = file.functions[i].instructions; }\n        array.push(hints, array.make[int64](len(data) + 1, -1));\n        moshi (i >= 0) { kaku empty: []int64 = []; array.push(results, empty); }\n        i = i + 1;\n    }\n    kaku pass = 0; kaku changed = hai;\n    aida (changed && pass <= len(file.functions) + 1) {\n        changed = iie; i = -1;\n        aida (i < len(file.functions)) {\n            kaku data = file.instructions; kaku count = 0;\n            moshi (i >= 0) { data = file.functions[i].instructions; count = file.functions[i].local_count; }\n            kaku branchless = hai; kaku at = 0;\n            aida (at < len(data)) { kaku op = int64(data[at]); moshi (op == 17 || op == 18) { branchless = iie; } kaku w = type_instruction_width(op); moshi (w == 0) { branchless = iie; nukeru; } at = at + w; }\n            moshi (!branchless) { i = i + 1; tsuzuku; }\n            kaku locals: [][]int64 = []; kaku stack: [][]int64 = []; kaku j = 0;\n            aida (j < count) { kaku empty: []int64 = []; array.push(locals, empty); j = j + 1; }\n            at = 0;\n            aida (at < len(data)) {\n                kaku op = int64(data[at]); kaku w = type_instruction_width(op); kaku arg = 0; kaku arg2 = 0;\n                moshi (w >= 3) { arg = type_u16(data, at); }\n                moshi (op == 38) { arg2 = type_operand2(data, at); }\n                moshi (op == 54 || op == 55 || op == 57 || op == 58 || op == 65) { arg = int64(data[at + 1]); }\n                moshi (op == 54) { arg2 = int64(data[at + 2]); }\n                moshi (op == 67) { arg2 = int64(data[at + 3]); }\n                kaku effect = type_stack_effect(file, op, arg, arg2); kaku value: []int64 = [];\n                moshi (op == 44 || op == 46) { array.push(value, arg); }\n                moshi (op == 20 && arg < len(globals)) { value = globals[arg]; }\n                moshi (op == 24 && arg < len(locals)) { value = locals[arg]; }\n                moshi (op == 25 && arg < len(results)) { value = results[arg]; }\n                moshi (op == 66 && len(stack) > 0) { value = stack[len(stack) - 1]; }\n                moshi (op == 45) {\n                    moshi (len(stack) < arg + 1) { nukeru; }\n                    kaku targets = stack[len(stack) - arg - 1]; kaku shape = -1; kaku ti = 0;\n                    aida (ti < len(targets)) {\n                        kaku target = targets[ti]; kaku fn = file.functions[target]; kaku current = 0; moshi (fn.returns_value) { current = 1; }\n                        moshi (fn.parameter_count != arg || (shape >= 0 && shape != current)) { shape = -2; nukeru; }\n                        shape = current; merge_targets(value, results[target]); ti = ti + 1;\n                    }\n                    moshi (shape >= 0) { moshi (hints[i + 1][at] != shape) { hints[i + 1][at] = shape; changed = hai; } effect[1] = shape; }\n                    sore { effect[1] = call_push(file, data, at, arg); }\n                    moshi (effect[1] < 0) { nukeru; }\n                }\n                moshi (effect[0] > len(stack)) { nukeru; }\n                moshi (op == 19 || op == 23 || op == 49 || op == 27) {\n                    kaku top = stack[len(stack) - 1];\n                    moshi (op == 19) { changed = merge_targets(globals[arg], top) || changed; }\n                    moshi (op == 23 || op == 49) { locals[arg] = top; }\n                    moshi (op == 27 && i >= 0) { changed = merge_targets(results[i], top) || changed; }\n                }\n                array.truncate(stack, len(stack) - effect[0]);\n                moshi (effect[1] > 0) { array.push(stack, value); }\n                at = at + w;\n            }\n            i = i + 1;\n        }\n        pass = pass + 1;\n    }\n    kaesu hints;\n}\n\nwaza type_block_depths(file: mochi.File, data: []uint8, function_id: int64, hints: []int64) -> []int64 {\n    kaku depths = array.make[int64](len(data) + 1, -1);\n    kaku boundary = array.make[bool](len(data) + 1, iie);\n    kaku offset = 0;\n    aida (offset < len(data)) {\n        kaku width = type_instruction_width(int64(data[offset]));\n        moshi (width == 0 || offset + width > len(data)) { kaesu []; }\n        boundary[offset] = hai;\n        offset = offset + width;\n    }\n    boundary[len(data)] = hai;\n    depths[0] = 0;\n    kaku queue: []int64 = [0];\n    kaku cursor = 0;\n    aida (cursor < len(queue)) {\n        offset = queue[cursor]; cursor = cursor + 1;\n        moshi (offset == len(data)) { tsuzuku; }\n        kaku opcode = int64(data[offset]);\n        kaku width = type_instruction_width(opcode);\n        kaku operand = 0; kaku operand2 = 0;\n        moshi (width >= 3) { operand = type_u16(data, offset); }\n        moshi (opcode == 38) { operand2 = type_operand2(data, offset); }\n        moshi (opcode == 56 || opcode == 67) { operand2 = int64(data[offset + 3]); }\n        moshi (opcode == 54 || opcode == 55 || opcode == 57 || opcode == 58 || opcode == 65 || opcode == 66) { operand = int64(data[offset + 1]); }\n        moshi (opcode == 54) { operand2 = int64(data[offset + 2]); }\n        kaku effect = type_stack_effect(file, opcode, operand, operand2);\n        moshi (opcode == 45) { effect[1] = hints[offset]; moshi (effect[1] < 0) { effect[1] = call_push(file, data, offset, operand); } }\n        moshi (effect[1] < 0) { kaesu []; }\n        moshi (len(effect) != 2 || effect[0] < 0 || depths[offset] < effect[0]) { kaesu []; }\n        kaku next_depth = depths[offset] - effect[0] + effect[1];\n        kaku next = offset + width;\n        kaku targets: []int64 = [];\n        moshi (opcode == 17) { array.push(targets, operand); }\n        moshi (opcode == 18) { array.push(targets, operand); array.push(targets, next); }\n        moshi (opcode != 17 && opcode != 18 && opcode != 26 && opcode != 27) { array.push(targets, next); }\n        kaku index = 0;\n        aida (index < len(targets)) {\n            kaku target = targets[index];\n            moshi (target < 0 || target > len(data) || !boundary[target]) { kaesu []; }\n            moshi (depths[target] < 0) { depths[target] = next_depth; array.push(queue, target); }\n            moshi (depths[target] != next_depth) { kaesu []; }\n            index = index + 1;\n        }\n    }\n    kaesu depths;\n}\n\nwaza type_merge_entry(arena: TypeArena, entries: [][]int64, at: int64, stack: []int64) -> bool {\n    kaku current = entries[at];\n    moshi (len(current) == 0 && len(stack) > 0) {\n        kaku copied: []int64 = [];\n        kaku index = 0; aida (index < len(stack)) { array.push(copied, stack[index]); index = index + 1; }\n        entries[at] = copied;\n        kaesu hai;\n    }\n    moshi (len(current) != len(stack)) { kaesu iie; }\n    kaku index = 0;\n    aida (index < len(stack)) {\n        moshi (!type_join(arena, current[index], stack[index])) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\nwaza type_pop(stack: []int64) -> int64 {\n    moshi (len(stack) == 0) { kaesu -1; }\n    kaku value = stack[len(stack) - 1];\n    array.truncate(stack, len(stack) - 1);\n    kaesu value;\n}\n\nwaza type_copy_stack(source: []int64) -> []int64 {\n    kaku result: []int64 = [];\n    kaku index = 0; aida (index < len(source)) { array.push(result, source[index]); index = index + 1; }\n    kaesu result;\n}\n\nwaza type_fail(function_id: int64, offset: int64, opcode: int64) -> int64 {\n    kaesu (function_id + 1) * 1000000 + offset * 100 + opcode;\n}\n\n// Build the graph in two stages: reachability establishes exact stack depths,\n// then each value-producing position receives a union node.  Successor stacks\n// are joined at bytecode boundaries, so loops and diamonds share the same\n// representation decision.\n// Only locals captured into shared Cells can be rebound by another call.\n// A normal by-value local keeps its non-nil fact across direct/indirect calls.\nwaza type_captured_locals(file: mochi.File, data: []uint8, count: int64) -> []bool {\n    kaku shared = array.make[bool](count, iie); kaku at = 0;\n    aida (at < len(data)) {\n        kaku opcode = int64(data[at]); kaku width = type_instruction_width(opcode);\n        moshi (width <= 0 || width > len(data) - at) { kaesu shared; }\n        moshi (opcode == 46) {\n            kaku target = type_u16(data, at);\n            moshi (target >= 0 && target < len(file.functions)) {\n                kaku captures = file.functions[target].captures; kaku ci = 0;\n                aida (ci < len(captures)) { kaku capture = captures[ci];\n                    moshi (capture.local && capture.index >= 0 && capture.index < count) { shared[capture.index] = hai; } ci = ci + 1;\n                }\n            }\n        }\n        at = at + width;\n    }\n    kaesu shared;\n}\n// Forward must-analysis intersects incoming paths. Stores invalidate their\n// local; calls and Cell writes invalidate potentially shared captured locals.\nwaza type_nonnil_entries(file: mochi.File, data: []uint8, count: int64) -> [][]bool {\n    kaku shared = type_captured_locals(file, data, count);\n    kaku facts: [][]bool = []; kaku visited = array.make[bool](len(data) + 1, iie);\n    kaku at = 0; aida (at <= len(data)) { array.push(facts, array.make[bool](count, iie)); at = at + 1; }\n    visited[0] = hai; kaku changed = hai;\n    aida (changed) {\n        changed = iie; at = 0;\n        aida (at < len(data)) {\n            kaku op = int64(data[at]); kaku width = type_instruction_width(op);\n            moshi (visited[at]) {\n                kaku out = array.clone(facts[at]);\n                moshi (op == 23 || op == 49) { kaku slot = type_u16(data, at); moshi (slot < count) { out[slot] = iie; } }\n                moshi (op == 25 || op == 45 || op == 67 || op == 48) { kaku i = 0; aida (i < count) { moshi (shared[i]) { out[i] = iie; } i = i + 1; } }\n                kaku successors: []int64 = []; kaku guard = -1; kaku inverted = iie;\n                moshi (op == 17 || op == 18) { array.push(successors, type_u16(data, at)); }\n                moshi (op != 17 && op != 26 && op != 27) { array.push(successors, at + width); }\n                // These are the compiler's local nil-test forms. All other\n                // conditions provide no fact; no instruction bytes are guessed\n                // from inside operands: verify their instruction boundaries.\n                moshi (op == 18) {\n                    kaku start = at - 4;\n                    moshi (at >= 5 && data[at - 1] == uint8(10)) { start = at - 5; inverted = hai; }\n                    moshi (start >= 0 && data[start] == uint8(24) && data[start + 3] == uint8(34)) {\n                        kaku boundary = 0; aida (boundary < start) { boundary = boundary + type_instruction_width(int64(data[boundary])); }\n                        moshi (boundary == start) { guard = type_u16(data, start); }\n                    }\n                }\n                kaku si = 0;\n                aida (si < len(successors)) {\n                    kaku dest = successors[si]; kaku incoming = array.clone(out);\n                    moshi (guard >= 0 && guard < count && ((si == 0 && !inverted) || (si == 1 && inverted))) { incoming[guard] = hai; }\n                    moshi (!visited[dest]) { facts[dest] = incoming; visited[dest] = hai; changed = hai; }\n                    sore { kaku i = 0; aida (i < count) { moshi (facts[dest][i] && !incoming[i]) { facts[dest][i] = iie; changed = hai; } i = i + 1; } }\n                    si = si + 1;\n                }\n            }\n            at = at + width;\n        }\n    }\n    kaesu facts;\n}\n\n// Operations relate base types without equating their raw/boxed value\n// representations. Only real value-flow edges use type_join.\nwaza type_same_kind(arena: TypeArena, a: int64, b: int64, infer_nil: bool) -> bool {\n    kaku left = type_root(arena, a); kaku right = type_root(arena, b);\n    kaku lk = arena.kind[left]; kaku rk = arena.kind[right];\n    moshi (infer_nil && lk == type_nil && rk != type_nil && rk != type_unknown) {\n        moshi (arena.trace[0]) { array.push(arena.nullable_origins, [arena.context[0], a, b, 2]); }\n        arena.kind[left] = rk; arena.nullable[left] = hai; arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (infer_nil && rk == type_nil && lk != type_nil && lk != type_unknown) {\n        moshi (arena.trace[0]) { array.push(arena.nullable_origins, [arena.context[0], b, a, 2]); }\n        arena.kind[right] = lk; arena.nullable[right] = hai; arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (lk == type_unknown && rk != type_unknown && rk != type_nil) {\n        arena.kind[left] = rk; arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (rk == type_unknown && lk != type_unknown && lk != type_nil) {\n        arena.kind[right] = lk; arena.revision[0] = arena.revision[0] + 1;\n    }\n    moshi (arena.kind[left] == type_integer && arena.kind[right] == type_integer) {\n        kaku ld = arena.integer_descriptor[left]; kaku rd = arena.integer_descriptor[right];\n        moshi (ld != 0 && rd != 0 && ld != rd) { kaesu iie; }\n        moshi (ld == 0 && rd != 0) { arena.integer_descriptor[left] = rd; arena.revision[0] = arena.revision[0] + 1; }\n        moshi (rd == 0 && ld != 0) { arena.integer_descriptor[right] = ld; arena.revision[0] = arena.revision[0] + 1; }\n    }\n    // Nil is a comparison alternative, never a reason to rebox the peer.\n    kaesu lk == rk || lk == type_unknown || rk == type_unknown || lk == type_nil || rk == type_nil ||\n        (lk == type_float_any && (rk == type_float32 || rk == type_float64)) ||\n        (rk == type_float_any && (lk == type_float32 || lk == type_float64));\n}\n\n// Array storage and SS