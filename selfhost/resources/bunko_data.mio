rk);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"invalid\");\n    ir.invoke_function(f, \"gc_old_roots\", 5, [0, 1]);\n    ir.branch(f, ir.nonzero, 5, \"failed\");\n    tconstant(f, 5, old_phase_remark);\n    ir.put(f, ir.release_store, 0, 0, 5, 144);\n    old_deadline(f, 20, 10000000000, \"invalid\");\n    ir.branch(f, ir.label, 0, \"drain\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    tcheck(f, 5, old_phase_abort, \"invalid\");\n    ir.invoke_function(f, \"gc_work_lock\", 5, [0]);\n    ir.branch(f, ir.nonzero, 5, \"deadline\");\n    ir.put(f, ir.load, 5, 0, 0, 40);\n    ir.branch(f, ir.nonzero, 5, \"unlock\");\n    ir.put(f, ir.load, 5, 0, 0, 48);\n    ir.branch(f, ir.nonzero, 5, \"unlock\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 104);\n    ir.branch(f, ir.nonzero, 5, \"unlock\");\n    tconstant(f, 5, 1);\n    ir.put(f, ir.store, 0, 0, 5, 56);\n    ir.branch(f, ir.label, 0, \"unlock\");\n    work_unlock(f);\n    ir.put(f, ir.acquire_load, 5, 0, 0, 184);\n    ir.branch(f, ir.nonzero, 5, \"join\");\n    ir.branch(f, ir.label, 0, \"deadline\");\n    ir.invoke_function(f, \"platform_now\", 5, []);\n    ir.branch(f, ir.zero, 5, \"invalid\");\n    ir.put(f, ir.less_unsigned, 5, 5, 20, 0);\n    ir.branch(f, ir.nonzero, 5, \"drain\");\n    ir.branch(f, ir.label, 0, \"invalid\");\n    tconstant(f, 5, 4);\n    ir.branch(f, ir.label, 0, \"failed\");\n    old_error(f, 5);\n    ir.invoke_function(f, \"gc_old_join\", 6, [0]);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    ir.branch(f, ir.label, 0, \"join\");\n    ir.invoke_function(f, \"gc_old_join\", 5, [0]);\n    ir.branch(f, ir.nonzero, 5, \"failed\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    tconstant(f, 6, old_phase_ready);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"invalid\");\n    tconstant(f, 6, 2);\n    ir.invoke_function(f, \"gc_old_walk\", 5, [0, 6]);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    kaesu f;\n}\nwaza old_observe_program() -> ir.Function {\n    // Only records an observation while the same actual object scan is in flight.\n    kaku f = ir.function(\"gc_old_observe\");\n    ir.put(f, ir.acquire_load, 10, 0, 0, 152);\n    old_bit(f, 10, 11, 1);\n    ir.branch(f, ir.zero, 11, \"done\");\n    ir.invoke_function(f, \"platform_now\", 12, []);\n    ir.branch(f, ir.zero, 12, \"clock_failed\");\n    ir.put(f, ir.acquire_load, 11, 0, 0, 152);\n    ir.put(f, ir.equal, 11, 10, 11, 0);\n    ir.branch(f, ir.zero, 11, \"done\");\n    ir.put(f, ir.address, 11, 0, 0, 208);\n    tconstant(f, 13, 1);\n    array.push(f.steps, ir.Step {\n            kind: ir.fetch_add, destination: 14, left: 11, right: 13, immediate: 0, name: \"\", arguments: [], order: acq_rel, failure_order: relaxed });\n    ir.branch(f, ir.nonzero, 14, \"last\");\n    ir.put(f, ir.release_store, 0, 0, 12, 216);\n    ir.branch(f, ir.label, 0, \"last\");\n    ir.put(f, ir.release_store, 0, 0, 12, 224);\n    ir.branch(f, ir.label, 0, \"done\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 208);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    ir.branch(f, ir.label, 0, \"clock_failed\");\n    tconstant(f, 5, 4);\n    old_error(f, 5);\n    treturn(f, 0);\n    kaesu f;\n}\nkoukai waza old_mark_program() -> []ir.Function {\n    kaku functions = work_queue_program();\n    array.append_all(functions, trace_program_with_visitor(\"gc_old_visit\"));\n    array.append_all(functions, [old_visit_program(), old_inspect_program(), old_walk_program(), old_roots_program(), old_prepare_program(), old_bounds_program(), old_worker_program(), old_join_program(), old_abort_program(), old_launch_program(), old_remark_program(), old_observe_program(), old_satb_program(), old_remember_header_program(), old_pause_program(), old_resume_program(), old_promoted_program(), old_minor_note_program(), old_world_resumed_program(), old_bulk_copy_program(), old_bulk_clear_program(), old_defer_program(), old_reoffer_program(), old_stress_minor_program(), old_cancel_program(), old_fatal_program()]);\n    kaesu functions;\n}\n\n// GCStress still collects before EVERY allocation. During a real Old Mark the\n// coordinated Minor path preserves the concurrent cycle; outside it the\n// existing full-collection compatibility stress semantics remain authoritative.\nwaza old_stress_minor_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_stress_minor\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    tconstant(f, 6, old_phase_mark);\n    ir.put(f, ir.equal, 5, 5, 6, 0);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    kaesu f;\n}\n\n// A terminal caller without a completed stopped epoch may request cancellation,\n// but cannot join/discard tasks concurrently with a registered coordinator.\n// Every mapping/handle is then retained until immediate terminal OS teardown.\nkoukai teisu old_fatal_cancel_only = 85;\nwaza old_cancel_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_cancel\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    ir.branch(f, ir.zero, 5, \"done\");\n    tcheck(f, 5, old_phase_ready, \"done\");\n    tcheck(f, 5, old_phase_abort, \"done\");\n    tconstant(f, 5, old_phase_abort);\n    ir.put(f, ir.release_store, 0, 0, 5, 144);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    kaesu f;\n}\nwaza old_fatal_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_fatal\");\n    ir.branch(f, ir.zero, 1, \"cancel_only\");\n    ir.put(f, ir.load, 10, 0, 0, 256);\n    ir.branch(f, ir.zero, 10, \"cancel_only\");\n    ir.put(f, ir.acquire_load, 11, 10, 0, gc_registry_owner);\n    ir.put(f, ir.equal, 12, 11, 1, 0);\n    ir.branch(f, ir.zero, 12, \"cancel_only\");\n    ir.put(f, ir.acquire_load, 11, 10, 0, gc_registry_phase);\n    tconstant(f, 12, gc_stopped);\n    ir.put(f, ir.equal, 12, 11, 12, 0);\n    ir.branch(f, ir.zero, 12, \"cancel_only\");\n    ir.invoke_function(f, \"gc_old_abort_join\", 5, [0]);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    ir.branch(f, ir.label, 0, \"cancel_only\");\n    ir.invoke_function(f, \"gc_old_cancel\", 5, [0]);\n    treturn(f, old_fatal_cancel_only);\n    kaesu f;\n}\n" }; }
waza data_109() -> File { kaesu File { path: "kiso/runtime/gc/old_overflow.mio", version: "Bunko-v2.1.1", length: 3896, sha256: "b2e89ccd021a85186dcef79b7101de21ecb434656167133e9739dd40deac5e01", source: "// Deferred-task compensation, under native validation. A full queue\n// retains its discovered object as a deferred exact task in the OWNED header.\n// No pointer buffer is dropped or fabricated. Counter104 is published before\n// pending bit42; the independent marker retries a real heap walk if publication\n// is still in flight. Mutator pause protects heap-layout changes during walks.\nkoukai teisu old_deferred_bit = 4398046511104;\nwaza old_defer_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_defer\");\n    ir.put(f, ir.address, 20, 0, 0, 104);\n    tconstant(f, 21, 1);\n    array.push(f.steps, ir.Step {\n            kind: ir.fetch_add, destination: 22, left: 20, right: 21, immediate: 0, name: \"\", arguments: [], order: acq_rel, failure_order: relaxed });\n    tconstant(f, 6, 16);\n    ir.put(f, ir.subtract, 10, 1, 6, 0);\n    tconstant(f, 14, 0);\n    ir.branch(f, ir.label, 0, \"defer_cas\");\n    ir.put(f, ir.acquire_load, 11, 10, 0, 0);\n    old_bit(f, 11, 12, old_deferred_bit);\n    ir.branch(f, ir.nonzero, 12, \"invalid\");\n    tconstant(f, 12, old_deferred_bit);\n    ir.put(f, ir.add, 12, 11, 12, 0);\n    array.push(f.steps, ir.Step {\n            kind: ir.compare_exchange, destination: 13, left: 10, right: 12, immediate: 0, name: \"\", arguments: [11], order: acq_rel, failure_order: acquire });\n    ir.put(f, ir.equal, 13, 13, 11, 0);\n    ir.branch(f, ir.nonzero, 13, \"done\");\n    tconstant(f, 6, 1);\n    ir.put(f, ir.add, 14, 14, 6, 0);\n    tconstant(f, 6, 1024);\n    ir.put(f, ir.less_unsigned, 6, 14, 6, 0);\n    ir.branch(f, ir.nonzero, 6, \"defer_cas\");\n    ir.branch(f, ir.label, 0, \"invalid\");\n    tconstant(f, 5, 4);\n    old_error(f, 5);\n    treturn(f, 4);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    kaesu f;\n}\nwaza old_reoffer_program() -> ir.Function {\n    // ctx,owned header. The only marker calls this during a real overflow walk.\n    // Clear bit42 only after successful queue publication. No other consumer can\n    // revisit this header until this function returns, so it cannot duplicate it.\n    kaku f = ir.function(\"gc_old_reoffer\");\n    ir.put(f, ir.acquire_load, 10, 1, 0, 0);\n    old_bit(f, 10, 11, old_deferred_bit);\n    ir.branch(f, ir.zero, 11, \"done\");\n    ir.put(f, ir.load, 16, 0, 0, 112);\n    ir.put(f, ir.address, 17, 1, 0, 16);\n    ir.invoke_function(f, \"gc_work_offer\", 5, [0, 16, 17]);\n    ir.branch(f, ir.zero, 5, \"published\");\n    tcheck(f, 5, 1, \"done\");\n    tcheck(f, 5, 2, \"done\");\n    ir.branch(f, ir.jump, 0, \"failed\");\n    ir.branch(f, ir.label, 0, \"published\");\n    tconstant(f, 14, 0);\n    ir.branch(f, ir.label, 0, \"clear_cas\");\n    ir.put(f, ir.acquire_load, 10, 1, 0, 0);\n    old_bit(f, 10, 11, old_deferred_bit);\n    ir.branch(f, ir.zero, 11, \"invalid\");\n    tconstant(f, 11, old_deferred_bit);\n    ir.put(f, ir.subtract, 11, 10, 11, 0);\n    array.push(f.steps, ir.Step {\n            kind: ir.compare_exchange, destination: 12, left: 1, right: 11, immediate: 0, name: \"\", arguments: [10], order: acq_rel, failure_order: acquire });\n    ir.put(f, ir.equal, 12, 12, 10, 0);\n    ir.branch(f, ir.nonzero, 12, \"cleared\");\n    tconstant(f, 6, 1);\n    ir.put(f, ir.add, 14, 14, 6, 0);\n    tconstant(f, 6, 1024);\n    ir.put(f, ir.less_unsigned, 6, 14, 6, 0);\n    ir.branch(f, ir.nonzero, 6, \"clear_cas\");\n    ir.branch(f, ir.jump, 0, \"invalid\");\n    ir.branch(f, ir.label, 0, \"cleared\");\n    ir.put(f, ir.address, 20, 0, 0, 104);\n    tconstant(f, 21, -1);\n    array.push(f.steps, ir.Step {\n            kind: ir.fetch_add, destination: 22, left: 20, right: 21, immediate: 0, name: \"\", arguments: [], order: acq_rel, failure_order: relaxed });\n    ir.branch(f, ir.zero, 22, \"invalid\");\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    ir.branch(f, ir.label, 0, \"invalid\");\n    tconstant(f, 5, 4);\n    ir.branch(f, ir.label, 0, \"failed\");\n    old_error(f, 5);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    kaesu f;\n}\n" }; }
waza data_110() -> File { kaesu File { path: "kiso/runtime/gc/old_pause.mio", version: "Bunko-v2.1.1", length: 9604, sha256: "e830df448aad6d62cf6e694eee41323d9145e0113363c8a35b87eae40c7c0eb1", source: "// 分配与 Minor GC 暂停/恢复协议：当前执行的 Mutator 持有堆 Epoch 所有权。\n// request(448)/ack(456)/released(464) 单调递增，depth(496) 为持有者私有；绝不接受复用前残留的陈旧确认。\nwaza old_pause_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_pause\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    tcheck(f, 5, old_phase_abort, \"abort\");\n    tconstant(f, 6, old_phase_mark);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"done\");\n    ir.put(f, ir.load, 10, 0, 0, 496);\n    ir.branch(f, ir.zero, 10, \"request\");\n    tconstant(f, 11, 1024);\n    ir.put(f, ir.less_unsigned, 11, 10, 11, 0);\n    ir.branch(f, ir.zero, 11, \"invalid\");\n    tconstant(f, 11, 1);\n    ir.put(f, ir.add, 10, 10, 11, 0);\n    ir.put(f, ir.store, 0, 0, 10, 496);\n    ir.branch(f, ir.jump, 0, \"done\");\n    ir.branch(f, ir.label, 0, \"request\");\n    ir.put(f, ir.acquire_load, 10, 0, 0, 448);\n    tconstant(f, 11, 1);\n    ir.put(f, ir.add, 10, 10, 11, 0);\n    ir.branch(f, ir.zero, 10, \"invalid\");\n    ir.put(f, ir.release_store, 0, 0, 10, 448);\n    old_deadline(f, 20, 10000000000, \"invalid\");\n    ir.branch(f, ir.label, 0, \"wait\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    tcheck(f, 5, old_phase_abort, \"abort\");\n    ir.put(f, ir.acquire_load, 11, 0, 0, 456);\n    ir.put(f, ir.equal, 11, 11, 10, 0);\n    ir.branch(f, ir.nonzero, 11, \"acknowledged\");\n    ir.invoke_function(f, \"platform_now\", 5, []);\n    ir.branch(f, ir.zero, 5, \"invalid\");\n    ir.put(f, ir.less_unsigned, 5, 5, 20, 0);\n    ir.branch(f, ir.nonzero, 5, \"wait\");\n    ir.branch(f, ir.label, 0, \"invalid\");\n    tconstant(f, 5, 4);\n    old_error(f, 5);\n    ir.branch(f, ir.label, 0, \"abort\");\n    ir.invoke_function(f, \"gc_old_abort_join\", 5, [0]);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    ir.branch(f, ir.label, 0, \"acknowledged\");\n    tconstant(f, 5, 1);\n    ir.put(f, ir.store, 0, 0, 5, 496);\n    old_add(f, 472);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    kaesu f;\n}\nwaza old_resume_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_resume\");\n    ir.put(f, ir.load, 10, 0, 0, 496);\n    ir.branch(f, ir.zero, 10, \"done\");\n    tconstant(f, 11, 1);\n    ir.put(f, ir.subtract, 10, 10, 11, 0);\n    ir.put(f, ir.store, 0, 0, 10, 496);\n    ir.branch(f, ir.nonzero, 10, \"done\");\n    ir.put(f, ir.acquire_load, 10, 0, 0, 448);\n    ir.put(f, ir.release_store, 0, 0, 10, 464);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    kaesu f;\n}\nwaza old_promoted_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_promoted\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    tconstant(f, 6, old_phase_mark);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"done\");\n    old_add(f, 488);\n    ir.invoke_function(f, \"gc_old_visit\", 5, [0, 1]);\n    ir.branch(f, ir.zero, 5, \"done\");\n    ir.invoke_function(f, \"gc_old_abort_join\", 5, [0]);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    kaesu f;\n}\n// Inline into the marker's take loop, between complete scans. The adapter\n// must add a label take_unpaused after this gate. No queue lock is held here.\nwaza old_marker_pause_gate(f: ir.Function) -> unit {\n    ir.put(f, ir.acquire_load, 22, 0, 0, 448);\n    ir.put(f, ir.acquire_load, 23, 0, 0, 464);\n    ir.put(f, ir.equal, 24, 22, 23, 0);\n    ir.branch(f, ir.nonzero, 24, \"take_unpaused\");\n    ir.put(f, ir.less_unsigned, 24, 22, 23, 0);\n    ir.branch(f, ir.nonzero, 24, \"invalid\");\n    ir.put(f, ir.release_store, 0, 0, 22, 456);\n    ir.branch(f, ir.label, 0, \"paused\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    tcheck(f, 5, old_phase_abort, \"done\");\n    ir.put(f, ir.acquire_load, 23, 0, 0, 464);\n    ir.put(f, ir.equal, 24, 22, 23, 0);\n    ir.branch(f, ir.nonzero, 24, \"take\");\n    ir.invoke_function(f, \"platform_now\", 5, []);\n    ir.branch(f, ir.zero, 5, \"invalid\");\n    ir.put(f, ir.less_unsigned, 5, 5, 20, 0);\n    ir.branch(f, ir.nonzero, 5, \"paused\");\n    ir.branch(f, ir.jump, 0, \"invalid\");\n}\n\n// A real Minor increments this only after a successful pause acknowledgment.\nwaza old_minor_note_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_note_minor\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    tconstant(f, 6, old_phase_mark);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"done\");\n    ir.put(f, ir.load, 5, 0, 0, 496);\n    ir.branch(f, ir.zero, 5, \"invalid\");\n    old_add(f, 480);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    ir.branch(f, ir.label, 0, \"invalid\");\n    tconstant(f, 5, 4);\n    old_error(f, 5);\n    ir.invoke_function(f, \"gc_old_abort_join\", 6, [0]);\n    treturn(f, 4);\n    kaesu f;\n}\n// Fresh object storage may be promoted by a nested allocation before its\n// descriptor/fields finish initialization. Hold the marker across the entire\n// existing Mutator heap epoch, rather than resuming immediately after malloc.\nwaza old_pause_epoch_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_pause_epoch\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    tcheck(f, 5, old_phase_abort, \"abort\");\n    tconstant(f, 6, old_phase_mark);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"done\");\n    ir.put(f, ir.load, 5, 0, 0, 496);\n    ir.branch(f, ir.nonzero, 5, \"done\");\n    ir.invoke_function(f, \"gc_old_pause\", 5, [0]);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    ir.branch(f, ir.label, 0, \"abort\");\n    ir.invoke_function(f, \"gc_old_abort_join\", 5, [0]);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    kaesu f;\n}\nwaza old_resume_epoch_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_resume_epoch\");\n    ir.put(f, ir.load, 5, 0, 0, 496);\n    ir.branch(f, ir.zero, 5, \"done\");\n    tconstant(f, 6, 1);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"invalid\");\n    ir.invoke_function(f, \"gc_old_resume\", 5, [0]);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    ir.branch(f, ir.label, 0, \"invalid\");\n    tconstant(f, 5, 4);\n    old_error(f, 5);\n    ir.invoke_function(f, \"gc_old_abort_join\", 6, [0]);\n    treturn(f, 4);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    kaesu f;\n}\n// The adapter supplies an OWNED optional extension slot offset, containing a\n// pointer to the shared control-pointer slot. No CPU or OS layout is assumed.\n// Interpose every original gc_end path, including Native blocking and error\n// cleanup, so pause ownership cannot leak across a Mutator epoch transfer.\nwaza old_end_epoch_program(control_link_offset: int64) -> ir.Function {\n    kaku f = ir.function(\"gc_end\");\n    tprepare(f);\n    tload(f, 10, thread_registry);\n    ir.put(f, ir.acquire_load, 11, 10, 0, gc_registry_owner);\n    ir.put(f, ir.equal, 12, 11, 0, 0);\n    ir.branch(f, ir.zero, 12, \"not_owner\");\n    ir.put(f, ir.load, 10, 0, 0, control_link_offset);\n    ir.branch(f, ir.zero, 10, \"delegate_epoch_end\");\n    ir.put(f, ir.acquire_load, 10, 10, 0, 0);\n    ir.branch(f, ir.zero, 10, \"delegate_epoch_end\");\n    ir.invoke_function(f, \"gc_old_resume_epoch\", 5, [10]);\n    ir.branch(f, ir.nonzero, 5, \"failed\");\n    ir.branch(f, ir.label, 0, \"delegate_epoch_end\");\n    ir.invoke_function(f, \"gc_end_base\", 5, [0]);\n    ir.branch(f, ir.nonzero, 5, \"failed\");\n    ir.branch(f, ir.zero, 10, \"failed\");\n    ir.invoke_function(f, \"gc_old_world_resumed\", 5, [10]);\n    ir.branch(f, ir.label, 0, \"failed\");\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    ir.branch(f, ir.label, 0, \"not_owner\");\n    treturn(f, 4);\n    kaesu f;\n}\nkoukai waza old_heap_epoch_program(functions: []ir.Function, control_link_offset: int64, owned_context_bytes: int64) -> []ir.Function {\n    kaku result: []ir.Function = [];\n    moshi (control_link_offset<thread_context_bytes || owned_context_bytes<8 || control_link_offset>owned_context_bytes - 8 || control_link_offset - (control_link_offset / 8) * 8 != 0) {\n        kaesu result;\n    }\n    kaku i = 0;\n    kaku found = 0;\n    aida (i<len(functions)) {\n        kaku f = functions[i];\n        moshi (f.name == \"gc_end\") {\n            found = found + 1;\n            array.push(result, ir.Function {\n                    name: \"gc_end_base\", steps: f.steps });\n            array.push(result, old_end_epoch_program(control_link_offset));\n        } sore {\n            array.push(result, f);\n        }\n        i = i + 1;\n    }\n    // An invalid build-time composition fails later symbol validation, rather\n    // than silently omitting the release wrapper from a purported safe profile.\n    moshi (found != 1) {\n        kaku invalid: []ir.Function = [];\n        kaesu invalid;\n    }\n    array.append_all(result, [old_pause_epoch_program(), old_resume_epoch_program()]);\n    kaesu result;\n}\n\n// One-way publication of the initial stopped-world release. Sampling current\n// registry ownership can miss that release if a new constructor immediately\n// owns the next epoch, deadlocking its pause request against marker startup.\n// Called only after successful gc_end_base; a later owner must still be able\n// to request/receive an acknowledgment before its constructor touches storage.\nwaza old_world_resumed_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_world_resumed\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 296);\n    ir.branch(f, ir.nonzero, 5, \"done\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    tconstant(f, 6, old_phase_mark);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"done\");\n    tconstant(f, 5, 1);\n    ir.put(f, ir.release_store, 0, 0, 5, 296);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    kaesu f;\n}\n" }; }
waza data_111() -> File { kaesu File { path: "kiso/runtime/gc/old_satb.mio", version: "Bunko-v2.1.1", length: 3031, sha256: "b35ac4c5329d3b9f94022c1316d6a384b4292167c096b71d3ff0529c46a68600", source: "// Typed slot prewrite for the experimental Old cycle. Caller holds the\n// Mutator heap epoch and owns the exact pointer slot. It must not overwrite\n// until this returns. A failed publication Abort/joins before compatibility\n// mutation; it never authorizes concurrent reclaim or a successful cycle.\nwaza old_satb_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_prewrite\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 144);\n    tconstant(f, 6, old_phase_mark);\n    ir.put(f, ir.equal, 6, 5, 6, 0);\n    ir.branch(f, ir.zero, 6, \"done\");\n    old_add(f, 424);\n    ir.put(f, ir.acquire_load, 1, 1, 0, 0);\n    ir.branch(f, ir.zero, 1, \"done\");\n    tconstant(f, 6, 2);\n    ir.put(f, ir.divide_unsigned, 7, 1, 6, 0);\n    ir.put(f, ir.multiply, 7, 7, 6, 0);\n    ir.put(f, ir.equal, 7, 7, 1, 0);\n    ir.branch(f, ir.zero, 7, \"done\");\n    old_add(f, 432);\n    // Only exact pointer slots reach here. Young is excluded from the Old\n    // queue; Init's complete Young frontier owns its pre-existing Old edges.\n    ir.invoke_function(f, \"gc_old_bounds\", 19, [0, 1]);\n    ir.branch(f, ir.zero, 19, \"invalid\");\n    tconstant(f, 6, 16);\n    ir.put(f, ir.less_unsigned, 7, 1, 6, 0);\n    ir.branch(f, ir.nonzero, 7, \"invalid\");\n    ir.put(f, ir.subtract, 10, 1, 6, 0);\n    ir.put(f, ir.acquire_load, 11, 10, 0, 0);\n    old_bit(f, 11, 12, old_generation_bit);\n    ir.branch(f, ir.zero, 12, \"done\");\n    old_bit(f, 11, 12, old_color_bit);\n    ir.branch(f, ir.nonzero, 12, \"publish\");\n    old_add(f, 440);\n    ir.branch(f, ir.label, 0, \"publish\");\n    ir.invoke_function(f, \"gc_old_visit\", 5, [0, 1]);\n    ir.branch(f, ir.zero, 5, \"done\");\n    ir.branch(f, ir.jump, 0, \"abort\");\n    ir.branch(f, ir.label, 0, \"invalid\");\n    tconstant(f, 5, 4);\n    old_error(f, 5);\n    ir.branch(f, ir.label, 0, \"abort\");\n    ir.invoke_function(f, \"gc_old_abort_join\", 5, [0]);\n    ir.put(f, ir.result, 0, 5, 0, 0);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    kaesu f;\n}\n// Caller supplies an owned object HEADER, with generation/list mutations\n// serialized by the Mutator epoch. Preserve a concurrent Old color claim.\nwaza old_remember_header_program() -> ir.Function {\n    kaku f = ir.function(\"gc_old_remember_header\");\n    tconstant(f, 10, 0);\n    ir.branch(f, ir.label, 0, \"retry\");\n    ir.put(f, ir.acquire_load, 11, 0, 0, 0);\n    old_bit(f, 11, 12, 1099511627776);\n    ir.branch(f, ir.nonzero, 12, \"done\");\n    tconstant(f, 12, 1099511627776);\n    ir.put(f, ir.add, 12, 11, 12, 0);\n    array.push(f.steps, ir.Step {\n            kind: ir.compare_exchange, destination: 13, left: 0, right: 12, immediate: 0, name: \"\", arguments: [11], order: acq_rel, failure_order: acquire });\n    ir.put(f, ir.equal, 13, 13, 11, 0);\n    ir.branch(f, ir.nonzero, 13, \"done\");\n    tconstant(f, 12, 1);\n    ir.put(f, ir.add, 10, 10, 12, 0);\n    tconstant(f, 12, 1024);\n    ir.put(f, ir.less_unsigned, 12, 10, 12, 0);\n    ir.branch(f, ir.nonzero, 12, \"retry\");\n    treturn(f, 4);\n    ir.branch(f, ir.label, 0, \"done\");\n    treturn(f, 0);\n    kaesu f;\n}\n" }; }
waza data_112() -> File { kaesu File { path: "kiso/runtime/gc/old_sweep.mio", version: "Bunko-v2.1.1", length: 35935, sha256: "737314829a6a90d98088d9d21a7c82b0d1a09a7d0aba320ab5eefd2d9080ab2c", source: "// 并发清扫（Concurrent Sweep）扩展实现，严格保留基础 512B 控制块 ABI。\n// 512..759 为清扫阶段状态与统计字段（lock512, waiter520, head528, pending536, claimed544,\n// swept552, bytes560, quarantine568..unmapError584, handle592..losReclaims752），1024 起为完整工作队列。\nkoukai teisu sweep_claim_bit = 17592186044416;\nkoukai teisu sweep_account_operation = 206;\nkoukai teisu sweep_unmap_operation = 207;\nwaza sweep_fail(f: ir.Function, r: int64) -> unit {\n    ir.put(f, ir.address, 26, 0, 0, 720);\n    tconstant(f, 27, 0);\n    array.push(f.steps, ir.Step {\n            kind: ir.compare_exchange, destination: 25, left: 26, right: r, immediate: 0, name: \"\", arguments: [27], order: acq_rel, failure_order: acquire });\n    tconstant(f, 27, 4);\n    ir.put(f, ir.release_store, 0, 0, 27, 712);\n}\nwaza sweep_add(f: ir.Function, off: int64, r: int64) -> unit {\n    ir.put(f, ir.load, 28, 0, 0, off);\n    ir.put(f, ir.add, 28, 28, r, 0);\n    ir.put(f, ir.release_store, 0, 0, 28, off);\n}\nwaza sweep_lock_program() -> ir.Function {\n    // ctrl,ownerToken (1 collector; context pointer Mutator),mutatorWaiter.\n    kaku f = ir.function(\"gc_sweep_lock\");\n    ir.branch(f, ir.zero, 1, \"invalid\");\n    ir.branch(f, ir.zero, 2, \"deadline\");\n    tconstant(f, 5, 1);\n    ir.put(f, ir.release_store, 0, 0, 5, 520);\n    ir.branch(f, ir.label, 0, \"deadline\");\n    old_deadline(f, 20, 30000000000, \"invalid\");\n    ir.put(f, ir.address, 10, 0, 0, 512);\n    tconstant(f, 11, 0);\n    ir.branch(f, ir.label, 0, \"try\");\n    ir.branch(f, ir.nonzero, 2, \"acquire\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 712);\n    tcheck(f, 5, 4, \"cancelled\");\n    ir.put(f, ir.acquire_load, 5, 0, 0, 520);\n    ir.branch(f, ir.nonzero, 5, \"clock\");\n    ir.branch(f, ir.label, 0, \"acquire\");\n    ir.put(f, ir.acquire_load, 12, 0