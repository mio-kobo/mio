c, arm64.cmp_x(1, 9)); lx_bcc(c, 1, \"lx_setsockopt_go\"); lx_li(c, 1, 1);\n    kaku options = [4, 2, 4130, -1, 512, 15, 4097, 7, 4098, 8];\n    at = 0;\n    aida (at < len(options)) {\n        kaku next = lx_name(\"lx_setsockopt_next_\", at);\n        lx_li(c, 9, options[at]); lx(c, arm64.cmp_x(2, 9)); lx_bcc(c, 1, next);\n        moshi (options[at + 1] < 0) { lx_li(c, 0, 0); lx_b(c, \"lx_norm\"); }\n        sore { lx_li(c, 2, options[at + 1]); lx_b(c, \"lx_setsockopt_go\"); }\n        lx_label(c, next);\n        at = at + 2;\n    }\n    lx_label(c, \"lx_setsockopt_go\"); lx_li(c, 8, 208); lx_b(c, \"lx_svc\");\n\n    // ---- bind/connect: Darwin sockaddr_in (sin_len, sin_family) -> Linux (u16 family)\n    lx_label(c, \"lx_bind\"); lx_li(c, 8, 200); lx_b(c, \"lx_sockaddr\");\n    lx_label(c, \"lx_connect\"); lx_li(c, 8, 203);\n    lx_label(c, \"lx_sockaddr\");\n    lx(c, arm64.ldp_x(9, 10, 1, 0)); lx(c, arm64.stp_x(9, 10, 31, 144));\n    lx_li(c, 9, 2); lx(c, arm64.strb_w(9, 31, 144)); lx(c, arm64.strb_w(31, 31, 145));\n    lx(c, arm64.add_imm_x(1, 31, 144, iie)); lx_b(c, \"lx_svc\");\n\n    // ---- poll(fds, nfds, timeout ms) -> ppoll(fds, nfds, &timespec or NULL, NULL, 0)\n    lx_label(c, \"lx_poll\");\n    lx(c, arm64.cmp_imm_x(2, 0, iie)); lx_bcc(c, 11, \"lx_poll_infinite\");\n    lx_li(c, 9, 1000); lx(c, arm64.udiv_x(10, 2, 9)); lx(c, arm64.msub_x(11, 10, 9, 2)); lx_li(c, 12, 1000000); lx(c, arm64.mul_x(11, 11, 12));\n    lx(c, arm64.str_x(10, 31, 144)); lx(c, arm64.str_x(11, 31, 152)); lx(c, arm64.add_imm_x(2, 31, 144, iie)); lx_b(c, \"lx_poll_go\");\n    lx_label(c, \"lx_poll_infinite\"); lx_li(c, 2, 0);\n    lx_label(c, \"lx_poll_go\"); lx_li(c, 3, 0); lx_li(c, 4, 0); lx_li(c, 8, 73); lx_b(c, \"lx_svc\");\n\n    // ---- sysctl({CTL_HW, HW_MEMSIZE}, 2, oldp, oldlenp): physical memory in bytes from sysinfo(2); other names fail\n    lx_label(c, \"lx_sysctl\");\n    lx(c, arm64.ldr_w(9, 0, 0)); lx(c, arm64.cmp_imm_x(9, 6, iie)); lx_bcc(c, 1, \"lx_unsupported\");\n    lx(c, arm64.ldr_w(9, 0, 4)); lx(c, arm64.cmp_imm_x(9, 24, iie)); lx_bcc(c, 1, \"lx_unsupported\");\n    lx_mov(c, 13, 2); lx_mov(c, 14, 3);\n    lx(c, arm64.add_imm_x(0, 31, 144, iie)); lx_li(c, 8, 179); lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie)); lx_bcc(c, 11, \"lx_norm\");\n    lx(c, arm64.ldr_x(9, 31, 176)); lx(c, arm64.ldr_w(10, 31, 248)); lx(c, arm64.mul_x(9, 9, 10));\n    lx(c, arm64.str_x(9, 13, 0)); lx_li(c, 11, 8); lx(c, arm64.str_x(11, 14, 0));\n    lx_li(c, 0, 0); lx_b(c, \"lx_norm\");\n    // sysctlbyname: the memory-pressure level is optional input; report it as unavailable (ENOENT)\n    lx_label(c, \"lx_sysctlbyname\"); lx_li(c, 0, -2); lx_b(c, \"lx_norm\");\n    // getrlimit: RLIMIT_AS is 5 on Darwin and 9 on Linux; Linux RLIM_INFINITY (~0) becomes the Darwin value 2^63 - 1\n    lx_label(c, \"lx_getrlimit\");\n    lx(c, arm64.cmp_imm_x(0, 5, iie)); lx_bcc(c, 1, \"lx_getrlimit_go\"); lx_li(c, 0, 9);\n    lx_label(c, \"lx_getrlimit_go\");\n    lx_mov(c, 13, 1); lx_li(c, 8, 163); lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie)); lx_bcc(c, 11, \"lx_norm\");\n    lx(c, arm64.movn_x(11, 0, 0)); lx(c, arm64.lsr_x(12, 11, 1));\n    kaku slot = 0;\n    aida (slot < 2) {\n        kaku keep = lx_name(\"lx_getrlimit_keep_\", slot);\n        lx(c, arm64.ldr_x(9, 13, slot * 8)); lx(c, arm64.cmp_x(9, 11)); lx_bcc(c, 1, keep); lx(c, arm64.str_x(12, 13, slot * 8));\n        lx_label(c, keep);\n        slot = slot + 1;\n    }\n    lx_li(c, 0, 0); lx_b(c, \"lx_norm\");\n\n    lx_errno(c);\n}\n" }; }
waza data_9() -> File { kaesu File { path: "kiso/aot/lower/lower.mio", version: "Bunko-v2.1.1", length: 165975, sha256: "f3dfed5bb61cd4bd0bf97387e30e6507457c17047ac2e2b155ae4521c7a3bdf5", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/lower/nativefs\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// M17e's native lowering tier. It accepts all v14 constant encodings and the\n// scalar opcode subset listed below plus typed Nullable and Struct operations.\n// A bounded managed region, exact Shadow Frames, mark/sweep and 32-bin reuse\n// provide GC-safe Struct, Array and Enum allocation plus NativeFS calls.\n// Closures use the M15b Cell/Environment protocol; unresolved layouts fail closed. Each generated call frame has a bounded\n// 4,080-byte local/operand area and uses the established one-word ABI.\nkoukai sentaku LowerError {\n    UnsupportedConstant;\n    UnsupportedOpcode(int64);\n    UnsupportedClosure;\n    InvalidFunction;\n    InvalidOperand(int64);\n    FrameTooLarge;\n    EncodeFailure;\n    UnsafeType(int64);\n    UnsupportedNative(int64);\n    BranchOutOfRange(int64);\n}\n\nkoukai kata LowerResult {\n    words: []uint32;\n    constants: []uint8;\n    patches: []macho.AddressPatch;\n    globals: int64;\n    error: LowerError?;\n    // code word of each Mochi function's entry (-1: not emitted); diagnostics such as symbol maps for profilers\n    function_words: []int64;\n    labels: []arm64.Label;\n}\n\nkoukai waza error_code(value: LowerError) -> int64 {\n    awase (value) {\n        baai UnsupportedConstant { kaesu 1; }\n        baai UnsupportedOpcode(detail) { kaesu 2; }\n        baai UnsupportedClosure { kaesu 3; }\n        baai InvalidFunction { kaesu 4; }\n        baai InvalidOperand(detail) { kaesu 5000 + detail; }\n        baai FrameTooLarge { kaesu 6; }\n        baai EncodeFailure { kaesu 7; }\n        baai UnsafeType(detail) { kaesu 8; }\n        baai UnsupportedNative(detail) { kaesu 9; }\n        baai BranchOutOfRange(detail) { kaesu 10; }\n    }\n    kaesu 0;\n}\n\n// For UnsupportedOpcode the detail packs (functionID+1, byteOffset, opcode)\n// as FFFFF*1_000_000 + offset*100 + opcode.  Main uses functionID -1 and\n// therefore has no leading function component. BranchOutOfRange instead\n// reports the generated machine-word index, after all bytecode lowering.\nkoukai waza error_detail(value: LowerError) -> int64 {\n    awase (value) {\n        baai UnsupportedOpcode(detail) { kaesu detail; }\n        baai InvalidOperand(detail) { kaesu detail; }\n        baai UnsupportedConstant { kaesu 0; }\n        baai UnsupportedClosure { kaesu 0; }\n        baai InvalidFunction { kaesu 0; }\n        baai FrameTooLarge { kaesu 0; }\n        baai EncodeFailure { kaesu 0; }\n        baai UnsafeType(detail) { kaesu detail; }\n        baai UnsupportedNative(detail) { kaesu detail; }\n        baai BranchOutOfRange(detail) { kaesu detail; }\n    }\n    kaesu 0;\n}\n\nwaza failed(kind: LowerError) -> LowerResult {\n    kaesu LowerResult { words: [], constants: [], patches: [], globals: 0, error: kind, function_words: [], labels: [] };\n}\n\nwaza same_bytes(left: []uint8, right: []uint8) -> bool {\n    moshi (len(left) != len(right)) { kaesu iie; }\n    kaku index = 0;\n    aida (index < len(left)) {\n        moshi (left[index] != right[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\n// Intern once in first-occurrence order. IDs are shared by instruction\n// lowering, the constant image and NativeFS's empty string.\nwaza string_ids(constants: []mochi.Constant) -> []int64 {\n    kaku ids = array.make[int64](len(constants), -1); kaku unique: []int64 = [];\n    kaku i = 0;\n    aida (i < len(constants)) {\n        moshi (constants[i].tag == uint8(2)) {\n            kaku id = 0;\n            aida (id < len(unique) && !same_bytes(constants[unique[id]].data, constants[i].data)) { id = id + 1; }\n            moshi (id == len(unique)) { array.push(unique, i); }\n            ids[i] = id;\n        }\n        i = i + 1;\n    }\n    kaesu ids;\n}\n\nwaza put_u32_le(data: []uint8, at: int64, value: int64) -> unit {\n    data[at] = uint8(value - (value / 256) * 256);\n    data[at + 1] = uint8((value / 256) - (value / 65536) * 256);\n    data[at + 2] = uint8((value / 65536) - (value / 16777216) * 256);\n    data[at + 3] = uint8(value / 16777216);\n}\n\n// The table matches the established Go runtime: one little-endian\n// (offset,length) entry per interned string, followed by the exact UTF-8 bytes.\nwaza constant_image(constants: []mochi.Constant, ids: []int64, add_empty: bool) -> []uint8 {\n    kaku unique = 0;\n    kaku has_empty = iie;\n    kaku index = 0;\n    aida (index < len(constants)) {\n        moshi (constants[index].tag == uint8(2)) {\n            moshi (len(constants[index].data) == 0) { has_empty = hai; }\n            moshi (ids[index] == unique) { unique = unique + 1; }\n        }\n        index = index + 1;\n    }\n    kaku table_count = unique; moshi (add_empty && !has_empty) { table_count = table_count + 1; }\n    kaku output = array.make[uint8](table_count * 8, uint8(0));\n    kaku cursor = table_count * 8;\n    index = 0; kaku next_id = 0;\n    aida (index < len(constants)) {\n        moshi (constants[index].tag == uint8(2)) {\n            kaku id = ids[index];\n            moshi (id == next_id) {\n                next_id = next_id + 1;\n                put_u32_le(output, id * 8, cursor);\n                put_u32_le(output, id * 8 + 4, len(constants[index].data));\n                array.append_all(output, constants[index].data);\n                cursor = cursor + len(constants[index].data);\n            }\n        }\n        index = index + 1;\n    }\n    kaesu output;\n}\n\nwaza empty_string_id(constants: []mochi.Constant, ids: []int64) -> int64 {\n    kaku unique = 0; kaku index = 0;\n    aida (index < len(constants)) {\n        moshi (constants[index].tag == uint8(2) && ids[index] == unique) {\n            moshi (len(constants[index].data) == 0) { kaesu unique; }\n            unique = unique + 1;\n        }\n        index = index + 1;\n    }\n    kaesu unique;\n}\n\nwaza emit_constant(code: arm64.Assembler, constants: []mochi.Constant, ids: []int64, at: int64) -> LowerError? {\n    moshi (at < 0 || at >= len(constants)) { kaesu LowerError.InvalidOperand(3000 + at); }\n    kaku constant = constants[at];\n    kaku high = constant.bits.high;\n    kaku low = constant.bits.low;\n    // Signed fixed-width constants are serialized as their exact 8/16/32-bit\n    // payload and occupy a sign-extended raw runtime slot.\n    moshi (constant.tag == uint8(5) && low >= uint32(128)) { high = uint32(4294967295); low = low + uint32(4294967040); }\n    moshi (constant.tag == uint8(6) && low >= uint32(32768)) { high = uint32(4294967295); low = low + uint32(4294901760); }\n    moshi (constant.tag == uint8(7) && low >= uint32(2147483648)) { high = uint32(4294967295); }\n    moshi (constant.tag == uint8(2)) {\n        kaku tagged = ids[at] * 2 + 1;\n        high = uint32(0); low = uint32(tagged);\n    }\n    moshi (constant.tag < uint8(1) || constant.tag > uint8(10)) { kaesu LowerError.UnsupportedConstant(); }\n    move_bits(code, 9, high, low); push_register(code, 9);\n    kaesu mu;\n}\n\nwaza operand_u16(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset + 1]) * 256 + int64(data[offset + 2]);\n}\n\nwaza width(opcode: int64) -> int64 {\n    moshi (opcode == 1 || (opcode >= 17 && opcode <= 20) ||\n        (opcode >= 23 && opcode <= 25) || opcode == 30 || opcode == 36 || opcode == 37 || opcode == 40 || (opcode >= 44 && opcode <= 49)) { kaesu 3; }\n    moshi (opcode >= 2 && opcode <= 16) { kaesu 1; }\n    moshi (opcode == 54) { kaesu 3; }\n    moshi (opcode == 38) { kaesu 5; }\n    moshi (opcode == 39 || opcode == 41 || opcode == 42 || opcode == 43) { kaesu 1; }\n    moshi (opcode == 56 || opcode == 67) { kaesu 4; }\n    moshi (opcode == 55 || opcode == 57 || opcode == 58 || opcode == 65 || opcode == 66) { kaesu 2; }\n    moshi (opcode == 59 || opcode == 64 || opcode == 60 || opcode == 61 || opcode == 62 || opcode == 63) { kaesu 1; }\n    moshi (opcode == 21 || opcode == 22 || opcode == 26 || opcode == 27 || opcode == 28 || opcode == 29 || (opcode >= 50 && opcode <= 53) || opcode == 31 || opcode == 32 || opcode == 33 || opcode == 34 || opcode == 35) { kaesu 1; }\n    kaesu 0;\n}\n\n// Struct fields are not at a fixed offset.  The M12/M16b payload is\n// {kind,fieldCount,fieldCount,bitmapWords,bitmap...,fields...}; consequently\n// even the same field index moves when a struct crosses a 64-field bitmap\n// boundary.  Load bitmapWords from the receiver and form the address at run\n// time.  OpGetField is allocation-free and has no helper call, so replacing\n// the receiver slot in place does not introduce a GC safepoint.\nwaza emit_get_field(code: arm64.Assembler, index: int64) -> unit {\n    pop_register(code, 9); move_bits(code, 11, uint32(0), uint32(index));\n    arm64.assembler_bl(code, \"rt_get_field\");\n    push_register(code, 9);\n}\n\n// x9 receiver, x11 field index -> x9 field value; uses x10-x14 (and the heap-read scratch). One shared copy of the\n// receiver kind, field bound, bitmap and payload checks that every field read performs.\nwaza emit_get_field_routine(code: arm64.Assembler) -> unit {\n    arm64.assembler_label(code, \"rt_get_field\");\n    arm64.assembler_cbz_x(code, 9, \"runtime_error\");\n    emit(code, arm64.ldr_x(10, 9, 0)); emit(code, arm64.cmp_imm_x(10, 1, iie)); arm64.assembler_b_cond(code, 1, \"runtime_error\");\n    emit(code, arm64.ldr_x(10, 9, 8)); emit(code, arm64.cmp_x(11, 10)); arm64.assembler_b_cond(code, 2, \"runtime_error\");\n    emit(code, arm64.ldr_x(10, 9, 24));\n    emit(code, arm64.ldr_x(12, 9, 8)); emit(code, arm64.add_imm_x(13, 12, 63, iie)); emit(code, arm64.lsr_x(13, 13, 6)); emit(code, arm64.cmp_x(13, 10));\n    arm64.assembler_b_cond(code, 1, \"runtime_error\");\n    emit(code, arm64.add_x(13, 10, 12)); emit(code, arm64.lsl_x(13, 13, 3)); emit(code, arm64.add_imm_x(13, 13, 32, iie));\n    emit(code, arm64.sub_imm_x(14, 9, 16, iie)); emit(code, arm64.ldr_x(14, 14, 8)); emit(code, arm64.cmp_x(13, 14));\n    arm64.assembler_b_cond(code, 8, \"runtime_error\");\n    emit(code, arm64.lsl_x(10, 10, 3));\n    emit(code, arm64.add_x(9, 9, 10));\n    emit(code, arm64.lsl_x(11, 11, 3));\n    emit(code, arm64.add_x(9, 9, 11));\n    emit_heap_read_word(code,9,9,32);\n    emit(code, arm64.ret());\n}\n\nwaza emit_len(code: arm64.Assembler, kind: int64) -> bool {\n    pop_register(code, 9);\n    moshi (kind == types.type_unknown || kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.movz_x(10, 1, 0)); emit(code, arm64.and_x(10, 9, 10)); emit(code, arm64.cmp_imm_x(10, 0, iie));\n        kaku dynamic_label = string.concat(\"len_dynamic_\", convert.format_int(len(code.words))); kaku done_label = string.concat(\"len_done_\", convert.format_int(len(code.words)));\n        arm64.assembler_b_cond(code, 0, dynamic_label); emit(code, arm64.lsr_x(10, 9, 1)); emit(code, arm64.lsl_x(10, 10, 3)); emit(code, arm64.add_x(10, 28, 10)); emit(code, arm64.ldr_x(10, 10, 0)); emit(code, arm64.lsr_x(9, 10, 32)); arm64.assembler_b(code, done_label);\n        arm64.assembler_label(code, dynamic_label); emit(code, arm64.ldr_x(9, 9, 8)); arm64.assembler_label(code, done_label); push_register(code, 9); kaesu hai;\n    }\n    moshi (kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\");\n        emit(code, arm64.lsr_x(10, 9, 1)); emit(code, arm64.lsl_x(10, 10, 3)); emit(code, arm64.add_x(10, 28, 10)); emit(code, arm64.ldr_x(10, 10, 0)); emit(code, arm64.lsr_x(9, 10, 32)); push_register(code, 9); kaesu hai;\n    }\n    moshi (kind == types.type_array_ref) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.ldr_x(9, 9, 8)); push_register(code, 9); kaesu hai;\n    }\n    kaesu iie;\n}\n\n// Full-mode readers pair with published mutable slots; no GC operation here.\nwaza emit_heap_read_word(code:arm64.Assembler,dst:int64,base:int64,offset:int64) -> unit {\n    moshi(!old_sweep_enabled(code)){emit(code,arm64.ldr_x(dst,base,offset));kaesu;}\n    moshi(offset==0){emit(code,arm64.ldar_x(dst,base));kaesu;}\n    kaku temp=14;moshi(dst==14){temp=15;}\n    emit(code,arm64.sub_imm_x(31,31,16,iie));emit(code,arm64.str_x(temp,31,0));\n    emit(code,arm64.add_imm_x(temp,base,offset,iie));emit(code,arm64.ldar_x(dst,temp));\n    emit(code,arm64.ldr_x(temp,31,0));emit(code,arm64.add_imm_x(31,31,16,iie));\n}\n\n// x9 array descriptor (non-nil), x10 index -> x9 element; uses x11, x12. The unsigned bound check also rejects negative\n// indexes; the element width byte (header bits 8..15) must be 8 or 1.\nwaza emit_array_element(code: arm64.Assembler) -> unit {\n    emit(code, arm64.ldr_x(11, 9, 8)); emit(code, arm64.cmp_x(10, 11)); arm64.assembler_b_cond(code, 2, \"runtime_error\");\n    emit(code, arm64.ldrb_w(11, 9, 1));\n    emit_heap_read_word(code,12,9,40); emit(code, arm64.add_imm_x(12, 12, 32, iie));\n    kaku byte_label = block_label(\"index_byte_\", len(code.words)); kaku done_label = string.concat(byte_label, \"_done\");\n    emit(code, arm64.cmp_imm_x(11, 8, iie)); arm64.assembler_b_cond(code, 1, byte_label);\n    moshi (old_sweep_enabled(code)) { emit(code, arm64.lsl_x(11, 10, 3)); emit(code, arm64.add_x(12, 12, 11)); emit_heap_read_word(code,9,12,0); }\n    sore { emit(code, arm64.ldr_x_register_scaled(9, 12, 10)); }\n    arm64.assembler_b(code, done_label);\n    arm64.assembler_label(code, byte_label); emit(code, arm64.cmp_imm_x(11, 1, iie)); arm64.assembler_b_cond(code, 1, \"runtime_error\");\n    emit(code, arm64.ldrb_w_register(9, 12, 10));\n    arm64.assembler_label(code, done_label);\n}\n\nwaza emit_index(code: arm64.Assembler, analysis: types.TypeAnalysis, index_node: int64, kind: int64) -> bool {\n    emit(code, arm64.sub_imm_x(20, 20, 16, iie)); emit(code, arm64.add_x(8, 19, 20)); emit(code, arm64.ldp_x(9, 10, 8, 0));\n    emit_unbox_register(code, analysis, index_node, 10);\n    // Every path below compares the index with the length as unsigned (B.HS), which also rejects negative indexes.\n    moshi (kind == types.type_unknown || kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.movz_x(11, 1, 0)); emit(code, arm64.and_x(11, 9, 11)); emit(code, arm64.cmp_imm_x(11, 0, iie));\n        kaku array_label = string.concat(\"index_array_\", convert.format_int(len(code.words))); kaku done_label = string.concat(\"index_unknown_done_\", convert.format_int(len(code.words)));\n        arm64.assembler_b_cond(code, 0, array_label); emit(code, arm64.lsr_x(11, 9, 1)); emit(code, arm64.lsl_x(11, 11, 3)); emit(code, arm64.add_x(11, 28, 11)); emit(code, arm64.ldr_x(12, 11, 0)); emit(code, arm64.lsr_x(13, 12, 32)); emit(code, arm64.cmp_x(10, 13)); arm64.assembler_b_cond(code, 2, \"runtime_error\"); move_bits(code, 13, uint32(0), uint32(4294967295)); emit(code, arm64.and_x(12, 12, 13)); emit(code, arm64.add_x(12, 28, 12)); emit(code, arm64.add_x(12, 12, 10)); emit(code, arm64.ldrb_w(9, 12, 0)); arm64.assembler_b(code, done_label);\n        arm64.assembler_label(code, array_label); emit_array_element(code); arm64.assembler_label(code, done_label); push_register(code, 9); kaesu hai;\n    }\n    moshi (kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.lsr_x(11, 9, 1)); emit(code, arm64.lsl_x(11, 11, 3)); emit(code, arm64.add_x(11, 28, 11)); emit(code, arm64.ldr_x(12, 11, 0)); emit(code, arm64.lsr_x(13, 12, 32)); emit(code, arm64.cmp_x(10, 13)); arm64.assembler_b_cond(code, 2, \"runtime_error\");\n        move_bits(code, 13, uint32(0), uint32(4294967295)); emit(code, arm64.and_x(12, 12, 13)); emit(code, arm64.add_x(12, 28, 1