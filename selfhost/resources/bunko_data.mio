   x86_64.label(code, \"rt.fs_close.closed\");\n    x86_64.mov_ri(code, x86_64.rsi, 3);\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.jmp(code, \"rt.fs_status_one\");\n}\n\n// rt.fs_read / rt.fs_write: rdi = token, rsi = byte array, rdx = offset, rcx = length, r8 = status array -> message\nwaza emit_fs_transfer(code: x86_64.Assembler, name: string, reading: bool) -> unit {\n    x86_64.label(code, name);\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 64);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rbp, -32, x86_64.r8);\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.test_rr(code, x86_64.r8, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.call(code, \"rt.fs_lookup\");\n    x86_64.mov_store(code, x86_64.rbp, -40, x86_64.rax);\n    x86_64.call(code, \"rt.fs_entry_code\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, string.concat(name, \".fail\"));\n    // range check against the byte array length\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -16);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -24);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsi, 16);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".range\"));\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".range\"));\n    x86_64.cmp_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_g, string.concat(name, \".range\"));\n    x86_64.sub_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.cmp_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_g, string.concat(name, \".range\"));\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsi, 40);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rbp, -48, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rbp, -56, x86_64.rax);\n    x86_64.label(code, string.concat(name, \".again\"));\n    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -40);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rax, 0);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -48);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -24);\n    moshi (reading) { x86_64.mov_eax_imm(code, 0); }\n    moshi (!reading) { x86_64.mov_eax_imm(code, 1); }\n    moshi (!reading) {\n        x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n        x86_64.jcc(code, x86_64.cc_e, string.concat(name, \".finished\"));\n    }\n    x86_64.call(code, \"rt.syscall\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".errno\"));\n    moshi (reading) {\n        x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n        x86_64.mov_ri(code, x86_64.rdx, 0);\n        x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n        x86_64.jcc(code, x86_64.cc_ne, string.concat(name, \".success\"));\n        x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -24);\n        x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n        x86_64.jcc(code, x86_64.cc_e, string.concat(name, \".success\"));\n        x86_64.mov_ri(code, x86_64.rdx, 1);\n        x86_64.label(code, string.concat(name, \".success\"));\n        x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -32);\n        x86_64.mov_ri(code, x86_64.rcx, 0);\n        x86_64.call(code, \"rt.fs_status_io\");\n        leave_frame(code);\n    }\n    moshi (!reading) {\n        x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n        x86_64.jcc(code, x86_64.cc_e, string.concat(name, \".errno_zero\"));\n        x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -56);\n        x86_64.add_rr(code, x86_64.rcx, x86_64.rax);\n        x86_64.mov_store(code, x86_64.rbp, -56, x86_64.rcx);\n        x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -48);\n        x86_64.add_rr(code, x86_64.rsi, x86_64.rax);\n        x86_64.mov_store(code, x86_64.rbp, -48, x86_64.rsi);\n        x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -24);\n        x86_64.sub_rr(code, x86_64.rdx, x86_64.rax);\n        x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rdx);\n        x86_64.jmp(code, string.concat(name, \".again\"));\n        x86_64.label(code, string.concat(name, \".finished\"));\n        x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -56);\n        x86_64.mov_ri(code, x86_64.rdx, 0);\n        x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -32);\n        x86_64.mov_ri(code, x86_64.rcx, 0);\n        x86_64.call(code, \"rt.fs_status_io\");\n        leave_frame(code);\n        x86_64.label(code, string.concat(name, \".errno_zero\"));\n        x86_64.mov_ri(code, x86_64.rax, 5);\n        x86_64.jmp(code, string.concat(name, \".code\"));\n    }\n    x86_64.label(code, string.concat(name, \".errno\"));\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.call(code, \"rt.fs_classify\");\n    x86_64.label(code, string.concat(name, \".code\"));\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -56);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -32);\n    x86_64.call(code, \"rt.fs_status_io\");\n    leave_frame(code);\n    x86_64.label(code, string.concat(name, \".fail\"));\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -32);\n    x86_64.call(code, \"rt.fs_status_io\");\n    leave_frame(code);\n    x86_64.label(code, string.concat(name, \".range\"));\n    x86_64.mov_ri(code, x86_64.rcx, 4);\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -32);\n    x86_64.call(code, \"rt.fs_status_io\");\n    leave_frame(code);\n}\n\n// ---- directories, stat, mkdir ------------------------------------------------------------------------\n// Directory iteration state lives in a second table indexed like the handle table:\n// 4 words per slot: buffer (backing payload), bytes in buffer, read position, current entry (0 = none).\nwaza dir_table_base() -> int64 { kaesu data_base() + 16 + 1536; }\n\n// rt.fs_cpath: rdi = string -> rax = NUL-terminated copy (payload pointer), or 0 when the path contains NUL.\nwaza emit_fs_cpath(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.fs_cpath\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 32);\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rdi);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 16);\n    x86_64.lea(code, x86_64.rsi, x86_64.rdi, 24);\n    x86_64.label(code, \"rt.fs_cpath.scan\");\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_cpath.copy\");\n    x86_64.mov_load8(code, x86_64.rax, x86_64.rsi, 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_cpath.bad\");\n    x86_64.add_ri(code, x86_64.rsi, 1);\n    x86_64.sub_ri(code, x86_64.rcx, 1);\n    x86_64.jmp(code, \"rt.fs_cpath.scan\");\n    x86_64.label(code, \"rt.fs_cpath.copy\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 16);\n    x86_64.add_ri(code, x86_64.rax, 8);\n    x86_64.and_ri(code, x86_64.rax, -8);\n    x86_64.add_ri(code, x86_64.rax, 16);\n    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rax);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -16);\n    x86_64.shl_ri(code, x86_64.rcx, 8);\n    x86_64.add_ri(code, x86_64.rcx, 4);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsi, 16);\n    x86_64.add_ri(code, x86_64.rsi, 24);\n    x86_64.lea(code, x86_64.rdi, x86_64.rax, 16);\n    x86_64.rep_movsb(code);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store8(code, x86_64.rdi, 0, x86_64.rdx);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -24);\n    x86_64.add_ri(code, x86_64.rax, 16);\n    leave_frame(code);\n    x86_64.label(code, \"rt.fs_cpath.bad\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    leave_frame(code);\n}\n\n// rt.fs_stat: rdi = path, rsi = status array (2 bytes) -> message. status[0]: 0 missing, 1 other/file, 2 directory.\nwaza emit_fs_stat(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.fs_stat\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 192);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rsi);\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.call(code, \"rt.fs_cpath\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_stat.badpath\");\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rax);\n    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -192);\n    x86_64.mov_eax_imm(code, 4);\n    x86_64.call(code, \"rt.syscall\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.fs_stat.failed\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -168);\n    x86_64.and_ri(code, x86_64.rcx, 61440);\n    x86_64.mov_ri(code, x86_64.rdx, 1);\n    x86_64.cmp_ri(code, x86_64.rcx, 16384);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.fs_stat.store\");\n    x86_64.mov_ri(code, x86_64.rdx, 2);\n    x86_64.label(code, \"rt.fs_stat.store\");\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rsi, 40);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store8(code, x86_64.rsi, 1, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.call(code, \"rt.fs_message\");\n    leave_frame(code);\n    x86_64.label(code, \"rt.fs_stat.failed\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.call(code, \"rt.fs_classify\");\n    x86_64.jmp(code, \"rt.fs_stat.fail_store\");\n    x86_64.label(code, \"rt.fs_stat.badpath\");\n    x86_64.mov_ri(code, x86_64.rax, 7);\n    x86_64.label(code, \"rt.fs_stat.fail_store\");\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rsi, 40);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.mov_store8(code, x86_64.rsi, 1, x86_64.rax);\n    x86_64.call(code, \"rt.fs_message\");\n    leave_frame(code);\n}\n\n// rt.fs_mkdir: rdi = path, rsi = status array -> message\nwaza emit_fs_mkdir(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.fs_mkdir\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 16);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rsi);\n    x86_64.call(code, \"rt.fs_cpath\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_mkdir.badpath\");\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 511);\n    x86_64.mov_eax_imm(code, 83);\n    x86_64.call(code, \"rt.syscall\");\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ge, \"rt.fs_mkdir.done\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.call(code, \"rt.fs_classify\");\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.label(code, \"rt.fs_mkdir.done\");\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);\n    x86_64.call(code, \"rt.fs_status_one\");\n    leave_frame(code);\n    x86_64.label(code, \"rt.fs_mkdir.badpath\");\n    x86_64.mov_ri(code, x86_64.rsi, 7);\n    x86_64.jmp(code, \"rt.fs_mkdir.done\");\n}\n\n// rt.fs_dir_slot: rdi = token -> rax = address of the directory state, or 0 (rcx = handle table entry)\nwaza emit_fs_dir_slot(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.fs_dir_slot\");\n    x86_64.call(code, \"rt.fs_lookup\");\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_dir_slot.none\");\n    x86_64.mov_ri(code, x86_64.rdx, handle_table_base());\n    x86_64.sub_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.r8, 24);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.div_r(code, x86_64.r8);\n    // only slots 0..63 have directory state: a socket or file handle in a higher slot is not a directory\n    x86_64.cmp_ri(code, x86_64.rax, directory_slots());\n    x86_64.jcc(code, x86_64.cc_ae, \"rt.fs_dir_slot.beyond\");\n    x86_64.shl_ri(code, x86_64.rax, 5);\n    x86_64.mov_ri(code, x86_64.rdx, dir_table_base());\n    x86_64.add_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.fs_dir_slot.beyond\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.label(code, \"rt.fs_dir_slot.none\");\n    x86_64.ret(code);\n}\n\n// rt.fs_open_dir: rdi = path -> token. The directory is opened O_RDONLY|O_DIRECTORY and gets a 32 KiB entry buffer.\nwaza emit_fs_open_dir(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.fs_open_dir\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 16);\n    x86_64.call(code, \"rt.fs_cpath\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_open_dir.badpath\");\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 65536);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_eax_imm(code, 2);\n    x86_64.call(code, \"rt.syscall\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.fs_open_dir.errno\");\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 1);\n    x86_64.call(code, \"rt.fs_alloc_dir\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_open_dir.done\");\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);\n    x86_64.call(code, \"rt.fs_dir_slot\");\n    // slot i of the directory table owns the static buffer directory_buffers() + i * 32768\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rcx, dir_table_base());\n    x86_64.sub_rr(code, x86_64.rdx, x86_64.rcx);\n    x86_64.shl_ri(code, x86_64.rdx, 10);\n    x86_64.mov_ri(code, x86_64.rcx, directory_buffers());\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store(code, x86_64.rax, 8, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rdx);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -8);\n    x86_64.jmp(code, \"rt.fs_open_dir.done\");\n    x86_64.label(code, \"rt.fs_open_dir.errno\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.call(code, \"rt.fs_classify\");\n    x86_64.lea(code, x86_64.rsi, x86_64.rax, 10);\n    x86_64.mov_ri(code, x86_64.rdi, -1);\n    x86_64.call(code, \"rt.fs_alloc\");\n    x86_64.jmp(code, \"rt.fs_open_dir.done\");\n    x86_64.label(code, \"rt.fs_open_dir.badpath\");\n    x86_64.mov_ri(code, x86_64.rsi, 17);\n    x86_64.mov_ri(code, x86_64.rdi, -1);\n    x86_64.call(code, \"rt.fs_alloc\");\n    x86_64.label(code, \"rt.fs_open_dir.done\");\n    leave_frame(code);\n}\n\n// rt.fs_dir_status: rdi = token, rsi = status array -> message (same contract as file_status)\n// rt.fs_dir_close: same as rt.fs_close\n// rt.fs_dir_next: rdi = token -> rax = 1 when an entry (not \".\" or \"..\") is current\nwaza emit_fs_dir_next(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.fs_dir_next\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 32);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rdi);\n    x86_64.call(code, \"rt.fs_dir_slot\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_dir_next.none\");\n    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 8);\n    x86_64.cmp_ri(code, x86_64.rdx, 10);\n    x86_64.jcc(code, x86_64.cc_ae, \"rt.fs_dir_next.none\");\n    x86_64.label(code, \"rt.fs_dir_next.again\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -16);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 16);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rax, 8);\n    x86_64.cmp_rr(code, x86_64.rcx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.fs_dir_next.have\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -24);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rdx, 0);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rax, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 32768);\n    x86_64.mov_eax_imm(code, 217);\n    x86_64.call(code, \"rt.syscall\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.fs_dir_next.failed\");\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_dir_next.end\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -16);\n    x86_64.mov_store(code, x86_64.rcx, 8, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store(code, x86_64.rcx, 16, x86_64.rdx);\n    x86_64.jmp(code, \"rt.fs_dir_next.again\");\n    x86_64.label(code, \"rt.fs_dir_next.have\");\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rax, 0);\n    x86_64.add_rr(code, x86_64.rsi, x86_64.rcx);\n    x86_64.mov_load8(code, x86_64.rdx, x86_64.rsi, 16);\n    x86_64.mov_load8(code, x86_64.r8, x86_64.rsi, 17);\n    x86_64.shl_ri(code, x86_64.r8, 8);\n    x86_64.add_rr(code, x86_64.rdx, x86_64.r8);\n    x86_64.add_rr(code, x86_64.rcx, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rsi);\n    x86_64.mov_load8(code, x86_64.rdx, x86_64.rsi, 19);\n    x86_64.cmp_ri(code, x86_64.rdx, 46);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.fs_dir_next.found\");\n    x86_64.mov_load8(code, x86_64.rdx, x86_64.rsi, 20);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_dir_next.again\");\n    x86_64.cmp_ri(code, x86_64.rdx, 46);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.fs_dir_next.found\");\n    x86_64.mov_load8(code, x86_64.rdx, x86_64.rsi, 21);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_dir_next.again\");\n    x86_64.label(code, \"rt.fs_dir_next.found\");\n    x86_64.mov_ri(code, x86_64.rax, 1);\n    leave_frame(code);\n    x86_64.label(code, \"rt.fs_dir_next.failed\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.call(code, \"rt.fs_classify\");\n    x86_64.add_ri(code, x86_64.rax, 10);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -24);\n    x86_64.mov_store(code, x86_64.rcx, 8, x86_64.rax);\n    x86_64.label(code, \"rt.fs_dir_next.end\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -16);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rdx);\n    x86_64.label(code, \"rt.fs_dir_next.none\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    leave_frame(code);\n}\n\n// rt.fs_dir_current: rdi = token -> rax = pointer to the current dirent, or traps with \"invalid argument\"\nwaza emit_fs_dir_current(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.fs_dir_current\");\n    x86_64.call(code, \"rt.fs_dir_slot\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.call\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 24);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.call\");\n    x86_64.ret(code);\n    // rt.fs_dir_name: rdi = token -> rax = the entry name as a new string\n    x86_64.label(code, \"rt.fs_dir_name\");\n    x86_64.call(code, \"rt.fs_dir_current\");\n    x86_64.lea(code, x86_64.rsi, x86_64.rax, 19);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.label(code, \"rt.fs_dir_name.length\");\n    x86_64.mov_load8(code, x86_64.rdx, x86_64.rsi, 0);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.fs_dir_name.sized\");\n    x86_64.add_ri(code, x86_64.rsi, 1);\n    x86_64.add_ri(code, x86_64.rcx, 1);\n    x86_64.jmp(code, \"rt.fs_dir_name.length\");\n    x86_64.label(code, \"rt.fs_dir_name.sized\");\n    x86_64.push_r(code, x86_64.rax);\n    x86_64.push_r(code, x86_64.rcx);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.add_ri(code, x86_64.rax, 24 + 7);\n    x86_64.and_ri(code, x86_64.rax, -8);\n    x86_64.mov_rr(code, x86_64.r9, x86_64.rax);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rax);\n    x86_64.pop_r(code, x86_64.rcx);\n    x86_64.pop_r(code, x86_64.rsi);\n    x86_64.shl_ri(code, x86_64.r9, 8);\n    x86_64.add_ri(code, x86_64.r9, 6);\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.r9);\n    x86_64.mov_store(code, x86_64.r8, 16, x86_64.rcx);\n    x86_64.add_ri(code, x86_64.rsi, 19);\n    x86_64.lea(code, x86_64.rdi, x86_64.r8, 24);\n    x86_64.rep_movsb(code);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.r8);\n    x86_64.ret(code);\n    // rt.fs_dir_is_dir / rt.fs_dir_is_file: d_type DT_DIR = 4, DT_REG = 8\n    x86_64.label(code, \"rt.fs_dir_is_dir\");\n    x86_64.call(code, \"rt.fs_dir_current\");\n    x86_64.mov_load8(code, x86_64.rax, x86_64.rax, 18);\n    x86_64.cmp_ri(code, x86_64.rax, 4);\n    x86_64.setcc_rax(code, x86_64.cc_e);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.fs_dir_is_file\");\n    x86_64.call(code, \"rt.fs_dir_current\");\n    x86_64.mov_load8(code, x86_64.rax, x86_64.rax, 18);\n    x86_64.cmp_ri(code, x86_64.rax, 8);\n    x86_64.setcc_rax(code, x86_64.cc_e);\n    x86_64.ret(code);\n}\n\nwaza emit_fs_runtime(code: x86_64.Assembler) -> unit {\n    emit_fs_support(code);\n    emit_fs_open(code);\n    emit_fs_file_status(code);\n    emit_fs_close(code);\n    emit_fs_transfer(code, \"rt.fs_read\", hai);\n    emit_fs_transfer(code, \"rt.fs_write\", iie);\n    emit_fs_cpath(code);\n    emit_fs_stat(code);\n    emit_fs_mkdir(code);\n    emit_fs_dir_slot(code);\n    emit_fs_open_dir(code);\n    emit_fs_dir_next(code);\n    emit_fs_dir_current(code);\n    x86_64.label(code, \"rt.fs_dir_status\");\n    x86_64.jmp(code, \"rt.fs_file_status\");\n    x86_64.label(code, \"rt.fs_dir_close\");\n    x86_64.jmp(code, \"rt.fs_close\");\n    kaku code_number = 0;\n    aida (code_number < 8) {\n        kaku text = \"\";\n        moshi (code_number != 0) { text = message_for(code_number); }\n        emit_string_object(code, message_label(code_number), text);\n        code_number = code_number + 1;\n    }\n}\n\n// Native operation of a body-less MMA function: \"fs:<name>\" or \"os:<name>\" (\"\" for any other function).\nwaza operation_name(operation: string) -> string {\n    kaku bytes = string.to_bytes(operation);\n    kaku output: []uint8 = [];\n    kaku at = 3;\n    aida (at < len(bytes)) {\n        array.push(output, bytes[at]);\n        at = at + 1;\n    }\n    kaku text = string.from_utf8(output);\n    moshi (text == mu) { kaesu \"\"; }\n    kaesu text;\n}\n\nwaza native_operation(name: string) -> string {\n    kaku prefixes: []string = [\"$mma::mio/fs/runtime::\", \"$mma::mio/os/runtime::\"];\n    kaku labels: []string = [\"fs:\", \"os:\"];\n    kaku which = 0;\n    aida (which < 2) {\n        moshi (string.has_prefix(name, prefixes[which])) {\n            kaku bytes = string.to_bytes(name);\n            kaku at = string.byte_len(prefixes[which]);\n            kaku output: []uint8 = [];\n            aida (at < len(bytes) && bytes[at] != uint8(58)) {\n                array.push(output, bytes[at]);\n                at = at + 1;\n            }\n            kaku text = string.from_utf8(output);\n            moshi (text == mu) { kaesu \"\"; }\n            kaesu string.concat(labels[which], text);\n        }\n        which = which + 1;\n    }\n    kaesu \"\";\n}\n\n// Routine of a native operation, or \"\" when it is not implemented.\nwaza native_routine(operation: string) -> string {\n    moshi (string.has_prefix(operation, \"os:\")) { kaesu os_routine(string.concat(\"\", operation_name(operation))); }\n    kaku name = operation_name(operation);\n    moshi (name == \"open\") { kaesu \"rt.fs_open\"; }\n    moshi (name == \"file_status\") { kaesu \"rt.fs_file_status\"; }\n    moshi (name == \"read\") { kaesu \"rt.fs_read\"; }\n    moshi (name == \"write\") { kaesu \"rt.fs_write\"; }\n    moshi (name == \"close\") { kaesu \"rt.fs_close\"; }\n    moshi (name == \"stat\") { kaesu \"rt.fs_stat\"; }\n    moshi (name == \"mkdir\") { kaesu \"rt.fs_mkdir\"; }\n    moshi (name == \"open_dir\") { kaesu \"rt.fs_open_dir\"; }\n    moshi (name == \"dir_status\") { kaesu \"rt.fs_dir_status\"; }\n    moshi (name == \"dir_next\") { kaesu \"rt.fs_dir_next\"; }\n    moshi (name == \"dir_name\") { kaesu \"rt.fs_dir_name\"; }\n    moshi (name == \"dir_is_dir\") { kaesu \"rt.fs_dir_is_dir\"; }\n    moshi (name == \"dir_is_file\") { kaesu \"rt.fs_dir_is_file\"; }\n    moshi (name == \"dir_close\") { kaesu \"rt.fs_dir_close\"; }\n    kaesu \"\";\n}\n" }; }
waza data_54() -> File { kaesu File { path: "kiso/aot/lowerwinrt/runtime_objects.mio", version: "Bunko-v2.1.1", length: 21964, sha256: "03b27a68a57e57e47f3a27b98e2a5957b5df52a246a74ff42f66f290491f5dd2", source: "yobu \"kiso/aot/elf\";\nyobu \"kiso/aot/x86_64\";\n\n// Linux object model (all words are 64-bit; every heap object starts with\n// [0] header = kind | total_bytes << 8, [8] GC word).\n//   kind 1 struct, kind 2 enum:  [16] payload count, [24] reference bitmap, [32] enum tag, [40 + 8i] payload i\n//   kind 3 array:                [16] length, [24] capacity, [32] width | reference << 8, [40] data pointer\n//   kind 4 byte backing, kind 5 word backing (data starts at +16 of the backing object)\n//   kind 6 string:               [16] byte length, [24 ...] bytes\nwaza object_kind_struct() -> int64 { kaesu 1; }\nwaza object_kind_enum() -> int64 { kaesu 2; }\nwaza object_kind_array() -> int64 { kaesu 3; }\n\nwaza trap_check(code: x86_64.Assembler, condition: int64, label: string) -> unit { x86_64.jcc(code, condition, label); }\n\n// round rax up to a multiple of 8\nwaza round8(code: x86_64.Assembler, reg: int64) -> unit {\n    x86_64.add_ri(code, reg, 7);\n    x86_64.and_ri(code, reg, -8);\n}\n\n// rt.array_new: rdi = length, rsi = capacity, rdx = element width (1 or 8), r8 = 1 when elements are references.\n// Returns the array in rax. Negative or too large sizes trap.\nwaza emit_array_new(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.array_new\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.trap.index\");\n    x86_64.cmp_rr(code, x86_64.rsi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.trap.index\");\n    x86_64.mov_ri(code, x86_64.rax, 134217728);\n    x86_64.cmp_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_g, \"rt.trap.memory\");\n    x86_64.push_r(code, x86_64.rdi);\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.push_r(code, x86_64.rdx);\n    x86_64.push_r(code, x86_64.r8);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.imul_rr(code, x86_64.rax, x86_64.rdx);\n    round8(code, x86_64.rax);\n    x86_64.add_ri(code, x86_64.rax, 16);\n    x86_64.call(code, \"rt.alloc\");\n    // backing header = kind | size << 8\n    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 0);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 8);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 16);\n    x86_64.mov_rr(code, x86_64.r9, x86_64.rcx);\n    x86_64.imul_rr(code, x86_64.r9, x86_64.rdx);\n    round8(code, x86_64.r9);\n    x86_64.add_ri(code, x86_64.r9, 16);\n    x86_64.shl_ri(code, x86_64.r9, 8);\n    x86_64.add_rr(code, x86_64.r9, x86_64.r8);\n    x86_64.add_ri(code, x86_64.r9, 4);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.r9);\n    x86_64.push_r(code, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 48);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_ri(code, x86_64.rcx, 48 * 256 + 3);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 32);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 24);\n    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 8);\n    x86_64.shl_ri(code, x86_64.rcx, 8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 16);\n    x86_64.add_rr(code, x86_64.rcx, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rax, 32, x86_64.rcx);\n    x86_64.pop_r(code, x86_64.rcx);\n    x86_64.add_ri(code, x86_64.rcx, 16);\n    x86_64.mov_store(code, x86_64.rax, 40, x86_64.rcx);\n    x86_64.add_ri(code, x86_64.rsp, 32);\n    x86_64.ret(code);\n}\n\n// rt.array_grow: rdi = array, rsi = minimum capacity.\nwaza emit_array_grow(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.array_grow\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 24);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_ge, \"rt.array_grow.done\");\n    x86_64.add_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_ge, \"rt.array_grow.big\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.label(code, \"rt.array_grow.big\");\n    x86_64.cmp_ri(code, x86_64.rax, 4);\n    x86_64.jcc(code, x86_64.cc_ge, \"rt.array_grow.sized\");\n    x86_64.mov_ri(code, x86_64.rax, 4);\n    x86_64.label(code, \"rt.array_grow.sized\");\n    x86_64.mov_ri(code, x86_64.rcx, 134217728);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_g, \"rt.trap.memory\");\n    x86_64.push_r(code, x86_64.rdi);\n    x86_64.push_r(code, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 32);\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rcx);\n    x86_64.and_ri(code, x86_64.rdx, 255);\n    x86_64.imul_rr(code, x86_64.rax, x86_64.rdx);\n    round8(code, x86_64.rax);\n    x86_64.add_ri(code, x86_64.rax, 16);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rsp, 8);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 32);\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rcx);\n    x86_64.and_ri(code, x86_64.rdx, 255);\n    x86_64.shr_ri(code, x86_64.rcx, 8);\n    x86_64.add_ri(code, x86_64.rcx, 4);\n    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 0);\n    x86_64.imul_rr(code, x86_64.r8, x86_64.rdx);\n    round8(code, x86_64.r8);\n    x86_64.add_ri(code, x86_64.r8, 16);\n    x86_64.shl_ri(code, x86_64.r8, 8);\n    x86_64.add_rr(code, x86_64.r8, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.r8);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rdi, 40);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 16);\n    x86_64.imul_rr(code, x86_64.rcx, x86_64.rdx);\n    x86_64.lea(code, x86_64.r9, x86_64.rax, 16);\n    x86_64.mov_rr(code, x86_64.r10, x86_64.rdi);\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.r9);\n    x86_64.rep_movsb(code);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 0);\n    x86_64.mov_store(code, x86_64.r10, 24, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.r10, 40, x86_64.r9);\n    x86_64.add_ri(code, x86_64.rsp, 16);\n    x86_64.label(code, \"rt.array_grow.done\");\n    x86_64.ret(code);\n}\n\n// rt.array_get: rdi = array, rsi = index -> rax = element.\nwaza emit_array_get(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.array_get\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 16);\n    x86_64.cmp_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ae, \"rt.trap.index\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 32);\n    x86_64.and_ri(code, x86_64.rcx, 255);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 40);\n    x86_64.cmp_ri(code, x86_64.rcx, 1);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.array_get.wide\");\n    x86_64.add_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_load8(code, x86_64.rax, x86_64.rax, 0);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.array_get.wide\");\n    x86_64.shl_ri(code, x86_64.rsi, 3);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 0);\n    x86_64.ret(code);\n}\n\n// rt.array_set: rdi = array, rsi = index, rdx = value.\nwaza emit_array_set(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.array_set\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 16);\n    x86_64.cmp_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ae, \"rt.trap.index\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 32);\n    x86_64.and_ri(code, x86_64.rcx, 255);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 40);\n    x86_64.cmp_ri(code, x86_64.rcx, 1);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.array_set.wide\");\n    x86_64.add_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_store8(code, x86_64.rax, 0, x86_64.rdx);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.array_set.wide\");\n    x86_64.shl_ri(code, x86_64.rsi, 3);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rdx);\n    x86_64.ret(code);\n}\n\n// rt.array_push: rdi = array, rdx = element.\nwaza emit_array_push(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.array_push\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 16);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 24);\n    x86_64.cmp_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.array_push.store\");\n    x86_64.push_r(code, x86_64.rdi);\n    x86_64.push_r(code, x86_64.rdx);\n    x86_64.lea(code, x86_64.rsi, x86_64.rcx, 1);\n    x86_64.call(code, \"rt.array_grow\");\n    x86_64.pop_r(code, x86_64.rdx);\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.label(code, \"rt.array_push.store\");\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rdi, 16);\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.call(code, \"rt.array_set_unchecked\");\n    x86_64.pop_r(code, x86_64.rsi);\n    x86_64.add_ri(code, x86_64.rsi, 1);\n    x86_64.mov_store(code, x86_64.rdi, 16, x86_64.rsi);\n    x86_64.ret(code);\n    // the slot at `length` lies inside the capacity, so the bounds check of array_set must not apply\n    x86_64.label(code, \"rt.array_set_unchecked\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 32);\n    x86_64.and_ri(code, x86_64.rcx, 255);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 40);\n    x86_64.cmp_ri(code, x86_64.rcx, 1);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.array_set_unchecked.wide\");\n    x86_64.add_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_store8(code, x86_64.rax, 0, x86_64.rdx);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.array_set_unchecked.wide\");\n    x86_64.shl_ri(code, x86_64.rsi, 3);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rdx);\n    x86_64.ret(code);\n}\n\n// rt.array_truncate: rdi = array, rsi = new length (0 <= new <= length).\nwaza emit_array_truncate(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.array_truncate\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 16);\n    x86_64.cmp_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.trap.index\");\n    x86_64.mov_store(code, x86_64.rdi, 16, x86_64.rsi);\n    x86_64.ret(code);\n}\n\n// rt.array_reserve: rdi = array, rsi = additional capacity (>= 0).\nwaza emit_array_reserve(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.array_reserve\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.trap.index\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 16);\n    x86_64.add_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.call(code, \"rt.array_grow\");\n    x86_64.ret(code);\n}\n\n// rt.array_clone: rdi = array -> rax = a new array with its own backing store.\nwaza emit_array_clone(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.array_clone\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.push_r(code, x86_64.rdi);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rdi, 16);\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rsi);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 0);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rax, 32);\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rdx);\n    x86_64.shr_ri(code, x86_64.r8, 8);\n    x86_64.and_ri(code, x86_64.rdx, 255);\n    x86_64.call(code, \"rt.array_new\");\n    x86_64.pop_r(code, x86_64.rsi);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsi, 16);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsi, 32);\n    x86_64.and_ri(code, x86_64.rdx, 255);\n    x86_64.imul_rr(code, x86_64.rcx, x86_64.rdx);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rsi, 40);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rax, 40);\n    x86_64.rep_movsb(code);\n    x86_64.ret(code);\n}\n\n// rt.array_append_all: rdi = destination, rsi = source.\nwaza emit_array_append_all(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.array_append_all\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.push_r(code, x86_64.rdi);\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 16);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsi, 16);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.call(code, \"rt.array_grow\");\n    x86_64.pop_r(code, x86_64.rsi);\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rdi, 32);\n    x86_64.and_ri(code, x86_64.rdx, 255);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsi, 16);\n    x86_64.mov_load(code, x86_64.r8, x86_64.rdi, 16);\n    x86_64.mov_load(code, x86_64.r9, x86_64.rdi, 40);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.r8);\n    x86_64.imul_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.add_rr(code, x86_64.r9, x86_64.rax);\n    x86_64.add_rr(code, x86_64.r8, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rdi, 16, x86_64.r8);\n    x86_64.imul_rr(code, x86_64.rcx, x86_64.rdx);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rsi, 40);\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.r9);\n    x86_64.rep_movsb(code);\n    x86_64.ret(code);\n}\n\n// rt.array_fill: rax = array, rdx = value; sets every element below the length.\nwaza emit_ar