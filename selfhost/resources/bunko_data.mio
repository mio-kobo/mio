nction(f,\"gc_sweep_world_resumed\",5,[10]);ir.branch(f,ir.label,0,\"failed\");ir.put(f,ir.result,0,5,0,0);kaesu f;\n}\nwaza sweep_old_prepare_program() -> ir.Function {\n kaku f=ir.function(\"gc_old_prepare\");ir.invoke_function(f,\"gc_sweep_abort_join\",6,[0]);ir.branch(f,ir.nonzero,6,\"failed\");ir.invoke_function(f,\"gc_old_prepare_mark_base\",6,[0,1,2,3,4,5]);ir.branch(f,ir.label,0,\"failed\");ir.put(f,ir.result,0,6,0,0);kaesu f;\n}\nwaza sweep_old_remark_program() -> ir.Function {\n kaku f=ir.function(\"gc_old_remark\");ir.invoke_function(f,\"gc_old_remark_mark_base\",5,[0,1]);ir.branch(f,ir.nonzero,5,\"failed\");ir.invoke_function(f,\"gc_sweep_prepare\",5,[0]);ir.branch(f,ir.nonzero,5,\"failed\");ir.invoke_function(f,\"gc_sweep_launch\",5,[0]);ir.branch(f,ir.label,0,\"failed\");ir.put(f,ir.result,0,5,0,0);kaesu f;\n}\nwaza sweep_old_abort_program() -> ir.Function {\n kaku f=ir.function(\"gc_old_abort_join\");ir.invoke_function(f,\"gc_old_abort_mark_join\",10,[0]);ir.invoke_function(f,\"gc_sweep_abort_join\",5,[0]);ir.branch(f,ir.nonzero,5,\"failed\");ir.put(f,ir.copy,5,10,0,0);ir.branch(f,ir.label,0,\"failed\");ir.put(f,ir.result,0,5,0,0);kaesu f;\n}\nkoukai waza concurrent_sweep_program(functions:[]ir.Function,control_link_offset:int64,owned_context_bytes:int64) -> []ir.Function {\n kaku result:[]ir.Function=[];moshi(control_link_offset<thread_context_bytes || owned_context_bytes<8 || control_link_offset>owned_context_bytes-8 || control_link_offset-(control_link_offset/8)*8!=0){kaesu result;}\n kaku names=[\"gc_old_inspect\",\"gc_old_prepare\",\"gc_old_remark\",\"gc_old_abort_join\",\"gc_heap_enter\",\"gc_end\",\"gc_old_note_minor\",\"gc_old_promoted\",\"gc_old_cancel\"];\n kaku bases=[\"gc_old_inspect_base\",\"gc_old_prepare_mark_base\",\"gc_old_remark_mark_base\",\"gc_old_abort_mark_join\",\"gc_heap_enter_base\",\"gc_end_mark_base\",\"gc_old_note_minor_mark_base\",\"gc_old_promoted_mark_base\",\"gc_old_cancel_mark_base\"];\n kaku found=0;kaku i=0;aida(i<len(functions)){kaku f=functions[i];kaku j=0;kaku which=-1;aida(j<len(names)){moshi(f.name==names[j]){which=j;}j=j+1;}moshi(which<0){array.push(result,f);}sore{array.push(result,ir.Function {name:bases[which],steps:f.steps});found=found+1;}i=i+1;}moshi(found!=len(names)){kaku invalid:[]ir.Function=[];kaesu invalid;}\n array.append_all(result,[sweep_lock_program(),sweep_unlock_program(),sweep_side_program(),sweep_inspect_program(),sweep_remembered_program(),sweep_step_program(),sweep_worker_program(),sweep_join_program(),sweep_clear_claims_program(),sweep_abort_program(),sweep_prepare_program(),sweep_launch_program(),sweep_resumed_program(),sweep_observe_program(),sweep_finish_program(),sweep_retry_program(),sweep_heap_enter_program(control_link_offset),sweep_end_epoch_program(control_link_offset),sweep_old_prepare_program(),sweep_old_remark_program(),sweep_old_abort_program(),sweep_minor_note_program(),sweep_promotion_note_program(),sweep_reused_program(),sweep_cancel_old_program()]);kaesu result;\n}\n\n// Actual collection/promotion hooks; final totals alone cannot prove they\n// occurred while Sweep was running. A Mutator must own the same allocator lock.\nwaza sweep_minor_note_program() -> ir.Function {\n kaku f=ir.function(\"gc_old_note_minor\");ir.invoke_function(f,\"gc_old_note_minor_mark_base\",5,[0]);ir.branch(f,ir.nonzero,5,\"failed\");ir.put(f,ir.acquire_load,5,0,0,712);tconstant(f,6,2);ir.put(f,ir.equal,6,5,6,0);ir.branch(f,ir.zero,6,\"done\");ir.put(f,ir.acquire_load,6,0,0,512);ir.branch(f,ir.zero,6,\"invalid\");tcheck(f,6,1,\"invalid\");tconstant(f,5,1);sweep_add(f,768,5);ir.branch(f,ir.label,0,\"done\");treturn(f,0);ir.branch(f,ir.label,0,\"invalid\");tconstant(f,5,4);sweep_fail(f,5);ir.branch(f,ir.label,0,\"failed\");ir.put(f,ir.result,0,5,0,0);kaesu f;\n}\nwaza sweep_promotion_note_program() -> ir.Function {\n kaku f=ir.function(\"gc_old_promoted\");ir.invoke_function(f,\"gc_old_promoted_mark_base\",5,[0,1]);ir.branch(f,ir.nonzero,5,\"failed\");ir.put(f,ir.acquire_load,5,0,0,712);tconstant(f,6,2);ir.put(f,ir.equal,6,5,6,0);ir.branch(f,ir.zero,6,\"done\");ir.put(f,ir.acquire_load,6,0,0,512);ir.branch(f,ir.zero,6,\"invalid\");tcheck(f,6,1,\"invalid\");ir.branch(f,ir.zero,1,\"invalid\");tconstant(f,6,16);ir.put(f,ir.subtract,10,1,6,0);ir.put(f,ir.acquire_load,10,10,0,0);old_bit(f,10,11,sweep_claim_bit);ir.branch(f,ir.nonzero,11,\"invalid\");old_bit(f,10,11,old_generation_bit);ir.branch(f,ir.zero,11,\"invalid\");tconstant(f,5,1);sweep_add(f,776,5);ir.branch(f,ir.label,0,\"done\");treturn(f,0);ir.branch(f,ir.label,0,\"invalid\");tconstant(f,5,4);sweep_fail(f,5);ir.branch(f,ir.label,0,\"failed\");ir.put(f,ir.result,0,5,0,0);kaesu f;\n}\n\n// Called only from the actual native allocator free-bin take, before the new\n// object header overwrites the free span. side.rememberedNext is unused on a\n// free header and records this exact Sweep epoch; gen_register clears it.\nwaza sweep_reused_program() -> ir.Function {\n kaku f=ir.function(\"gc_sweep_reused\");ir.put(f,ir.acquire_load,5,0,0,512);ir.branch(f,ir.zero,5,\"invalid\");tcheck(f,5,1,\"invalid\");ir.put(f,ir.acquire_load,10,1,0,0);ir.branch(f,ir.nonzero,10,\"invalid\");ir.invoke_function(f,\"gc_sweep_side\",10,[0,1]);ir.put(f,ir.load,11,10,0,8);ir.put(f,ir.load,12,0,0,704);ir.branch(f,ir.zero,12,\"done\");ir.put(f,ir.equal,13,11,12,0);ir.branch(f,ir.zero,13,\"done\");tconstant(f,5,1);sweep_add(f,816,5);ir.put(f,ir.acquire_load,5,0,0,712);tconstant(f,6,2);ir.put(f,ir.equal,6,5,6,0);ir.branch(f,ir.zero,6,\"done\");tconstant(f,5,1);sweep_add(f,808,5);ir.put(f,ir.load,5,0,0,824);ir.branch(f,ir.nonzero,5,\"done\");ir.put(f,ir.release_store,0,0,1,824);ir.put(f,ir.release_store,0,0,12,832);ir.branch(f,ir.label,0,\"done\");treturn(f,0);ir.branch(f,ir.label,0,\"invalid\");tconstant(f,5,4);sweep_fail(f,5);treturn(f,4);kaesu f;\n}\n\nwaza sweep_cancel_old_program() -> ir.Function {\n kaku f=ir.function(\"gc_old_cancel\");ir.invoke_function(f,\"gc_old_cancel_mark_base\",5,[0]);ir.put(f,ir.acquire_load,5,0,0,712);ir.branch(f,ir.zero,5,\"done\");tcheck(f,5,3,\"done\");tcheck(f,5,4,\"done\");tconstant(f,5,4);ir.put(f,ir.release_store,0,0,5,712);ir.branch(f,ir.label,0,\"done\");treturn(f,0);kaesu f;\n}\n" }; }
waza data_90() -> File { kaesu File { path: "kiso/runtime/gc/operations.mio", version: "Bunko-v2.1.1", length: 3622, sha256: "7e0ddecb6d2753dfb89cd83418cda46ee571ff551603c3f8fe27decaa03a7cd4", source: "// Semantic runtime IR. Operands are virtual values, never CPU registers.\n// Operations return status explicitly; failure may not be silently discarded.\nkoukai teisu relaxed = 0;\nkoukai teisu acquire = 1;\nkoukai teisu release = 2;\nkoukai teisu acq_rel = 3;\nkoukai teisu seq_cst = 4;\nkoukai teisu atomic_load = 1;\nkoukai teisu atomic_store = 2;\nkoukai teisu atomic_cas = 3;\nkoukai teisu atomic_add = 4;\nkoukai teisu fence = 5;\nkoukai teisu thread_start = 6;\nkoukai teisu thread_join = 7;\nkoukai teisu thread_identity = 8;\nkoukai teisu tls_get = 9;\nkoukai teisu tls_set = 10;\nkoukai teisu park = 11;\nkoukai teisu wake = 12;\nkoukai teisu reserve = 13;\nkoukai teisu commit = 14;\nkoukai teisu decommit = 15;\nkoukai teisu memory_release = 16;\nkoukai teisu clock = 17;\nkoukai teisu pressure = 18;\nkoukai teisu roots = 19;\nkoukai teisu safepoint = 20;\nkoukai teisu write_barrier = 21;\nkoukai teisu protect = 22;\nkoukai teisu tls_create = ir.tls_create;\nkoukai teisu tls_destroy = ir.tls_destroy;\nkoukai teisu mutex_create = ir.mutex_create;\nkoukai teisu mutex_destroy = ir.mutex_destroy;\nkoukai teisu mutex_lock = ir.mutex_lock;\nkoukai teisu mutex_unlock = ir.mutex_unlock;\nkoukai teisu condition_create = ir.condition_create;\nkoukai teisu condition_destroy = ir.condition_destroy;\nkoukai teisu abort_runtime = ir.abort_runtime;\n\n// CAS returns the observed old value. On failure no store occurs. Failure\n// order cannot release or exceed success order. Strong CAS retries spurious\n// failure. RMW arithmetic wraps at 64 bits. Addresses must be 8-byte aligned.\n// Park compares the wait word with expected while holding the wait protocol's\n// lock, atomically releases it while sleeping and rechecks after every wake.\n// Deadlines use monotonic nanoseconds; timeout/failure is distinct from wake.\n// Roots requires a completed handshake for this epoch, never a running frame.\n// Barrier preserves overwritten references BEFORE publishing the new edge and\n// records Old->Young AFTER it. Its operands must carry precise layout identity.\nkoukai kata RuntimeOp {\n    kind: int64; address: int64; value: int64; expected: int64;\n    result: int64; status: int64; order: int64; failure_order: int64;\n    alignment: int64; epoch: int64;\n}\nkoukai waza operation(kind: int64) -> RuntimeOp {\n    kaesu RuntimeOp { kind: kind, address: 0, value: 1, expected: 2,\n        result: 3, status: 4, order: relaxed, failure_order: relaxed,\n        alignment: 8, epoch: 0 };\n}\nkoukai waza valid_operation(op: RuntimeOp) -> bool {\n    moshi (op.kind < atomic_load || op.kind > abort_runtime || op.address < 0 ||\n        op.value < 0 || op.expected < 0 || op.result < 0 || op.status < 0 ||\n        op.epoch < 0 || op.order < relaxed || op.order > seq_cst ||\n        op.failure_order < relaxed || op.failure_order > seq_cst) { kaesu iie; }\n    moshi (op.kind <= atomic_add && (op.alignment < 8 || op.alignment - (op.alignment / 8) * 8 != 0)) { kaesu iie; }\n    moshi (op.kind == atomic_load && op.order != relaxed && op.order != acquire && op.order != seq_cst) { kaesu iie; }\n    moshi (op.kind == atomic_store && op.order != relaxed && op.order != release && op.order != seq_cst) { kaesu iie; }\n    moshi (op.kind == atomic_cas) {\n        moshi (op.failure_order != relaxed && op.failure_order != acquire && op.failure_order != seq_cst) { kaesu iie; }\n        moshi (op.failure_order == acquire && op.order != acquire && op.order != acq_rel && op.order != seq_cst) { kaesu iie; }\n        moshi (op.failure_order == seq_cst && op.order != seq_cst) { kaesu iie; }\n    }\n    moshi (op.kind == fence && op.order == relaxed) { kaesu iie; }\n    kaesu hai;\n}\n" }; }
waza data_91() -> File { kaesu File { path: "kiso/runtime/gc/protocol.mio", version: "Bunko-v2.1.1", length: 2353, sha256: "7a8007f52c986fd9b109b42ef5c270381965515c3f70cc7306c9469de3125b43", source: "// Platform-independent collector phase protocol. Scalar-only functions can be\n// compiled without managed allocation. Backend integration is gated separately:\n// these predicates do not by themselves stop threads or publish roots.\nkoukai teisu idle = 0;\nkoukai teisu init_handshake = 1;\nkoukai teisu concurrent_mark = 2;\nkoukai teisu remark_handshake = 3;\nkoukai teisu concurrent_sweep = 4;\nkoukai teisu aborted = 5;\n// Every predicate describes the CURRENT epoch. Callers must acquire the epoch\n// snapshot before evaluating; stale acknowledgements cannot count as parked.\n// A failure enters a non-reclaiming terminal phase. Recovery requires a full\n// join + stop + reinitialize protocol, never a transition directly back to Idle.\nkoukai waza next_phase(phase:int64, requested:bool, all_parked:bool,\n    roots_complete:bool, queues_empty:bool, producers_quiet:bool,\n    sweep_complete:bool, readers_quiet:bool, failed:bool) -> int64 {\n    moshi(phase<idle || phase>aborted){kaesu -1;}\n    moshi(failed || phase==aborted){kaesu aborted;}\n    moshi(phase==idle){moshi(requested){kaesu init_handshake;}kaesu idle;}\n    moshi(phase==init_handshake){moshi(all_parked && roots_complete){kaesu concurrent_mark;}kaesu init_handshake;}\n    moshi(phase==concurrent_mark){moshi(queues_empty && producers_quiet){kaesu remark_handshake;}kaesu concurrent_mark;}\n    moshi(phase==remark_handshake){\n        moshi(all_parked && roots_complete && queues_empty && producers_quiet){kaesu concurrent_sweep;}\n        kaesu remark_handshake;\n    }\n    moshi(sweep_complete && readers_quiet){kaesu idle;}\n    kaesu concurrent_sweep;\n}\nkoukai waza minor_allowed(phase:int64) -> bool {kaesu phase==idle;}\nkoukai waza may_reclaim(phase:int64, proven_dead:bool, readers_quiet:bool, epoch_matches:bool) -> bool {\n    kaesu phase==concurrent_sweep && proven_dead && readers_quiet && epoch_matches;\n}\nkoukai waza needs_satb(phase:int64, pointer_slot:bool) -> bool {\n    kaesu pointer_slot && (phase==concurrent_mark || phase==remark_handshake);\n}\n// Queue exhaustion must request remark/backpressure before overwriting a slot.\n// Until the old reference has been published/drained, the pointer store is held.\nkoukai waza pointer_store_allowed(phase:int64, pointer_slot:bool, old_reference_saved:bool) -> bool {\n    kaesu !needs_satb(phase,pointer_slot) || old_reference_saved;\n}\n" }; }
waza data_92() -> File { kaesu File { path: "kiso/runtime/gc/safepoints.mio", version: "Bunko-v2.1.1", length: 10850, sha256: "6403ba25da818d3ff0b4591a84be05bd6ab73be25c212e98edcc96495a815857", source: "// Shadow descriptor v2 is additive: direct frames retain their original ABI.\nkoukai teisu shadow_indirect_factor=4294967296;\n// Cooperative thread/registry ABI v3 extends the v2 registry with two words.\n// The object heap ABI is unchanged. All algorithms here emit neutral runtime IR.\nkoukai teisu gc_registry_bytes=80;\nkoukai teisu gc_registry_epoch=48;\nkoukai teisu gc_registry_owner=56;\nkoukai teisu gc_registry_heartbeat=64;\nkoukai teisu gc_registry_phase=72;\nkoukai teisu gc_handshake=1;\nkoukai teisu gc_stopped=2;\nkoukai teisu thread_gc_parked=3;\nkoukai teisu gc_visit_root_operation=200;\nwaza gc_heartbeat(f:ir.Function,registry:int64) -> unit {\n    ir.put(f,ir.load,29,registry,0,gc_registry_heartbeat);tconstant(f,30,1);ir.put(f,ir.add,29,29,30,0);ir.put(f,ir.release_store,0,registry,29,gc_registry_heartbeat);\n}\nwaza gc_park_locked_program() -> ir.Function {\n    // Caller holds this context's mutex. On return it still holds that mutex.\n    // A returned error never authorizes resuming while a collector is active.\n    // A stuck owner causes process abort rather than releasing live root frames.\n    kaku f=ir.function(\"gc_park_locked\");tprepare(f);tload(f,10,thread_registry);ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.branch(f,ir.zero,11,\"idle\");ir.put(f,ir.equal,12,11,0,0);ir.branch(f,ir.nonzero,12,\"idle\");\n    tload(f,13,thread_progress);ir.put(f,ir.acquire_load,12,10,0,gc_registry_epoch);ir.put(f,ir.release_store,0,0,12,thread_ack_epoch);ir.put(f,ir.copy,19,12,0,0);tpublish(f,thread_progress,thread_gc_parked);\n    ir.put(f,ir.acquire_load,15,10,0,gc_registry_heartbeat);ir.invoke_function(f,\"platform_now\",14,[]);tconstant(f,16,30000000000);ir.put(f,ir.add,14,14,16,0);\n    ir.branch(f,ir.label,0,\"wait\");ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.branch(f,ir.zero,11,\"resumed\");ir.put(f,ir.acquire_load,12,10,0,gc_registry_epoch);ir.put(f,ir.release_store,0,0,12,thread_ack_epoch);ir.put(f,ir.copy,19,12,0,0);\n    ir.put(f,ir.acquire_load,12,10,0,gc_registry_heartbeat);ir.put(f,ir.equal,17,12,15,0);ir.branch(f,ir.nonzero,17,\"check_deadline\");ir.put(f,ir.copy,15,12,0,0);ir.invoke_function(f,\"platform_now\",14,[]);ir.put(f,ir.add,14,14,16,0);\n    ir.branch(f,ir.label,0,\"check_deadline\");ir.invoke_function(f,\"platform_now\",17,[]);ir.put(f,ir.less_unsigned,18,17,14,0);ir.branch(f,ir.zero,18,\"fatal\");\n    tload(f,2,thread_mutex);tload(f,3,thread_condition);tconstant(f,4,10000000);ir.invoke_function(f,\"platform_wait\",5,[3,2,4]);ir.branch(f,ir.zero,5,\"wait\");tcheck(f,5,1,\"wait\");terror(f,5);ir.branch(f,ir.jump,0,\"wait\");\n    // Publish the Epoch actually acknowledged while parked. A new owner can\n    // publish its next Epoch after our zero-owner load; do not label that\n    // unacknowledged future request as a completed park.\n    ir.branch(f,ir.label,0,\"resumed\");ir.put(f,ir.release_store,0,0,19,thread_seen_epoch);ir.put(f,ir.release_store,0,0,13,thread_progress);treturn(f,0);\n    ir.branch(f,ir.label,0,\"idle\");treturn(f,0);\n    ir.branch(f,ir.label,0,\"fatal\");tconstant(f,1,81);ir.call(f,abort_runtime,1,[1]);treturn(f,3);kaesu f;\n}\nwaza gc_poll_program() -> ir.Function {\n    kaku f=ir.function(\"gc_poll\");tprepare(f);ir.put(f,ir.release_store,0,0,1,thread_shadow);tload(f,10,thread_registry);ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.branch(f,ir.zero,11,\"done\");ir.put(f,ir.equal,12,11,0,0);ir.branch(f,ir.nonzero,12,\"done\");\n    tload(f,2,thread_mutex);ir.call(f,ir.mutex_lock,1,[2]);ir.branch(f,ir.nonzero,1,\"fatal\");ir.invoke_function(f,\"gc_park_locked\",3,[0]);ir.call(f,ir.mutex_unlock,1,[2]);ir.branch(f,ir.nonzero,1,\"fatal\");ir.put(f,ir.result,0,3,0,0);\n    ir.branch(f,ir.label,0,\"done\");treturn(f,0);\n    ir.branch(f,ir.label,0,\"fatal\");tconstant(f,1,82);ir.call(f,abort_runtime,1,[1]);treturn(f,3);kaesu f;\n}\nwaza gc_end_program() -> ir.Function {\n    // The owner retains the registry lock throughout root scanning/collection.\n    // Unpublish before wake; periodic waits also observe release if wake fails.\n    kaku f=ir.function(\"gc_end\");tprepare(f);tload(f,10,thread_registry);ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.put(f,ir.equal,12,11,0,0);ir.branch(f,ir.zero,12,\"not_owner\");\n    tconstant(f,12,0);ir.put(f,ir.release_store,0,10,12,gc_registry_phase);ir.put(f,ir.release_store,0,10,12,gc_registry_owner);ir.put(f,ir.load,11,10,0,32);\n    ir.branch(f,ir.label,0,\"wake\");ir.branch(f,ir.zero,11,\"unlock\");ir.put(f,ir.load,12,11,0,thread_condition);ir.invoke_function(f,\"platform_wake_all\",1,[12]);ir.put(f,ir.load,11,11,0,thread_next);ir.branch(f,ir.jump,0,\"wake\");\n    ir.branch(f,ir.label,0,\"unlock\");ir.invoke_function(f,\"registry_unlock\",1,[0]);treturn(f,0);\n    ir.branch(f,ir.label,0,\"not_owner\");treturn(f,4);kaesu f;\n}\nwaza gc_begin_program() -> ir.Function {\n    kaku f=ir.function(\"gc_begin\");tprepare(f);ir.invoke_function(f,\"gc_poll\",2,[0,1]);ir.invoke_function(f,\"registry_lock\",2,[0]);ir.branch(f,ir.nonzero,2,\"failed_lock\");\n    tload(f,10,thread_registry);ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.branch(f,ir.nonzero,11,\"unlock_failed\");ir.put(f,ir.load,11,10,0,gc_registry_epoch);tconstant(f,12,-1);ir.put(f,ir.equal,12,11,12,0);ir.branch(f,ir.nonzero,12,\"unlock_failed\");\n    tconstant(f,12,1);ir.put(f,ir.add,11,11,12,0);ir.put(f,ir.release_store,0,10,11,gc_registry_epoch);ir.put(f,ir.release_store,0,0,11,thread_ack_epoch);ir.put(f,ir.release_store,0,10,12,gc_registry_phase);ir.put(f,ir.release_store,0,10,0,gc_registry_owner);gc_heartbeat(f,10);\n    ir.invoke_function(f,\"platform_now\",20,[]);tconstant(f,21,1000000000);ir.put(f,ir.add,20,20,21,0);\n    ir.branch(f,ir.label,0,\"retry\");ir.put(f,ir.load,13,10,0,32);tconstant(f,14,0);\n    ir.branch(f,ir.label,0,\"member\");ir.branch(f,ir.zero,13,\"check_all\");ir.put(f,ir.equal,15,13,0,0);ir.branch(f,ir.nonzero,15,\"next\");\n    ir.put(f,ir.acquire_load,15,13,0,thread_error);ir.branch(f,ir.nonzero,15,\"abort\");ir.put(f,ir.load,16,13,0,thread_mutex);ir.invoke_function(f,\"platform_trylock\",17,[16]);tcheck(f,17,1,\"not_ready\");ir.branch(f,ir.nonzero,17,\"abort\");\n    ir.put(f,ir.acquire_load,18,13,0,thread_progress);tcheck(f,18,thread_parked,\"ack_blocked\");tcheck(f,18,thread_finished,\"ack_blocked\");\n    tcheck(f,18,thread_gc_parked,\"check_parked_ack\");ir.branch(f,ir.jump,0,\"not_ready_unlock\");\n    ir.branch(f,ir.label,0,\"check_parked_ack\");ir.put(f,ir.acquire_load,18,13,0,thread_ack_epoch);ir.put(f,ir.equal,18,18,11,0);ir.branch(f,ir.nonzero,18,\"ready_unlock\");\n    ir.branch(f,ir.label,0,\"not_ready_unlock\");tconstant(f,14,1);ir.branch(f,ir.jump,0,\"ready_unlock\");\n    ir.branch(f,ir.label,0,\"ack_blocked\");ir.put(f,ir.release_store,0,13,11,thread_ack_epoch);\n    ir.branch(f,ir.label,0,\"ready_unlock\");ir.call(f,ir.mutex_unlock,17,[16]);ir.branch(f,ir.nonzero,17,\"abort\");ir.branch(f,ir.jump,0,\"next\");\n    ir.branch(f,ir.label,0,\"not_ready\");tconstant(f,14,1);\n    ir.branch(f,ir.label,0,\"next\");ir.put(f,ir.load,13,13,0,thread_next);ir.branch(f,ir.jump,0,\"member\");\n    ir.branch(f,ir.label,0,\"check_all\");ir.branch(f,ir.zero,14,\"stopped\");ir.invoke_function(f,\"platform_now\",21,[]);ir.put(f,ir.less_unsigned,21,21,20,0);ir.branch(f,ir.nonzero,21,\"retry\");\n    ir.branch(f,ir.label,0,\"abort\");ir.invoke_function(f,\"gc_end\",2,[0]);treturn(f,2);\n    ir.branch(f,ir.label,0,\"stopped\");tconstant(f,12,gc_stopped);ir.put(f,ir.release_store,0,10,12,gc_registry_phase);gc_heartbeat(f,10);treturn(f,0);\n    ir.branch(f,ir.label,0,\"unlock_failed\");ir.invoke_function(f,\"registry_unlock\",2,[0]);treturn(f,4);\n    ir.branch(f,ir.label,0,\"failed_lock\");ir.put(f,ir.result,0,2,0,0);kaesu f;\n}\nwaza gc_scan_frames_program(max_roots:int64) -> ir.Function {\n    // arg0 coordinator, arg1 exact compiler-produced frame. Descriptor low32\n    // is total entries, high32 is the leading indirect global-slot count.\n    // Old direct frames keep high32==0. Globals are dereferenced only here,\n    // after gc_scan_roots verified stopped ownership and every thread epoch.\n    kaku f=ir.function(\"gc_scan_frames\");tprepare(f);ir.put(f,ir.copy,10,1,0,0);tconstant(f,11,0);\n    ir.branch(f,ir.label,0,\"frame\");ir.branch(f,ir.zero,10,\"done\");tconstant(f,12,1024);ir.put(f,ir.less_unsigned,12,11,12,0);ir.branch(f,ir.zero,12,\"invalid\");tconstant(f,12,1);ir.put(f,ir.add,11,11,12,0);\n    ir.put(f,ir.load,12,10,0,8);tconstant(f,20,shadow_indirect_factor);ir.put(f,ir.divide_unsigned,19,12,20,0);ir.put(f,ir.multiply,20,19,20,0);ir.put(f,ir.subtract,12,12,20,0);ir.put(f,ir.less_unsigned,20,12,19,0);ir.branch(f,ir.nonzero,20,\"invalid\");tconstant(f,13,max_roots+1);ir.put(f,ir.less_unsigned,13,12,13,0);ir.branch(f,ir.zero,13,\"invalid\");tconstant(f,13,0);ir.put(f,ir.address,14,10,0,16);tconstant(f,15,8);\n    ir.branch(f,ir.label,0,\"value\");ir.put(f,ir.equal,16,13,12,0);ir.branch(f,ir.nonzero,16,\"next_frame\");ir.put(f,ir.multiply,16,13,15,0);ir.put(f,ir.add,16,14,16,0);ir.put(f,ir.load,17,16,0,0);ir.put(f,ir.less_unsigned,20,13,19,0);ir.branch(f,ir.zero,20,\"direct_value\");ir.branch(f,ir.zero,17,\"invalid\");ir.put(f,ir.load,17,17,0,0);ir.branch(f,ir.label,0,\"direct_value\");ir.call(f,gc_visit_root_operation,18,[0,17,2]);ir.branch(f,ir.nonzero,18,\"invalid\");tconstant(f,16,1);ir.put(f,ir.add,13,13,16,0);ir.branch(f,ir.jump,0,\"value\");\n    ir.branch(f,ir.label,0,\"next_frame\");ir.put(f,ir.load,10,10,0,0);ir.branch(f,ir.jump,0,\"frame\");\n    ir.branch(f,ir.label,0,\"done\");treturn(f,0);\n    ir.branch(f,ir.label,0,\"invalid\");treturn(f,4);kaesu f;\n}\nwaza gc_scan_roots_program() -> ir.Function {\n    kaku f=ir.function(\"gc_scan_roots\");tprepare(f);tload(f,10,thread_registry);ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.put(f,ir.equal,12,11,0,0);ir.branch(f,ir.zero,12,\"invalid\");ir.put(f,ir.acquire_load,11,10,0,gc_registry_phase);tcheck(f,11,gc_stopped,\"scan\");treturn(f,4);\n    ir.branch(f,ir.label,0,\"scan\");tload(f,13,thread_member);ir.branch(f,ir.nonzero,13,\"members\");tload(f,14,thread_shadow);ir.invoke_function(f,\"gc_scan_frames\",15,[0,14,1]);ir.branch(f,ir.nonzero,15,\"invalid\");ir.branch(f,ir.label,0,\"members\");ir.put(f,ir.load,11,10,0,32);ir.put(f,ir.acquire_load,12,10,0,gc_registry_epoch);\n    ir.branch(f,ir.label,0,\"member\");ir.branch(f,ir.zero,11,\"done\");ir.put(f,ir.acquire_load,13,11,0,thread_ack_epoch);ir.put(f,ir.equal,13,13,12,0);ir.branch(f,ir.zero,13,\"invalid\");ir.put(f,ir.acquire_load,14,11,0,thread_shadow);ir.invoke_function(f,\"gc_scan_frames\",15,[0,14,1]);ir.branch(f,ir.nonzero,15,\"invalid\");gc_heartbeat(f,10);ir.put(f,ir.load,11,11,0,thread_next);ir.branch(f,ir.jump,0,\"member\");\n    ir.branch(f,ir.label,0,\"done\");treturn(f,0);\n    ir.branch(f,ir.label,0,\"invalid\");treturn(f,4);kaesu f;\n}\nkoukai waza safepoint_program(max_roots_per_frame:int64) -> []ir.Function {\n    kaesu [gc_park_locked_program(),gc_poll_program(),gc_begin_program(),gc_end_program(),gc_scan_frames_program(max_roots_per_frame),gc_scan_roots_program()];\n}\n" }; }
waza data_93() -> File { kaesu File { path: "kiso/runtime/gc/stw.mio", version: "Bunko-v2.1.1", length: 2475, sha256: "04e772a44ea26a90cf31e55b84a7fb7a42454cd105347b0bc9290743a931f13d", source: "// Transitional bridge to the existing exact generational collector. The caller\n// owns gc_begin/gc_end; no frame is read after gc_end. Snapshot storage is owned\n// by that coordinator and must contain (capacity+2) words. Overflow fails closed\n// BEFORE invoking the heap operation. No foreign stack links are modified.\nkoukai teisu gc_collect_stopped_operation=201;\nkoukai teisu gc_heap_initialize_operation=202;\nkoukai teisu gc_allocate_stopped_operation=203;\nwaza gc_snapshot_root_program(capacity:int64) -> ir.Function {\n    // ctx, value, snapshot. The third visitor argument is opaque to the walker.\n    kaku f=ir.function(\"gc_snapshot_root\");\n    ir.put(f,ir.load,10,2,0,8);tconstant(f,11,capacity);\n    ir.put(f,ir.less_unsigned,11,10,11,0);ir.branch(f,ir.zero,11,\"overflow\");\n    tconstant(f,11,8);ir.put(f,ir.multiply,11,10,11,0);\n    ir.put(f,ir.add,11,2,11,0);ir.put(f,ir.store,0,11,1,16);\n    tconstant(f,11,1);ir.put(f,ir.add,10,10,11,0);ir.put(f,ir.store,0,2,10,8);treturn(f,0);\n    ir.branch(f,ir.label,0,\"overflow\");treturn(f,5);kaesu f;\n}\nwaza gc_collect_stopped_program() -> ir.Function {\n    // ctx, heap, snapshot, major. This does NOT acquire the handshake itself:\n    // the caller may need to inspect/modify the stopped heap in the same epoch.\n    kaku f=ir.function(\"gc_collect_stopped\");tprepare(f);\n    tconstant(f,10,0);ir.put(f,ir.store,0,2,10,0);ir.put(f,ir.store,0,2,10,8);\n    ir.invoke_function(f,\"gc_scan_roots\",10,[0,2]);ir.branch(f,ir.nonzero,10,\"failed\");\n    ir.call(f,gc_collect_stopped_operation,10,[1,2,3]);\n    ir.branch(f,ir.label,0,\"failed\");ir.put(f,ir.result,0,10,0,0);kaesu f;\n}\nwaza gc_allocate_stopped_program() -> ir.Function {\n    // ctx, heap, snapshot, payload bytes, layout. Initialization/publication of\n    // the returned object must finish before the caller releases this epoch.\n    kaku f=ir.function(\"gc_allocate_stopped\");tprepare(f);\n    tconstant(f,10,0);ir.put(f,ir.store,0,2,10,0);ir.put(f,ir.store,0,2,10,8);\n    ir.invoke_function(f,\"gc_scan_roots\",10,[0,2]);ir.branch(f,ir.nonzero,10,\"failed\");\n    ir.call(f,gc_allocate_stopped_operation,10,[1,2,3,4]);\n    ir.put(f,ir.result,0,10,0,0);\n    // Allocation failure is NULL, never an error code that resembles a pointer.\n    ir.branch(f,ir.label,0,\"failed\");treturn(f,0);kaesu f;\n}\nkoukai waza stopped_heap_program(capacity:int64) -> []ir.Function {\n    kaesu [gc_snapshot_root_program(capacity),gc_collect_stopped_program(),gc_allocate_stopped_program()];\n}\n" }; }
waza data_94() -> File { kaesu File { path: "kiso/runtime/gc/threads.mio", version: "Bunko-v2.1.1", length: 24271, sha256: "402c71582751e0350943c5e931c640a97cb594476c4fd2cc960360ba13177720", source: "yobu \"kiso/runtime/ir\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n// Thread extension ABI v2; allocated separately from the frozen heap metadata.\n// All fields are native scalar words. OS opaque storage is passed by pointer.\nkoukai teisu thread_context_bytes=288;\nkoukai teisu thread_version=0;\nkoukai teisu thread_imports=8;\nkoukai teisu thread_handle=16;\nkoukai teisu thread_key=24;\nkoukai teisu thread_mutex=32;\nkoukai teisu thread_condition=40;\nkoukai teisu thread_state=48;\nkoukai teisu thread_stop=56;\nkoukai teisu thread_error=64;\nkoukai teisu thread_owns_key=72;\nkoukai teisu thread_owns_mutex=80;\nkoukai teisu thread_owns_condition=88;\nkoukai teisu thread_owns_handle=96;\nkoukai teisu thread_registered=104;\nkoukai teisu thread_starts=112;\nkoukai teisu thread_joins=120;\nkoukai teisu thread_registrations=128;\nkoukai teisu thread_exits=136;\nkoukai teisu thread_fault_operation=144;\nkoukai teisu thread_fault_error=152;\nkoukai teisu thread_fault_count=160;\nkoukai teisu thread_shadow=168;\nkoukai teisu thread_identity_value=176;\nkoukai teisu thread_wakes=184;\nkoukai teisu thread_waits=192;\nkoukai teisu thread_join_retries=200;\nkoukai teisu thread_registry=208;\nkoukai teisu thread_progress=216;\nkoukai teisu thread_waiting=thread_progress;\nkoukai teisu thread_at_work=0;\nkoukai teisu thread_parked=1;\nkoukai teisu thread_finished=2;\nkoukai teisu thread_entry=224;\nkoukai teisu thread_user=232;\nkoukai teisu thread_acquisitions=240;\nkoukai teisu thread_releases=248;\nkoukai teisu thread_new=0;\nkoukai teisu thread_starting=1;\nkoukai teisu thread_running=2;\nkoukai teisu thread_stopping=3;\nkoukai teisu thread_exited=4;\nkoukai teisu thread_joined=5;\nkoukai teisu thread_closed=6;\nkoukai teisu thread_failed=7;\nkoukai teisu thread_quarantined=8;\nkoukai teisu thread_next=256;\nkoukai teisu thread_member=264;\nkoukai teisu thread_ack_epoch=272;\nkoukai teisu thread_seen_epoch=280;\n// Shared registry v2: version, active, registrations, exits, head, lock,\n// requested epoch, coordinator state. Enumerators must hold the registry lock.\n// Storage remains\n// owned until all handles are joined; counters use AcqRel RMW.\nkoukai teisu thread_registry_bytes=64;\nwaza tload(f:ir.Function,dst:int64,offset:int64) -> unit {ir.put(f,ir.load,dst,0,0,offset);}\nwaza tstore(f:ir.Function,offset:int64,src:int64) -> unit {ir.put(f,ir.store,0,0,src,offset);}\nwaza tconstant(f:ir.Function,dst:int64,value:int64) -> unit {ir.put(f,ir.constant,dst,0,0,value);}\nwaza tset(f:ir.Function,offset:int64,value:int64) -> unit {tconstant(f,31,value);tstore(f,offset,31);}\nwaza tpublish(f:ir.Function,offset:int64,value:int64) -> unit {tconstant(f,31,value);ir.put(f,ir.release_store,0,0,31,offset);}\nwaza tinc(f:ir.Function,offset:int64) -> unit {tload(f,29,offset);tconstant(f,30,1);ir.put(f,ir.add,29,29,30,0);tstore(f,offset,29);}\nwaza tcheck(f:ir.Function,value:int64,expected:int64,label:string) -> unit {tconstant(f,30,expected);ir.put(f,ir.equal,30,value,30,0);ir.branch(f,ir.nonzero,30,label);}\nwaza treturn(f:ir.Function,value:int64) -> unit {tconstant(f,31,value);ir.put(f,ir.result,0,31,0,0);}\nwaza terror(f:ir.Function,src:int64) -> unit {\n    kaku done=string.concat(\"error_saved_\",convert.format_int(len(f.steps)));\n    ir.branch(f,ir.zero,src,done);ir.put(f,ir.address,27,0,0,thread_error);tconstant(f,28,0);\n    array.push(f.steps,ir.Step {kind:ir.compare_exchange,destination:26,left:27,right:src,immediate:0,name:\"\",arguments:[28],order:acq_rel,failure_order:acquire});\n    ir.branch(f,ir.label,0,done);\n}\nwaza tprepare(f:ir.Function) -> unit {tload(f,31,thread_imports);ir.put(f,ir.imports,0,31,0,0);}\n// One-shot fault injection is compiled only into explicit validation programs.\n// It substitutes an operation result BEFORE acquisition, then follows the same\n// production error/cleanup path. Default production functions have no hook.\nwaza tcall(f:ir.Function,operation:int64,dst:int64,args:[]int64,faults:bool) -> unit {\n    moshi(!faults){ir.call(f,operation,dst,args);kaesu;}\n    kaku tag=convert.format_int(len(f.steps));kaku actual=string.concat(\"actual_\",tag);kaku done=string.concat(\"call_done_\",tag);\n    tload(f,30,thread_fault_operation);tconstant(f,31,operation);ir.put(f,ir.equal,30,30,31,0);ir.branch(f,ir.zero,30,actual);\n    tload(f,dst,thread_fault_error);tset(f,thread_fault_operation,0);tinc(f,thread_fault_count);ir.branch(f,ir.jump,0,done);\n    ir.branch(f,ir.label,0,actual);ir.call(f,operation,dst,args);ir.branch(f,ir.label,0,done);\n}\nwaza registry_add(f:ir.Function,offset:int64,delta:int64) -> unit {\n    tload(f,27,thread_registry);ir.put(f,ir.address,27,27,0,offset);tconstant(f,28,delta);\n    array.push(f.steps,ir.Step {kind:ir.fetch_add,destination:26,left:27,right:28,immediate:0,name:\"\",arguments:[],order:acq_rel,failure_order:relaxed});\n}\nwaza thread_open_program(faults:bool,cooperative:bool) -> ir.Function {\n    kaesu thread_open_options(faults,cooperative,iie);\n}\nwaza thread_open_options(faults:bool,cooperative:bool,shared_key:bool) -> ir.Function {\n    kaku version=2;moshi(cooperative){version=3;}\n    kaku name=\"thread_open\";moshi(shared_key){name=\"thread_open_shared\";}\n    kaku f=ir.function(name);tprepare(f);tload(f,1,thread_version);tcheck(f,1,version,\"version_ok\");treturn(f,1);\n    ir.branch(f,ir.label,0,\"version_ok\");tload(f,2,thread_registry);ir.branch(f,ir.zero,2,\"invalid_registry\");ir.put(f,ir.load,3,2,0,0);tcheck(f,3,version,\"registry_ok\");\n    ir.branch(f,ir.label,0,\"invalid_registry\");treturn(f,1);\n    ir.branch(f,ir.label,0,\"registry_ok\");tload(f,1,thread_member);ir.branch(f,ir.zero,1,\"not_member\");treturn(f,1);\n    ir.branch(f,ir.label,0,\"not_member\");tload(f,1,thread_state);\n    tcheck(f,1,thread_new,\"start\");tcheck(f,1,thread_closed,\"start\");treturn(f,1);\n    ir.branch(f,ir.label,0,\"start\");tset(f,thread_version,version);tset(f,thread_error,0);tset(f,thread_stop,0);moshi(!cooperative){tset(f,thread_shadow,0);}tset(f,thread_registered,0);tset(f,thread_progress,thread_at_work);\n    // Shared-key callers retain the key until every child has joined. The\n    // child's close never deletes a borrowed key. Context/mutex/condition and\n    // handle ownership remain independent for every actual worker.\n    moshi(shared_key){tset(f,thread_owns_key,0);}\n    sore{ir.put(f,ir.address,2,0,0,thread_key);tcall(f,ir.tls_create,1,[2],faults);ir.branch(f,ir.nonzero,1,\"failed\");tset(f,thread_owns_key,1);tinc(f,thread_acquisitions);}\n    tload(f,2,thread_mutex);tcall(f,ir.mutex_create,1,[2],faults);ir.branch(f,ir.nonzero,1,\"failed\");tset(f,thread_owns_mutex,1);tinc(f,thread_acquisitions);\n    tload(f,2,thread_condition);tcall(f,ir.condition_create,1,[2],faults);ir.branch(f,ir.nonzero,1,\"failed\");tset(f,thread_owns_condition,1);tinc(f,thread_acquisitions);\n    tpublish(f,thread_state,thread_starting);ir.put(f,ir.address,2,0,0,thread_handle);tload(f,3,thread_entry);\n    moshi(shared_key){\n        ir.put(f,ir.address,4,0,0,thread_error);ir.invoke_function(f,\"platform_thread_start\",1,[2,3,0,4]);\n    } sore {tcall(f,thread_start,1,[2,3,0],faults);}\n    ir.branch(f,ir.nonzero,1,\"failed\");tset(f,thread_owns_handle,1);tinc(f,thread_acquisitions);tinc(f,thread_starts);treturn(f,0);\n    ir.branch(f,ir.label,0,\"failed\");terror(f,1);ir.invoke_function(f,\"thread_close\",2,[0]);tload(f,1,thread_error);ir.put(f,ir.result,0,1,0,0);kaesu f;\n}\nwaza thread_enter_program(faults:bool,cooperative:bool) -> ir.Function {\n    kaku f=ir.function(\"thread_enter\");tprepare(f);tload(f,2,thread_key);tconstant(f,4,0);\n    tcall(f,tls_set,1,[2,0],faults);ir.branch(f,ir.nonzero,1,\"failed\");tconstant(f,4,1);\n    tcall(f,tls_get,1,[2],faults);ir.put(f,ir.equal,3,1,0,0);ir.branch(f,ir.nonzero,3,\"registered\");tconstant(f,1,3);ir.branch(f,ir.jump,0,\"failed\");\n    ir.branch(f,ir.label,0,\"registered\");ir.invoke_function(f,\"registry_enter\",1,[0]);ir.branch(f,ir.nonzero,1,\"failed\");tinc(f,thread_registrations);tpublish(f,thread_registered,1);\n    ir.call(f,thread_identity,1,[]);tstore(f,thread_identity_value,1);\n    tload(f,2,thread_mutex);ir.call(f,ir.mutex_lock,1,[2]);ir.branch(f,ir.nonzero,1,\"failed_registered\");\n    ir.put(f,ir.acquire_load,3,0,0,thread_stop);ir.branch(f,ir.nonzero,3,\"stopping\");tpublish(f,thread_state,thread_running);ir.branch(f,ir.jump,0,\"publish\");\n    ir.branch(f,ir.label,0,\"stopping\");tpublish(f,thread_state,thread_stopping);\n    ir.branch(f,ir.label,0,\"publish\");tload(f,3,thread_condition);ir.call(f,wake,1,[3]);terror(f,1);tinc(f,thread_wakes);ir.call(f,ir.mutex_unlock,1,[2]);ir.branch(f,ir.nonzero,1,\"failed_registered\");\n    moshi(cooperative){tload(f,2,thread_shadow);ir.invoke_function(f,\"gc_poll\",1,[0,2]);ir.branch(f,ir.nonzero,1,\"failed_registered\");}treturn(f,0);\n    ir.branch(f,ir.label,0,\"failed_registered\");terror(f,1);ir.invoke_function(f,\"thread_leave\",2,[0]);tload(f,1,thread_error);ir.put(f,ir.result,0,1,0,0);\n    ir.branch(f,ir.label,0,\"failed\");ir.branch(f,ir.zero,4,\"failure_publish\");tconstant(f,3,0);ir.call(f,tls_set,5,[2,3]);\n    ir.branch(f,ir.label,0,\"failure_publish\");terror(f,1);tpublish(f,thread_state,thread_failed);tpublish(f,thread_progress,thread_finished);treturn(f,1);kaesu f;\n}\n// Attach the calling native thread without creating/joining a pthread. The\n// context is caller-owned and zero-initialized, with imports/registry and opaque\n// mutex/condition storage configured. Reuse is allowed only after full close.\n// Acquisition/rollback uses the same ownership accounting as thread_open.\nwaza thread_attach_program(faults:bool) -> ir.Function {\n    kaku f=ir.function(\"thread_attach\");tprepare(f);\n    tload(f,1,thread_version);tcheck(f,1,3,\"version_ok\");treturn(f,1);\n    ir.branch(f,ir.label,0,\"version_ok\");tload(f,2,thread_registry);ir.branch(f,ir.zero,2,\"invalid\");\n    ir.put(f,ir.load,3,2,0,0);tcheck(f,3,3,\"registry_ok\");\n    ir.branch(f,ir.label,0,\"invalid\");treturn(f,1);\n    ir.branch(f,ir.label,0,\"registry_ok\");tload(f,1,thread_member);ir.branch(f,ir.nonzero,1,\"invalid\");\n    tload(f,1,thread_state);tcheck(f,1,thread_new,\"acquire\");tcheck(f,1,thread_closed,\"acquire\");treturn(f,1);\n    ir.branch(f,ir.label,0,\"acquire\");tset(f,thread_error,0);tset(f,thread_stop,0);tset(f,thread_shadow,0);tset(f,thread_progress,thread_at_work);\n    ir.put(f,ir.address,2,0,0,thread_key);tcall(f,ir.tls_create,1,[2],faults);ir.branch(f,ir.nonzero,1,\"failed\");tset(f,thread_owns_key,1);tinc(f,thread_acquisitions);\n    tload(f,2,thread_mutex);tcall(f,ir.mutex_create,1,[2],faults);ir.branch(f,ir.nonzero,1,\"failed\");tset(f,thread_owns_mutex,1);tinc(f,thread_acquisitions);\n    tload(f,2,thread_condition);tcall(f,ir.condition_create,1,[2],faults);ir.branch(f,ir.nonzero,1,\"failed\");tset(f,thread_owns_condition,1);tinc(f,thread_acquisitions);\n    tpublish(f,thread_state,thread_starting);ir.invoke_function(f,\"thread_enter\",1,[0]);ir.branch(f,ir.nonzero,1,\"failed\");treturn(f,0);\n    ir.branch(f,ir.label,0,\"failed\");terror(f,1);ir.invoke_function(f,\"thread_close\",2,[0]);tload(f,1,thread_error);ir.put(f,ir.result,0,1,0,0);kaesu f;\n}\nwaza thread_leave_program(cooperative:bool) -> ir.Function {\n    kaku f=ir.function(\"thread_leave\");tprepare(f);\n    moshi(cooperative){tload(f,2,thread_shadow);ir.invoke_function(f,\"gc_poll\",1,[0,2]);terror(f,1);}\n    tload(f,1,thread_registered);ir.branch(f,ir.zero,1,\"publish\");\n    tload(f,2,thread_key);tconstant(f,3,0);ir.call(f,tls_set,1,[2,3]);terror(f,1);\n    ir.invoke_function(f,\"registry_leave\",1,[0]);ir.branch(f,ir.zero,1,\"unlinked\");terror(f,1);ir.branch(f,ir.jump,0,\"publish\");\n    ir.branch(f,ir.label,0,\"unlinked\");tinc(f,thread_exits);tpublish(f,thread_registered,0);tpublish(f,thread_shadow,0);\n    ir.branch(f,ir.label,0,\"publish\");tload(f,2,thread_mutex);ir.call(f,ir.mutex_lock,1,[2]);ir.branch(f,ir.nonzero,1,\"bad_lock\");\n    tpublish(f,thread_state,thread_exited);tpublish(f,thread_progress,thread_finished);tload(f,3,thread_condition);ir.call(f,wake,1,[3]);terror(f,1);tinc(f,thread_wakes);ir.call(f,ir.mutex_unlock,1,[2]);terror(f,1);tload(f,1,thread_error);ir.put(f,ir.result,0,1,0,0);\n    ir.branch(f,ir.label,0,\"bad_lock\");terror(f,1);tpublish(f,thread_state,thread_exited);tpublish(f,thread_progress,thread_finished);tload(f,1,thread_error);ir.put(f,ir.result,0,1,0,0);kaesu f;\n}\nwaza thread_wait_program(faults:bool,cooperative:bool) -> ir.Function {\n    // Bounded GC wait: arg1 is 0..1s in ns. Zero means deadline already due.\n    // Wake is only a hint: recheck stop under the same mutex after every wake.\n    // The absolute deadline survives spurious wakes; they cannot extend it.\n    kaku f=ir.function(\"thread_wait\");tprepare(f);ir.put(f,ir.copy,5,1,0,0);tconstant(f,7,1000000001);ir.put(f,ir.less_unsigned,7,5,7,0);ir.branch(f,ir.zero,7,\"bad_timeout\");\n    ir.invoke_function(f,\"platform_now\",6,[]);ir.branch(f,ir.zero,6,\"bad_timeout\");ir.put(f,ir.copy,8,6,0,0);ir.put(f,ir.add,6,6,5,0);ir.put(f,ir.less_unsigned,8,6,8,0);ir.branch(f,ir.nonzero,8,\"bad_timeout\");\n    tload(f,2,thread_mutex);ir.call(f,ir.mutex_lock,1,[2]);ir.branch(f,ir.nonzero,1,\"lock_failed\");\n    ir.branch(f,ir.label,0,\"predicate\");moshi(cooperative){ir.invoke_function(f,\"gc_park_locked\",9,[0]);ir.branch(f,ir.nonzero,9,\"gc_failed\");}ir.put(f,ir.acquire_load,3,0,0,thread_stop);ir.branch(f,ir.nonzero,3,\"stopped\");\n    ir.invoke_function(f,\"platform_now\",7,[]);ir.branch(f,ir.zero,7,\"clock_failed\");ir.put(f,ir.less_unsigned,8,7,6,0);ir.branch(f,ir.zero,8,\"timed_out\");ir.put(f,ir.subtract,5,6,7,0);\n    moshi(faults){tload(f,3,thread_fault_operation);tchec