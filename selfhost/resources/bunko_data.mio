waza data_20() -> File { kaesu File { path: "kiso/aot/lower/old_satb.mio", version: "Bunko-v2.1.1", length: 2651, sha256: "ab5ba5bad9a2caba8b8603178fdc93d28abecaa15e1ff5c65a7c7771fe4956fd", source: "// Darwin/AArch64 instruction adapter for neutral typed prewrite semantics.\n// Preserve every live operand; x14 is only a private argument carrier.\nwaza emit_old_typed_prewrite(c:arm64.Assembler,base:int64,offset:int64) -> unit {\n moshi(!old_mark_proto_enabled(c)){kaesu;}\n emit(c,arm64.sub_imm_x(31,31,16,iie));emit(c,arm64.str_x(14,31,0));\n emit(c,arm64.add_imm_x(14,base,offset,iie));arm64.assembler_bl(c,\"old_satb_slot\");\n emit(c,arm64.ldr_x(14,31,0));emit(c,arm64.add_imm_x(31,31,16,iie));\n}\nwaza emit_old_release_store(c:arm64.Assembler,value:int64,base:int64,offset:int64) -> unit {\n moshi(!old_mark_proto_enabled(c)){emit(c,arm64.str_x(value,base,offset));kaesu;}\n emit(c,arm64.sub_imm_x(31,31,16,iie));emit(c,arm64.str_x(14,31,0));\n emit(c,arm64.add_imm_x(14,base,offset,iie));emit(c,arm64.stlr_x(value,14));\n emit(c,arm64.ldr_x(14,31,0));emit(c,arm64.add_imm_x(31,31,16,iie));\n}\nwaza emit_old_satb_adapter(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {\n emit_old_bulk_adapter(c,p,first);\n attached_save(c,\"old_satb_slot\");move_x(c,1,14);old_control(c,p,first,0);arm64.assembler_cbz_x(c,0,\"old_satb_no_state\");wr_imports(c,p,first);wr_call(c,\"gc_old_prewrite\");arm64.assembler_label(c,\"old_satb_no_state\");attached_restore(c);\n attached_save(c,\"old_remember_header\");move_x(c,0,14);wr_imports(c,p,first);wr_call(c,\"gc_old_remember_header\");attached_restore(c);\n}\n// Terminal error packet for this explicit development mode. Preserve the\n// originating status/return PC before the exit syscall; no managed dereference.\nwaza emit_old_error_diagnostic(c:arm64.Assembler) -> unit {\n emit(c,arm64.sub_imm_x(31,31,128,iie));\n kaku registers=[0,30,23,7,19,20,21,22,24,25,26,27,28];kaku i=0;\n aida(i<len(registers)){emit(c,arm64.str_x(registers[i],31,(i+1)*8));i=i+1;}\n emit(c,arm64.add_imm_x(9,31,128,iie));emit(c,arm64.str_x(9,31,112));\n wr_num(c,9,1330398546);emit(c,arm64.str_x(9,31,0));wr_num(c,9,1);emit(c,arm64.str_x(9,31,120));\n wr_num(c,0,2);emit(c,arm64.add_imm_x(1,31,0,iie));wr_num(c,2,128);wr_num(c,16,4);emit(c,arm64.svc(128));\n}\n\n// Native operand movement only; aligned copy/clear and prewrite ordering are\n// neutral IR. Runtime helpers preserve all user registers and their caller LR.\nwaza emit_old_bulk_adapter(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {\n attached_save(c,\"old_bulk_copy\");move_x(c,3,2);move_x(c,2,1);move_x(c,1,0);old_control(c,p,first,0);wr_imports(c,p,first);wr_call(c,\"gc_copy_reference_slots\");attached_restore(c);\n attached_save(c,\"old_bulk_clear\");move_x(c,1,11);old_control(c,p,first,0);wr_imports(c,p,first);wr_call(c,\"gc_clear_reference_slots\");attached_restore(c);\n}\n" }; }
waza data_21() -> File { kaesu File { path: "kiso/aot/lower/old_sweep.mio", version: "Bunko-v2.1.1", length: 4935, sha256: "422cc76a914b1d5204e31b918874ee096f096df3adfde21e6a9bdb476e213598", source: "// E5 experimental Darwin/AArch64 CPU/OS adaptation, native gates NOT_ACCEPTED.\nkoukai teisu concurrent_old_root_words=3306;\nwaza old_sweep_enabled(c:arm64.Assembler) -> bool {kaesu arm64.assembler_label_word(c,\"old_sweep_enabled\")>=0;}\nwaza old_mapping_size(c:arm64.Assembler) -> int64 {moshi(old_sweep_enabled(c)){kaesu 263168;}kaesu old_mapping_bytes;}\nwaza old_queue_start(c:arm64.Assembler) -> int64 {moshi(old_sweep_enabled(c)){kaesu 1024;}kaesu 512;}\nwaza emit_sweep_dispatch(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {\n // Called inside old_collect_dispatch's owned64B scratch, with ctrl0/mode9.\n kaku modes=[20,21,22,23,24,26,27,28,29,32,33,34,41,42,43,44,45];kaku offsets=[712,552,536,576,560,648,656,720,584,752,744,544,768,776,808,816,672];kaku i=0;\n aida(i<len(modes)){kaku next=string.concat(\"sweep_query_next_\",convert.format_int(modes[i]));emit(c,arm64.cmp_imm_x(9,modes[i],iie));arm64.assembler_b_cond(c,1,next);emit(c,arm64.add_imm_x(9,0,offsets[i],iie));emit(c,arm64.ldar_x(0,9));old_result(c,0);arm64.assembler_label(c,next);i=i+1;}\n // Heap metrics acquire the actual stopped heap and shared sweep lock.\n kaku heap_modes=[35,36,37,38,39,40];kaku heap_offsets=[gc.los_count,gc.los_bytes,gc.los_reclaimed,2720,304,1120];i=0;\n aida(i<len(heap_modes)){kaku next=string.concat(\"sweep_heap_query_next_\",convert.format_int(heap_modes[i]));emit(c,arm64.cmp_imm_x(9,heap_modes[i],iie));arm64.assembler_b_cond(c,1,next);wr_poll(c,p,first,\"gc_heap_enter\");emit(c,arm64.ldr_x(9,23,heap_offsets[i]));emit(c,arm64.str_x(9,31,32));wr_current(c,p,first);wr_call(c,\"gc_end\");emit(c,arm64.ldr_x(0,31,32));old_result(c,0);arm64.assembler_label(c,next);i=i+1;}\n emit(c,arm64.cmp_imm_x(9,25,iie));arm64.assembler_b_cond(c,1,\"sweep_query_not_observe\");wr_imports(c,p,first);arm64.assembler_bl(c,\"attached_gc_sweep_observe\");old_result(c,0);arm64.assembler_label(c,\"sweep_query_not_observe\");\n emit(c,arm64.cmp_imm_x(9,30,iie));arm64.assembler_b_cond(c,0,\"sweep_query_finish\");emit(c,arm64.cmp_imm_x(9,31,iie));arm64.assembler_b_cond(c,1,\"sweep_queries_done\");\n arm64.assembler_label(c,\"sweep_query_finish\");wr_poll(c,p,first,\"gc_heap_enter\");wr_current(c,p,first);emit(c,arm64.str_x(0,31,0));move_x(c,1,0);old_control(c,p,first,0);wr_imports(c,p,first);emit(c,arm64.ldr_x(9,31,24));emit(c,arm64.cmp_imm_x(9,31,iie));arm64.assembler_b_cond(c,0,\"sweep_do_retry\");wr_call(c,\"gc_sweep_finish\");old_control(c,p,first,9);emit(c,arm64.ldr_x(9,9,552));emit(c,arm64.str_x(9,31,32));arm64.assembler_b(c,\"sweep_query_resume\");\n arm64.assembler_label(c,\"sweep_do_retry\");wr_call(c,\"gc_sweep_retry\");emit(c,arm64.str_x(31,31,32));arm64.assembler_label(c,\"sweep_query_resume\");wr_current(c,p,first);wr_call(c,\"gc_end\");emit(c,arm64.ldr_x(0,31,32));old_result(c,0);\n arm64.assembler_label(c,\"sweep_queries_done\");emit(c,arm64.ldr_x(9,31,24));\n}\nwaza emit_sweep_adapter(c:arm64.Assembler,p:[]macho.AddressPatch,first:int64) -> unit {\n attached_save(c,\"sweep_bin_reused\");move_x(c,1,13);old_control(c,p,first,0);arm64.assembler_cbz_x(c,0,\"sweep_bin_no_state\");wr_imports(c,p,first);wr_call(c,\"gc_sweep_reused\");arm64.assembler_label(c,\"sweep_bin_no_state\");attached_restore(c);\n // Neutral reclaim owns lock/charges; adapter reports the real public OS result.\n stw_bridge_enter(c,\"worker_sweep_account\");move_x(c,23,0);arm64.assembler_bl(c,\"memory_sample\");wr_num(c,0,0);stw_bridge_leave(c);\n stw_bridge_enter(c,\"worker_sweep_unmap\");\n moshi(arm64.assembler_label_word(c,\"sweep_unmap_fault_enabled\")>=0){\n  move_x(c,19,0);move_x(c,20,1);old_control(c,p,first,9);emit(c,arm64.ldr_x(10,9,784));arm64.assembler_cbnz_x(c,10,\"sweep_unmap_real\");wr_num(c,10,1);emit(c,arm64.str_x(10,9,784));emit(c,arm64.add_imm_x(0,19,1,iie));\n  arm64.assembler_label(c,\"sweep_unmap_real\");\n }\n wr_num(c,16,73);emit(c,arm64.svc(128));arm64.assembler_b_cond(c,2,\"sweep_unmap_return\");wr_num(c,0,0);arm64.assembler_label(c,\"sweep_unmap_return\");stw_bridge_leave(c);\n // Report to separately owned stack. Never overwrite a control that still has\n // a live native owner when failure cleanup could not join.\n attached_save(c,\"sweep_control_report\");old_control(c,p,first,14);arm64.assembler_cbz_x(c,14,\"sweep_report_no_state\");emit(c,arm64.sub_imm_x(31,31,256,iie));wr_num(c,9,1330406979);emit(c,arm64.str_x(9,31,0));wr_num(c,9,3);emit(c,arm64.str_x(9,31,8));\n kaku offsets=[712,720,544,552,536,576,560,624,632,640,648,656,608,616,664,672,680,688,704,584,736,744,752,760,768,776,808,816,824,832];kaku i=0;aida(i<len(offsets)){emit(c,arm64.add_imm_x(9,14,offsets[i],iie));emit(c,arm64.ldar_x(9,9));emit(c,arm64.str_x(9,31,(i+2)*8));i=i+1;}\n wr_num(c,0,2);emit(c,arm64.add_imm_x(1,31,0,iie));wr_num(c,2,256);wr_num(c,16,4);emit(c,arm64.svc(128));emit(c,arm64.add_imm_x(31,31,256,iie));arm64.assembler_label(c,\"sweep_report_no_state\");attached_restore(c);\n}\n\nwaza worker_import_slots(c:arm64.Assembler) -> int64 {moshi(old_sweep_enabled(c)){kaesu 30;}kaesu 28;}\n" }; }
waza data_22() -> File { kaesu File { path: "kiso/aot/lower/sha256_native.mio", version: "Bunko-v2.1.1", length: 5130, sha256: "f5228e0b7ae55da3bb3537f96938866185c5d131d8117e8bef4ee8cc24cdc2b2", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/aot/lower/types\";\n\n// ARMv8 SHA-256 for kiso/crypto/sha256's sha256_compress_native_block(state, words, k, x, bytes): every Apple-silicon\n// Mac implements FEAT_SHA256. The call keeps the Mochi call's stack effect (five operands popped, no result); the routine\n// validates its three arrays (non-nil, 8-byte elements, lengths >= 8, 16 and 64) and fails like any bad index otherwise.\n// It allocates nothing and stores only integers, so no shadow frame, safepoint or barrier is involved. Full-sweep images\n// (acquire loads for heap reads) keep the ordinary call.\nteisu sha256_native_name = \"sha256_compress_native_block\";\n\nwaza sha256_native_call(code: arm64.Assembler, analysis: types.TypeAnalysis, entries: []int64, target: mochi.Function) -> bool {\n    moshi (old_sweep_enabled(code) || target.name != sha256_native_name || target.parameter_count != 5 || target.returns_value) { kaesu iie; }\n    moshi (len(entries) < 5) { kaesu iie; }\n    kaku i = len(entries) - 5;\n    aida (i < len(entries)) {\n        moshi (types.type_kind(analysis, entries[i]) != types.type_array_ref) { kaesu iie; }\n        i = i + 1;\n    }\n    kaesu hai;\n}\n\nwaza emit_sha256_native_call(code: arm64.Assembler) -> unit {\n    emit(code, arm64.sub_imm_x(20, 20, 40, iie)); emit(code, arm64.add_x(8, 19, 20));\n    emit(code, arm64.ldp_x(0, 1, 8, 0)); emit(code, arm64.ldr_x(2, 8, 16));\n    arm64.assembler_bl(code, \"rt_sha256_compress\");\n}\n\nwaza simd(code: arm64.Assembler, word: int64) -> unit { emit(code, arm64.Instruction { word: uint32(word), error: mu }); }\n// INS Vd.S[lane], Wn / UMOV Wd, Vn.S[lane]\nwaza ins_s(code: arm64.Assembler, vd: int64, lane: int64, wn: int64) -> unit { simd(code, 1308630016 + (lane * 8 + 4) * 65536 + wn * 32 + vd); }\nwaza umov_s(code: arm64.Assembler, wd: int64, vn: int64, lane: int64) -> unit { simd(code, 234896384 + (lane * 8 + 4) * 65536 + vn * 32 + wd); }\nwaza add_4s(code: arm64.Assembler, vd: int64, vn: int64, vm: int64) -> unit { simd(code, 1319142400 + vm * 65536 + vn * 32 + vd); }\nwaza mov_16b(code: arm64.Assembler, vd: int64, vn: int64) -> unit { simd(code, 1319115776 + vn * 65536 + vn * 32 + vd); }\nwaza sha256h(code: arm64.Assembler, qd: int64, qn: int64, vm: int64) -> unit { simd(code, 1577074688 + vm * 65536 + qn * 32 + qd); }\nwaza sha256h2(code: arm64.Assembler, qd: int64, qn: int64, vm: int64) -> unit { simd(code, 1577078784 + vm * 65536 + qn * 32 + qd); }\nwaza sha256su0(code: arm64.Assembler, vd: int64, vn: int64) -> unit { simd(code, 1579689984 + vn * 32 + vd); }\nwaza sha256su1(code: arm64.Assembler, vd: int64, vn: int64, vm: int64) -> unit { simd(code, 1577082880 + vm * 65536 + vn * 32 + vd); }\n\n// x<reg> array descriptor -> x<storage> first element address; minimum length checked.\nwaza sha256_native_array(code: arm64.Assembler, reg: int64, minimum: int64, storage: int64) -> unit {\n    arm64.assembler_cbz_x(code, reg, \"runtime_error\");\n    emit(code, arm64.ldr_x(9, reg, 8)); emit(code, arm64.cmp_imm_x(9, minimum, iie)); arm64.assembler_b_cond(code, 3, \"runtime_error\");\n    emit(code, arm64.ldrb_w(9, reg, 1)); emit(code, arm64.cmp_imm_x(9, 8, iie)); arm64.assembler_b_cond(code, 1, \"runtime_error\");\n    emit(code, arm64.ldr_x(storage, reg, 40)); emit(code, arm64.add_imm_x(storage, storage, 32, iie));\n}\n\n// Four consecutive 64-bit elements (low 32 bits each, little-endian) at x<base> + 8 * first into Vd.4S.\nwaza sha256_native_load(code: arm64.Assembler, vd: int64, base: int64, first: int64) -> unit {\n    kaku lane = 0;\n    aida (lane < 4) { emit(code, arm64.ldr_w(9, base, (first + lane) * 8)); ins_s(code, vd, lane, 9); lane = lane + 1; }\n}\n\n// x0 state, x1 words, x2 k; uses x9-x12, v16-v27.\nwaza emit_sha256_native_routine(code: arm64.Assembler) -> unit {\n    arm64.assembler_label(code, \"rt_sha256_compress\");\n    sha256_native_array(code, 0, 8, 10); sha256_native_array(code, 1, 16, 11); sha256_native_array(code, 2, 64, 12);\n    sha256_native_load(code, 16, 10, 0); sha256_native_load(code, 17, 10, 4);\n    sha256_native_load(code, 20, 11, 0); sha256_native_load(code, 21, 11, 4); sha256_native_load(code, 22, 11, 8); sha256_native_load(code, 23, 11, 12);\n    mov_16b(code, 24, 16); mov_16b(code, 25, 17);\n    kaku group = 0;\n    aida (group < 16) {\n        kaku m0 = 20 + group - (group / 4) * 4;\n        sha256_native_load(code, 26, 12, group * 4);\n        add_4s(code, 26, m0, 26);\n        moshi (group < 12) {\n            kaku m1 = 20 + (group + 1) - ((group + 1) / 4) * 4; kaku m2 = 20 + (group + 2) - ((group + 2) / 4) * 4; kaku m3 = 20 + (group + 3) - ((group + 3) / 4) * 4;\n            sha256su0(code, m0, m1); sha256su1(code, m0, m2, m3);\n        }\n        mov_16b(code, 27, 16);\n        sha256h(code, 16, 17, 26); sha256h2(code, 17, 27, 26);\n        group = group + 1;\n    }\n    add_4s(code, 16, 16, 24); add_4s(code, 17, 17, 25);\n    kaku lane = 0;\n    aida (lane < 4) {\n        umov_s(code, 9, 16, lane); emit(code, arm64.str_x(9, 10, lane * 8));\n        umov_s(code, 9, 17, lane); emit(code, arm64.str_x(9, 10, (lane + 4) * 8));\n        lane = lane + 1;\n    }\n    emit(code, arm64.ret());\n}\n" }; }
waza data_23() -> File { kaesu File { path: "kiso/aot/lower/specialize.mio", version: "Bunko-v2.1.1", length: 4129, sha256: "56a65569228240d20c60bfa2538565b7147576bc337ffdd0bd0372143943a3ab", source: "yobu \"kiso/array\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/encoding/mochi\";\n\nkata Specialization { file: mochi.File; analysis: types.TypeAnalysis; }\n\nwaza instance_function(source: mochi.Function, id: int64, data: []uint8) -> mochi.Function {\n    // Each specialization owns its mutable metadata arrays. Explicitly typed\n    // copies also retain the array representation when the input function list\n    // is empty and no reachable constructor supplies an element witness.\n    kaku name_bytes: []uint8 = [];\n    array.append_all(name_bytes, source.name_bytes);\n    kaku captures: []mochi.Capture = [];\n    array.append_all(captures, source.captures);\n    kaesu mochi.Function { id: id, name: source.name, name_bytes: name_bytes,\n        parameter_count: source.parameter_count, local_count: source.local_count,\n        returns_value: source.returns_value, captures: captures, instructions: data };\n}\n\nwaza retarget_call(data: []uint8, at: int64, id: int64) -> unit {\n    data[at + 1] = uint8(id / 256); data[at + 2] = uint8(id - (id / 256) * 256);\n}\n\n// v14 erases generic type arguments. Recover separate representations only\n// when the unchanged strict solver rejects a direct call's shared signature.\n// The complete callee is cloned, retaining its control flow and GC analysis.\n// A call site is split at most once; an actual per-instance type/layout failure\n// stays a failure. Bounds prevent recursive specialization from running away.\nwaza specialize(file: mochi.File) -> Specialization {\n    kaku work = mochi.File { version: file.version, constants: file.constants,\n        global_count: file.global_count, instructions: file.instructions,\n        functions: array.clone(file.functions) };\n    kaku attempted: []int64 = []; kaku count = 0;\n    kaku analysis = types.analyze_types(work);\n    aida (analysis.error_detail != 0 && count < 256 && len(work.functions) < 65536) {\n        kaku detail = analysis.error_detail;\n        moshi (detail - (detail / 100) * 100 != 25) { nukeru; }\n        kaku owner = detail / 1000000 - 1;\n        kaku offset = (detail - (owner + 1) * 1000000) / 100;\n        kaku repeated = iie; kaku index = 0;\n        aida (index < len(attempted)) { moshi (attempted[index] == detail) { repeated = hai; } index = index + 1; }\n        moshi (repeated || owner >= len(work.functions)) { nukeru; }\n        array.push(attempted, detail);\n        kaku caller = work.instructions; moshi (owner >= 0) { caller = work.functions[owner].instructions; }\n        moshi (offset < 0 || offset + 3 > len(caller) || caller[offset] != uint8(25)) { nukeru; }\n        kaku target = int64(caller[offset + 1]) * 256 + int64(caller[offset + 2]);\n        moshi (target >= len(work.functions)) { nukeru; }\n        kaku source = work.functions[target];\n        // Captured environments have separate identity/representation edges.\n        // Do not clone them without specializing those edges as well.\n        moshi (len(source.captures) != 0 || len(source.instructions) == 0) { nukeru; }\n        kaku id = len(work.functions); kaku body = array.clone(source.instructions);\n        kaku at = 0;\n        aida (at < len(body)) {\n            kaku opcode = int64(body[at]); kaku width = types.type_instruction_width(opcode);\n            moshi (width <= 0 || at + width > len(body)) { kaesu Specialization { file: work, analysis: analysis }; }\n            moshi (opcode == 25 && int64(body[at + 1]) * 256 + int64(body[at + 2]) == target) { retarget_call(body, at, id); }\n            at = at + width;\n        }\n        array.push(work.functions, instance_function(source, id, body));\n        kaku patched = array.clone(caller); retarget_call(patched, offset, id);\n        moshi (owner < 0) {\n            work = mochi.File { version: work.version, constants: work.constants,\n                global_count: work.global_count, instructions: patched, functions: work.functions };\n        }\n        sore { work.functions[owner] = instance_function(work.functions[owner], owner, patched); }\n        count = count + 1;\n        analysis = types.analyze_types(work);\n    }\n    kaesu Specialization { file: work, analysis: analysis };\n}\n" }; }
waza data_24() -> File { kaesu File { path: "kiso/aot/lower/stw_bridge.mio", version: "Bunko-v2.1.1", length: 2552, sha256: "2e8d14230dc5654b1214bd34ceeb42a39cb715e11fbf125827442e2782281730", source: "// Darwin/AArch64 ABI bridge for the legacy heap. Exclusivity is established by\n// the portable coordinator, never by sharing a thread's x24. Each call installs\n// a coordinator-owned exact snapshot, and restores every native callee-save.\n// These entry points are internal runtime adapters, not language builtins.\nwaza stw_bridge_enter(code:arm64.Assembler,name:string) -> unit {\n    arm64.assembler_label(code,name);\n    emit(code,arm64.stp_pre_x(29,30,31,-16));\n    kaku r=19;aida(r<29){emit(code,arm64.stp_pre_x(r,r+1,31,-16));r=r+2;}\n}\nwaza stw_bridge_leave(code:arm64.Assembler) -> unit {\n    kaku r=27;aida(r>=19){emit(code,arm64.ldp_post_x(r,r+1,31,16));r=r-2;}\n    emit(code,arm64.ldp_post_x(29,30,31,16));emit(code,arm64.ret());\n}\nkoukai waza emit_stopped_heap_adapter(code:arm64.Assembler,capacity:int64) -> unit {\n    stw_bridge_enter(code,\"stw_heap_init\");\n    emit_runtime_init(code,capacity,runtime_metadata_bytes);emit_observation_init(code);\n    arm64.assembler_bl(code,\"memory_sample\");move_x(code,0,23);stw_bridge_leave(code);\n    // heap, exact snapshot, size, type. Requires exclusive heap access; an\n    // allocation-triggered collection uses the same complete root snapshot.\n    stw_bridge_enter(code,\"stw_heap_alloc\");move_x(code,23,0);move_x(code,24,1);\n    move_x(code,0,2);move_x(code,1,3);arm64.assembler_bl(code,\"runtime_alloc\");stw_bridge_leave(code);\n    // heap, exact snapshot, major. The ordinary collector remains unchanged.\n    stw_bridge_enter(code,\"stw_heap_collect\");move_x(code,23,0);move_x(code,24,1);\n    arm64.assembler_cbz_x(code,2,\"stw_heap_minor\");arm64.assembler_bl(code,\"gen_major\");arm64.assembler_b(code,\"stw_heap_collected\");\n    arm64.assembler_label(code,\"stw_heap_minor\");arm64.assembler_bl(code,\"gen_minor\");\n    arm64.assembler_label(code,\"stw_heap_collected\");emit(code,arm64.movz_x(0,0,0));stw_bridge_leave(code);\n    // heap, typed owner. Exact pointer stores use the legacy post-write barrier\n    // while all mutators are stopped; this is NOT a concurrent SATB barrier.\n    stw_bridge_enter(code,\"stw_heap_remember\");move_x(code,23,0);move_x(code,0,1);\n    emit_gen_remember(code,0);emit(code,arm64.movz_x(0,0,0));stw_bridge_leave(code);\n    emit_managed_runtime(code,iie,runtime_metadata_bytes,iie);\n    kaku labels=[\"runtime_error\",\"runtime_oom\",\"runtime_gc_bad_type\",\"runtime_gc_bad_kind\",\"runtime_gc_bad_count\"];\n    kaku i=0;aida(i<len(labels)){arm64.assembler_label(code,labels[i]);emit(code,arm64.movz_x(0,91+i,0));emit(code,arm64.movz_x(16,1,0));emit(code,arm64.svc(128));i=i+1;}\n}\n" }; }
waza data_25() -> File { kaesu File { path: "kiso/aot/lower/testing.mio", version: "Bunko-v2.1.1", length: 3738, sha256: "ece06d8e332458ffb618bd025bf5db29732d2443ac2c53771c891e45414f9981", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/array\";\n\nwaza uses_testing(file: mochi.File) -> bool {\n    kaku index = 0;\n    aida (index < len(file.functions)) {\n        moshi (types.is_testing_report(file.functions[index].name)) { kaesu hai; }\n        index = index + 1;\n    }\n    kaesu iie;\n}\n\nwaza testing_counter_address(code: arm64.Assembler, patches: []macho.AddressPatch, slot: int64) -> unit {\n    kaku at = len(code.words);\n    emit(code, arm64.Instruction { word: uint32(0), error: mu });\n    emit(code, arm64.Instruction { word: uint32(0), error: mu });\n    array.push(patches, macho.AddressPatch { at_word: at, add_at_word: at + 1,\n        target: macho.data_target(), target_offset: slot * 8, register: 8 });\n}\n\n// report records every failure and returns normally, as the reference recorder\n// does. Program exit reflects the accumulated result; it does not stop after\n// the first failed expectation or turn a failed assertion into success.\nwaza emit_testing_report(code: arm64.Assembler, patches: []macho.AddressPatch, slot: int64,\n    analysis: types.TypeAnalysis, function_id: int64, packet: bool) -> unit {\n    emit(code, arm64.ldr_x(9, 21, 0)); emit_unbox_register(code, analysis, analysis.locals[function_id][0], 9);\n    arm64.assembler_cbnz_x(code, 9, \"testing_report_done\");\n    moshi(worker_roots_enabled(code)){arm64.assembler_bl(code,\"attached_heap_enter\");}\n    testing_counter_address(code, patches, slot);\n    emit(code, arm64.ldr_x(9, 8, 0)); emit(code, arm64.add_imm_x(9, 9, 1, iie)); emit(code, arm64.str_x(9, 8, 0));\n    emit(code, arm64.ldr_x(9, 21, 8)); emit_string_view(code);\n    moshi (packet) {\n        emit(code, arm64.sub_imm_x(31, 31, 32, iie)); emit(code, arm64.str_x(13, 31, 0)); emit(code, arm64.str_x(10, 31, 8));\n        // Length-prefixed bytes preserve newlines/NUL and distinguish assertion\n        // data from user stderr. Only test-linked images ever write fd 3.\n        emit(code, arm64.movz_x(0, 3, 0)); emit(code, arm64.add_imm_x(1, 31, 8, iie)); emit(code, arm64.movz_x(2, 8, 0)); emit(code, arm64.movz_x(16, 4, 0)); emit_print_boundary(code);\n        emit(code, arm64.movz_x(0, 3, 0)); emit(code, arm64.ldr_x(1, 31, 0)); emit(code, arm64.ldr_x(2, 31, 8)); emit(code, arm64.movz_x(16, 4, 0)); emit_print_boundary(code);\n        emit(code, arm64.ldr_x(13, 31, 0)); emit(code, arm64.ldr_x(10, 31, 8)); emit(code, arm64.add_imm_x(31, 31, 32, iie));\n    }\n    emit(code, arm64.movz_x(0, 2, 0)); move_x(code, 1, 13); move_x(code, 2, 10);\n    emit(code, arm64.movz_x(16, 4, 0)); emit_print_boundary(code);\n    // A separate stack byte supplies the newline without an embedded string.\n    emit(code, arm64.sub_imm_x(31, 31, 16, iie)); emit(code, arm64.movz_x(9, 10, 0)); emit(code, arm64.strb_w(9, 31, 0));\n    emit(code, arm64.movz_x(0, 2, 0)); emit(code, arm64.add_imm_x(1, 31, 0, iie)); emit(code, arm64.movz_x(2, 1, 0));\n    emit(code, arm64.movz_x(16, 4, 0)); emit_print_boundary(code); emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    arm64.assembler_label(code, \"testing_report_done\");\n}\n\nwaza uses_testing_packet(file: mochi.File) -> bool {\n    kaku at = 0;\n    aida (at < len(file.functions)) { moshi (types.is_testing_packet(file.functions[at].name)) { kaesu hai; } at = at + 1; }\n    kaesu iie;\n}\nwaza emit_testing_completion(code: arm64.Assembler) -> unit {\n    emit(code, arm64.sub_imm_x(31, 31, 16, iie)); emit(code, arm64.movn_x(9, 0, 0)); emit(code, arm64.str_x(9, 31, 0));\n    emit(code, arm64.movz_x(0, 3, 0)); emit(code, arm64.add_imm_x(1, 31, 0, iie)); emit(code, arm64.movz_x(2, 8, 0)); emit(code, arm64.movz_x(16, 4, 0)); emit_print_boundary(code); emit(code, arm64.add_imm_x(31, 31, 16, iie));\n}\n" }; }
waza data_26() -> File { kaesu File { path: "kiso/aot/lower/types/types.mio", version: "Bunko-v2.1.1", length: 80401, sha256: "420253881b2bf4dd4cc1e571177512050a088eb1bfec06cb8a1d0fb987d73bcf", source: "yobu \"kiso/array\";\nyobu \"kiso/aot/lower/nativefs\";\nyobu \"kiso/encoding/mochi\";\n\n// Closed value categories used by the pure-Mio lowering pass.  These are\n// representation categories rather than source-language names: in\n// particular, strings are tagged IDs or managed dynamic descriptors. Exact\n// string slots are published as tagged-union Roots; marking skips tagged IDs.\nkoukai teisu type_unknown = 0;\nkoukai teisu type_integer = 1;\nkoukai teisu type_float32 = 2;\nkoukai teisu type_float64 = 3;\nkoukai teisu type_bool = 4;\nkoukai teisu type_string_id = 5;\nkoukai teisu type_array_ref = 6;\nkoukai teisu type_struct_ref = 7;\nkoukai teisu type_enum_ref = 8;\nkoukai teisu type_function_ref = 9;\nkoukai teisu type_nil = 10;\nkoukai teisu type_float_any = 11;\nkoukai teisu type_map_ref = 12;\n\nkoukai waza is_testing_report(name: string) -> bool {\n    kaesu name == \"$mma::mio/testing/runtime::report::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967\" || is_testing_packet(name);\n}\n\nkoukai waza is_testing_packet(name: string) -> bool {\n    kaesu name == \"$mma::mio/testing/runtime::report_packet::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967\";\n}\n\nkoukai kata TypeArena {\n    parent: []int64;\n    revision: []int64;\n    kind: []int64;\n    nullable: []bool;\n    struct_arity: []int64;\n    struct_exact: []bool;\n    fields: [][]int64;\n    array_width: []int64;\n    array_descriptor: []int64;\n    integer_descriptor: []int64;\n    map_written: []bool;\n    targets: [][]int64;\n    variants: [][][]int64;\n    trace: []bool;\n    context: []int64;\n    nullable_origins: [][]int64;\n}\n\nkoukai kata TypeBlock {\n    data: []uint8;\n    function_id: int64;\n    entry: [][]int64;\n    reachable: []bool;\n}\n\nkoukai kata TypeAnalysis {\n    arena: TypeArena;\n    globals: []int64;\n    locals: [][]int64;\n    returns: []int64;\n    upvalues: [][]int64;\n    cells: [][]bool;\n    blocks: []TypeBlock;\n    error_detail: int64;\n}\n\nwaza type_arena() -> TypeArena {\n    kaesu TypeArena { parent: [], revision: [0], kind: [], nullable: [], struct_arity: [],\n        struct_exact: [], fields: [], array_width: [], array_descriptor: [], integer_descriptor: [], map_written: [], targets: [], variants: [], trace: [iie], context: [0], nullable_origins: [] };\n}\n\nwaza type_new(arena: TypeArena, kind: int64) -> int64 {\n    kaku id = len(arena.parent);\n    array.push(arena.parent, id);\n    array.push(arena.kind, kind);\n    array.push(arena.array_width, 0); array.push(arena.array_descriptor, 0); array.push(arena.integer_descriptor, 0);\n    array.push(arena.map_written, iie);\n    array.push(arena.nullable, iie);\n    array.push(arena.struct_arity, -1);\n    array.push(arena.struct_exact, iie);\n    kaku empty: []int64 = [];\n    array.push(arena.fields, empty);\n    kaku targets: []int64 = []; array.push(arena.targets, targets);\n    kaku variants: [][]int64 = []; array.push(arena.variants, variants);\n    kaesu id;\n}\n\nwaza type_root(arena: TypeArena, node: int64) -> int64 {\n    kaku root = node;\n    aida (arena.parent[root] != root) { root = arena.parent[root]; }\n    kaku cursor = node;\n    aida (arena.parent[cursor] != cursor) {\n        kaku next = arena.parent[cursor];\n        arena.parent[cursor] = root;\n        cursor = next;\n    }\n    kaesu root;\n}\n\nkoukai waza type_kind(analysis: TypeAnalysis, node: int64) -> int64 {\n    kaesu analysis.arena.kind[type_root(analysis.arena, node)];\n}\n\nkoukai waza integer_descriptor(analysis: TypeAnalysis, node: int64) -> int64 {\n    kaesu analysis.arena.integer_descriptor[type_root(analysis.arena, node)];\n}\n\nkoukai waza type_nullable(analysis: TypeAnalysis, node: int64) -> bool {\n    kaesu analysis.arena.nullable[type_root(analysis.arena, node)];\n}\n\nkoukai waza type_is_heap_reference(analysis: TypeAnalysis, node: int64) -> bool {\n    kaku kind = type_kind(analysis, node);\n    kaesu kind == type_string_id || kind == type_array_ref || kind == type_struct_ref || kind == type_enum_ref ||\n        kind == type_function_ref || kind == type_map_ref || (type_nullable(analysis, node) && type_is_scalar_kind(kind));\n}\n\nwaza type_is_scalar_kind(kind: int64) -> bool {\n    kaesu kind == type_integer || kind == type_float32 || kind == type_float64 || kind == type_float_any ||\n        kind == type_bool || kind == type_string_id;\n}\n\nwaza type_merge_fields(arena: TypeArena, left: int64, right: int64) -> bool {\n    kaku left_fields = arena.fields[left];\n    kaku right_fields = arena.fields[right];\n    kaku index = 0;\n    aida (index < len(right_fields)) {\n        moshi (index < len(left_fields)) {\n            moshi (!type_join(arena, left_fields[index], right_fields[index])) { kaesu iie; }\n        }\n        sore { array.push(left_fields, right_fields[index]); }\n        index = index + 1;\n    }\n    arena.fields[left] = left_fields;\n    kaesu hai;\n}\n\n// Union is deliberately strict.  Unknown is a constraint variable, while Nil\n// only adds nullability to a concrete representation.  Two different concrete\n// representations never silently collapse to \"maybe a pointer\".\nwaza type_join(arena: TypeArena, a: int64, b: int64) -> bool {\n    moshi (a < 0 || b < 0 || a >= len(arena.parent) || b >= len(arena.parent)) { kaesu iie; }\n    kaku left = type_root(arena, a);\n    kaku right = type_root(arena, b);\n    moshi (left == right) { kaesu hai; }\n    kaku left_kind = arena.kind[left];\n    moshi (arena.trace[0] && arena.nullable[left] != arena.nullable[right]) { array.push(arena.nullable_origins, [arena.context[0], a, b, 1]); }\n    moshi (arena.trace[0] && ((arena.kind[left] == type_nil && arena.kind[right] != type_nil && arena.kind[right] != type_unknown) || (arena.kind[right] == type_nil && arena.kind[left] != type_nil && arena.kind[left] != type_unknown))) { array.push(arena.nullable_origins, [arena.context[0], a, b, 2]); }\n    kaku right_kind = arena.kind[right];\n    kaku resolved = iie;\n    moshi ((left_kind == type_float_any && (right_kind == type_float32 || right_kind == type_float64)) ||\n        (right_kind == type_float_any && (left_kind == type_float32 || left_kind == type_float64))) {\n        arena.kind[left] = type_float_any;\n        resolved = hai;\n    }\n    moshi (left_kind == type_nil && right_kind != type_nil && right_kind != type_unknown) {\n        arena.kind[left] = right_kind;\n        arena.nullable[left] = hai;\n        resolved = hai;\n    }\n    moshi (!resolved && right_kind == type_nil && left_kind != type_nil && left_kind != type_unknown) {\n        arena.nullable[left] = hai;\n        resolved = hai;\n    }\n    moshi (!resolved && left_kind == type_unknown) { arena.kind[left] = right_kind; resolved = hai; }\n    moshi (!resolved && right_kind != type_unknown && left_kind != right_kind) { kaesu iie; }\n\n    moshi (arena.struct_exact[left] && arena.struct_exact[right] &&\n        arena.struct_arity[left] != arena.struct_arity[right]) { kaesu iie; }\n    moshi (arena.integer_descriptor[left] != 0 && arena.integer_descriptor[right] != 0 && arena.integer_descriptor[left] != arena.integer_descriptor[right]) { kaesu iie; }\n    moshi (arena.integer_descriptor[left] == 0) { arena.integer_descriptor[left] = arena.integer_descriptor[right]; }\n    moshi (arena.array_descriptor[left] != 0 && arena.array_descriptor[right] != 0 && arena.array_descriptor[left] != arena.array_descriptor[right]) { kaesu iie; }\n    moshi (arena.array_descriptor[left] == 0) { arena.array_descriptor[left] = arena.array_descriptor[right]; }\n    arena.map_written[left] = arena.map_written[left] || arena.map_written[right];\n    arena.parent[right] = left; arena.revision[0] = arena.revision[0] + 1;\n    // Nullability belongs to the class before the recursive field joins run: a self-referential shape\n    // (struct Tree { left: Tree? }) can make a nested join re-parent `left`, and anything written to `left`\n    // afterwards would land on a node that is no longer the root.\n    arena.nullable[left] = arena.nullable[left] || arena.nullable[right];\n    moshi (!type_merge_fields(arena, left, right)) { kaesu iie; }\n    moshi (arena.array_width[left] != 0 && arena.array_width[right] != 0 && arena.array_width[left] != arena.array_width[right]) { kaesu iie; }\n    moshi (arena.array_width[left] == 0) { arena.array_width[left] = arena.array_width[right]; }\n    kaku variants = arena.variants[left]; kaku vi = 0;\n    aida (vi < len(arena.variants[right])) {\n        aida (len(variants) <= vi) { kaku empty: []int64 = []; array.push(variants, empty); }\n        kaku incoming = arena.variants[right][vi]; kaku current = variants[vi];\n        moshi (len(incoming) > 0) {\n            moshi (len(current) == 0) { variants[vi] = incoming; }\n            sore {\n                moshi (len(current) != len(incoming)) { kaesu iie; }\n                kaku fi = 1; aida (fi < len(current)) { moshi (!type_join(arena, current[fi], incoming[fi])) { kaesu iie; } fi = fi + 1; }\n            }\n        }\n        vi = vi + 1;\n    }\n    arena.variants[left] = variants;\n    kaku targets = arena.targets[left];\n    kaku ti = 0;\n    aida (ti < len(arena.targets[right])) {\n        kaku target = arena.targets[right][ti]; kaku found = iie; kaku tj = 0;\n        aida (tj < len(targets)) { moshi (targets[tj] == target) { found = hai; } tj = tj + 1; }\n        moshi (!found) { array.push(targets, target); } ti = ti + 1;\n    }\n    arena.targets[left] = targets;\n    arena.parent[right] = left;\n    arena.nullable[left] = arena.nullable[left] || arena.nullable[right];\n    moshi (!arena.struct_exact[left] && arena.struct_exact[right]) {\n        arena.struct_exact[left] = hai;\n        arena.struct_arity[left] = arena.struct_arity[right];\n    }\n    moshi (!arena.struct_exact[left] && arena.struct_arity[left] < arena.struct_arity[right]) {\n        arena.struct_arity[left] = arena.struct_arity[right];\n    }\n    // A nested join may have re-parented `left` (see above): carry its facts to the current root.\n    kaesu type_carry_to_root(arena, left);\n}\n\nwaza type_carry_to_root(arena: TypeArena, node: int64) -> bool {\n    kaku root = type_root(arena, node);\n    moshi (root == node) { kaesu hai; }\n    moshi (arena.nullable[node] && !arena.nullable[root]) { arena.nullable[root] = hai; arena.revision[0] = arena.revision[0] + 1; }\n    moshi (arena.map_written[node] && !arena.map_written[root]) { arena.map_written[root] = hai; arena.revision[0] = arena.revision[0] + 1; }\n    moshi (merge_targets(arena.targets[root], arena.targets[node])) { arena.revision[0] = arena.revision[0] + 1; }\n    moshi (arena.struct_exact[node] && arena.struct_exact[root] && arena.struct_arity[node] != arena.struct_arity[root]) { kaesu iie; }\n    moshi (arena.struct_exact[node] && !arena.struct_exact[root]) { arena.struct_exact[root] = hai; arena.struct_arity[root] = arena.struct_arity[node]; }\n    moshi (!arena.struct_exact[root] && arena.struct_arity[root] < arena.struct_arity[node]) { arena.struct_arity[root] = arena.struct_arity[node]; }\n    kaku variants = arena.variants[node]; kaku current = arena.variants[root]; kaku vi = 0;\n    aida (vi < len(variants)) {\n        aida (len(current) <= vi) { kaku empty: []int64 = []; array.push(current, empty); }\n        moshi (len(current[vi]) == 0 && len(variants[vi]) > 0) { current[vi] = variants[vi]; }\n        vi = vi + 1;\n    }\n    arena.variants[root] = current;\n    kaesu hai;\n}\n\nwaza type_require(arena: TypeArena, node: int64, kind: int64) -> bool {\n    kaesu type_join(arena, node, type_new(arena, kind));\n}\n\nwaza type_mark_nullable(arena: TypeArena, node: int64) -> unit {\n    moshi (node < 0 || node >= len(arena.parent)) { kaesu; }\n    moshi (arena.trace[0]) { array.push(arena.nullable_origins, [arena.context[0], node, node, 3]); }\n    arena.nullable[type_root(arena, node)] = hai;\n}\n\nwaza type_new_struct(arena: TypeArena, fields: []int64) -> int64 {\n    kaku node = type_new(arena, type_struct_ref);\n    arena.struct_arity[node] = len(fields);\n    arena.struct_exact[node] = hai;\n    arena.fields[node] = fields;\n    kaesu node;\n}\n\nwaza type_struct_field(arena: TypeArena, node: int64, index: int64) -> int64 {\n    kaku root = type_root(arena, node);\n    moshi (arena.kind[root] == type_unknown) { arena.kind[root] = type_struct_ref; }\n    // A class that has only met nil so far (for example a global initialised with mu whose struct stores are\n    // analysed in a later block) is a nullable struct once a field is read, exactly as type_join(nil, struct).\n    moshi (arena.kind[root] == type_nil) { arena.kind[root] = type_struct_ref; arena.nullable[root] = hai; arena.revision[0] = arena.revision[0] + 1; }\n    moshi (arena.kind[root] != type_struct_ref || index < 0) { kaesu -1; }\n    moshi (arena.struct_exact[root] && index >= arena.struct_arity[root]) { kaesu -1; }\n    kaku fields = arena.fields[root];\n    aida (len(fields) <= index) { array.push(fields, type_new(arena, type_unknown)); }\n    arena.fields[root] = fields;\n    moshi (arena.struct_arity[root] < index + 1) { arena.struct_arity[root] = index + 1; }\n    kaesu fields[index];\n}\n\n// Arrays reuse the constraint edge vector with one element edge. The node\n// kind distinguishes these edges from Struct fields.\nkoukai waza type_array_element(arena: TypeArena, node: int64) -> int64 {\n    kaku root = type_root(arena, node);\n    moshi (arena.kind[root] == type_unknown) { arena.kind[root] = type_array_ref; arena.revision[0] = arena.revision[0] + 1; }\n    moshi (arena.kind[root] != type_array_ref) { kaesu -1; }\n    kaku fields = arena.fields[root];\n    moshi (len(fields) == 0) { array.push(fields, type_new(arena, type_unknown)); arena.fields[root] = fields; }\n    kaesu fields[0];\n}\n\n// Map edges describe key and stored nullable value independently of the\n// descriptor's physical linked-entry layout. Scalar values use existing boxes.\nkoukai waza map_field(arena: TypeArena, node: int64, index: int64) -> int64 {\n    moshi (!type_require(arena, node, type_map_ref)) { kaesu -1; }\n    kaku root = type_root(arena, node); kaku fields = arena.fields[root];\n    aida (len(fields) < 2) { array.push(fields, type_new(arena, type_unknown)); }\n    arena.fields[root] = fields;\n    type_mark_nullable(arena, fields[1]);\n    kaesu fields[index];\n}\n\nwaza type_descriptor_kind(descriptor: int64) -> int64 {\n    kaku kind = descriptor - (descriptor / 128) * 128;\n    moshi (kind == 0) { kaesu type_unknown; }\n    moshi (kind == 2) { kaesu type_float64; }\n    moshi (kind == 3) { kaesu type_float32; }\n    moshi (kind == 4) { kaesu type_bool; }\n    moshi (kind == 5) { kaesu type_string_id; }\n    moshi (kind == 7) { kaesu type_array_ref; }\n    moshi (kind == 8) { kaesu type_struct_ref; }\n    moshi (kind == 9) { kaesu type_enum_ref; }\n    moshi (kind == 10) { kaesu type_map_ref; }\n    moshi (kind == 11) { kaesu type_function_ref; }\n    kaesu type_integer;\n}\n\nkoukai waza type_instruction_width(opcode: int64) -> int64 {\n    moshi (opcode == 1 || (opcode >= 17 && opcode <= 20) ||\n        (opcode >= 23 && opcode <= 25) || opcode == 30 || opcode == 36 || opcode == 37 ||\n        opcode == 40 || (opcode >= 44 && opcode <= 49)) { kaesu 3; }\n    moshi (opcode == 38) { kaesu 5; }\n    moshi (opcode == 56 || opcode == 67) { kaesu 4; }\n    moshi (opcode == 54) { kaesu 3; }\n    moshi (opcode == 55 || opcode == 57 || opcode == 58 || opcode == 65 || opcode == 66) { kaesu 2; }\n    moshi ((opcode >= 2 && opcode <= 16) || opcode == 21 || opcode == 22 ||\n        (opcode >= 26 && opcode <= 35) || (opcode >= 39 && opcode <= 43) ||\n        (opcode >= 50 && opcode <= 53) || (opcode >= 59 && opcode <= 64)) { kaesu 