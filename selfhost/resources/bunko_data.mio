\"invalid\");old_add(f,480);\n ir.branch(f,ir.label,0,\"done\");treturn(f,0);\n ir.branch(f,ir.label,0,\"invalid\");tconstant(f,5,4);old_error(f,5);ir.invoke_function(f,\"gc_old_abort_join\",6,[0]);treturn(f,4);kaesu f;\n}\n// Fresh object storage may be promoted by a nested allocation before its\n// descriptor/fields finish initialization. Hold the marker across the entire\n// existing Mutator heap epoch, rather than resuming immediately after malloc.\nwaza old_pause_epoch_program() -> ir.Function {\n kaku f=ir.function(\"gc_old_pause_epoch\");ir.put(f,ir.acquire_load,5,0,0,144);tcheck(f,5,old_phase_abort,\"abort\");tconstant(f,6,old_phase_mark);ir.put(f,ir.equal,6,5,6,0);ir.branch(f,ir.zero,6,\"done\");ir.put(f,ir.load,5,0,0,496);ir.branch(f,ir.nonzero,5,\"done\");ir.invoke_function(f,\"gc_old_pause\",5,[0]);ir.put(f,ir.result,0,5,0,0);\n ir.branch(f,ir.label,0,\"abort\");ir.invoke_function(f,\"gc_old_abort_join\",5,[0]);ir.put(f,ir.result,0,5,0,0);\n ir.branch(f,ir.label,0,\"done\");treturn(f,0);kaesu f;\n}\nwaza old_resume_epoch_program() -> ir.Function {\n kaku f=ir.function(\"gc_old_resume_epoch\");ir.put(f,ir.load,5,0,0,496);ir.branch(f,ir.zero,5,\"done\");tconstant(f,6,1);ir.put(f,ir.equal,6,5,6,0);ir.branch(f,ir.zero,6,\"invalid\");ir.invoke_function(f,\"gc_old_resume\",5,[0]);ir.put(f,ir.result,0,5,0,0);\n ir.branch(f,ir.label,0,\"invalid\");tconstant(f,5,4);old_error(f,5);ir.invoke_function(f,\"gc_old_abort_join\",6,[0]);treturn(f,4);\n ir.branch(f,ir.label,0,\"done\");treturn(f,0);kaesu f;\n}\n// The adapter supplies an OWNED optional extension slot offset, containing a\n// pointer to the shared control-pointer slot. No CPU or OS layout is assumed.\n// Interpose every original gc_end path, including Native blocking and error\n// cleanup, so pause ownership cannot leak across a Mutator epoch transfer.\nwaza old_end_epoch_program(control_link_offset:int64) -> ir.Function {\n kaku f=ir.function(\"gc_end\");tprepare(f);tload(f,10,thread_registry);ir.put(f,ir