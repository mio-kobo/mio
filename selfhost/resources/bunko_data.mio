JSON data\"); }\n    kaesu Document { values: state.values, root: root, error: state.error[0], offset: state.at[0] };\n}\nkoukai waza member(document: Document, object: int64, key: string) -> int64 {\n    moshi (object < 0 || object >= len(document.values) || document.values[object].kind != 5) { kaesu -1; }\n    kaku node = document.values[object]; kaku at = len(node.keys) - 1;\n    aida (at >= 0) { moshi (node.keys[at] == key) { kaesu node.children[at]; } at = at - 1; } kaesu -1;\n}\nkoukai waza text(document: Document, node: int64) -> string {\n    moshi (node < 0 || node >= len(document.values)) { kaesu \"\"; } kaesu document.values[node].text;\n}\nkoukai waza integer(document: Document, node: int64) -> int64? {\n    moshi (node < 0 || node >= len(document.values) || document.values[node].kind != 2) { kaesu mu; }\n    kaesu convert.parse_int(document.values[node].text);\n}\nkoukai waza quote(text: string) -> string {\n    kaku bytes = string.to_bytes(text); kaku output: []uint8 = [uint8(34)]; kaku digits = string.to_bytes(\"0123456789abcdef\"); kaku at = 0;\n    aida (at < len(bytes)) {\n        kaku byte = int64(bytes[at]); kaku escaped = 0;\n        moshi (byte == 34 || byte == 92) { escaped = byte; }\n        moshi (byte == 8) { escaped = 98; } moshi (byte == 9) { escaped = 116; } moshi (byte == 10) { escaped = 110; } moshi (byte == 12) { escaped = 102; } moshi (byte == 13) { escaped = 114; }\n        moshi (escaped > 0) { array.push(output, uint8(92)); array.push(output, uint8(escaped)); }\n        sore { moshi (byte < 32) {\n            array.push(output, uint8(92)); array.push(output, uint8(117)); array.push(output, uint8(48)); array.push(output, uint8(48)); array.push(output, digits[byte / 16]); array.push(output, digits[byte - (byte / 16) * 16]);\n        } sore { array.push(output, uint8(byte)); } }\n        at = at + 1;\n    }\n    array.push(output, uint8(34)); kaku result = string.from_utf8(output); moshi (result == mu) { kaesu \"\\\"\\\"\"; } kaesu r