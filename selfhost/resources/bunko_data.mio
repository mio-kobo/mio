waza data_15() -> File { kaesu File { path: "kiso/aot/lower/map.mio", version: "Bunko-v2.1.1", length: 5856, sha256: "20a77eae380db60b60b23d92589f919cc0563f5267aedbee5ac8b72bff2f439c", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/string\";\n\n// Maps use ordinary exact-bitmap managed Struct objects, so the existing\n// non-moving collector, LOS and remembered-set protocol remain authoritative.\n// Descriptor: one reference field (head). Entry: next, key, nullable value.\n// Lookup is linear; replacing a key updates its entry without retaining history.\nwaza emit_map_header(code: arm64.Assembler, count: int64, bitmap: int64) -> unit {\n    emit(code, arm64.movz_x(9, 1, 0));\n    emit(code, arm64.str_x(9, 12, 0));\n    emit(code, arm64.movz_x(9, count, 0));\n    emit(code, arm64.str_x(9, 12, 8));\n    emit(code, arm64.str_x(9, 12, 16));\n    emit(code, arm64.movz_x(9, 1, 0));\n    emit(code, arm64.str_x(9, 12, 24));\n    emit(code, arm64.movz_x(9, bitmap, 0));\n    emit(code, arm64.str_x(9, 12, 32));\n}\n\nwaza emit_map(code: arm64.Assembler, patches: []macho.AddressPatch,\n    analysis: types.TypeAnalysis, function_id: int64, entries: []int64, opcode: int64) -> bool {\n    moshi (opcode == 41) {\n        kaku shadow = emit_shadow_push(code, patches, analysis, function_id, entries);\n        moshi (shadow < 0) { kaesu iie; }\n        move_bits(code, 0, uint32(0), uint32(48));\n        move_bits(code, 1, uint32(0), uint32(100));\n        arm64.assembler_bl(code, \"runtime_alloc\");\n        emit_shadow_pop(code, shadow);\n        arm64.assembler_cbz_x(code, 0, \"runtime_oom\");\n        move_x(code, 12, 0);\n        emit_map_header(code, 1, 1);\n        emit(code, arm64.str_x(31, 12, 40));\n        push_register(code, 12);\n        kaesu hai;\n    }\n    kaku count = 2;\n    moshi (opcode == 43) {\n        count = 3;\n    }\n    kaku first = len(entries) - count;\n    moshi (first < 0) {\n        kaesu iie;\n    }\n    kaku key = entries[first + 1];\n    kaku kind = types.type_kind(analysis, key);\n    moshi (kind != types.type_integer && kind != types.type_bool && kind != types.type_string_id) { kaesu iie; }\n    kaku prefix = block_label(\"map_\", len(code.words));\n    kaku loop = string.concat(prefix, \"_loop\");\n    kaku missing = string.concat(prefix, \"_missing\");\n    kaku found = string.concat(prefix, \"_found\");\n    kaku done = string.concat(prefix, \"_done\");\n    // x22 is the Mio call-depth counter, not a disposable cursor register.\n    // Preserve it while searching; runtime allocation helpers preserve x22,\n    // and descriptor/entry operands remain in the exact Shadow Frame.\n    emit(code, arm64.sub_imm_x(31, 31, 16, iie));\n    emit(code, arm64.str_x(22, 31, 0));\n    emit(code, arm64.ldr_x(9, 19, first * 8));\n    arm64.assembler_cbz_x(code, 9, \"runtime_error\");\n    emit(code, arm64.ldr_x(22, 9, 40));\n    arm64.assembler_label(code, loop);\n    arm64.assembler_cbz_x(code, 22, missing);\n    emit(code, arm64.ldr_x(9, 22, 48));\n    emit(code, arm64.ldr_x(10, 19, (first + 1) * 8));\n    moshi (kind == types.type_string_id) {\n        emit_string_equal(code, 11);\n        arm64.assembler_cbnz_x(code, 9, found);\n    }\n    sore {\n        emit_unbox_register(code, analysis, key, 9);\n        emit_unbox_register(code, analysis, key, 10);\n        emit(code, arm64.cmp_x(9, 10));\n        arm64.assembler_b_cond(code, 0, found);\n    }\n    emit(code, arm64.ldr_x(22, 22, 40));\n    arm64.assembler_b(code, loop);\n    arm64.assembler_label(code, found);\n    moshi (opcode == 42) {\n        emit(code, arm64.ldr_x(9, 22, 56));\n        emit(code, arm64.sub_imm_x(20, 20, 16, iie));\n        push_register(code, 9);\n    }\n    sore {\n        emit(code, arm64.ldr_x(9, 19, (first + 2) * 8));\n        moshi (old_mark_proto_enabled(code)) {\n            kaku scalar = string.concat(prefix, \"_scalar_value\");\n            emit(code, arm64.ldr_x(13, 22, 32));\n            emit(code, arm64.lsr_x(13, 13, 2));\n            move_bits(code, 14, uint32(0), uint32(1));\n            emit(code, arm64.and_x(13, 13, 14));\n            arm64.assembler_cbz_x(code, 13, scalar);\n            emit_old_typed_prewrite(code, 22, 56);\n            arm64.assembler_label(code, scalar);\n        }\n        emit_old_release_store(code, 9, 22, 56);\n        emit_gen_remember(code, 22);\n        emit(code, arm64.sub_imm_x(20, 20, 24, iie));\n    }\n    arm64.assembler_b(code, done);\n    arm64.assembler_label(code, missing);\n    moshi (opcode == 42) {\n        emit(code, arm64.sub_imm_x(20, 20, 16, iie));\n        emit(code, arm64.movz_x(9, 0, 0));\n        push_register(code, 9);\n    }\n    sore {\n        kaku value = entries[first + 2];\n        moshi (!root_node_ok(analysis, value)) {\n            kaesu iie;\n        }\n        kaku bitmap = 1;\n        moshi (types.type_is_heap_reference(analysis, key)) { bitmap = bitmap + 2; }\n        moshi (types.type_is_heap_reference(analysis, value)) { bitmap = bitmap + 4; }\n        kaku shadow = emit_shadow_push(code, patches, analysis, function_id, entries);\n        moshi (shadow < 0) { kaesu iie; }\n        move_bits(code, 0, uint32(0), uint32(64));\n        move_bits(code, 1, uint32(0), uint32(100));\n        arm64.assembler_bl(code, \"runtime_alloc\");\n        emit_shadow_pop(code, shadow);\n        arm64.assembler_cbz_x(code, 0, \"runtime_oom\");\n        move_x(code, 12, 0);\n        emit_map_header(code, 3, bitmap);\n        emit(code, arm64.ldr_x(10, 19, first * 8));\n        emit(code, arm64.ldr_x(9, 10, 40));\n        emit(code, arm64.str_x(9, 12, 40));\n        emit(code, arm64.ldr_x(9, 19, (first + 1) * 8));\n        emit(code, arm64.str_x(9, 12, 48));\n        emit(code, arm64.ldr_x(9, 19, (first + 2) * 8));\n        emit(code, arm64.str_x(9, 12, 56));\n        emit_old_typed_prewrite(code, 10, 40);\n        emit_old_release_store(code, 12, 10, 40);\n        emit_gen_remember(code, 10);\n        emit(code, arm64.sub_imm_x(20, 20, 24, iie));\n    }\n    arm64.assembler_label(code, done);\n    emit(code, arm64.ldr_x(22, 31, 0));\n    emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    kaesu hai;\n}\n" }; }
