waza data_76() -> File { kaesu File { path: "kiso/runtime/abi/abi.mio", version: "Bunko-v2.1.1", length: 3778, sha256: "62421d144a44bf756b95aa21884f20de705c065af5a9c12b3cdeacd9b6272457", source: "// Mio Runtime ABI contract, revision RA-1 (docs/runtime-abi.md).\n//\n// The contract fixes what every native target must guarantee to a Mio program (exact roots, object lifetime, memory\n// safety, the reference store paths) and names the object layout profile each target implements. It does not fix one\n// collector: the generational layout (Object ABI v1, kiso/runtime/gc/layout.mio) and the x86-64 mark & sweep layout\n// (kiso/aot/lowerlinux, kiso/aot/lowerwinrt) are the two existing profiles. Binaries of different targets never\n// exchange heap objects, so the profiles need not be byte compatible with each other; a target must match its own\n// profile exactly. No target-specific machine detail lives here.\n\nkoukai teisu contract_revision = 1;          // RA-1\nkoukai teisu word_bytes = 8;                 // every target is 64-bit little endian\nkoukai teisu header_bytes = 16;              // every heap object starts with a two-word header\nkoukai teisu gc_stress_threshold_bytes = 16384; // `mio build --gc-stress` on threshold-driven collectors\n\n// Layout profiles.\nkoukai teisu profile_generational_v1 = 1;    // darwin-arm64: Object ABI v1 (layout_version 1)\nkoukai teisu profile_x64_marksweep_v1 = 2;   // linux-amd64, windows-amd64\n\nkoukai kata Profile {\n    id: int64;\n    name: string;\n    header_bytes: int64;\n    object_alignment: int64;       // address alignment of every object start\n    size_granule: int64;           // object sizes are rounded up to a multiple of this\n    generational: bool;            // young/old generations with a remembered set\n    large_object_threshold: int64; // 0 = no separate large-object space\n    write_barrier: bool;           // reference stores into old objects are recorded\n    root_scheme: string;           // how exact stack roots are found\n    safepoints: string;            // where collections may start\n}\n\nkoukai waza profile(id: int64) -> Profile {\n    moshi (id == profile_generational_v1) {\n        kaesu Profile { id: id, name: \"generational-v1\", header_bytes: 16, object_alignment: 16, size_granule: 16,\n            generational: hai, large_object_threshold: 131072, write_barrier: hai,\n            root_scheme: \"shadow-frames\", safepoints: \"allocation\" };\n    }\n    moshi (id == profile_x64_marksweep_v1) {\n        kaesu Profile { id: id, name: \"x64-marksweep-v1\", header_bytes: 16, object_alignment: 8, size_granule: 8,\n            generational: iie, large_object_threshold: 0, write_barrier: iie,\n            root_scheme: \"inline-frame-descriptors\", safepoints: \"function-entry-and-back-edge\" };\n    }\n    kaesu Profile { id: 0, name: \"\", header_bytes: 0, object_alignment: 0, size_granule: 0, generational: iie,\n        large_object_threshold: 0, write_barrier: iie, root_scheme: \"\", safepoints: \"\" };\n}\n\n// The profile a native target implements; 0 for an unknown target (callers must fail closed).\nkoukai waza target_profile(target: string) -> int64 {\n    moshi (target == \"darwin-arm64\") { kaesu profile_generational_v1; }\n    moshi (target == \"linux-amd64\" || target == \"windows-amd64\") { kaesu profile_x64_marksweep_v1; }\n    kaesu 0;\n}\n\n// Contract invariants every profile must satisfy.\nkoukai waza profile_valid(p: Profile) -> bool {\n    moshi (p.id == 0) { kaesu iie; }\n    moshi (p.header_bytes != header_bytes) { kaesu iie; }\n    moshi (p.object_alignment < word_bytes || p.size_granule < word_bytes) { kaesu iie; }\n    moshi (p.object_alignment - (p.object_alignment / word_bytes) * word_bytes != 0) { kaesu iie; }\n    // a generational profile must record old-to-young references\n    moshi (p.generational && !p.write_barrier) { kaesu iie; }\n    moshi (p.large_object_threshold != 0 && p.large_object_threshold < 4096) { kaesu iie; }\n    kaesu p.root_scheme != \"\" && p.safepoints != \"\";\n}\n" }; }
waza data_77() -> File { kaesu File { path: "kiso/runtime/cpu/aarch64/atomic.mio", version: "Bunko-v2.1.1", length: 3249, sha256: "e7ac14fccf9d890b5b9d6815902df5b0f922d4489122816a2c9c8e92e94d5126", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/runtime/gc\";\nyobu \"kiso/string\";\nyobu \"kiso/convert\";\n// CPU ABI: x0 address, x1 desired/addend, x2 expected; x0 observed old,\n// x3 is CAS success; for other operations it is unspecified. x9-x12 clobbered.\n// Never uses platform x18.\n// Strong CAS retries exclusive failure, clearing monitor on value mismatch.\n// SeqCst is conservatively fenced on both sides; weaker ops use one-way ops.\nkoukai waza emit_atomic(code: arm64.Assembler, op: gc.RuntimeOp) -> string {\n    moshi (!gc.valid_operation(op) || op.kind < gc.atomic_load || op.kind > gc.fence) { kaesu \"INVALID_RUNTIME_OP\"; }\n    kaku prefix = string.concat(\"atomic_\", convert.format_int(len(code.words)));\n    kaku retry = string.concat(prefix,\"_retry\"); kaku mismatch = string.concat(prefix,\"_mismatch\"); kaku done = string.concat(prefix,\"_done\");\n    moshi (op.order == gc.seq_cst) { arm64.assembler_emit(code,arm64.dmb_ish()); }\n    moshi (op.kind == gc.fence) { moshi (op.order != gc.seq_cst) { arm64.assembler_emit(code,arm64.dmb_ish()); } }\n    sore { moshi (op.kind == gc.atomic_load) {\n        moshi (op.order == gc.relaxed) { arm64.assembler_emit(code,arm64.ldr_x(0,0,0)); }\n        sore { arm64.assembler_emit(code,arm64.ldar_x(0,0)); }\n    } sore { moshi (op.kind == gc.atomic_store) {\n        moshi (op.order == gc.relaxed) { arm64.assembler_emit(code,arm64.str_x(1,0,0)); }\n        sore { arm64.assembler_emit(code,arm64.stlr_x(1,0)); }\n    } sore {\n        arm64.assembler_emit(code,arm64.add_imm_x(9,0,0,iie));\n        arm64.assembler_label(code,retry);\n        kaku load_acquire = op.order == gc.acquire || op.order == gc.acq_rel || op.order == gc.seq_cst || op.failure_order == gc.acquire;\n        kaku store_release = op.order == gc.release || op.order == gc.acq_rel || op.order == gc.seq_cst;\n        arm64.assembler_emit(code,arm64.ldxr_x(0,9,load_acquire));\n        moshi (op.kind == gc.atomic_cas) {\n            arm64.assembler_emit(code,arm64.cmp_x(0,2)); arm64.assembler_b_cond(code,1,mismatch);\n            arm64.assembler_emit(code,arm64.stxr_x(10,1,9,store_release));\n        } sore {\n            arm64.assembler_emit(code,arm64.add_x(11,0,1));\n            arm64.assembler_emit(code,arm64.stxr_x(10,11,9,store_release));\n        }\n        arm64.assembler_cbnz_x(code,10,retry);\n        arm64.assembler_emit(code,arm64.movz_x(3,1,0)); arm64.assembler_b(code,done);\n        arm64.assembler_label(code,mismatch); arm64.assembler_emit(code,arm64.clrex());\n        arm64.assembler_emit(code,arm64.movz_x(3,0,0)); arm64.assembler_label(code,done);\n    } } }\n    moshi (op.order == gc.seq_cst) { arm64.assembler_emit(code,arm64.dmb_ish()); }\n    kaesu \"\";\n}\n\n// x0-x7 hold public ABI arguments, native result returned in x0. Caller\n// saves its runtime registers/frame before crossing this boundary. x16 scratch.\nkoukai waza emit_import_call(code:arm64.Assembler, table:int64, slot:int64, slots:int64) -> string {\n    moshi(table<0 || table>28 || table==16 || table==18 || slot<0 || slot>=slots || slots<1 || slots>4096){kaesu \"INVALID_IMPORT_CALL\";}\n    moshi(arm64.assembler_emit(code,arm64.ldr_x(16,table,slot*8))!=mu ||\n        arm64.assembler_emit(code,arm64.blr_x(16))!=mu){kaesu \"IMPORT_CALL_ENCODING_FAILURE\";}\n    kaesu \"\";\n}\n" }; }
waza data_78() -> File { kaesu File { path: "kiso/runtime/cpu/aarch64/program.mio", version: "Bunko-v2.1.1", length: 8755, sha256: "1c6118362934cba30389b26cb20a90fc6007547ed6b37e4c69b684375378c3d7", source: "yobu \"kiso/runtime/ir\";\nyobu \"kiso/array\";\n// Native scalar ABI: x0..x6 arguments, x7 import table, x0 result. Every\n// function preserves x19 and the return address; all virtual values are spills.\n// CPU lowering owns registers, instruction choices, stack and code addresses.\nkoukai kata FunctionPatch {word:int64; name:string;}\nwaza ir_name(prefix:string,name:string) -> string {kaesu string.concat(prefix,string.concat(\"_\",name));}\nwaza ir_emit(c:arm64.Assembler,word:arm64.Instruction) -> unit {arm64.assembler_emit(c,word);}\nwaza ir_number(c:arm64.Assembler,r:int64,value:int64) -> unit {\n    kaku v=value;kaku negative=iie;moshi(v<0){v=-(v+1);negative=hai;}\n    kaku shift=0;\n    aida(shift<4){kaku part=v-(v/65536)*65536;\n        moshi(shift==0){moshi(negative){ir_emit(c,arm64.movn_x(r,part,0));}sore{ir_emit(c,arm64.movz_x(r,part,0));}}\n        sore{moshi(negative){part=65535-part;}ir_emit(c,arm64.movk_x(r,part,shift));}\n        v=v/65536;shift=shift+1;\n    }\n}\nwaza ir_read(c:arm64.Assembler,virtual:int64,r:int64) -> unit {ir_emit(c,arm64.ldr_x(r,31,virtual*8));}\nwaza ir_write(c:arm64.Assembler,virtual:int64,r:int64) -> unit {ir_emit(c,arm64.str_x(r,31,virtual*8));}\nwaza ir_offset(c:arm64.Assembler,dst:int64,base:int64,offset:int64) -> unit {\n    moshi(offset<=4095){ir_emit(c,arm64.add_imm_x(dst,base,offset,iie));}\n    sore{ir_number(c,12,offset);ir_emit(c,arm64.add_x(dst,base,12));}\n}\nkoukai waza emit_program(c:arm64.Assembler,functions:[]ir.Function,bindings:[]ir.Binding,slots:int64,prefix:string) -> string {\n    // Validate the complete program before emitting any machine code.\n    kaku fi=0;\n    aida(fi<len(functions)){\n        kaku f=functions[fi];moshi(f.name==\"\"){kaesu \"INVALID_RUNTIME_FUNCTION\";}\n        kaku j=0;aida(j<fi){moshi(functions[j].name==f.name){kaesu \"DUPLICATE_RUNTIME_FUNCTION\";}j=j+1;}\n        kaku si=0;aida(si<len(f.steps)){\n            kaku s=f.steps[si];moshi(!ir.valid_step(s)){kaesu \"INVALID_RUNTIME_STEP\";}\n            moshi(s.kind==ir.label){\n                moshi(s.name==\"__epilogue\"){kaesu \"RESERVED_RUNTIME_LABEL\";}\n                j=0;aida(j<si){moshi(f.steps[j].kind==ir.label && f.steps[j].name==s.name){kaesu \"DUPLICATE_RUNTIME_LABEL\";}j=j+1;}\n            }\n            moshi(s.kind==ir.compare_exchange && len(s.arguments)!=1){kaesu \"INVALID_CAS_ARGUMENT\";}\n            moshi(s.kind==ir.fetch_add || s.kind==ir.compare_exchange){\n                kaku operation=gc.atomic_add;moshi(s.kind==ir.compare_exchange){operation=gc.atomic_cas;}\n                moshi(!gc.valid_operation(gc.RuntimeOp {kind:operation,address:0,value:1,expected:2,result:3,status:4,order:s.order,failure_order:s.failure_order,alignment:8,epoch:0})){kaesu \"INVALID_RUNTIME_ATOMIC_ORDER\";}\n            }\n            moshi(s.kind==ir.system){\n                kaku found=iie;j=0;aida(j<len(bindings)){\n                    kaku b=bindings[j];moshi(b.operation==s.immediate){\n                        moshi(found || b.slot<0 || b.slot>=slots || len(b.arguments)>7 || (b.result_bits!=32 && b.result_bits!=64)){kaesu \"INVALID_RUNTIME_BINDING\";}found=hai;\n                        kaku a=0;aida(a<len(b.arguments)){moshi(b.arguments[a]>=len(s.arguments) || b.arguments[a]< -65536){kaesu \"INVALID_RUNTIME_ARGUMENT\";}a=a+1;}\n                    }j=j+1;\n                }moshi(!found){kaesu \"NOT_SUPPORTED_RUNTIME_OPERATION\";}\n            }\n            moshi(s.kind==ir.invoke || s.kind==ir.function_address){\n                kaku found=iie;j=0;aida(j<len(functions)){moshi(functions[j].name==s.name){found=hai;}j=j+1;}moshi(!found){kaesu \"UNDEFINED_RUNTIME_FUNCTION\";}\n            }\n            moshi(s.kind==ir.jump || s.kind==ir.zero || s.kind==ir.nonzero){\n                kaku found=iie;j=0;aida(j<len(f.steps)){moshi(f.steps[j].kind==ir.label && f.steps[j].name==s.name){found=hai;}j=j+1;}moshi(!found){kaesu \"UNDEFINED_RUNTIME_LABEL\";}\n            }\n            si=si+1;\n        }fi=fi+1;\n    }\n    kaku patches:[]FunctionPatch=[];fi=0;\n    aida(fi<len(functions)){\n        kaku f=functions[fi];kaku scope=ir_name(prefix,f.name);arm64.assembler_label(c,scope);\n        ir_emit(c,arm64.sub_imm_x(31,31,352,iie));ir_emit(c,arm64.str_x(19,31,320));ir_emit(c,arm64.str_x(30,31,328));\n        ir_emit(c,arm64.add_imm_x(19,7,0,iie));kaku i=0;\n        aida(i<7){ir_write(c,i,i);i=i+1;}\n        // Remaining virtual registers start at zero, including unused args.\n        aida(i<32){ir_write(c,i,31);i=i+1;}\n        i=0;aida(i<len(f.steps)){\n            kaku s=f.steps[i];kaku kind=s.kind;\n            moshi(kind==ir.constant){ir_number(c,9,s.immediate);ir_write(c,s.destination,9);}\n            moshi(kind==ir.copy){ir_read(c,s.left,9);ir_write(c,s.destination,9);}\n            moshi(kind==ir.address || kind==ir.load || kind==ir.store || kind==ir.acquire_load || kind==ir.release_store){\n                ir_read(c,s.left,9);ir_offset(c,9,9,s.immediate);\n                moshi(kind==ir.address){ir_write(c,s.destination,9);}\n                moshi(kind==ir.load || kind==ir.acquire_load){moshi(kind==ir.load){ir_emit(c,arm64.ldr_x(10,9,0));}sore{ir_emit(c,arm64.ldar_x(10,9));}ir_write(c,s.destination,10);}\n                moshi(kind==ir.store || kind==ir.release_store){ir_read(c,s.right,10);moshi(kind==ir.store){ir_emit(c,arm64.str_x(10,9,0));}sore{ir_emit(c,arm64.stlr_x(10,9));}}\n            }\n            moshi(kind>=ir.add && kind<=ir.less_unsigned){\n                ir_read(c,s.left,9);ir_read(c,s.right,10);\n                moshi(kind==ir.add){ir_emit(c,arm64.add_x(11,9,10));}\n                moshi(kind==ir.subtract){ir_emit(c,arm64.sub_x(11,9,10));}\n                moshi(kind==ir.multiply){ir_emit(c,arm64.mul_x(11,9,10));}\n                moshi(kind==ir.divide_unsigned){ir_emit(c,arm64.udiv_x(11,9,10));}\n                moshi(kind==ir.equal || kind==ir.less_unsigned){ir_emit(c,arm64.cmp_x(9,10));kaku condition=0;moshi(kind==ir.less_unsigned){condition=3;}ir_emit(c,arm64.cset_w(11,condition));}\n                ir_write(c,s.destination,11);\n            }\n            moshi(kind==ir.label){arm64.assembler_label(c,ir_name(scope,s.name));}\n            moshi(kind==ir.jump){arm64.assembler_b(c,ir_name(scope,s.name));}\n            moshi(kind==ir.zero || kind==ir.nonzero){ir_read(c,s.left,9);moshi(kind==ir.zero){arm64.assembler_cbz_x(c,9,ir_name(scope,s.name));}sore{arm64.assembler_cbnz_x(c,9,ir_name(scope,s.name));}}\n            moshi(kind==ir.system){\n                kaku bi=0;aida(bi<len(bindings)){\n                    kaku b=bindings[bi];moshi(b.operation==s.immediate){kaku ai=0;aida(ai<len(b.arguments)){\n                        kaku selector=b.arguments[ai];moshi(selector<0){ir_number(c,ai,-selector-1);}sore{ir_read(c,s.arguments[selector],ai);}ai=ai+1;\n                    }emit_import_call(c,19,b.slot,slots);moshi(b.result_bits==32){ir_emit(c,arm64.lsl_x(0,0,32));ir_emit(c,arm64.lsr_x(0,0,32));}}bi=bi+1;\n                }ir_write(c,s.destination,0);\n            }\n            moshi(kind==ir.invoke){kaku ai=0;aida(ai<len(s.arguments)){ir_read(c,s.arguments[ai],ai);ai=ai+1;}ir_emit(c,arm64.add_imm_x(7,19,0,iie));arm64.assembler_bl(c,ir_name(prefix,s.name));ir_write(c,s.destination,0);}\n            moshi(kind==ir.function_address){array.push(patches,FunctionPatch {word:len(c.words),name:ir_name(prefix,s.name)});ir_emit(c,arm64.movz_x(9,0,0));ir_write(c,s.destination,9);}\n            moshi(kind==ir.imports){ir_read(c,s.left,19);}\n            moshi(kind==ir.scratch_address){ir_emit(c,arm64.add_imm_x(9,31,256+s.immediate,iie));ir_write(c,s.destination,9);}\n            moshi(kind==ir.fetch_add || kind==ir.compare_exchange){\n                ir_read(c,s.left,0);ir_read(c,s.right,1);moshi(kind==ir.compare_exchange){moshi(len(s.arguments)!=1){kaesu \"INVALID_CAS_ARGUMENT\";}ir_read(c,s.arguments[0],2);}\n                kaku atomic_kind=gc.atomic_add;moshi(kind==ir.compare_exchange){atomic_kind=gc.atomic_cas;}\n                kaku error=emit_atomic(c,gc.RuntimeOp {kind:atomic_kind,address:0,value:1,expected:2,result:3,status:4,order:s.order,failure_order:s.failure_order,alignment:8,epoch:0});moshi(error!=\"\"){kaesu error;}ir_write(c,s.destination,0);\n            }\n            moshi(kind==ir.result){ir_read(c,s.left,0);arm64.assembler_b(c,ir_name(scope,\"__epilogue\"));}\n            i=i+1;\n        }\n        ir_number(c,0,0);arm64.assembler_label(c,ir_name(scope,\"__epilogue\"));ir_emit(c,arm64.ldr_x(19,31,320));ir_emit(c,arm64.ldr_x(30,31,328));ir_emit(c,arm64.add_imm_x(31,31,352,iie));ir_emit(c,arm64.ret());fi=fi+1;\n    }\n    fi=0;aida(fi<len(patches)){kaku p=patches[fi];kaku at=arm64.assembler_label_word(c,p.name);kaku encoded=arm64.adr(9,(at-p.word)*4);moshi(encoded.error!=mu){kaesu \"RUNTIME_FUNCTION_ADDRESS_OUT_OF_RANGE\";}c.words[p.word]=encoded.word;fi=fi+1;}\n    kaesu \"\";\n}\n" }; }
waza data_79() -> File { kaesu File { path: "kiso/runtime/cpu/amd64/atomic.mio", version: "Bunko-v2.1.1", length: 2300, sha256: "5a391a888dd33d72d90e0610334f2c285d7908b4b6d4e9dfac8619f9fd89be62", source: "yobu \"kiso/aot/x86_64\";\nyobu \"kiso/runtime/gc\";\n// CPU ABI (AMD64): rdi address, rsi desired/addend, rdx expected; rax observed\n// old value. For compare-and-swap rcx additionally holds the success flag (1 on\n// success, 0 on failure); the runtime-IR lowering in program.mio returns only rax, so\n// rcx is for callers that emit this sequence directly. Other operations leave rcx unspecified.\n// The runtime IR itself only reaches fetch_add and compare_exchange here; the load, store\n// and fence forms are part of the CPU contract (gc.RuntimeOp) and are covered by byte tests.\n// x86-64 is TSO: loads are acquire and stores are release, and LOCK-prefixed\n// read-modify-write instructions are full barriers. A seq_cst store is XCHG and\n// a seq_cst fence is MFENCE; weaker fences only constrain the compiler.\nkoukai waza emit_atomic(code: x86_64.Assembler, op: gc.RuntimeOp) -> string {\n    moshi (!gc.valid_operation(op) || op.kind < gc.atomic_load || op.kind > gc.fence) { kaesu \"INVALID_RUNTIME_OP\"; }\n    moshi (op.kind == gc.atomic_load) {\n        x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 0);\n        moshi (op.order == gc.seq_cst) { x86_64.mfence(code); }\n    }\n    moshi (op.kind == gc.atomic_store) {\n        moshi (op.order == gc.seq_cst) { x86_64.xchg_store(code, x86_64.rdi, x86_64.rsi); }\n        sore { x86_64.mov_store(code, x86_64.rdi, 0, x86_64.rsi); }\n    }\n    moshi (op.kind == gc.atomic_add) {\n        x86_64.mov_rr(code, x86_64.rax, x86_64.rsi);\n        x86_64.lock_xadd(code, x86_64.rdi, x86_64.rax);\n    }\n    moshi (op.kind == gc.atomic_cas) {\n        x86_64.mov_rr(code, x86_64.rax, x86_64.rdx);\n        x86_64.lock_cmpxchg(code, x86_64.rdi, x86_64.rsi);\n        x86_64.setcc_rcx(code, x86_64.cc_e);\n    }\n    moshi (op.kind == gc.fence) { moshi (op.order == gc.seq_cst) { x86_64.mfence(code); } }\n    kaesu \"\";\n}\n\n// Public native ABI import call (System V): arguments are already in\n// rdi,rsi,rdx,rcx,r8,r9; the table base is `table` and slots are 8 bytes.\nkoukai waza emit_import_call(code: x86_64.Assembler, table: int64, slot: int64, slots: int64) -> string {\n    moshi (table < 0 || table > 15 || table == 4 || slot < 0 || slot >= slots || slots < 1 || slots > 4096) { kaesu \"INVALID_IMPORT_CALL\"; }\n    x86_64.call_memory(code, table, slot * 8);\n    kaesu \"\";\n}\n" }; }
waza data_80() -> File { kaesu File { path: "kiso/runtime/cpu/amd64/program.mio", version: "Bunko-v2.1.1", length: 12558, sha256: "4715aaa4c3b471eb2980162599a8937ac7673233e5d1b548ec7ac4a8d0b2d73e", source: "yobu \"kiso/runtime/ir\";\nyobu \"kiso/string\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/runtime/gc\";\nyobu \"kiso/convert\";\n// Native scalar ABI (AMD64): arguments in rdi,rsi,rdx,rcx,r8,r9,r10 (virtual\n// registers 0..6), import table in r11, result in rax. Every function preserves\n// rbx (it holds the import table) and stays 16-byte aligned for System V calls.\n// All virtual values live in a 320-byte frame: 32 spill words, then 64 bytes of\n// scratch. CPU lowering owns registers, instruction choices, stack and code\n// addresses; the IR never names any of them. udiv by zero yields 0 (as AArch64).\n//\n// Validation. ir.valid_step guarantees, for every step: kind in the range this file lowers,\n// destination/left/right and every argument < 32 virtual registers, load/store/address\n// immediates in 0..32760 (multiples of 8), scratch_address in 0..56 (multiples of 8), at most\n// seven arguments (the seventh travels in r10), and a non-empty name for label/jump/zero/\n// nonzero/invoke/function_address. validate() adds what the IR cannot know: the step kinds this\n// lowering implements, reserved names, label/function resolution, atomic orders and the System V\n// limit of six register arguments for OS calls. Nothing is emitted unless the whole program is valid,\n// and any error the encoder records while emitting (for example an out-of-range immediate) is returned.\n//\n// Label namespaces. Function entries are `<prefix>_<function>`. Every label inside a function is\n// `<prefix>.<length of function name>.<function>.<label>`, which cannot collide with an entry label\n// (third character differs) nor with another function's labels (the length delimits the name).\n// Labels starting with \"__\" are reserved for the lowering itself (`__epilogue`, `__div_*`).\n// The highest ir step kind this file knows how to lower (ir.scratch_address at the time of writing).\n// Hard-coded on purpose: if the IR grows a new kind, programs using it are rejected, not mis-lowered.\nteisu lowered_last_kind = 25;\n\nwaza ir_name(prefix: string, name: string) -> string { kaesu string.concat(prefix, string.concat(\"_\", name)); }\nwaza local_label(prefix: string, function: string, label: string) -> string {\n    kaesu string.concat(prefix, string.concat(\".\", string.concat(convert.format_int(len(string.to_bytes(function))), string.concat(\".\", string.concat(function, string.concat(\".\", label))))));\n}\nwaza reserved_name(name: string) -> bool { kaesu string.has_prefix(name, \"__\"); }\nwaza ir_read(c: x86_64.Assembler, virtual: int64, r: int64) -> unit { x86_64.mov_load(c, r, x86_64.rsp, virtual * 8); }\nwaza ir_write(c: x86_64.Assembler, virtual: int64, r: int64) -> unit { x86_64.mov_store(c, x86_64.rsp, virtual * 8, r); }\nwaza argument_register(index: int64) -> int64 {\n    moshi (index == 0) { kaesu x86_64.rdi; } moshi (index == 1) { kaesu x86_64.rsi; }\n    moshi (index == 2) { kaesu x86_64.rdx; } moshi (index == 3) { kaesu x86_64.rcx; }\n    moshi (index == 4) { kaesu x86_64.r8; } moshi (index == 5) { kaesu x86_64.r9; }\n    kaesu x86_64.r10;\n}\nwaza validate(functions: []ir.Function, bindings: []ir.Binding, slots: int64) -> string {\n    kaku fi = 0;\n    aida (fi < len(functions)) {\n        kaku f = functions[fi]; moshi (f.name == \"\") { kaesu \"INVALID_RUNTIME_FUNCTION\"; }\n        kaku j = 0; aida (j < fi) { moshi (functions[j].name == f.name) { kaesu \"DUPLICATE_RUNTIME_FUNCTION\"; } j = j + 1; }\n        kaku si = 0;\n        aida (si < len(f.steps)) {\n            kaku s = f.steps[si];\n            moshi (s.kind < ir.constant || s.kind > lowered_last_kind) { kaesu \"UNSUPPORTED_RUNTIME_STEP\"; }\n            moshi (!ir.valid_step(s)) { kaesu \"INVALID_RUNTIME_STEP\"; }\n            moshi (s.kind == ir.label) {\n                moshi (reserved_name(s.name)) { kaesu \"RESERVED_RUNTIME_LABEL\"; }\n                j = 0; aida (j < si) { moshi (f.steps[j].kind == ir.label && f.steps[j].name == s.name) { kaesu \"DUPLICATE_RUNTIME_LABEL\"; } j = j + 1; }\n            }\n            moshi (s.kind == ir.compare_exchange && len(s.arguments) != 1) { kaesu \"INVALID_CAS_ARGUMENT\"; }\n            moshi (s.kind == ir.fetch_add || s.kind == ir.compare_exchange) {\n                kaku operation = gc.atomic_add; moshi (s.kind == ir.compare_exchange) { operation = gc.atomic_cas; }\n                moshi (!gc.valid_operation(gc.RuntimeOp { kind: operation, address: 0, value: 1, expected: 2, result: 3, status: 4, order: s.order, failure_order: s.failure_order, alignment: 8, epoch: 0 })) { kaesu \"INVALID_RUNTIME_ATOMIC_ORDER\"; }\n            }\n            moshi (s.kind == ir.system) {\n                kaku found = iie; j = 0;\n                aida (j < len(bindings)) {\n                    kaku b = bindings[j];\n                    moshi (b.operation == s.immediate) {\n                        moshi (found || b.slot < 0 || b.slot >= slots || len(b.arguments) > 6 || (b.result_bits != 32 && b.result_bits != 64)) { kaesu \"INVALID_RUNTIME_BINDING\"; }\n                        found = hai; kaku a = 0;\n                        aida (a < len(b.arguments)) { moshi (b.arguments[a] >= len(s.arguments) || b.arguments[a] < -65536) { kaesu \"INVALID_RUNTIME_ARGUMENT\"; } a = a + 1; }\n                    }\n                    j = j + 1;\n                }\n                moshi (!found) { kaesu \"NOT_SUPPORTED_RUNTIME_OPERATION\"; }\n            }\n            moshi (s.kind == ir.invoke || s.kind == ir.function_address) {\n                kaku found = iie; j = 0; aida (j < len(functions)) { moshi (functions[j].name == s.name) { found = hai; } j = j + 1; }\n                moshi (!found) { kaesu \"UNDEFINED_RUNTIME_FUNCTION\"; }\n            }\n            moshi (s.kind == ir.jump || s.kind == ir.zero || s.kind == ir.nonzero) {\n                kaku found = iie; j = 0; aida (j < len(f.steps)) { moshi (f.steps[j].kind == ir.label && f.steps[j].name == s.name) { found = hai; } j = j + 1; }\n                moshi (!found) { kaesu \"UNDEFINED_RUNTIME_LABEL\"; }\n            }\n            si = si + 1;\n        }\n        fi = fi + 1;\n    }\n    kaesu \"\";\n}\nkoukai waza emit_program(c: x86_64.Assembler, functions: []ir.Function, bindings: []ir.Binding, slots: int64, prefix: string) -> string {\n    kaku problem = validate(functions, bindings, slots); moshi (problem != \"\") { kaesu problem; }\n    kaku fi = 0;\n    aida (fi < len(functions)) {\n        kaku f = functions[fi];\n        x86_64.label(c, ir_name(prefix, f.name));\n        x86_64.push_r(c, x86_64.rbx); x86_64.sub_ri(c, x86_64.rsp, 320); x86_64.mov_rr(c, x86_64.rbx, x86_64.r11);\n        kaku i = 0;\n        aida (i < 7) { ir_write(c, i, argument_register(i)); i = i + 1; }\n        x86_64.xor_rr(c, x86_64.rax, x86_64.rax);\n        aida (i < 32) { ir_write(c, i, x86_64.rax); i = i + 1; }\n        i = 0;\n        aida (i < len(f.steps)) {\n            kaku s = f.steps[i]; kaku kind = s.kind;\n            moshi (kind == ir.constant) { x86_64.mov_ri(c, x86_64.rax, s.immediate); ir_write(c, s.destination, x86_64.rax); }\n            moshi (kind == ir.copy) { ir_read(c, s.left, x86_64.rax); ir_write(c, s.destination, x86_64.rax); }\n            moshi (kind == ir.address || kind == ir.load || kind == ir.store || kind == ir.acquire_load || kind == ir.release_store) {\n                ir_read(c, s.left, x86_64.rax); x86_64.add_ri(c, x86_64.rax, s.immediate);\n                moshi (kind == ir.address) { ir_write(c, s.destination, x86_64.rax); }\n                moshi (kind == ir.load || kind == ir.acquire_load) { x86_64.mov_load(c, x86_64.rcx, x86_64.rax, 0); ir_write(c, s.destination, x86_64.rcx); }\n                moshi (kind == ir.store || kind == ir.release_store) { ir_read(c, s.right, x86_64.rcx); x86_64.mov_store(c, x86_64.rax, 0, x86_64.rcx); }\n            }\n            moshi (kind >= ir.add && kind <= ir.less_unsigned) {\n                ir_read(c, s.left, x86_64.rax); ir_read(c, s.right, x86_64.rcx);\n                moshi (kind == ir.add) { x86_64.add_rr(c, x86_64.rax, x86_64.rcx); }\n                moshi (kind == ir.subtract) { x86_64.sub_rr(c, x86_64.rax, x86_64.rcx); }\n                moshi (kind == ir.multiply) { x86_64.imul_rr(c, x86_64.rax, x86_64.rcx); }\n                moshi (kind == ir.divide_unsigned) {\n                    kaku skip = local_label(prefix, f.name, string.concat(\"__div_zero_\", convert.format_int(len(c.bytes))));\n                    kaku done = local_label(prefix, f.name, string.concat(\"__div_done_\", convert.format_int(len(c.bytes))));\n                    x86_64.test_rr(c, x86_64.rcx, x86_64.rcx); x86_64.jcc(c, x86_64.cc_e, skip);\n                    x86_64.xor_rr(c, x86_64.rdx, x86_64.rdx); x86_64.div_r(c, x86_64.rcx); x86_64.jmp(c, done);\n                    x86_64.label(c, skip); x86_64.xor_rr(c, x86_64.rax, x86_64.rax); x86_64.label(c, done);\n                }\n                moshi (kind == ir.equal) { x86_64.cmp_rr(c, x86_64.rax, x86_64.rcx); x86_64.setcc_rax(c, x86_64.cc_e); }\n                moshi (kind == ir.less_unsigned) { x86_64.cmp_rr(c, x86_64.rax, x86_64.rcx); x86_64.setcc_rax(c, x86_64.cc_b); }\n                ir_write(c, s.destination, x86_64.rax);\n            }\n            moshi (kind == ir.label) { x86_64.label(c, local_label(prefix, f.name, s.name)); }\n            moshi (kind == ir.jump) { x86_64.jmp(c, local_label(prefix, f.name, s.name)); }\n            moshi (kind == ir.zero || kind == ir.nonzero) {\n                ir_read(c, s.left, x86_64.rax); x86_64.test_rr(c, x86_64.rax, x86_64.rax);\n                moshi (kind == ir.zero) { x86_64.jcc(c, x86_64.cc_e, local_label(prefix, f.name, s.name)); }\n                sore { x86_64.jcc(c, x86_64.cc_ne, local_label(prefix, f.name, s.name)); }\n            }\n            moshi (kind == ir.system) {\n                kaku bi = 0;\n                aida (bi < len(bindings)) {\n                    kaku b = bindings[bi];\n                    moshi (b.operation == s.immediate) {\n                        kaku ai = 0;\n                        aida (ai < len(b.arguments)) {\n                            kaku selector = b.arguments[ai];\n                            moshi (selector < 0) { x86_64.mov_ri(c, argument_register(ai), -selector - 1); }\n                            sore { ir_read(c, s.arguments[selector], argument_register(ai)); }\n                            ai = ai + 1;\n                        }\n                        kaku failure = emit_import_call(c, x86_64.rbx, b.slot, slots); moshi (failure != \"\") { kaesu failure; }\n                        moshi (b.result_bits == 32) { x86_64.zero_extend_eax(c); }\n                    }\n                    bi = bi + 1;\n                }\n                ir_write(c, s.destination, x86_64.rax);\n            }\n            moshi (kind == ir.invoke) {\n                kaku ai = 0; aida (ai < len(s.arguments)) { ir_read(c, s.arguments[ai], argument_register(ai)); ai = ai + 1; }\n                x86_64.mov_rr(c, x86_64.r11, x86_64.rbx); x86_64.call(c, ir_name(prefix, s.name)); ir_write(c, s.destination, x86_64.rax);\n            }\n            moshi (kind == ir.function_address) { x86_64.lea_label(c, x86_64.rax, ir_name(prefix, s.name)); ir_write(c, s.destination, x86_64.rax); }\n            moshi (kind == ir.imports) { ir_read(c, s.left, x86_64.rbx); }\n            moshi (kind == ir.scratch_address) { x86_64.lea(c, x86_64.rax, x86_64.rsp, 256 + s.immediate); ir_write(c, s.destination, x86_64.rax); }\n            moshi (kind == ir.fetch_add || kind == ir.compare_exchange) {\n                ir_read(c, s.left, x86_64.rdi); ir_read(c, s.right, x86_64.rsi);\n                moshi (kind == ir.compare_exchange) { ir_read(c, s.arguments[0], x86_64.rdx); }\n                kaku atomic_kind = gc.atomic_add; moshi (kind == ir.compare_exchange) { atomic_kind = gc.atomic_cas; }\n                kaku error = emit_atomic(c, gc.RuntimeOp { kind: atomic_kind, address: 0, value: 1, expected: 2, result: 3, status: 4, order: s.order, failure_order: s.failure_order, alignment: 8, epoch: 0 });\n                moshi (error != \"\") { kaesu error; }\n                ir_write(c, s.destination, x86_64.rax);\n            }\n            moshi (kind == ir.result) { ir_read(c, s.left, x86_64.rax); x86_64.jmp(c, local_label(prefix, f.name, \"__epilogue\")); }\n            i = i + 1;\n        }\n        x86_64.xor_rr(c, x86_64.rax, x86_64.rax);\n        x86_64.label(c, local_label(prefix, f.name, \"__epilogue\"));\n        x86_64.add_ri(c, x86_64.rsp, 320); x86_64.pop_r(c, x86_64.rbx); x86_64.ret(c);\n        fi = fi + 1;\n    }\n    // Surface anything the encoder recorded (out-of-range immediate or register, duplicate label ...).\n    moshi (len(c.errors) > 0) { kaesu c.errors[0]; }\n    kaesu \"\";\n}\n" }; }
waza data_81() -> File { kaesu File { path: "kiso/runtime/gc/layout.mio", version: "Bunko-v2.1.1", length: 752, sha256: "cbeb5eb9db2949de0e2b51104a7c079d0607e0a6f02af902ec4c5bcfd6233b0d", source: "// Frozen M19b/c object ABI v1. No target page size or machine ABI lives here.\nkoukai teisu layout_version = 1;\nkoukai teisu header_bytes = 16;\nkoukai teisu object_alignment = 16;\nkoukai teisu metadata_bytes = 3072;\nkoukai teisu default_los_threshold = 131072;\nkoukai teisu side_entry_bytes = 16;\nkoukai teisu young_head = 1048;\nkoukai teisu remembered_head = 1056;\nkoukai teisu collection_mode = 1064;\nkoukai teisu promotion_threshold = 1072;\nkoukai teisu minor_count = 1080;\nkoukai teisu major_count = 1088;\nkoukai teisu los_head = 2560;\nkoukai teisu los_bytes = 2568;\nkoukai teisu los_reclaimed = 2576;\nkoukai teisu los_count = 2584;\nkoukai teisu los_threshold = 2592;\nkoukai teisu minimum_promotion_age = 2;\nkoukai teisu maximum_promotion_age = 8;\n" }; }
waza data_82() -> File { kaesu File { path: "kiso/runtime/gc/mutators.mio", version: "Bunko-v2.1.1", length: 4796, sha256: "6f1c3d12fc9fbac2500358514e1c98dca22dccef2f69193bc552e9551850c7c5", source: "// Compiler-facing managed mutator protocol, expressed only in neutral IR.\n// A heap operation owns its stopped epoch through initialization/publication;\n// the next solved opcode boundary releases it before ordinary execution polls.\nwaza gc_heap_enter_program() -> ir.Function {\n    kaku f=ir.function(\"gc_heap_enter\");tprepare(f);ir.put(f,ir.release_store,0,0,1,thread_shadow);\n    tload(f,10,thread_registry);ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.put(f,ir.equal,12,11,0,0);ir.branch(f,ir.nonzero,12,\"owned\");\n    ir.invoke_function(f,\"gc_begin\",2,[0,1]);ir.put(f,ir.result,0,2,0,0);\n    ir.branch(f,ir.label,0,\"owned\");treturn(f,0);kaesu f;\n}\nwaza gc_mutator_poll_program() -> ir.Function {\n    kaku f=ir.function(\"gc_mutator_poll\");tprepare(f);ir.put(f,ir.release_store,0,0,1,thread_shadow);\n    tload(f,10,thread_registry);ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.put(f,ir.equal,12,11,0,0);ir.branch(f,ir.zero,12,\"poll\");\n    ir.invoke_function(f,\"gc_end\",2,[0]);ir.branch(f,ir.nonzero,2,\"failed\");\n    ir.branch(f,ir.label,0,\"poll\");ir.invoke_function(f,\"gc_poll\",2,[0,1]);\n    ir.branch(f,ir.label,0,\"failed\");ir.put(f,ir.result,0,2,0,0);kaesu f;\n}\nwaza gc_block_enter_program() -> ir.Function {\n    kaku f=ir.function(\"gc_block_enter\");tprepare(f);ir.invoke_function(f,\"gc_mutator_poll\",2,[0,1]);ir.branch(f,ir.nonzero,2,\"fatal\");\n    tload(f,3,thread_mutex);ir.call(f,ir.mutex_lock,2,[3]);ir.branch(f,ir.nonzero,2,\"fatal\");\n    ir.invoke_function(f,\"gc_park_locked\",2,[0]);tpublish(f,thread_progress,thread_parked);ir.call(f,ir.mutex_unlock,2,[3]);ir.branch(f,ir.nonzero,2,\"fatal\");treturn(f,0);\n    ir.branch(f,ir.label,0,\"fatal\");tconstant(f,2,83);ir.call(f,abort_runtime,3,[2]);treturn(f,3);kaesu f;\n}\nwaza gc_block_leave_program() -> ir.Function {\n    kaku f=ir.function(\"gc_block_leave\");tprepare(f);tload(f,3,thread_mutex);ir.call(f,ir.mutex_lock,2,[3]);ir.branch(f,ir.nonzero,2,\"fatal\");\n    ir.invoke_function(f,\"gc_park_locked\",2,[0]);tpublish(f,thread_progress,thread_at_work);ir.call(f,ir.mutex_unlock,2,[3]);ir.branch(f,ir.nonzero,2,\"fatal\");treturn(f,0);\n    ir.branch(f,ir.label,0,\"fatal\");tconstant(f,2,84);ir.call(f,abort_runtime,3,[2]);treturn(f,3);kaesu f;\n}\nwaza thread_wait_started_program() -> ir.Function {\n    kaku f=ir.function(\"thread_wait_started\");tprepare(f);tload(f,2,thread_mutex);ir.call(f,ir.mutex_lock,1,[2]);ir.branch(f,ir.nonzero,1,\"failed_lock\");\n    ir.invoke_function(f,\"platform_now\",5,[]);tconstant(f,6,1000000000);ir.put(f,ir.add,5,5,6,0);\n    ir.branch(f,ir.label,0,\"retry\");ir.put(f,ir.acquire_load,3,0,0,thread_state);tcheck(f,3,thread_running,\"ready\");tcheck(f,3,thread_exited,\"ready\");tcheck(f,3,thread_failed,\"failed\");\n    ir.invoke_function(f,\"platform_now\",6,[]);ir.put(f,ir.less_unsigned,7,6,5,0);ir.branch(f,ir.zero,7,\"failed\");\n    tload(f,3,thread_condition);tconstant(f,4,10000000);ir.invoke_function(f,\"platform_wait\",6,[3,2,4]);ir.branch(f,ir.zero,6,\"retry\");tcheck(f,6,1,\"retry\");\n    ir.branch(f,ir.label,0,\"failed\");tconstant(f,8,2);ir.branch(f,ir.jump,0,\"unlock\");\n    ir.branch(f,ir.label,0,\"ready\");tload(f,8,thread_error);\n    ir.branch(f,ir.label,0,\"unlock\");ir.call(f,ir.mutex_unlock,1,[2]);ir.branch(f,ir.nonzero,1,\"failed_lock\");ir.put(f,ir.result,0,8,0,0);\n    ir.branch(f,ir.label,0,\"failed_lock\");treturn(f,2);kaesu f;\n}\n// High-level join waits for natural user completion before thread_close's\n// bounded stop/cleanup protocol. Joining must not cancel ordinary user waits.\nwaza thread_wait_completion_program() -> ir.Function {\n    kaku f=ir.function(\"thread_wait_completion\");tprepare(f);tload(f,2,thread_mutex);ir.call(f,ir.mutex_lock,1,[2]);ir.branch(f,ir.nonzero,1,\"failed_lock\");\n    ir.invoke_function(f,\"platform_now\",5,[]);tconstant(f,6,30000000000);ir.put(f,ir.add,5,5,6,0);\n    ir.branch(f,ir.label,0,\"retry\");ir.put(f,ir.acquire_load,3,0,0,thread_progress);tcheck(f,3,thread_finished,\"ready\");\n    ir.invoke_function(f,\"platform_now\",6,[]);ir.put(f,ir.less_unsigned,7,6,5,0);ir.branch(f,ir.zero,7,\"failed\");\n    tload(f,3,thread_condition);tconstant(f,4,10000000);ir.invoke_function(f,\"platform_wait\",6,[3,2,4]);ir.branch(f,ir.zero,6,\"retry\");tcheck(f,6,1,\"retry\");\n    ir.branch(f,ir.label,0,\"failed\");tconstant(f,8,2);ir.branch(f,ir.jump,0,\"unlock\");\n    ir.branch(f,ir.label,0,\"ready\");tload(f,8,thread_error);\n    ir.branch(f,ir.label,0,\"unlock\");ir.call(f,ir.mutex_unlock,1,[2]);ir.branch(f,ir.nonzero,1,\"failed_lock\");ir.put(f,ir.result,0,8,0,0);\n    ir.branch(f,ir.label,0,\"failed_lock\");treturn(f,2);kaesu f;\n}\nkoukai waza mutator_program() -> []ir.Function {\n    kaesu [gc_heap_enter_program(),gc_mutator_poll_program(),gc_block_enter_program(),gc_block_leave_program(),thread_wait_started_program(),thread_wait_completion_program(),memory_snapshot_program()];\n}\n" }; }
waza data_83() -> File { kaesu File { path: "kiso/runtime/gc/observations.mio", version: "Bunko-v2.1.1", length: 3319, sha256: "efd7032f1e8e4b6be34e983b5f906c80197a36b92e58d7976e278c3f83592c02", source: "yobu \"kiso/runtime/ir\";\n// M19c snapshot ABI v1: level, reason, used, committed, limit, rate,\n// gcActive, sequence. These are architecture-neutral 64-bit metadata slots.\n// The old raw memory.snapshot leaf is a single-thread / externally-owned ABI;\n// its plain sequence does not synchronize readers with writers.\nkoukai teisu memory_snapshot_words=8;\nkoukai teisu memory_snapshot_bytes=64;\n// ctx, precise shadow, heap, private aligned 64-byte destination, and a\n// separate aligned availability-word destination (0 Unknown, nonzero Known).\n// Availability is copied under the SAME protection/version as the eight fields;\n// the legacy eight-field layout remains unchanged. Neither buffer may alias\n// the heap, context or another thread's mutable storage.\n// All producers hold gc_heap_enter's ownership or the shared Sweep lock.\n// Acquiring BOTH through gc_heap_enter makes this copy coherent. Nested callers\n// keep their existing owned epoch; newly acquired ownership is released.\n// Invalid arguments do not touch the destination or ownership. An invariant\n// failure after acquisition retains ownership for the existing fatal protocol;\n// the caller must not use a partial destination or resume arbitrary heap work.\nwaza memory_snapshot_program() -> ir.Function {\n kaku f=ir.function(\"gc_memory_snapshot\");\n ir.branch(f,ir.zero,0,\"invalid\");ir.branch(f,ir.zero,2,\"invalid\");ir.branch(f,ir.zero,3,\"invalid\");ir.branch(f,ir.zero,4,\"invalid\");\n tconstant(f,6,8);ir.put(f,ir.divide_unsigned,5,3,6,0);ir.put(f,ir.multiply,5,5,6,0);ir.put(f,ir.equal,5,5,3,0);ir.branch(f,ir.zero,5,\"invalid\");\n tconstant(f,6,8);ir.put(f,ir.divide_unsigned,5,4,6,0);ir.put(f,ir.multiply,5,5,6,0);ir.put(f,ir.equal,5,5,4,0);ir.branch(f,ir.zero,5,\"invalid\");\n tload(f,5,thread_version);tconstant(f,6,3);ir.put(f,ir.equal,5,5,6,0);ir.branch(f,ir.zero,5,\"invalid\");\n tload(f,5,thread_registered);tconstant(f,6,1);ir.put(f,ir.equal,5,5,6,0);ir.branch(f,ir.zero,5,\"invalid\");\n tprepare(f);tload(f,10,thread_registry);ir.branch(f,ir.zero,10,\"invalid\");ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.put(f,ir.equal,22,11,0,0);\n ir.invoke_function(f,\"gc_heap_enter\",5,[0,1]);ir.branch(f,ir.nonzero,5,\"failed\");\n ir.put(f,ir.acquire_load,11,10,0,gc_registry_owner);ir.put(f,ir.equal,12,11,0,0);ir.branch(f,ir.zero,12,\"invalid_owned\");\n ir.put(f,ir.acquire_load,11,10,0,gc_registry_phase);tconstant(f,12,gc_stopped);ir.put(f,ir.equal,12,11,12,0);ir.branch(f,ir.zero,12,\"invalid_owned\");\n ir.put(f,ir.acquire_load,23,2,0,2656);tconstant(f,6,2);ir.put(f,ir.divide_unsigned,5,23,6,0);ir.put(f,ir.multiply,5,5,6,0);ir.put(f,ir.equal,5,5,23,0);ir.branch(f,ir.zero,5,\"invalid_owned\");\n ir.put(f,ir.load,25,2,0,2752);\n kaku offsets=[2640,2648,2760,2616,2608,2632,2664,2656];kaku i=0;\n aida(i<len(offsets)){ir.put(f,ir.load,24,2,0,offsets[i]);ir.put(f,ir.store,0,3,24,i*8);i=i+1;}\n ir.put(f,ir.acquire_load,24,2,0,2656);ir.put(f,ir.equal,5,23,24,0);ir.branch(f,ir.zero,5,\"invalid_owned\");\n ir.put(f,ir.store,0,4,25,0);\n ir.branch(f,ir.nonzero,22,\"owned\");ir.invoke_function(f,\"gc_end\",5,[0]);ir.put(f,ir.result,0,5,0,0);\n ir.branch(f,ir.label,0,\"owned\");treturn(f,0);\n ir.branch(f,ir.label,0,\"invalid_owned\");treturn(f,4);\n ir.branch(f,ir.label,0,\"invalid\");treturn(f,4);\n ir.branch(f,ir.label,0,\"failed\");ir.put(f,ir.result,0,5,0,0);kaesu f;\n}\n" }; }
waza data_84() -> File { kaesu File { path: "kiso/runtime/gc/old_bulk.mio", version: "Bunko-v2.1.1", length: 3337, sha256: "f76f0e3ebd5eea10099c729ebdd0dc611264e73cfeb0c1b4b1b32e11c05c7fc7", source: "// Reference bulk operations, under native validation. Caller owns both mapped slot\n// ranges and supplies their checked byte count. These helpers perform no\n// allocation and never interpret numeric slots: the compiler/layout gate\n// selects them only for reference storage. Count/alignment/overflow failures\n// Abort/join before returning an error, without authorizing reclamation.\nwaza old_bulk_aligned(f:ir.Function,value:int64) -> unit {\n tconstant(f,28,8);ir.put(f,ir.divide_unsigned,29,value,28,0);\n ir.put(f,ir.multiply,29,29,28,0);ir.put(f,ir.equal,29,29,value,0);\n ir.branch(f,ir.zero,29,\"invalid\");\n}\nwaza old_bulk_error(f:ir.Function) -> unit {\n ir.branch(f,ir.label,0,\"invalid\");ir.branch(f,ir.zero,0,\"bad_result\");\n tconstant(f,5,4);old_error(f,5);ir.invoke_function(f,\"gc_old_abort_join\",5,[0]);\n ir.branch(f,ir.label,0,\"bad_result\");treturn(f,4);\n}\nwaza old_bulk_copy_program() -> ir.Function {\n // ctx(optional0), destination, source, bytes. Preserve memmove semantics.\n kaku f=ir.function(\"gc_copy_reference_slots\");\n ir.branch(f,ir.zero,3,\"done\");ir.branch(f,ir.zero,1,\"invalid\");ir.branch(f,ir.zero,2,\"invalid\");\n old_bulk_aligned(f,1);old_bulk_aligned(f,2);old_bulk_aligned(f,3);\n ir.put(f,ir.add,13,2,3,0);ir.put(f,ir.less_unsigned,16,13,2,0);ir.branch(f,ir.nonzero,16,\"invalid\");\n ir.put(f,ir.add,14,1,3,0);ir.put(f,ir.less_unsigned,16,14,1,0);ir.branch(f,ir.nonzero,16,\"invalid\");\n tconstant(f,12,8);tconstant(f,15,0);\n ir.put(f,ir.less_unsigned,16,2,1,0);ir.branch(f,ir.zero,16,\"copy\");\n ir.put(f,ir.less_unsigned,16,1,13,0);ir.branch(f,ir.zero,16,\"copy\");\n tconstant(f,15,1);ir.put(f,ir.subtract,1,14,12,0);ir.put(f,ir.subtract,2,13,12,0);\n ir.branch(f,ir.label,0,\"copy\");ir.put(f,ir.acquire_load,10,2,0,0);\n ir.branch(f,ir.zero,0,\"store\");ir.invoke_function(f,\"gc_old_prewrite\",5,[0,1]);ir.branch(f,ir.nonzero,5,\"failed\");\n ir.branch(f,ir.label,0,\"store\");ir.put(f,ir.release_store,0,1,10,0);\n ir.put(f,ir.subtract,3,3,12,0);ir.branch(f,ir.zero,3,\"done\");\n ir.branch(f,ir.zero,15,\"forward\");ir.put(f,ir.subtract,1,1,12,0);ir.put(f,ir.subtract,2,2,12,0);ir.branch(f,ir.jump,0,\"copy\");\n ir.branch(f,ir.label,0,\"forward\");ir.put(f,ir.add,1,1,12,0);ir.put(f,ir.add,2,2,12,0);ir.branch(f,ir.jump,0,\"copy\");\n ir.branch(f,ir.label,0,\"failed\");ir.put(f,ir.result,0,5,0,0);\n ir.branch(f,ir.label,0,\"done\");treturn(f,0);old_bulk_error(f);kaesu f;\n}\nwaza old_bulk_clear_program() -> ir.Function {\n // ctx(optional0), destination, bytes. Every dropped pointer is published\n // before its full aligned word is cleared; no torn byte stores are allowed.\n kaku f=ir.function(\"gc_clear_reference_slots\");\n ir.branch(f,ir.zero,2,\"done\");ir.branch(f,ir.zero,1,\"invalid\");old_bulk_aligned(f,1);old_bulk_aligned(f,2);tconstant(f,12,8);\n ir.put(f,ir.add,13,1,2,0);ir.put(f,ir.less_unsigned,16,13,1,0);ir.branch(f,ir.nonzero,16,\"invalid\");\n ir.branch(f,ir.label,0,\"clear\");ir.branch(f,ir.zero,0,\"store\");ir.invoke_function(f,\"gc_old_prewrite\",5,[0,1]);ir.branch(f,ir.nonzero,5,\"failed\");\n ir.branch(f,ir.label,0,\"store\");tconstant(f,10,0);ir.put(f,ir.release_store,0,1,10,0);\n ir.put(f,ir.subtract,2,2,12,0);ir.branch(f,ir.zero,2,\"done\");ir.put(f,ir.add,1,1,12,0);ir.branch(f,ir.jump,0,\"clear\");\n ir.branch(f,ir.label,0,\"failed\");ir.put(f,ir.result,0,5,0,0);\n ir.branch(f,ir.label,0,\"done\");treturn(f,0);old_bulk_error(f);kaesu f;\n}\n" }; }
waza data_85() -> File { kaesu File { path: "kiso/runtime/gc/old_mark.mio", version: "Bunko-v2.1.1", length: 23638, sha256: "39176ee949c3886283b3712fa8509ebe21a1c440c99bd23ece4668175f086d47", source: "// Experimental Old marker with real exact roots, typed SATB and an independent\n// worker. Allocation/Minor require old_heap_epoch_program plus pause/promotion\n// hooks; unsupported writes/Major Abort/join. Full E4 gates remain unfinished.\n// Work queue0..127. heap128,current136,phase144,scanSeq152,scanned160,\n// scanFirst168,scanLast176,done184,error192,identity200,overlap208,\n// overlapFirst216,overlapLast224,handle232,nativeError240,imports248,\n// registry256,white264,black272,joined280,deadline288,worldResumed296,starts304,joins312.\n// Deferred bit42/outstanding104; extension416; SATB424/432/440; pauseRequest448/ack456/released464,\n// pauseCount472,Minor480,promoted488,nestedPauseDepth496.\nkoukai teisu old_color_bit=2199023255552;\nkoukai teisu old_generation_bit=34359738368;\nkoukai teisu old_control_bytes=512;\nkoukai teisu old_mark_extension_version=5;\nkoukai teisu old_phase_init=1;\nkoukai teisu old_phase_mark=2;\nkoukai teisu old_phase_remark=3;\nkoukai teisu old_phase_ready=4;\nkoukai teisu old_phase_abort=6;\n// Clock failure/overflow cannot extend a bounded wait or produce fake trace\n// timestamps. Virtual30/31 are private scratch at all call sites.\nwaza old_deadline(f:ir.Function,destination:int64,nanoseconds:int64,failure:string) -> unit {\n ir.invoke_function(f,\"platform_now\",destination,[]);ir.branch(f,ir.zero,destination,failure);ir.put(f,ir.copy,30,destination,0,0);tconstant(f,31,nanoseconds);ir.put(f,ir.add,destination,destination,31,0);ir.put(f,ir.less_unsigned,31,destination,30,0);ir.branch(f,ir.nonzero,31,failure);\n}\nwaza old_bit(f:ir.Function,src:int64,dst:int64,mask:int64) -> unit {\n tconstant(f,28,mask);ir.put(f,ir.divide_unsigned,dst,src,28,0);tconstant(f,28,2);ir.put(f,ir.divide_unsigned,29,dst,28,0);ir.put(f,ir.multiply,29,29,28,0);ir.put(f,ir.subtract,dst,dst,29,0);\n}\nwaza old_error(f:ir.Function,src:int64) -> unit {\n ir.put(f,ir.address,26,0,0,192);tconstant(f,27,0);array.push(f.steps,ir.Step {kind:ir.compare_exchange,destination:25,left:26,right:src,immediate:0,name:\"\",arguments:[27],order:acq_rel,failure_order:acquire});tconstant(f,27,old_phase_abort);ir.put(f,ir.release_store,0,0,27,144);\n}\nwaza old_add(f:ir.Function,off:int64) -> unit {ir.put(f,ir.load,28,0,0,off);tconstant(f,29,1);ir.put(f,ir.add,28,28,29,0);ir.put(f,ir.release_store,0,0,28,off);}\nwaza old_visit_program() -> ir.Function {\n kaku f=ir.function(\"gc_old_visit\");ir.put(f,ir.acquire_load,5,0,0,144);tcheck(f,5,old_phase_abort,\"cancelled\");ir.branch(f,ir.zero,1,\"done\");tconstant(f,6,2);ir.put(f,ir.divide_unsigned,7,1,6,0);ir.put(f,ir.multiply,7,7,6,0);ir.put(f,ir.equal,7,7,1,0);ir.branch(f,ir.zero,7,\"done\");\n tconstant(f,6,16);ir.put(f,ir.less_unsigned,7,1,6,0);ir.branch(f,ir.nonzero,7,\"invalid\");ir.put(f,ir.divide_unsigned,7,1,6,0);ir.put(f,ir.multiply,7,7,6,0);ir.put(f,ir.equal,7,7,1,0);ir.branch(f,ir.zero,7,\"invalid\");ir.invoke_function(f,\"gc_old_bounds\",19,[0,1]);ir.branch(f,ir.zero,19,\"invalid\");tconstant(f,6,16);ir.put(f,ir.subtract,10,1,6,0);tconstant(f,14,0);\n ir.branch(f,ir.label,0,\"color\");ir.put(f,ir.acquire_load,11,10,0,0);old_bit(f,11,12,old_generation_bit);ir.branch(f,ir.zero,12,\"done\");old_bit(f,11,12,old_color_bit);ir.branch(f,ir.nonzero,12,\"done\");tconstant(f,12,old_color_bit);ir.put(f,ir.add,12,11,12,0);\n array.push(f.steps,ir.Step {kind:ir.compare_exchange,destination:13,left:10,right:12,immediate:0,name:\"\",arguments:[11],order:acq_rel,failure_order:acquire});ir.put(f,ir.equal,13,13,11,0);ir.branch(f,ir.nonzero,13,\"enqueue\");tconstant(f,6,1);ir.put(f,ir.add,14,14,6,0);tconstant(f,6,1024);ir.put(f,ir.less_unsigned,6,14,6,0);ir.branch(f,ir.nonzero,6,\"color\");ir.branch(f,ir.jump,0,\"invalid\");\n ir.branch(f,ir.label,0,\"enqueue\");ir.put(f,ir.load,16,0,0,112);old_