ssembler_label(code, \"runtime_array_push_byte\");\n    emit(code, arm64.add_x(11, 11, 10));\n    emit(code, arm64.strb_w(9, 11, 0));\n    arm64.assembler_label(code, \"runtime_array_push_commit\");\n    emit(code, arm64.ldr_x(11, 12, 40)); emit_gen_remember(code, 11);\n    emit(code, arm64.add_imm_x(10, 10, 1, iie));\n    emit(code, arm64.str_x(10, 12, 8));\n    emit(code, arm64.ldr_x(30, 31, 0));\n    emit(code, arm64.add_imm_x(31, 31, 32, iie));\n    emit(code, arm64.ret());\n    arm64.assembler_label(code, \"runtime_array_truncate\");\n    arm64.assembler_cbz_x(code, 0, \"runtime_error\");\n    emit(code, arm64.ldr_x(9, 0, 8));\n    emit(code, arm64.cmp_x(1, 9));\n    arm64.assembler_b_cond(code, 8, \"runtime_error\");\n    emit(code, arm64.str_x(1, 0, 8));\n    emit(code, arm64.ldr_x(10, 0, 0));\n    emit(code, arm64.lsr_x(10, 10, 8));\n    move_bits(code, 11, uint32(0), uint32(255));\n    emit(code, arm64.and_x(10, 10, 11));\n    emit(code, arm64.sub_x(2, 9, 1));\n    emit(code, arm64.mul_x(2, 2, 10));\n    emit(code, arm64.mul_x(1, 1, 10));\n    emit(code, arm64.ldr_x(11, 0, 40));\n    emit(code, arm64.add_imm_x(11, 11, 32, iie));\n    emit(code, arm64.add_x(11, 11, 1));\n    moshi(old_mark_proto_enabled(code)){\n        emit(code,arm64.ldr_x(13,0,40));emit(code,arm64.ldr_x(13,13,24));arm64.assembler_cbz_x(code,13,\"runtime_array_truncate_clear\");\n        emit(code,arm64.sub_imm_x(31,31,16,iie));emit(code,arm64.str_x(30,31,0));arm64.assembler_bl(code,\"old_bulk_clear\");emit(code,arm64.ldr_x(30,31,0));emit(code,arm64.add_imm_x(31,31,16,iie));arm64.assembler_b(code,\"runtime_array_truncate_done\");\n    }\n    arm64.assembler_label(code, \"runtime_array_truncate_clear\");\n    arm64.assembler_cbz_x(code, 2, \"runtime_array_truncate_done\");\n    emit(code, arm64.strb_w(31, 11, 0));\n    emit(code, arm64.add_imm_x(11, 11, 1, iie));\n    emit(code, arm64.sub_imm_x(2, 2, 1, iie));\n    arm64.assembler_b(code, \"runtime_array_truncate_clear\");\n    arm64.assembler_label(code, \"runtime_array_truncate_done\");\n    emit(code, arm64.ret());\n}\n\nwaza emit_managed_runtime(code: arm64.Assembler, gc_stress: bool, metadata_bytes: int64, observation: bool) -> unit {\n    emit_runtime_alloc(code, gc_stress, observation);\n    emit_runtime_collect(code, metadata_bytes, observation);\n    emit_runtime_mark(code, metadata_bytes);\n    emit_memory_adapters(code); emit_los_runtime(code); emit_gen_register(code); emit_gen_minor(code, observation); emit_gen_rebuild(code); emit_gen_adapt(code);\n    moshi (observation) { emit_observation_runtime(code, metadata_bytes); }\n    emit_array_runtime(code);\n    emit_utf8_runtime(code);\n}\n\nkoukai waza compile(file: mochi.File) -> LowerResult { kaesu compile_impl(file, iie, runtime_default_heap_bytes, iie); }\n\n// Verification mode uses the identical allocator and object protocol, collecting\n// at every allocation entry in addition to the ordinary bounded-heap retry.\nkoukai waza compile_gc_stress(file: mochi.File) -> LowerResult { kaesu compile_impl(file, hai, runtime_default_heap_bytes, iie); }\n\n// Explicit bounded target capacity; does not change the seed builder's heap.\nkoukai waza compile_with_heap(file: mochi.File, capacity: int64, gc_stress: bool) -> LowerResult {\n    kaesu compile_impl(file, gc_stress, capacity, iie);\n}\n\n// Observation is opt-in. Existing entry points keep the M18 emitted runtime.\nkoukai waza compile_with_observation(file: mochi.File, capacity: int64, gc_stress: bool) -> LowerResult {\n    kaesu compile_impl(file, gc_stress, capacity, hai);\n}\n\n// Internal automatic budget entry, no new CLI option or bootstrap protocol.\nkoukai waza compile_with_adaptive_heap(file: mochi.File, maximum: int64, gc_stress: bool, observation: bool) -> LowerResult {\n kaesu compile_memory_impl(file,gc_stress,maximum,observation,hai);\n}\nwaza compile_impl(file: mochi.File, gc_stress: bool, capacity: int64, observation: bool) -> LowerResult {\n kaesu compile_memory_impl(file,gc_stress,capacity,observation,iie);\n}\nkoukai waza compile_with_memory_budget(file: mochi.File, hard_cap: int64, gc_stress: bool, observation: bool) -> LowerResult {\n moshi (hard_cap < 114688) { kaesu failed(LowerError.InvalidOperand(1)); }\n kaku capacity=((hard_cap-65536)/3/16384)*16384;\n moshi (capacity>runtime_max_heap_bytes) { capacity=runtime_max_heap_bytes; }\n kaesu compile_memory_impl(file,gc_stress,capacity,observation,iie);\n}\nwaza instruction_error(file: mochi.File) -> LowerError? {\n    kaku function = -1;\n    aida (function < len(file.functions)) {\n        kaku data = file.instructions; moshi (function >= 0) { data = file.functions[function].instructions; }\n        kaku at = 0;\n        aida (at < len(data)) {\n            kaku opcode = int64(data[at]); kaku width = types.type_instruction_width(opcode);\n            moshi (width <= 0 || (opcode == 66 && file.version < 15) || (opcode == 67 && file.version < 16)) { kaesu LowerError.UnsupportedOpcode((function + 1) * 1000000 + at * 100 + opcode); }\n            moshi (width > len(data) - at) { kaesu LowerError.InvalidOperand((function + 1) * 1000000 + at * 100 + opcode); }\n            moshi(opcode==67 && data[at+3]>uint8(1)){kaesu LowerError.InvalidOperand((function+1)*1000000+at*100+opcode);}\n            at = at + width;\n        }\n        function = function + 1;\n    }\n    kaesu mu;\n}\nwaza compile_memory_impl(input_file: mochi.File, gc_stress: bool, capacity: int64, observation: bool, adaptive: bool) -> LowerResult {\n    kaesu compile_roots_impl(input_file,gc_stress,capacity,observation,adaptive,iie);\n}\n// Internal E3 integration path. Link with darwin.executable_appended using\n// thread_symbols() and attached_root_words; no language/API thread support is\n// implied. Legacy compile entry points preserve their emitted ABI and bytes.\nkoukai waza compile_with_attached_roots(file:mochi.File,capacity:int64,gc_stress:bool) -> LowerResult {\n    kaesu compile_roots_impl(file,gc_stress,capacity,iie,iie,hai);\n}\nwaza compile_roots_impl(input_file: mochi.File, gc_stress: bool, capacity: int64, observation: bool, adaptive: bool, attached:bool) -> LowerResult {\n    kaesu compile_worker_impl(input_file,gc_stress,capacity,observation,adaptive,attached,[],iie,32768,iie,iie);\n}\n// Internal native startup bridge: explicit function IDs for start, join, wait,\n// collect. Ordinary user closures still use normal solved native codegen; no\n// user Root API is involved. This is not an enabled concurrent Old collector.\nkoukai waza compile_with_worker_bridge(file:mochi.File,capacity:int64,gc_stress:bool,bindings:[]int64) -> LowerResult {\n    moshi(len(bindings)!=4){kaesu failed(LowerError.InvalidFunction());}\n    kaku i=0;aida(i<4){\n        kaku id=bindings[i];moshi(id<0 || id>=len(file.functions)){kaesu failed(LowerError.InvalidFunction());}\n        kaku f=file.functions[id];moshi(f.parameter_count!=1 || !f.returns_value || len(f.captures)!=0){kaesu failed(LowerError.InvalidFunction());}\n        kaku j=0;aida(j<i){moshi(bindings[j]==id){kaesu failed(LowerError.InvalidFunction());}j=j+1;}i=i+1;\n    }\n    kaesu compile_worker_impl(file,gc_stress,capacity,iie,iie,hai,bindings,iie,32768,iie,iie);\n}\n// Public thread natives on Darwin/AArch64 (the mio/thread/runtime start and join natives, ids given by the pipeline). The same cooperative\n// bridge as above, with the shutdown evidence record on stderr switched off (abi 3). An entry may return an int64; join returns it.\nkoukai waza compile_with_public_threads(file:mochi.File,capacity:int64,gc_stress:bool,start_id:int64,join_id:int64) -> LowerResult {\n    moshi(start_id<0 || start_id>=len(file.functions) || join_id<0 || join_id>=len(file.functions) || start_id==join_id){kaesu failed(LowerError.InvalidFunction());}\n    kaku s=file.functions[start_id];kaku j=file.functions[join_id];\n    moshi(s.parameter_count!=1 || !s.returns_value || j.parameter_count!=1 || !j.returns_value){kaesu failed(LowerError.InvalidFunction());}\n    kaesu compile_worker_target(file,gc_stress,capacity,iie,iie,hai,[start_id,join_id,-1,-1],iie,32768,iie,iie,3,hai,0,iie);\n}\n// Diagnostic build of the public thread image (mio build --observe): the heap observation record of the single-threaded runtime (collection counts,\n// pause histogram, live/peak bytes, on stderr at exit) plus per-thread timing counters of the epoch protocol (worker_roots.mio, label worker_observe,\n// printed as `mio-thread name=value` lines on stderr by the main thread when it ends). `retention` false builds the same image without bounded epoch\n// retention so the epoch counts of the two can be compared. Never used for timing; a normal build contains none of this code.\n// Test-only image (MIO_ALLOC_LOCK_STRESS=1 with --observe): the real allocation lock fast path next to frequent real collections. See\n// docs/darwin-thread-heap-exclusion-design.md section 12. Never selected by default.\nkoukai waza compile_with_public_threads_lock_stress(file:mochi.File,capacity:int64,start_id:int64,join_id:int64,violate:bool) -> LowerResult {\n    moshi(start_id<0||join_id<0||start_id==join_id){kaesu failed(LowerError.InvalidFunction());}\n    kaku mode=1;moshi(violate){mode=2;}\n    kaesu compile_worker_target(file,hai,capacity,hai,iie,hai,[start_id,join_id,-1,-1],iie,32768,iie,iie,3,hai,mode,iie);\n}\n// Test-only entry that forces the allocation wait guard and kernel errno paths.\nkoukai waza compile_with_public_threads_wait_test(file:mochi.File,capacity:int64,start_id:int64,join_id:int64,mode:int64) -> LowerResult {\n    moshi(start_id<0||join_id<0||start_id==join_id){kaesu failed(LowerError.InvalidFunction());}\n    kaesu compile_worker_target(file,mode==5,capacity,hai,iie,hai,[start_id,join_id,-1,-1],iie,32768,iie,iie,3,hai,mode,iie);\n}\nkoukai waza compile_with_public_threads_observed(file:mochi.File,capacity:int64,gc_stress:bool,start_id:int64,join_id:int64,retention:bool) -> LowerResult {\n    moshi(start_id<0 || start_id>=len(file.functions) || join_id<0 || join_id>=len(file.functions) || start_id==join_id){kaesu failed(LowerError.InvalidFunction());}\n    kaku s=file.functions[start_id];kaku j=file.functions[join_id];\n    moshi(s.parameter_count!=1 || !s.returns_value || j.parameter_count!=1 || !j.returns_value){kaesu failed(LowerError.InvalidFunction());}\n    kaesu compile_worker_target(file,gc_stress,capacity,hai,iie,hai,[start_id,join_id,-1,-1],iie,32768,iie,iie,3,retention,0,iie);\n}\n// Experimental Old collector with typed SATB and coordinated allocation/Minor.\n// Unsupported writes still Abort/join. This is not full E4 capability acceptance.\nkoukai waza compile_with_old_mark_proto(file:mochi.File,capacity:int64,bindings:[]int64) -> LowerResult {\n    kaesu compile_with_old_work_queue(file,capacity,32768,bindings);\n}\nkoukai waza compile_with_old_work_queue(file:mochi.File,capacity:int64,queue_slots:int64,bindings:[]int64) -> LowerResult {\n    kaesu compile_with_old_work_queue_stress(file,capacity,queue_slots,iie,bindings);\n}\nkoukai waza compile_with_old_work_queue_stress(file:mochi.File,capacity:int64,queue_slots:int64,gc_stress:bool,bindings:[]int64) -> LowerResult {\n    kaesu compile_old_profile(file,capacity,queue_slots,gc_stress,bindings,iie,iie);\n}\n// Internal production user-function profile; roots remain fully automatic.\nkoukai waza compile_with_concurrent_old(file:mochi.File,capacity:int64,queue_slots:int64,gc_stress:bool,bindings:[]int64) -> LowerResult {\n    kaesu compile_old_profile(file,capacity,queue_slots,gc_stress,bindings,hai,iie);\n}\n// Negative OS-release profile: first actual syscall receives unaligned address.\n// It does not fabricate a return or alter any root/GC/ownership algorithm.\nkoukai waza compile_with_concurrent_old_release_fault(file:mochi.File,capacity:int64,queue_slots:int64,gc_stress:bool,bindings:[]int64) -> LowerResult {\n    kaesu compile_old_profile(file,capacity,queue_slots,gc_stress,bindings,hai,hai);\n}\nwaza compile_old_profile(file:mochi.File,capacity:int64,queue_slots:int64,gc_stress:bool,bindings:[]int64,full_sweep:bool,release_fault:bool) -> LowerResult {\n    moshi(queue_slots<1 || queue_slots>32768){kaesu failed(LowerError.InvalidOperand(2));}\n    moshi(len(bindings)!=4){kaesu failed(LowerError.InvalidFunction());}\n    kaku i=0;aida(i<4){kaku id=bindings[i];moshi(id<0 || id>=len(file.functions)){kaesu failed(LowerError.InvalidFunction());}kaku f=file.functions[id];moshi(f.parameter_count!=1 || !f.returns_value || len(f.captures)!=0){kaesu failed(LowerError.InvalidFunction());}kaku j=0;aida(j<i){moshi(bindings[j]==id){kaesu failed(LowerError.InvalidFunction());}j=j+1;}i=i+1;}\n    kaesu compile_worker_impl(file,gc_stress,capacity,iie,iie,hai,bindings,hai,queue_slots,full_sweep,release_fault);\n}\nwaza compile_worker_impl(input_file: mochi.File, gc_stress: bool, capacity: int64, observation: bool, adaptive: bool, attached:bool, worker_bindings:[]int64, old_proto:bool, queue_slots:int64, full_sweep:bool, release_fault:bool) -> LowerResult {\n    kaesu compile_worker_target(input_file,gc_stress,capacity,observation,adaptive,attached,worker_bindings,old_proto,queue_slots,full_sweep,release_fault,0,hai,0,iie);\n}\n// Linux AArch64 target: the same lowering and runtime as Darwin, with every Darwin system call routed through the\n// linux_syscall adapter (linuxabi.mio). The caller links the words with an ELF container (kiso/aot/linuxarm64).\nkoukai waza compile_linux_arm64(file: mochi.File, capacity: int64, gc_stress: bool) -> LowerResult {\n    kaesu compile_worker_target(file,gc_stress,capacity,iie,iie,iie,[],iie,32768,iie,iie,1,hai,0,iie);\n}\n// Windows ARM64 target: the same lowering and runtime, with every Darwin system call routed through the windows_syscall adapter\n// (winabi.mio, Win32 imports) and a PE entry routine windows_start. The caller packages the words with kiso/aot/winarm64.\nkoukai waza compile_windows_arm64(file: mochi.File, capacity: int64, gc_stress: bool) -> LowerResult {\n    kaesu compile_worker_target(file,gc_stress,capacity,iie,iie,iie,[],iie,32768,iie,iie,2,hai,0,iie);\n}\nwaza compile_worker_target(input_file: mochi.File, gc_stress: bool, capacity: int64, observation: bool, adaptive: bool, attached:bool, worker_bindings:[]int64, old_proto:bool, queue_slots:int64, full_sweep:bool, release_fault:bool, abi: int64, retention: bool, lock_stress: int64, allow_c: bool) -> LowerResult {\n    moshi (mochi.has_win64_c(input_file)) { kaesu failed(LowerError.UnsupportedNative(-64)); }\n    kaku file = input_file;\n    kaku metadata_bytes = runtime_metadata_bytes;\n    moshi (observation) { metadata_bytes = observation_metadata_bytes; }\n    moshi (capacity < 64 || capacity > runtime_max_heap_bytes || capacity - (capacity / 16) * 16 != 0) { kaesu failed(LowerError.InvalidOperand(1)); }\n    moshi (file.version < 1 || file.version > 16 || file.global_count < 0 || file.global_count > 2048) { kaesu failed(LowerError.InvalidOperand(1)); }\n    kaku ffi = iie; kaku scan = 0;\n    aida (scan < len(file.functions)) {\n        kaku function = file.functions[scan];\n        moshi (cabi.is_external(function.name)) {\n            kaku signature = cabi.signature(function.name, function.parameter_count, function.returns_value);\n            // 间接调用和 []uint8 数据指针参数只有 Linux x86-64 后端实现。\n            kaku linux_only = signature.indirect; kaku lp = 0;\n            aida (lp < len(signature.parameters)) { moshi (signature.parameters[lp] == 109) { linux_only = hai; } lp = lp + 1; }\n            moshi (!allow_c || !signature.valid || linux_only || len(function.instructions) != 0 ||\n                len(function.captures) != 0 || function.local_count != function.parameter_count) {\n                kaesu failed(LowerError.UnsupportedNative((scan + 1) * 1000000));\n            }\n            ffi = hai;\n        }\n        scan = scan + 1;\n    }\n    kaku malformed = instruction_error(file); moshi (malformed != mu) { kaesu failed(malformed); }\n    kaku specialized = specialize(file);\n    file = specialized.file;\n    kaku type_result = specialized.analysis;\n    moshi (type_result.error_detail != 0) { kaesu failed(LowerError.UnsafeType(type_result.error_detail)); }\n    kaku worker_reachable=types.reachable_functions(file);\n    kaku wi=0;aida(wi<len(worker_bindings)){\n      moshi(worker_bindings[wi]>=0){\n        kaku node=type_result.locals[worker_bindings[wi]][0];kaku kind=types.type_kind(type_result,node);\n        moshi(worker_reachable[worker_bindings[wi]]){\n            kaku returned=type_result.returns[worker_bindings[wi]];\n            // The bridge's native result is a signed machine-word integer.\n            // Object/Nullable/narrow stubs would otherwise forge a managed\n            // pointer or bypass the solved language's numeric representation.\n            moshi(types.type_kind(type_result,returned)!=types.type_integer || types.type_nullable(type_result,returned) || types.integer_descriptor(type_result,returned)>1){kaesu failed(LowerError.InvalidFunction());}\n            moshi(types.type_nullable(type_result,node) || (wi==0 && kind!=types.type_function_ref) || (wi>0 && (kind!=types.type_integer || types.integer_descriptor(type_result,node)>1))){kaesu failed(LowerError.InvalidFunction());}\n        }\n      }\n        wi=wi+1;\n    }\n    kaku ids = string_ids(file.constants);\n    kaku code = arm64.assembler();\n    moshi (abi == 1) { arm64.assembler_label(code, \"linux_abi\"); }\n    moshi (abi == 2) { arm64.assembler_label(code, \"windows_abi\"); arm64.assembler_label(code, \"windows_main\"); }\n    kaku patches: []macho.AddressPatch = [];\n    array.reserve(patches, file.global_count * 2);\n    kaku native_fs = file_uses_nativefs(file);\n    kaku socket_runtime = iie; kaku si = 0; aida (si < len(file.functions)) { kaku sop = nativefs.operation(file.functions[si].name); moshi (nativefs.is_socket_operation(sop)) { socket_runtime = hai; } si = si + 1; }\n    kaku testing = uses_testing(file