 -1, -1, 0, 0, []); }\n    moshi (value == 92) {\n        kaku escaped_value = current(p);\n        moshi (escaped_value == 65 || escaped_value == 122 || escaped_value == 98 || escaped_value == 66) {\n            p.at[0] = p.at[0] + 1; kaku op = 5;\n            moshi (escaped_value == 122) { op = 6; } moshi (escaped_value == 98) { op = 9; } moshi (escaped_value == 66) { op = 10; }\n            kaesu node(p, op, -1, -1, 0, 0, []);\n        }\n        p.at[0] = p.at[0] - 1; kaku term = escaped(p); kaku ranges = term.ranges;\n        moshi (term.scalar >= 0) { ranges = folded(p, ranges); }\n        kaesu node(p, 1, -1, -1, 0, 0, ranges);\n    }\n    moshi (value < 0 || value == 42 || value == 43 || value == 63) { fail(p, \"repetition has no operand\"); kaesu -1; }\n    kaesu node(p, 1, -1, -1, 0, 0, folded(p, [value,value]));\n}\n// A malformed count is a literal brace, including multi-digit leading zeros.\nwaza repetition_count(p: Parser) -> Count {\n    kaku bad = Count { valid: iie, low: -1, high: -1, end: p.at[0] };\n    moshi (current(p) != 123) { kaesu bad; }\n    kaku at = p.at[0] + 1; kaku low = 0; kaku high = -1;\n    moshi (at >= len(p.input)) { kaesu bad; }\n    moshi (!is_digit(p.input[at])) { kaesu bad; }\n    moshi (p.input[at] == 48 && at + 1 < len(p.input)) { moshi (is_digit(p.input[at + 1])) { kaesu bad; } }\n    aida (at < len(p.input)) { moshi (!is_digit(p.input[at])) { nukeru; } moshi (low < 100000) { low = low * 10 + p.input[at] - 48; } at = at + 1; }\n    high = low;\n    moshi (at < len(p.input)) { moshi (p.input[at] == 44) {\n        at = at + 1; high = -1;\n        moshi (at < len(p.input)) { moshi (is_digit(p.input[at])) {\n            moshi (p.input[at] == 48 && at + 1 < len(p.input)) { moshi (is_digit(p.input[at + 1])) { kaesu bad; } }\n            high = 0;\n            aida (at < len(p.input)) { moshi (!is_digit(p.input[at])) { nukeru; } moshi (high < 100000) { high = high * 10 + p.input[at] - 48; } at = at + 1; }\n        } }\n    } }\n    moshi (at >= len(p.input)) { kaesu bad; }\n    moshi (p.input[at] != 125) { kaesu bad; }\n    kaesu Count { valid: hai, low: low, high: high, end: at + 1 };\n}\nwaza repeat_valid(p: Parser, root: int64) -> bool {\n    kaku nodes: []int64 = [root]; kaku limits: []int64 = [1000];\n    aida (len(nodes) > 0) {\n        kaku last = len(nodes) - 1; kaku id = nodes[last]; kaku limit = limits[last]; array.truncate(nodes, last); array.truncate(limits, last);\n        kaku item = p.nodes[id];\n        moshi (item.op == 13 && item.b == 1) {\n            kaku count = item.high; moshi (count == 0) { tsuzuku; } moshi (count < 0) { count = item.low; }\n            moshi (count > limit) { kaesu iie; } moshi (count > 0) { limit = limit / count; }\n        }\n        moshi (item.op == 11 || item.op == 12 || item.op == 13 || item.op == 14) { array.push(nodes, item.a); array.push(limits, limit); }\n        moshi (item.op == 11 || item.op == 12) { array.push(nodes, item.b); array.push(limits, limit); }\n    }\n    kaesu hai;\n}\nwaza repetition(p: Parser, child: int64) -> int64 {\n    quotes(p); moshi (p.quoted[0]) { kaesu child; }\n    kaku value = current(p); kaku low = -1; kaku high = -1; kaku first = p.at[0];\n    moshi (value == 42) { low = 0; }\n    moshi (value == 43) { low = 1; }\n    moshi (value == 63) { low = 0; high = 1; }\n    moshi (value == 42 || value == 43 || value == 63) { p.at[0] = p.at[0] + 1; }\n    sore { moshi (value == 123) {\n        kaku count = repetition_count(p);\n        moshi (count.valid) { low = count.low; high = count.high; p.at[0] = count.end;\n            moshi (low > 1000 || high > 1000 || (high >= 0 && high < low)) { fail(p, \"invalid repetition count\"); }\n        }\n    } }\n    moshi (low < 0) { kaesu child; }\n    moshi (current(p) == 63) { p.at[0] = p.at[0] + 1; }\n    moshi (current(p) == 42 || current(p) == 43 || current(p) == 63) { fail(p, \"nested repetition operator\"); }\n    moshi (current(p) == 123) { kaku count = repetition_count(p)