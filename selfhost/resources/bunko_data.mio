57 || opcode == 58) { descriptor = operand; }\n                kaku storage_width = 8;\n                moshi (opcode == 30 || descriptor == 0) {\n                    storage_width = 0;\n                }\n                moshi (descriptor == 15) {\n                    storage_width = 1;\n                }\n                // Untyped literals defer storage width until their element\n                // constraints are solved; uint8 remains compact across IO.\n                arena.array_width[type_root(arena, node)] = storage_width;\n                arena.array_descriptor[type_root(arena, node)] = descriptor;\n                ok = type_require(arena, element, type_descriptor_kind(descriptor));\n                moshi (descriptor >= 128) { type_mark_nullable(arena, element); }\n                moshi (opcode == 30 || opcode == 56) {\n                    kaku first = len(stack) - operand;\n                    kaku index = first;\n                    aida (index < len(stack) && ok) {\n                        array.push(array_links, [node, stack[index], 1, type_fail(block.function_id, offset, opcode)]);\n                        ok = type_array_link(arena, node, stack[index], hai);\n                        index = index + 1;\n                    }\n                    array.truncate(stack, first);\n                }\n                moshi (opcode == 57) {\n                    kaku initial = type_pop(stack);\n                    array.push(array_links, [node, initial, 1, type_fail(block.function_id, offset, opcode)]);\n                    ok = ok && type_array_link(arena, node, initial, hai);\n                    ok = ok && type_require(arena, type_pop(stack), type_integer);\n                }\n                moshi (opcode == 58) { ok = ok && type_require(arena, type_pop(stack), type_integer); }\n                array.push(stack, node);\n                handled = hai;\n            }\n            moshi (!handled && (opcode == 59 || opcode == 64)) {\n                kaku value = type_pop(stack);\n                kaku receiver = type_pop(stack);\n                kaku element = type_array_element(arena, receiver);\n                ok = element >= 0 && value >= 0;\n                moshi (ok && opcode == 64) { ok = type_join(arena, receiver, value); }\n                moshi (ok && opcode == 59) { array.push(array_links, [receiver, value, 1, type_fail(block.function_id, offset, opcode)]); }\n                handled = hai;\n            }\n            moshi (!handled && (opcode == 60 || opcode == 61 || opcode == 62 || opcode == 63)) {\n                moshi (opcode == 61 || opcode == 63) { type_pop(stack); }\n                kaku receiver = type_pop(stack);\n                ok = type_array_element(arena, receiver) >= 0;\n                moshi (opcode == 60) { array.push(stack, type_new(arena, type_integer)); }\n                moshi (opcode == 62) { array.push(stack, receiver); }\n                handled = hai;\n            }\n            moshi (!handled && opcode == 31) {\n                type_pop(stack);\n                kaku receiver = type_pop(stack);\n                kaku result = type_new(arena, type_unknown);\n                array.push(deferred_indexes, receiver);\n                array.push(deferred_indexes, result);\n                array.push(deferred_indexes, type_fail(block.function_id, offset, opcode));\n                array.push(stack, result);\n                handled = hai;\n            }\n            moshi (!handled && (opcode == 33 || opcode == 35)) {\n                kaku value = type_pop(stack);\n                type_pop(stack);\n                kaku receiver = type_pop(stack);\n                kaku element = type_array_element(arena, receiver);\n                ok = element >= 0;\n                moshi (ok) { array.push(array_links, [receiver, value, 1, type_fail(block.function_id, offset, opcode)]); }\n                handled = hai;\n            }\n            moshi (!handled && (opcode == 3 || opcode == 22)) {\n                array.truncate(stack, len(stack) - 1);\n                handled = hai;\n            }\n            moshi (!handled) {\n                kaku effect = type_stack_effect(file, opcode, operand, operand2);\n                kaku pops = effect[0];\n                aida (pops > 0) {\n                    array.truncate(stack, len(stack) - 1);\n                    pops = pops - 1;\n                }\n                kaku pushes = effect[1];\n                kaku kind = type_unknown;\n                moshi (opcode == 30 || opcode == 56 || opcode == 57 || opcode == 58 || opcode == 62) { kind = type_array_ref; }\n                moshi (opcode == 38) { kind = type_enum_ref; }\n                moshi (opcode == 44 || opcode == 46) { kind = type_function_ref; }\n                moshi (opcode == 28 || opcode == 52) { kind = type_float64; }\n                moshi (opcode == 50 || opcode == 53) { kind = type_float32; }\n                moshi (opcode == 29 || opcode == 51 || opcode == 32 || opcode == 39 || opcode == 55 || opcode == 60) {\n                    kind = type_integer;\n                }\n                aida (pushes > 0) {\n                    array.push(stack, type_new(arena, kind));\n                    pushes = pushes - 1;\n                }\n            }\n            moshi (!ok) { failed_detail = type_fail(block.function_id, offset, opcode); }\n            sore {\n                kaku next = offset + width;\n                moshi (opcode == 17) { ok = type_merge_entry(arena, block.entry, operand, stack); }\n                moshi (opcode == 18) {\n                    ok = type_merge_entry(arena, block.entry, operand, stack) && type_merge_entry(arena, block.entry, next, stack);\n                }\n                moshi (opcode != 17 && opcode != 18 && opcode != 26 && opcode != 27) {\n                    ok = type_merge_entry(arena, block.entry, next, stack);\n                }\n                moshi (!ok) { failed_detail = type_fail(block.function_id, offset, opcode); }\n            }\n            offset = offset + width;\n        }\n        blocks[block_index] = block;\n        block_index = block_index + 1;\n    }\n    // Signature edges must reach a fixed point: returns can themselves carry\n    // function targets, including recursively through parameters and captures.\n    kaku pass = 0;\n    kaku changed = hai;\n    aida (changed && failed_detail == 0) {\n        arena.context[0] = -1;\n        kaku before = arena.revision[0];\n        kaku ki = 0;\n        aida (ki < len(kind_links) && failed_detail == 0) {\n            kaku link = kind_links[ki];\n            arena.context[0] = link[2];\n            moshi (!type_same_kind(arena, link[0], link[1], link[2] - (link[2] / 100) * 100 <= 7)) {\n                failed_detail = link[2];\n            }\n            ki = ki + 1;\n        }\n        ki = 0;\n        aida (ki < len(projections) && failed_detail == 0) {\n            kaku link = projections[ki];\n            arena.context[0] = link[2];\n            kaku view = type_root(arena, link[0]);\n            kaku source = type_root(arena, link[1]);\n            moshi (!type_same_kind(arena, view, source, hai)) { failed_detail = link[2]; }\n            // References already use one representation for nil/non-nil.\n            // Keep their complete shape/target/variant edges in the existing\n            // union; only scalar boxes need a distinct non-nil value view.\n            kaku kind = arena.kind[source];\n            moshi (kind == type_function_ref) {\n                // A non-nil function value retains all callable targets without\n                // rejoining its nullable placeholder's value representation.\n                kaku vr = type_root(arena, view);\n                moshi (merge_targets(arena.targets[vr], arena.targets[source])) {\n                    arena.revision[0] = arena.revision[0] + 1;\n                }\n            } sore { moshi (kind == type_array_ref || kind == type_struct_ref || kind == type_enum_ref || kind == type_map_ref || kind == type_string_id) {\n                    moshi (!type_join(arena, view, source)) { failed_detail = link[2]; }\n                } }\n            ki = ki + 1;\n        }\n        kaku di = 0;\n        aida (di < len(deferred_indexes) && failed_detail == 0) {\n            kaku receiver = deferred_indexes[di];\n            moshi (receiver >= 0) {\n                kaku kind = arena.kind[type_root(arena, receiver)];\n                kaku result = deferred_indexes[di + 1];\n                kaku ok = hai;\n                moshi (kind == type_string_id) {\n                    ok = type_require(arena, result, type_integer);\n                    deferred_indexes[di] = -1;\n                }\n                moshi (kind == type_array_ref) {\n                    array.push(array_links, [receiver, result, 0, deferred_indexes[di + 2]]);\n                    deferred_indexes[di] = -1;\n                }\n                moshi (!ok) { failed_detail = deferred_indexes[di + 2]; }\n            }\n            di = di + 3;\n        }\n        di = 0;\n        aida (di < len(enum_reads) && failed_detail == 0) {\n            kaku variants = arena.variants[type_root(arena, enum_reads[di])];\n            kaku tag = enum_reads[di + 3];\n            kaku field = enum_reads[di + 2] + 1;\n            moshi (tag >= 0 && tag < len(variants) && len(variants[tag]) > field) {\n                moshi (!type_join(arena, enum_reads[di + 1], variants[tag][field])) { failed_detail = enum_reads[di + 4]; }\n            }\n            di = di + 5;\n        }\n        kaku al = 0;\n        aida (al < len(array_links) && failed_detail == 0) {\n            kaku link = array_links[al];\n            moshi (!type_array_link(arena, link[0], link[1], link[2] == 1)) { failed_detail = link[3]; }\n            al = al + 1;\n        }\n        kaku ci = 0;\n        aida (ci < len(call_nodes) && failed_detail == 0) {\n            kaku node = call_nodes[ci];\n            kaku targets = arena.targets[type_root(arena, node)];\n            kaku ti = 0;\n            aida (ti < len(targets) && failed_detail == 0) {\n                kaku target = targets[ti];\n                kaku fn = file.functions[target];\n                kaku args = call_arguments[ci];\n                kaku ok = fn.parameter_count == len(args) && fn.returns_value == (call_results[ci] >= 0);\n                kaku ai = 0;\n                aida (ai < len(args) && ok) {\n                    ok = type_join(arena, locals[target][ai], args[ai]);\n                    ai = ai + 1;\n                }\n                moshi (ok && fn.returns_value) { ok = type_join(arena, call_results[ci], returns[target]); }\n                moshi (!ok || arena.kind[type_root(arena, node)] != type_function_ref) { failed_detail = call_details[ci]; }\n                ti = ti + 1;\n            }\n            ci = ci + 1;\n        }\n        changed = before != arena.revision[0];\n        pass = pass + 1;\n    }\n    // v14 erases Map value annotations. A Map alias class without any write\n    // has only nil lookup results. Derive Nil from the complete alias/write\n    // graph; never publish an unresolved scalar as a speculative GC Root.\n    kaku map_index = 0;\n    aida (map_index < len(arena.parent)) {\n        moshi (arena.parent[map_index] == map_index && arena.kind[map_index] == type_map_ref &&\n            !arena.map_written[map_index] && len(arena.fields[map_index]) > 1) {\n            kaku value = type_root(arena, arena.fields[map_index][1]);\n            moshi (arena.kind[value] == type_unknown) { arena.kind[value] = type_nil; }\n        }\n        map_index = map_index + 1;\n    }\n    kaku ki = 0;\n    aida (ki < len(kind_links) && failed_detail == 0) {\n        kaku link = kind_links[ki];\n        kaku op = link[2] - (link[2] / 100) * 100;\n        kaku kind = arena.kind[type_root(arena, link[0])];\n        moshi (kind == type_unknown || ((op == 2 || op == 4 || op == 5 || op == 6 || op == 7) && kind != type_integer && kind != type_float32 && kind != type_float64 && kind != type_float_any)) {\n            failed_detail = link[2];\n        }\n        ki = ki + 1;\n    }\n    kaku mi = 0;\n    aida (mi < len(math_arguments) && failed_detail == 0) {\n        kaku item = math_arguments[mi];\n        kaku kind = arena.kind[type_root(arena, item[0])];\n        kaku floating = kind == type_float32 || kind == type_float64 || kind == type_float_any;\n        moshi ((!floating && item[1] <= 9) || (!floating && kind != type_integer && item[1] >= 11)) { failed_detail = item[2]; }\n        mi = mi + 1;\n    }\n    kaku fi = 0;\n    aida (fi < len(float_predicate_arguments) && failed_detail == 0) {\n        kaku arg = float_predicate_arguments[fi];\n        kaku kind = arena.kind[type_root(arena, arg[0])];\n        moshi (kind != type_float32 && kind != type_float64) { failed_detail = arg[1]; }\n        fi = fi + 1;\n    }\n    kaku ci = 0;\n    aida (ci < len(call_nodes) && failed_detail == 0) {\n        moshi (len(arena.targets[type_root(arena, call_nodes[ci])]) == 0) { failed_detail = call_details[ci]; }\n        ci = ci + 1;\n    }\n    // Index is overloaded for strings and arrays. Resolve after all direct\n    // call/return edges exist, without guessing unknown receiver kinds.\n    kaku progress = hai;\n    aida (progress && failed_detail == 0) {\n        progress = iie;\n        kaku index = 0;\n        aida (index < len(deferred_indexes)) {\n            kaku receiver = deferred_indexes[index];\n            moshi (receiver >= 0) {\n                kaku kind = arena.kind[type_root(arena, receiver)];\n                moshi (kind != type_unknown) {\n                    kaku result = deferred_indexes[index + 1];\n                    kaku ok = iie;\n                    moshi (kind == type_string_id) { ok = type_require(arena, result, type_integer); }\n                    moshi (kind == type_array_ref) { ok = type_array_link(arena, receiver, result, iie); }\n                    moshi (!ok) { failed_detail = deferred_indexes[index + 2]; }\n                    deferred_indexes[index] = -1;\n                    progress = hai;\n                }\n            }\n            index = index + 3;\n        }\n    }\n    kaku ni = 0;\n    aida (ni < len(arena.parent)) {\n        moshi (arena.parent[ni] == ni && arena.kind[ni] == type_array_ref && arena.array_width[ni] == 0 && len(arena.fields[ni]) > 0) {\n            kaku element = type_root(arena, arena.fields[ni][0]);\n            kaku width = 8;\n            moshi (arena.integer_descriptor[element] == 15 && !arena.nullable[element]) { width = 1; }\n            arena.array_width[ni] = width;\n        }\n        ni = ni + 1;\n    }\n    kaesu TypeAnalysis { arena: arena, globals: globals, locals: locals, returns: returns, upvalues: upvalues, cells: cells,\n        blocks: blocks, error_detail: failed_detail };\n}\n" }; }
waza data_34() -> File { kaesu File { path: "kiso/aot/lower/winabi.mio", version: "Bunko-v2.1.1", length: 70719, sha256: "5a49af567832456bd36bda535d02787d9e5d688869a87d83d8ccf81c55f7fa39", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// Windows ARM64 operating-system adapter for the Darwin/AArch64 lowering.\n//\n// The Darwin backend reaches the kernel only through `SVC #128` (BSD number in x16; carry set and a positive errno in x0 on\n// failure). With the label `windows_abi` defined (see arm64.assembler_emit) every such SVC becomes a call of\n// `windows_syscall`, emitted here: it performs the equivalent Win32 call through the import address table (IAT) and\n// returns the Darwin convention. Win32 has no stable system-call interface, so every operation goes through kernel32 /\n// ws2_32 imports; the loader fills the IAT. Calls without a translation fail explicitly with ENOSYS (Darwin value 78).\n// All registers except x0, x1, x16 and the flags are preserved (Win32 clobbers x0-x17; the adapter saves and restores).\n//\n// IAT slots are addressed with ADRP/ADD AddressPatch records of target kind 3 (target_offset = flattened import index * 8);\n// the image builder (kiso/aot/winarm64) resolves them. Frame (288 bytes): 0..127 saved x2-x15, x17, x30; 128 original x1;\n// 144..271 scratch.\n\n// The imports in IAT order: pairs of (library, symbol). The image builder groups them by library in this order.\nkoukai waza windows_imports() -> []string {\n    kaku names = [\"ExitProcess\", \"GetStdHandle\", \"WriteFile\", \"ReadFile\", \"CloseHandle\", \"VirtualAlloc\", \"VirtualFree\", \"CreateFileW\",\n        \"GetLastError\", \"MultiByteToWideChar\", \"WideCharToMultiByte\", \"GetFileAttributesExW\", \"CreateDirectoryW\", \"RemoveDirectoryW\",\n        \"DeleteFileW\", \"GetFileInformationByHandleEx\", \"GetCurrentProcessId\", \"GetFinalPathNameByHandleW\", \"GetModuleFileNameW\",\n        \"SetConsoleOutputCP\", \"SetConsoleCP\", \"GetCommandLineW\", \"GetEnvironmentStringsW\", \"CreateProcessW\", \"WaitForSingleObject\",\n        \"GetExitCodeProcess\", \"TerminateProcess\", \"SetHandleInformation\", \"GetStartupInfoW\", \"GetFileType\", \"PeekNamedPipe\", \"Sleep\"];\n    kaku pairs: []string = [];\n    kaku at = 0;\n    aida (at < len(names)) {\n        array.push(pairs, \"kernel32.dll\");\n        array.push(pairs, names[at]);\n        at = at + 1;\n    }\n    kaku sockets = [\"WSAStartup\", \"WSASocketW\", \"bind\", \"connect\", \"listen\", \"accept\", \"setsockopt\", \"closesocket\", \"WSAGetLastError\", \"ioctlsocket\", \"getsockopt\", \"recv\", \"send\"];\n    at = 0;\n    aida (at < len(sockets)) {\n        array.push(pairs, \"ws2_32.dll\");\n        array.push(pairs, sockets[at]);\n        at = at + 1;\n    }\n    array.push(pairs, \"shell32.dll\");\n    array.push(pairs, \"CommandLineToArgvW\");\n    kaesu pairs;\n}\n\n// Adapter data (64-bit words appended after the program's globals): the descriptor table has 64 entries (HANDLE or 0 = free)\n// at word 0 (entries 0..2 are the standard handles); per-descriptor \"directory enumeration started\" flags at word 64.\n// Process emulation state (see the fork/execve blocks): word 128 mode (1 while the emulated child runs), 129 timeout seconds,\n// 130 last child exit code, 131 child pid, 132 saved sp, 133 saved return address, 134 saved caller lr, 136..149 saved x2-x15,\n// 150 saved x17, 151..160 saved x19-x28, 161 saved x29, 162 Winsock started, 192..255 snapshot of the descriptor table taken at fork.\n// Sockets live in a second table of 4032 SOCKET entries at word 256 (descriptors 64..4095, 0 = free): the 64-entry table above is for\n// files, pipes and the standard handles, so a program can hold thousands of sockets while process emulation keeps its layout.\nkoukai waza windows_adapter_words() -> int64 { kaesu 256 + 4032; }\n\nwaza wx(c: arm64.Assembler, i: arm64.Instruction) -> unit { arm64.assembler_emit(c, i); }\nwaza wx_label(c: arm64.Assembler, name: string) -> unit { arm64.assembler_label(c, name); }\nwaza wx_b(c: arm64.Assembler, name: string) -> unit { arm64.assembler_b(c, name); }\nwaza wx_bcc(c: arm64.Assembler, condition: int64, name: string) -> unit { arm64.assembler_b_cond(c, condition, name); }\nwaza wx_cbz(c: arm64.Assembler, reg: int64, name: string) -> unit { arm64.assembler_cbz_x(c, reg, name); }\nwaza wx_mov(c: arm64.Assembler, rd: int64, rn: int64) -> unit { wx(c, arm64.add_imm_x(rd, rn, 0, iie)); }\nwaza wx_li(c: arm64.Assembler, reg: int64, value: int64) -> unit {\n    moshi (value < 0) {\n        wx(c, arm64.movn_x(reg, -value - 1, 0));\n        kaesu;\n    }\n    moshi (value < 65536) {\n        wx(c, arm64.movz_x(reg, value, 0));\n        kaesu;\n    }\n    kaku low = value - (value / 65536) * 65536;\n    wx(c, arm64.movz_x(reg, low, 0));\n    wx(c, arm64.movk_x(reg, (value / 65536) - ((value / 65536) / 65536) * 65536, 1));\n    moshi (value >= 4294967296) { wx(c, arm64.movk_x(reg, value / 4294967296, 2)); }\n}\nwaza wx_name(prefix: string, index: int64) -> string { kaesu string.concat(prefix, convert.format_int(index)); }\n\nwaza import_index(symbol: string) -> int64 {\n    kaku names = windows_imports();\n    kaku at = 1;\n    aida (at < len(names)) {\n        moshi (names[at] == symbol) {\n            kaesu at / 2;\n        }\n        at = at + 2;\n    }\n    kaesu -1;\n}\n\n// Call the imported function `symbol`: x16 = address of its IAT slot (patched ADRP/ADD), x16 = [x16], blr x16.\nwaza wx_call(c: arm64.Assembler, patches: []macho.AddressPatch, symbol: string) -> unit {\n    kaku index = import_index(symbol);\n    kaku at = len(c.words);\n    wx(c, arm64.Instruction {\n            word: uint32(0), error: mu });\n    wx(c, arm64.Instruction {\n            word: uint32(0), error: mu });\n    array.push(patches, macho.AddressPatch {\n            at_word: at, add_at_word: at + 1, target: macho.AddressTarget {\n                kind: 3 }, target_offset: index * 8, register: 16 });\n    wx(c, arm64.ldr_x(16, 16, 0));\n    wx(c, arm64.blr_x(16));\n}\n\n// x(reg) = address of adapter data word `word` (ADRP/ADD with a globals patch; the image builder resolves it).\nwaza wx_data(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64, reg: int64, word: int64) -> unit {\n    kaku at = len(c.words);\n    wx(c, arm64.Instruction {\n            word: uint32(0), error: mu });\n    wx(c, arm64.Instruction {\n            word: uint32(0), error: mu });\n    array.push(patches, macho.AddressPatch {\n            at_word: at, add_at_word: at + 1, target: macho.data_target(), target_offset: (base + word) * 8, register: reg });\n}\n\n// [adapter word] <-> register (clobbers x10)\nwaza wx_get(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64, dst: int64, word: int64) -> unit {\n    wx_data(c, patches, base, 10, word);\n    wx(c, arm64.ldr_x(dst, 10, 0));\n}\nwaza wx_put(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64, src: int64, word: int64) -> unit {\n    wx_data(c, patches, base, 10, word);\n    wx(c, arm64.str_x(src, 10, 0));\n}\n\n// BOOL results are 32-bit: clear the undefined upper half.\nwaza wx_bool(c: arm64.Assembler) -> unit {\n    wx(c, arm64.lsl_x(0, 0, 32));\n    wx(c, arm64.lsr_x(0, 0, 32));\n}\n\nwaza wx_save(c: arm64.Assembler, a: int64, b: int64, offset: int64) -> unit { wx(c, arm64.stp_x(a, b, 31, offset)); }\nwaza wx_load(c: arm64.Assembler, a: int64, b: int64, offset: int64) -> unit { wx(c, arm64.ldp_x(a, b, 31, offset)); }\n\n// ---- small assembly helpers used by the blocks below\nwaza wx_cmpi(c: arm64.Assembler, reg: int64, value: int64) -> unit { wx(c, arm64.cmp_imm_x(reg, value, iie)); }\nwaza wx_ldr(c: arm64.Assembler, rt: int64, off: int64) -> unit { wx(c, arm64.ldr_x(rt, 31, off)); }\nwaza wx_str(c: arm64.Assembler, rt: int64, off: int64) -> unit { wx(c, arm64.str_x(rt, 31, off)); }\nwaza wx_cbnz(c: arm64.Assembler, reg: int64, name: string) -> unit { arm64.assembler_cbnz_x(c, reg, name); }\nwaza wx_bl(c: arm64.Assembler, name: string) -> unit { arm64.assembler_bl(c, name); }\n\n// Frame allocation in two probed halves (each below a page) so the guard-page mechanism can commit the stack in order.\nwaza wx_alloc(c: arm64.Assembler, size: int64) -> unit {\n    // each half must be a multiple of 16: SP is checked for alignment on every access through it\n    moshi ((size / 2) - ((size / 2) / 16) * 16 != 0 || size - (size / 2) * 2 != 0) {\n        array.push(c.errors, arm64.EncodeError.MisalignedOffset());\n    }\n    wx(c, arm64.sub_imm_x(31, 31, size / 2, iie));\n    wx(c, arm64.str_x(31, 31, 0));\n    wx(c, arm64.sub_imm_x(31, 31, size / 2, iie));\n    wx(c, arm64.str_x(31, 31, 0));\n}\nwaza wx_free(c: arm64.Assembler, size: int64) -> unit {\n    wx(c, arm64.add_imm_x(31, 31, size / 2, iie));\n    wx(c, arm64.add_imm_x(31, 31, size / 2, iie));\n}\n\n// Win32 error code (x0) -> Darwin errno (x0). Leaf routine, clobbers x9-x10.\nwaza wx_map_error(c: arm64.Assembler) -> unit {\n    wx_label(c, \"wx_map_error\");\n    kaku pairs = [2, 2, 3, 2, 5, 13, 6, 9, 32, 13, 80, 17, 183, 17, 267, 20, 145, 66, 87, 22, 123, 63, 161, 63, 206, 63,\n        10013, 13, 10022, 22, 10035, 35, 10036, 36, 10038, 38, 10040, 40, 10047, 47, 10048, 48, 10049, 49, 10051, 51, 10053, 53, 10054, 54, 10056, 56,\n        10057, 57, 10060, 60, 10061, 61, 10065, 65, 64, 54];\n    kaku at = 0;\n    aida (at < len(pairs)) {\n        kaku next = wx_name(\"wx_map_error_next_\", at);\n        wx_li(c, 9, pairs[at]);\n        wx(c, arm64.cmp_x(0, 9));\n        wx_bcc(c, 1, next);\n        wx_li(c, 0, pairs[at + 1]);\n        wx(c, arm64.ret());\n        wx_label(c, next);\n        at = at + 2;\n    }\n    wx_li(c, 0, 5);\n    wx(c, arm64.ret());\n}\n\n// Calls GetLastError, maps it and jumps to the common error exit; `cleanup` bytes of stack are released first.\nwaza wx_fail_last(c: arm64.Assembler, patches: []macho.AddressPatch, cleanup: int64) -> unit {\n    wx_call(c, patches, \"GetLastError\");\n    wx_bool(c);\n    wx_bl(c, \"wx_map_error\");\n    moshi (cleanup > 0) { wx_free(c, cleanup); }\n    wx_b(c, \"wx_error\");\n}\n\n// x0 = descriptor -> x0 = HANDLE, or 0 when the descriptor is not open. Clobbers x9, x10.\nwaza wx_handle_routine(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64) -> unit {\n    wx_label(c, \"wx_handle\");\n    wx_cmpi(c, 0, 64);\n    wx_bcc(c, 2, \"wx_handle_socket\");\n    wx_data(c, patches, base, 10, 0);\n    wx(c, arm64.ldr_x_register_scaled(0, 10, 0));\n    wx(c, arm64.ret());\n    wx_label(c, \"wx_handle_socket\");\n    wx(c, arm64.sub_imm_x(0, 0, 64, iie));\n    wx_cmpi(c, 0, 4032);\n    wx_bcc(c, 2, \"wx_handle_none\");\n    wx_data(c, patches, base, 10, 256);\n    wx(c, arm64.ldr_x_register_scaled(0, 10, 0));\n    wx(c, arm64.ret());\n    wx_label(c, \"wx_handle_none\");\n    wx_li(c, 0, 0);\n    wx(c, arm64.ret());\n}\n\n// UTF-8 C string at [sp, #source] -> UTF-16 at [sp] (1024 code units): x0 = number of units including the NUL, 0 on failure.\nwaza wx_to_utf16(c: arm64.Assembler, patches: []macho.AddressPatch, source: int64) -> unit {\n    wx_li(c, 0, 65001);\n    wx_li(c, 1, 0);\n    wx_ldr(c, 2, source);\n    wx(c, arm64.movn_x(3, 0, 0));\n    wx(c, arm64.add_imm_x(4, 31, 0, iie));\n    wx_li(c, 5, 1024);\n    wx_call(c, patches, \"MultiByteToWideChar\");\n    wx_bool(c);\n}\n\n// bytes at [reg] equal `text` (and its NUL): fall through when equal, jump to `fail` otherwise. Uses x9.\nwaza wx_streq(c: arm64.Assembler, reg: int64, text: string, fail: string) -> unit {\n    kaku bytes = string.to_bytes(text);\n    kaku at = 0;\n    aida (at <= len(bytes)) {\n        kaku expected = 0;\n        moshi (at < len(bytes)) {\n            expected = int64(bytes[at]);\n        }\n        wx(c, arm64.ldrb_w(9, reg, at));\n        wx_cmpi(c, 9, expected);\n        wx_bcc(c, 1, fail);\n        at = at + 1;\n    }\n}\n\n// The Mio front end expects drive-absolute paths with '/' separators from os.canonical_path (as the Windows amd64 backend\n// provides): rewrite every backslash of the NUL-terminated UTF-8 string whose pointer is saved at [sp, #slot].\nwaza wx_slashes(c: arm64.Assembler, slot: int64, prefix: string) -> unit {\n    wx_ldr(c, 9, slot);\n    wx_label(c, string.concat(prefix, \"_loop\"));\n    wx(c, arm64.ldrb_w(10, 9, 0));\n    wx_cbz(c, 10, string.concat(prefix, \"_done\"));\n    wx_cmpi(c, 10, 92);\n    wx_bcc(c, 1, string.concat(prefix, \"_next\"));\n    wx_li(c, 11, 47);\n    wx(c, arm64.strb_w(11, 9, 0));\n    wx_label(c, string.concat(prefix, \"_next\"));\n    wx(c, arm64.add_imm_x(9, 9, 1, iie));\n    wx_b(c, string.concat(prefix, \"_loop\"));\n    wx_label(c, string.concat(prefix, \"_done\"));\n}\n\n// Defines `windows_syscall`; `base` is the first adapter data word (see windows_adapter_words).\nkoukai waza emit_windows_abi_runtime(c: arm64.Assembler, patches: []macho.AddressPatch, base: int64) -> unit {\n    wx_label(c, \"windows_syscall\");\n    wx(c, arm64.sub_imm_x(31, 31, 288, iie));\n    wx_save(c, 2, 3, 0);\n    wx_save(c, 4, 5, 16);\n    wx_save(c, 6, 7, 32);\n    wx_save(c, 8, 9, 48);\n    wx_save(c, 10, 11, 64);\n    wx_save(c, 12, 13, 80);\n    wx_save(c, 14, 15, 96);\n    wx_save(c, 17, 30, 112);\n    wx(c, arm64.str_x(1, 31, 128));\n    kaku calls = [1, 2, 3, 4, 5, 6, 7, 10, 15, 20, 30, 54, 59, 73, 74, 83, 90, 92, 97, 98, 104, 105, 106, 118, 136, 137, 194, 195, 197, 202, 230, 274, 336, 338, 344];\n    kaku names = [\"wx_exit\", \"wx_fork\", \"wx_read\", \"wx_write\", \"wx_open\", \"wx_close\", \"wx_wait4\", \"wx_unlink\", \"wx_chmod\", \"wx_getpid\", \"wx_accept\", \"wx_ioctl\", \"wx_execve\", \"wx_munmap\",\n        \"wx_mprotect\", \"wx_setitimer\", \"wx_dup2\", \"wx_fcntl\", \"wx_socket\", \"wx_connect\", \"wx_bind\", \"wx_setsockopt\", \"wx_listen\", \"wx_getsockopt\", \"wx_mkdir\", \"wx_rmdir\", \"wx_getrlimit\",\n        \"wx_setrlimit\", \"wx_mmap\", \"wx_sysctl\", \"wx_poll\", \"wx_sysctlbyname\", \"wx_procinfo\", \"wx_stat\", \"wx_dirents\"];\n    kaku at = 0;\n    aida (at < len(calls)) {\n        kaku next = wx_name(\"wx_dispatch_next_\", at);\n        wx(c, arm64.cmp_imm_x(16, calls[at], iie));\n        wx_bcc(c, 1, next);\n        wx_b(c, names[at]);\n        wx_label(c, next);\n        at = at + 1;\n    }\n    // unsupported: ENOSYS (Darwin 78), carry set\n    wx_label(c, \"wx_unsupported\");\n    wx_li(c, 0, 78);\n    wx_label(c, \"wx_error\");\n    wx(c, arm64.cmp_x(31, 31));\n    wx_b(c, \"wx_done\");\n    wx_label(c, \"wx_ok\");\n    wx(c, arm64.cmn_imm_x(0, 0, iie));\n    wx_label(c, \"wx_done\");\n    wx(c, arm64.ldr_x(1, 31, 128));\n    wx_load(c, 2, 3, 0);\n    wx_load(c, 4, 5, 16);\n    wx_load(c, 6, 7, 32);\n    wx_load(c, 8, 9, 48);\n    wx_load(c, 10, 11, 64);\n    wx_load(c, 12, 13, 80);\n    wx_load(c, 14, 15, 96);\n    wx_load(c, 17, 30, 112);\n    wx(c, arm64.add_imm_x(31, 31, 288, iie));\n    wx(c, arm64.ret());\n    wx_map_error(c);\n    wx_handle_routine(c, patches, base);\n\n    // ---- exit(status) -> ExitProcess(status)\n    wx_label(c, \"wx_exit\");\n    wx_get(c, patches, base, 9, 128);\n    wx_cbz(c, 9, \"wx_exit_process\");\n    wx_b(c, \"wx_child_done\");\n    wx_label(c, \"wx_exit_process\");\n    wx_call(c, patches, \"ExitProcess\");\n    wx_b(c, \"wx_unsupported\");\n    wx_label(c, \"wx_badfd\");\n    wx_li(c, 0, 9);\n    wx_b(c, \"wx_error\");\n    wx_label(c, \"wx_inval\");\n    wx_li(c, 0, 22);\n    wx_b(c, \"wx_error\");\n\n    // ---- read(fd, buffer, length) -> ReadFile; a broken pipe or end of file reads as 0 bytes\n    wx_label(c, \"wx_read\");\n    wx(c, arm64.str_x(1, 31, 144));\n    wx(c, arm64.str_x(2, 31, 152));\n    wx(c, arm64.str_x(0, 31, 168));\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_badfd\");\n    // POSIX: a zero-length read returns 0 at once; ReadFile(0 bytes) on a socket or pipe would wait for data\n    wx(c, arm64.ldr_x(2, 31, 152));\n    wx_cbnz(c, 2, \"wx_read_nonzero\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_read_nonzero\");\n    // a socket (descriptor >= 64) reads with recv: ReadFile on a Winsock socket ignores nonblocking mode\n    wx(c, arm64.ldr_x(9, 31, 168));\n    wx_cmpi(c, 9, 64);\n    wx_bcc(c, 3, \"wx_read_file\");\n    wx(c, arm64.ldr_x(1, 31, 144));\n    wx(c, arm64.ldr_x(2, 31, 152));\n    wx_li(c, 3, 0);\n    wx_call(c, patches, \"recv\");\n    wx_bool(c);\n    wx_li(c, 9, 4294967295);\n    wx(c, arm64.cmp_x(0, 9));\n    wx_bcc(c, 0, \"wx_net_failed\");\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_read_file\");\n    wx(c, arm64.ldr_x(1, 31, 144));\n    wx(c, arm64.ldr_x(2, 31, 152));\n    wx(c, arm64.add_imm_x(3, 31, 160, iie));\n    wx_li(c, 4, 0);\n    wx_call(c, patches, \"ReadFile\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"wx_read_failed\");\n    wx(c, arm64.ldr_w(0, 31, 160));\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_read_failed\");\n    wx_call(c, patches, \"GetLastError\");\n    wx_bool(c);\n    wx_cmpi(c, 0, 109);\n    wx_bcc(c, 0, \"wx_eof\");\n    wx_cmpi(c, 0, 38);\n    wx_bcc(c, 0, \"wx_eof\");\n    wx_bl(c, \"wx_map_error\");\n    wx_b(c, \"wx_error\");\n    wx_label(c, \"wx_eof\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n\n    // ---- write(fd, buffer, length) -> WriteFile\n    wx_label(c, \"wx_write\");\n    wx(c, arm64.str_x(1, 31, 144));\n    wx(c, arm64.str_x(2, 31, 152));\n    wx(c, arm64.str_x(0, 31, 168));\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_badfd\");\n    wx(c, arm64.ldr_x(2, 31, 152));\n    wx_cbnz(c, 2, \"wx_write_nonzero\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_write_nonzero\");\n    wx(c, arm64.ldr_x(9, 31, 168));\n    wx_cmpi(c, 9, 64);\n    wx_bcc(c, 3, \"wx_write_file\");\n    wx(c, arm64.ldr_x(1, 31, 144));\n    wx(c, arm64.ldr_x(2, 31, 152));\n    wx_li(c, 3, 0);\n    wx_call(c, patches, \"send\");\n    wx_bool(c);\n    wx_li(c, 9, 4294967295);\n    wx(c, arm64.cmp_x(0, 9));\n    wx_bcc(c, 0, \"wx_net_failed\");\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_write_file\");\n    wx(c, arm64.ldr_x(1, 31, 144));\n    wx(c, arm64.ldr_x(2, 31, 152));\n    wx(c, arm64.add_imm_x(3, 31, 160, iie));\n    wx_li(c, 4, 0);\n    wx_call(c, patches, \"WriteFile\");\n    wx_bool(c);\n    wx_cbz(c, 0, \"wx_io_error\");\n    wx(c, arm64.ldr_w(0, 31, 160));\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_io_error\");\n    wx_fail_last(c, patches, 0);\n\n    // ---- close(fd): the standard descriptors stay open; others are removed from the table and closed\n    wx_label(c, \"wx_close\");\n    wx_cmpi(c, 0, 2);\n    wx_bcc(c, 8, \"wx_close_real\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_close_real\");\n    wx_cmpi(c, 0, 64);\n    wx_bcc(c, 2, \"wx_close_socket_entry\");\n    wx(c, arm64.str_x(0, 31, 144));\n    wx_bl(c, \"wx_handle\");\n    wx_cbz(c, 0, \"wx_badfd\");\n    wx(c, arm64.str_x(0, 31, 152));\n    wx_data(c, patches, base, 10, 0);\n    wx(c, arm64.ldr_x(11, 31, 144));\n    wx(c, arm64.lsl_x(11, 11, 3));\n    wx(c, arm64.add_x(10, 10, 11));\n    wx(c, arm64.str_x(31, 10, 0));\n    wx_data(c, patches, base, 10, 0);\n    wx_li(c, 11, 0);\n    wx(c, arm64.ldr_x(12, 31, 152));\n    wx_label(c, \"wx_close_scan\");\n    wx_cmpi(c, 11, 64);\n    wx_bcc(c, 2, \"wx_close_last\");\n    wx(c, arm64.ldr_x_register_scaled(13, 10, 11));\n    wx(c, arm64.cmp_x(13, 12));\n    wx_bcc(c, 0, \"wx_close_shared\");\n    wx(c, arm64.add_imm_x(11, 11, 1, iie));\n    wx_b(c, \"wx_close_scan\");\n    wx_label(c, \"wx_close_shared\");\n    wx_li(c, 0, 0);\n    wx_b(c, \"wx_ok\");\n    wx_label(c, \"wx_close_last\");\n    wx_data(c, patches, base, 10, 64);\n    wx(c, arm64.ldr_x(11, 31, 144));\n    wx(c, arm64.lsl_x(11, 11, 3));\n    wx(c, arm64.add_x(10, 10, 11));\n    wx(c, arm64.ldr_x(12, 10, 0));\n    wx(c, arm64.str_x(31, 10, 0));\n    wx(c, arm64.ldr_x(0, 31, 152));\n    wx_cmpi(c, 12, 2);\n    wx_bcc(c, 0, \"wx_close_socket\");\n    wx_call(c, patches, \"Cl