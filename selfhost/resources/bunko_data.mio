waza data_95() -> File { kaesu File { path: "kiso/runtime/gc/trace.mio", version: "Bunko-v2.1.1", length: 6566, sha256: "f3e4320c5062e6ed9197247059e274323f09c2b7e074b82e890a5a2a430e892a", source: "// Exact object-edge enumeration, independent of CPU/OS and collector policy.\n// The caller owns the mapped object and its lifetime. args: visitor context,\n// payload pointer, maximum owned payload bytes. No Root or integer guessing.\n// Visitor failure or malformed layout returns4 before further payload reads.\nkoukai teisu gc_trace_edge_operation=205;\nwaza trace_minimum(f:ir.Function,bytes:int64) -> unit {\n    tconstant(f,30,bytes);ir.put(f,ir.less_unsigned,29,4,30,0);ir.branch(f,ir.nonzero,29,\"invalid\");\n}\nwaza trace_kind(f:ir.Function,expected:int64) -> unit {\n    ir.put(f,ir.load,29,1,0,0);tconstant(f,30,expected);ir.put(f,ir.equal,29,29,30,0);ir.branch(f,ir.zero,29,\"invalid\");\n}\nwaza trace_edge(f:ir.Function,value:int64,visitor:string) -> unit {\n    moshi(visitor==\"\"){ir.call(f,gc_trace_edge_operation,15,[0,value]);}\n    sore{ir.invoke_function(f,visitor,15,[0,value]);}ir.branch(f,ir.nonzero,15,\"visitor_failed\");\n}\nwaza trace_object_program(visitor:string) -> ir.Function {\n    kaku f=ir.function(\"gc_trace_object\");\n    tconstant(f,6,16);ir.put(f,ir.less_unsigned,29,1,6,0);ir.branch(f,ir.nonzero,29,\"invalid\");\n    ir.put(f,ir.divide_unsigned,29,1,6,0);ir.put(f,ir.multiply,29,29,6,0);ir.put(f,ir.equal,29,29,1,0);ir.branch(f,ir.zero,29,\"invalid\");\n    ir.put(f,ir.subtract,3,1,6,0);ir.put(f,ir.load,4,3,0,8);\n    ir.put(f,ir.less_unsigned,29,2,4,0);ir.branch(f,ir.nonzero,29,\"invalid\");\n    ir.put(f,ir.acquire_load,5,3,0,0);tconstant(f,6,4294967296);ir.put(f,ir.divide_unsigned,29,5,6,0);ir.put(f,ir.multiply,29,29,6,0);ir.put(f,ir.subtract,5,5,29,0);\n    tcheck(f,5,100,\"structure\");tcheck(f,5,101,\"array\");tcheck(f,5,102,\"storage\");tcheck(f,5,103,\"closure\");tcheck(f,5,104,\"environment\");tcheck(f,5,105,\"cell\");tcheck(f,5,106,\"d