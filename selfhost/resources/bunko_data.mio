waza data_38() -> File { kaesu File { path: "kiso/aot/lowerlinux/gc.mio", version: "Bunko-v2.1.1", length: 33516, sha256: "358b0bd6bab07fc667915edfbdbfe4eb691a361dc9b021cbd5d828633ad5a6c2", source: "yobu \"kiso/aot/elf\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// Runtime ABI RA-1 layout profile \"x64-marksweep-v1\" (kiso/runtime/abi, docs/runtime-abi.md): two-word header,\n// sizes rounded to 8-byte granules (so objects are 8-byte aligned), no generations, no large-object space.\nkoukai teisu object_layout_profile = 2;\nkoukai teisu object_header_bytes = 16;\nkoukai teisu object_size_granule = 8;\n\n// Precise, non-moving, stop-the-world mark & sweep collector for the single-threaded Linux backend.\n//\n// Object header: [0] = kind | total_bytes << 8 (kind 0 = free block), [8] = mark word.\n// Roots: Mochi globals (rt.globals_map) and every frame of the rbp chain. The collector runs only at poll\n// points (function entry, loop back-edges); each call/poll site is followed by `jmp over; descriptor; over:`\n// where the descriptor lists the rbp-relative slots of that frame that hold references, so a frame is scanned\n// from its return address alone. No collection happens inside runtime routines, so their temporaries need no roots.\n//\n// Data segment layout (offsets from elf.data_base):\n//   0 heap_next, 8 heap_end, 16..1552 unused, 1552.. directory table (64 x 32), 3600.. collector state,\n//   8192.. directory buffers (64 x 32 KiB), then the NativeFS handle table (4096 x 24 = 98304 bytes), then the Mochi globals.\nwaza gc_state() -> int64 { kaesu elf.data_base + 3600; }\nkoukai waza directory_buffers() -> int64 { kaesu elf.data_base + 8192; }\nkoukai waza globals_base() -> int64 { kaesu elf.data_base + 8192 + 2097152 + 98304; }\n// collector state words: +0 free list head, +8 bytes allocated since the last collection, +16 threshold,\n// +24 heap base, +32 mark stack top, +40 mark stack limit, +48 mark stack base, +56 collections, +64 minimum threshold\nwaza gc_base_register() -> int64 { kaesu x86_64.rcx; }\n\nwaza emit_gc_init(code: x86_64.Assembler) -> unit {\n    // rt.init: reserve the heap (1 GiB) and the mark stack (512 MiB), both lazily committed.\n    x86_64.label(code, \"rt.init\");\n    x86_64.mov_ri(code, x86_64.rdi, 0);\n    x86_64.mov_ri(code, x86_64.rsi, 8589934592);\n    x86_64.mov_ri(code, x86_64.rdx, 3);\n    x86_64.mov_ri(code, x86_64.r10, 16418);\n    x86_64.mov_ri(code, x86_64.r8, -1);\n    x86_64.mov_ri(code, x86_64.r9, 0);\n    x86_64.mov_eax_imm(code, 9);\n    x86_64.syscall(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.trap.memory\");\n    x86_64.mov_data(code, x86_64.rcx, elf.data_base);\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rax);\n    x86_64.mov_data(code, x86_64.rdx, gc_state());\n    x86_64.mov_store(code, x86_64.rdx, 24, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 8589934592);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rcx, 8, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdi, 0);\n    x86_64.mov_ri(code, x86_64.rsi, 536870912);\n    x86_64.mov_ri(code, x86_64.rdx, 3);\n    x86_64.mov_ri(code, x86_64.r10, 16418);\n    x86_64.mov_ri(code, x86_64.r8, -1);\n    x86_64.mov_ri(code, x86_64.r9, 0);\n    x86_64.mov_eax_imm(code, 9);\n    x86_64.syscall(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.trap.memory\");\n    x86_64.mov_data(code, x86_64.rdx, gc_state());\n    x86_64.mov_store(code, x86_64.rdx, 32, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rdx, 48, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 536870912);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rdx, 40, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 33554432);\n    x86_64.mov_store(code, x86_64.rdx, 16, x86_64.rax);\n    // crash reporting: SIGSEGV, SIGBUS and SIGFPE print the faulting instruction and address, then exit with 139.\n    // A shared library (label \"pic\") must not take over the host process's signal handlers, so it installs none.\n    moshi (x86_64.label_offset(code, \"pic\") < 0) {\n    x86_64.sub_ri(code, x86_64.rsp, 32);\n    x86_64.lea_label(code, x86_64.rax, \"rt.signal_handler\");\n    x86_64.mov_store(code, x86_64.rsp, 0, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 67108868);\n    x86_64.mov_store(code, x86_64.rsp, 8, x86_64.rax);\n    x86_64.lea_label(code, x86_64.rax, \"rt.signal_restorer\");\n    x86_64.mov_store(code, x86_64.rsp, 16, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rsp, 24, x86_64.rax);\n    kaku signals: []int64 = [11, 7, 8];\n    kaku at = 0;\n    aida (at < len(signals)) {\n        x86_64.mov_ri(code, x86_64.rdi, signals[at]);\n        x86_64.mov_rr(code, x86_64.rsi, x86_64.rsp);\n        x86_64.mov_ri(code, x86_64.rdx, 0);\n        x86_64.mov_ri(code, x86_64.r10, 8);\n        x86_64.mov_eax_imm(code, 13);\n        x86_64.syscall(code);\n        at = at + 1;\n    }\n    x86_64.add_ri(code, x86_64.rsp, 32);\n    }\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.signal_restorer\");\n    x86_64.mov_eax_imm(code, 15);\n    x86_64.syscall(code);\n    // handler(sig, info, ucontext): \"fault rip=<hex> addr=<hex> rbp=<hex> rsp=<hex>\\n\" on stderr\n    x86_64.label(code, \"rt.signal_handler\");\n    x86_64.mov_rr(code, x86_64.r12, x86_64.rdx);\n    x86_64.mov_load(code, x86_64.r13, x86_64.rsi, 16);\n    emit_write_literal(code, \"rt.text.fault_rip\", 10, 2);\n    x86_64.mov_load(code, x86_64.rax, x86_64.r12, 168);\n    x86_64.call(code, \"rt.print_hex\");\n    emit_write_literal(code, \"rt.text.fault_addr\", 6, 2);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.r13);\n    x86_64.call(code, \"rt.print_hex\");\n    emit_write_literal(code, \"rt.text.fault_rbp\", 5, 2);\n    x86_64.mov_load(code, x86_64.rax, x86_64.r12, 120);\n    x86_64.call(code, \"rt.print_hex\");\n    emit_write_literal(code, \"rt.text.fault_rsp\", 5, 2);\n    x86_64.mov_load(code, x86_64.rax, x86_64.r12, 160);\n    x86_64.call(code, \"rt.print_hex\");\n    kaku shown: []int64 = [144, 152, 136, 40, 48];\n    kaku shown_at = 0;\n    aida (shown_at < len(shown)) {\n        emit_write_literal(code, \"rt.text.newline\", 1, 2);\n        x86_64.mov_load(code, x86_64.rax, x86_64.r12, shown[shown_at]);\n        x86_64.call(code, \"rt.print_hex\");\n        shown_at = shown_at + 1;\n    }\n    emit_write_literal(code, \"rt.text.newline\", 1, 2);\n    emit_exit(code, 139);\n    // rt.print_hex: rax = value -> 16 hex digits on stderr\n    x86_64.label(code, \"rt.print_hex\");\n    x86_64.sub_ri(code, x86_64.rsp, 24);\n    x86_64.mov_ri(code, x86_64.rcx, 16);\n    x86_64.label(code, \"rt.print_hex.digit\");\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.and_ri(code, x86_64.rdx, 15);\n    x86_64.cmp_ri(code, x86_64.rdx, 10);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.print_hex.numeric\");\n    x86_64.add_ri(code, x86_64.rdx, 39);\n    x86_64.label(code, \"rt.print_hex.numeric\");\n    x86_64.add_ri(code, x86_64.rdx, 48);\n    x86_64.sub_ri(code, x86_64.rcx, 1);\n    x86_64.lea(code, x86_64.rsi, x86_64.rsp, 0);\n    x86_64.add_rr(code, x86_64.rsi, x86_64.rcx);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.shr_ri(code, x86_64.rax, 4);\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.print_hex.digit\");\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.mov_ri(code, x86_64.rdi, 2);\n    x86_64.lea(code, x86_64.rsi, x86_64.rsp, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 16);\n    x86_64.syscall(code);\n    x86_64.add_ri(code, x86_64.rsp, 24);\n    x86_64.ret(code);\n    data_string(code, \"rt.text.fault_rip\", \"fault rip=\");\n    data_string(code, \"rt.text.fault_addr\", \" addr=\");\n    data_string(code, \"rt.text.fault_rbp\", \" rbp=\");\n    data_string(code, \"rt.text.fault_rsp\", \" rsp=\");\n}\n\n// Free blocks live in segregated lists: one exact-size list per block size 16..512 (bins), and one list for larger\n// blocks (collector state +0). Both are singly linked through word +16 of the free block, pushed at the front.\nwaza bins_base() -> int64 { kaesu elf.data_base + 4096; }\n\n// rt.alloc: rax = byte size (multiple of 8, at least 16) -> rax = zeroed block. Clobbers rcx, rdx, r8 only.\n// Small requests pop an exact-size bin, or split the first non-empty bin of size >= need + 24; everything else\n// (and every request above 512 bytes) takes the first fitting block of the large list, then falls back to bump allocation.\nwaza emit_gc_alloc(code: x86_64.Assembler) -> unit {\n    // mutator mode wraps this allocator in a heap lock (mutators.mio) and emits it under another name\n    kaku entry = \"rt.alloc\";\n    moshi (mutators_enabled(code)) { entry = \"rt.alloc.locked\"; }\n    x86_64.label(code, entry);\n    x86_64.push_r(code, x86_64.r9);\n    x86_64.push_r(code, x86_64.r10);\n    x86_64.mov_data(code, x86_64.rcx, gc_state());\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 8);\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rcx, 8, x86_64.rdx);\n    moshi (mutators_enabled(code)) {\n        // tell the pollers (one word, rarely written) that the threshold was reached\n        x86_64.mov_load(code, x86_64.r8, x86_64.rcx, 16);\n        x86_64.cmp_rr(code, x86_64.rdx, x86_64.r8);\n        x86_64.jcc(code, x86_64.cc_b, \"rt.alloc.nowant\");\n        x86_64.mov_ri(code, x86_64.r8, 1);\n        x86_64.mov_store(code, x86_64.rcx, mut_want, x86_64.r8);\n        x86_64.label(code, \"rt.alloc.nowant\");\n    }\n    x86_64.cmp_ri(code, x86_64.rax, 512);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.alloc.large\");\n    x86_64.mov_data(code, x86_64.r8, bins_base());\n    x86_64.add_rr(code, x86_64.r8, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.r8, 0);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.bigger\");\n    x86_64.mov_load(code, x86_64.r9, x86_64.rdx, 16);\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.r9);\n    x86_64.jmp(code, \"rt.alloc.zero\");\n    // a bigger bin: its block is split, the remainder (at least 24 bytes) goes back into its own bin\n    x86_64.label(code, \"rt.alloc.bigger\");\n    x86_64.lea(code, x86_64.r10, x86_64.rax, 24);\n    x86_64.label(code, \"rt.alloc.bigger_scan\");\n    x86_64.cmp_ri(code, x86_64.r10, 512);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.alloc.large\");\n    x86_64.mov_data(code, x86_64.r8, bins_base());\n    x86_64.add_rr(code, x86_64.r8, x86_64.r10);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.r8, 0);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.alloc.bigger_found\");\n    x86_64.add_ri(code, x86_64.r10, 8);\n    x86_64.jmp(code, \"rt.alloc.bigger_scan\");\n    x86_64.label(code, \"rt.alloc.bigger_found\");\n    x86_64.mov_load(code, x86_64.r9, x86_64.rdx, 16);\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.r9);\n    x86_64.sub_rr(code, x86_64.r10, x86_64.rax);\n    x86_64.jmp(code, \"rt.alloc.remainder\");\n    // large list: first block with size == need or size >= need + 24, unlinked; remainder re-inserted\n    x86_64.label(code, \"rt.alloc.large\");\n    x86_64.mov_data(code, x86_64.rcx, gc_state());\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 0);\n    x86_64.label(code, \"rt.alloc.large_scan\");\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.bump\");\n    x86_64.mov_load(code, x86_64.r10, x86_64.rdx, 0);\n    x86_64.shr_ri(code, x86_64.r10, 8);\n    x86_64.sub_rr(code, x86_64.r10, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.alloc.large_next\");\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.large_take\");\n    x86_64.cmp_ri(code,