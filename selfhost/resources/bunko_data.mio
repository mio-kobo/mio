x86_64.rsi);\n    x86_64.call(code, \"rt.fs_lookup\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.sock_close.closed\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 8);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rax, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store(code, x86_64.rax, 8, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.cmp_ri(code, x86_64.rcx, 1);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.sock_close.done\");\n    x86_64.mov_eax_imm(code, 3);\n    x86_64.syscall(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ge, \"rt.sock_close.done\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.call(code, \"rt.sock_classify\");\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.label(code, \"rt.sock_close.done\");\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.jmp(code, \"rt.sock_status_one\");\n    x86_64.label(code, \"rt.sock_close.closed\");\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.mov_ri(code, x86_64.rsi, 2);\n    x86_64.jmp(code, \"rt.sock_status_one\");\n}\n\nwaza emit_socket_transfer(code: x86_64.Assembler, name: string, reading: bool) -> unit {\n    x86_64.label(code, name);\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 48);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rbp, -32, x86_64.r8);\n    x86_64.test_rr(code, x86_64.r8, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.call(code, \"rt.sock_fd\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".state\"));\n    x86_64.mov_store(code, x86_64.rbp, -40, x86_64.rax);\n    // the whole byte range must lie inside the array, or nothing is touched\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -8);\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -16);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -24);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsi, 16);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".range\"));\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".range\"));\n    x86_64.cmp_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_g, string.concat(name, \".range\"));\n    x86_64.sub_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.cmp_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_g, string.concat(name, \".range\"));\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_e, string.concat(name, \".empty\"));\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rsi, 40);\n    x86_64.add_rr(code, x86_64.rsi, x86_64.rdx);\n    x86_64.label(code, string.concat(name, \".again\"));\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -40);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -24);\n    moshi (reading) { x86_64.mov_eax_imm(code, 0); }\n    moshi (!reading) {\n        x86_64.mov_eax_imm(code, 44);\n        x86_64.mov_ri(code, x86_64.r10, 16384);\n        x86_64.mov_ri(code, x86_64.r8, 0);\n        x86_64.mov_ri(code, x86_64.r9, 0);\n    }\n    x86_64.mov_store(code, x86_64.rbp, -48, x86_64.rsi);\n    x86_64.syscall(code);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -48);\n    x86_64.cmp_ri(code, x86_64.rax, -4);\n    x86_64.jcc(code, x86_64.cc_e, string.concat(name, \".again\"));\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".errno\"));\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    moshi (reading) {\n        x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n        x86_64.jcc(code, x86_64.cc_ne, string.concat(name, \".reported\"));\n        x86_64.mov_ri(code, x86_64.rdx, 1);\n    }\n    x86_64.label(code, string.concat(name, \".reported\"));\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.jmp(code, string.concat(name, \".status\"));\n    x86_64.label(code, string.concat(name, \".empty\"));\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.jmp(code, string.concat(name, \".status\"));\n    x86_64.label(code, string.concat(name, \".errno\"));\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.call(code, \"rt.sock_classify\");\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.jmp(code, string.concat(name, \".status\"));\n    x86_64.label(code, string.concat(name, \".range\"));\n    x86_64.mov_ri(code, x86_64.rcx, 1);\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.jmp(code, string.concat(name, \".status\"));\n    x86_64.label(code, string.concat(name, \".state\"));\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.label(code, string.concat(name, \".status\"));\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -32);\n    x86_64.call(code, \"rt.sock_status_io\");\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n}\n\n// \"$mma::mio/sys/socket::<name>::<hash>\" -> routine, or \"\" when the function is not a socket primitive.\nwaza socket_routine(function_name: string) -> string {\n    kaku prefix = \"$mma::mio/sys/socket::\";\n    moshi (!string.has_prefix(function_name, prefix)) { kaesu \"\"; }\n    kaku bytes = string.to_bytes(function_name);\n    kaku at = string.byte_len(prefix);\n    kaku output: []uint8 = [];\n    aida (at < len(bytes) && bytes[at] != uint8(58)) { array.push(output, bytes[at]); at = at + 1; }\n    kaku name = string.from_utf8(output);\n    moshi (name == mu) { kaesu \"\"; }\n    moshi (name == \"open\") { kaesu \"rt.sock_open\"; }\n    moshi (name == \"status\") { kaesu \"rt.sock_status\"; }\n    moshi (name == \"bind_ipv4\") { kaesu \"rt.sock_bind\"; }\n    moshi (name == \"connect_ipv4\") { kaesu \"rt.sock_connect\"; }\n    moshi (name == \"listen\") { kaesu \"rt.sock_listen\"; }\n    moshi (name == \"accept\") { kaesu \"rt.sock_accept\"; }\n    moshi (name == \"read\") { kaesu \"rt.sock_read\"; }\n    moshi (name == \"write\") { kaesu \"rt.sock_write\"; }\n    moshi (name == \"close\") { kaesu \"rt.sock_close\"; }\n    kaesu \"\";\n}\n" }; }
waza data_36() -> File { kaesu File { path: "kiso/aot/lowerlinux/runtime_testing.mio", version: "Bunko-v2.1.1", length: 4060, sha256: "31fb6127d4ff2111f143d95460ee666d8a09259279fae646273466cd113f39c5", source: "yobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/encoding/mochi\";\n\n// Test images (kiso/testing report channel), Linux side. The failure counter lives at gc_state() + 80.\n// rt.testing_report: rdi = condition, rsi = message string, rdx = 1 for the packet channel.\n// A failed expectation is counted, written to stderr with a newline and, in packet mode, to fd 3 as an\n// 8-byte little-endian length followed by the bytes. It returns normally so that every failure is recorded.\nwaza testing_counter() -> int64 { kaesu gc_state() + 80; }\n\nwaza uses_testing(file: mochi.File) -> bool {\n    kaku at = 0;\n    aida (at < len(file.functions)) {\n        moshi (types.is_testing_report(file.functions[at].name) || types.is_testing_packet(file.functions[at].name)) { kaesu hai; }\n        at = at + 1;\n    }\n    kaesu iie;\n}\n\nwaza uses_testing_packet(file: mochi.File) -> bool {\n    kaku at = 0;\n    aida (at < len(file.functions)) { moshi (types.is_testing_packet(file.functions[at].name)) { kaesu hai; } at = at + 1; }\n    kaesu iie;\n}\n\nwaza emit_testing_runtime(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.testing_report\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.testing_report.done\");\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 32);\n    x86_64.mov_ri(code, x86_64.rcx, testing_counter());\n    x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 0);\n    x86_64.add_ri(code, x86_64.rax, 1);\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rsi);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.testing_report.stderr\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsi, 16);\n    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdi, 3);\n    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -16);\n    x86_64.mov_ri(code, x86_64.rdx, 8);\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.syscall(code);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsi, 16);\n    x86_64.add_ri(code, x86_64.rsi, 24);\n    x86_64.mov_ri(code, x86_64.rdi, 3);\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.syscall(code);\n    x86_64.label(code, \"rt.testing_report.stderr\");\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsi, 16);\n    x86_64.add_ri(code, x86_64.rsi, 24);\n    x86_64.mov_ri(code, x86_64.rdi, 2);\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.syscall(code);\n    emit_write_literal(code, \"rt.text.newline\", 1, 2);\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.label(code, \"rt.testing_report.done\");\n    x86_64.ret(code);\n\n    // rt.testing_finish: rdi = 1 when the packet channel is open. Writes the completion marker (all ones) to fd 3 and\n    // exits with status 1 when any expectation failed, else 0.\n    x86_64.label(code, \"rt.testing_finish\");\n    x86_64.sub_ri(code, x86_64.rsp, 16);\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.testing_finish.status\");\n    x86_64.mov_ri(code, x86_64.rax, -1);\n    x86_64.mov_store(code, x86_64.rsp, 0, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdi, 3);\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rsp);\n    x86_64.mov_ri(code, x86_64.rdx, 8);\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.syscall(code);\n    x86_64.label(code, \"rt.testing_finish.status\");\n    x86_64.mov_ri(code, x86_64.rcx, testing_counter());\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rcx, 0);\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.mov_ri(code, x86_64.rdi, 0);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.testing_finish.exit\");\n    x86_64.mov_ri(code, x86_64.rdi, 1);\n    x86_64.label(code, \"rt.testing_finish.exit\");\n    x86_64.mov_eax_imm(code, 231);\n    x86_64.syscall(code);\n}\n" }; }
waza data_37() -> File { kaesu File { path: "kiso/aot/lowerwin/lowerwin.mio", version: "Bunko-v2.1.1", length: 27980, sha256: "6252a2fb1b3025362e1ef57adad15c016a04e30137759b2e8f3266a3f4c659d0", source: "yobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/pe\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// Pure Mio Mochi -> Windows AMD64 PE32+ lowering, scalar subset (no heap, no GC).\n//\n// Internal execution model (private to this backend, shared with kiso/aot/lowerlinux): the Mochi operand stack is the\n// native stack; each function has an rbp frame, arguments are pushed by the caller and popped by the caller.\n// The Win64 ABI applies at the Windows API boundary only (rt.write / rt.exit): RSP is realigned to 16 bytes, 32 bytes of\n// shadow space are reserved, the fifth argument has its own slot and only volatile registers carry values across calls.\n// Every emitted function (program functions, entry, runtime routines) is a frame-pointer function with matching\n// RUNTIME_FUNCTION / UNWIND_INFO: push rbp; mov rbp,rsp; [sub rsp,N]; epilogue = lea rsp,[rbp]; pop rbp; ret.\n// Anything outside the supported subset is a compile error: nothing is ignored and there is no VM fallback.\nkoukai kata LowerResult { bytes: []uint8; error: string; }\n\nkoukai teisu io_failure_exit = 111;\nwaza failed(message: string) -> LowerResult { kaesu LowerResult { bytes: [], error: message }; }\n\nwaza block_label(prefix: string, offset: int64) -> string {\n    kaesu string.concat(prefix, string.concat(\".\", convert.format_int(offset)));\n}\nwaza function_label(id: int64) -> string { kaesu string.concat(\"fn.\", convert.format_int(id)); }\nwaza string_label(index: int64) -> string { kaesu string.concat(\"str.\", convert.format_int(index)); }\nwaza operand_u16(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset + 1]) * 256 + int64(data[offset + 2]);\n}\n\nwaza constant_value(constant: mochi.Constant) -> int64 {\n    kaku high = int64(constant.bits.high);\n    kaku low = int64(constant.bits.low);\n    kaku tag = int64(constant.tag);\n    moshi (tag == 5) { moshi (low >= 128) { kaesu low - 256; } kaesu low; }\n    moshi (tag == 6) { moshi (low >= 32768) { kaesu low - 65536; } kaesu low; }\n    moshi (tag == 7) { moshi (low >= 2147483648) { kaesu low - 4294967296; } kaesu low; }\n    moshi (tag >= 8) { kaesu low; }\n    moshi (high >= 2147483648) { high = high - 4294967296; }\n    kaesu high * 4294967296 + low;\n}\n\nwaza local_disp(parameters: int64, index: int64) -> int64 {\n    moshi (index < parameters) { kaesu 16 + 8 * (parameters - 1 - index); }\n    kaesu -8 * (index - parameters + 1);\n}\n\n// ---- frames -------------------------------------------------------------------------------------------------------\n\n// Emits label, `push rbp`, `mov rbp,rsp` and optionally `sub rsp,alloc`; returns the start offset.\nwaza open_frame(code: x86_64.Assembler, name: string, alloc: int64) -> int64 {\n    x86_64.label(code, name);\n    kaku begin = len(code.bytes);\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    moshi (alloc > 0) { x86_64.sub_ri(code, x86_64.rsp, alloc); }\n    kaesu begin;\n}\n\n// Prologue byte layout is fixed by the encoder: push rbp = 1, mov rbp,rsp = 3, sub rsp,imm32 = 7.\nwaza close_frame(code: x86_64.Assembler, frames: []pe.FrameFunction, begin: int64, alloc: int64) -> unit {\n    kaku alloc_offset = 0;\n    moshi (alloc > 0) { alloc_offset = 11; }\n    array.push(frames, pe.FrameFunction { begin: begin, end: len(code.bytes), push_offset: 1, set_offset: 4,\n        alloc_offset: alloc_offset, alloc_size: alloc });\n}\n\nwaza emit_epilogue(code: x86_64.Assembler) -> unit {\n    x86_64.lea(code, x86_64.rsp, x86_64.rbp, 0);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n}\n\n// mov r11, <IAT slot VA> ; call [r11]. The VA is patched by the PE writer and registered as a DIR64 relocation.\nwaza import_call(code: x86_64.Assembler, patches: []pe.Patch, index: int64) -> unit {\n    kaku at = len(code.bytes);\n    x86_64.mov_ri(code, x86_64.r11, 0);\n    array.push(patches, pe.Patch { section: pe.text_section, offset: at + 2, kind: pe.va64, target: pe.import_section, target_offset: index });\n    x86_64.call_memory(code, x86_64.r11, 0);\n}\n\n// Address of the 64-bit global slot in rcx.\nwaza global_address(code: x86_64.Assembler, patches: []pe.Patch, slot: int64) -> unit {\n    kaku at = len(code.bytes);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    array.push(patches, pe.Patch { section: pe.text_section, offset: at + 2, kind: pe.va64, target: pe.data_section, target_offset: slot * 8 });\n}\n\n// ---- runtime routines (Win64 boundary) -----------------------------------------------------------------------------\n\n// rt.exit: rcx = status. Never returns.\nwaza emit_exit(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction) -> unit {\n    kaku begin = open_frame(code, \"rt.exit\", 0);\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    x86_64.sub_ri(code, x86_64.rsp, 32);\n    import_call(code, patches, 2);\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 0);\n}\n\n// rt.write: rcx = fd (1 or 2), rdx = pointer, r8 = length. Writes all bytes to the inherited synchronous handle.\n// Any GetStdHandle / WriteFile failure, zero progress or oversized count exits with 111 (never succeeds silently).\n// Frame after realignment: [0,32) shadow, +32 fifth argument, +40 bytes written, +48 handle, +56 cursor, +64 remaining.\nwaza emit_write(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction) -> unit {\n    kaku begin = open_frame(code, \"rt.write\", 0);\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    x86_64.sub_ri(code, x86_64.rsp, 80);\n    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rsp, 64, x86_64.r8);\n    x86_64.cmp_ri(code, x86_64.rcx, 1);\n    x86_64.mov_ri(code, x86_64.rcx, 4294967285);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.handle\");\n    x86_64.mov_ri(code, x86_64.rcx, 4294967284);\n    x86_64.label(code, \"rt.write.handle\");\n    import_call(code, patches, 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.cmp_ri(code, x86_64.rax, -1);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.mov_store(code, x86_64.rsp, 48, x86_64.rax);\n    x86_64.label(code, \"rt.write.again\");\n    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 64);\n    x86_64.test_rr(code, x86_64.r8, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.done\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 48);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 56);\n    x86_64.lea(code, x86_64.r9, x86_64.rsp, 40);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rsp, 40, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rax);\n    import_call(code, patches, 1);\n    x86_64.zero_extend_eax(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 40);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 64);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.write.failure\");\n    x86_64.sub_rr(code, x86_64.r8, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 64, x86_64.r8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 56);\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rdx);\n    x86_64.jmp(code, \"rt.write.again\");\n    x86_64.label(code, \"rt.write.done\");\n    emit_epilogue(code);\n    x86_64.label(code, \"rt.write.failure\");\n    x86_64.mov_ri(code, x86_64.rcx, io_failure_exit);\n    x86_64.call(code, \"rt.exit\");\n    close_frame(code, frames, begin, 0);\n}\n\n// rt.print_int: value in rax; decimal text and \"\\n\" to stdout.\nwaza emit_print_int(code: x86_64.Assembler, frames: []pe.FrameFunction) -> unit {\n    kaku begin = open_frame(code, \"rt.print_int\", 64);\n    x86_64.mov_ri(code, x86_64.r9, 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ge, \"rt.print_int.positive\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.r9, 1);\n    x86_64.label(code, \"rt.print_int.positive\");\n    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -1);\n    x86_64.mov_ri(code, x86_64.rdx, 10);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.r8, 10);\n    x86_64.label(code, \"rt.print_int.digit\");\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.div_r(code, x86_64.r8);\n    x86_64.add_ri(code, x86_64.rdx, 48);\n    x86_64.sub_ri(code, x86_64.rsi, 1);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.print_int.digit\");\n    x86_64.test_rr(code, x86_64.r9, x86_64.r9);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.print_int.write\");\n    x86_64.mov_ri(code, x86_64.rdx, 45);\n    x86_64.sub_ri(code, x86_64.rsi, 1);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.label(code, \"rt.print_int.write\");\n    x86_64.lea(code, x86_64.r8, x86_64.rbp, 0);\n    x86_64.sub_rr(code, x86_64.r8, x86_64.rsi);\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rsi);\n    x86_64.mov_ri(code, x86_64.rcx, 1);\n    x86_64.call(code, \"rt.write\");\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 64);\n}\n\n// rt.write_text: rdx = label address, r8 = length -> stdout.\nwaza emit_write_literal(code: x86_64.Assembler, label: string, length: int64, fd: int64) -> unit {\n    x86_64.lea_label(code, x86_64.rdx, label);\n    x86_64.mov_ri(code, x86_64.r8, length);\n    x86_64.mov_ri(code, x86_64.rcx, fd);\n    x86_64.call(code, \"rt.write\");\n}\n\nwaza emit_print_bool(code: x86_64.Assembler, frames: []pe.FrameFunction) -> unit {\n    kaku begin = open_frame(code, \"rt.print_bool\", 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.print_bool.false\");\n    emit_write_literal(code, \"rt.text.true\", 4, 1);\n    emit_epilogue(code);\n    x86_64.label(code, \"rt.print_bool.false\");\n    emit_write_literal(code, \"rt.text.false\", 4, 1);\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 0);\n}\n\n// rt.print_string: rax = string object (header 16, length at 16, bytes at 24) -> text and \"\\n\" on stdout.\nwaza emit_print_string(code: x86_64.Assembler, frames: []pe.FrameFunction) -> unit {\n    kaku begin = open_frame(code, \"rt.print_string\", 0);\n    x86_64.mov_load(code, x86_64.r8, x86_64.rax, 16);\n    x86_64.lea(code, x86_64.rdx, x86_64.rax, 24);\n    x86_64.mov_ri(code, x86_64.rcx, 1);\n    x86_64.call(code, \"rt.write\");\n    emit_write_literal(code, \"rt.text.newline\", 1, 1);\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 0);\n}\n\nwaza emit_trap(code: x86_64.Assembler, frames: []pe.FrameFunction, label: string, text: string, length: int64) -> unit {\n    kaku begin = open_frame(code, label, 0);\n    emit_write_literal(code, text, length, 2);\n    x86_64.mov_ri(code, x86_64.rcx, 1);\n    x86_64.call(code, \"rt.exit\");\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 0);\n}\n\nwaza data_string(code: x86_64.Assembler, label: string, text: string) -> unit {\n    x86_64.label(code, label);\n    kaku bytes = string.to_bytes(text);\n    kaku at = 0;\n    aida (at < len(bytes)) { x86_64.byte(code, int64(bytes[at])); at = at + 1; }\n}\n\nwaza emit_runtime(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction) -> unit {\n    emit_exit(code, patches, frames);\n    emit_write(code, patches, frames);\n    emit_print_int(code, frames);\n    emit_print_bool(code, frames);\n    emit_print_string(code, frames);\n    emit_trap(code, frames, \"rt.trap.divide\", \"rt.text.divide\", 32);\n    emit_trap(code, frames, \"rt.trap.unreachable\", \"rt.text.unreachable\", 35);\n    data_string(code, \"rt.text.true\", \"hai\\n\");\n    data_string(code, \"rt.text.false\", \"iie\\n\");\n    data_string(code, \"rt.text.newline\", \"\\n\");\n    data_string(code, \"rt.text.divide\", \"runtime error: division by zero\\n\");\n    data_string(code, \"rt.text.unreachable\", \"runtime error: unreachable code\\n\");\n}\n\nwaza emit_word(code: x86_64.Assembler, value: int64) -> unit {\n    kaku rest = value;\n    kaku at = 0;\n    aida (at < 8) { x86_64.byte(code, rest - (rest / 256) * 256); rest = rest / 256; at = at + 1; }\n}\n\n// Constant strings are immutable string objects in .text (kind 6 | size << 8, gc word, length, bytes); no heap, no GC.\nwaza emit_string_constants(code: x86_64.Assembler, file: mochi.File) -> unit {\n    kaku index = 0;\n    aida (index < len(file.constants)) {\n        kaku constant = file.constants[index];\n        moshi (int64(constant.tag) == 2) {\n            x86_64.label(code, string_label(index));\n            emit_word(code, 6 + 256 * (24 + len(constant.data)));\n            emit_word(code, 0);\n            emit_word(code, len(constant.data));\n            kaku at = 0;\n            aida (at < len(constant.data)) { x86_64.byte(code, int64(constant.data[at])); at = at + 1; }\n        }\n        index = index + 1;\n    }\n}\n\n// ---- instruction selection ------------------------------------------------------------------------------------------\n\nwaza condition_for(opcode: int64) -> int64 {\n    moshi (opcode == 11) { kaesu x86_64.cc_e; }\n    moshi (opcode == 12) { kaesu x86_64.cc_ne; }\n    moshi (opcode == 13) { kaesu x86_64.cc_l; }\n    moshi (opcode == 14) { kaesu x86_64.cc_le; }\n    moshi (opcode == 15) { kaesu x86_64.cc_g; }\n    kaesu x86_64.cc_ge;\n}\n\nwaza supported(opcode: int64) -> bool {\n    kaesu (opcode >= 1 && opcode <= 20) || opcode == 22 || opcode == 23 || opcode == 24 || opcode == 25 || opcode == 26 || opcode == 27 || opcode == 49;\n}\n\nwaza stack_node(analysis: types.TypeAnalysis, function_id: int64, offset: int64, depth: int64) -> int64 {\n    kaku entries = analysis.blocks[function_id + 1].entry[offset];\n    moshi (depth >= len(entries)) { kaesu -1; }\n    kaesu entries[len(entries) - 1 - depth];\n}\n\n// Integer/bool values are raw 64-bit slots. Nullable values would be boxed objects and floats need SSE: both are rejected.\nwaza scalar_operand(analysis: types.TypeAnalysis, node: int64, allow_bool: bool) -> string {\n    moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n    kaku kind = types.type_kind(analysis, node);\n    moshi (types.type_nullable(analysis, node)) { kaesu \"UNSUPPORTED_NULLABLE\"; }\n    moshi (kind == types.type_integer) { kaesu \"\"; }\n    moshi (kind == types.type_bool && allow_bool) { kaesu \"\"; }\n    kaesu string.concat(\"UNSUPPORTED_OPERAND_TYPE \", convert.format_int(kind));\n}\n\nwaza emit_normalize(code: x86_64.Assembler, descriptor: int64) -> unit {\n    moshi (descriptor < 12 || descriptor > 17) { kaesu; }\n    kaku width = 8;\n    moshi (descriptor == 13 || descriptor == 16) { width = 16; }\n    moshi (descriptor == 14 || descriptor == 17) { width = 32; }\n    x86_64.shl_ri(code, x86_64.rax, 64 - width);\n    moshi (descriptor <= 14) { x86_64.sar_ri(code, x86_64.rax, 64 - width); }\n    moshi (descriptor > 14) { x86_64.shr_ri(code, x86_64.rax, 64 - width); }\n}\n\n// \"$mma::mio/os/runtime::exit:...\" -> \"exit\"; \"\" for every other body-less function.\nwaza native_exit(name: string) -> bool {\n    kaku prefix = \"$mma::mio/os/runtime::exit\";\n    moshi (!string.has_prefix(name, prefix)) { kaesu iie; }\n    kaku bytes = string.to_bytes(name);\n    kaku at = string.byte_len(prefix);\n    kaesu at == len(bytes) || bytes[at] == uint8(58);\n}\n\nwaza emit_block(code: x86_64.Assembler, patches: []pe.Patch, file: mochi.File, analysis: types.TypeAnalysis, data: []uint8,\n    prefix: string, function_id: int64, parameters: int64) -> string {\n    kaku offset = 0;\n    aida (offset < len(data)) {\n        x86_64.label(code, block_label(prefix, offset));\n        kaku opcode = int64(data[offset]);\n        moshi (!supported(opcode)) { kaesu string.concat(\"UNSUPPORTED_OPCODE \", convert.format_int(opcode)); }\n        kaku step = types.type_instruction_width(opcode);\n        moshi (step == 0) { kaesu string.concat(\"UNSUPPORTED_OPCODE \", convert.format_int(opcode)); }\n        moshi (offset + step > len(data)) { kaesu \"TRUNCATED_INSTRUCTION\"; }\n        kaku operand = 0;\n        moshi (step >= 3) { operand = operand_u16(data, offset); }\n        moshi (offset >= len(analysis.blocks[function_id + 1].entry)) { kaesu \"MISSING_TYPE_INFO\"; }\n        moshi (opcode == 1) {\n            moshi (operand >= len(file.constants)) { kaesu \"INVALID_CONSTANT_INDEX\"; }\n            kaku constant = file.constants[operand];\n            kaku tag = int64(constant.tag);\n            moshi (tag == 2) { x86_64.lea_label(code, x86_64.rax, string_label(operand)); }\n            moshi (tag == 1 || (tag >= 5 && tag <= 10)) { x86_64.mov_ri(code, x86_64.rax, constant_value(constant)); }\n            moshi (tag != 1 && tag != 2 && !(tag >= 5 && tag <= 10)) { kaesu string.concat(\"UNSUPPORTED_CONSTANT_TAG \", convert.format_int(tag)); }\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode == 2 || opcode == 4 || opcode == 5 || opcode == 6) {\n            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), iie);\n            moshi (bad == \"\") { bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 1), iie); }\n            moshi (bad != \"\") { kaesu bad; }\n            x86_64.pop_r(code, x86_64.rcx); x86_64.pop_r(code, x86_64.rax);\n            moshi (opcode == 2) { x86_64.add_rr(code, x86_64.rax, x86_64.rcx); }\n            moshi (opcode == 4) { x86_64.sub_rr(code, x86_64.rax, x86_64.rcx); }\n            moshi (opcode == 5) { x86_64.imul_rr(code, x86_64.rax, x86_64.rcx); }\n            moshi (opcode == 6) {\n                kaku done = block_label(string.concat(prefix, \".div\"), offset);\n                kaku wrapped = block_label(string.concat(prefix, \".neg\"), offset);\n                x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n                x86_64.jcc(code, x86_64.cc_e, \"rt.trap.divide\");\n                x86_64.mov_ri(code, x86_64.rdx, -1);\n                x86_64.cmp_rr(code, x86_64.rcx, x86_64.rdx);\n                x86_64.jcc(code, x86_64.cc_e, wrapped);\n                x86_64.cqo(code);\n                x86_64.idiv_r(code, x86_64.rcx);\n                x86_64.jmp(code, done);\n                x86_64.label(code, wrapped);\n                x86_64.neg_r(code, x86_64.rax);\n                x86_64.label(code, done);\n            }\n            emit_normalize(code, types.integer_descriptor(analysis, stack_node(analysis, function_id, offset, 0)));\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode == 3) { x86_64.pop_r(code, x86_64.rax); }\n        moshi (opcode == 7) {\n            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), iie);\n            moshi (bad != \"\") { kaesu bad; }\n            x86_64.pop_r(code, x86_64.rax); x86_64.neg_r(code, x86_64.rax);\n            emit_normalize(code, types.integer_descriptor(analysis, stack_node(analysis, function_id, offset, 0)));\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode == 8 || opcode == 9) {\n            x86_64.mov_ri(code, x86_64.rax, 9 - opcode);\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode == 10) {\n            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), hai);\n            moshi (bad != \"\") { kaesu bad; }\n            x86_64.pop_r(code, x86_64.rax); x86_64.mov_ri(code, x86_64.rcx, 1); x86_64.xor_rr(code, x86_64.rax, x86_64.rcx);\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode >= 11 && opcode <= 16) {\n            kaku equality = opcode <= 12;\n            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), equality);\n            moshi (bad == \"\") { bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 1), equality); }\n            moshi (bad != \"\") { kaesu bad; }\n            x86_64.pop_r(code, x86_64.rcx); x86_64.pop_r(code, x86_64.rax);\n            x86_64.cmp_rr(code, x86_64.rax, x86_64.rcx);\n            x86_64.setcc_rax(code, condition_for(opcode));\n            x86_64.push_r(code, x86_64.rax);\n        }\n        moshi (opcode == 17) { x86_64.jmp(code, block_label(prefix, operand)); }\n        moshi (opcode == 18) {\n            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), hai);\n            moshi (bad != \"\") { kaesu bad; }\n            x86_64.pop_r(code, x86_64.rax); x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n            x86_64.jcc(code, x86_64.cc_e, block_label(prefix, operand));\n        }\n        moshi (opcode == 19 || opcode == 20) {\n            moshi (operand >= file.global_count) { kaesu \"INVALID_GLOBAL_INDEX\"; }\n            kaku node = analysis.globals[operand];\n            moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n            moshi (types.type_nullable(analysis, node)) { kaesu \"UNSUPPORTED_NULLABLE\"; }\n            kaku kind = types.type_kind(analysis, node);\n            moshi (kind != types.type_integer && kind != types.type_bool && kind != types.type_string_id) { kaesu string.concat(\"UNSUPPORTED_GLOBAL_TYPE \", convert.format_int(kind)); }\n            global_address(code, patches, operand);\n            moshi (opcode == 19) { x86_64.pop_r(code, x86_64.rax); x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rax); }\n            moshi (opcode == 20) { x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 0); x86_64.push_r(code, x86_64.rax); }\n        }\n        moshi (opcode == 22) {\n            kaku node = stack_node(analysis, function_id, offset, 0);\n            moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n            kaku kind = types.type_kind(analysis, node);\n            moshi (types.type_nullable(analysis, node) || (kind != types.type_integer && kind != types.type_bool && kind != types.type_string_id)) {\n                kaesu string.concat(\"UNSUPPORTED_CHANT_TYPE \", convert.format_int(kind));\n            }\n            x86_64.pop_r(code, x86_64.rax);\n            moshi (kind == types.type_integer) { x86_64.call(code, \"rt.print_int\"); }\n            moshi (kind == types.type_bool) { x86_64.call(code, \"rt.print_bool\"); }\n            moshi (kind == types.type_string_id) { x86_64.call(code, \"rt.print_string\"); }\n        }\n        moshi (opcode == 23 || opcode == 24 || opcode == 49) {\n            moshi (function_id < 0) { kaesu \"LOCAL_OUTSIDE_FUNCTION\"; }\n            moshi (operand >= file.functions[function_id].local_count) { kaesu \"INVALID_LOCAL_INDEX\"; }\n            kaku node = analysis.locals[function_id][operand];\n            moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n            moshi (types.type_nullable(analysis, node)) { kaesu \"UNSUPPORTED_NULLABLE\"; }\n            kaku kind = types.type_kind(analysis, node);\n            moshi (kind != types.type_integer && kind != types.type_bool && kind != types.type_string_id) { kaesu string.concat(\"UNSUPPORTED_LOCAL_TYPE \", convert.format_int(kind)); }\n            kaku disp = local_disp(parameters, operand);\n            moshi (opcode == 24) { x86_64.mov_load(code, x86_64.rax, x86_64.rbp, disp); x86_64.push_r(code, x86_64.rax); }\n            moshi (opcode != 24) { x86_64.pop_r(code, x86_64.rax); x86_64.mov_store(code, x86_64.rbp, disp, x86_64.rax); }\n        }\n        moshi (opcode == 25) {\n            moshi (operand >= len(file.functions)) { kaesu \"INVALID_FUNCTION_INDEX\"; }\n            kaku callee = file.functions[operand];\n            kaku argument = 0;\n            aida (argument < callee.parameter_count) {\n                kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, argument), hai);\n                moshi (bad != \"\" && types.type_kind(analysis, stack_node(analysis, function_id, offset, argument)) != types.type_string_id) { kaesu bad; }\n                argument = argument + 1;\n            }\n            x86_64.call(code, function_label(operand));\n            moshi (callee.parameter_count > 0) { x86_64.add_ri(code, x86_64.rsp, 8 * callee.parameter_count); }\n            moshi (callee.returns_value) { x86_64.push_r(code, x86_64.rax); }\n        }\n        moshi (opcode == 26 || opcode == 27) {\n            moshi (function_id < 0) { kaesu \"RETURN_OUTSIDE_FUNCTION\"; }\n            moshi (opcode == 27) { x86_64.pop_r(code, x86_64.rax); }\n            emit_epilogue(code);\n        }\n        offset = offset + step;\n    }\n    x86_64.label(code, block_label(prefix, offset));\n    kaesu \"\";\n}\n\nwaza emit_function(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction, file: mochi.File,\n    analysis: types.TypeAnalysis, index: int64, reachable: bool) -> string {\n    kaku function = file.functions[index];\n    moshi (!reachable) {\n        kaku begin = open_frame(code, function_label(index), 0);\n        x86_64.call(code, \"rt.trap.unreachable\");\n        emit_epilogue(code);\n        close_frame(code, frames, begin, 0);\n        kaesu \"\";\n    }\n    moshi (len(function.captures) != 0) { kaesu string.concat(function.name, \": UNSUPPORTED_CLOSURE\"); }\n    moshi (len(function.instructions) == 0) {\n        moshi (!native_exit(function.name) || function.parameter_count != 1 || function.returns_value) {\n            kaesu string.concat(\"UNSUPPORTED_NATIVE_FUNCTION \", function.name);\n        }\n        kaku begin = open_frame(code, function_label(index), 0);\n        x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, local_disp(1, 0));\n        x86_64.call(code, \"rt.exit\");\n        emit_epilogue(code);\n        close_frame(code, frames, begin, 0);\n        kaesu \"\";\n    }\n    kaku locals = function.local_count - function.parameter_count;\n    moshi (locals < 0) { kaesu \"INVALID_LOCAL_COUNT\"; }\n    kaku cell = 0;\n    aida (cell < len(analysis.cells[index])) {\n        moshi (analysis.cells[index][cell]) { kaesu string.concat(function.name, \": UNSUPPORTED_CAPTURED_LOCAL\"); }\n        cell = cell + 1;\n    }\n    kaku alloc = 8 * locals;\n    kaku begin = open_frame(code, function_label(index), alloc);\n    moshi (locals > 0) {\n        x86_64.mov_ri(code, x86_64.rax, 0);\n        kaku slot = 0;\n        aida (slot < locals) { x86_64.mov_store(code, x86_64.rbp, -8 * (slot + 1), x86_64.rax); slot = slot + 1; }\n    }\n    kaku body = emit_block(code, patches, file, analysis, function.instructions, string.concat(\"f\", convert.format_int(index)), index, function.parameter_count);\n    moshi (body != \"\") { kaesu string.concat(function.name, string.concat(\": \", body)); }\n    emit_epilogue(code);\n    close_frame(code, frames, begin, alloc);\n    kaesu \"\";\n}\n\nkoukai waza compile(file: mochi.File) -> LowerResult {\n    kaku analysis = types.analyze_types(file);\n    kaku code = x86_64.assembler();\n    kaku patches: []pe.Patch = [];\n    kaku frames: []pe.FrameFunction = [];\n    // Entry (PE AddressOfEntryPoint = 0): the loader enters with RSP = 8 mod 16; the program body is a framed function.\n    kaku begin = open_frame(code, \"start\", 0);\n    kaku problem = emit_block(code, patches, file, analysis, file.instructions, \"main\", -1, 0);\n    moshi (problem != \"\") { kaesu failed(string.concat(\"main: \", problem)); }\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.call(code, \"rt.exit\");\n    emit_epilogue(code);\n    close_frame(code, frames, begin, 0);\n    kaku reached = types.reachable_functions(file);\n    kaku index = 0;\n    aida (index < len(file.functions)) {\n        kaku failure = emit_function(code, patches, frames, file, analysis, index, reached[index]);\n        moshi (failure != \"\") { kaesu failed(failure); }\n        index = index + 1;\n    }\n    emit_runtime(code, patches, frames);\n    emit_string_constants(code, file);\n    kaku assembled = x86_64.assemble(code);\n    moshi (assembled.error != \"\") { kaesu failed(assembled.error); }\n    kaku image = pe.executable_framed(pe.ImageSpec { text: assembled.bytes, rdata: [], data: [], zero_fill: 8 * file.global_count, entry: 0,\n        imports: [pe.ImportLibrary { name: \"KERNEL32.dll\", symbols: [\"GetStdHandle\", \"WriteFile\", \"ExitProcess\"] }],\n        patches: patches, unwind: [] }, frames);\n    moshi (image.error != mu) { kaesu failed(\"PE_IMAGE_ERROR\"); }\n    kaesu LowerResult { bytes: image.bytes, error: \"\" };\n}\n" }; }
waza data_38() -> File { kaesu File { path: "kiso/aot/lowerwinrt/gc.mio", version: "Bunko-v2.1.1", length: 25406, sha256: "df04b58a22ff4f2c248f5ae4a84801e4fd5d49a7f5cd5d94fbe2303821b4837c", source: "yobu \"kiso/aot/pe\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// Runtime ABI RA-1 layout profile \"x64-marksweep-v1\" (kiso/runtime/abi, docs/runtime-abi.md): two-word header,\n// sizes rounded to 8-byte granules (so objects are 8-byte aligned), no generations, no large-object space.\nkoukai teisu object_layout_profile = 2;\nkoukai teisu object_header_bytes = 16;\nkoukai teisu object_size_granule = 8;\n\n// Precise, non-moving, stop-the-world mark & sweep collector for the single-threaded Linux backend.\n//\n// Object header: [0] = kind | total_bytes << 8 (kind 0 = free block), [8] = mark word.\n// Roots: Mochi globals (rt.globals_map) and every frame of the rbp chain. The collector runs only at poll\n// points (function entry, loop back-edges); each call/poll site is followed by `jmp over; descriptor; over:`\n// where the descriptor lists the rbp-relative slots of that frame that hold references, so a frame is scanned\n// from its return address alone. No collection happens inside runtime routines, so their temporaries need no roots.\n//\n// Data segment layout (offsets from data_base()):\n//   0 heap_next, 8 heap_end, 16.. NativeFS handle table (64 x 24), 1552.. directory table (64 x 32),\n//   3600.. collector and Win32 state (3704 Winsock started flag), 8192.. directory buffers (64 x 32 KiB), then the Mochi globals.\nwaza gc_state() -> int64 { kaesu data_base() + 3600; }\nkoukai waza directory_buffers() -> int64 { kaesu data_base() + 8192; }\nkoukai waza globals_base() -> int64 { kaesu data_base() + 8192 + 2097152 + 131072; }\n// collector state words: +0 free list head, +8 bytes allocated since the last collection, +16 threshold,\n// +24 heap base, +32 mark stack top, +40 mark stack limit, +48 mark stack base, +56 collections, +64 minimum threshold\nwaza gc_base_register() -> int64 { kaesu x86_64.rcx; }\n\n\n// Free blocks live in segregated lists: one exact-size list per block size 16..512 (bins), and one list for larger\n// blocks (collector state +0). Both are singly linked through word +16 of the free block, pushed at the front.\nwaza bins_base() -> int64 { kaesu data_base() + 4096; }\n\n// rt.alloc: rax = byte size (multiple of 8, at least 16) -> rax = zeroed block. Clobbers rcx, rdx, r8 only.\n// Small requests pop an exact-size bin, or split the first non-empty bin of size >= need + 24; everything else\n// (and every request above 512 bytes) takes the first fitting block of the large list, then falls back to bump allocation.\nwaza emit_gc_alloc(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.alloc\");\n    x86_64.push_r(code, x86_64.r9);\n    x86_64.push_r(code, x86_64.r10);\n    x86_64.mov_ri(code, x86_64.rcx, gc_state());\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 8);\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rcx, 8, x86_64.rdx);\n    x86_64.cmp_ri(code, x86_64.rax, 512);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.alloc.large\");\n    x86_64.mov_ri(code, x86_64.r8, bins_base());\n    x86_64.add_rr(code, x86_64.r8, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.r8, 0);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.bigger\");\n    x86_64.mov_load(code, x86_64.r9, x86_64.rdx, 16);\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.r9);\n    x86_64.jmp(code, \"rt.alloc.zero\");\n    // a bigger bin: its block is split, the remainder (at least 24 bytes) goes back into its own bin\n    x86_64.label(code, \"rt.alloc.bigger\");\n    x86_64.lea(code, x86_64.r10, x86_64.rax, 24);\n    x86_64.label(code, \"rt.alloc.bigger_scan\");\n    x86_64.cmp_ri(code, x86_64.r10, 512);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.alloc.large\");\n    x86_64.mov_ri(code, x86_64.r8, bins_base());\n    x86_64.add_rr(code, x86_64.r8, x86_64.r10);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.r8, 0);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.alloc.bigger_found\");\n    x86_64.add_ri(code, x86_64.r10, 8);\n    x86_64.jmp(code, \"rt.alloc.bigger_scan\");\n    x86_64.label(code, \"rt.alloc.bigger_found\");\n    x86_64.mov_load(code, x86_64.r9, x86_64.rdx, 16);\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.r9);\n    x86_64.sub_rr(code, x86_64.r10, x86_64.rax);\n    x86_64.jmp(code, \"rt.alloc.remainder\");\n    // large list: first block with size == need or size >= need + 24, unlinked; remainder re-inserted\n    x86_64.label(code, \"rt.alloc.large\");\n    x86_64.mov_ri(code, x86_64.rcx, gc_state());\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 0);\n    x86_64.label(code, \"rt.alloc.large_scan\");\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.bump\");\n    x86_64.mov_load(code, x86_64.r10, x86_64.rdx, 0);\n    x86_64.shr_ri(code, x86_64.r10, 8);\n    x86_64.sub_rr(code, x86_64.r10, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.alloc.large_next\");\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.large_take\");\n    x86_64.cmp_ri(code, x86_64.r10, 24);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.alloc.large_next\");\n    x86_64.label(code, \"rt.alloc.large_take\");\n    x86_64.mov_load(code, x86_64.r9, x86_64.rdx, 16);\n    x86_64.cmp_rr(code, x86_64.r8, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.alloc.large_unlink\");\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.r9);\n    x86_64.jmp(code, \"rt.alloc.remainder\");\n    x86_64.label(code, \"rt.alloc.large_unlink\");\n    x86_64.mov_store(code, x86_64.r8, 16, x86_64.r9);\n    x86_64.jmp(code, \"rt.alloc.remainder\");\n    x86_64.label(code, \"rt.alloc.large_next\");\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rdx);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rdx, 16);\n    x86_64.jmp(code, \"rt.alloc.large_scan\");\n    // rdx = the block, r10 = remainder size (0 or >= 24): re-insert the remainder at rdx + need\n    x86_64.label(code, \"rt.alloc.remainder\");\n    x86_64.test_rr(code, x86_64.r10, x86_64.r10);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.alloc.zero\");\n    x86_64.lea(code, x86_64.r9, x86_64.rdx, 0);\n    x86_64.add_rr(code, x86_64.r9, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.r10);\n    x86_64.shl_ri(code, x86_64.rcx, 8);\n    x86_64.mov_store(code, x86_64.r9, 0, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.mov_store(code, x86_64.r9, 8, x86_64.rcx);\n    x86_64.cmp_ri(code, x86_64.r10, 512);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.alloc.remainder_large\");\n    x86_64.mov_ri(code, x86_64.r8, bins_base());\n    x86_64.add_rr(code, x86_64.r8, x86_64.r10);\n    x86_64.jmp(code, \"rt.alloc.remainder_push\");\n    x86_64.label(code, \"rt.alloc.remainder_large\");\n    x86_64.mov_ri(code, x86_64.r8, gc_state());\n    x86_64.label(code, \"rt.alloc.remainder_push\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.r8, 0);\n    x86_64.mov_store(code, x86_64.r9, 16, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.r9);\n    x86_64.label(code, \"rt.alloc.zero\");\n    x86_64.mov_rr(code, x86_64.r9, x86_64.rax);\n    x86_64.shr_ri(code, x86_64.r9, 3);\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.label(code, \"rt.alloc.zero_loop\");\n    x86_64.mov_store(code, x86_64.r8, 0, x86_64.rcx);\n    x86_64.add_ri(code, x86_64.r8, 8);\n    x86_64.sub_ri(code, x86_64.r9, 1);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.alloc.zero_loop\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.pop_r(code, x86_64.r10);\n    x86_64.pop_r(code, x86_64.r9);\n    x86_64.ret(code);\n    // bump allocation from untouched (alread