nged;\n}\n\n// Return-shape hints mirror M15b's branchless literal/local/factory analysis.\n// They decide only provisional stack depths; the full graph validates targets.\nwaza call_hints(file: mochi.File) -> [][]int64 {\n    kaku hints: [][]int64 = []; kaku results: [][]int64 = []; kaku globals: [][]int64 = [];\n    kaku i = 0;\n    aida (i < file.global_count) { kaku empty: []int64 = []; array.push(globals, empty); i = i + 1; }\n    i = -1;\n    aida (i < len(file.functions)) {\n        kaku data = file.instructions; moshi (i >= 0) { data = file.functions[i].instructions; }\n        array.push(hints, array.make[int64](len(data) + 1, -1));\n        moshi (i >= 0) { kaku empty: []int64 = []; array.push(results, empty); }\n        i = i + 1;\n    }\n    kaku pass = 0; kaku changed = hai;\n    aida (changed && pass <= len(file.functions) + 1) {\n        changed = iie; i = -1;\n        aida (i < len(file.functions)) {\n            kaku data = file.instructions; kaku count = 0;\n            moshi (i >= 0) { data = file.functions[i].instructions; count = file.functions[i].local_count; }\n            kaku branchless = hai; kaku at = 0;\n            aida (at < len(data)) { kaku op = int64(data[at]); moshi (op == 17 || op == 18) { branchless = iie; } kaku w = type_instruction_width(op); moshi (w == 0) { branchless = iie; nukeru; } at = at + w; }\n            moshi (!branchless) { i = i + 1; tsuzuku; }\n            kaku locals: [][]int64 = []; kaku stack: [][]int64 = []; kaku j = 0;\n            aida (j < count) { kaku empty: []int64 = []; array.push(locals, empty); j = j + 1; }\n            at = 0;\n            aida (at < len(data)) {\n                kaku op = int64(data[at]); kaku w = type_instruction_width(op); kaku arg = 0; kaku arg2 = 0;\n                moshi (w >= 3) { arg = type_u16(data, at); }\n                moshi (op == 38) { arg2 = type_operand2(data, at); }\n                moshi (op == 54 || op == 55 || op == 57 || op == 58 || op == 65) { arg = int64(data[a