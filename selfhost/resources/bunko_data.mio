rax);\n    dx_jmp(c, \"dx_dirents_next\");\n    x86_64.label(c, \"dx_dirents_done\");\n    x86_64.mov_rr(c, x86_64.rax, x86_64.rbx);\n    x86_64.sub_rr(c, x86_64.rax, x86_64.r12);\n    x86_64.add_ri(c, x86_64.rsp, 4112);\n    dx_jmp(c, \"dx_return\");\n\n    // ---- readlink(path, buf, size): /proc/self/exe -> proc_info(PIDPATHINFO); /proc/self/fd/N -> fcntl(F_GETPATH)\n    x86_64.label(c, \"dx_readlink\");\n    x86_64.mov_rr(c, x86_64.r12, x86_64.rsi);\n    x86_64.mov_rr(c, x86_64.r13, x86_64.rdx);\n    dx_prefix(c, x86_64.rdi, \"/proc/self/\", \"dx_readlink_plain\");\n    x86_64.mov_load8(c, x86_64.rax, x86_64.rdi, 11);\n    x86_64.cmp_ri(c, x86_64.rax, 101);\n    dx_jcc(c, x86_64.cc_e, \"dx_readlink_exe\");\n    dx_prefix(c, x86_64.rdi, \"/proc/self/fd/\", \"dx_readlink_plain\");\n    // fd number: decimal digits from offset 14\n    x86_64.mov_ri(c, x86_64.r14, 0);\n    x86_64.mov_ri(c, x86_64.r15, 14);\n    x86_64.label(c, \"dx_readlink_digit\");\n    x86_64.mov_rr(c, x86_64.rcx, x86_64.rdi);\n    x86_64.add_rr(c, x86_64.rcx, x86_64.r15);\n    x86_64.mov_load8(c, x86_64.rax, x86_64.rcx, 0);\n    x86_64.sub_ri(c, x86_64.rax, 48);\n    x86_64.cmp_ri(c, x86_64.rax, 10);\n    dx_jcc(c, x86_64.cc_ae, \"dx_readlink_digits_done\");\n    x86_64.mov_ri(c, x86_64.rcx, 10);\n    x86_64.imul_rr(c, x86_64.r14, x86_64.rcx);\n    x86_64.add_rr(c, x86_64.r14, x86_64.rax);\n    x86_64.add_ri(c, x86_64.r15, 1);\n    dx_jmp(c, \"dx_readlink_digit\");\n    x86_64.label(c, \"dx_readlink_digits_done\");\n    x86_64.sub_ri(c, x86_64.rsp, 1040);\n    x86_64.mov_rr(c, x86_64.rdi, x86_64.r14);\n    x86_64.mov_ri(c, x86_64.rsi, 50);\n    x86_64.mov_rr(c, x86_64.rdx, x86_64.rsp);\n    x86_64.mov_eax_imm(c, dx_class(92));\n    dx_jmp(c, \"dx_readlink_measure\");\n    x86_64.label(c, \"dx_readlink_exe\");\n    x86_64.sub_ri(c, x86_64.rsp, 1040);\n    x86_64.mov_eax_imm(c, dx_class(20));\n    x86_64.syscall_raw(c);\n    x86_64.mov_rr(c, x86_64.rsi, x86_64.rax);\n    x86_64.mov_ri(c, x86_64.rd