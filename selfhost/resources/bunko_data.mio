waza data_44() -> File { kaesu File { path: "kiso/aot/lowerwinrt/runtime_socket.mio", version: "Bunko-v2.1.1", length: 23357, sha256: "7d7138bbd3120ad537fb7c83af9b8cafde02bf832e9dacc60cf8b64beb3e7d8c", source: "yobu \"kiso/aot/pe\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// The PE writer numbers IAT entries across libraries. Winsock follows KERNEL32.\nteisu import_wsa_startup = 31;\nteisu import_wsa_cleanup = 32;\nteisu import_wsa_error = 33;\nteisu import_wsa_socket = 34;\nteisu import_socket_option = 35;\nteisu import_socket_bind = 36;\nteisu import_socket_connect = 37;\nteisu import_socket_listen = 38;\nteisu import_socket_accept = 39;\nteisu import_socket_recv = 40;\nteisu import_socket_send = 41;\nteisu import_socket_close = 42;\nteisu socket_state = 20; // 20 open, 20 + status failed. File states occupy 1 through 17.\n\nwaza winsock_imports() -> pe.ImportLibrary {\n    kaesu pe.ImportLibrary { name: \"WS2_32.dll\", symbols: [\n        \"WSAStartup\", \"WSACleanup\", \"WSAGetLastError\", \"WSASocketW\", \"setsockopt\",\n        \"bind\", \"connect\", \"listen\", \"accept\", \"recv\", \"send\", \"closesocket\"] };\n}\n\nwaza winsock_started_cell() -> int64 { kaesu gc_state() + 104; }\n\n// Mio's internal calls can enter with either stack alignment. Reserve the Win64 shadow\n// space (and any stack arguments) below the rbp-relative locals.\nwaza socket_frame(code: x86_64.Assembler, name: string, bytes: int64) -> int64 {\n    kaku begin = open_frame(code, name, 0);\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    x86_64.sub_ri(code, x86_64.rsp, bytes);\n    kaesu begin;\n}\n\nwaza socket_status_label(code: int64) -> string {\n    kaesu string.concat(\"rt.sock.message.\", convert.format_int(code));\n}\n\nwaza emit_socket_status(code: x86_64.Assembler) -> unit {\n    kaku messages: []string = [\"\", \"invalid argument\", \"socket closed\", \"connection timed out\",\n        \"connection refused\", \"connection reset\", \"address already in use\", \"permission denied\",\n        \"operation would block\", \"socket error\"];\n    kaku at = 0;\n    aida (at < len(messages)) {\n        emit_string_object(code, socket_status_label(at), messages[at]);\n        at = at + 1;\n    }\n\n    // rt.sock_message: rax = code -> rax = message string\n    x86_64.label(code, \"rt.sock_message\");\n    at = 0;\n    aida (at < 9) {\n        kaku next = string.concat(\"rt.sock_message.next.\", convert.format_int(at));\n        x86_64.cmp_ri(code, x86_64.rax, at);\n        x86_64.jcc(code, x86_64.cc_ne, next);\n        x86_64.lea_label(code, x86_64.rax, socket_status_label(at));\n        x86_64.ret(code);\n        x86_64.label(code, next);\n        at = at + 1;\n    }\n    x86_64.lea_label(code, x86_64.rax, socket_status_label(9));\n    x86_64.ret(code);\n\n    // rt.sock_status_one: rdi = status array (>= 1 byte), rsi = code -> rax = message\n    x86_64.label(code, \"rt.sock_status_one\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 40);\n    x86_64.mov_store8(code, x86_64.rax, 0, x86_64.rsi);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.jmp(code, \"rt.sock_message\");\n\n    // rt.sock_status_io: rdi = status array (10 bytes), rsi = count, rdx = eof, rcx = code -> rax = message\n    x86_64.label(code, \"rt.sock_status_io\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 40);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rsi);\n    x86_64.mov_store8(code, x86_64.rax, 8, x86_64.rdx);\n    x86_64.mov_store8(code, x86_64.rax, 9, x86_64.rcx);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.jmp(code, \"rt.sock_message\");\n\n    // rt.sock_status: rdi = token, rsi = status array -> message\n    x86_64.label(code, \"rt.sock_status\");\n    x86_