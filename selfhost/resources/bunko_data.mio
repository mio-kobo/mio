nt64; fixups: []Fixup; errors: []EncodeError; }\nkoukai kata AssembleResult { words: []uint32; error: EncodeError?; }\n\nkoukai waza assembler() -> Assembler {\n    kaesu Assembler { words: array.with_capacity[uint32](32), labels: array.with_capacity[Label](8), label_index: [array.make[int64](32, 0)], fixups: array.with_capacity[Fixup](8), errors: array.with_capacity[EncodeError](1) };\n}\n\nkoukai waza assembler_emit(value: Assembler, encoded: Instruction) -> EncodeError? {\n    kaku failure = encoded.error;\n    moshi (failure != mu) { array.push(value.errors, failure); kaesu failure; }\n    array.push(value.words, encoded.word);\n    kaesu mu;\n}\n\nwaza label_hash(name: string, capacity: int64) -> int64 {\n    kaku hash = 0; kaku i = 0; kaku data = string.to_bytes(name);\n    aida (i < len(data)) { hash = hash * 131 + int64(data[i]); hash = hash - (hash / capacity) * capacity; i = i + 1; }\n    kaesu hash;\n}\n\nwaza index_label(table: []int64, labels: []Label, index: int64) -> unit {\n    kaku slot = label_hash(labels[index].name, len(table));\n    aida (table[slot] != 0) { slot = slot + 1; moshi (slot == len(table)) { slot = 0; } }\n    table[slot] = index + 1;\n}\n\nwaza find_label(value: Assembler, name: string) -> int64 {\n    kaku table = value.label_index[0]; kaku slot = label_hash(name, len(table)); kaku probes = 0;\n    aida (probes < len(table)) {\n        kaku index = table[slot] - 1; moshi (index < 0) { kaesu -1; }\n        moshi (value.labels[index].name == name) { kaesu value.labels[index].word; }\n        slot = slot + 1; moshi (slot == len(table)) { slot = 0; } probes = probes + 1;\n    }\n    kaesu -1;\n}\n\nkoukai waza assembler_label(value: Assembler, name: string) -> EncodeError? {\n    moshi (find_label(value, name) >= 0) {\n        kaku failure = EncodeError.DuplicateLabel(name); array.push(value.errors, failure); kaesu failure;\n    }\n    kaku table = value.label_index[0];\n    moshi ((len(value.labels) + 1) * 2 >= len(table)) {\n        table = array.make[int64](len(table) * 2, 0); kaku i = 0;\n        aida (i < len(value.labels)) { index_label(table, value.labels, i); i = i + 1; }\n        value.label_index[0] = table;\n    }\n    array.push(value.labels, Label { name: name, word: len(value.words) });\n    index_label(table, value.labels, len(value.labels) - 1);\n    kaesu mu;\n}\n\nwaza assembler_fixup(value: Assembler, target: string, kind: int64, operand: int64) -> EncodeError? {\n    array.push(value.fixups, Fixup { at_word: len(value.words), target: target, kind: kind, operand: operand });\n    array.push(value.words, uint32(0));\n    // Reserve before any later label or AddressPatch captures a word index.\n    // Short branches retain their original encoding followed by NOP. Far\n    // branches use the inverted condition over B, without touching NZCV or GPRs.\n    moshi (kind >= 2 && kind <= 4) { array.push(value.words, uint32(3573751839)); }\n    kaesu mu;\n}\n\nkoukai waza assembler_b(value: Assembler, target: string) -> EncodeError? { kaesu assembler_fixup(value, target, 0, 0); }\nkoukai waza assembler_bl(value: Assembler, target: string) -> EncodeError? { kaesu assembler_fixup(value, target, 1, 0); }\nkoukai waza assembler_b_cond(value: Assembler, condition: int64, target: string) -> EncodeError? {\n    moshi (condition < 0 || condition > 15) { kaku failure = EncodeError.InvalidCondition(); array.push(value.errors, failure); kaesu failure; }\n    kaesu assembler_fixup(value, target, 2, condition);\n}\nkoukai waza assembler_cbz_x(value: Assembler, reg: int64, target: string) -> EncodeError? {\n    kaku failure = register_error(reg); moshi (failure != mu) { array.push(value.errors, failure); kaesu failure; }\n    kaesu assembler_fixup(value, target, 3, reg);\n}\nkoukai waza assembler_cbnz_x(value: Assembler, reg: int64, target: string) -> EncodeError? {\n    kaku failure = register_error(reg); moshi (failure != mu) { array.push(value.errors, failure); kaesu failure; }\n    kaesu assembler