_64.label(code, \"rt.gc_drain.environment\");\n    x86_64.mov_load(code, x86_64.r9, x86_64.r8, 16);\n    x86_64.lea(code, x86_64.rsi, x86_64.r8, 24);\n    x86_64.label(code, \"rt.gc_drain.environment_loop\");\n    x86_64.test_rr(code, x86_64.r9, x86_64.r9);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.gc_drain.next\");\n    mark_word(code, x86_64.rsi, 0);\n    x86_64.add_ri(code, x86_64.rsi, 8);\n    x86_64.sub_ri(code, x86_64.r9, 1);\n    x86_64.jmp(code, \"rt.gc_drain.environment_loop\");\n    x86_64.label(code, \"rt.gc_drain.empty\");\n    x86_64.ret(code);\n}\n\n// rt.gc: called from a poll site. [rsp] is the return address inside the polling function (whose descriptor follows\n// the jmp at that address); rbp is that function's frame pointer.\nwaza emit_gc_collect(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.gc\");\n    x86_64.mov_load(code, x86_64.r11, x86_64.rsp, 0);\n    x86_64.mov_rr(code, x86_64.r10, x86_64.rbp);\n    // roots 1: Mochi globals\n    x86_64.lea_label(code, x86_64.rsi, \"rt.globals_map\");\n    x86_64.mov_load(code, x86_64.r9, x86_64.rsi, 0);\n    x86_64.add_ri(code, x86_64.rsi, 8);\n    x86_64.mov_data(code, x86_64.r8, globals_base());\n    x86_64.label(code, \"rt.gc.globals\");\n    x86_64.test_rr(code, x86_64.r9, x86_64.r9);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.gc.frames\");\n    x86_64.mov_load8(code, x86_64.rax, x86_64.rsi, 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.gc.globals_skip\");\n    x86_64.mov_load(code, x86_64.rdi, x86_64.r8, 0);\n    x86_64.call(code, \"rt.gc_mark\");\n    x86_64.label(code, \"rt.gc.globals_skip\");\n    x86_64.add_ri(code, x86_64.rsi, 1);\n    x86_64.add_ri(code, x86_64.r8, 8);\n    x86_64.sub_ri(code, x86_64.r9, 1);\n    x86_64.jmp(code, \"rt.gc.globals\");\n    // roots 2: the frame chain. r10 = frame pointer, r11 = return address identifying the call site in that frame\n    x86_64.label(code, \"rt.gc.frames\");\n    x86_64.test_rr(code, x86_64.r10, x86_64.r10);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.gc.marked\");\n    x86_64.lea(code, x86_64.rsi, x86_64.r11, 5);\n    x86_64.mov_load(code, x86_64.r9, x86_64.rsi, 0);\n    x86_64.add_ri(code, x86_64.rsi, 8);\n    x86_64.label(code, \"rt.gc.slots\");\n    x86_64.test_rr(code, x86_64.r9, x86_64.r9);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.gc.next_frame\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsi, 0);\n    x86_64.add_rr(code, x86_64.rax, x86_64.r10);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rax, 0);\n    x86_64.call(code, \"rt.gc_mark\");\n    x86_64.add_ri(code, x86_64.rsi, 8);\n    x86_64.sub_ri(code, x86_64.r9, 1);\n    x86_64.jmp(code, \"rt.gc.slots\");\n    x86_64.label(code, \"rt.gc.next_frame\");\n    x86_64.mov_load(code, x86_64.r11, x86_64.r10, 8);\n    x86_64.mov_load(code, x86_64.r10, x86_64.r10, 0);\n    x86_64.jmp(code, \"rt.gc.frames\");\n    x86_64.label(code, \"rt.gc.marked\");\n    x86_64.call(code, \"rt.gc_drain\");\n    emit_gc_sweep(code);\n    x86_64.ret(code);\n}\n\n// Sweep: walk the heap, clear marks, coalesce dead runs into free blocks and rebuild the free list.\nwaza emit_gc_sweep(code: x86_64.Assembler) -> unit {\n    x86_64.mov_data(code, x86_64.rcx, gc_state());\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rax);\n    x86_64.mov_data(code, x86_64.rdx, bins_base());\n    x86_64.mov_ri(code, x86_64.r8, 66);\n    x86_64.label(code, \"rt.gc.clear_bins\");\n    x86_64.mov_store(code, x86_64.rdx, 0, x86_64.rax);\n    x86_64.add_ri(code, x86_64.rdx, 8);\n    x86_64.sub_ri(code, x86_64.r8, 1);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.gc.clear_bins\");\n    x86_64.mov_load(code, x86_64.r8, x86_64.rcx, 24);\n    x86_64.mov_data(code, x86_64.rdx, elf.data_base);\n    x86_64.mov_load(code, x86_64.r9, x86_64.rdx, 0);\n    x86_64.mov_ri(code, x86_64.r11, 0);\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.label(code, \"rt.gc.sweep\");\n    x86_64.cmp_rr(code, x86_64.r8, x86_64.r9);\n    x86_64.jcc(code, x86_64.cc_ae, \"rt.gc.sweep_end\");\n    x86_64.mov_load(code, x86_64.rdi, x86_64.r8, 0);\n    x86_64.shr_ri(code, x86_64.rdi, 8);\n    x86_64.cmp_ri(code, x86_64.rdi, 16);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.trap.memory\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.r8, 8);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.gc.sweep_dead\");\n    x86_64.call(code, \"rt.gc.close_run\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.r8, 8, x86_64.rax);\n    x86_64.add_rr(code, x86_64.rsi, x86_64.rdi);\n    x86_64.add_rr(code, x86_64.r8, x86_64.rdi);\n    x86_64.jmp(code, \"rt.gc.sweep\");\n    x86_64.label(code, \"rt.gc.sweep_dead\");\n    x86_64.test_rr(code, x86_64.r11, x86_64.r11);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.gc.sweep_advance\");\n    x86_64.mov_rr(code, x86_64.r11, x86_64.r8);\n    x86_64.label(code, \"rt.gc.sweep_advance\");\n    x86_64.add_rr(code, x86_64.r8, x86_64.rdi);\n    x86_64.jmp(code, \"rt.gc.sweep\");\n    x86_64.label(code, \"rt.gc.sweep_end\");\n    // a dead run reaching the end of the heap becomes a free block like any other (its memory is not zero)\n    x86_64.call(code, \"rt.gc.close_run\");\n    x86_64.mov_data(code, x86_64.rcx, gc_state());\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rcx, 8, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 56);\n    x86_64.add_ri(code, x86_64.rax, 1);\n    x86_64.mov_store(code, x86_64.rcx, 56, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 64);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_ae, \"rt.gc.threshold\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.label(code, \"rt.gc.threshold\");\n    x86_64.mov_store(code, x86_64.rcx, 16, x86_64.rax);\n    x86_64.jmp(code, \"rt.gc.swept\");\n    // close_run: turn the pending dead run [r11, r8) into a free block (r10 = last link cell)\n    x86_64.label(code, \"rt.gc.close_run\");\n    x86_64.test_rr(code, x86_64.r11, x86_64.r11);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.gc.close_done\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.r8);\n    x86_64.sub_rr(code, x86_64.rax, x86_64.r11);\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.shl_ri(code, x86_64.rdx, 8);\n    x86_64.mov_store(code, x86_64.r11, 0, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_store(code, x86_64.r11, 8, x86_64.rdx);\n    x86_64.cmp_ri(code, x86_64.rax, 24);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.gc.close_reset\");\n    x86_64.cmp_ri(code, x86_64.rax, 512);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.gc.close_large\");\n    x86_64.mov_data(code, x86_64.rdx, bins_base());\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.jmp(code, \"rt.gc.close_push\");\n    x86_64.label(code, \"rt.gc.close_large\");\n    x86_64.mov_data(code, x86_64.rdx, gc_state());\n    x86_64.label(code, \"rt.gc.close_push\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdx, 0);\n    x86_64.mov_store(code, x86_64.r11, 16, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rdx, 0, x86_64.r11);\n    x86_64.label(code, \"rt.gc.close_reset\");\n    x86_64.mov_ri(code, x86_64.r11, 0);\n    x86_64.label(code, \"rt.gc.close_done\");\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.gc.swept\");\n}\n\nwaza emit_gc_runtime(code: x86_64.Assembler) -> unit {\n    emit_gc_init(code);\n    emit_gc_alloc(code);\n    emit_gc_mark(code);\n    emit_gc_drain(code);\n    moshi (mutators_enabled(code)) {\n        emit_collect_mutators(code);\n        emit_mutator_support(code);\n    } sore {\n        emit_gc_collect(code);\n    }\n}\n\n// ---- compile-time side: poll points and frame descriptors ----------------------------------------------------------\n\nwaza emit_signed_word(code: x86_64.Assembler, value: int64) -> unit {\n    moshi (value >= 0) {\n        emit_word(code, value);\n        kaesu;\n    }\n    kaku rest = -(value + 1);\n    kaku at = 0;\n    aida (at < 8) {\n        kaku low = rest - (rest / 256) * 256;\n        x86_64.byte(code, 255 - low);\n        rest = rest / 256;\n        at = at + 1;\n    }\n}\n\n// Frame descriptor after a call/poll site: `jmp over; count; offsets...; over:`.\n// Lists the rbp-relative slots holding references: the locals of the function and its operand stack at `offset`.\nwaza emit_frame_descriptor(code: x86_64.Assembler, file: mochi.File, analysis: types.TypeAnalysis, function_id: int64,\n    offset: int64, parameters: int64) -> string {\n    kaku offsets: []int64 = [];\n    kaku locals = 0;\n    moshi (function_id >= 0) {\n        kaku function = file.functions[function_id];\n        locals = function.local_count - parameters;\n        kaku slot = 0;\n        aida (slot < function.local_count) {\n            kaku captured = slot < len(analysis.cells[function_id]) && analysis.cells[function_id][slot];\n            kaku reference = captured;\n            moshi (!captured) {\n                kaku node = analysis.locals[function_id][slot];\n                moshi (node >= 0 && types.type_kind(analysis, node) == types.type_unknown) { reference = iie; }\n                moshi (node >= 0 && types.type_kind(analysis, node) != types.type_unknown) {\n                    reference = is_reference_node(analysis, node);\n                }\n            }\n            moshi (reference) { array.push(offsets, local_disp(parameters, slot)); }\n            slot = slot + 1;\n        }\n    }\n    kaku entries = analysis.blocks[function_id + 1].entry[offset];\n    kaku index = 0;\n    aida (index < len(entries)) {\n        kaku node = entries[index];\n        moshi (node < 0) { kaesu \"UNSAFE_GC_MISSING_TYPE\"; }\n        kaku kind = types.type_kind(analysis, node);\n        moshi (kind == types.type_unknown) { kaesu string.concat(\"UNSAFE_GC_UNKNOWN_STACK_TYPE at \", convert.format_int(offset)); }\n        moshi (is_reference_node(analysis, node)) { array.push(offsets, -8 * locals - 8 * (index + 1)); }\n        index = index + 1;\n    }\n    kaku over = block_label(\"gc_over\", len(code.bytes));\n    x86_64.jmp(code, over);\n    emit_word(code, len(offsets));\n    kaku at = 0;\n    aida (at < len(offsets)) {\n        emit_signed_word(code, offsets[at]);\n        at = at + 1;\n    }\n    x86_64.label(code, over);\n    kaesu \"\";\n}\n\n// Poll: collect when the allocation volume since the last collection exceeds the threshold.\nwaza emit_poll(code: x86_64.Assembler, file: mochi.File, analysis: types.TypeAnalysis, function_id: int64,\n    offset: int64, parameters: int64) -> string {\n    kaku skip = block_label(\"gc_poll_skip\", len(code.bytes));\n    x86_64.mov_data(code, x86_64.rcx, gc_state());\n    moshi (mutators_enabled(code)) {\n        // another mutator may have requested a stop-the-world: honour it at every poll\n        kaku collect = block_label(\"gc_poll_collect\", len(code.bytes));\n        x86_64.mov_load(code, x86_64.rax, x86_64.rcx, mut_stop);\n        x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n        x86_64.jcc(code, x86_64.cc_ne, collect);\n        x86_64.mov_load(code, x86_64.rax, x86_64.rcx, mut_want);    // not the volume word: every allocation writes that one\n        x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n        x86_64.jcc(code, x86_64.cc_e, skip);\n        x86_64.label(code, collect);\n        x86_64.call(code, \"rt.gc\");\n        kaku threaded = emit_frame_descriptor(code, file, analysis, function_id, offset, parameters);\n        moshi (threaded != \"\") { kaesu threaded; }\n        x86_64.label(code, skip);\n        kaesu \"\";\n    }\n    x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 16);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_b, skip);\n    x86_64.call(code, \"rt.gc\");\n    kaku problem = emit_frame_descriptor(code, file, analysis, function_id, offset, parameters);\n    moshi (problem != \"\") { kaesu problem; }\n    x86_64.label(code, skip);\n    kaesu \"\";\n}\n\n// Globals that hold references: one byte per global after a count word.\nwaza emit_globals_map(code: x86_64.Assembler, file: mochi.File, analysis: types.TypeAnalysis) -> unit {\n    x86_64.label(code, \"rt.globals_map\");\n    emit_word(code, file.global_count);\n    kaku index = 0;\n    aida (index < file.global_count) {\n        kaku flag = 0;\n        moshi (index < len(analysis.globals)) {\n            kaku node = analysis.globals[index];\n            moshi (node >= 0 && types.type_kind(analysis, node) != types.type_unknown && is_reference_node(analysis, node)) { flag = 1; }\n        }\n        x86_64.byte(code, flag);\n        index = index + 1;\n    }\n}\n" }; }
waza data_39() -> File { kaesu File { path: "kiso/aot/lowerlinux/lowerlinux.mio", version: "Bunko-v2.1.1", length: 78399, sha256: "d6869a4e7dcb59d72f47c247b9a7b23ab2490cec81e3d5a630f6c7473b367ba6", source: "yobu \"kiso/aot/cabi\";\nyobu \"kiso/aot/elf\";\nyobu \"kiso/aot/machox64\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// Pure Mio Mochi -> Linux x86-64 ELF64 lowering (scalar subset, first slice).\n//\n// Execution model: the Mochi operand stack is the native stack (rsp). Locals of a\n// function live in its frame (rbp-relative); arguments are pushed by the caller\n// and popped by the caller after the call. Globals are 64-bit slots at the start\n// of the zero-filled RW segment. Anything outside the supported subset is a\n// compile error: nothing is ignored, and there is no VM fallback.\nkoukai kata LowerResult {\n    bytes: []uint8;\n    error: string;\n}\n\nwaza failed(message: string) -> LowerResult { kaesu LowerResult { bytes: [], error: message }; }\n\nwaza block_label(prefix: string, offset: int64) -> string {\n    kaesu string.concat(prefix, string.concat(\".\", convert.format_int(offset)));\n}\nwaza function_label(id: int64) -> string { kaesu string.concat(\"fn.\", convert.format_int(id)); }\nwaza operand_u16(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset + 1]) * 256 + int64(data[offset + 2]);\n}\n\n// 64-bit constant from the serialized high/low halves, as a signed value.\nwaza constant_value(constant: mochi.Constant) -> int64 {\n    kaku high = int64(constant.bits.high);\n    kaku low = int64(constant.bits.low);\n    kaku tag = int64(constant.tag);\n    // Fixed-width constants carry their exact payload: int8/16/32 sign-extend, uint8/16/32 zero-extend.\n    moshi (tag == 5) {\n        moshi (low >= 128) {\n            kaesu low - 256;\n        }\n        kaesu low;\n    }\n    moshi (tag == 6) {\n        moshi (low >= 32768) {\n            kaesu low - 65536;\n        }\n        kaesu low;\n    }\n    moshi (tag == 7) {\n        moshi (low >= 2147483648) {\n            kaesu low - 4294967296;\n        }\n        kaesu low;\n    }\n    moshi (tag >= 8) { kaesu low; }\n    moshi (high >= 2147483648) { high = high - 4294967296; }\n    kaesu high * 4294967296 + low;\n}\n\nwaza push(code: x86_64.Assembler, reg: int64) -> unit { x86_64.push_r(code, reg); }\nwaza pop(code: x86_64.Assembler, reg: int64) -> unit { x86_64.pop_r(code, reg); }\n\n// Slot address of local `index` of a function with `parameters` parameters.\nwaza local_disp(parameters: int64, index: int64) -> int64 {\n    moshi (index < parameters) { kaesu 16 + 8 * (parameters - 1 - index); }\n    kaesu -8 * (index - parameters + 1);\n}\n\nwaza emit_write_literal(code: x86_64.Assembler, label: string, length: int64, fd: int64) -> unit {\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.mov_ri(code, x86_64.rdi, fd);\n    x86_64.lea_label(code, x86_64.rsi, label);\n    x86_64.mov_ri(code, x86_64.rdx, length);\n    x86_64.syscall(code);\n}\n\nwaza emit_exit(code: x86_64.Assembler, status: int64) -> unit {\n    x86_64.mov_ri(code, x86_64.rdi, status);\n    x86_64.mov_eax_imm(code, 231);\n    x86_64.syscall(code);\n}\n\nwaza data_string(code: x86_64.Assembler, label: string, text: string) -> unit {\n    x86_64.label(code, label);\n    kaku bytes = string.to_bytes(text);\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        x86_64.byte(code, int64(bytes[at]));\n        at = at + 1;\n    }\n}\n\n// rt.print_int: value in rax; writes the decimal text and a newline to stdout.\nwaza emit_print_int(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.print_int\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 64);\n    x86_64.mov_ri(code, x86_64.r9, 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ge, \"rt.print_int.positive\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.r9, 1);\n    x86_64.label(code, \"rt.print_int.positive\");\n    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -1);\n    x86_64.mov_ri(code, x86_64.rdx, 10);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.r8, 10);\n    x86_64.label(code, \"rt.print_int.digit\");\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.div_r(code, x86_64.r8);\n    x86_64.add_ri(code, x86_64.rdx, 48);\n    x86_64.sub_ri(code, x86_64.rsi, 1);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.print_int.digit\");\n    x86_64.test_rr(code, x86_64.r9, x86_64.r9);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.print_int.write\");\n    x86_64.mov_ri(code, x86_64.rdx, 45);\n    x86_64.sub_ri(code, x86_64.rsi, 1);\n    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);\n    x86_64.label(code, \"rt.print_int.write\");\n    x86_64.lea(code, x86_64.rdx, x86_64.rbp, 0);\n    x86_64.sub_rr(code, x86_64.rdx, x86_64.rsi);\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.mov_ri(code, x86_64.rdi, 1);\n    x86_64.syscall(code);\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n}\n\n// rt.print_bool: value in rax.\nwaza emit_print_bool(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.print_bool\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.print_bool.false\");\n    emit_write_literal(code, \"rt.text.true\", 4, 1);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.print_bool.false\");\n    emit_write_literal(code, \"rt.text.false\", 4, 1);\n    x86_64.ret(code);\n}\n\n// A trap writes its complete message (length taken from the text itself) to stderr and exits with status 1.\nwaza emit_trap(code: x86_64.Assembler, label: string, text_label: string, text: string) -> unit {\n    x86_64.label(code, label);\n    emit_write_literal(code, text_label, len(string.to_bytes(text)), 2);\n    emit_exit(code, 1);\n    data_string(code, text_label, text);\n}\n\nwaza emit_runtime(code: x86_64.Assembler) -> unit {\n    emit_print_int(code);\n    emit_print_bool(code);\n    emit_gc_runtime(code);\n    emit_string_equal(code);\n    emit_print_string(code);\n    emit_fail_string(code);\n    emit_object_runtime(code);\n    emit_box_runtime(code);\n    emit_fs_runtime(code);\n    emit_map_runtime(code);\n    emit_testing_runtime(code);\n    emit_trap(code, \"rt.trap.nil\", \"rt.text.nil\", \"runtime error: nil reference\\n\");\n    emit_trap(code, \"rt.trap.index\", \"rt.text.index\", \"runtime error: index out of range\\n\");\n    emit_trap(code, \"rt.trap.convert\", \"rt.text.convert\", \"runtime error: integer out of range\\n\");\n    emit_trap(code, \"rt.trap.unreachable\", \"rt.text.unreachable\", \"runtime error: unsupported operation\\n\");\n    emit_trap(code, \"rt.trap.call\", \"rt.text.call\", \"runtime error: invalid call\\n\");\n    x86_64.label(code, \"rt.trap.memory\");\n    emit_write_literal(code, \"rt.text.memory\", 22, 2);\n    emit_exit(code, 1);\n    data_string(code, \"rt.text.newline\", \"\\n\");\n    data_string(code, \"rt.text.nilline\", \"nil\\n\");\n    data_string(code, \"rt.text.memory\", \"runtime error: memory\\n\");\n    x86_64.label(code, \"rt.trap.divide\");\n    emit_write_literal(code, \"rt.text.divide\", 32, 2);\n    emit_exit(code, 1);\n    data_string(code, \"rt.text.true\", \"hai\\n\");\n    data_string(code, \"rt.text.false\", \"iie\\n\");\n    data_string(code, \"rt.text.divide\", \"runtime error: division by zero\\n\");\n}\n\nwaza condition_for(opcode: int64) -> int64 {\n    moshi (opcode == 11) { kaesu x86_64.cc_e; }\n    moshi (opcode == 12) { kaesu x86_64.cc_ne; }\n    moshi (opcode == 13) { kaesu x86_64.cc_l; }\n    moshi (opcode == 14) { kaesu x86_64.cc_le; }\n    moshi (opcode == 15) { kaesu x86_64.cc_g; }\n    kaesu x86_64.cc_ge;\n}\n\n// Data segment: word 0 = heap_next, word 1 = heap_end, 16..1552 = NativeFS handle table, 1552..3600 = directory iteration state, then the Mochi globals.\nwaza global_address(code: x86_64.Assembler, slot: int64) -> unit {\n    x86_64.mov_data(code, x86_64.rcx, globals_base() + slot * 8);\n}\n\n// Object header word: kind in the low byte, total size in bytes above it.\nwaza object_kind_string() -> int64 { kaesu 6; }\n\nwaza emit_word(code: x86_64.Assembler, value: int64) -> unit {\n    kaku rest = value;\n    kaku at = 0;\n    aida (at < 8) {\n        kaku low = rest - (rest / 256) * 256;\n        x86_64.byte(code, low);\n        rest = rest / 256;\n        at = at + 1;\n    }\n}\n\nwaza string_label(index: int64) -> string { kaesu string.concat(\"str.\", convert.format_int(index)); }\n\n// String constants are immutable objects in the code segment: header, gc word, length, bytes.\nwaza emit_string_constants(code: x86_64.Assembler, file: mochi.File) -> unit {\n    kaku index = 0;\n    aida (index < len(file.constants)) {\n        kaku constant = file.constants[index];\n        moshi (int64(constant.tag) == 2) {\n            x86_64.label(code, string_label(index));\n            emit_word(code, object_kind_string() + 256 * (24 + len(constant.data)));\n            emit_word(code, 0);\n            emit_word(code, len(constant.data));\n            kaku at = 0;\n            aida (at < len(constant.data)) {\n                x86_64.byte(code, int64(constant.data[at]));\n                at = at + 1;\n            }\n        }\n        index = index + 1;\n    }\n}\n\n// rt.string_equal: rax, rcx = strings -> rax = 1 when equal.\nwaza emit_string_equal(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.string_equal\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rax, 16);\n    x86_64.mov_load(code, x86_64.r8, x86_64.rcx, 16);\n    x86_64.cmp_rr(code, x86_64.rdx, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.string_equal.no\");\n    x86_64.lea(code, x86_64.rax, x86_64.rax, 24);\n    x86_64.lea(code, x86_64.rcx, x86_64.rcx, 24);\n    x86_64.label(code, \"rt.string_equal.loop\");\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.string_equal.yes\");\n    x86_64.mov_load8(code, x86_64.r8, x86_64.rax, 0);\n    x86_64.mov_load8(code, x86_64.r9, x86_64.rcx, 0);\n    x86_64.cmp_rr(code, x86_64.r8, x86_64.r9);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.string_equal.no\");\n    x86_64.add_ri(code, x86_64.rax, 1);\n    x86_64.add_ri(code, x86_64.rcx, 1);\n    x86_64.sub_ri(code, x86_64.rdx, 1);\n    x86_64.jmp(code, \"rt.string_equal.loop\");\n    x86_64.label(code, \"rt.string_equal.yes\");\n    x86_64.mov_ri(code, x86_64.rax, 1);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.string_equal.no\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.ret(code);\n}\n\n// rt.fail_string: rax = message -> message and a newline on stderr, exit status 1.\nwaza emit_fail_string(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.fail_string\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rax, 16);\n    x86_64.lea(code, x86_64.rsi, x86_64.rax, 24);\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.mov_ri(code, x86_64.rdi, 2);\n    x86_64.syscall(code);\n    emit_write_literal(code, \"rt.text.newline\", 1, 2);\n    emit_exit(code, 1);\n}\n\n// rt.print_string: rax = string -> text and a newline on stdout.\nwaza emit_print_string(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.print_string\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.print_string.text\");\n    emit_write_literal(code, \"rt.text.nilline\", 4, 1);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.print_string.text\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rax, 16);\n    x86_64.lea(code, x86_64.rsi, x86_64.rax, 24);\n    x86_64.mov_eax_imm(code, 1);\n    x86_64.mov_ri(code, x86_64.rdi, 1);\n    x86_64.syscall(code);\n    emit_write_literal(code, \"rt.text.newline\", 1, 1);\n    x86_64.ret(code);\n}\n\n// Emits the instructions of the main program (function_id < 0) or of one function.\nwaza emit_block(code: x86_64.Assembler, file: mochi.File, analysis: types.TypeAnalysis, data: []uint8,\n    prefix: string, function_id: int64, parameters: int64) -> string {\n    kaku offset = 0;\n    aida (offset < len(data)) {\n        x86_64.label(code, block_label(prefix, offset));\n        kaku opcode = int64(data[offset]);\n        moshi (!supported(opcode)) { kaesu string.concat(\"UNSUPPORTED_OPCODE \", convert.format_int(opcode)); }\n        kaku step = types.type_instruction_width(opcode);\n        moshi (step == 0) { kaesu string.concat(\"UNSUPPORTED_OPCODE \", convert.format_int(opcode)); }\n        kaku operand = 0;\n        moshi (step >= 3) { operand = operand_u16(data, offset); }\n        moshi (opcode == 65) { operand = int64(data[offset + 1]); }\n        moshi (opcode == 1) {\n            moshi (operand < 0 || operand >= len(file.constants)) { kaesu \"INVALID_CONSTANT_INDEX\"; }\n            kaku constant = file.constants[operand];\n            moshi (int64(constant.tag) == 2) {\n                x86_64.lea_label(code, x86_64.rax, string_label(operand));\n                push(code, x86_64.rax);\n            }\n            moshi (int64(constant.tag) == 1 || (int64(constant.tag) >= 3 && int64(constant.tag) <= 10)) {\n                x86_64.mov_ri(code, x86_64.rax, constant_value(constant));\n                push(code, x86_64.rax);\n            }\n            moshi (int64(constant.tag) != 1 && int64(constant.tag) != 2 && !(int64(constant.tag) >= 3 && int64(constant.tag) <= 10)) {\n                kaesu string.concat(\"UNSUPPORTED_CONSTANT_TAG \", convert.format_int(int64(constant.tag)));\n            }\n        }\n        moshi (opcode >= 11 && opcode <= 16 && operand_is_string(analysis, function_id, offset)) {\n            moshi (opcode >= 13) { kaesu \"UNSUPPORTED_STRING_ORDERING\"; }\n            kaku raw = block_label(string.concat(prefix, \".sraw\"), offset);\n            kaku finished = block_label(string.concat(prefix, \".sdone\"), offset);\n            pop(code, x86_64.rcx);\n            pop(code, x86_64.rax);\n            x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n            x86_64.jcc(code, x86_64.cc_e, raw);\n            x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n            x86_64.jcc(code, x86_64.cc_e, raw);\n            x86_64.call(code, \"rt.string_equal\");\n            x86_64.jmp(code, finished);\n            x86_64.label(code, raw);\n            x86_64.cmp_rr(code, x86_64.rax, x86_64.rcx);\n            x86_64.setcc_rax(code, x86_64.cc_e);\n            x86_64.label(code, finished);\n            moshi (opcode == 12) {\n                x86_64.mov_ri(code, x86_64.rcx, 1);\n                x86_64.xor_rr(code, x86_64.rax, x86_64.rcx);\n            }\n            push(code, x86_64.rax);\n        }\n        moshi ((opcode == 11 || opcode == 12) && (nilish(analysis, stack_node(analysis, function_id, offset, 0)) || nilish(analysis, stack_node(analysis, function_id, offset, 1))) && !operand_is_string(analysis, function_id, offset)) {\n            // A value that the analysis types as non-nullable can never be nil, whatever bits it holds.\n            kaku left_nil = nilish(analysis, stack_node(analysis, function_id, offset, 1));\n            kaku right_nil = nilish(analysis, stack_node(analysis, function_id, offset, 0));\n            kaku is_nil_case = block_label(string.concat(prefix, \".nnil\"), offset);\n            kaku non_nil_case = block_label(string.concat(prefix, \".nval\"), offset);\n            kaku finished = block_label(string.concat(prefix, \".ndone\"), offset);\n            pop(code, x86_64.rcx);\n            pop(code, x86_64.rax);\n            moshi (left_nil) {\n                x86_64.test_rr(code, x86_64.rax