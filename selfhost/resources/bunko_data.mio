waza data_45() -> File { kaesu File { path: "kiso/aot/lowerlinux/runtime_reactor_darwin.mio", version: "Bunko-v2.1.1", length: 21306, sha256: "1a657e4f6d4a1665e31415db5c9629fe38bd78789865ad69f2b2e102ba19dfb6", source: "yobu \"kiso/aot/x86_64\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// macOS x86-64 reactor (group M): kqueue backend of the mio/sys/socket reactor primitives, emitted instead of the epoll routines when the\n// lowering targets Darwin (the label darwin_abi exists). The routines call kqueue (362) and kevent (363) through the same `syscall`\n// instruction as the rest of the runtime; the Darwin adapter passes both numbers through unchanged (darwinabi.mio) and converts a failed\n// call to the usual negative Linux errno. Same contract as the epoll and AArch64 kqueue backends: level-triggered EVFILT_READ and\n// EVFILT_WRITE with the 64-bit token in udata, a wake-up kqueue registered with the poll kqueue and triggered through EVFILT_USER, EINTR\n// as zero events. struct kevent: ident 0, filter int16 8, flags uint16 10, fflags uint32 12, data 16, udata 24 (32 bytes).\n\n// rt.reactor_change: rdi = kqueue, rsi = ident, rdx = filter (1 read, 2 write), rcx = flags, r8 = udata -> rax = 0 or -errno.\n// Deleting a filter that is not registered (ENOENT) is not an error.\nwaza emit_kqueue_change(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.reactor_change\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 64);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rbp, -48, x86_64.rsi);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.sub_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.mov_ri(code, x86_64.r9, 65535);\n    x86_64.and_rr(code, x86_64.rax, x86_64.r9);\n    x86_64.shl_ri(code, x86_64.rcx, 16);\n    x86_64.or_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rbp, -40, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rbp, -32, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.r8);\n    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -48);\n    x86_64.mov_ri(code, x86_64.rdx, 1);\n    x86_64.mov_ri(code, x86_64.r10, 0);\n    x86_64.mov_ri(code, x86_64.r8, 0);\n    x86_64.mov_ri(code, x86_64.r9, 0);\n    x86_64.mov_eax_imm(code, 363);\n    x86_64.syscall(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ge, \"rt.reactor_change.done\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -8);\n    x86_64.and_ri(code, x86_64.rcx, 2);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.reactor_change.done\");\n    x86_64.cmp_ri(code, x86_64.rax, -2);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.reactor_change.done\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.label(code, \"rt.reactor_change.done\");\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n}\n\nwaza ctl_kqueue_change(code: x86_64.Assembler, filter: int64, subscription: bool) -> unit {\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -32);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -40);\n    x86_64.mov_ri(code, x86_64.rdx, filter);\n    moshi (subscription) { x86_64.mov_load(code, x86_64.r8, x86_64.rbp, -64); }\n    sore { x86_64.mov_ri(code, x86_64.r8, 0); }\n    x86_64.call(code, \"rt.reactor_change\");\n}\n\nkoukai waza emit_reactor_kqueue(code: x86_64.Assembler) -> unit {\n    emit_kqueue_change(code);\n\n    // rt.reactor_open: rdi = kind (0 poll kqueue, 1 wake kqueue; any other kind is invalid) -> token\n    x86_64.label(code, \"rt.reactor_open\");\n    x86_64.cmp_ri(code, x86_64.rdi, 0);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.reactor_open.kqueue\");\n    x86_64.cmp_ri(code, x86_64.rdi, 1);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.reactor_open.kqueue\");\n    x86_64.mov_ri(code, x86_64.rax, -22);\n    x86_64.jmp(code, \"rt.sock_wrap\");\n    x8