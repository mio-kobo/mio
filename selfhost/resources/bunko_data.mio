     moshi (!supported(opcode)) { kaesu string.concat(\"UNSUPPORTED_OPCODE \", convert.format_int(opcode)); }\n        moshi (raw_producer(opcode) && offset + step <= len(data)) {\n            kaku produced = stack_node(analysis, function_id, offset + step, 0);\n            moshi (produced >= 0 && nullable_scalar(analysis, produced)) {\n                pop(code, x86_64.rax);\n                x86_64.call(code, \"rt.box_scalar\");\n                push(code, x86_64.rax);\n            }\n        }\n        offset = offset + step;\n    }\n    x86_64.label(code, block_label(prefix, offset));\n    kaesu \"\";\n}\n\n// Fresh cell in rax (kind 9 holds a scalar, kind 10 a reference). Clobbers rcx, rdx, r8.\nwaza emit_new_cell(code: x86_64.Assembler, reference: bool) -> unit {\n    x86_64.mov_ri(code, x86_64.rax, 24);\n    x86_64.call(code, \"rt.alloc\");\n    kaku kind = 9;\n    moshi (reference) { kind = 10; }\n    x86_64.mov_ri(code, x86_64.rcx, 24 * 256 + kind);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n}\n\n// rax = the cell stored in the frame slot at `disp`, created on first use.\nwaza emit_cell_pointer(code: x86_64.Assembler, disp: int64, reference: bool) -> unit {\n    kaku ready = block_label(\"cell_ready\", len(code.bytes));\n    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, disp);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, ready);\n    emit_new_cell(code, reference);\n    x86_64.mov_store(code, x86_64.rbp, disp, x86_64.rax);\n    x86_64.label(code, ready);\n}\n\n// Closure object (kind 7): [16] target, [24] parameters, [32] returns, [40] environment, [48] code address.\n// Environment (kind 8): [16] count, [24 + 8i] cells of the captured variables.\nwaza emit_closure(code: x86_64.Assembler, file: mochi.File, analysis: types.TypeAnalysis, function_id: int64,\n    parameters: int64, target: int64, captures: bool) -> string {\n    kaku callee = file.functions[target];\n    kaku count = len(callee.captures);\n    moshi (!captures && count != 0) { kaesu \"CAPTURES_WITHOUT_ENVIRONMENT\"; }\n    moshi (count > 0) {\n        x86_64.mov_ri(code, x86_64.rax, 24 + 8 * count);\n        x86_64.call(code, \"rt.alloc\");\n        x86_64.mov_ri(code, x86_64.rcx, (24 + 8 * count) * 256 + 8);\n        x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n        x86_64.mov_ri(code, x86_64.rcx, count);\n        x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);\n        x86_64.push_r(code, x86_64.rax);\n        kaku index = 0;\n        aida (index < count) {\n            kaku capture = callee.captures[index];\n            moshi (capture.local) {\n                moshi (function_id < 0) { kaesu \"CAPTURE_OUTSIDE_FUNCTION\"; }\n                kaku node = analysis.locals[function_id][capture.index];\n                emit_cell_pointer(code, local_disp(parameters, capture.index), is_reference_node(analysis, node));\n            }\n            moshi (!capture.local) {\n                moshi (function_id < 0) { kaesu \"CAPTURE_OUTSIDE_FUNCTION\"; }\n                x86_64.mov_load(code, x86_64.rax, x86_64.rbp, 16 + 8 * parameters);\n                x86_64.mov_load(code, x86_64.rax, x86_64.rax, 40);\n                x86_64.mov_load(code, x86_64.rax, x86_64.rax, 24 + 8 * capture.index);\n            }\n            x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 0);\n            x86_64.mov_store(code, x86_64.rcx, 24 + 8 * index, x86_64.rax);\n            index = index + 1;\n        }\n    }\n    moshi (count == 0) {\n        x86_64.mov_ri(code, x86_64.rax, 0);\n        x86_64.push_r(code, x86_64.rax);\n    }\n    x86_64.mov_ri(code, x86_64.rax, 56);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_ri(code, x86_64.rcx, 56 * 256 + 7);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, target);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, callee.parameter_count);\n    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rcx);\n    kaku returns = 0;\n    moshi (callee.returns_value) { returns = 1; }\n    x86_64.mov_ri(code, x86_64.rcx, returns);\n    x86_64.mov_store(code, x86_64.rax, 32, x86_64.rcx);\n    x86_64.pop_r(code, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rax, 40, x86_64.rcx);\n    x86_64.lea_label(code, x86_64.rcx, function_label(target));\n    x86_64.mov_store(code, x86_64.rax, 48, x86_64.rcx);\n    push(code, x86_64.rax);\n    kaesu \"\";\n}\n\n// 0 = not a float, 1 = float32, 2 = float64 (an unresolved float literal counts as float64).\nwaza float_kind(analysis: types.TypeAnalysis, node: int64) -> int64 {\n    moshi (node < 0) { kaesu 0; }\n    kaku kind = types.type_kind(analysis, node);\n    moshi (kind == types.type_float32) { kaesu 1; }\n    moshi (kind == types.type_float64 || kind == types.type_float_any) { kaesu 2; }\n    kaesu 0;\n}\n\n// Float predicate on the raw bits in rax for width fk (1 float32, 2 float64): primitive 6 is_nan, 7 is_inf,\n// 8 is_finite -> rax = 0/1. Clobbers rcx, rdx, xmm0.\nwaza emit_float_predicate(code: x86_64.Assembler, fk: int64, primitive: int64) -> unit {\n    kaku double = fk == 2;\n    moshi (primitive == 6) {\n        emit_float_load(code, fk, 0, x86_64.rax);\n        x86_64.ucomis(code, double, 0, 0);\n        x86_64.setcc_rax(code, 10);\n    }\n    moshi (primitive == 7 || primitive == 8) {\n        // exponent field all ones: infinity or NaN; infinity has a zero fraction\n        kaku bits = 52;\n        kaku mask = 2047;\n        kaku infinity = 9218868437227405312;\n        moshi (fk == 1) {\n            bits = 23;\n            mask = 255;\n            infinity = 2139095040;\n            x86_64.mov_ri(code, x86_64.rcx, 4294967295);\n            x86_64.and_rr(code, x86_64.rax, x86_64.rcx);\n        }\n        x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n        x86_64.shr_ri(code, x86_64.rcx, bits);\n        x86_64.and_ri(code, x86_64.rcx, mask);\n        x86_64.cmp_ri(code, x86_64.rcx, mask);\n        moshi (primitive == 8) { x86_64.setcc_rax(code, x86_64.cc_ne); }\n        moshi (primitive == 7) {\n            x86_64.setcc_rcx(code, x86_64.cc_e);\n            x86_64.mov_ri(code, x86_64.rdx, infinity);\n            moshi (fk == 1) { x86_64.and_ri(code, x86_64.rax, 2147483647); }\n            moshi (fk == 2) {\n                x86_64.shl_ri(code, x86_64.rax, 1);\n                x86_64.shr_ri(code, x86_64.rax, 1);\n            }\n            x86_64.cmp_rr(code, x86_64.rax, x86_64.rdx);\n            x86_64.setcc_rax(code, x86_64.cc_e);\n            x86_64.and_rr(code, x86_64.rax, x86_64.rcx);\n        }\n    }\n}\n\n// xmm0 <- rax, xmm1 <- rcx for the given float kind (1 or 2).\nwaza emit_float_load(code: x86_64.Assembler, kind: int64, xmm: int64, reg: int64) -> unit {\n    moshi (kind == 2) { x86_64.movq_xmm_r(code, xmm, reg); }\n    moshi (kind == 1) { x86_64.movd_xmm_r(code, xmm, reg); }\n}\nwaza emit_float_store(code: x86_64.Assembler, kind: int64, reg: int64, xmm: int64) -> unit {\n    moshi (kind == 2) { x86_64.movq_r_xmm(code, reg, xmm); }\n    moshi (kind == 1) { x86_64.movd_r_xmm(code, reg, xmm); }\n}\n\n// Nullable scalars (int64?, bool?, float64? ...) are boxed: a pointer to a kind-11 object holding the value at\n// [16], or 0 for nil. Every stack/storage slot whose analysis type is a nullable scalar holds such a box.\nwaza unbox_node(code: x86_64.Assembler, analysis: types.TypeAnalysis, node: int64, reg: int64) -> unit {\n    moshi (node >= 0 && nullable_scalar(analysis, node)) {\n        x86_64.test_rr(code, reg, reg);\n        x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n        x86_64.mov_load(code, reg, reg, 16);\n    }\n}\n\nwaza nilish(analysis: types.TypeAnalysis, node: int64) -> bool {\n    kaesu node >= 0 && (types.type_nullable(analysis, node) || types.type_kind(analysis, node) == types.type_nil);\n}\n\n// Convert the value in rax between the representation of `source` and of `target` (box <-> raw).\n// Clobbers rcx, rdx, r8, r9 when it boxes.\nwaza convert_scalar(code: x86_64.Assembler, analysis: types.TypeAnalysis, source: int64, target: int64) -> unit {\n    moshi (source < 0 || target < 0) { kaesu; }\n    moshi (types.type_kind(analysis, source) == types.type_nil) { kaesu; }\n    kaku source_box = nullable_scalar(analysis, source);\n    kaku target_box = nullable_scalar(analysis, target);\n    moshi (source_box && !target_box) { unbox_node(code, analysis, source, x86_64.rax); }\n    moshi (!source_box && target_box) { x86_64.call(code, \"rt.box_scalar\"); }\n}\n\nwaza nil_equality(analysis: types.TypeAnalysis, function_id: int64, offset: int64, opcode: int64) -> bool {\n    moshi (opcode != 11 && opcode != 12) { kaesu iie; }\n    kaesu (nilish(analysis, stack_node(analysis, function_id, offset, 0)) || nilish(analysis, stack_node(analysis, function_id, offset, 1))) && !operand_is_string(analysis, function_id, offset);\n}\n\n// Element node of the array whose analysis node is `array_node` (-1 when unknown).\nwaza element_node(analysis: types.TypeAnalysis, array_node: int64) -> int64 {\n    moshi (array_node < 0 || types.type_kind(analysis, array_node) != types.type_array_ref) { kaesu -1; }\n    kaesu types.type_array_element(analysis.arena, array_node);\n}\n\nwaza raw_producer(opcode: int64) -> bool {\n    kaesu opcode == 1 || opcode == 8 || opcode == 9 || opcode == 10 || opcode == 34 || opcode == 7 || opcode == 2 ||\n    (opcode >= 4 && opcode <= 6) || (opcode >= 11 && opcode <= 16) || (opcode >= 28 && opcode <= 29) ||\n    (opcode >= 50 && opcode <= 55) || opcode == 32 || opcode == 60;\n}\n\nwaza emit_box_runtime(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.box_scalar\");\n    x86_64.mov_rr(code, x86_64.r9, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 24);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_ri(code, x86_64.rcx, 24 * 256 + 11);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.r9);\n    x86_64.ret(code);\n}\n\nwaza nullable_scalar_descriptor(descriptor: int64) -> bool {\n    kaku kind = descriptor - (descriptor / 128) * 128;\n    kaesu descriptor >= 128 && (kind == 1 || kind == 4 || kind == 2 || kind == 3 || (kind >= 12 && kind <= 17));\n}\n\nwaza supported(opcode: int64) -> bool {\n    kaesu (opcode >= 1 && opcode <= 20) || opcode == 22 || (opcode >= 23 && opcode <= 27) || (opcode >= 30 && opcode <= 40) || opcode == 28 || opcode == 29 || (opcode >= 50 && opcode <= 53) || opcode == 49 || (opcode >= 44 && opcode <= 48) || opcode == 66 || opcode == 67 || (opcode >= 41 && opcode <= 43) || opcode == 54 || opcode == 55 || (opcode >= 56 && opcode <= 65) || opcode == 21;\n}\n\nwaza stack_node(analysis: types.TypeAnalysis, function_id: int64, offset: int64, depth: int64) -> int64 {\n    kaku entries = analysis.blocks[function_id + 1].entry[offset];\n    moshi (depth >= len(entries)) { kaesu -1; }\n    kaesu entries[len(entries) - 1 - depth];\n}\n\nwaza scalar_kind(kind: int64) -> bool {\n    kaesu kind == types.type_integer || kind == types.type_bool || kind == types.type_float32 || kind == types.type_float64 || kind == types.type_float_any;\n}\n\n// Nullable scalars are boxed by the ARM64 backend; this backend does not support them yet.\nwaza nullable_scalar(analysis: types.TypeAnalysis, node: int64) -> bool {\n    kaesu types.type_nullable(analysis, node) && scalar_kind(types.type_kind(analysis, node));\n}\n\nwaza is_reference_node(analysis: types.TypeAnalysis, node: int64) -> bool {\n    kaesu types.type_is_heap_reference(analysis, node);\n}\n\n// Wrap rax to the fixed-width integer type described by `descriptor` (12..17 = int8..uint32 as in the analysis).\nwaza emit_normalize(code: x86_64.Assembler, descriptor: int64) -> unit {\n    moshi (descriptor < 12 || descriptor > 17) { kaesu; }\n    kaku width = 8;\n    moshi (descriptor == 13 || descriptor == 16) { width = 16; }\n    moshi (descriptor == 14 || descriptor == 17) { width = 32; }\n    x86_64.shl_ri(code, x86_64.rax, 64 - width);\n    moshi (descriptor <= 14) { x86_64.sar_ri(code, x86_64.rax, 64 - width); }\n    moshi (descriptor > 14) { x86_64.shr_ri(code, x86_64.rax, 64 - width); }\n}\n\nwaza array_width(descriptor: int64) -> int64 {\n    moshi (descriptor == 15) { kaesu 1; }\n    kaesu 8;\n}\nwaza array_is_reference(descriptor: int64) -> bool {\n    kaku nullable = descriptor >= 128;\n    kaku kind = descriptor - (descriptor / 128) * 128;\n    kaesu nullable || kind == 5 || kind == 7 || kind == 8 || kind == 9 || kind == 10 || kind == 11;\n}\nwaza inferred_descriptor(analysis: types.TypeAnalysis, node: int64) -> int64 {\n    kaku root = node;\n    aida (analysis.arena.parent[root] != root) { root = analysis.arena.parent[root]; }\n    kaku fields = analysis.arena.fields[root];\n    moshi (len(fields) == 0) { kaesu -1; }\n    kaku element = fields[0];\n    kaku kind = types.type_kind(analysis, element);\n    moshi (kind == types.type_unknown) { kaesu -1; }\n    kaku descriptor = 1;\n    moshi (analysis.arena.array_width[root] == 1) { descriptor = 15; }\n    moshi (kind == types.type_string_id) { descriptor = 5; }\n    moshi (kind == types.type_array_ref) { descriptor = 7; }\n    moshi (kind == types.type_struct_ref) { descriptor = 8; }\n    moshi (kind == types.type_enum_ref) { descriptor = 9; }\n    moshi (kind == types.type_map_ref) { descriptor = 10; }\n    moshi (kind == types.type_function_ref) { descriptor = 11; }\n    moshi (types.type_nullable(analysis, element)) { descriptor = descriptor + 128; }\n    kaesu descriptor;\n}\n\n// rdi = length, rsi = capacity are set by the caller; this loads width/reference and calls rt.array_new.\nwaza emit_array_new_call(code: x86_64.Assembler, descriptor: int64) -> unit {\n    x86_64.mov_ri(code, x86_64.rdx, array_width(descriptor));\n    kaku reference = 0;\n    moshi (array_is_reference(descriptor)) { reference = 1; }\n    x86_64.mov_ri(code, x86_64.r8, reference);\n    x86_64.call(code, \"rt.array_new\");\n}\n\n// Allocates a struct (kind 1) or enum (kind 2) with `count` payload words taken from the stack.\nwaza emit_record(code: x86_64.Assembler, analysis: types.TypeAnalysis, function_id: int64, offset: int64,\n    kind: int64, tag: int64, count: int64) -> string {\n    moshi (count > 62) { kaesu \"UNSUPPORTED_LARGE_RECORD\"; }\n    kaku bitmap = 0;\n    kaku power = 1;\n    kaku field = 0;\n    aida (field < count) {\n        kaku node = stack_node(analysis, function_id, offset, count - 1 - field);\n        moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n        moshi (types.type_kind(analysis, node) == types.type_unknown) { kaesu \"UNSUPPORTED_UNKNOWN_FIELD\"; }\n        moshi (is_reference_node(analysis, node)) { bitmap = bitmap + power; }\n        power = power * 2;\n        field = field + 1;\n    }\n    kaku size = 40 + 8 * count;\n    x86_64.mov_ri(code, x86_64.rax, size);\n    x86_64.call(code, \"rt.alloc\");\n    x86_64.mov_ri(code, x86_64.rcx, size * 256 + kind);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, count);\n    x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, bitmap);\n    x86_64.mov_store(code, x86_64.rax, 24, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rcx, tag);\n    x86_64.mov_store(code, x86_64.rax, 32, x86_64.rcx);\n    field = count;\n    aida (field > 0) {\n        field = field - 1;\n        pop(code, x86_64.rcx);\n        x86_64.mov_store(code, x86_64.rax, 40 + 8 * field, x86_64.rcx);\n    }\n    push(code, x86_64.rax);\n    kaesu \"\";\n}\n\n// Dereference a record in rax and load payload word `index` (null checked).\nwaza emit_record_load(code: x86_64.Assembler, index: int64) -> unit {\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 40 + 8 * index);\n}\n\nwaza emit_array_op_check(analysis: types.TypeAnalysis, function_id: int64, offset: int64, depth: int64) -> string {\n    kaku node = stack_node(analysis, function_id, offset, depth);\n    moshi (node < 0) { kaesu \"MISSING_TYPE_INFO\"; }\n    moshi (types.type_kind(analysis, node) != types.type_array_ref) { kaesu \"UNSUPPORTED_ARRAY_OPERAND\"; }\n    kaesu \"\";\n}\n\n// True when the two operands on top of the stack at `offset` are strings.\nwaza operand_is_string(analysis: types.TypeAnalysis, function_id: int64, offset: int64) -> bool {\n    kaku entries = analysis.blocks[function_id + 1].entry[offset];\n    moshi (len(entries) < 2) { kaesu iie; }\n    kaesu types.type_kind(analysis, entries[len(entries) - 1]) == types.type_string_id && types.type_kind(analysis, entries[len(entries) - 2]) == types.type_string_id;\n}\n\nwaza emit_function(code: x86_64.Assembler, file: mochi.File, analysis: types.TypeAnalysis, index: int64, reachable: bool) -> string {\n    kaku function = file.functions[index];\n    x86_64.label(code, function_label(index));\n    moshi (!reachable) {\n        x86_64.call(code, \"rt.trap.unreachable\");\n        kaesu \"\";\n    }\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    moshi (len(function.instructions) == 0 && (types.is_testing_report(function.name) || types.is_testing_packet(function.name))) {\n        moshi (function.parameter_count != 2 || function.returns_value || len(function.captures) != 0) { kaesu \"INVALID_TESTING_REPORT\"; }\n        x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, local_disp(2, 0));\n        unbox_node(code, analysis, analysis.locals[index][0], x86_64.rdi);\n        x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, local_disp(2, 1));\n        x86_64.mov_ri(code, x86_64.rdx, 0);\n        moshi (types.is_testing_packet(function.name)) { x86_64.mov_ri(code, x86_64.rdx, 1); }\n        x86_64.call(code, \"rt.testing_report\");\n        x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n        x86_64.pop_r(code, x86_64.rbp);\n        x86_64.ret(code);\n        kaesu \"\";\n    }\n    moshi (len(function.instructions) == 0 && cabi.is_external(function.name)) {\n        // C 外部函数：只有 compile_with_c 会定义 cabi_sysv 标签；其他构建不会得到 C 调用，也不会回退到 Mio 约定。\n        moshi (!c_bridge_enabled(code)) { kaesu \"UNSUPPORTED_C_ABI_TARGET\"; }\n        kaku declaration = cabi.signature(function.name, function.parameter_count, function.returns_value);\n        kaku bridged = emit_c_bridge(code, declaration, function.parameter_count);\n        moshi (bridged != \"\") { kaesu bridged; }\n        x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n        x86_64.pop_r(code, x86_64.rbp);\n        x86_64.ret(code);\n        kaesu \"\";\n    }\n    moshi (len(function.instructions) == 0) {\n        kaku operation = native_operation(function.name);\n        kaku routine = native_routine(operation);\n        moshi (routine == \"\") { routine = socket_routine(function.name); }\n        moshi (routine == \"\") { routine = \"rt.os_unsupported\"; }\n        moshi (routine != \"rt.os_unsupported\" && function.parameter_count > 6) { kaesu \"UNSUPPORTED_NATIVE_ARITY\"; }\n        kaku registers: []int64 = [x86_64.rdi, x86_64.rsi, x86_64.rdx, x86_64.rcx, x86_64.r8, x86_64.r9];\n        kaku arg = 0;\n        aida (arg < function.parameter_count && routine != \"rt.os_unsupported\") {\n            x86_64.mov_load(code, registers[arg], x86_64.rbp, local_disp(function.parameter_count, arg));\n            arg = arg + 1;\n        }\n        x86_64.call(code, routine);\n        x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n        x86_64.pop_r(code, x86_64.rbp);\n        x86_64.ret(code);\n        kaesu \"\";\n    }\n    kaku locals = function.local_count - function.parameter_count;\n    moshi (locals < 0) { kaesu \"INVALID_LOCAL_COUNT\"; }\n    moshi (locals > 0) {\n        x86_64.mov_ri(code, x86_64.rax, 0);\n        kaku slot = 0;\n        aida (slot < locals) {\n            x86_64.push_r(code, x86_64.rax);\n            slot = slot + 1;\n        }\n    }\n    kaku param = 0;\n    aida (param < function.parameter_count) {\n        moshi (param < len(analysis.cells[index]) && analysis.cells[index][param]) {\n            kaku node = analysis.locals[index][param];\n            emit_new_cell(code, is_reference_node(analysis, node));\n            x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, local_disp(function.parameter_count, param));\n            x86_64.mov_store(code, x86_64.rax, 16, x86_64.rcx);\n            x86_64.mov_store(code, x86_64.rbp, local_disp(function.parameter_count, param), x86_64.rax);\n        }\n        param = param + 1;\n    }\n    kaku entry_poll = emit_poll(code, file, analysis, index, 0, function.parameter_count);\n    moshi (entry_poll != \"\") { kaesu string.concat(function.name, string.concat(\": \", entry_poll)); }\n    kaku body = emit_block(code, file, analysis, function.instructions, string.concat(\"f\", convert.format_int(index)), index, function.parameter_count);\n    moshi (body != \"\") { kaesu string.concat(function.name, string.concat(\": \", body)); }\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n    kaesu \"\";\n}\n\n// First-collection threshold in bytes allocated; the default is 32 MiB. Tests use tiny values to force frequent collections.\nkoukai waza compile(file: mochi.File) -> LowerResult { kaesu compile_with_gc_threshold(file, 33554432); }\n\nkoukai waza compile_with_gc_threshold(file: mochi.File, gc_threshold: int64) -> LowerResult {\n    kaesu compile_target(file, gc_threshold, iie);\n}\n\n// macOS x86-64 target: the same lowering and runtime, every Linux system call routed through the darwin_syscall adapter\n// (darwinabi.mio) and the result packaged as a Mach-O executable (kiso/aot/machox64).\nkoukai waza compile_darwin_amd64(file: mochi.File, gc_threshold: int64) -> LowerResult {\n    kaesu compile_target(file, gc_threshold, hai);\n}\n\n// A program that references the thread natives gets the multi-mutator runtime (mutators.mio); every other program keeps the\n// single-mutator runtime and compiles to exactly the image it always did.\nwaza uses_threads(file: mochi.File) -> bool {\n    kaku index = 0;\n    aida (index < len(file.functions)) {\n        moshi (string.has_prefix(file.functions[index].name, \"$mma::mio/thread/runtime::\")) { kaesu hai; }\n        index = index + 1;\n    }\n    kaesu iie;\n}\n\n// C ABI 模式由标签 cabi_sysv 开启（与 darwin_abi、mutators 相同的标签式开关），因此普通构建的指令序列完全不变。\nwaza cabi_enabled(code: x86_64.Assembler) -> bool { kaesu x86_64.label_offset(code, \"cabi_sysv\") >= 0; }\n// The Mio -> C bridge is also available inside a shared library that declares its C dependencies (label cabi_shared).\nwaza c_bridge_enabled(code: x86_64.Assembler) -> bool { kaesu cabi_enabled(code) || x86_64.label_offset(code, \"cabi_shared\") >= 0; }\n\n// 正常结束：C 模式下必须走 libc 的 exit，才能冲刷 C 的 stdio 缓冲并运行 atexit；普通构建仍直接 exit_group。\n// libc 的 exit 要求调用点 RSP 对齐 16 字节。\nwaza emit_clean_exit(code: x86_64.Assembler) -> unit {\n    moshi (cabi_enabled(code)) {\n        x86_64.mov_ri(code, x86_64.rdi, 0);\n        x86_64.and_ri(code, x86_64.rsp, -16);\n        x86_64.call_external(code, \"exit\");\n        kaesu;\n    }\n    emit_exit(code, 0);\n}\n\nkoukai kata CLowerResult {\n    // 机器码；入口偏移为 0。外部调用的 rel32 为 0，等待系统链接器回填。\n    bytes: []uint8;\n    error: string;\n    externals: []x86_64.ExternalCall;\n    // 需要在固定地址 elf.data_base 提供的零填充 bss 字节数。\n    bss_size: int64;\n}\n\nkoukai waza compile_with_c(file: mochi.File, gc_threshold: int64) -> CLowerResult {\n    kaku parts = compile_parts(file, gc_threshold, iie, hai);\n    kaesu CLowerResult { bytes: parts.code, error: parts.error, externals: parts.externals, bss_size: parts.bss_size };\n}\n\nwaza compile_target(file: mochi.File, gc_threshold: int64, darwin: bool) -> LowerResult {\n    kaku parts = compile_parts(file, gc_threshold, darwin, iie);\n    moshi (parts.error != \"\") { kaesu failed(parts.error); }\n    moshi (darwin) {\n        kaku macho_image = machox64.executable(machox64.ImageSpec { code: parts.code, entry_offset: 0, bss_size: parts.bss_size });\n        moshi (macho_image.error != \"\") { kaesu failed(macho_image.error); }\n        kaesu LowerResult { bytes: macho_image.bytes, error: \"\" };\n    }\n    kaku image = elf.executable(elf.ImageSpec { code: parts.code, entry_offset: 0, bss_size: parts.bss_size });\n    moshi (image.error != \"\") { kaesu failed(image.error); }\n    kaesu LowerResult { bytes: image.bytes, error: \"\" };\n}\n\nkata Parts {\n    code: []uint8;\n    error: string;\n    externals: []x86_64.ExternalCall;\n    bss_size: int64;\n}\n\nwaza failed_parts(message: string) -> Parts { kaesu Parts { code: [], error: message, externals: [], bss_size: 0 }; }\n\nwaza compile_parts(file: mochi.File, gc_threshold: int64, darwin: bool, c_abi: bool) -> Parts {\n    moshi (mochi.has_win64_c(file)) { kaesu failed_parts(\"E_FFI_TARGET Windows AMD64 C ABI requires windows-amd64\"); }\n    moshi (gc_threshold < 4096) { kaesu failed_parts(\"INVALID_GC_THRESHOLD\"); }\n    kaku threads = uses_threads(file);\n    moshi (threads && darwin) { kaesu failed_parts(\"UNSUPPORTED_THREADS_TARGET\"); }\n    // 线程运行时用裸 clone 和 FS 基址 TLS，会破坏 libc 的线程状态，所以 C 调用与 OS 线程不能同时使用。\n    moshi (threads && c_abi) { kaesu failed_parts(\"E_CABI C calls cannot be combined with OS threads on linux-amd64\"); }\n    kaku analysis = types.analyze_types(file);\n    kaku code = x86_64.assembler();\n    moshi (c_abi) {\n        x86_64.label(code, \"cabi_sysv\");\n        // glibc 的 _start 调用 main(argc, argv, envp)：RDI = argc，RSI = argv，argc 就在 argv 前一个字，\n        // 与 Linux 进程入口处期望的 RSP 布局完全一致。和 Darwin x86-64 入口相同，直接把 RSP 放回该处；\n        // 之后程序只通过 libc 的 exit 结束，不会返回 libc 启动代码。argv 16 字节对齐 + 8，所以 RSP 对齐。\n        x86_64.lea(code, x86_64.rsp, x86_64.rsi, -8);\n    }\n    moshi (threads) { x86_64.label(code, \"mutators\"); }\n    // dyld enters at LC_MAIN with main(argc, argv, envp): rsi = argv, and argc sits just below it, exactly where the Linux\n    // entry expects