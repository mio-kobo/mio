waza data_43() -> File { kaesu File { path: "kiso/aot/lowerwinrt/runtime_os.mio", version: "Bunko-v2.1.1", length: 10443, sha256: "3c9de45716569562a0f85aac0adc807c363b0303ce6a026bf912f896b5d45eb1", source: "yobu \"kiso/aot/pe\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/string\";\n\n// Windows implementation of the body-less \"mio/os/runtime\" functions needed to run selfhost/cli's build path.\n// Arguments and environment use the Linux layout: rt.win_args builds, at startup, a block\n//   [argc][argv pointers][0][envp pointers][0] ... strings from +65536   (UTF-8, NUL-terminated)\n// from GetCommandLineW / GetEnvironmentStringsW and stores its address in initial_sp_cell(); the lookup routines below are the\n// Linux ones, unchanged. Process spawning (spawn/exec/spawn_test) and stdin readiness are NOT implemented (explicit\n// \"unsupported operation\"). chmod is a successful no-op: Windows has no POSIX permission bits.\nwaza emit_load_initial_sp(code: x86_64.Assembler, reg: int64) -> unit {\n    x86_64.mov_ri(code, reg, initial_sp_cell());\n    x86_64.mov_load(code, reg, reg, 0);\n}\n\nwaza emit_os_runtime(code: x86_64.Assembler) -> unit {\n    // rt.os_argc -> rax\n    x86_64.label(code, \"rt.os_argc\");\n    emit_load_initial_sp(code, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 0);\n    x86_64.ret(code);\n\n    // rt.os_arg_pointer: rdi = index -> rax = pointer to the NUL-terminated argument, or 0\n    x86_64.label(code, \"rt.os_arg_pointer\");\n    emit_load_initial_sp(code, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 0);\n    x86_64.cmp_rr(code, x86_64.rdi, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ae, \"rt.os_arg_pointer.none\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rdi);\n    x86_64.shl_ri(code, x86_64.rax, 3);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 8);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.os_arg_pointer.none\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.ret(code);\n\n    // rt.os_strlen: rsi = pointer -> rax = length\n    x86_64.label(code, \"rt.os_strlen\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.label(code, \"rt.os_strlen.loop\");\n    x86_64.mov_load8(code, x86_64.rcx, x86_64.rsi, 0);\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.os_strlen.done\");\n    x86_64.add_ri(code, x86_64.rsi, 1);\n    x86_64.add_ri(code, x86_64.rax, 1);\n    x86_64.jmp(code, \"rt.os_strlen.loop\");\n    x86_64.label(code, \"rt.os_strlen.done\");\n    x86_64.ret(code);\n\n    // rt.os_arg_size: rdi = index -> rax = byte length or -1\n    x86_64.label(code, \"rt.os_arg_size\");\n    x86_64.call(code, \"rt.os_arg_pointer\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.os_arg_size.none\");\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.call(code, \"rt.os_strlen\");\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.os_arg_size.none\");\n    x86_64.mov_ri(code, x86_64.rax, -1);\n    x86_64.ret(code);\n\n    // rt.os_arg_copy: rdi = index, rsi = byte array -> rax = length copied, or -1\n    x86_64.label(code, \"rt.os_arg_copy\");\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.call(code, \"rt.os_arg_pointer\");\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.os_arg_size.none\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.push_r(code, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.push_r(code, x86_64.rdi);\n    x86_64.call(code, \"rt.os_strlen\");\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.pop_r(code, x86_64.rsi);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rdi, 16);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_g, \"rt.os_arg_size.none\");\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rdi, 40);\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.rep_movsb(code);\n    x86_64.ret(code);\n\n\n    // chmod: no POSIX modes on Windows\n    x86_64.label(code, \"rt.os_chmod\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.ret(code);\n    emit_os_path_call(code, \"rt.os_remove\", 87);\n    emit_os_path_call(code, \"rt.os_rmdir\", 84);\n    x86_64.label(code, \"rt.os_pid\");\n    x86_64.mov_eax_imm(code, 39);\n    x86_64.call(code, \"rt.syscall\");\n    x86_64.ret(code);\n    // rt.os_monotonic_ms: milliseconds since boot (GetTickCount64 through the shim)\n    x86_64.label(code, \"rt.os_monotonic_ms\");\n    x86_64.mov_eax_imm(code, 228);\n    x86_64.call(code, \"rt.syscall\");\n    x86_64.ret(code);\n    emit_os_environment(code);\n    // rt.os_real_path: rdi = path string, rsi = byte array -> rax = length of the absolute path (forward slashes) or -errno\n    x86_64.label(code, \"rt.os_real_path\");\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    x86_64.sub_ri(code, x86_64.rsp, 16);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rsi);\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.call(code, \"rt.fs_cpath\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.os_real_path.invalid\");\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rcx, 16);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rcx, 40);\n    x86_64.mov_eax_imm(code, 1000);\n    x86_64.call(code, \"rt.syscall\");\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.os_real_path.invalid\");\n    x86_64.mov_ri(code, x86_64.rax, -22);\n    x86_64.mov_rr(code, x86_64.rsp, x86_64.rbp);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n}\n\nwaza emit_os_path_call(code: x86_64.Assembler, name: string, number: int64) -> unit {\n    x86_64.label(code, name);\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.call(code, \"rt.fs_cpath\");\n    x86_64.pop_r(code, x86_64.rsi);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, string.concat(name, \".bad\"));\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rax);\n    x86_64.mov_eax_imm(code, number);\n    x86_64.call(code, \"rt.syscall\");\n    x86_64.ret(code);\n    x86_64.label(code, string.concat(name, \".bad\"));\n    x86_64.mov_ri(code, x86_64.rax, -22);\n    x86_64.ret(code);\n}\n\n// reg = reg - 32 when it holds an ASCII lowercase letter.\nwaza emit_ascii_upper(code: x86_64.Assembler, reg: int64, tag: string) -> unit {\n    x86_64.cmp_ri(code, reg, 97);\n    x86_64.jcc(code, x86_64.cc_b, tag);\n    x86_64.cmp_ri(code, reg, 122);\n    x86_64.jcc(code, x86_64.cc_a, tag);\n    x86_64.sub_ri(code, reg, 32);\n    x86_64.label(code, tag);\n}\n\n// rt.os_find_env: rdi = name string -> rax = pointer to the value (after '='), or 0. ASCII case-insensitive.\nwaza emit_os_environment(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.os_find_env\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    emit_load_initial_sp(code, x86_64.rcx);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 0);\n    x86_64.lea(code, x86_64.rcx, x86_64.rcx, 16);\n    x86_64.shl_ri(code, x86_64.rax, 3);\n    x86_64.add_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.mov_load(code, x86_64.r8, x86_64.rdi, 16);\n    x86_64.lea(code, x86_64.r9, x86_64.rdi, 24);\n    x86_64.label(code, \"rt.os_find_env.next\");\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rcx, 0);\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.os_find_env.none\");\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.label(code, \"rt.os_find_env.compare\");\n    x86_64.cmp_rr(code, x86_64.rdx, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_ae, \"rt.os_find_env.tail\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.mov_load8(code, x86_64.rax, x86_64.rax, 0);\n    x86_64.mov_rr(code, x86_64.r10, x86_64.r9);\n    x86_64.add_rr(code, x86_64.r10, x86_64.rdx);\n    x86_64.mov_load8(code, x86_64.r10, x86_64.r10, 0);\n    // Windows environment names are case-insensitive (GetEnvironmentVariableW): compare with ASCII letters folded,\n    // so os.environment(\"PATH\") finds \"Path\" as it does on Windows itself.\n    emit_ascii_upper(code, x86_64.rax, \"rt.os_find_env.fold_entry\");\n    emit_ascii_upper(code, x86_64.r10, \"rt.os_find_env.fold_name\");\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.r10);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.os_find_env.skip\");\n    x86_64.add_ri(code, x86_64.rdx, 1);\n    x86_64.jmp(code, \"rt.os_find_env.compare\");\n    x86_64.label(code, \"rt.os_find_env.tail\");\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.add_rr(code, x86_64.rax, x86_64.r8);\n    x86_64.mov_load8(code, x86_64.r10, x86_64.rax, 0);\n    x86_64.cmp_ri(code, x86_64.r10, 61);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.os_find_env.skip\");\n    x86_64.add_ri(code, x86_64.rax, 1);\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.os_find_env.skip\");\n    x86_64.add_ri(code, x86_64.rcx, 8);\n    x86_64.jmp(code, \"rt.os_find_env.next\");\n    x86_64.label(code, \"rt.os_find_env.none\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.ret(code);\n    // rt.os_env_size: rdi = name -> rax = value length or -1\n    x86_64.label(code, \"rt.os_env_size\");\n    x86_64.call(code, \"rt.os_find_env\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.os_arg_size.none\");\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.call(code, \"rt.os_strlen\");\n    x86_64.ret(code);\n    // rt