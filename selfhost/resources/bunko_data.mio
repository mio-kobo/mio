081);\n    observation_word(code, 3943236351);\n    arm64.assembler_b_cond(code, 9, \"memory.commit.success\");\n    observation_word(code, 4182078057);\n    observation_word(code, 3943236351);\n    arm64.assembler_b_cond(code, 9, \"memory.commit.charge\");\n    observation_word(code, 4177883767);\n    arm64.assembler_label(code, \"memory.commit.charge\");\n    observation_word(code, 2458386409);\n    // Protect only the newly committed pages [base + committed, base + end): [base, base + committed) is already\n    // read/write (2792, the committed extent, only grows and nothing else changes protection). Re-protecting the whole\n    // prefix on every 16 KiB step made each commit O(heap) in the kernel.\n    emit(code, arm64.ldr_x(10, 19, 2792));\n    emit(code, arm64.add_x(0, 20, 10));\n    emit(code, arm64.and_x(0, 0, 9));\n    observation_word(code, 2333540993);\n    observation_word(code, 3532128234);\n    observation_word(code, 4070572042);\n    observation_word(code, 4072669194);\n    observation_word(code, 4074766346);\n    observation_word(code, 2332688417);\n    observation_word(code, 2315845665);\n    observation_word(code, 3405774881);\n    observation_word(code, 3531604066);\n    observation_word(code, 3531606352);\n    observation_word(code, 3556773889);\n    arm64.assembler_b_cond(code, 2, \"memory.commit.fail\");\n    arm64.assembler_label(code, \"memory.commit.prefix.0\");\n    observation_word(code, 2458386409);\n    // Same for the side-metadata prefix, which mirrors the arena extent.\n    emit(code, arm64.ldr_x(10, 19, 2792));\n    emit(code, arm64.add_x(0, 21, 10));\n    emit(code, arm64.and_x(0, 0, 9));\n    observation_word(code, 2333541025);\n    observation_word(code, 3532128234);\n    observation_word(code, 4070572042);\n    observation_word(code, 4072669194);\n    observation_word(code, 4074766346);\n    observation_word(code, 2332688417);\n    observation_word(code, 2315845665);\n    observation_word(code, 3405774881);\n    observation_word