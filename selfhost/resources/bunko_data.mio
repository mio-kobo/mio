 13, 0)); emit(code, arm64.strb_w(9, 11, 0)); emit(code, arm64.add_imm_x(11, 11, 1, iie)); emit(code, arm64.add_imm_x(13, 13, 1, iie)); emit(code, arm64.sub_imm_x(10, 10, 1, iie)); arm64.assembler_b(code, loop); arm64.assembler_label(code, done);\n    }\n    push_register(code, 12); kaesu hai;\n}\n\nwaza emit_set_index(code: arm64.Assembler, analysis: types.TypeAnalysis, index_node: int64) -> unit {\n    pop_register(code, 9); pop_register(code, 10); pop_register(code, 12);\n    emit_unbox_register(code, analysis, index_node, 10);\n    arm64.assembler_cbz_x(code, 12, \"runtime_error\"); emit(code, arm64.ldr_x(11, 12, 8)); emit(code, arm64.cmp_x(10, 11)); arm64.assembler_b_cond(code, 2, \"runtime_error\");\n    emit(code, arm64.ldr_x(13, 12, 0)); emit(code, arm64.lsr_x(13, 13, 8)); move_bits(code, 14, uint32(0), uint32(255)); emit(code, arm64.and_x(13, 13, 14)); emit(code, arm64.ldr_x(11, 12, 40)); emit(code, arm64.add_imm_x(11, 11, 32, iie));\n    kaku byte = string.concat(\"set_index_byte_\", convert.format_int(len(code.words))); kaku done = string.concat(byte, \"_done\");\n    emit(code, arm64.cmp_imm_x(13, 1, iie)); arm64.assembler_b_cond(code, 0, byte); emit(code, arm64.lsl_x(10, 10, 3)); emit(code, arm64.add_x(11, 11, 10));\n    moshi(old_mark_proto_enabled(code)){kaku scalar=block_label(\"old_array_scalar_\",len(code.words));emit(code,arm64.ldr_x(13,12,40));emit(code,arm64.ldr_x(13,13,24));arm64.assembler_cbz_x(code,13,scalar);emit_old_typed_prewrite(code,11,0);arm64.assembler_label(code,scalar);}\n    emit_old_release_store(code,9,11,0); arm64.assembler_b(code, done);\n    arm64.assembler_label(code, byte); emit(code, arm64.add_x(11, 11, 10)); emit(code, arm64.strb_w(9, 11, 0)); arm64.assembler_label(code, done);\n    emit(code, arm64.ldr_x(11, 12, 40)); emit_gen_remember(code, 11);\n}\n\nwaza is_nullable_scalar(type_result: types.TypeAnalysis, node: int64) -> bool {\n    kaku kind = types.type_kind(type_result, node);\n    kaesu types.type_nullable(type_result, node) &&\n        (kind == types.type_integer || kind == types.type_float32 || kind == types.type_float64 ||\n         kind == types.type_float_any || kind == types.type_bool);\n}\n\nwaza is_raw_producer(opcode: int64) -> bool {\n    kaesu opcode == 1 || opcode == 8 || opcode == 9 || opcode == 10 || opcode == 34 ||\n        opcode == 7 || opcode == 2 || (opcode >= 4 && opcode <= 6) ||\n        (opcode >= 11 && opcode <= 16) || (opcode >= 28 && opcode <= 29) ||\n        (opcode >= 50 && opcode <= 55) || opcode == 32 || opcode == 60;\n}\n\n// Opcodes whose body needs no stopped Epoch in the cooperative thread builds.\n//\n// Why an Epoch-free body is safe: gc_begin returns only after every registered thread that is not blocked has acknowledged the Epoch at a\n// solved poll, and a thread acknowledges only at the poll in front of an opcode. So an opcode body that runs without an Epoch of its own is\n// never concurrent with an Epoch owner (an owner waits for it to finish), with a collection, or with any other Epoch-owning mutation. It can\n// only run concurrently with other Epoch-free bodies, which therefore must not write memory that another thread reads. Allocation\n// (runtime_alloc) enters its own Epoch, so exempting an opcode never exempts an allocation. The argument needs every mutation to be a full\n// stop-the-world Epoch: a protocol with a separate, cheaper heap lock (docs/darwin-thread-heap-exclusion-design.md) must re-audit the array\n// reads (31, 32, 60: length and payload pointer are two words that a push can replace) before keeping them Epoch-free.\n//   scalar slot store (19, 23, 49): a non-nullable integer/float/bool value into a global slot or into a non-captured local. The body is one\n//     plain store into __DATA or this thread's own frame: no heap word, header, remembered set, barrier or boxing is involved, and the shadow\n//     roots published before it are unchanged by it. Reference, nullable (boxing allocates) and captured-cell (heap cell + barrier) targets keep the Epoch.\n//   read-only opcodes (32 len, 34 is-nil, 37 field, 39/40 enum tag/payload, 47 upvalue read, 60 capacity, 31 index): loads only, with checks that\n//     end in runtime_error. They write no heap memory and cannot allocate; an index read whose result would be boxed (nullable scalar element)\n//     keeps the Epoch because the box is allocated.\n//   register-only opcodes (50-53 float/int conversions, 55 integer range conversion): arithmetic on the popped operand and a push, failing through\n//     runtime_error; 66 (type constraint) emits no code at all, it only annotates the stack top for the type analysis.\nwaza heap_step_exempt(code:arm64.Assembler,type_result:types.TypeAnalysis,function_id:int64,offset:int64,opcode:int64,operand:int64,instruction_width:int64) -> bool {\n    kaku node=-1;\n    moshi(opcode==19 && operand>=0 && operand<len(type_result.globals)){node=type_result.globals[operand];}\n    moshi((opcode==23 || (opcode==49 && !old_sweep_enabled(code))) && function_id>=0){\n        moshi(operand>=0 && operand<len(type_result.locals[function_id])){\n            moshi(!type_result.cells[function_id][operand]){node=type_result.locals[function_id][operand];}\n        }\n    }\n    // With the allocation lock: a reference (non-nullable-scalar) value into a non-captured local is one plain store into this thread's own frame\n    // (emit_local): no barrier (the barrier and cell code run only for captured locals), no boxing, no heap word. The value stays reachable from the\n    // published operand/local roots exactly as before, and a collector only scans this frame while the thread stands at a poll.\n    moshi(node>=0 && (opcode==23 || opcode==49) && alloc_lock_enabled(code) && types.type_kind(type_result,node)!=types.type_unknown && !is_nullable_scalar(type_result,node)){kaesu hai;}\n    moshi(node>=0){\n        kaku kind=types.type_kind(type_result,node);\n        moshi(!types.type_nullable(type_result,node) && (kind==types.type_integer || kind==types.type_float32 || kind==types.type_float64 || kind==types.type_bool)){kaesu hai;}\n    }\n    // Allocation-only constructors (30 and 56 array literal, 57 array of n copies, 36 struct literal, 38 enum value) when the allocation lock exists:\n    // their bodies allocate through runtime_alloc, which takes the allocation lock (a fast path that never collects) or, when it cannot, its own\n    // Epoch, and then only initialize the fresh, unpublished object and pop/push this thread's operand stack. No barrier, remembered-set write or\n    // store into a published object occurs (emit_object, emit_array_construct), so they need no Epoch of their own.\n    moshi(alloc_lock_enabled(code) && (opcode==30 || opcode==36 || opcode==38 || opcode==56 || opcode==57)){kaesu hai;}\n    moshi(opcode==32 || opcode==34 || opcode==37 || opcode==39 || opcode==40 || opcode==47 || opcode==60){kaesu hai;}\n    moshi((opcode>=50 && opcode<=53) || opcode==55 || opcode==66){kaesu hai;}\n    moshi(opcode==31){\n        kaku after_read=type_result.blocks[function_id+1].entry[offset+instruction_width];\n        moshi(len(after_read)>0){moshi(!is_nullable_scalar(type_result,after_read[len(after_read)-1])){kaesu hai;}}\n    }\n    kaesu iie;\n}\n\n// Bounded epoch retention (cooperative thread builds, docs/darwin-thread-heap-exclusion-design.md section 8). An epoch entered by one opcode is kept\n// by the following opcodes of the same straight-line run instead of being released by the next poll and entered again. A run ends (the next poll\n// releases the epoch) at a branch target, at any opcode that branches, calls, returns or prints, and after retain_limit opcodes.\nteisu retain_limit = 16;\n// Heap-lock allocation is compiled in (label worker_alloc_lock) for cooperative thread builds that retain epochs, are not collection-stressed and are\n// not old-heap prototype builds; every other image is byte-identical to one built before the feature existed.\nwaza alloc_lock_stress_enabled(code: arm64.Assembler) -> bool { kaesu arm64.assembler_label_word(code, \"worker_alloc_lock_stress\") >= 0; }\nwaza alloc_lock_enabled(code: arm64.Assembler) -> bool { kaesu arm64.assembler_label_word(code, \"worker_alloc_lock\") >= 0; }\nwaza epoch_breaker(opcode: int64) -> bool {\n    kaesu opcode == 17 || opcode == 18 || opcode == 22 || opcode == 25 || opcode == 26 || opcode == 27 || opcode == 45 || opcode == 67;\n}\n// true at every offset that some jump (17, 18) can reach: a run never continues into it.\nwaza jump_targets(data: []uint8) -> []bool {\n    kaku targets: []bool = [];\n    kaku i = 0;\n    aida (i <= len(data)) { array.push(targets, iie); i = i + 1; }\n    kaku at = 0;\n    aida (at < len(data)) {\n        kaku code = int64(data[at]); kaku step = width(code);\n        moshi (step == 0) { kaesu targets; }\n        moshi (code == 17 || code == 18) { kaku target = operand_u16(data, at); moshi (target >= 0 && target <= len(data)) { targets[target] = hai; } }\n        at = at + step;\n    }\n    kaesu targets;\n}\n\nwaza emit_nullable_box(code: arm64.Assembler, patches: []macho.AddressPatch,\n    type_result: types.TypeAnalysis, function_id: int64, after: []int64) -> bool {\n    // The produced raw scalar is never published under its boxed result type.\n    // Retain only the surviving operand prefix, and keep raw bits off-root.\n    kaku live: []int64 = []; kaku i = 0;\n    aida (i + 1 < len(after)) { array.push(live, after[i]); i = i + 1; }\n    pop_register(code, 9); emit(code, arm64.sub_imm_x(31, 31, 16, iie)); emit(code, arm64.str_x(9, 31, 0));\n    kaku shadow_bytes = emit_shadow_push(code, patches, type_result, function_id, live);\n    moshi (shadow_bytes < 0) { kaesu iie; }\n    move_bits(code, 0, uint32(0), uint32(16)); move_bits(code, 1, uint32(0), uint32(106));\n    arm64.assembler_bl(code, \"runtime_alloc\"); emit_shadow_pop(code, shadow_bytes);\n    arm64.assembler_cbz_x(code, 0, \"runtime_oom\");\n    move_bits(code, 10, uint32(0), uint32(7)); emit(code, arm64.str_x(10, 0, 0));\n    emit(code, arm64.ldr_x(9, 31, 0)); emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    emit(code, arm64.str_x(9, 0, 8)); push_register(code, 0); kaesu hai;\n}\n\n// Convert one live operand slot to the physical scalar element ABI.\n// A private entry vector describes every intermediate GC safepoint; analysis\n// entries remain immutable and raw bits are never published as boxed Roots.\nwaza emit_array_operand(code: arm64.Assembler, patches: []macho.AddressPatch,\n    analysis: types.TypeAnalysis, function_id: int64, entries: []int64, index: int64, target: int64) -> bool {\n    kaku source = entries[index]; kaku source_box = is_nullable_scalar(analysis, source); kaku target_box = is_nullable_scalar(analysis, target);\n    moshi (source_box == target_box || types.type_kind(analysis, source) == types.type_nil) { entries[index] = target; kaesu hai; }\n    emit(code, arm64.ldr_x(9, 19, index * 8));\n    moshi (source_box) {\n        emit_unbox_register(code, analysis, source, 9); emit(code, arm64.str_x(9, 19, index * 8)); entries[index] = target; kaesu hai;\n    }\n    push_register(code, 9);\n    kaku after: []int64 = []; kaku at = 0;\n    aida (at < len(entries)) { array.push(after, entries[at]); at = at + 1; }\n    array.push(after, target);\n    moshi (!emit_nullable_box(code, patches, analysis, function_id, after)) { kaesu iie; }\n    pop_register(code, 9); emit(code, arm64.str_x(9, 19, index * 8)); entries[index] = target; kaesu hai;\n}\n\nwaza operand_entries(entries: []int64) -> []int64 {\n    kaku result: []int64 = []; kaku at = 0;\n    aida (at < len(entries)) { array.push(result, entries[at]); at = at + 1; }\n    kaesu result;\n}\n\nwaza file_uses_heap(file: mochi.File) -> bool {\n    kaku block = -1;\n    aida (block < len(file.functions)) {\n        kaku data = file.instructions; moshi (block >= 0) {\n            moshi (nativefs.operation(file.functions[block].name) != nativefs.op_none) { kaesu hai; }\n            data = file.functions[block].instructions;\n        }\n        kaku offset = 0;\n        aida (offset < len(data)) {\n            kaku opcode = int64(data[offset]);\n            moshi (opcode == 65 || opcode == 41 || opcode == 42 || opcode == 43 || opcode == 44 || opcode == 46 || opcode == 36 || opcode == 38 || opcode == 30 || (opcode >= 56 && opcode <= 64)) { kaesu hai; }\n            moshi (opcode == 21 || opcode == 34) { kaesu hai; }\n            kaku size = types.type_instruction_width(opcode); moshi (size == 0) { kaesu iie; }\n            offset = offset + size;\n        }\n        block = block + 1;\n    }\n    kaesu iie;\n}\n\nwaza file_uses_nativefs(file: mochi.File) -> bool {\n    kaku index = 0; aida (index < len(file.functions)) {\n        moshi (nativefs.operation(file.functions[index].name) != nativefs.op_none) { kaesu hai; }\n        index = index + 1;\n    }\n    kaesu iie;\n}\n\nwaza block_label(prefix: string, offset: int64) -> string {\n    kaesu string.concat(prefix, convert.format_int(offset));\n}\n\nwaza function_label(id: int64) -> string {\n    kaesu string.concat(\"fn_\", convert.format_int(id));\n}\n\nwaza function_end_label(id: int64) -> string {\n    kaesu string.concat(\"fn_end_\", convert.format_int(id));\n}\n\nwaza emit(code: arm64.Assembler, value: arm64.Instruction) -> unit {\n    arm64.assembler_emit(code, value);\n}\n\nwaza move_x(code: arm64.Assembler, destination: int64, source: int64) -> unit {\n    emit(code, arm64.orr_x(destination, 31, source));\n}\n\nwaza move_bits(code: arm64.Assembler, destination: int64, high: uint32, low: uint32) -> unit {\n    kaku low_value = int64(low);\n    kaku high_value = int64(high);\n    kaku part0 = low_value - (low_value / 65536) * 65536;\n    kaku part1 = low_value / 65536;\n    kaku part2 = high_value - (high_value / 65536) * 65536;\n    kaku part3 = high_value / 65536;\n    // Shortest MOVZ/MOVN + MOVK sequence: halfwords equal to the background (0 for MOVZ, 0xFFFF for MOVN) are skipped.\n    kaku parts = [part0, part1, part2, part3];\n    kaku zeros = 0; kaku ones = 0; kaku i = 0;\n    aida (i < 4) { moshi (parts[i] == 0) { zeros = zeros + 1; } moshi (parts[i] == 65535) { ones = ones + 1; } i = i + 1; }\n    kaku background = 0; moshi (ones > zeros) { background = 65535; }\n    kaku first = hai; i = 0;\n    aida (i < 4) {\n        moshi (parts[i] != background) {\n            moshi (first) {\n                moshi (background == 0) { emit(code, arm64.movz_x(destination, parts[i], i)); }\n                sore { emit(code, arm64.movn_x(destination, 65535 - parts[i], i)); }\n                first = iie;\n            } sore { emit(code, arm64.movk_x(destination, parts[i], i)); }\n        }\n        i = i + 1;\n    }\n    moshi (first) {\n        moshi (background == 0) { emit(code, arm64.movz_x(destination, 0, 0)); } sore { emit(code, arm64.movn_x(destination, 0, 0)); }\n    }\n}\n\n// x19 is the frame's operand-area base and x20 is its live byte count.\nwaza push_register(code: arm64.Assembler, reg: int64) -> unit {\n    emit(code, arm64.str_x_register(reg, 19, 20));\n    emit(code, arm64.add_imm_x(20, 20, 8, iie));\n}\n\nwaza pop_register(code: arm64.Assembler, reg: int64) -> unit {\n    emit(code, arm64.sub_imm_x(20, 20, 8, iie));\n    emit(code, arm64.ldr_x_register(reg, 19, 20));\n}\n\n// Arithmetic wraps at the source integer width. Operand slots remain eight\n// bytes: signed narrow values are sign extended, unsigned values zero extended.\nwaza emit_integer_normalize(code: arm64.Assembler, analysis: types.TypeAnalysis, node: int64) -> unit {\n    kaku descriptor = types.integer_descriptor(analysis, node);\n    moshi (descriptor < 12 || descriptor > 17) { kaesu; }\n    kaku width = 8;\n    moshi (descriptor == 13 || descriptor == 16) { width = 16; }\n    moshi (descriptor == 14 || descriptor == 17) { width = 32; }\n    emit(code, arm64.lsl_x(9, 9, 64 - width));\n    moshi (descriptor <= 14) { emit(code, arm64.asr_x(9, 9, 64 - width)); }\n    sore { emit(code, arm64.lsr_x(9, 9, 64 - width)); }\n}\n\nwaza emit_binary(code: arm64.Assembler, opcode: int64, analysis: types.TypeAnalysis, entries: []int64) -> unit {\n    pop_register(code, 10);\n    pop_register(code, 9);\n    emit_unbox_register(code, analysis, entries[len(entries) - 2], 9); emit_unbox_register(code, analysis, entries[len(entries) - 1], 10);\n    kaku kind = types.type_kind(analysis, entries[len(entries) - 1]);\n    moshi (kind == types.type_float32 || kind == types.type_float64) { emit_float_binary(code, kind, opcode); push_register(code, 9); kaesu; }\n    moshi (opcode == 2) { emit(code, arm64.add_x(9, 9, 10)); }\n    moshi (opcode == 4) { emit(code, arm64.sub_x(9, 9, 10)); }\n    moshi (opcode == 5) { emit(code, arm64.mul_x(9, 9, 10)); }\n    moshi (opcode == 6) {\n        arm64.assembler_cbz_x(code, 10, \"runtime_error\");\n        emit(code, arm64.sdiv_x(9, 9, 10));\n    }\n    emit_integer_normalize(code, analysis, entries[len(entries) - 1]);\n    push_register(code, 9);\n}\n\nwaza emit_compare(code: arm64.Assembler, opcode: int64, analysis: types.TypeAnalysis, entries: []int64) -> unit {\n    pop_register(code, 10);\n    pop_register(code, 9);\n    kaku kind = types.type_kind(analysis, entries[len(entries) - 1]);\n    kaku done = block_label(\"compare_done_\", len(code.words));\n    kaku left = entries[len(entries) - 2]; kaku right = entries[len(entries) - 1];\n    kaku left_nil = types.type_nullable(analysis, left) || types.type_kind(analysis, left) == types.type_nil;\n    kaku right_nil = types.type_nullable(analysis, right) || types.type_kind(analysis, right) == types.type_nil;\n    moshi ((opcode == 11 || opcode == 12) && (left_nil || right_nil)) {\n        kaku nonnil = string.concat(done, \"_nonnil\"); kaku nilcase = string.concat(done, \"_nil\");\n        moshi (left_nil) { arm64.assembler_cbz_x(code, 9, nilcase); }\n        moshi (right_nil) { arm64.assembler_cbz_x(code, 10, nilcase); }\n        arm64.assembler_b(code, no