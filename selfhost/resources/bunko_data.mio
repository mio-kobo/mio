6) * 16 != 0) { kaesu failed(LowerError.InvalidOperand(1)); }\n    moshi (file.version < 1 || file.version > 16 || file.global_count < 0 || file.global_count > 2048) { kaesu failed(LowerError.InvalidOperand(1)); }\n    kaku malformed = instruction_error(file); moshi (malformed != mu) { kaesu failed(malformed); }\n    kaku specialized = specialize(file);\n    file = specialized.file;\n    kaku type_result = specialized.analysis;\n    moshi (type_result.error_detail != 0) { kaesu failed(LowerError.UnsafeType(type_result.error_detail)); }\n    kaku worker_reachable=types.reachable_functions(file);\n    kaku wi=0;aida(wi<len(worker_bindings)){\n        kaku node=type_result.locals[worker_bindings[wi]][0];kaku kind=types.type_kind(type_result,node);\n        moshi(worker_reachable[worker_bindings[wi]]){\n            kaku returned=type_result.returns[worker_bindings[wi]];\n            // The bridge's native result is a signed machine-word integer.\n            // Object/Nullable/narrow stubs would otherwise forge a managed\n            // pointer or bypass the solved language's numeric representation.\n            moshi(types.type_kind(type_result,returned)!=types.type_integer || types.type_nullable(type_result,returned) || types.integer_descriptor(type_result,returned)>1){kaesu failed(LowerError.InvalidFunction());}\n            moshi(types.type_nullable(type_result,node) || (wi==0 && kind!=types.type_function_ref) || (wi>0 && (kind!=types.type_integer || types.integer_descriptor(type_result,node)>1))){kaesu failed(LowerError.InvalidFunction());}\n        }\n        wi=wi+1;\n    }\n    kaku ids = string_ids(file.constants);\n    kaku code = arm64.assembler();\n    moshi (linux) { arm64.assembler_label(code, \"linux_abi\"); }\n    kaku patches: []macho.AddressPatch = [];\n    array.reserve(patches, file.global_count * 2);\n    kaku native_fs = file_uses_nativefs(file);\n    kaku socket_runtime = iie; kaku si = 0; aida (si < len(file.functions)) { kaku sop = nativefs.oper