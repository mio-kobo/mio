,visitor);tconstant(f,29,1);ir.put(f,ir.add,12,12,29,0);ir.branch(f,ir.jump,0,\"linear_item\");\n    ir.branch(f,ir.label,0,\"structure\");trace_minimum(f,32);trace_kind(f,1);ir.put(f,ir.load,8,1,0,8);ir.put(f,ir.load,29,1,0,16);ir.put(f,ir.equal,29,8,29,0);ir.branch(f,ir.zero,29,\"invalid\");ir.branch(f,ir.jump,0,\"bitmap\");\n    ir.branch(f,ir.label,0,\"enumeration\");trace_minimum(f,32);trace_kind(f,8);ir.put(f,ir.load,8,1,0,16);\n    ir.branch(f,ir.label,0,\"bitmap\");ir.put(f,ir.load,9,1,0,24);tconstant(f,6,32);ir.put(f,ir.subtract,17,4,6,0);tconstant(f,6,8);ir.put(f,ir.divide_unsigned,17,17,6,0);\n    // Subtract first, avoiding overflow of bitmapWords+fieldCount.\n    ir.put(f,ir.less_unsigned,29,17,9,0);ir.branch(f,ir.nonzero,29,\"invalid\");ir.put(f,ir.subtract,17,17,9,0);ir.put(f,ir.less_unsigned,29,17,8,0);ir.branch(f,ir.nonzero,29,\"invalid\");\n    // ceil(count/64), with no count+63 overflow.\n    tconstant(f,6,64);ir.put(f,ir.divide_unsigned,16,8,6,0);ir.put(f,ir.multiply,29,16,6,0);ir.put(f,ir.subtract,29,8,29,0);ir.branch(f,ir.zero,29,\"bitmap_words\");tconstant(f,29,1);ir.put(f,ir.add,16,16,29,0);\n    ir.branch(f,ir.label,0,\"bitmap_words\");ir.put(f,ir.equal,29,16,9,0);ir.branch(f,ir.zero,29,\"invalid\");ir.put(f,ir.address,10,1,0,32);tconstant(f,6,8);ir.put(f,ir.multiply,11,9,6,0);ir.put(f,ir.add,11,10,11,0);tconstant(f,12,0);\n    ir.branch(f,ir.label,0,\"bitmap_item\");ir.put(f,ir.equal,29,12,8,0);ir.branch(f,ir.nonzero,29,\"done\");tconstant(f,6,64);ir.put(f,ir.divide_unsigned,13,12,6,0);ir.put(f,ir.multiply,20,13,6,0);ir.put(f,ir.subtract,20,12,20,0);tconstant(f,6,8);ir.put(f,ir.multiply,13,13,6,0);ir.put(f,ir.add,13,10,13,0);ir.put(f,ir.load,18,13,0,0);tconstant(f,6,2);\n    ir.branch(f,ir.label,0,\"shift\");ir.branch(f,ir.zero,20,\"bit\");ir.put(f,ir.divide_unsigned,18,18,6,0);tconstant(f,29,1);ir.put(f,ir.subtract,20,20,29,0);ir.branch(f,ir.jump,0,\"shift\");\n    ir.branch(f,ir.label,0,\"bit\");ir.put(f,ir.divide_unsigned,29,18,6,0);ir.put(f,ir.multiply,29,29,6,0);ir.put(f,ir.subtract,29,18,29,0);ir.branch(f,ir.zero,29,\"bitmap_next\");tconstant(f,6,8);ir.put(f,ir.multiply,13,12,6,0);ir.put(f,ir.add,13,11,13,0);ir.put(f,ir.acquire_load,14,13,0,0);trace_edge(f,14,visitor);\n    ir.branch(f,ir.label,0,\"bitmap_next\");tconstant(f,29,1);ir.put(f,ir.add,12,12,29,0);ir.branch(f,ir.jump,0,\"bitmap_item\");\n    ir.branch(f,ir.label,0,\"done\");treturn(f,0);\n    ir.branch(f,ir.label,0,\"invalid\");treturn(f,4);\n    ir.branch(f,ir.label,0,\"visitor_failed\");ir.put(f,ir.result,0,15,0,0);kaesu f;\n}\nkoukai waza trace_program() -> []ir.Function {kaesu trace_program_with_visitor(\"\");}\n// Internal neutral visitor calls preserve the Runtime IR imports ABI, without\n// requiring a foreign native callback to carry a hidden import-table register.\nkoukai waza trace_program_with_visitor(visitor:string) -> []ir.Function {kaesu [trace_object_program(visitor)];}\n" }; }
waza data_96() -> File { kaesu File { path: "kiso/runtime/gc/work_queue.mio", version: "Bunko-v2.1.1", length: 7449, sha256: "535558b7b27d2d9a8edb88df72a7357f65f41e889cce3fc54cf27dc3547b0fe9", source: "// Epoch-scoped bounded collector work queue. Neutral IR only. Caller owns\n// ctx(128B), aligned buffer and object lifetimes until every worker joins.\n// Lock0, buffer8, capacity16, head24, tail32, count40, active48, closed56,\n// error64, published72, taken80, completed88, overflow96, optional exact deferred-task count104, epoch112.\n// Results:0 success,1 full/empty,2 lock contention,4 protocol error. No item\n// is silently dropped. A full offer leaves the overwritten reference owned by\n// its caller, which must retry or Abort the entire GC without reclaiming.\nkoukai teisu gc_work_context_bytes=128;\nwaza work_lock_program() -> ir.Function {\n kaku f=ir.function(\"gc_work_lock\");tconstant(f,10,0);tconstant(f,11,1);tconstant(f,12,0);tconstant(f,13,1024);\n ir.branch(f,ir.label,0,\"retry\");array.push(f.steps,ir.Step {kind:ir.compare_exchange,destination:14,left:0,right:11,immediate:0,name:\"\",arguments:[10],order:acq_rel,failure_order:acquire});ir.branch(f,ir.zero,14,\"locked\");ir.put(f,ir.add,12,12,11,0);ir.put(f,ir.less_unsigned,14,12,13,0);ir.branch(f,ir.nonzero,14,\"retry\");treturn(f,2);\n ir.branch(f,ir.label,0,\"locked\");treturn(f,0);kaesu f;\n}\nwaza work_unlock(f:ir.Function) -> unit {tconstant(f,31,0);ir.put(f,ir.release_store,0,0,31,0);}\nwaza work_enter(f:ir.Function) -> unit {\n ir.invoke_function(f,\"gc_work_lock\",5,[0]);ir.branch(f,ir.nonzero,5,\"busy\");\n ir.branch(f,ir.zero,1,\"invalid\");ir.put(f,ir.load,6,0,0,8);ir.branch(f,ir.zero,6,\"invalid\");ir.put(f,ir.load,6,0,0,16);ir.branch(f,ir.zero,6,\"invalid\");\n ir.put(f,ir.load,6,0,0,112);ir.put(f,ir.equal,6,6,1,0);ir.branch(f,ir.zero,6,\"invalid\");ir.put(f,ir.load,6,0,0,64);ir.branch(f,ir.nonzero,6,\"invalid\");\n}\nwaza work_tails(f:ir.Function) -> unit {\n ir.branch(f,ir.label,0,\"invalid\");work_unlock(f);treturn(f,4);ir.branch(f,ir.label,0,\"busy\");treturn(f,2);\n}\nwaza work_increment(f:ir.Function,off:int64) -> unit {ir.put(f,ir.load,28,0,0,off);tconstant(f,29,1);ir.put(f,ir.add,28,28,29,0);ir.put(f,ir.release_store,0,0,28,off);}\nwaza work_configure_program() -> ir.Function {\n // ctx,buffer,capacity,buffer_bytes,epoch. Reuse requires closed+quiet and a\n // strictly newer Epoch. A stale caller cannot access a reconfigured buffer.\n kaku f=ir.function(\"gc_work_configure\");ir.invoke_function(f,\"gc_work_lock\",5,[0]);ir.branch(f,ir.nonzero,5,\"busy\");\n ir.branch(f,ir.zero,1,\"invalid\");ir.branch(f,ir.zero,2,\"invalid\");ir.branch(f,ir.zero,4,\"invalid\");tconstant(f,6,8);ir.put(f,ir.divide_unsigned,7,1,6,0);ir.put(f,ir.multiply,7,7,6,0);ir.put(f,ir.equal,7,7,1,0);ir.branch(f,ir.zero,7,\"invalid\");ir.put(f,ir.divide_unsigned,7,3,6,0);ir.put(f,ir.less_unsigned,7,7,2,0);ir.branch(f,ir.nonzero,7,\"invalid\");\n ir.put(f,ir.add,7,1,3,0);ir.put(f,ir.less_unsigned,7,7,1,0);ir.branch(f,ir.nonzero,7,\"invalid\");ir.put(f,ir.load,6,0,0,112);ir.put(f,ir.less_unsigned,7,6,4,0);ir.branch(f,ir.zero,7,\"invalid\");ir.branch(f,ir.zero,6,\"configure\");\n ir.put(f,ir.load,7,0,0,56);ir.branch(f,ir.zero,7,\"invalid\");ir.put(f,ir.load,7,0,0,40);ir.branch(f,ir.nonzero,7,\"invalid\");ir.put(f,ir.load,7,0,0,48);ir.branch(f,ir.nonzero,7,\"invalid\");\n ir.branch(f,ir.label,0,\"configure\");ir.put(f,ir.store,0,0,1,8);ir.put(f,ir.store,0,0,2,16);ir.put(f,ir.store,0,0,4,112);tconstant(f,6,0);\n kaku off=24;aida(off<=104){ir.put(f,ir.store,0,0,6,off);off=off+8;}work_unlock(f);treturn(f,0);work_tails(f);kaesu f;\n}\nwaza work_offer_program() -> ir.Function {\n // ctx,epoch,non-null exact reference. It never guesses numeric values.\n kaku f=ir.function(\"gc_work_offer\");work_enter(f);ir.branch(f,ir.zero,2,\"invalid\");tconstant(f,6,16);ir.put(f,ir.divide_unsigned,7,2,6,0);ir.put(f,ir.multiply,7,7,6,0);ir.put(f,ir.equal,7,7,2,0);ir.branch(f,ir.zero,7,\"invalid\");ir.put(f,ir.load,6,0,0,56);ir.branch(f,ir.nonzero,6,\"invalid\");ir.put(f,ir.load,7,0,0,40);ir.put(f,ir.load,8,0,0,16);ir.put(f,ir.less_unsigned,6,7,8,0);ir.branch(f,ir.zero,6,\"full\");\n ir.put(f,ir.load,9,0,0,32);ir.put(f,ir.load,10,0,0,8);tconstant(f,11,8);ir.put(f,ir.multiply,11,9,11,0);ir.put(f,ir.add,10,10,11,0);ir.put(f,ir.store,0,10,2,0);\n tconstant(f,11,1);ir.put(f,ir.add,9,9,11,0);ir.put(f,ir.equal,6,9,8,0);ir.branch(f,ir.zero,6,\"tail_ready\");tconstant(f,9,0);ir.branch(f,ir.label,0,\"tail_ready\");ir.put(f,ir.store,0,0,9,32);ir.put(f,ir.add,7,7,11,0);ir.put(f,ir.store,0,0,7,40);work_increment(f,72);work_unlock(f);treturn(f,0);\n ir.branch(f,ir.label,0,\"full\");work_increment(f,96);work_unlock(f);treturn(f,1);work_tails(f);kaesu f;\n}\nwaza work_take_program() -> ir.Function {\n // ctx,epoch,out*. Return status separately from a potential pointer value.\n kaku f=ir.function(\"gc_work_take\");ir.branch(f,ir.zero,2,\"bad_out\");tconstant(f,6,0);ir.put(f,ir.store,0,2,6,0);work_enter(f);ir.put(f,ir.load,7,0,0,40);ir.branch(f,ir.zero,7,\"empty\");ir.put(f,ir.load,8,0,0,16);ir.put(f,ir.load,9,0,0,24);ir.put(f,ir.load,10,0,0,8);tconstant(f,11,8);ir.put(f,ir.multiply,11,9,11,0);ir.put(f,ir.add,10,10,11,0);ir.put(f,ir.load,12,10,0,0);ir.put(f,ir.store,0,2,12,0);tconstant(f,12,0);ir.put(f,ir.store,0,10,12,0);\n tconstant(f,11,1);ir.put(f,ir.add,9,9,11,0);ir.put(f,ir.equal,6,9,8,0);ir.branch(f,ir.zero,6,\"head_ready\");tconstant(f,9,0);ir.branch(f,ir.label,0,\"head_ready\");ir.put(f,ir.store,0,0,9,24);ir.put(f,ir.subtract,7,7,11,0);ir.put(f,ir.store,0,0,7,40);work_increment(f,48);work_increment(f,80);work_unlock(f);treturn(f,0);\n ir.branch(f,ir.label,0,\"empty\");work_unlock(f);treturn(f,1);ir.branch(f,ir.label,0,\"bad_out\");treturn(f,4);work_tails(f);kaesu f;\n}\nwaza work_complete_program() -> ir.Function {\n kaku f=ir.function(\"gc_work_complete\");work_enter(f);ir.put(f,ir.load,7,0,0,48);ir.branch(f,ir.zero,7,\"invalid\");tconstant(f,8,1);ir.put(f,ir.subtract,7,7,8,0);ir.put(f,ir.store,0,0,7,48);work_increment(f,88);work_unlock(f);treturn(f,0);work_tails(f);kaesu f;\n}\nwaza work_close_program() -> ir.Function {\n kaku f=ir.function(\"gc_work_close\");work_enter(f);tconstant(f,6,1);ir.put(f,ir.store,0,0,6,56);work_unlock(f);treturn(f,0);work_tails(f);kaesu f;\n}\nwaza work_quiet_program() -> ir.Function {\n // Quiescence requires closed producer input AND no queued/in-flight work.\n // This queue condition does not replace an all-Mutator Remark handshake.\n kaku f=ir.function(\"gc_work_quiet\");work_enter(f);ir.put(f,ir.load,6,0,0,56);ir.branch(f,ir.zero,6,\"no\");ir.put(f,ir.load,6,0,0,40);ir.branch(f,ir.nonzero,6,\"no\");ir.put(f,ir.load,6,0,0,48);ir.branch(f,ir.nonzero,6,\"no\");ir.put(f,ir.acquire_load,6,0,0,104);ir.branch(f,ir.nonzero,6,\"no\");work_unlock(f);treturn(f,1);\n ir.branch(f,ir.label,0,\"no\");work_unlock(f);treturn(f,0);work_tails(f);kaesu f;\n}\nwaza work_abort_program() -> ir.Function {\n // Abort closes input and preserves the first error. It never frees queued\n // objects/buffers, and quiet cannot be mistaken for permission to reclaim.\n kaku f=ir.function(\"gc_work_abort\");ir.invoke_function(f,\"gc_work_lock\",5,[0]);ir.branch(f,ir.nonzero,5,\"busy\");ir.put(f,ir.load,6,0,0,112);ir.put(f,ir.equal,6,6,1,0);ir.branch(f,ir.zero,6,\"invalid\");ir.branch(f,ir.zero,2,\"invalid\");ir.put(f,ir.load,6,0,0,64);ir.branch(f,ir.nonzero,6,\"closed\");ir.put(f,ir.store,0,0,2,64);\n ir.branch(f,ir.label,0,\"closed\");tconstant(f,6,1);ir.put(f,ir.store,0,0,6,56);work_unlock(f);treturn(f,0);work_tails(f);kaesu f;\n}\nkoukai waza work_queue_program() -> []ir.Function {\n kaesu [work_lock_program(),work_configure_program(),work_offer_program(),work_take_program(),work_complete_program(),work_close_program(),work_quiet_program(),work_abort_program()];\n}\n" }; }
waza data_97() -> File { kaesu File { path: "kiso/runtime/ir/ir.mio", version: "Bunko-v2.1.1", length: 3672, sha256: "762e8cab359873a3a60b7b9d68a79804c5aac90ef3adf08105879e15c3a18aac", source: "yobu \"kiso/array\";\n// Target-neutral scalar runtime IR. Virtual registers hold native words, not\n// managed Mio values. Building a program happens in the compiler; executing it\n// requires no managed allocation. Labels/functions are symbolic, never PCs.\nkoukai teisu constant=1;\nkoukai teisu copy=2;\nkoukai teisu address=3;\nkoukai teisu load=4;\nkoukai teisu store=5;\nkoukai teisu add=6;\nkoukai teisu subtract=7;\nkoukai teisu multiply=8;\nkoukai teisu divide_unsigned=9;\nkoukai teisu equal=10;\nkoukai teisu less_unsigned=11;\nkoukai teisu label=12;\nkoukai teisu jump=13;\nkoukai teisu zero=14;\nkoukai teisu nonzero=15;\nkoukai teisu system=16;\nkoukai teisu invoke=17;\nkoukai teisu function_address=18;\nkoukai teisu result=19;\nkoukai teisu acquire_load=20;\nkoukai teisu release_store=21;\nkoukai teisu fetch_add=22;\nkoukai teisu compare_exchange=23;\nkoukai teisu imports=24;\nkoukai teisu scratch_address=25;\n// Extra portable OS services; 1..22 retain RuntimeOp's original identities.\nkoukai teisu tls_create=23;\nkoukai teisu tls_destroy=24;\nkoukai teisu mutex_create=25;\nkoukai teisu mutex_destroy=26;\nkoukai teisu mutex_lock=27;\nkoukai teisu mutex_unlock=28;\nkoukai teisu condition_create=29;\nkoukai teisu condition_destroy=30;\nkoukai teisu abort_runtime=31;\n// A binding maps abstract operands to a public native ABI. Negative selectors\n// denote literal (-selector-1), e.g. -1 is NULL. Core code never names symbols.\nkoukai kata Binding {operation:int64; slot:int64; arguments:[]int64; result_bits:int64;}\nkoukai kata Step {kind:int64; destination:int64; left:int64; right:int64; immediate:int64;\n    name:string; arguments:[]int64; order:int64; failure_order:int64;}\nkoukai kata Function {name:string; steps:[]Step;}\nkoukai waza function(name:string) -> Function {kaesu Function {name:name,steps:[]};}\nkoukai waza step(kind:int64,destination:int64,left:int64,right:int64,immediate:int64,name:string,arguments:[]int64) -> Step {\n    kaesu Step {kind:kind,destination:destination,left:left,right:right,immediate:immediate,name:name,arguments:arguments,order:0,failure_order:0};\n}\nkoukai waza put(f:Function,kind:int64,destination:int64,left:int64,right:int64,immediate:int64) -> unit {array.push(f.steps,step(kind,destination,left,right,immediate,\"\",[]));}\nkoukai waza branch(f:Function,kind:int64,value:int64,name:string) -> unit {array.push(f.steps,step(kind,0,value,0,0,name,[]));}\nkoukai waza call(f:Function,operation:int64,destination:int64,arguments:[]int64) -> unit {array.push(f.steps,step(system,destination,0,0,operation,\"\",arguments));}\nkoukai waza invoke_function(f:Function,name:string,destination:int64,arguments:[]int64) -> unit {array.push(f.steps,step(invoke,destination,0,0,0,name,arguments));}\nkoukai waza function_pointer(f:Function,name:string,destination:int64) -> unit {array.push(f.steps,step(function_address,destination,0,0,0,name,[]));}\nkoukai waza valid_step(s:Step) -> bool {\n    moshi(s.kind<constant || s.kind>scratch_address || s.destination<0 || s.destination>=32 || s.left<0 || s.left>=32 || s.right<0 || s.right>=32 || len(s.arguments)>7){kaesu iie;}\n    moshi((s.kind==load || s.kind==store || s.kind==acquire_load || s.kind==release_store || s.kind==address) && (s.immediate<0 || s.immediate>32760 || s.immediate-(s.immediate/8)*8!=0)){kaesu iie;}\n    moshi(s.kind==scratch_address && (s.immediate<0 || s.immediate>56 || s.immediate-(s.immediate/8)*8!=0)){kaesu iie;}\n    moshi((s.kind==label || s.kind==jump || s.kind==zero || s.kind==nonzero || s.kind==invoke || s.kind==function_address) && s.name==\"\"){kaesu iie;}\n    kaku i=0;aida(i<len(s.arguments)){moshi(s.arguments[i]<0 || s.arguments[i]>=32){kaesu iie;}i=i+1;}\n    kaesu hai;\n}\n" }; }
waza data_98() -> File { kaesu File { path: "kiso/runtime/os/darwin/link.mio", version: "Bunko-v2.1.1", length: 4027, sha256: "94747d813d2fef697bc27533c011aa70b405682d6ff11587ea36aafc12c64a70", source: "yobu \"kiso/aot/macho\";\nyobu \"kiso/array\";\nyobu \"kiso/string\";\n// Public libSystem ABI bridge. Reuses the established Mach-O writer without\n// changing its static executable format. Replace the two empty symbol-table\n// commands with LC_LOAD_DYLIB and LC_DYLD_INFO_ONLY of identical total size.\n// Each import binds one 8-byte __DATA slot. No C compiler or external linker.\nkoukai kata LinkedImage {bytes:[]uint8; error:string;}\nwaza get32(bytes:[]uint8, at:int64) -> int64 { kaesu int64(bytes[at])+int64(bytes[at+1])*256+int64(bytes[at+2])*65536+int64(bytes[at+3])*16777216; }\nwaza put32(bytes:[]uint8, at:int64, value:int64) -> unit {\n    kaku x=value; kaku i=0; aida(i<4){bytes[at+i]=uint8(x-(x/256)*256);x=x/256;i=i+1;}\n}\nwaza uleb(bytes:[]uint8, value:int64) -> unit {\n    kaku x=value; aida(x>=128){array.push(bytes,uint8(x-(x/128)*128+128));x=x/128;}array.push(bytes,uint8(x));\n}\n// Legacy raw fixtures explicitly reserve the initial data slots.\nkoukai waza executable(spec:macho.ImageSpec, symbols:[]string) -> LinkedImage {\n    moshi(len(symbols)==0 || len(symbols)>spec.globals){kaesu LinkedImage {bytes:[],error:\"invalid import slots\"};}\n    kaesu bind_image(macho.executable(spec),symbols,0);\n}\n// Production placement: append imports AFTER all user and existing private words.\n// Source global capacity and indices are unchanged. Additional runtime words are\n// also appended and never interpreted as managed roots by source type analysis.\nkoukai waza executable_appended(spec:macho.ImageSpec, symbols:[]string, runtime_words:int64) -> LinkedImage {\n    moshi(len(symbols)==0 || len(symbols)>4096 || runtime_words<0 || runtime_words>4096){\n        kaesu LinkedImage {bytes:[],error:\"invalid appended runtime layout\"};\n    }\n    kaesu bind_image(macho.executable_with_runtime_data(spec,len(symbols)+runtime_words),symbols,spec.globals);\n}\nwaza bind_image(base:macho.ImageResult, symbols:[]string, first_word:int64) -> LinkedImage {\n    moshi(base.error!=mu){kaesu LinkedImage {bytes:[],error:\"Mach-O image failure\"};}\n    kaku bytes=base.bytes; kaku at=32; kaku index=0; kaku sym=-1; kaku link=-1;\n    aida(index<get32(bytes,16)){\n        kaku cmd=get32(bytes,at);kaku size=get32(bytes,at+4);\n        moshi(cmd==2){sym=at;}\n        moshi(cmd==25 && bytes[at+10]==uint8(76)){link=at;}\n        at=at+size;index=index+1;\n    }\n    moshi(sym<0 || link<0 || get32(bytes,sym+24)!=11 || get32(bytes,sym+28)!=80){kaesu LinkedImage {bytes:[],error:\"unexpected static commands\"};}\n    // dylib_command + path incl NUL, padded to 56 bytes.\n    index=0;aida(index<104){bytes[sym+index]=uint8(0);index=index+1;}\n    put32(bytes,sym,12);put32(bytes,sym+4,56);put32(bytes,sym+8,24);\n    put32(bytes,sym+16,65536);put32(bytes,sym+20,65536);\n    kaku path=string.to_bytes(\"/usr/lib/libSystem.B.dylib\");index=0;\n    aida(index<len(path)){bytes[sym+24+index]=path[index];index=index+1;}\n    kaku info=sym+56;put32(bytes,info,2147483682);put32(bytes,info+4,48);\n    kaku stream:[]uint8=[];\n    array.push(stream,uint8(17));array.push(stream,uint8(81)); // ordinal 1, pointer\n    index=0;\n    aida(index<len(symbols)){\n        kaku name=string.to_bytes(symbols[index]);\n        moshi(len(name)<2 || name[0]!=uint8(95)){kaesu LinkedImage {bytes:[],error:\"invalid public ABI symbol\"};}\n        kaku ni=0;array.push(stream,uint8(64));\n        aida(ni<len(name)){moshi(name[ni]==uint8(0)){kaesu LinkedImage {bytes:[],error:\"embedded NUL symbol\"};}array.push(stream,name[ni]);ni=ni+1;}\n        array.push(stream,uint8(0));array.push(stream,uint8(114));uleb(stream,(first_word+index)*8); // DATA segment 2\n        array.push(stream,uint8(144));index=index+1;\n    }\n    array.push(stream,uint8(0));\n    kaku offset=len(bytes);put32(bytes,info+16,offset);put32(bytes,info+20,len(stream));\n    array.append_all(bytes,stream);aida(len(bytes)-(len(bytes)/16)*16!=0){array.push(bytes,uint8(0));}\n    put32(bytes,link+32,((len(bytes)-offset+16383)/16384)*16384);put32(bytes,link+48,len(bytes)-offset);\n    kaesu LinkedImage {bytes:bytes,error:\"\"};\n}\n" }; }
waza data_99() -> File { kaesu File { path: "kiso/runtime/os/darwin/operations.mio", version: "Bunko-v2.1.1", length: 3916, sha256: "ddc1e4582638c5e109647b7bcbe5e5262a865969b647dc370b9c0251b802730e", source: "yobu \"kiso/runtime/ir\";\nyobu \"kiso/array\";\n// Public ABI mapping data only. CPU code generation is a separate consumer.\n// 100/101 are adapter-private raw wait/clock calls; portable core calls the\n// platform_wait/platform_now functions whose units/results are target-neutral.\nkoukai waza thread_bindings() -> []ir.Binding {\n    kaesu [\n        ir.Binding {operation:6,slot:0,arguments:[0,-1,1,2],result_bits:32},\n        ir.Binding {operation:7,slot:1,arguments:[0,1],result_bits:32},\n        ir.Binding {operation:8,slot:2,arguments:[],result_bits:64},\n        ir.Binding {operation:9,slot:5,arguments:[0],result_bits:64},\n        ir.Binding {operation:10,slot:4,arguments:[0,1],result_bits:32},\n        ir.Binding {operation:12,slot:14,arguments:[0],result_bits:32},\n        ir.Binding {operation:23,slot:3,arguments:[0,-1],result_bits:32},\n        ir.Binding {operation:24,slot:6,arguments:[0],result_bits:32},\n        ir.Binding {operation:25,slot:9,arguments:[0,-1],result_bits:32},\n        ir.Binding {operation:26,slot:16,arguments:[0],result_bits:32},\n        ir.Binding {operation:27,slot:10,arguments:[0],result_bits:32},\n        ir.Binding {operation:28,slot:11,arguments:[0],result_bits:32},\n        ir.Binding {operation:29,slot:12,arguments:[0,-1],result_bits:32},\n        ir.Binding {operation:30,slot:15,arguments:[0],result_bits:32},\n        ir.Binding {operation:31,slot:7,arguments:[0],result_bits:64},\n        ir.Binding {operation:100,slot:13,arguments:[0,1,2],result_bits:32},\n        ir.Binding {operation:101,slot:17,arguments:[-7,0],result_bits:32},\n        ir.Binding {operation:102,slot:7,arguments:[0],result_bits:64},\n        ir.Binding {operation:103,slot:8,arguments:[-2,0,1],result_bits:64},\n        ir.Binding {operation:104,slot:19,arguments:[0],result_bits:32},\n        ir.Binding {operation:105,slot:20,arguments:[0],result_bits:32}\n    ];\n}\nkoukai waza thread_platform_program() -> []ir.Function {\n    kaku wait=ir.function(\"platform_wait\");\n    ir.put(wait,ir.scratch_address,3,0,0,0);ir.put(wait,ir.constant,4,0,0,1000000000);\n    ir.put(wait,ir.divide_unsigned,5,2,4,0);ir.put(wait,ir.multiply,6,5,4,0);ir.put(wait,ir.subtract,6,2,6,0);\n    ir.put(wait,ir.store,0,3,5,0);ir.put(wait,ir.store,0,3,6,8);\n    ir.call(wait,100,4,[0,1,3]);ir.branch(wait,ir.zero,4,\"return\");\n    // Darwin ETIMEDOUT=60 is confined to this adapter. Generic wait result is\n    // zero for wake, one for timeout, negative native errno for other errors.\n    ir.put(wait,ir.constant,5,0,0,60);ir.put(wait,ir.equal,5,4,5,0);ir.branch(wait,ir.zero,5,\"error\");ir.put(wait,ir.constant,4,0,0,1);ir.branch(wait,ir.jump,0,\"return\");\n    ir.branch(wait,ir.label,0,\"error\");ir.put(wait,ir.constant,5,0,0,0);ir.put(wait,ir.subtract,4,5,4,0);\n    ir.branch(wait,ir.label,0,\"return\");ir.put(wait,ir.result,0,4,0,0);\n    kaku clock=ir.function(\"platform_now\");ir.put(clock,ir.scratch_address,1,0,0,0);ir.call(clock,101,2,[1]);ir.branch(clock,ir.nonzero,2,\"error\");\n    ir.put(clock,ir.load,2,1,0,0);ir.put(clock,ir.load,3,1,0,8);ir.put(clock,ir.constant,4,0,0,1000000000);ir.put(clock,ir.multiply,2,2,4,0);ir.put(clock,ir.add,2,2,3,0);ir.put(clock,ir.result,0,2,0,0);\n    ir.branch(clock,ir.label,0,\"error\");ir.put(clock,ir.constant,2,0,0,0);ir.put(clock,ir.result,0,2,0,0);\n    kaku trylock=ir.function(\"platform_trylock\");ir.call(trylock,104,1,[0]);ir.branch(trylock,ir.zero,1,\"done\");ir.put(trylock,ir.constant,2,0,0,16);ir.put(trylock,ir.equal,2,1,2,0);ir.branch(trylock,ir.zero,2,\"error\");ir.put(trylock,ir.constant,1,0,0,1);ir.branch(trylock,ir.jump,0,\"done\");\n    ir.branch(trylock,ir.label,0,\"error\");ir.put(trylock,ir.constant,2,0,0,0);ir.put(trylock,ir.subtract,1,2,1,0);ir.branch(trylock,ir.label,0,\"done\");ir.put(trylock,ir.result,0,1,0,0);\n    kaku broadcast=ir.function(\"platform_wake_all\");ir.call(broadcast,105,1,[0]);ir.put(broadcast,ir.result,0,1,0,0);\n    kaesu [wait,clock,trylock,broadcast];\n}\n" }; }
waza data_100() -> File { kaesu File { path: "kiso/runtime/os/darwin/thread.mio", version: "Bunko-v2.1.1", length: 1274, sha256: "e69bfc0fa1ade5cf412b41a98b1404cea84cb16d889ea9cebc4767f74aa1ae6e", source: "yobu \"kiso/runtime/target\";\n// Stable import table for the first public Darwin thread bridge. Native code\n// calls the documented ABI; pthread opaque sizes belong only to this adapter.\nkoukai teisu thread_symbol_count = 21;\nkoukai teisu mutex_bytes = 64;\nkoukai teisu condition_bytes = 48;\nkoukai waza thread_symbols() -> []string {\n    kaesu [\"_pthread_create\",\"_pthread_join\",\"_pthread_self\",\"_pthread_key_create\",\n        \"_pthread_setspecific\",\"_pthread_getspecific\",\"_pthread_key_delete\",\"_exit\",\"_write\",\n        \"_pthread_mutex_init\",\"_pthread_mutex_lock\",\"_pthread_mutex_unlock\",\n        \"_pthread_cond_init\",\"_pthread_cond_timedwait_relative_np\",\"_pthread_cond_signal\",\n        \"_pthread_cond_destroy\",\"_pthread_mutex_destroy\",\"_clock_gettime\",\"_getpagesize\",\"_pthread_mutex_trylock\",\"_pthread_cond_broadcast\"];\n}\nkoukai waza capabilities() -> target.TargetInfo {\n    // Thread primitive witnesses do NOT establish multi-mutator root safety.\n    kaesu target.TargetInfo {os:\"darwin\",arch:\"arm64\",abi:\"aapcs64-darwin\",pointer_bits:64,\n        little_endian:hai,page_size_query:hai,atomic64:hai,threads:hai,tls:hai,park_wake:hai,\n        monotonic_clock:hai,virtual_memory:iie,precise_roots:iie,stack_alignment:16,\n        concurrent_collector:iie,executable:hai};\n}\n" }; }
waza data_101() -> File { kaesu File { path: "kiso/runtime/os/darwin/worker.mio", version: "Bunko-v2.1.1", length: 2663, sha256: "fc8e666539d40cb3d3fb7c37fad769fb58ea940f1a788d3a3bac2ce3279a8f73", source: "// Public pthread attributes ABI. LP64 Darwin pthread_attr_t is 64 bytes\n// (long signature + 56 opaque bytes), contained in the IR's 64-byte scratch.\n// Stack policy belongs to this adapter, never to the portable GC algorithms.\nkoukai teisu worker_stack_bytes=8388608;\nkoukai waza worker_symbols() -> []string {\n    kaku symbols=thread_symbols();array.append_all(symbols,[\"_pthread_attr_init\",\"_pthread_attr_setstacksize\",\"_pthread_attr_destroy\",\"_posix_spawn\"]);kaesu symbols;\n}\nkoukai waza worker_bindings() -> []ir.Binding {\n    kaku bindings=thread_bindings();\n    array.push(bindings,ir.Binding {operation:106,slot:21,arguments:[0],result_bits:32});\n    array.push(bindings,ir.Binding {operation:107,slot:22,arguments:[0,1],result_bits:32});\n    array.push(bindings,ir.Binding {operation:108,slot:23,arguments:[0],result_bits:32});\n    array.push(bindings,ir.Binding {operation:109,slot:0,arguments:[0,1,2,3],result_bits:32});\n    array.push(bindings,ir.Binding {operation:110,slot:24,arguments:[0,1,2,3,4,5],result_bits:32});kaesu bindings;\n}\nkoukai waza worker_platform_program() -> []ir.Function {\n    kaku f=ir.function(\"platform_thread_start\");\n    // handle*, entry, argument, first-cleanup-error*. A successful create must\n    // remain success even if attribute cleanup fails: the parent owns a real\n    // handle and must not lose it. Cleanup errors are independently CAS-latched.\n    ir.put(f,ir.scratch_address,4,0,0,0);ir.call(f,106,5,[4]);ir.branch(f,ir.nonzero,5,\"init_failed\");\n    ir.put(f,ir.constant,6,0,0,worker_stack_bytes);ir.call(f,107,5,[4,6]);ir.branch(f,ir.nonzero,5,\"configuration_failed\");\n    ir.call(f,109,7,[0,4,1,2]);ir.branch(f,ir.jump,0,\"destroy\");\n    ir.branch(f,ir.label,0,\"configuration_failed\");ir.put(f,ir.copy,7,5,0,0);\n    ir.branch(f,ir.label,0,\"destroy\");ir.branch(f,ir.zero,7,\"cleanup\");ir.put(f,ir.constant,8,0,0,0);\n    array.push(f.steps,ir.Step {kind:ir.compare_exchange,destination:9,left:3,right:7,immediate:0,name:\"\",arguments:[8],order:3,failure_order:1});\n    ir.branch(f,ir.label,0,\"cleanup\");ir.call(f,108,5,[4]);ir.branch(f,ir.zero,5,\"result\");\n    ir.put(f,ir.constant,8,0,0,0);\n    array.push(f.steps,ir.Step {kind:ir.compare_exchange,destination:9,left:3,right:5,immediate:0,name:\"\",arguments:[8],order:3,failure_order:1});\n    ir.branch(f,ir.label,0,\"result\");ir.put(f,ir.result,0,7,0,0);\n    ir.branch(f,ir.label,0,\"init_failed\");ir.put(f,ir.result,0,5,0,0);\n    kaku functions=thread_platform_program();array.push(functions,f);\n    kaku spawn=ir.function(\"platform_process_spawn\");ir.call(spawn,110,6,[0,1,2,3,4,5]);ir.put(spawn,ir.result,0,6,0,0);array.push(functions,spawn);kaesu functions;\n}\n" }; }
waza data_102() -> File { kaesu File { path: "kiso/runtime/os/linux/link.mio", version: "Bunko-v2.1.1", length: 2583, sha256: "c3b3f5b8b8a0b1400f19b751bc438ace6f028a070c4b1654963c2769059ff0ef", source: "yobu \"kiso/aot/x86_64\";\nyobu \"kiso/aot/elf\";\nyobu \"kiso/runtime/ir\";\nyobu \"kiso/runtime/cpu/amd64\";\nyobu \"kiso/string\";\nyobu \"kiso/convert\";\n// Static Linux image builder. Layout of the code segment:\n//   _start (fills the import table with stub addresses, calls `entry`, exit_group)\n//   one syscall stub per slot, then the lowered runtime-IR functions.\n// The import table lives at the start of the fixed RW segment (elf.data_base).\n// No loader, no external linker, no libc.\nkoukai kata LinkedImage { bytes: []uint8; error: string; }\n\nkoukai waza executable(functions: []ir.Function, bindings: []ir.Binding, entry: string, extra_data: int64) -> LinkedImage {\n    kaku numbers = syscall_numbers();\n    moshi (extra_data < 0 || extra_data > 134217728) { kaesu LinkedImage { bytes: [], error: \"INVALID_RUNTIME_DATA\" }; }\n    kaku found = iie; kaku fi = 0;\n    aida (fi < len(functions)) { moshi (functions[fi].name == entry) { found = hai; } fi = fi + 1; }\n    moshi (!found) { kaesu LinkedImage { bytes: [], error: \"UNDEFINED_RUNTIME_ENTRY\" }; }\n    kaku c = x86_64.assembler();\n    // _start\n    kaku slot = 0;\n    x86_64.mov_ri(c, x86_64.rcx, elf.data_base);\n    aida (slot < len(numbers)) {\n        x86_64.lea_label(c, x86_64.rax, string_stub(slot));\n        x86_64.mov_store(c, x86_64.rcx, slot * 8, x86_64.rax);\n        slot = slot + 1;\n    }\n    x86_64.mov_rr(c, x86_64.r11, x86_64.rcx);\n    x86_64.call(c, string_function(\"rt\", entry));\n    x86_64.mov_rr(c, x86_64.rdi, x86_64.rax);\n    x86_64.mov_eax_imm(c, 231); x86_64.syscall(c);\n    slot = 0;\n    aida (slot < len(numbers)) {\n        x86_64.label(c, string_stub(slot));\n        x86_64.mov_eax_imm(c, numbers[slot]); x86_64.mov_rr(c, x86_64.r10, x86_64.rcx); x86_64.syscall(c); x86_64.ret(c);\n        slot = slot + 1;\n    }\n    kaku failure = amd64.emit_program(c, functions, bindings, len(numbers), \"rt\");\n    moshi (failure != \"\") { kaesu LinkedImage { bytes: [], error: failure }; }\n    kaku assembled = x86_64.assemble(c);\n    moshi (assembled.error != \"\") { kaesu LinkedImage { bytes: [], error: assembled.error }; }\n    kaku image = elf.executable(elf.ImageSpec { code: assembled.bytes, entry_offset: 0, bss_size: len(numbers) * 8 + extra_data });\n    moshi (image.error != \"\") { kaesu LinkedImage { bytes: [], error: image.error }; }\n    kaesu LinkedImage { bytes: image.bytes, error: \"\" };\n}\n\nwaza string_stub(slot: int64) -> string { kaesu string.concat(\"stub_\", convert.format_int(slot)); }\nwaza string_function(prefix: string, name: string) -> string { kaesu string.concat(prefix, string.concat(\"_\", name)); }\n" }; }
waza data_103() -> File { kaesu File { path: "kiso/runtime/os/linux/operations.mio", version: "Bunko-v2.1.1", length: 9130, sha256: "610bad258e4678648263f349cf81f31ccdf664d89df345663d0a2d214df05558", source: "yobu \"kiso/runtime/ir\";\nyobu \"kiso/runtime/target\";\n// Linux x86-64 (System V) OS adapter. There is no dynamic loader and no libc:\n// every OS service is a raw system call reached through a tiny in-image stub\n// (`mov eax,N; mov r10,rcx; syscall; ret`). Stub addresses fill the import table\n// that cpu/amd64 calls through (the same Binding/slot mechanism as os/darwin), so\n// the portable runtime-IR functions are lowered identically for the two targets.\n// Raw system calls return -errno; this adapter confines Linux errno values.\n//\n// What is NOT the same as os/darwin. Darwin's platform_wait(condition, mutex, timeout_ns),\n// platform_wake_all(condition) and platform_trylock(mutex) are pthread-condition/mutex\n// operations: the caller holds the mutex, which is released atomically while waiting. Linux has\n// no such layer yet (it would be built on futex words and is not implemented), so these three\n// functions are deliberately NOT defined here: portable code that calls them fails validation\n// (UNDEFINED_RUNTIME_FUNCTION / NOT_SUPPORTED_RUNTIME_OPERATION) instead of silently passing a\n// mutex pointer where a futex value is expected. Only the raw futex wait/wake below exist, under\n// their own names (platform_futex_*), and `capabilities().park_wake` is therefore false.\n//\n// Slot -> system call number. Slot order is part of the image contract.\nkoukai teisu slot_write = 0;\nkoukai teisu slot_exit = 1;\nkoukai teisu slot_mmap = 2;\nkoukai teisu slot_munmap = 3;\nkoukai teisu slot_mprotect = 4;\nkoukai teisu slot_madvise = 5;\nkoukai teisu slot_clock_gettime = 6;\nkoukai teisu slot_futex = 7;\nkoukai teisu slot_count = 8;\nkoukai waza syscall_numbers() -> []int64 { kaesu [1, 231, 9, 11, 10, 28, 228, 202]; }\n\nkoukai teisu clock_monotonic = 1;\nkoukai teisu futex_wait_private = 128;\nkoukai teisu futex_wake_private = 129;\nkoukai teisu page_bytes = 4096;\n\n// Operation numbers. 31 (abort), 101 (clock_gettime(CLOCK_MONOTONIC) into a timespec, 0 on success),\n// 102 (exit) and 103 (write(1, buffer, length)) mean the same as in os/darwin. Darwin's 12, 100, 104\n// and 105 are pthread condition/mutex calls with no Linux equivalent here, so they are not bound.\n// 200..203 are Linux-private virtual-memory calls whose six arguments all come from virtual registers\n// (a literal fd = -1 is not encodable in a Binding); 204/205 are the Linux-private futex wait/wake.\nkoukai waza bindings() -> []ir.Binding {\n    kaesu [\n        ir.Binding { operation: 31, slot: 1, arguments: [0], result_bits: 64 },\n        ir.Binding { operation: 101, slot: 6, arguments: [-2, 0], result_bits: 64 },\n        ir.Binding { operation: 102, slot: 1, arguments: [0], result_bits: 64 },\n        ir.Binding { operation: 103, slot: 0, arguments: [-2, 0, 1], result_bits: 64 },\n        ir.Binding { operation: 200, slot: 2, arguments: [0, 1, 2, 3, 4, 5], result_bits: 64 },\n        ir.Binding { operation: 201, slot: 3, arguments: [0, 1], result_bits: 64 },\n        ir.Binding { operation: 202, slot: 4, arguments: [0, 1, 2], result_bits: 64 },\n        ir.Binding { operation: 203, slot: 5, arguments: [0, 1, 2], result_bits: 64 },\n        ir.Binding { operation: 204, slot: 7, arguments: [0, -129, 1, 2], result_bits: 64 },\n        ir.Binding { operation: 205, slot: 7, arguments: [0, -130, 1], result_bits: 64 }\n    ];\n}\n\n// What this adapter really provides. Threads, TLS and precise roots are NOT claimed (no clone, no TLS\n// register, no root registry), and neither is park_wake: that capability means the portable condition/\n// mutex protocol (see above), of which only raw futex wait/wake exist. So the target still fails closed\n// for the concurrent collector (target.concurrent_error != \"\") and for mutex/condition/park/wake operations.\nkoukai waza capabilities() -> target.TargetInfo {\n    kaesu target.TargetInfo { os: \"linux\", arch: \"amd64\", abi: \"sysv\", pointer_bits: 64, little_endian: hai,\n        page_size_query: hai, atomic64: hai, threads: iie, tls: iie, park_wake: iie,\n        monotonic_clock: hai, virtual_memory: hai, precise_roots: iie, stack_alignment: 16,\n        concurrent_collector: iie, executable: hai };\n}\n\n// platform_now() -> monotonic nanoseconds, 0 on failure: the same contract as os/darwin.\n//\n// platform_futex_wait(address, expected, timeout_ns) -> 0, 1 or a negative errno:\n//   0  woken, or the word no longer matched (EAGAIN) or the call was interrupted (EINTR): the portable\n//      contract allows spurious wake-ups, so callers must re-check their predicate;\n//   1  the relative timeout elapsed (ETIMEDOUT); a timeout of 0 returns 1 at once when the word still\n//      matches (it never waits forever);\n//   <0 any other failure, as -errno.\n//   Linux compares a 32-bit word: only the low 32 bits (little endian) of the 64-bit word at `address`\n//   are compared with the low 32 bits of `expected`; callers must keep the state they wait on in those\n//   bits. `address` is a process-private futex word (FUTEX_WAIT_PRIVATE), 4-byte aligned.\n// platform_futex_wake(address, count) -> number of waiters woken, or -errno.\n// platform_futex_wake_all(address) -> platform_futex_wake(address, INT_MAX).\n// platform_reserve(length) -> the mapping address, or -errno; every other memory function returns 0 or\n//   -errno. An error is a value in [2^64 - 4095, 2^64 - 1] viewed unsigned, which is never a user address.\nkoukai waza platform_program() -> []ir.Function {\n    kaku wait = ir.function(\"platform_futex_wait\");\n    // (address, expected, timeout_ns): build the relative timespec {sec, nsec} in scratch.\n    ir.put(wait, ir.scratch_address, 3, 0, 0, 0); ir.put(wait, ir.constant, 4, 0, 0, 1000000000);\n    ir.put(wait, ir.divide_unsigned, 5, 2, 4, 0); ir.put(wait, ir.multiply, 6, 5, 4, 0); ir.put(wait, ir.subtract, 6, 2, 6, 0);\n    ir.put(wait, ir.store, 0, 3, 5, 0); ir.put(wait, ir.store, 0, 3, 6, 8);\n    ir.call(wait, 204, 4, [0, 1, 3]); ir.branch(wait, ir.zero, 4, \"return\");\n    // ETIMEDOUT=110 -> timeout(1). EAGAIN=11 (value changed) and EINTR=4 are\n    // legitimate wakeups from the portable point of view -> 0. Other errors are negative errno.\n    ir.put(wait, ir.constant, 5, 0, 0, -110); ir.put(wait, ir.equal, 5, 4, 5, 0); ir.branch(wait, ir.zero, 5, \"again\");\n    ir.put(wait, ir.constant, 4, 0, 0, 1); ir.branch(wait, ir.jump, 0, \"return\");\n    ir.branch(wait, ir.label, 0, \"again\");\n    ir.put(wait, ir.constant, 5, 0, 0, -11); ir.put(wait, ir.equal, 5, 4, 5, 0); ir.branch(wait, ir.nonzero, 5, \"woken\");\n    ir.put(wait, ir.constant, 5, 0, 0, -4); ir.put(wait, ir.equal, 5, 4, 5, 0); ir.branch(wait, ir.zero, 5, \"return\");\n    ir.branch(wait, ir.label, 0, \"woken\"); ir.put(wait, ir.constant, 4, 0, 0, 0);\n    ir.branch(wait, ir.label, 0, \"return\"); ir.put(wait, ir.result, 0, 4, 0, 0);\n\n    kaku clock = ir.function(\"platform_now\");\n    ir.put(clock, ir.scratch_address, 1, 0, 0, 0); ir.call(clock, 101, 2, [1]); ir.branch(clock, ir.nonzero, 2, \"error\");\n    ir.put(clock, ir.load, 2, 1, 0, 0); ir.put(clock, ir.load, 3, 1, 0, 8); ir.put(clock, ir.constant, 4, 0, 0, 1000000000);\n    ir.put(clock, ir.multiply, 2, 2, 4, 0); ir.put(clock, ir.add, 2, 2, 3, 0); ir.put(clock, ir.result, 0, 2, 0, 0);\n    ir.branch(clock, ir.label, 0, \"error\"); ir.put(clock, ir.constant, 2, 0, 0, 0); ir.put(clock, ir.result, 0, 2, 0, 0);\n\n    kaku wake = ir.function(\"platform_futex_wake\");\n    ir.call(wake, 205, 2, [0, 1]); ir.put(wake, ir.result, 0, 2, 0, 0);\n    kaku wake_all = ir.function(\"platform_futex_wake_all\");\n    ir.put(wake_all, ir.constant, 1, 0, 0, 2147483647); ir.call(wake_all, 205, 2, [0, 1]); ir.put(wake_all, ir.result, 0, 2, 0, 0);\n\n    // Virtual memory. reserve: PROT_NONE private anonymous NORESERVE mapping.\n    kaku reserve = ir.function(\"platform_reserve\");\n    // virtual registers: 0=length (argument) 1=addr(NULL) 2=PROT_NONE 3=flags 4=fd(-1) 5=offset\n    ir.put(reserve, ir.constant, 1, 0, 0, 0); ir.put(reserve, ir.constant, 2, 0, 0, 0); ir.put(reserve, ir.constant, 3, 0, 0, 16418);\n    ir.put(reserve, ir.constant, 4, 0, 0, -1); ir.put(reserve, ir.constant, 5, 0, 0, 0);\n    ir.call(reserve, 200, 7, [1, 0, 2, 3, 4, 5]); ir.put(reserve, ir.result, 0, 7, 0, 0);\n    // commit(addr,len): PROT_READ|PROT_WRITE (3)\n    kaku commit = ir.function(\"platform_commit\");\n    ir.put(commit, ir.constant, 2, 0, 0, 3); ir.call(commit, 202, 3, [0, 1, 2]); ir.put(commit, ir.result, 0, 3, 0, 0);\n    // decommit(addr,len): MADV_DONTNEED (4) drops pages; then PROT_NONE (0)\n    kaku decommit = ir.function(\"platform_decommit\");\n    ir.put(decommit, ir.constant, 2, 0, 0, 4); ir.call(decommit, 203, 3, [0, 1, 2]); ir.branch(decommit, ir.nonzero, 3, \"done\");\n    ir.put(decommit, ir.constant, 2, 0, 0, 0); ir.call(decommit, 202, 3, [0, 1, 2]);\n    ir.branch(decommit, ir.label, 0, \"done\"); ir.put(decommit, ir.result, 0, 3, 0, 0);\n    kaku release = ir.function(\"platform_release\");\n    ir.call(release, 201, 2, [0, 1]); ir.put(release, ir.result, 0, 2, 0, 0);\n    kaku protect = ir.function(\"platform_protect\");\n    ir.call(protect, 202, 3, [0, 1, 2]); ir.put(protect, ir.result, 0, 3, 0, 0);\n    kaesu [wait, clock, wake, wake_all, reserve, commit, decommit, release, protect];\n}\n" }; }
waza data_104() -> File { kaesu File { path: "kiso/runtime/target/target.mio", version: "Bunko-v2.1.1", length: 2500, sha256: "4f2a0b8211eebc2d7e8dc5d8a15987f08fe5f1cf3f3d7df38889574a4aa8fb51", source: "yobu \"kiso/runtime/gc\";\n\n// ABI descriptors describe capabilities, not optimistic platform names.\n// Unknown pressure and unavailable memory limits are valid optional inputs.\nkoukai kata TargetInfo {\n    os: string; arch: string; abi: string; pointer_bits: int64; little_endian: bool;\n    page_size_query: bool; atomic64: bool; threads: bool; tls: bool;\n    park_wake: bool; monotonic_clock: bool; virtual_memory: bool;\n    precise_roots: bool; stack_alignment: int64; concurrent_collector: bool;\n    executable: bool;\n}\nkoukai waza descriptor(os: string, arch: string, abi: string) -> TargetInfo {\n    kaesu TargetInfo { os: os, arch: arch, abi: abi, pointer_bits: 64,\n        little_endian: hai, page_size_query: iie, atomic64: iie, threads: iie,\n        tls: iie, park_wake: iie, monotonic_clock: iie, virtual_memory: iie,\n        precise_roots: iie, stack_alignment: 16, concurrent_collector: iie, executable: iie };\n}\nkoukai waza concurrent_error(t: TargetInfo) -> string {\n    moshi (t.pointer_bits != 64 || t.stack_alignment < 16 || !t.page_size_query ||\n        !t.atomic64 || !t.threads || !t.tls || !t.park_wake || !t.monotonic_clock ||\n        !t.virtual_memory || !t.precise_roots || !t.concurrent_collector || !t.executable) {\n        kaesu \"NOT_SUPPORTED: concurrent collector target contract incomplete\";\n    }\n    kaesu \"\";\n}\nkoukai waza operation_error(t: TargetInfo, op: gc.RuntimeOp) -> string {\n    moshi (!gc.valid_operation(op)) { kaesu \"INVALID_RUNTIME_OP\"; }\n    moshi (op.kind <= gc.fence && !t.atomic64) { kaesu \"NOT_SUPPORTED: atomic64\"; }\n    moshi (op.kind >= gc.thread_start && op.kind <= gc.thread_identity && !t.threads) { kaesu \"NOT_SUPPORTED: threads\"; }\n    moshi ((op.kind == gc.tls_get || op.kind == gc.tls_set || op.kind == gc.tls_create || op.kind == gc.tls_destroy) && !t.tls) { kaesu \"NOT_SUPPORTED: TLS\"; }\n    moshi ((op.kind == gc.park || op.kind == gc.wake) && !t.park_wake) { kaesu \"NOT_SUPPORTED: park/wake\"; }\n    moshi (((op.kind >= gc.reserve && op.kind <= gc.memory_release) || op.kind == gc.protect) && !t.virtual_memory) { kaesu \"NOT_SUPPORTED: virtual memory\"; }\n    moshi (op.kind >= gc.mutex_create && op.kind <= gc.condition_destroy && !t.park_wake) { kaesu \"NOT_SUPPORTED: synchronization lifecycle\"; }\n    moshi (op.kind == gc.clock && !t.monotonic_clock) { kaesu \"NOT_SUPPORTED: monotonic clock\"; }\n    moshi (op.kind >= gc.roots && op.kind <= gc.write_barrier && !t.precise_roots) { kaesu \"NOT_SUPPORTED: roots/barrier\"; }\n    kaesu \"\";\n}\n" }; }
waza data_105() -> File { kaesu File { path: "kiso/string/string.mio", version: "Bunko-v2.1.1", length: 3979, sha256: "e634aa4c7f3644604d45f3df6d3ecdd9df8c4fb37eb6ccd07357bb6d9855a462", source: "yobu \"kiso/array\";\nyobu \"kiso/bytes\";\nyobu \"kiso/utf8\";\n\nkoukai kata StringBuilder { buffer: bytes.ByteBuffer; }\n\nkoukai waza to_bytes(value: string) -> []uint8 {\n    kaesu __string_to_bytes(value);\n}\n\nkoukai waza from_utf8(data: []uint8) -> string? {\n    moshi (!utf8.valid(data)) { kaesu mu; }\n    kaesu __string_from_utf8(data);\n}\n\nkoukai waza byte_len(value: string) -> int64 {\n    kaesu __string_byte_len(value);\n}\n\nkoukai waza rune_count(value: string) -> int64 {\n    kaku count = utf8.rune_count(to_bytes(value));\n    moshi (count != mu) { kaesu count; }\n    __math_error(\"kiso/string.rune_count: string contains invalid UTF-8\");\n    kaesu 0;\n}\n\nkoukai waza has_prefix(value: string, prefix: string) -> bool {\n    kaesu bytes.has_prefix(to_bytes(value), to_bytes(prefix));\n}\n\nkoukai waza has_suffix(value: string, suffix: string) -> bool {\n    kaesu bytes.has_suffix(to_bytes(value), to_bytes(suffix));\n}\n\nkoukai waza index(value: string, pattern: string) -> int64 {\n    kaku data = to_bytes(value);\n    kaku target = to_bytes(pattern);\n    moshi (len(target) == 0) { kaesu 0; }\n    moshi (len(target) > len(data)) { kaesu -1; }\n    kaku offset = 0;\n    kaku limit = len(data) - len(target);\n    aida (offset <= limit) {\n        kaku matched = hai;\n        kaku current = 0;\n        aida (current < len(target)) {\n            moshi (data[offset + current] != target[current]) {\n                matched = iie;\n                nukeru;\n            }\n            current = current + 1;\n        }\n        moshi (matched) { kaesu offset; }\n        offset = offset + 1;\n    }\n    kaesu -1;\n}\n\nkoukai waza contains(value: string, pattern: string) -> bool {\n    kaesu index(value, pattern) >= 0;\n}\n\nkoukai waza concat(left: string, right: string) -> string {\n    kaku builder = builder_with_capacity(byte_len(left) + byte_len(right));\n    write_string(builder, left);\n    write_string(builder, right);\n    kaesu builder_string(builder);\n}\n\nkoukai waza new_builder() -> StringBuilder {\n    kaesu StringBuilder { buffer: bytes.new_buffer() };\n}\n\nkoukai waza builder_with_capacity(capacity: int64) -> StringBuilder {\n    kaesu StringBuilder { buffer: bytes.buffer_with_capacity(capacity) };\n}\n\nkoukai waza write_string(builder: StringBuilder, value: string) -> unit {\n    bytes.write(builder.buffer, to_bytes(value));\n}\n\nkoukai waza write_rune(builder: StringBuilder, value: rune) -> unit {\n    utf8.append_rune(builder.buffer.data, value);\n}\n\nkoukai waza builder_len(builder: StringBuilder) -> int64 {\n    kaesu bytes.buffer_len(builder.buffer);\n}\n\nkoukai waza builder_capacity(builder: StringBuilder) -> int64 {\n    kaesu bytes.buffer_capacity(builder.buffer);\n}\n\nkoukai waza builder_reset(builder: StringBuilder) -> unit {\n    bytes.reset(builder.buffer);\n}\n\nkoukai waza builder_string(builder: StringBuilder) -> string {\n    kaku result = from_utf8(builder.buffer.data);\n    moshi (result != mu) { kaesu result; }\n    __math_error(\"kiso/string.builder_string: builder contains invalid UTF-8\");\n    kaesu \"\";\n}\n\nwaza whitespace_rune(value: rune) -> bool {\n    kaku code=int64(value);\n    kaesu (code>=9 && code<=13) || code==32 || code==133 || code==160 || code==5760 || (code>=8192 && code<=8202) || code==8232 || code==8233 || code==8239 || code==8287 || code==12288;\n}\nkoukai waza trim_space(value: string) -> string {\n    kaku data=to_bytes(value);kaku low=0;kaku high=len(data);\n    aida(low<high){kaku decoded=utf8.decode_one(data,low);moshi(!decoded.valid || !whitespace_rune(decoded.value)){nukeru;}low=low+decoded.width;}\n    aida(high>low){kaku start=high-1;aida(start>low && data[start]>=uint8(128) && data[start]<uint8(192)){start=start-1;}\n        kaku decoded=utf8.decode_one(data,start);moshi(!decoded.valid || start+decoded.width!=high || !whitespace_rune(decoded.value)){nukeru;}high=start;\n    }\n    kaku output: []uint8=[];kaku at=low;aida(at<high){array.push(output,data[at]);at=at+1;}\n    kaku text=from_utf8(output);moshi(text==mu){kaesu value;}kaesu text;\n}\n" }; }
waza data_106() -> File { kaesu File { path: "kiso/testing/testing.mio", version: "Bunko-v2.1.1", length: 562, sha256: "3bdbe2c2b556ad19b6d658d07319f77493ecda8eb73b454f81383faebea68d2f", source: "yobu \"mio/testing/runtime\";\n\nkoukai waza expect(condition: bool, message: string) -> unit {\n    runtime.report(condition, message);\n}\n\n// A skipped test is neither a pass nor a failure: the runner reports it as SKIP with the reason and counts it\n// separately. A skip is two records: the fixed marker, then the reason. Call it before any other expectation.\nkoukai waza skip(reason: string) -> unit {\n    runtime.report(iie, \"@@mio-test-skip@@\");\n    runtime.report(iie, reason);\n}\n\nkoukai waza fail(message: string) -> unit {\n    runtime.report(iie, message);\n}\n" }; }
waza data_107() -> File { kaesu File { path: "kiso/utf8/utf8.mio", version: "Bunko-v2.1.1", length: 5540, sha256: "61c91357b2a5de3de4de54b5fa2f2e215d27d82fe5289aa90a76f400f8d67f06", source: "yobu \"kiso/array\";\nyobu \"kiso/bytes\";\n\nkoukai kata DecodeResult {\n    value: rune;\n    width: int64;\n    valid: bool;\n}\n\nwaza invalid_decode() -> DecodeResult {\n    kaesu DecodeResult { value: '\\uFFFD', width: 1, valid: iie };\n}\n\nwaza decode_packed(data: []uint8, offset: int64) -> int64 {\n    moshi (offset == len(data)) { kaesu -2; }\n    moshi (offset < 0 || offset > len(data)) {\n        data[offset];\n    }\n\n    kaku first = int64(data[offset]);\n    moshi (first <= 127) {\n        kaesu first + 1114112;\n    }\n    moshi (first >= 194 && first <= 223) {\n        moshi (offset + 2 > len(data)) { kaesu -1; }\n        kaku second = int64(data[offset + 1]);\n        moshi (second < 128 || second > 191) { kaesu -1; }\n        kaesu (first - 192) * 64 + second - 128 + 2228224;\n    }\n    moshi (first >= 224 && first <= 239) {\n        moshi (offset + 3 > len(data)) { kaesu -1; }\n        kaku second = int64(data[offset + 1]);\n        kaku third = int64(data[offset + 2]);\n        moshi (second < 128 || second > 191 || third < 128 || third > 191) {\n            kaesu -1;\n        }\n        moshi (first == 224 && second < 160) { kaesu -1; }\n        moshi (first == 237 && second > 159) { kaesu -1; }\n        kaesu (first - 224) * 4096 + (second - 128) * 64 + third - 128 + 3342336;\n    }\n    moshi (first >= 240 && first <= 244) {\n        moshi (offset + 4 > len(data)) { kaesu -1; }\n        kaku second = int64(data[offset + 1]);\n        kaku third = int64(data[offset + 2]);\n        kaku fourth = int64(data[offset + 3]);\n        moshi (second < 128 || second > 191 || third < 128 || third > 191 || fourth < 128 || fourth > 191) {\n            kaesu -1;\n        }\n        moshi (first == 240 && second < 144) { kaesu -1; }\n        moshi (first == 244 && second > 143) { kaesu -1; }\n        kaesu (first - 240) * 262144 + (second - 128) * 4096 + (third - 128) * 64 + fourth - 128 + 4456448;\n    }\n    kaesu -1;\n}\n\nwaza append_valid(destination: []uint8, code: int64) -> unit {\n    moshi (code <= 127) {\n        array.push(destination, uint8(code));\n        kaesu;\n    }\n    moshi (code <= 2047) {\n        array.push(destination, uint8(192 + code / 64));\n        array.push(destination, uint8(128 + code - (code / 64) * 64));\n        kaesu;\n    }\n    moshi (code <= 65535) {\n        array.push(destination, uint8(224 + code / 4096));\n        array.push(destination, uint8(128 + (code / 64) - (code / 4096) * 64));\n        array.push(destination, uint8(128 + code - (code / 64) * 64));\n        kaesu;\n    }\n    array.push(destination, uint8(240 + code / 262144));\n    array.push(destination, uint8(128 + (code / 4096) - (code / 262144) * 64));\n    array.push(destination, uint8(128 + (code / 64) - (code / 4096) * 64));\n    array.push(destination, uint8(128 + code - (code / 64) * 64));\n}\n\nkoukai waza is_valid_rune(value: rune) -> bool {\n    kaku code = int64(value);\n    kaesu code >= 0 && code <= 1114111 && (code < 55296 || code > 57343);\n}\n\nkoukai waza rune_width(value: rune) -> int64 {\n    moshi (!is_valid_rune(value)) {\n        __math_error(\"kiso/utf8.rune_width: invalid Unicode scalar value\");\n        kaesu 0;\n    }\n    kaku code = int64(value);\n    moshi (code <= 127) { kaesu 1; }\n    moshi (code <= 2047) { kaesu 2; }\n    moshi (code <= 65535) { kaesu 3; }\n    kaesu 4;\n}\n\nkoukai waza decode_one(data: []uint8, offset: int64) -> DecodeResult {\n    kaku packed = decode_packed(data, offset);\n    moshi (packed == -2) {\n        kaesu DecodeResult { value: '\\uFFFD', width: 0, valid: iie };\n    }\n    moshi (packed == -1) { kaesu invalid_decode(); }\n    kaku width = 1;\n    moshi (packed >= 2228224) {\n        width = 2;\n        moshi (packed >= 3342336) {\n            width = 3;\n            moshi (packed >= 4456448) { width = 4; }\n        }\n    }\n    kaesu DecodeResult { value: rune(packed - width * 1114112), width: width, valid: hai };\n}\n\nkoukai waza encode_rune(value: rune) -> []uint8 {\n    kaku width = rune_width(value);\n    kaku buffer = bytes.buffer_with_capacity(width);\n    append_valid(buffer.data, int64(value));\n    kaesu buffer.data;\n}\n\nkoukai waza append_rune(destination: []uint8, value: rune) -> unit {\n    moshi (!is_valid_rune(value)) {\n        __math_error(\"kiso/utf8.append_rune: invalid Unicode scalar value\");\n        kaesu;\n    }\n    append_valid(destination, int64(value));\n}\n\nkoukai waza valid(data: []uint8) -> bool {\n    kaku offset = 0;\n    aida (offset < len(data)) {\n        kaku packed = decode_packed(data, offset);\n        moshi (packed < 0) { kaesu iie; }\n        moshi (packed < 2228224) {\n            offset = offset + 1;\n        } sore {\n            moshi (packed < 3342336) {\n                offset = offset + 2;\n            } sore {\n                moshi (packed < 4456448) {\n                    offset = offset + 3;\n                } sore {\n                    offset = offset + 4;\n                }\n            }\n        }\n    }\n    kaesu hai;\n}\n\nkoukai waza rune_count(data: []uint8) -> int64? {\n    kaku offset = 0;\n    kaku count = 0;\n    aida (offset < len(data)) {\n        kaku packed = decode_packed(data, offset);\n        moshi (packed < 0) { kaesu mu; }\n        moshi (packed < 2228224) {\n            offset = offset + 1;\n        } sore {\n            moshi (packed < 3342336) {\n                offset = offset + 2;\n            } sore {\n                moshi (packed < 4456448) {\n                    offset = offset + 3;\n                } sore {\n                    offset = offset + 4;\n                }\n            }\n        }\n        count = count + 1;\n    }\n    kaesu count;\n}\n" }; }
