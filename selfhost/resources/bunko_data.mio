ode, \"memory.commit.suffix.1\");\n    observation_word(code, 4177883767);\n    observation_word(code, 4177884791);\n    arm64.assembler_label(code, \"memory.commit.success\");\n    observation_word(code, 3531604000);\n    arm64.assembler_b(code, \"memory.commit.return\");\n    arm64.assembler_label(code, \"memory.commit.fail\");\n    observation_word(code, 3531603968);\n    arm64.assembler_label(code, \"memory.commit.return\");\n    observation_word(code, 4181732350);\n    observation_word(code, 4181722099);\n    observation_word(code, 4181723124);\n    observation_word(code, 4181724149);\n    observation_word(code, 4181725174);\n    observation_word(code, 4181726199);\n    observation_word(code, 4181727224);\n    observation_word(code, 4181728249);\n    observation_word(code, 4181729274);\n    observation_word(code, 4181730299);\n    observation_word(code, 4181731324);\n    observation_word(code, 2432795647);\n    observation_word(code, 3596551104);\n    arm64.assembler_label(code, \"memory.snapshot\");\n    observation_word(code, 4182059017);\n    observation_word(code, 4177526825);\n    observation_word(code, 4182060041);\n    observation_word(code, 4177527849);\n    observation_word(code, 4182074377);\n    observation_word(code, 4177528873);\n    observation_word(code, 4182055945);\n    observation_word(code, 4177529897);\n    observation_word(code, 4182054921);\n    observation_word(code, 4177530921);\n    observation_word(code, 4182057993);\n    observation_word(code, 4177531945);\n    observation_word(code, 4182062089);\n    observation_word(code, 4177532969);\n    observation_word(code, 4182061065);\n    observation_word(code, 4177533993);\n    observation_word(code, 3596551104);\n}\n" }; }
waza data_17() -> File { kaesu File { path: "kiso/aot/lower/memory_runtime.mio", version: "Bunko-v2.1.1", length: 7452, sha256: "6c0fb0184e5f3f8bd7860de46ce10d488003d66cfec9b84c7d2eaef9bacfc03e", source: "// Internal policy adapters. The policy block starts at byte 2600, matching Go.\n// Committed is a conservative managed working-page charge, not physical RSS.\n// It includes both arena and sparse side-metadata prefix high-water extents,\n// fixed mapping/page overhead, and the exact rounded lengths of LOS mappings.\nteisu memory_Goal = 2600;\nteisu memory_Limit = 2608;\nteisu memory_Committed = 2616;\nteisu memory_Reserved = 2624;\nteisu memory_Rate = 2632;\nteisu memory_Level = 2640;\nteisu memory_Reason = 2648;\nteisu memory_Sequence = 2656;\nteisu memory_GCActive = 2664;\nteisu memory_ObjectLimit = 2712;\nteisu memory_LOSCommitted = 2720;\nteisu memory_HighWater = 2784;\n// OS memory pressure (sysctl kern.memorystatus_vm_pressure_level) is queried by memory.update unless the system\n// pressure state word (2752) is 2, which the policy treats as \"available, use the cached level\" (2672). memory.update\n// runs several times per allocation (362 M updates for 91 M allocations in a CLI self-build), and on macos-15 each\n// sysctl costs about 0.1 ms of kernel time, so even one query per 256 updates spent more than half of a self-build\n// in the kernel. The adapter therefore re-queries only when 1/16 s (CNTVCT ticks) has passed since the last query\n// or a collection has run, and reuses the cached level in between. The state word is restored to 1 afterwards, so\n// observed values are unchanged.\n// 2880 is unused metadata (the policy block ends at 2816; nothing in 2824..3071 is addressed): the CNTVCT tick at or\n// after which the next query is due (0 = now).\nteisu memory_SystemNextQuery = 2880;\n// 2888 (also unused, zero at start): CNTFRQ_EL0, cached on first use.\nteisu memory_CounterFrequency = 2888;\nteisu memory_SystemState = 2752;\nwaza emit_memory_adapters(code: arm64.Assembler) -> unit {\n    emit_memory_policy(code);\n    arm64.assembler_label(code, \"memory_sample\");\n    emit(code, arm64.sub_imm_x(31, 31, 32, iie));\n    emit(code, arm64.str_x(30, 31, 0));\n    emit(code, arm64.str_x(0, 31, 8));\n    emit(code, arm64.ldr_x(9, 23, 0));\n    emit(code, arm64.add_imm_x(10, 23, 3072, iie));\n    emit(code, arm64.sub_x(9, 9, 10));\n    emit(code, arm64.ldr_x(11, 23, memory_HighWater));\n    emit(code, arm64.cmp_x(9, 11));\n    arm64.assembler_b_cond(code, 2, \"memory_highwater_store\");\n    move_x(code, 9, 11);\n    arm64.assembler_label(code, \"memory_highwater_store\");\n    emit(code, arm64.str_x(9, 23, memory_HighWater));\n    emit(code, arm64.movz_x(10, 16383, 0));\n    emit(code, arm64.add_x(9, 9, 10));\n    emit(code, arm64.movn_x(10, 16383, 0));\n    emit(code, arm64.and_x(9, 9, 10));\n    emit(code, arm64.add_x(9, 9, 9));\n    move_bits(code, 10, uint32(0), uint32(65536));\n    emit(code, arm64.add_x(9, 9, 10));\n    emit(code, arm64.ldr_x(11, 23, memory_LOSCommitted));\n    emit(code, arm64.add_x(9, 9, 11));\n    emit(code, arm64.str_x(9, 23, memory_Committed));\n    emit(code, arm64.ldr_x(3, 23, 8));\n    emit(code, arm64.add_imm_x(9, 23, 3072, iie));\n    emit(code, arm64.sub_x(3, 3, 9));\n    emit(code, arm64.add_x(9, 3, 3));\n    emit(code, arm64.add_imm_x(9, 9, 3072, iie));\n    emit(code, arm64.add_x(9, 9, 11));\n    emit(code, arm64.str_x(9, 23, memory_Reserved));\n    emit(code, arm64.ldr_x(9, 23, memory_Reserved));\n    emit(code, arm64.movz_x(10, 16383, 0));\n    emit(code, arm64.add_x(9, 9, 10));\n    emit(code, arm64.movn_x(10, 16383, 0));\n    emit(code, arm64.and_x(9, 9, 10));\n    emit(code, arm64.str_x(9, 23, memory_Reserved));\n    emit(code, arm64.ldr_x(10, 23, memory_Committed));\n    emit(code, arm64.cmp_x(10, 9));\n    arm64.assembler_b_cond(code, 9, \"memory_charge_bounded\");\n    emit(code, arm64.str_x(9, 23, memory_Committed));\n    arm64.assembler_label(code, \"memory_charge_bounded\");\n    move_x(code, 0, 23);\n    emit(code, arm64.ldr_x(1, 23, 304));\n    emit(code, arm64.ldr_x(2, 23, 296));\n    // x4 = CNTFRQ_EL0, read once: the register is constant, but on virtualized macOS hosts the read traps (a sampled\n    // macos-15 self-build spent 10% of its time on this instruction, executed twice per allocation).\n    emit(code, arm64.ldr_x(4, 23, memory_CounterFrequency));\n    arm64.assembler_cbnz_x(code, 4, \"memory_frequency_ready\");\n    observation_word(code, 3577470980);\n    emit(code, arm64.str_x(4, 23, memory_CounterFrequency)); // MRS x4, CNTFRQ_EL0\n    arm64.assembler_label(code, \"memory_frequency_ready\");\n    emit(code, arm64.ldr_x(5, 23, 872));\n    emit(code, arm64.ldr_x(6, 23, 2800));\n    emit(code, arm64.ldr_x(9, 23, memory_SystemState));\n    emit(code, arm64.cmp_imm_x(9, 1, iie));\n    arm64.assembler_b_cond(code, 1, \"memory_sample_update\");\n    observation_word(code, 3577471050); // MRS x10, CNTVCT_EL0\n    emit(code, arm64.ldr_x(11, 23, memory_SystemNextQuery));\n    emit(code, arm64.cmp_x(10, 11));\n    arm64.assembler_b_cond(code, 2, \"memory_sample_refresh\");\n    emit(code, arm64.movz_x(9, 2, 0));\n    emit(code, arm64.str_x(9, 23, memory_SystemState));\n    arm64.assembler_b(code, \"memory_sample_update\");\n    arm64.assembler_label(code, \"memory_sample_refresh\");\n    emit(code, arm64.ldr_x(11, 23, memory_CounterFrequency)); // cached CNTFRQ_EL0 (set above)\n    emit(code, arm64.lsr_x(11, 11, 4));\n    emit(code, arm64.add_x(11, 10, 11));\n    emit(code, arm64.str_x(11, 23, memory_SystemNextQuery));\n    arm64.assembler_label(code, \"memory_sample_update\");\n    arm64.assembler_bl(code, \"memory.update\");\n    emit(code, arm64.ldr_x(9, 23, memory_SystemState));\n    emit(code, arm64.cmp_imm_x(9, 2, iie));\n    arm64.assembler_b_cond(code, 1, \"memory_sample_state\");\n    emit(code, arm64.movz_x(9, 1, 0));\n    emit(code, arm64.str_x(9, 23, memory_SystemState));\n    arm64.assembler_label(code, \"memory_sample_state\");\n    emit(code, arm64.ldr_x(9, 23, memory_Goal));\n    arm64.assembler_cbnz_x(code, 9, \"memory_sample_done\");\n    move_x(code, 0, 23);\n    emit(code, arm64.movz_x(1, 0, 0));\n    emit(code, arm64.movz_x(2, 0, 0));\n    arm64.assembler_bl(code, \"memory.goal\");\n    arm64.assembler_label(code, \"memory_sample_done\");\n    emit(code, arm64.ldr_x(0, 31, 8));\n    emit(code, arm64.ldr_x(30, 31, 0));\n    emit(code, arm64.add_imm_x(31, 31, 32, iie));\n    emit(code, arm64.ret());\n    arm64.assembler_label(code, \"memory_grow\"); // payload request in x0\n    emit(code, arm64.sub_imm_x(31, 31, 32, iie));\n    emit(code, arm64.str_x(30, 31, 0));\n    emit(code, arm64.str_x(0, 31, 8));\n    emit(code, arm64.add_imm_x(2, 0, 31, iie));\n    emit(code, arm64.movn_x(9, 15, 0));\n    emit(code, arm64.and_x(2, 2, 9));\n    emit(code, arm64.ldr_x(1, 23, 304));\n    move_x(code, 0, 23);\n    arm64.assembler_bl(code, \"memory.goal\");\n    emit(code, arm64.ldr_x(0, 31, 8));\n    emit(code, arm64.ldr_x(30, 31, 0));\n    emit(code, arm64.add_imm_x(31, 31, 32, iie));\n    emit(code, arm64.ret());\n    arm64.assembler_label(code, \"memory_aftergc\");\n    emit(code, arm64.sub_imm_x(31, 31, 32, iie));\n    emit(code, arm64.str_x(30, 31, 0));\n    emit(code, arm64.str_x(0, 31, 8));\n    emit(code, arm64.str_x(31, 23, memory_GCActive));\n    emit(code, arm64.str_x(31, 23, memory_SystemNextQuery)); // a collection always refreshes the OS pressure level\n    arm64.assembler_bl(code, \"memory_sample\");\n    move_x(code, 0, 23);\n    emit(code, arm64.ldr_x(1, 23, 304));\n    emit(code, arm64.movz_x(2, 0, 0));\n    arm64.assembler_bl(code, \"memory.goal\");\n    emit(code, arm64.ldr_x(0, 31, 8));\n    emit(code, arm64.ldr_x(30, 31, 0));\n    emit(code, arm64.add_imm_x(31, 31, 32, iie));\n    emit(code, arm64.ret());\n}\n" }; }
