}\n            moshi (child < 0) { kaesu -1; }\n            p.flags[0] = frame.flags; array.truncate(frames, index); p.at[0] = p.at[0] + 1;\n            array.push(frames[index - 1].items, repetition(p, child)); tsuzuku;\n        }\n        kaku item = atom(p); moshi (item < 0) { kaesu -1; }\n        array.push(frame.items, repetition(p, item));\n    }\n    kaesu -1;\n}\n\nwaza state(states: []State, op: int64, out: int64, other: int64, ranges: []int64) -> int64 {\n    kaku id = len(states); array.push(states, State { op: op, out: out, other: other, ranges: ranges }); kaesu id;\n}\nwaza patch(states: []State, ends: []int64, target: int64) -> unit {\n    kaku at = 0;\n    aida (at < len(ends)) {\n        kaku id = ends[at] / 2; kaku port = ends[at] - id * 2; kaku old = states[id]; kaku out = old.out; kaku other = old.other;\n        moshi (port == 0) { out = target; } sore { other = target; }\n        states[id] = State { op: old.op, out: out, other: other, ranges: old.ranges }; at = at + 1;\n    }\n}\nwaza compile_node(p: Parser, id: int64, states: []State) -> Fragment {\n    moshi (id < 0 || len(states) > 3355443) { fail(p, \"regexp program size limit\"); kaesu Fragment { start: -1, ends: [] }; }\n    kaku item = p.nodes[id];\n    moshi (item.op == 14) { kaesu compile_node(p, item.a, states); }\n    moshi (item.op <= 10) {\n        kaku op = item.op; moshi (op == 0) { op = 4; }\n        kaku start = state(states, op, -1, -1, item.ranges); kaesu Fragment { start: start, ends: [start * 2] };\n    }\n    moshi (item.op == 11 || item.op == 12) {\n        kaku left = compile_node(p, item.a, states); kaku right = compile_node(p, item.b, states);\n        moshi (item.op == 11) { patch(states, left.ends, right.start); kaesu Fragment { start: left.start, ends: right.ends }; }\n        kaku start = state(states, 11, left.start, right.start, []); kaku ends = array.clone(left.ends); array.append_all(ends, right.ends); kaesu Fragment { start: start, ends: ends };\n    }\n    kaku start = state(states, 4, -1, -1, []); kaku ends: []int64 = [start * 2]; kaku at = 0;\n    aida (at < item.low && p.error[0] == \"\") { kaku next = compile_node(p, item.a, states); patch(states, ends, next.start); ends = next.ends; at = at + 1; }\n    moshi (item.high < 0 && p.error[0] == \"\") {\n        kaku child = compile_node(p, item.a, states); kaku split = state(states, 11, child.start, -1, []); patch(states, ends, split); patch(states, child.ends, split); ends = [split * 2 + 1];\n    }\n    sore { aida (at < item.high && p.error[0] == \"\") {\n        kaku child = compile_node(p, item.a, states); kaku split = state(states, 11, child.start, -1, []); patch(states, ends, split); ends = array.clone(child.ends); array.push(ends, split * 2 + 1); at = at + 1;\n    } }\n    kaesu Fragment { start: start, ends: ends };\n}\n\nkoukai waza compile(pattern: string) -> Program {\n    moshi (string.byte_len(pattern) > 33554432) { kaesu Program { states: [], start: -1, error: \"regexp size limit\" }; }\n    kaku p = Parser { input: runes(pattern), at: [0], flags: [0], quoted: [iie], nodes: [], heights: [], folds: [], error: [\"\"] };\n    kaku root = parse_expression(p); moshi (p.at[0] != len(p.input)) { fail(p, \"unexpected closing parenthesis\"); }\n    kaku states: []State = []; kaku fragment = Fragment { start: -1, ends: [] };\n    moshi (p.error[0] == \"\") { fragment = compile_node(p, root, states); }\n    moshi (p.error[0] != \"\") { kaesu Program { states: [], start: -1, error: p.error[0] }; }\n    kaku accepted = state(states, 0, -1, -1, []); patch(states, fragment.ends, accepted);\n    kaesu Program { states: states, start: fragment.start, error: \"\" };\n}\nwaza word(value: int64) -> bool { kaesu is_digit(value) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95; }\nwaza closure(program: Program, id: int64, position: int64, input: []int64, seen: []int64, epoch: int64, active: []int64) -> unit {\n    kaku stack: []int64 = [id];\n    