fail(p, \"invalid ASCII character class\"); nukeru; }\n                named = folded(p, named); moshi (neg) { named = invert(named); } array.append_all(ranges, named); p.at[0] = end + 2; tsuzuku;\n            }\n        }\n        kaku term = Term { ranges: [], scalar: -1 };\n        moshi (current(p) == 92) { term = escaped(p); }\n        sore { kaku value = current(p); p.at[0] = p.at[0] + 1; term = Term { ranges: [value,value], scalar: value }; }\n        moshi (term.scalar < 0) { array.append_all(ranges, term.ranges); tsuzuku; }\n        kaku low = term.scalar; kaku high = low;\n        moshi (current(p) == 45 && look(p, 1) != 93 && look(p, 1) >= 0) {\n            p.at[0] = p.at[0] + 1;\n            moshi (current(p) == 92) { kaku last = escaped(p); high = last.scalar; }\n            sore { high = current(p); p.at[0] = p.at[0] + 1; }\n            moshi (high < low) { fail(p, \"invalid character range\"); nukeru; }\n        }\n        array.append_all(ranges, folded(p, [low,high]));\n    }\n    moshi (current(p) != 93) { fail(p, \"unterminated character class\"); } sore { p.at[0] = p.at[0] + 1; }\n    ranges = clean(ranges); moshi (negative) { ranges = invert(ranges); }\n    kaesu node(p, 1, -1, -1, 0, 0, ranges);\n}\nwaza group_header(p: Parser) -> int64 {\n    kaku capturing = hai;\n    p.at[0] = p.at[0] + 1;\n    moshi (current(p) == 63) {\n        capturing = iie;\n        p.at[0] = p.at[0] + 1;\n        moshi (current(p) == 80 && look(p, 1) == 60) { p.at[0] = p.at[0] + 1; }\n        moshi (current(p) == 60) {\n            capturing = hai;\n            p.at[0] = p.at[0] + 1; kaku count = 0;\n            aida (current(p) != 62 && current(p) >= 0) {\n                kaku value = current(p); moshi (!(is_digit(value) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95)) { fail(p, \"invalid capture name\"); nukeru; }\n                p.at[0] = p.at[0] + 1; count = count + 1;\n            }\n            moshi (count == 0 || current(p) !=