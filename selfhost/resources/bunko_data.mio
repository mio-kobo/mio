t(code,arm64.add_x(9,3,3)); emit(code,arm64.add_imm_x(9,9,3072,iie)); emit(code,arm64.add_x(9,9,11)); emit(code,arm64.str_x(9,23,memory_Reserved));\n emit(code,arm64.ldr_x(9,23,memory_Reserved)); emit(code,arm64.movz_x(10,16383,0)); emit(code,arm64.add_x(9,9,10)); emit(code,arm64.movn_x(10,16383,0)); emit(code,arm64.and_x(9,9,10)); emit(code,arm64.str_x(9,23,memory_Reserved)); emit(code,arm64.ldr_x(10,23,memory_Committed)); emit(code,arm64.cmp_x(10,9)); arm64.assembler_b_cond(code,9,\"memory_charge_bounded\"); emit(code,arm64.str_x(9,23,memory_Committed));\n arm64.assembler_label(code,\"memory_charge_bounded\");\n move_x(code,0,23); emit(code,arm64.ldr_x(1,23,304)); emit(code,arm64.ldr_x(2,23,296)); observation_word(code,3577470980); emit(code,arm64.ldr_x(5,23,872)); emit(code,arm64.ldr_x(6,23,2800));\n arm64.assembler_bl(code,\"memory.update\");\n emit(code,arm64.ldr_x(9,23,memory_Goal)); arm64.assembler_cbnz_x(code,9,\"memory_sample_done\");\n move_x(code,0,23); emit(code,arm64.movz_x(1,0,0)); emit(code,arm64.movz_x(2,0,0)); arm64.assembler_bl(code,\"memory.goal\");\n arm64.assembler_label(code,\"memory_sample_done\"); emit(code,arm64.ldr_x(0,31,8)); emit(code,arm64.ldr_x(30,31,0)); emit(code,arm64.add_imm_x(31,31,32,iie)); emit(code,arm64.ret());\n arm64.assembler_label(code,\"memory_grow\"); // payload request in x0\n emit(code,arm64.sub_imm_x(31,31,32,iie)); emit(code,arm64.str_x(30,31,0)); emit(code,arm64.str_x(0,31,8));\n emit(code,arm64.add_imm_x(2,0,31,iie)); emit(code,arm64.movn_x(9,15,0)); emit(code,arm64.and_x(2,2,9)); emit(code,arm64.ldr_x(1,23,304)); move_x(code,0,23); arm64.assembler_bl(code,\"memory.goal\");\n emit(code,arm64.ldr_x(0,31,8)); emit(code,arm64.ldr_x(30,31,0)); emit(code,arm64.add_imm_x(31,31,32,iie)); emit(code,arm64.ret());\n arm64.assembler_label(code,\"memory_aftergc\");\n emit(code,arm64.sub_imm_x(31,31,32,iie)); emit(code,arm64.str_x(30,31,0)); emit(code,arm64.str_x(0,31,8)); emit(code,arm64.str_x(31,23,memory_GCActive)); arm64.ass