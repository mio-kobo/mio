ocation entry in addition to the ordinary bounded-heap retry.\nkoukai waza compile_gc_stress(file: mochi.File) -> LowerResult { kaesu compile_impl(file, hai, runtime_default_heap_bytes, iie); }\n\n// Explicit bounded target capacity; does not change the seed builder's heap.\nkoukai waza compile_with_heap(file: mochi.File, capacity: int64, gc_stress: bool) -> LowerResult {\n    kaesu compile_impl(file, gc_stress, capacity, iie);\n}\n\n// Observation is opt-in. Existing entry points keep the M18 emitted runtime.\nkoukai waza compile_with_observation(file: mochi.File, capacity: int64, gc_stress: bool) -> LowerResult {\n    kaesu compile_impl(file, gc_stress, capacity, hai);\n}\n\n// Internal automatic budget entry, no new CLI option or bootstrap protocol.\nkoukai waza compile_with_adaptive_heap(file: mochi.File, maximum: int64, gc_stress: bool, observation: bool) -> LowerResult {\n kaesu compile_memory_impl(file,gc_stress,maximum,observation,hai);\n}\nwaza compile_impl(file: mochi.File, gc_stress: bool, capacity: int64, observation: bool) -> LowerResult {\n kaesu compile_memory_impl(file,gc_stress,capacity,observation,iie);\n}\nkoukai waza compile_with_memory_budget(file: mochi.File, hard_cap: int64, gc_stress: bool, observation: bool) -> LowerResult {\n moshi (hard_cap < 114688) { kaesu failed(LowerError.InvalidOperand(1)); }\n kaku capacity=((hard_cap-65536)/3/16384)*16384;\n moshi (capacity>runtime_max_heap_bytes) { capacity=runtime_max_heap_bytes; }\n kaesu compile_memory_impl(file,gc_stress,capacity,observation,iie);\n}\nwaza instruction_error(file: mochi.File) -> LowerError? {\n    kaku function = -1;\n    aida (function < len(file.functions)) {\n        kaku data = file.instructions; moshi (function >= 0) { data = file.functions[function].instructions; }\n        kaku at = 0;\n        aida (at < len(data)) {\n            kaku opcode = int64(data[at]); kaku width = types.type_instruction_width(opcode);\n            moshi (width <= 0 || (opcode == 66 && file.version < 15) || (opcode == 67 && file.version < 16)) { kaesu LowerError.UnsupportedOpcode((function + 1) * 1000000 + at * 100 + opcode); }\n            moshi (width > len(data) - at) { kaesu LowerError.InvalidOperand((function + 1) * 1000000 + at * 100 + opcode); }\n            moshi(opcode==67 && data[at+3]>uint8(1)){kaesu LowerError.InvalidOperand((function+1)*1000000+at*100+opcode);}\n            at = at + width;\n        }\n        function = function + 1;\n    }\n    kaesu mu;\n}\nwaza compile_memory_impl(input_file: mochi.File, gc_stress: bool, capacity: int64, observation: bool, adaptive: bool) -> LowerResult {\n    kaesu compile_roots_impl(input_file,gc_stress,capacity,observation,adaptive,iie);\n}\n// Internal E3 integration path. Link with darwin.executable_appended using\n// thread_symbols() and attached_root_words; no language/API thread support is\n// implied. Legacy compile entry points preserve their emitted ABI and bytes.\nkoukai waza compile_with_attached_roots(file:mochi.File,capacity:int64,gc_stress:bool) -> LowerResult {\n    kaesu compile_roots_impl(file,gc_stress,capacity,iie,iie,hai);\n}\nwaza compile_roots_impl(input_file: mochi.File, gc_stress: bool, capacity: int64, observation: bool, adaptive: bool, attached:bool) -> LowerResult {\n    kaesu compile_worker_impl(input_file,gc_stress,capacity,observation,adaptive,attached,[],iie,32768,iie,iie);\n}\n// Internal native startup bridge: explicit function IDs for start, join, wait,\n// collect. Ordinary user closures still use normal solved native codegen; no\n// user Root API is involved. This is not an enabled concurrent Old collector.\nkoukai waza compile_with_worker_bridge(file:mochi.File,capacity:int64,gc_stress:bool,bindings:[]int64) -> LowerResult {\n    moshi(len(bindings)!=4){kaesu failed(LowerError.InvalidFunction());}\n    kaku i=0;aida(i<4){\n        kaku id=bindings[i];moshi(id<0 || id>=len(file.functions)){kaesu failed(LowerError.InvalidFunction());}\n        kaku f=file.functions[id];m