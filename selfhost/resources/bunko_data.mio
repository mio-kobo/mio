 moshi (opcode == 57) { descriptor = operand; }\n            kaku inferred = array_inferred_descriptor(type_result, after[len(after) - 1]);\n            moshi (descriptor == 0) { descriptor = inferred; }\n            moshi (inferred < 0 || array_descriptor_width(descriptor) != array_descriptor_width(inferred) || array_descriptor_reference(descriptor) != array_descriptor_reference(inferred)) { kaesu LowerError.UnsafeType((function_id + 1) * 1000000 + offset * 100 + opcode); }\n            kaku working = operand_entries(entries);\n            kaku element = types.type_array_element(type_result.arena, after[len(after) - 1]);\n            kaku first = len(working);\n            moshi (opcode == 30 || opcode == 56) { first = first - operand; }\n            moshi (opcode == 57) { first = first - 1; }\n            kaku at = first;\n            aida (at < len(working)) {\n                moshi (!emit_array_operand(code, patches, type_result, function_id, working, at, element)) { kaesu LowerError.UnsafeType((function_id + 1) * 1000000 + offset * 100 + opcode); }\n                at = at + 1;\n            }\n            moshi (!emit_array_construct(code, patches, type_result, function_id, working, opcode, operand, descriptor)) { kaesu LowerError.UnsafeType((function_id + 1) * 1000000 + offset * 100 + opcode); }\n        }\n        moshi (opcode == 33 || opcode == 35) {\n            kaku working = operand_entries(type_result.blocks[function_id + 1].entry[offset]);\n            kaku element = types.type_array_element(type_result.arena, working[len(working) - 3]);\n            moshi (!emit_array_operand(code, patches, type_result, function_id, working, len(working) - 1, element)) { kaesu LowerError.UnsafeType((function_id + 1) * 1000000 + offset * 100 + opcode); }\n            emit_set_index(code, type_result, working[len(working) - 2]);\n        }\n        moshi (opcode == 55) {\n            moshi (operand < 1 || operand > 7) { kaesu LowerError.InvalidOperand(offset); }\n            pop_register(code, 9);\n            kaku entries = type_result.blocks[function_id + 1].entry[offset];\n            emit_unbox_register(code, type_result, entries[len(entries) - 1], 9);\n            moshi (operand != 4) {\n                kaku maximum = 127; kaku minimum = 128;\n                moshi (operand == 2) { maximum = 32767; minimum = 32768; }\n                moshi (operand == 3) { maximum = 2147483647; minimum = 2147483648; }\n                moshi (operand >= 5) { minimum = 0; maximum = 255; }\n                moshi (operand == 6) { maximum = 65535; }\n                moshi (operand == 7) { maximum = 4294967295; }\n                moshi (minimum > 0) { move_bits(code, 10, uint32(4294967295), uint32(4294967296 - minimum)); }\n                sore { move_bits(code, 10, uint32(0), uint32(0)); }\n                emit(code, arm64.cmp_x(9, 10)); arm64.assembler_b_cond(code, 11, \"runtime_error\");\n                move_bits(code, 10, uint32(0), uint32(maximum)); emit(code, arm64.cmp_x(9, 10)); arm64.assembler_b_cond(code, 12, \"runtime_error\");\n            }\n            push_register(code, 9);\n        }\n        moshi (opcode == 58) {\n            kaku entries = type_result.blocks[function_id + 1].entry[offset];\n            kaku after = type_result.blocks[function_id + 1].entry[offset + instruction_width];\n            kaku descriptor = operand;\n            kaku inferred = array_inferred_descriptor(type_result, after[len(after) - 1]);\n            moshi (descriptor == 0) { descriptor = inferred; }\n            moshi (inferred < 0 || array_descriptor_width(descriptor) != array_descriptor_width(inferred) || array_descriptor_reference(descriptor) != array_descriptor_reference(inferred)) { kaesu LowerError.UnsafeType((function_id + 1) * 1000000 + offset * 100 + opcode); }\n            moshi (!emit_array_with_capacity(code, patches, type_result, function_id, entries, descriptor, entries[len(entries) - 1])) { kaesu LowerError.UnsafeType((function_id + 1) * 1000000 + offset * 100 + opcode); }\n        }\n        moshi (opcode == 59 || opcode == 64 || opcode == 61 || opcode == 63) {\n            kaku entries = type_result.blocks[function_id + 1].entry[offset];\n            kaku working = operand_entries(entries);\n            moshi (opcode == 59) {\n                kaku element = types.type_array_element(type_result.arena, working[len(working) - 2]);\n                moshi (!emit_array_operand(code, patches, type_result, function_id, working, len(working) - 1, element)) { kaesu LowerError.UnsafeType((function_id + 1) * 1000000 + offset * 100 + opcode); }\n            }\n            moshi (!emit_array_mutation(code, patches, type_result, function_id, working, opcode)) { kaesu LowerError.UnsafeType((function_id + 1) * 1000000 + offset * 100 + opcode); }\n        }\n        moshi (opcode == 60) { pop_register(code, 9); arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.ldr_x(9, 9, 16)); push_register(code, 9); }\n        moshi (opcode == 26 || opcode == 27) {\n            moshi (function_id < 0) { kaesu LowerError.InvalidFunction(); }\n            moshi (opcode == 27) { pop_register(code, 0); }\n            arm64.assembler_b(code, function_end_label(function_id));\n        }\n        kaku next_offset = offset + instruction_width;\n        moshi (is_raw_producer(opcode) && next_offset <= len(data)) {\n            kaku after = type_result.blocks[function_id + 1].entry[next_offset];\n            moshi (len(after) > 0 && is_nullable_scalar(type_result, after[len(after) - 1])) {\n                moshi (!emit_nullable_box(code, patches, type_result, function_id, after)) {\n                    kaesu LowerError.UnsafeType((function_id + 1) * 1000000 + offset * 100 + opcode);\n                }\n            }\n        }\n        offset = offset + instruction_width;\n    }\n    arm64.assembler_label(code, block_label(prefix, len(data)));\n    kaesu mu;\n}\n\n// Match the CLI's basic-value display rules for ordinary expressions.\n// Composite results are errors, never addresses printed as integers.\nwaza emit_last_result(code: arm64.Assembler) -> unit {\n    move_x(code, 0, 25);\n    emit(code, arm64.cmp_imm_x(26, 128, iie)); arm64.assembler_b_cond(code, 3, \"last_result_dispatch\");\n    emit(code, arm64.sub_imm_x(26, 26, 128, iie)); arm64.assembler_cbz_x(code, 0, \"last_result_nil\");\n    emit(code, arm64.cmp_imm_x(26, 5, iie)); arm64.assembler_b_cond(code, 2, \"last_result_dispatch\");\n    emit(code, arm64.ldr_x(0, 0, 8));\n    arm64.assembler_label(code, \"last_result_dispatch\");\n    emit(code, arm64.cmp_imm_x(26, 1, iie)); arm64.assembler_b_cond(code, 0, \"last_result_integer\");\n    emit(code, arm64.cmp_imm_x(26, 2, iie)); arm64.assembler_b_cond(code, 0, \"last_result_float32\");\n    emit(code, arm64.cmp_imm_x(26, 3, iie)); arm64.assembler_b_cond(code, 0, \"last_result_float64\");\n    emit(code, arm64.cmp_imm_x(26, 4, iie)); arm64.assembler_b_cond(code, 0, \"last_result_bool\");\n    emit(code, arm64.cmp_imm_x(26, 5, iie)); arm64.assembler_b_cond(code, 0, \"last_result_string\");\n    emit(code, arm64.cmp_imm_x(26, 10, iie)); arm64.assembler_b_cond(code, 0, \"last_result_nil\");\n    // An unsupported display is a runtime error just as in the reference CLI.\n    kaku message = string.to_bytes(\"cannot display composite runtime value\\n\");\n    adjust_sp(code, 64, hai); kaku at = 0;\n    aida (at < len(message)) { emit(code, arm64.movz_x(9, int64(message[at]), 0)); emit(code, arm64.strb_w(9, 31, at)); at = at + 1; }\n    emit(code, arm64.movz_x(0, 2, 0)); emit(code, arm64.add_imm_x(1, 31, 0, iie)); emit(code, arm64.movz_x(2, len(message), 0)); emit(code, arm64.movz_x(16, 4, 0)); emit(code, arm64.svc(128)); adjust_sp(code, 64, iie); arm64.assembler_b(code, \"runtime_error\");\n    arm64.assembler_label(code, \"last_result_integer\"); arm64.assembler_bl(code, \"print_int64\"); arm64.assembler_b(code, \"normal_exit\");\n    arm64.assembler_label(code, \"last_result_float32\"); emit(code, arm64.movz_x(1, 3, 0)); arm64.assembler_bl(code, \"print_float\"); arm64.assembler_b(code, \"normal_exit\");\n    arm64.assembler_label(code, \"last_result_float64\"); emit(code, arm64.movz_x(1, 4, 0)); arm64.assembler_bl(code, \"print_float\"); arm64.assembler_b(code, \"normal_exit\");\n    arm64.assembler_label(code, \"last_result_bool\"); arm64.assembler_bl(code, \"print_bool\"); arm64.assembler_b(code, \"normal_exit\");\n    arm64.assembler_label(code, \"last_result_string\"); arm64.assembler_bl(code, \"print_string\"); arm64.assembler_b(code, \"normal_exit\");\n    arm64.assembler_label(code, \"last_result_nil\"); arm64.assembler_bl(code, \"print_nil\"); arm64.assembler_b(code, \"normal_exit\");\n}\n\nwaza emit_main_prologue(code: arm64.Assembler) -> unit {\n    emit(code, arm64.sub_imm_x(31, 31, 4080, iie));\n    emit(code, arm64.add_imm_x(19, 31, 0, iie));\n    emit(code, arm64.movz_x(20, 0, 0));\n    emit(code, arm64.movz_x(26, 0, 0));\n    emit(code, arm64.movz_x(22, 0, 0));\n}\n\nwaza emit_function_prologue(code: arm64.Assembler, function: mochi.Function) -> LowerError? {\n    moshi (function.local_count > 256 || function.parameter_count > 256) { kaesu LowerError.FrameTooLarge(); }\n    emit(code, arm64.stp_pre_x(29, 30, 31, -16));\n    emit(code, arm64.add_imm_x(29, 31, 0, iie));\n    emit(code, arm64.stp_pre_x(19, 20, 31, -16));\n    emit(code, arm64.stp_pre_x(21, 22, 31, -16));\n    emit(code, arm64.stp_pre_x(25, 26, 31, -16));\n    emit(code, arm64.sub_imm_x(31, 31, 4080, iie));\n    emit(code, arm64.sub_imm_x(31, 31, 2048, iie));\n    emit(code, arm64.add_imm_x(21, 31, 2048, iie));\n    emit(code, arm64.add_imm_x(19, 21, 2048, iie));\n    emit(code, arm64.movz_x(20, 0, 0));\n    kaku index = 0;\n    aida (index < function.local_count) { emit(code, arm64.str_x(31, 21, index * 8)); cell_address(code, index); emit(code, arm64.str_x(31, 8, 0)); index = index + 1; }\n    index = 0;\n    aida (index < function.parameter_count) {\n    