waza data_42() -> File { kaesu File { path: "kiso/aot/lowerwinrt/runtime_objects.mio", version: "Bunko-v2.1.1", length: 21964, sha256: "03b27a68a57e57e47f3a27b98e2a5957b5df52a246a74ff42f66f290491f5dd2", source: "yobu \"kiso/aot/elf\";\nyobu \"kiso/aot/x86_64\";\n\n// Linux object model (all words are 64-bit; every heap object starts with\n// [0] header = kind | total_bytes << 8, [8] GC word).\n//   kind 1 struct, kind 2 enum:  [16] payload count, [24] reference bitmap, [32] enum tag, [40 + 8i] payload i\n//   kind 3 array:                [16] length, [24] capacity, [32] width | reference << 8, [40] data pointer\n//   kind 4 byte backing, kind 5 word backing (data starts at +16 of the backing object)\n//   kind 6 string:               [16] byte length, [24 ...] bytes\nwaza object_kind_struct() -> int64 { kaesu 1; }\nwaza object_kind_enum() -> int64 { kaesu 2; }\nwaza object_kind_array() -> int64 { kaesu 3; }\n\nwaza trap_check(code: x86_64.Assembler, condition: int64, label: string) -> unit { x86_64.jcc(code, condition, label); }\n\n// round rax up to a multiple of 8\nwaza round8(code: x86_64.Assembler, reg: int64) -> unit {\n    x86_64.add_ri(code, reg, 7);\n    x86_64.and_ri(code, reg, -8);\n}\n\n// rt.array_new: rdi = length, rsi = capacity, rdx = element width (1 or 8), r8 = 1 when elements are references.\n// Returns the array in rax. Negative or too large sizes trap.\nwaza emit_array_new(code: x86_64.Assembler) -> unit {\n    x86_64.label(code, \"rt.array_new\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.trap.index\");\n    x86_64.cmp_rr(code, x86_64.rsi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.trap.index\");\n    x86_64.mov_ri(code, x86_64.rax, 134217728);\n    x86_64.cmp_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_g, \"rt.trap.memory\");\n    x86_64.push_r(code, x86_64.rdi);\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.push_r(code, x86_64.rdx);\n    x86_64.push_r(code, x8