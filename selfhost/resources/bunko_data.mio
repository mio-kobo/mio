waza data_56() -> File { kaesu File { path: "kiso/aot/lowerwinrt/runtime_socket.mio", version: "Bunko-v2.1.1", length: 29211, sha256: "a20a3cb196ab2c199a706da8057dc82d675eb844869de47ffe3d3258fe6149cf", source: "yobu \"kiso/aot/pe\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// The PE writer numbers IAT entries across libraries. Winsock follows KERNEL32.\nteisu import_wsa_startup = 31;\nteisu import_wsa_cleanup = 32;\nteisu import_wsa_error = 33;\nteisu import_wsa_socket = 34;\nteisu import_socket_option = 35;\nteisu import_socket_bind = 36;\nteisu import_socket_connect = 37;\nteisu import_socket_listen = 38;\nteisu import_socket_accept = 39;\nteisu import_socket_recv = 40;\nteisu import_socket_send = 41;\nteisu import_socket_close = 42;\nteisu import_socket_ioctl = 43;\nteisu import_socket_getsockopt = 44;\nteisu socket_state = 20; // 20 open, 20 + status failed. File states occupy 1 through 17.\n\nwaza winsock_imports() -> pe.ImportLibrary {\n    kaesu pe.ImportLibrary { name: \"WS2_32.dll\", symbols: [\n            \"WSAStartup\", \"WSACleanup\", \"WSAGetLastError\", \"WSASocketW\", \"setsockopt\",\n            \"bind\", \"connect\", \"listen\", \"accept\", \"recv\", \"send\", \"closesocket\", \"ioctlsocket\", \"getsockopt\"] };\n}\n\nwaza winsock_started_cell() -> int64 { kaesu gc_state() + 104; }\n\n// Mio's internal calls can enter with either stack alignment. Reserve the Win64 shadow\n// space (and any stack arguments) below the rbp-relative locals.\nwaza socket_frame(code: x86_64.Assembler, name: string, bytes: int64) -> int64 {\n    kaku begin = open_frame(code, name, 0);\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    x86_64.sub_ri(code, x86_64.rsp, bytes);\n    kaesu begin;\n}\n\nwaza socket_status_label(code: int64) -> string {\n    kaesu string.concat(\"rt.sock.message.\", convert.format_int(code));\n}\n\nwaza emit_socket_status(code: x86_64.Assembler) -> unit {\n    kaku messages: []string = [\"\", \"invalid argument\", \"socket closed\", \"connection timed out\",\n        \"connection refused\", \"connection reset\", \"address already in use\", \"permission denied\",\n        \"operation would block\", \"socket error\"];\n    kaku at = 0;\n    aida (at < len(messages)) {\n        emit_string_object(code, socket_status_label(at), messages[at]);\n        at = at + 1;\n    }\n\n    // rt.sock_message: rax = code -> rax = message string\n    x86_64.label(code, \"rt.sock_message\");\n    at = 0;\n    aida (at < 9) {\n        kaku next = string.concat(\"rt.sock_message.next.\", convert.format_int(at));\n        x86_64.cmp_ri(code, x86_64.rax, at);\n        x86_64.jcc(code, x86_64.cc_ne, next);\n        x86_64.lea_label(code, x86_64.rax, socket_status_label(at));\n        x86_64.ret(code);\n        x86_64.label(code, next);\n        at = at + 1;\n    }\n    x86_64.lea_label(code, x86_64.rax, socket_status_label(9));\n    x86_64.ret(code);\n\n    // rt.sock_status_one: rdi = status array (>= 1 byte), rsi = code -> rax = message\n    x86_64.label(code, \"rt.sock_status_one\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 40);\n    x86_64.mov_store8(code, x86_64.rax, 0, x86_64.rsi);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.jmp(code, \"rt.sock_message\");\n\n    // rt.sock_status_io: rdi = status array (10 bytes), rsi = count, rdx = eof, rcx = code -> rax = message\n    x86_64.label(code, \"rt.sock_status_io\");\n    x86_64.test_rr(code, x86_64.rdi, x86_64.rdi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rdi, 40);\n    x86_64.mov_store(code, x86_64.rax, 0, x86_64.rsi);\n    x86_64.mov_store8(code, x86_64.rax, 8, x86_64.rdx);\n    x86_64.mov_store8(code, x86_64.rax, 9, x86_64.rcx);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.jmp(code, \"rt.sock_message\");\n\n    // rt.sock_status: rdi = token, rsi = status array -> message\n    x86_64.label(code, \"rt.sock_status\");\n    x86_64.push_r(code, x86_64.rsi);\n    x86_64.call(code, \"rt.sock_slot\");\n    x86_64.pop_r(code, x86_64.rdi);\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ge, \"rt.sock_status.go\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.label(code, \"rt.sock_status.go\");\n    x86_64.jmp(code, \"rt.sock_status_one\");\n}\n\nwaza emit_socket_errors(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    kaku begin = socket_frame(code, \"rt.sock_last_error\", 32);\n    import_call(code, ctx, import_wsa_error);\n    x86_64.zero_extend_eax(code);\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n\n    // Winsock errors -> kiso/net/tcp status byte. Network reset and shutdown are broken streams.\n    x86_64.label(code, \"rt.sock_classify\");\n    kaku errors: []int64 = [10022, 10047, 10009, 10038, 10060, 10061, 10052, 10053, 10054, 10058, 10048, 10013, 10035];\n    kaku statuses: []int64 = [1, 1, 2, 2, 3, 4, 5, 5, 5, 5, 6, 7, 8];\n    kaku at = 0;\n    aida (at < len(errors)) {\n        kaku next = string.concat(\"rt.sock_classify.next.\", convert.format_int(at));\n        x86_64.cmp_ri(code, x86_64.rax, errors[at]);\n        x86_64.jcc(code, x86_64.cc_ne, next);\n        x86_64.mov_ri(code, x86_64.rax, statuses[at]);\n        x86_64.ret(code);\n        x86_64.label(code, next);\n        at = at + 1;\n    }\n    x86_64.mov_ri(code, x86_64.rax, 9);\n    x86_64.ret(code);\n\n    // Win64 only defines the low 32 bits of int results. SOCKET results use all 64 bits.\n    x86_64.label(code, \"rt.sock_int_status\");\n    x86_64.zero_extend_eax(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.sock_int_status.done\");\n    x86_64.call(code, \"rt.sock_last_error\");\n    x86_64.jmp(code, \"rt.sock_classify\");\n    x86_64.label(code, \"rt.sock_int_status.done\");\n    x86_64.ret(code);\n}\n\nwaza emit_socket_resources(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    // rdi = Mio token -> slot pointer or negative status. Never use the SOCKET value as a status.\n    x86_64.label(code, \"rt.sock_slot\");\n    x86_64.call(code, \"rt.resource_lookup\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.sock_slot.closed\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 8);\n    x86_64.cmp_ri(code, x86_64.rcx, socket_state);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.sock_slot.closed\");\n    x86_64.jcc(code, x86_64.cc_e, \"rt.sock_slot.done\");\n    x86_64.mov_ri(code, x86_64.rax, socket_state);\n    x86_64.sub_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.label(code, \"rt.sock_slot.done\");\n    x86_64.ret(code);\n    x86_64.label(code, \"rt.sock_slot.closed\");\n    x86_64.mov_ri(code, x86_64.rax, -2);\n    x86_64.ret(code);\n\n    // rax = negative status -> token that preserves the failure until close.\n    x86_64.label(code, \"rt.sock_failed\");\n    x86_64.mov_ri(code, x86_64.rsi, socket_state);\n    x86_64.sub_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdi, -1);\n    x86_64.jmp(code, \"rt.fs_alloc\");\n\n    // rax = result of a SOCKET-producing call. INVALID_SOCKET is (UINT_PTR)-1.\n    kaku begin = socket_frame(code, \"rt.sock_wrap\", 48);\n    x86_64.cmp_ri(code, x86_64.rax, -1);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.sock_wrap.failed\");\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rax);\n    x86_64.mov_rr(code, x86_64.rdi, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, socket_state);\n    x86_64.call(code, \"rt.fs_alloc\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.sock_wrap.done\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -8);\n    import_call(code, ctx, import_socket_close);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.jmp(code, \"rt.sock_wrap.done\");\n    x86_64.label(code, \"rt.sock_wrap.failed\");\n    x86_64.call(code, \"rt.sock_last_error\");\n    x86_64.call(code, \"rt.sock_classify\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.call(code, \"rt.sock_failed\");\n    x86_64.label(code, \"rt.sock_wrap.done\");\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n\n    begin = socket_frame(code, \"rt.sock_close\", 48);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rsi);\n    x86_64.call(code, \"rt.resource_lookup\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.sock_close.closed\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rax, 8);\n    x86_64.cmp_ri(code, x86_64.rdx, socket_state);\n    x86_64.jcc(code, x86_64.cc_b, \"rt.sock_close.closed\");\n    // Invalidate the token before releasing the descriptor. Winsock may reuse it immediately.\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 0);\n    x86_64.mov_ri(code, x86_64.r8, 0);\n    x86_64.mov_store(code, x86_64.rax, 8, x86_64.r8);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.sock_close.done\");\n    import_call(code, ctx, import_socket_close);\n    x86_64.call(code, \"rt.sock_int_status\");\n    x86_64.jmp(code, \"rt.sock_close.done\");\n    x86_64.label(code, \"rt.sock_close.closed\");\n    x86_64.mov_ri(code, x86_64.rax, 2);\n    x86_64.label(code, \"rt.sock_close.done\");\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);\n    x86_64.call(code, \"rt.sock_status_one\");\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\nwaza emit_socket_open(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    // 32-byte shadow space plus room for the 64-bit WSADATA struct.\n    kaku begin = socket_frame(code, \"rt.sock_startup\", 448);\n    x86_64.mov_ri(code, x86_64.rcx, winsock_started_cell());\n    x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 0);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.sock_startup.ok\");\n    x86_64.mov_ri(code, x86_64.rcx, 514); // MAKEWORD(2, 2)\n    x86_64.lea(code, x86_64.rdx, x86_64.rsp, 32);\n    import_call(code, ctx, import_wsa_startup);\n    x86_64.zero_extend_eax(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.sock_startup.done\"); // WSAStartup returns its own error.\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 32);\n    x86_64.and_ri(code, x86_64.rax, 65535); // WSADATA.wVersion\n    x86_64.cmp_ri(code, x86_64.rax, 514);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.sock_startup.started\");\n    import_call(code, ctx, import_wsa_cleanup);\n    x86_64.mov_ri(code, x86_64.rax, 10092); // WSAVERNOTSUPPORTED\n    x86_64.jmp(code, \"rt.sock_startup.done\");\n    x86_64.label(code, \"rt.sock_startup.started\");\n    x86_64.mov_ri(code, x86_64.rcx, winsock_started_cell());\n    x86_64.mov_ri(code, x86_64.rax, 1);\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rax);\n    x86_64.label(code, \"rt.sock_startup.ok\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.label(code, \"rt.sock_startup.done\");\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n\n    begin = socket_frame(code, \"rt.sock_open\", 48);\n    x86_64.call(code, \"rt.sock_startup\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.sock_open.failed\");\n    x86_64.mov_ri(code, x86_64.rcx, 2); // AF_INET\n    x86_64.mov_ri(code, x86_64.rdx, 1); // SOCK_STREAM\n    x86_64.mov_ri(code, x86_64.r8, 6); // IPPROTO_TCP\n    x86_64.mov_ri(code, x86_64.r9, 0); // protocol info\n    x86_64.mov_ri(code, x86_64.rax, 0); // group\n    x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 128); // WSA_FLAG_NO_HANDLE_INHERIT\n    x86_64.mov_store(code, x86_64.rsp, 40, x86_64.rax);\n    import_call(code, ctx, import_wsa_socket);\n    x86_64.call(code, \"rt.sock_wrap\");\n    x86_64.jmp(code, \"rt.sock_open.done\");\n    x86_64.label(code, \"rt.sock_open.failed\");\n    x86_64.call(code, \"rt.sock_classify\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.call(code, \"rt.sock_failed\");\n    x86_64.label(code, \"rt.sock_open.done\");\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\n// rdi = token, rsi = address bytes, rdx = port, rcx = status array.\nwaza emit_socket_address(code: x86_64.Assembler, ctx: WinContext, name: string, binding: bool) -> unit {\n    kaku begin = socket_frame(code, name, 112);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rbp, -32, x86_64.rdx);\n    x86_64.call(code, \"rt.sock_slot\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".state\"));\n    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rbp, -40, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -24);\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, string.concat(name, \".invalid\"));\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsi, 16);\n    x86_64.cmp_ri(code, x86_64.rax, 4);\n    x86_64.jcc(code, x86_64.cc_ne, string.concat(name, \".invalid\"));\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -32);\n    x86_64.cmp_ri(code, x86_64.rdx, 0);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".invalid\"));\n    x86_64.cmp_ri(code, x86_64.rdx, 65535);\n    x86_64.jcc(code, x86_64.cc_g, string.concat(name, \".invalid\"));\n    // sockaddr_in: family (2 bytes), port big endian (2), address (4), zero padding (8)\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rsi, 40);\n    x86_64.mov_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.and_ri(code, x86_64.rax, 255);\n    x86_64.shl_ri(code, x86_64.rax, 8);\n    x86_64.shr_ri(code, x86_64.rdx, 8);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.shl_ri(code, x86_64.rax, 16);\n    x86_64.add_ri(code, x86_64.rax, 2);\n    kaku octet = 0;\n    aida (octet < 4) {\n        x86_64.mov_load8(code, x86_64.rcx, x86_64.rsi, octet);\n        x86_64.shl_ri(code, x86_64.rcx, 32 + 8 * octet);\n        x86_64.add_rr(code, x86_64.rax, x86_64.rcx);\n        octet = octet + 1;\n    }\n    x86_64.mov_store(code, x86_64.rbp, -64, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rbp, -56, x86_64.rax);\n    moshi (binding) {\n        // On Windows SO_REUSEADDR permits a second socket to take over a live port.\n        // Request exclusive bind instead. Windows controls when a closed port becomes reusable.\n        x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -40);\n        x86_64.mov_ri(code, x86_64.rdx, 65535); // SOL_SOCKET\n        x86_64.mov_ri(code, x86_64.r8, -5); // SO_EXCLUSIVEADDRUSE\n        x86_64.mov_ri(code, x86_64.rax, 1);\n        x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rax);\n        x86_64.lea(code, x86_64.r9, x86_64.rbp, -16);\n        x86_64.mov_ri(code, x86_64.rax, 4); // sizeof(BOOL)\n        x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rax);\n        import_call(code, ctx, import_socket_option);\n        x86_64.call(code, \"rt.sock_int_status\");\n        x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n        x86_64.jcc(code, x86_64.cc_ne, string.concat(name, \".done\"));\n    }\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -40);\n    x86_64.lea(code, x86_64.rdx, x86_64.rbp, -64);\n    x86_64.mov_ri(code, x86_64.r8, 16);\n    moshi (binding) { import_call(code, ctx, import_socket_bind); }\n    sore { import_call(code, ctx, import_socket_connect); }\n    x86_64.call(code, \"rt.sock_int_status\");\n    // A nonblocking connect reports WSAEWOULDBLOCK (status 8) while it is in progress: that is status 10 (in progress), not \"would block\".\n    moshi (!binding) {\n        x86_64.cmp_ri(code, x86_64.rax, 8);\n        x86_64.jcc(code, x86_64.cc_ne, string.concat(name, \".done\"));\n        x86_64.mov_ri(code, x86_64.rax, 10);\n    }\n    moshi (binding) {\n        // Exclusive TCP bind also reports WSAEACCES for overlapping wildcard\n        // listeners and reserved ports. Both mean the local endpoint is unavailable.\n        x86_64.cmp_ri(code, x86_64.rax, 7);\n        x86_64.jcc(code, x86_64.cc_ne, string.concat(name, \".done\"));\n        x86_64.mov_ri(code, x86_64.rax, 6);\n    }\n    x86_64.jmp(code, string.concat(name, \".done\"));\n    x86_64.label(code, string.concat(name, \".invalid\"));\n    x86_64.mov_ri(code, x86_64.rax, 1);\n    x86_64.jmp(code, string.concat(name, \".done\"));\n    x86_64.label(code, string.concat(name, \".state\"));\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.label(code, string.concat(name, \".done\"));\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);\n    x86_64.call(code, \"rt.sock_status_one\");\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\nwaza emit_socket_listen(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    kaku begin = socket_frame(code, \"rt.sock_listen\", 48);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rdx);\n    x86_64.call(code, \"rt.sock_slot\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.sock_listen.state\");\n    x86_64.cmp_ri(code, x86_64.rsi, 65535);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.sock_listen.invalid\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 0);\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rsi);\n    import_call(code, ctx, import_socket_listen);\n    x86_64.call(code, \"rt.sock_int_status\");\n    x86_64.jmp(code, \"rt.sock_listen.done\");\n    x86_64.label(code, \"rt.sock_listen.invalid\");\n    x86_64.mov_ri(code, x86_64.rax, 1);\n    x86_64.jmp(code, \"rt.sock_listen.done\");\n    x86_64.label(code, \"rt.sock_listen.state\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.label(code, \"rt.sock_listen.done\");\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);\n    x86_64.call(code, \"rt.sock_status_one\");\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n\n    begin = socket_frame(code, \"rt.sock_accept\", 32);\n    x86_64.call(code, \"rt.sock_slot\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.sock_accept.state\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_ri(code, x86_64.r8, 0);\n    import_call(code, ctx, import_socket_accept);\n    x86_64.call(code, \"rt.sock_wrap\");\n    x86_64.jmp(code, \"rt.sock_accept.done\");\n    x86_64.label(code, \"rt.sock_accept.state\");\n    x86_64.call(code, \"rt.sock_failed\");\n    x86_64.label(code, \"rt.sock_accept.done\");\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\n// rdi = token, rsi = bytes, rdx = offset, rcx = length, r8 = status array.\nwaza emit_socket_transfer(code: x86_64.Assembler, ctx: WinContext, name: string, reading: bool) -> unit {\n    kaku begin = socket_frame(code, name, 80);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rcx);\n    x86_64.mov_store(code, x86_64.rbp, -32, x86_64.r8);\n    x86_64.call(code, \"rt.sock_slot\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".state\"));\n    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rbp, -40, x86_64.rax);\n    // the whole byte range must lie inside the array, or nothing is touched\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rbp, -8);\n    x86_64.test_rr(code, x86_64.rsi, x86_64.rsi);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.nil\");\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rbp, -16);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -24);\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsi, 16);\n    x86_64.test_rr(code, x86_64.rdx, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".range\"));\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_l, string.concat(name, \".range\"));\n    x86_64.cmp_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_g, string.concat(name, \".range\"));\n    x86_64.sub_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.cmp_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_g, string.concat(name, \".range\"));\n    x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_e, string.concat(name, \".empty\"));\n    x86_64.mov_load(code, x86_64.rsi, x86_64.rsi, 40);\n    x86_64.add_rr(code, x86_64.rsi, x86_64.rdx);\n    // Winsock accepts an int length. A larger Mio request can complete as a short transfer.\n    x86_64.mov_rr(code, x86_64.r8, x86_64.rcx);\n    x86_64.cmp_ri(code, x86_64.r8, 2147483647);\n    x86_64.jcc(code, x86_64.cc_le, string.concat(name, \".length\"));\n    x86_64.mov_ri(code, x86_64.r8, 2147483647);\n    x86_64.label(code, string.concat(name, \".length\"));\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -40);\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.rsi);\n    x86_64.mov_ri(code, x86_64.r9, 0);\n    moshi (reading) { import_call(code, ctx, import_socket_recv); }\n    sore { import_call(code, ctx, import_socket_send); }\n    x86_64.zero_extend_eax(code);\n    x86_64.mov_ri(code, x86_64.rdx, 4294967295);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.rdx);\n    x86_64.jcc(code, x86_64.cc_e, string.concat(name, \".error\"));\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    moshi (reading) {\n        x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n        x86_64.jcc(code, x86_64.cc_ne, string.concat(name, \".status\"));\n        x86_64.mov_ri(code, x86_64.rdx, 1);\n    }\n    x86_64.jmp(code, string.concat(name, \".status\"));\n    x86_64.label(code, string.concat(name, \".error\"));\n    x86_64.call(code, \"rt.sock_last_error\");\n    x86_64.call(code, \"rt.sock_classify\");\n    x86_64.jmp(code, string.concat(name, \".no_bytes\"));\n    x86_64.label(code, string.concat(name, \".range\"));\n    x86_64.mov_ri(code, x86_64.rax, 1);\n    x86_64.jmp(code, string.concat(name, \".no_bytes\"));\n    x86_64.label(code, string.concat(name, \".state\"));\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.jmp(code, string.concat(name, \".no_bytes\"));\n    x86_64.label(code, string.concat(name, \".empty\"));\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.label(code, string.concat(name, \".no_bytes\"));\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.label(code, string.concat(name, \".status\"));\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -32);\n    x86_64.call(code, \"rt.sock_status_io\");\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\n// rt.sock_nonblock: rdi = token, rsi = 0 or 1, rdx = status array -> message. ioctlsocket(socket, FIONBIO, &enabled).\nwaza emit_socket_nonblock(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    // 96 bytes: the Win64 shadow space (32) and the stack argument slot sit below every local (-8 .. -32) whichever alignment the routine\n    // is entered with (socket_frame rounds rsp down to 16, which moves [rsp+32] by 8 bytes between the two cases).\n    kaku begin = socket_frame(code, \"rt.sock_nonblock\", 96);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rdx);\n    x86_64.call(code, \"rt.sock_slot\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.sock_nonblock.state\");\n    x86_64.cmp_ri(code, x86_64.rsi, 1);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.sock_nonblock.invalid\");\n    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rsi);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rax, 0);\n    x86_64.mov_ri(code, x86_64.rdx, 2147772030); // FIONBIO\n    x86_64.lea(code, x86_64.r8, x86_64.rbp, -24);\n    import_call(code, ctx, import_socket_ioctl);\n    x86_64.call(code, \"rt.sock_int_status\");\n    x86_64.jmp(code, \"rt.sock_nonblock.done\");\n    x86_64.label(code, \"rt.sock_nonblock.invalid\");\n    x86_64.mov_ri(code, x86_64.rax, 1);\n    x86_64.jmp(code, \"rt.sock_nonblock.done\");\n    x86_64.label(code, \"rt.sock_nonblock.state\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.label(code, \"rt.sock_nonblock.done\");\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);\n    x86_64.call(code, \"rt.sock_status_one\");\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\n// One getsockopt(socket, SOL_SOCKET, option, &value, &length) with value pre-set to 0 and length 4: rax = 0 on success (value at [rbp-24]),\n// otherwise the classified status. Uses the frame slots -16 (socket), -24 (value) and -32 (length).\nwaza emit_socket_option_call(code: x86_64.Assembler, ctx: WinContext, option: int64) -> unit {\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rbp, -24, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 4);\n    x86_64.mov_store(code, x86_64.rbp, -32, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, -16);\n    x86_64.mov_ri(code, x86_64.rdx, 65535); // SOL_SOCKET\n    x86_64.mov_ri(code, x86_64.r8, option);\n    x86_64.lea(code, x86_64.r9, x86_64.rbp, -24);\n    x86_64.lea(code, x86_64.rax, x86_64.rbp, -32);\n    x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rax);\n    import_call(code, ctx, import_socket_getsockopt);\n    x86_64.call(code, \"rt.sock_int_status\");\n}\n\n// rt.sock_finish: rdi = token, rsi = status array -> message. Completes a nonblocking connect: SO_ERROR holds the failure of a connect that\n// failed; otherwise SO_CONNECT_TIME is 0xFFFFFFFF while the socket is not connected yet (status 10, in progress, call again) and the\n// number of seconds since the connection was made once it is.\nwaza emit_socket_finish(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    // 96 bytes, see rt.sock_nonblock: with 64 the fifth getsockopt argument at [rsp+32] overlapped the length local at [rbp-32] when\n    // the routine was entered with the standard alignment.\n    kaku begin = socket_frame(code, \"rt.sock_finish\", 96);\n    x86_64.mov_store(code, x86_64.rbp, -8, x86_64.rsi);\n    x86_64.call(code, \"rt.sock_slot\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_l, \"rt.sock_finish.state\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rbp, -16, x86_64.rax);\n    emit_socket_option_call(code, ctx, 4103); // SO_ERROR 0x1007\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.sock_finish.done\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -24);\n    x86_64.mov_ri(code, x86_64.rcx, 4294967295);\n    x86_64.and_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.sock_finish.connected\");\n    x86_64.call(code, \"rt.sock_classify\");\n    x86_64.jmp(code, \"rt.sock_finish.done\");\n    x86_64.label(code, \"rt.sock_finish.connected\");\n    emit_socket_option_call(code, ctx, 28684); // SO_CONNECT_TIME 0x700C\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_ne, \"rt.sock_finish.done\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rbp, -24);\n    x86_64.mov_ri(code, x86_64.rcx, 4294967295);\n    x86_64.and_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.rcx);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.sock_finish.pending\");\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.jmp(code, \"rt.sock_finish.done\");\n    x86_64.label(code, \"rt.sock_finish.pending\");\n    x86_64.mov_ri(code, x86_64.rax, 10);\n    x86_64.jmp(code, \"rt.sock_finish.done\");\n    x86_64.label(code, \"rt.sock_finish.state\");\n    x86_64.neg_r(code, x86_64.rax);\n    x86_64.label(code, \"rt.sock_finish.done\");\n    x86_64.mov_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.mov_load(code, x86_64.rdi, x86_64.rbp, -8);\n    x86_64.call(code, \"rt.sock_status_one\");\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\nwaza emit_socket_runtime(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    emit_socket_status(code);\n    emit_socket_errors(code, ctx);\n    emit_socket_resources(code, ctx);\n    emit_socket_open(code, ctx);\n    emit_socket_address(code, ctx, \"rt.sock_bind\", hai);\n    emit_socket_address(code, ctx, \"rt.sock_connect\", iie);\n    emit_socket_listen(code, ctx);\n    emit_socket_transfer(code, ctx, \"rt.sock_read\", hai);\n    emit_socket_transfer(code, ctx, \"rt.sock_write\", iie);\n    emit_socket_nonblock(code, ctx);\n    emit_socket_finish(code, ctx);\n}\n\n// \"$mma::mio/sys/socket::<name>::<hash>\" -> routine, or \"\" when the function is not a socket primitive.\nwaza socket_routine(function_name: string) -> string {\n    kaku prefix = \"$mma::mio/sys/socket::\";\n    moshi (!string.has_prefix(function_name, prefix)) { kaesu \"\"; }\n    kaku bytes = string.to_bytes(function_name);\n    kaku at = string.byte_len(prefix);\n    kaku output: []uint8 = [];\n    aida (at < len(bytes) && bytes[at] != uint8(58)) {\n        array.push(output, bytes[at]);\n        at = at + 1;\n    }\n    kaku name = string.from_utf8(output);\n    moshi (name == mu) { kaesu \"\"; }\n    moshi (name == \"open\") { kaesu \"rt.sock_open\"; }\n    moshi (name == \"status\") { kaesu \"rt.sock_status\"; }\n    moshi (name == \"bind_ipv4\") { kaesu \"rt.sock_bind\"; }\n    moshi (name == \"connect_ipv4\") { kaesu \"rt.sock_connect\"; }\n    moshi (name == \"listen\") { kaesu \"rt.sock_listen\"; }\n    moshi (name == \"accept\") { kaesu \"rt.sock_accept\"; }\n    moshi (name == \"read\") { kaesu \"rt.sock_read\"; }\n    moshi (name == \"write\") { kaesu \"rt.sock_write\"; }\n    moshi (name == \"close\") { kaesu \"rt.sock_close\"; }\n    moshi (name == \"set_nonblocking\") { kaesu \"rt.sock_nonblock\"; }\n    moshi (name == \"finish_connect\") { kaesu \"rt.sock_finish\"; }\n    kaesu \"\";\n}\n" }; }
waza data_57() -> File { kaesu File { path: "kiso/aot/lowerwinrt/winos.mio", version: "Bunko-v2.1.1", length: 58863, sha256: "4c96286cd9b43368f1fca534e6666f0308f3cf8475e082bc7145b51f68b54eaa", source: "yobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/pe\";\nyobu \"kiso/aot/x86_64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// Windows OS layer of the heap-capable lowering. The rest of the package is the Linux runtime (allocator, precise\n// collector, objects) with the ELF/syscall assumptions removed. Everything that touches Windows lives here:\n//  * fixed image base, no relocations: absolute data addresses are constants (data_base) fixed by a two-pass layout;\n//  * KERNEL32 imports are called through `call [rip+rel32]` patched by the PE writer (no DIR64 relocation needed);\n//  * every Win64 boundary routine is a frame-pointer function with unwind info, 16-byte realigned, 32-byte shadow space.\n// Imports (index): 0 GetStdHandle, 1 WriteFile, 2 ExitProcess, 3 VirtualAlloc, 4 CreateFileW, 5 ReadFile, 6 CloseHandle,\n// 7 MultiByteToWideChar, 8 GetLastError, 9 GetFileAttributesW, 10 CreateDirectoryW, 11 FindFirstFileW, 12 FindNextFileW,\n// 13 FindClose, 14 WideCharToMultiByte, 15 GetCommandLineW, 16 GetEnvironmentStringsW, 17 DeleteFileW, 18 RemoveDirectoryW,\n// 19 GetCurrentProcessId, 20 GetTickCount64, 21 GetFullPathNameW.\nkoukai teisu import_get_std_handle = 0;\nkoukai teisu import_write_file = 1;\nkoukai teisu import_exit_process = 2;\nkoukai teisu import_virtual_alloc = 3;\nkoukai teisu import_create_file = 4;\nkoukai teisu import_read_file = 5;\nkoukai teisu import_close_handle = 6;\nkoukai teisu import_multibyte = 7;\nkoukai teisu import_last_error = 8;\nkoukai teisu import_get_attributes = 9;\nkoukai teisu import_create_directory = 10;\nkoukai teisu import_find_first = 11;\nkoukai teisu import_find_next = 12;\nkoukai teisu import_find_close = 13;\nkoukai teisu import_wide_to_multibyte = 14;\nkoukai teisu import_command_line = 15;\nkoukai teisu import_environment_strings = 16;\nkoukai teisu import_delete_file = 17;\nkoukai teisu import_remove_directory = 18;\nkoukai teisu import_process_id = 19;\nkoukai teisu import_tick_count = 20;\nkoukai teisu import_full_path = 21;\n// 22 GetModuleFileNameW (executable path). Process layer (winprocess.mio): 23 CreateProcessW, 24 WaitForSingleObject,\n// 25 GetExitCodeProcess, 26 TerminateProcess, 27 GetStartupInfoW, 28 PeekNamedPipe, 29 GetFileType, 30 Sleep.\nkoukai teisu import_module_file = 22;\nkoukai teisu import_create_process = 23;\nkoukai teisu import_wait_object = 24;\nkoukai teisu import_exit_code = 25;\nkoukai teisu import_terminate_process = 26;\nkoukai teisu import_startup_info = 27;\nkoukai teisu import_peek_pipe = 28;\nkoukai teisu import_file_type = 29;\nkoukai teisu import_sleep = 30;\nkoukai teisu io_failure_exit = 111;\nkoukai teisu heap_reserve = 8589934592;\nkoukai teisu heap_first_commit = 16777216;\nkoukai teisu heap_commit_step = 16777216;\nkoukai teisu mark_stack_size = 536870912;\n\n// Packages cannot hold mutable globals, so the collected unwind records and patches travel in a context.\nkoukai kata WinContext {\n    patches: []pe.Patch;\n    frames: []pe.FrameFunction;\n    sockets: bool;\n}\n// .data is the first section, at RVA 0x1000 (pe.executable_placed data-first layout): every absolute data address is a\n// link-time constant and the image has no RVA gap.\nkoukai teisu data_rva = 4096;\nkoukai waza data_base() -> int64 { kaesu pe.image_base + data_rva; }\n// Scratch zone between the directory buffers and the Mochi globals (131072 bytes): +0 UTF-16 path buffer (64 KiB),\n// +65536 directory-enumeration state, 64 slots x 1024 bytes: [0] find handle (0 = free), [8] entry pending flag,\n// [16..608) WIN32_FIND_DATAW.\nwaza scratch_path() -> int64 { kaesu data_base() + 8192 + 2097152; }\nwaza dir_state() -> int64 { kaesu scratch_path() + 65536; }\n\nwaza open_frame(code: x86_64.Assembler, name: string, alloc: int64) -> int64 {\n    x86_64.label(code, name);\n    kaku begin = len(code.bytes);\n    x86_64.push_r(code, x86_64.rbp);\n    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);\n    moshi (alloc > 0) { x86_64.sub_ri(code, x86_64.rsp, alloc); }\n    kaesu begin;\n}\n\n// Prologue byte layout is fixed by the encoder: push rbp = 1, mov rbp,rsp = 3, sub rsp,imm32 = 7.\nwaza close_frame(code: x86_64.Assembler, ctx: WinContext, begin: int64, alloc: int64) -> unit {\n    kaku alloc_offset = 0;\n    moshi (alloc > 0) { alloc_offset = 11; }\n    array.push(ctx.frames, pe.FrameFunction { begin: begin, end: len(code.bytes), push_offset: 1, set_offset: 4,\n            alloc_offset: alloc_offset, alloc_size: alloc });\n}\n\nwaza emit_epilogue(code: x86_64.Assembler) -> unit {\n    x86_64.lea(code, x86_64.rsp, x86_64.rbp, 0);\n    x86_64.pop_r(code, x86_64.rbp);\n    x86_64.ret(code);\n}\n\n// call qword ptr [rip + IAT slot]; the rel32 is patched by the PE writer.\nwaza import_call(code: x86_64.Assembler, ctx: WinContext, index: int64) -> unit {\n    x86_64.byte(code, 255);\n    x86_64.byte(code, 21);\n    kaku at = len(code.bytes);\n    x86_64.byte(code, 0);\n    x86_64.byte(code, 0);\n    x86_64.byte(code, 0);\n    x86_64.byte(code, 0);\n    array.push(ctx.patches, pe.Patch {\n            section: pe.text_section, offset: at, kind: pe.rel32, target: pe.import_section, target_offset: index });\n}\n\n// rt.exit: rcx = status. Never returns.\nwaza emit_win_exit(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    kaku begin = open_frame(code, \"rt.exit\", 0);\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    x86_64.sub_ri(code, x86_64.rsp, 32);\n    moshi (ctx.sockets) {\n        x86_64.mov_ri(code, x86_64.rax, winsock_started_cell());\n        x86_64.mov_load(code, x86_64.rax, x86_64.rax, 0);\n        x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n        x86_64.jcc(code, x86_64.cc_e, \"rt.exit.process\");\n        x86_64.sub_ri(code, x86_64.rsp, 16);\n        x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rcx);\n        import_call(code, ctx, import_wsa_cleanup);\n        x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 32);\n        x86_64.label(code, \"rt.exit.process\");\n    }\n    import_call(code, ctx, import_exit_process);\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\n// rt.write: rcx = fd (1 or 2), rdx = pointer, r8 = length. Writes everything to the inherited synchronous handle;\n// any failure, zero progress or oversized count exits with 111. Preserves rsi, rdi, rbx (nonvolatile); clobbers the rest.\n// Frame after realignment: [0,32) shadow, +32 fifth argument, +40 bytes written, +48 handle, +56 cursor, +64 remaining.\nwaza emit_win_write(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    kaku begin = open_frame(code, \"rt.write\", 0);\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    x86_64.sub_ri(code, x86_64.rsp, 80);\n    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rsp, 64, x86_64.r8);\n    x86_64.cmp_ri(code, x86_64.rcx, 1);\n    x86_64.mov_ri(code, x86_64.rcx, 4294967285);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.handle\");\n    x86_64.mov_ri(code, x86_64.rcx, 4294967284);\n    x86_64.label(code, \"rt.write.handle\");\n    import_call(code, ctx, import_get_std_handle);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.cmp_ri(code, x86_64.rax, -1);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.mov_store(code, x86_64.rsp, 48, x86_64.rax);\n    x86_64.label(code, \"rt.write.again\");\n    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 64);\n    x86_64.test_rr(code, x86_64.r8, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.done\");\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 48);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 56);\n    x86_64.lea(code, x86_64.r9, x86_64.rsp, 40);\n    x86_64.mov_ri(code, x86_64.rax, 0);\n    x86_64.mov_store(code, x86_64.rsp, 40, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rax);\n    import_call(code, ctx, import_write_file);\n    x86_64.zero_extend_eax(code);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 40);\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.write.failure\");\n    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 64);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.r8);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.write.failure\");\n    x86_64.sub_rr(code, x86_64.r8, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 64, x86_64.r8);\n    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 56);\n    x86_64.add_rr(code, x86_64.rdx, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rdx);\n    x86_64.jmp(code, \"rt.write.again\");\n    x86_64.label(code, \"rt.write.done\");\n    emit_epilogue(code);\n    x86_64.label(code, \"rt.write.failure\");\n    x86_64.mov_ri(code, x86_64.rcx, io_failure_exit);\n    x86_64.call(code, \"rt.exit\");\n    close_frame(code, ctx, begin, 0);\n}\n\n// rt.virtual_alloc: rcx = address, rdx = size, r8 = allocation type, r9 = protection -> rax (0 on failure).\nwaza emit_win_virtual_alloc(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    kaku begin = open_frame(code, \"rt.virtual_alloc\", 0);\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    x86_64.sub_ri(code, x86_64.rsp, 32);\n    import_call(code, ctx, import_virtual_alloc);\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\n// rt.commit: rcx = address, rdx = size -> rax = nonzero on success. Preserves rsi, rdi.\nwaza emit_win_commit(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    kaku begin = open_frame(code, \"rt.commit\", 0);\n    x86_64.mov_ri(code, x86_64.r8, 4096);\n    x86_64.mov_ri(code, x86_64.r9, 4);\n    x86_64.call(code, \"rt.virtual_alloc\");\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\n// rt.init: reserve the 8 GiB heap and commit its first 16 MiB (more is committed by rt.alloc.grow); reserve and\n// commit the 512 MiB mark stack. Word layout matches the Linux runtime: data_base+0 heap_next, +8 end of COMMITTED\n// heap; collector state +24 heap base, +32/+48 mark stack top/base, +40 mark stack limit, +80 end of the reservation.\nwaza emit_win_init(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    kaku begin = open_frame(code, \"rt.init\", 0);\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.mov_ri(code, x86_64.rdx, heap_reserve);\n    x86_64.mov_ri(code, x86_64.r8, 8192);\n    x86_64.mov_ri(code, x86_64.r9, 4);\n    x86_64.call(code, \"rt.virtual_alloc\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.memory\");\n    x86_64.mov_ri(code, x86_64.rcx, data_base());\n    x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdx, gc_state());\n    x86_64.mov_store(code, x86_64.rdx, 24, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, heap_reserve);\n    x86_64.add_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rdx, 80, x86_64.rsi);\n    x86_64.mov_ri(code, x86_64.rsi, heap_first_commit);\n    x86_64.add_rr(code, x86_64.rsi, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rcx, 8, x86_64.rsi);\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rdx, heap_first_commit);\n    x86_64.call(code, \"rt.commit\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.memory\");\n    x86_64.mov_ri(code, x86_64.rcx, 0);\n    x86_64.mov_ri(code, x86_64.rdx, mark_stack_size);\n    x86_64.mov_ri(code, x86_64.r8, 12288);\n    x86_64.mov_ri(code, x86_64.r9, 4);\n    x86_64.call(code, \"rt.virtual_alloc\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.memory\");\n    x86_64.mov_ri(code, x86_64.rdx, gc_state());\n    x86_64.mov_store(code, x86_64.rdx, 32, x86_64.rax);\n    x86_64.mov_store(code, x86_64.rdx, 48, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rsi, mark_stack_size);\n    x86_64.add_rr(code, x86_64.rax, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rdx, 40, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 33554432);\n    x86_64.mov_store(code, x86_64.rdx, 16, x86_64.rax);\n    emit_epilogue(code);\n    close_frame(code, ctx, begin, 0);\n}\n\n// rt.alloc.grow: rax = requested heap end, rdx = old heap_next, rcx = data_base. Commits the heap up to the next 16 MiB\n// boundary at or above rax (clamped to the reservation) and resumes at rt.alloc.bump_check. Preserves rax, rcx, rdx.\nwaza emit_win_heap_grow(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    x86_64.label(code, \"rt.alloc.grow\");\n    x86_64.push_r(code, x86_64.rax);\n    x86_64.push_r(code, x86_64.rdx);\n    x86_64.push_r(code, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.rdx, gc_state());\n    x86_64.mov_load(code, x86_64.r10, x86_64.rdx, 80);\n    x86_64.cmp_rr(code, x86_64.rax, x86_64.r10);\n    x86_64.jcc(code, x86_64.cc_a, \"rt.trap.memory\");\n    x86_64.mov_rr(code, x86_64.r9, x86_64.rax);\n    x86_64.add_ri(code, x86_64.r9, heap_commit_step - 1);\n    x86_64.mov_ri(code, x86_64.rdx, -heap_commit_step);\n    x86_64.and_rr(code, x86_64.r9, x86_64.rdx);\n    x86_64.cmp_rr(code, x86_64.r9, x86_64.r10);\n    x86_64.jcc(code, x86_64.cc_be, \"rt.alloc.grow_ok\");\n    x86_64.mov_rr(code, x86_64.r9, x86_64.r10);\n    x86_64.label(code, \"rt.alloc.grow_ok\");\n    x86_64.mov_ri(code, x86_64.rcx, data_base());\n    x86_64.mov_load(code, x86_64.rcx, x86_64.rcx, 8);\n    x86_64.mov_rr(code, x86_64.rdx, x86_64.r9);\n    x86_64.sub_rr(code, x86_64.rdx, x86_64.rcx);\n    x86_64.mov_ri(code, x86_64.r10, data_base());\n    x86_64.mov_store(code, x86_64.r10, 8, x86_64.r9);\n    x86_64.call(code, \"rt.commit\");\n    x86_64.test_rr(code, x86_64.rax, x86_64.rax);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.trap.memory\");\n    x86_64.pop_r(code, x86_64.rcx);\n    x86_64.pop_r(code, x86_64.rdx);\n    x86_64.pop_r(code, x86_64.rax);\n    x86_64.jmp(code, \"rt.alloc.bump_check\");\n}\n\n// UTF-8 path (descriptor-less syscalls: saved rdi at +64) -> UTF-16 in the scratch buffer; rax = 0 on failure. Inline so the\n// API call sees an aligned stack with its own shadow space.\nwaza emit_path_to_wide(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    x86_64.mov_ri(code, x86_64.rcx, 65001);\n    x86_64.mov_ri(code, x86_64.rdx, 0);\n    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 64);\n    x86_64.mov_ri(code, x86_64.r9, -1);\n    x86_64.mov_ri(code, x86_64.rax, scratch_path());\n    x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rax);\n    x86_64.mov_ri(code, x86_64.rax, 16384);\n    x86_64.mov_store(code, x86_64.rsp, 40, x86_64.rax);\n    import_call(code, ctx, import_multibyte);\n    x86_64.zero_extend_eax(code);\n}\n\n// Handle for descriptor rdi -> rcx (descriptors 0/1/2 map to GetStdHandle); inline so the stack stays aligned at the API call.\nwaza emit_descriptor_handle(code: x86_64.Assembler, ctx: WinContext, tag: string) -> unit {\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rdi);\n    x86_64.cmp_ri(code, x86_64.rdi, 2);\n    x86_64.jcc(code, x86_64.cc_a, string.concat(tag, \".handle_done\"));\n    x86_64.mov_ri(code, x86_64.rcx, 4294967286);\n    x86_64.cmp_ri(code, x86_64.rdi, 0);\n    x86_64.jcc(code, x86_64.cc_e, string.concat(tag, \".handle_std\"));\n    x86_64.mov_ri(code, x86_64.rcx, 4294967285);\n    x86_64.cmp_ri(code, x86_64.rdi, 1);\n    x86_64.jcc(code, x86_64.cc_e, string.concat(tag, \".handle_std\"));\n    x86_64.mov_ri(code, x86_64.rcx, 4294967284);\n    x86_64.label(code, string.concat(tag, \".handle_std\"));\n    import_call(code, ctx, import_get_std_handle);\n    x86_64.mov_rr(code, x86_64.rcx, x86_64.rax);\n    x86_64.label(code, string.concat(tag, \".handle_done\"));\n}\n\n// rt.syscall: the few Linux system calls that runtime_fs.mio issues, implemented on Win32. Linux register contract:\n// eax = number, rdi, rsi, rdx = arguments -> rax >= 0 result or -errno; only rax, rcx, r11 are clobbered (everything else is\n// saved and restored here because Win32 clobbers rdx, r8-r10). Implemented: 0 read, 1 write, 2 open, 3 close.\n// Anything else returns -38 (ENOSYS), which the fs layer reports as an I/O error: never a silent success.\n// Descriptors 0/1/2 are the standard handles; other descriptors are Win32 HANDLE values. Paths are UTF-8, converted with\n// MultiByteToWideChar into a scratch buffer (scratch_path()) and opened with CreateFileW; \"/dev/stdin|stdout|stderr\"\n// map to descriptors 0/1/2.\n// Frame after realignment: +0 shadow(32), +32 args 5-7 (3 slots), +56 bytes-done cell, +64 saved rdi, +72 saved rsi,\n// +80 saved rdx, +88 saved r8, +96 saved r9, +104 saved r10, +112 number, +120 arg slot.\nwaza emit_win_syscall(code: x86_64.Assembler, ctx: WinContext) -> unit {\n    kaku begin = open_frame(code, \"rt.syscall\", 0);\n    x86_64.and_ri(code, x86_64.rsp, -16);\n    x86_64.sub_ri(code, x86_64.rsp, 144);\n    x86_64.mov_store(code, x86_64.rsp, 64, x86_64.rdi);\n    x86_64.mov_store(code, x86_64.rsp, 72, x86_64.rsi);\n    x86_64.mov_store(code, x86_64.rsp, 80, x86_64.rdx);\n    x86_64.mov_store(code, x86_64.rsp, 88, x86_64.r8);\n    x86_64.mov_store(code, x86_64.rsp, 96, x86_64.r9);\n    x86_64.mov_store(code, x86_64.rsp, 104, x86_64.r10);\n    x86_64.cmp_ri(code, x86_64.rax, 0);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.syscall.read\");\n    x86_64.cmp_ri(code, x86_64.rax, 1);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.syscall.write\");\n    x86_64.cmp_ri(code, x86_64.rax, 2);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.syscall.open\");\n    x86_64.cmp_ri(code, x86_64.rax, 3);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.syscall.close\");\n    x86_64.cmp_ri(code, x86_64.rax, 4);\n    x86_64.jcc(code, x86_64.cc_e, \"rt.syscall.stat\");\n    x86_64.cmp_ri(code, x86_64.rax, 83);\n   