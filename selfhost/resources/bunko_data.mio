d(code, 9, \"gen_adapt_reset\");\n    emit(code, arm64.ldr_x(11, 23, 1168));\n    emit(code, arm64.cmp_x(11, 12));\n    arm64.assembler_b_cond(code, 3, \"gen_adapt_reset\");\n    emit(code, arm64.movz_x(10, 2, 0));\n    arm64.assembler_b(code, \"gen_adapt_vote\");\n    arm64.assembler_label(code, \"gen_adapt_up\");\n    emit(code, arm64.movz_x(10, 1, 0));\n    arm64.assembler_label(code, \"gen_adapt_vote\");\n    emit(code, arm64.ldr_x(11, 23, 1176));\n    emit(code, arm64.cmp_x(10, 11));\n    arm64.assembler_b_cond(code, 0, \"gen_adapt_same\");\n    emit(code, arm64.str_x(10, 23, 1176));\n    emit(code, arm64.str_x(31, 23, 1184));\n    arm64.assembler_label(code, \"gen_adapt_same\");\n    emit(code, arm64.ldr_x(11, 23, 1184));\n    emit(code, arm64.add_imm_x(11, 11, 1, iie));\n    emit(code, arm64.str_x(11, 23, 1184));\n    emit(code, arm64.cmp_imm_x(11, 3, iie));\n    arm64.assembler_b_cond(code, 3, \"gen_adapt_done\");\n    emit(code, arm64.str_x(31, 23, 1184));\n    emit(code, arm64.ldr_x(11, 23, 1072));\n    emit(code, arm64.cmp_imm_x(10, 1, iie));\n    arm64.assembler_b_cond(code, 1, \"gen_adapt_down\");\n    emit(code, arm64.cmp_imm_x(11, 8, iie));\n    arm64.assembler_b_cond(code, 2, \"gen_adapt_done\");\n    emit(code, arm64.add_imm_x(11, 11, 1, iie));\n    arm64.assembler_b(code, \"gen_adapt_store\");\n    arm64.assembler_label(code, \"gen_adapt_down\");\n    emit(code, arm64.cmp_imm_x(11, 2, iie));\n    arm64.assembler_b_cond(code, 9, \"gen_adapt_done\");\n    emit(code, arm64.sub_imm_x(11, 11, 1, iie));\n    arm64.assembler_label(code, \"gen_adapt_store\");\n    emit(code, arm64.str_x(11, 23, 1072));\n    arm64.assembler_b(code, \"gen_adapt_done\");\n    arm64.assembler_label(code, \"gen_adapt_reset\");\n    emit(code, arm64.str_x(31, 23, 1176));\n    emit(code, arm64.str_x(31, 23, 1184));\n    arm64.assembler_label(code, \"gen_adapt_done\");\n    emit(code, arm64.ret());\n}\n" }; }
waza data_12() -> File { kaesu File { path: "kiso/aot/lower/large_objects.mio", version: "Bunko-v2.1.1", length: 7521, sha256: "5b2a30b98034bc33b07bc53e8bacc677b7d74e6ea441535a3e204538b23c987b", source: "yobu \"kiso/aot/arm64\";\n\n// Independent page-rounded mappings. Prefix: next, mapping bytes, young link,\n// remembered link; unchanged object header at +32 and payload at +48.\nteisu los_Head = gc.los_head;\nteisu los_Bytes = gc.los_bytes;\nteisu los_Reclaimed = gc.los_reclaimed;\nteisu los_Count = gc.los_count;\nteisu los_Threshold = gc.los_threshold;\n\nwaza emit_los_side(code: arm64.Assembler, dst: int64, header: int64, scratch: int64) -> unit {\n    kaku outside = block_label(\"los_side_\", len(code.words));\n    kaku done = string.concat(outside, \"_done\");\n    emit(code, arm64.add_imm_x(dst, 23, 3072, iie));\n    emit(code, arm64.cmp_x(header, dst));\n    arm64.assembler_b_cond(code, 3, outside);\n    emit(code, arm64.ldr_x(scratch, 23, 8));\n    emit(code, arm64.cmp_x(header, scratch));\n    arm64.assembler_b_cond(code, 2, outside);\n    emit(code, arm64.sub_x(dst, header, dst));\n    emit(code, arm64.add_x(dst, dst, scratch));\n    arm64.assembler_b(code, done);\n    arm64.assembler_label(code, outside);\n    emit(code, arm64.sub_imm_x(dst, header, 16, iie));\n    emit(code, arm64.ldr_x(scratch, 23, 8));\n    arm64.assembler_label(code, done);\n}\n\nwaza emit_los_runtime(code: arm64.Assembler) -> unit {\n    // x19 payload bytes, x20 packed type, x22 physical span; no managed safepoint.\n    arm64.assembler_label(code, \"los_alloc\");\n    emit(code, arm64.sub_imm_x(31, 31, 16, iie));\n    emit(code, arm64.add_imm_x(1, 22, 32, iie));\n    emit(code, arm64.movz_x(10, 16383, 0));\n    emit(code, arm64.add_x(1, 1, 10));\n    emit(code, arm64.movn_x(10, 16383, 0));\n    emit(code, arm64.and_x(1, 1, 10));\n    emit(code, arm64.str_x(1, 31, 0));\n    emit(code, arm64.ldr_x(9, 23, memory_Committed));\n    emit(code, arm64.add_x(9, 9, 1));\n    emit(code, arm64.ldr_x(10, 23, memory_Limit));\n    emit(code, arm64.cmp_x(9, 10));\n    arm64.assembler_b_cond(code, 8, \"los_alloc_fail\");\n    emit(code, arm64.movz_x(0, 0, 0));\n    emit(code, arm64.movz_x(2, 3, 0));\n    emit(code, arm64.movz_x(3, 4098, 0));\n    emit(code, arm64.movn_x(4, 0, 0));\n    emit(code, arm64.movz_x(5, 0, 0));\n    emit(code, arm64.movz_x(16, 197, 0));\n    emit(code, arm64.svc(128));\n    arm64.assembler_b_cond(code, 2, \"los_alloc_fail\");\n    emit(code, arm64.ldr_x(9, 23, los_Head));\n    emit(code, arm64.str_x(9, 0, 0));\n    emit(code, arm64.str_x(0, 23, los_Head));\n    emit(code, arm64.ldr_x(9, 31, 0));\n    emit(code, arm64.str_x(9, 0, 8));\n    emit(code, arm64.ldr_x(10, 23, memory_LOSCommitted));\n    emit(code, arm64.add_x(10, 10, 9));\n    emit(code, arm64.str_x(10, 23, memory_LOSCommitted));\n    emit(code, arm64.str_x(20, 0, 32));\n    emit(code, arm64.str_x(19, 0, 40));\n    emit(code, arm64.ldr_x(9, 23, los_Bytes));\n    emit(code, arm64.add_x(9, 9, 22));\n    emit(code, arm64.str_x(9, 23, los_Bytes));\n    emit(code, arm64.ldr_x(9, 23, los_Count));\n    emit(code, arm64.add_imm_x(9, 9, 1, iie));\n    emit(code, arm64.str_x(9, 23, los_Count));\n    emit(code, arm64.add_imm_x(0, 0, 48, iie));\n    arm64.assembler_b(code, \"los_alloc_return\");\n    arm64.assembler_label(code, \"los_alloc_fail\");\n    emit(code, arm64.movz_x(0, 0, 0));\n    arm64.assembler_label(code, \"los_alloc_return\");\n    emit(code, arm64.add_imm_x(31, 31, 16, iie));\n    emit(code, arm64.ret());\n\n    // Routine collections retain the bounded release batch. Allocation pressure\n    // gets one finite pass after completed Major/rebuild, before the final retry.\n    emit_los_prune(code, iie);\n    emit_los_prune(code, hai);\n\n    // Major sweep; returns live physical bytes in x0 for occupied accounting.\n    arm64.assembler_label(code, \"los_major\");\n    emit(code, arm64.movz_x(0, 0, 0));\n    emit(code, arm64.ldr_x(12, 23, los_Head));\n    arm64.assembler_label(code, \"los_major_loop\");\n    arm64.assembler_cbz_x(code, 12, \"los_major_done\");\n    emit(code, arm64.ldr_x(9, 12, 32));\n    arm64.assembler_cbz_x(code, 9, \"los_major_next\");\n    emit(code, arm64.ldr_x(9, 12, 32));\n    move_bits(code, 10, uint32(1), uint32(0));\n    emit(code, arm64.and_x(10, 9, 10));\n    arm64.assembler_cbz_x(code, 10, \"los_major_dead\");\n    move_bits(code, 10, uint32(4294967292), uint32(4294967295));\n    emit(code, arm64.and_x(9, 9, 10));\n    emit(code, arm64.str_x(9, 12, 32));\n    emit(code, arm64.ldr_x(9, 12, 40));\n    emit(code, arm64.add_imm_x(9, 9, 31, iie));\n    emit(code, arm64.movn_x(10, 15, 0));\n    emit(code, arm64.and_x(9, 9, 10));\n    emit(code, arm64.add_x(0, 0, 9));\n    arm64.assembler_b(code, \"los_major_next\");\n    arm64.assembler_label(code, \"los_major_dead\");\n    emit(code, arm64.str_x(31, 12, 32));\n    emit(code, arm64.ldr_x(9, 12, 40));\n    emit(code, arm64.add_imm_x(9, 9, 31, iie));\n    emit(code, arm64.movn_x(10, 15, 0));\n    emit(code, arm64.and_x(9, 9, 10));\n    emit(code, arm64.ldr_x(10, 23, los_Bytes));\n    emit(code, arm64.sub_x(10, 10, 9));\n    emit(code, arm64.str_x(10, 23, los_Bytes));\n    emit(code, arm64.ldr_x(10, 23, los_Reclaimed));\n    emit(code, arm64.add_x(10, 10, 9));\n    emit(code, arm64.str_x(10, 23, los_Reclaimed));\n    emit(code, arm64.ldr_x(10, 23, los_Count));\n    emit(code, arm64.sub_imm_x(10, 10, 1, iie));\n    emit(code, arm64.str_x(10, 23, los_Count));\n    arm64.assembler_label(code, \"los_major_next\");\n    emit(code, arm64.ldr_x(12, 12, 0));\n    arm64.assembler_b(code, \"los_major_loop\");\n    arm64.assembler_label(code, \"los_major_done\");\n    emit(code, arm64.ret());\n}\n\n// This adapter releases only nodes already marked dead by a real collection.\n// A failed munmap is relinked with ownership/charge intact and visited once;\n// neither mode retries the OS operation indefinitely or changes liveness.\nwaza emit_los_prune(code: arm64.Assembler, pressure: bool) -> unit {\n    kaku name = \"los_prune\";\n    moshi (pressure) {\n        name = \"los_prune_pressure\";\n    }\n    kaku loop = string.concat(name, \"_loop\");\n    kaku done = string.concat(name, \"_done\");\n    kaku dead = string.concat(name, \"_dead\");\n    kaku failed = string.concat(name, \"_failed\");\n    arm64.assembler_label(code, name);\n    emit(code, arm64.stp_pre_x(19, 20, 31, -16));\n    emit(code, arm64.stp_pre_x(21, 22, 31, -16));\n    emit(code, arm64.add_imm_x(19, 23, los_Head, iie));\n    emit(code, arm64.movz_x(22, 0, 0));\n    arm64.assembler_label(code, loop);\n    emit(code, arm64.ldr_x(20, 19, 0));\n    arm64.assembler_cbz_x(code, 20, done);\n    emit(code, arm64.ldr_x(9, 20, 32));\n    arm64.assembler_cbz_x(code, 9, dead);\n    move_x(code, 19, 20);\n    arm64.assembler_b(code, loop);\n    arm64.assembler_label(code, dead);\n    moshi (!pressure) {\n        emit(code, arm64.cmp_imm_x(22, 8, iie));\n        arm64.assembler_b_cond(code, 2, done);\n        emit(code, arm64.add_imm_x(22, 22, 1, iie));\n    }\n    emit(code, arm64.ldr_x(9, 20, 0));\n    emit(code, arm64.str_x(9, 19, 0));\n    emit(code, arm64.ldr_x(1, 20, 8));\n    move_x(code, 21, 1);\n    move_x(code, 0, 20);\n    emit(code, arm64.movz_x(16, 73, 0));\n    emit(code, arm64.svc(128));\n    arm64.assembler_b_cond(code, 2, failed);\n    emit(code, arm64.ldr_x(9, 23, memory_LOSCommitted));\n    emit(code, arm64.sub_x(9, 9, 21));\n    emit(code, arm64.str_x(9, 23, memory_LOSCommitted));\n    arm64.assembler_b(code, loop);\n    arm64.assembler_label(code, failed);\n    emit(code, arm64.ldr_x(9, 19, 0));\n    emit(code, arm64.str_x(9, 20, 0));\n    emit(code, arm64.str_x(20, 19, 0));\n    move_x(code, 19, 20);\n    arm64.assembler_b(code, loop);\n    arm64.assembler_label(code, done);\n    emit(code, arm64.ldp_post_x(21, 22, 31, 16));\n    emit(code, arm64.ldp_post_x(19, 20, 31, 16));\n    emit(code, arm64.ret());\n}\n" }; }
waza data_13() -> File { kaesu File { path: "kiso/aot/lower/linuxabi.mio", version: "Bunko-v2.1.1", length: 23135, sha256: "a268f77ccbf2cb7667a834462d71eb14ac17b5a1e59b59c8a6c540fd96198c94", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// Linux AArch64 operating-system adapter for the Darwin/AArch64 lowering.\n//\n// The Darwin backend reaches the kernel only through `SVC #128` (BSD system-call number in x16, carry flag set and a\n// positive errno in x0 on failure). With the label `linux_abi` defined (see arm64.assembler_emit) every such SVC becomes\n// a call of `linux_syscall`, emitted here. The routine translates the call into the Linux AArch64 system call: number,\n// argument conventions, flag values, the `stat` and directory-entry layouts, sockaddr_in and the errno values, and it\n// returns the Darwin result convention. Calls that have no translation fail explicitly with ENOSYS (Darwin value 78).\n// All registers except x0, x1, x16 and the flags are preserved, as the Darwin kernel does; x1 is preserved unless the\n// call defines a second result (fork).\n//\n// Frame (288 bytes): 0..127 saved x2..x15, x17, x30; 128 original x1; 144..271 scratch (stat buffer, sockaddr, path).\n\nwaza lx(c: arm64.Assembler, i: arm64.Instruction) -> unit { arm64.assembler_emit(c, i); }\nwaza lx_label(c: arm64.Assembler, name: string) -> unit { arm64.assembler_label(c, name); }\nwaza lx_b(c: arm64.Assembler, name: string) -> unit { arm64.assembler_b(c, name); }\nwaza lx_bcc(c: arm64.Assembler, condition: int64, name: string) -> unit { arm64.assembler_b_cond(c, condition, name); }\nwaza lx_cbz(c: arm64.Assembler, reg: int64, name: string) -> unit { arm64.assembler_cbz_x(c, reg, name); }\nwaza lx_cbnz(c: arm64.Assembler, reg: int64, name: string) -> unit { arm64.assembler_cbnz_x(c, reg, name); }\nwaza lx_bl(c: arm64.Assembler, name: string) -> unit { arm64.assembler_bl(c, name); }\nwaza lx_mov(c: arm64.Assembler, rd: int64, rn: int64) -> unit { lx(c, arm64.add_imm_x(rd, rn, 0, iie)); }\n// Load an immediate in [-65536, 4294967295].\nwaza lx_li(c: arm64.Assembler, reg: int64, value: int64) -> unit {\n    moshi (value < 0) {\n        lx(c, arm64.movn_x(reg, -value - 1, 0));\n        kaesu;\n    }\n    moshi (value < 65536) {\n        lx(c, arm64.movz_x(reg, value, 0));\n        kaesu;\n    }\n    kaku low = value - (value / 65536) * 65536;\n    lx(c, arm64.movz_x(reg, low, 0));\n    lx(c, arm64.movk_x(reg, value / 65536, 1));\n}\nwaza lx_name(prefix: string, index: int64) -> string { kaesu string.concat(prefix, convert.format_int(index)); }\n\n// A direct translation: only the number changes (arguments and result convention are identical).\nwaza lx_direct(c: arm64.Assembler, darwin: int64, linux: int64, index: int64) -> unit {\n    kaku next = lx_name(\"lx_direct_next_\", index);\n    lx(c, arm64.cmp_imm_x(16, darwin, iie));\n    lx_bcc(c, 1, next);\n    lx_li(c, 8, linux);\n    lx_b(c, \"lx_svc\");\n    lx_label(c, next);\n}\n\n// Dispatch entry for a translated call: `lx_dispatch(c, darwin, label)` jumps to label when x16 == darwin.\nwaza lx_dispatch(c: arm64.Assembler, darwin: int64, target: string, index: int64) -> unit {\n    kaku next = lx_name(\"lx_dispatch_next_\", index);\n    lx(c, arm64.cmp_imm_x(16, darwin, iie));\n    lx_bcc(c, 1, next);\n    lx_b(c, target);\n    lx_label(c, next);\n}\n\n// dst = (src & 3) | translated flag bits; pairs are (darwin mask, linux mask). Uses x10-x12.\nwaza lx_flags(c: arm64.Assembler, src: int64, dst: int64, masks: []int64, prefix: string) -> unit {\n    lx_li(c, 10, 3);\n    lx(c, arm64.and_x(dst, src, 10));\n    kaku at = 0;\n    aida (at < len(masks)) {\n        kaku skip = lx_name(prefix, at);\n        lx_li(c, 10, masks[at]);\n        lx(c, arm64.and_x(11, src, 10));\n        lx_cbz(c, 11, skip);\n        lx_li(c, 12, masks[at + 1]);\n        lx(c, arm64.orr_x(dst, dst, 12));\n        lx_label(c, skip);\n        at = at + 2;\n    }\n}\n\n// Store the bytes of `text` plus a NUL at [base, #offset...] using x9.\nwaza lx_store_text(c: arm64.Assembler, base: int64, offset: int64, text: string) -> int64 {\n    kaku bytes = string.to_bytes(text);\n    kaku at = 0;\n    aida (at < len(bytes)) {\n        lx_li(c, 9, int64(bytes[at]));\n        lx(c, arm64.strb_w(9, base, offset + at));\n        at = at + 1;\n    }\n    lx(c, arm64.strb_w(31, base, offset + len(bytes)));\n    kaesu offset + len(bytes);\n}\n\n// readlinkat(AT_FDCWD, path at x1, buffer at x2, size x3) then NUL-terminate: result 0 or a negative errno in x0.\nwaza lx_readlink_finish(c: arm64.Assembler, label: string) -> unit {\n    lx_li(c, 0, -100);\n    lx_li(c, 8, 78);\n    lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie));\n    lx_bcc(c, 11, \"lx_norm\");\n    lx(c, arm64.add_x(9, 2, 0));\n    lx(c, arm64.strb_w(31, 9, 0));\n    lx_li(c, 0, 0);\n    lx_b(c, \"lx_norm\");\n}\n\n// Linux errno -> Darwin errno for the values that differ (x0 in and out; uses x9, x10).\nwaza lx_errno(c: arm64.Assembler) -> unit {\n    lx_label(c, \"lx_errno\");\n    kaku pairs = [11, 35, 115, 36, 114, 37, 88, 38, 89, 39, 90, 40, 91, 41, 92, 42, 93, 43, 95, 45, 97, 47, 98, 48, 99, 49, 100, 50,\n        101, 51, 103, 53, 104, 54, 105, 55, 106, 56, 107, 57, 110, 60, 111, 61, 113, 65, 39, 66, 40, 62, 36, 63, 38, 78];\n    kaku at = 0;\n    aida (at < len(pairs)) {\n        kaku next = lx_name(\"lx_errno_next_\", at);\n        lx(c, arm64.cmp_imm_x(0, pairs[at], iie));\n        lx_bcc(c, 1, next);\n        lx_li(c, 0, pairs[at + 1]);\n        lx(c, arm64.ret());\n        lx_label(c, next);\n        at = at + 2;\n    }\n    lx(c, arm64.ret());\n}\n\nwaza lx_save_pair(c: arm64.Assembler, a: int64, b: int64, offset: int64) -> unit { lx(c, arm64.stp_x(a, b, 31, offset)); }\nwaza lx_load_pair(c: arm64.Assembler, a: int64, b: int64, offset: int64) -> unit { lx(c, arm64.ldp_x(a, b, 31, offset)); }\n\nkoukai waza emit_linux_abi_runtime(c: arm64.Assembler) -> unit {\n    lx_label(c, \"linux_syscall\");\n    lx(c, arm64.sub_imm_x(31, 31, 288, iie));\n    lx_save_pair(c, 2, 3, 0);\n    lx_save_pair(c, 4, 5, 16);\n    lx_save_pair(c, 6, 7, 32);\n    lx_save_pair(c, 8, 9, 48);\n    lx_save_pair(c, 10, 11, 64);\n    lx_save_pair(c, 12, 13, 80);\n    lx_save_pair(c, 14, 15, 96);\n    lx_save_pair(c, 17, 30, 112);\n    lx(c, arm64.str_x(1, 31, 128));\n    // ---- direct translations (number only)\n    kaku direct = [1, 94, 3, 63, 4, 64, 6, 57, 7, 260, 20, 172, 30, 202, 59, 221, 83, 103, 97, 198, 106, 201, 195, 164, 74, 226];\n    kaku at = 0;\n    aida (at < len(direct)) {\n        lx_direct(c, direct[at], direct[at + 1], at);\n        at = at + 2;\n    }\n    // ---- translated calls\n    kaku calls = [73, 5, 197, 338, 344, 136, 137, 10, 15, 2, 90, 92, 105, 104, 98, 230, 336, 202, 274, 194, 54, 118];\n    kaku names = [\"lx_munmap\", \"lx_open\", \"lx_mmap\", \"lx_stat\", \"lx_dirents\", \"lx_mkdir\", \"lx_rmdir\", \"lx_unlink\", \"lx_chmod\", \"lx_fork\", \"lx_dup2\",\n        \"lx_fcntl\", \"lx_setsockopt\", \"lx_bind\", \"lx_connect\", \"lx_poll\", \"lx_procinfo\", \"lx_sysctl\", \"lx_sysctlbyname\", \"lx_getrlimit\", \"lx_ioctl\", \"lx_getsockopt\"];\n    at = 0;\n    aida (at < len(calls)) {\n        lx_dispatch(c, calls[at], names[at], at);\n        at = at + 1;\n    }\n    lx_li(c, 0, -38);\n    lx_b(c, \"lx_norm\");\n\n    // ---- common completion\n    lx_label(c, \"lx_svc\");\n    lx(c, arm64.svc(0));\n    lx_label(c, \"lx_norm\");\n    lx(c, arm64.cmn_imm_x(0, 4095, iie));\n    lx_bcc(c, 3, \"lx_done\");\n    lx(c, arm64.sub_x(0, 31, 0));\n    lx_bl(c, \"lx_errno\");\n    lx(c, arm64.cmp_x(31, 31));\n    lx_label(c, \"lx_done\");\n    lx(c, arm64.ldr_x(1, 31, 128));\n    lx_label(c, \"lx_return\");\n    lx_load_pair(c, 2, 3, 0);\n    lx_load_pair(c, 4, 5, 16);\n    lx_load_pair(c, 6, 7, 32);\n    lx_load_pair(c, 8, 9, 48);\n    lx_load_pair(c, 10, 11, 64);\n    lx_load_pair(c, 12, 13, 80);\n    lx_load_pair(c, 14, 15, 96);\n    lx_load_pair(c, 17, 30, 112);\n    lx(c, arm64.add_imm_x(31, 31, 288, iie));\n    lx(c, arm64.ret());\n\n    // ---- open(path, flags, mode) -> openat(AT_FDCWD, path, flags', mode)\n    lx_label(c, \"lx_open\");\n    lx_mov(c, 3, 2);\n    lx_flags(c, 1, 9, [512, 64, 1024, 512, 8, 1024, 2048, 128, 4, 2048, 1048576, 16384, 16777216, 524288, 32768, 2097152], \"lx_open_skip_\");\n    lx_mov(c, 1, 0);\n    lx_mov(c, 2, 9);\n    lx_li(c, 0, -100);\n    lx_li(c, 8, 56);\n    lx_b(c, \"lx_svc\");\n\n    // ---- mmap: the Darwin kernel works in 16 KiB pages (mappings are 16 KiB aligned and their length is rounded up to\n    // 16 KiB; the runtime protects and releases ranges up to that rounded end), Linux in 4 KiB pages. Length is rounded\n    // to 16 KiB here; mappings of 64 KiB or more are also aligned to 16 KiB by over-allocating and trimming the slack.\n    // MAP_ANON 0x1000 -> 0x20; very large reservations are MAP_NORESERVE (0x4000).\n    lx_label(c, \"lx_mmap\");\n    lx_li(c, 10, 4096);\n    lx(c, arm64.and_x(11, 3, 10));\n    lx_cbz(c, 11, \"lx_mmap_flags_done\");\n    lx(c, arm64.sub_imm_x(3, 3, 1, hai));\n    lx(c, arm64.add_imm_x(3, 3, 32, iie));\n    lx_label(c, \"lx_mmap_flags_done\");\n    lx_li(c, 10, 16383);\n    lx(c, arm64.add_x(1, 1, 10));\n    lx(c, arm64.movn_x(11, 16383, 0));\n    lx(c, arm64.and_x(1, 1, 11));\n    lx_li(c, 10, 268435456);\n    lx(c, arm64.cmp_x(1, 10));\n    lx_bcc(c, 3, \"lx_mmap_reserve_done\");\n    lx_li(c, 11, 16384);\n    lx(c, arm64.orr_x(3, 3, 11));\n    lx_label(c, \"lx_mmap_reserve_done\");\n    lx_cbnz(c, 0, \"lx_mmap_plain\");\n    lx_li(c, 10, 65536);\n    lx(c, arm64.cmp_x(1, 10));\n    lx_bcc(c, 3, \"lx_mmap_plain\");\n    // aligned path: map len + 16 KiB at a kernel-chosen address, keep the 16 KiB-aligned window, unmap the slack\n    lx_mov(c, 13, 1);\n    lx(c, arm64.add_imm_x(1, 13, 4, hai));\n    lx_li(c, 8, 222);\n    lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie));\n    lx_bcc(c, 11, \"lx_norm\");\n    lx_mov(c, 12, 0);\n    lx_li(c, 10, 16383);\n    lx(c, arm64.add_x(9, 12, 10));\n    lx(c, arm64.movn_x(11, 16383, 0));\n    lx(c, arm64.and_x(9, 9, 11));\n    lx(c, arm64.sub_x(1, 9, 12));\n    lx_cbz(c, 1, \"lx_mmap_head_done\");\n    lx_mov(c, 0, 12);\n    lx_li(c, 8, 215);\n    lx(c, arm64.svc(0));\n    lx_label(c, \"lx_mmap_head_done\");\n    lx(c, arm64.add_x(0, 9, 13));\n    lx(c, arm64.sub_x(1, 9, 12));\n    lx_li(c, 10, 16384);\n    lx(c, arm64.sub_x(1, 10, 1));\n    lx_li(c, 8, 215);\n    lx(c, arm64.svc(0));\n    lx_mov(c, 0, 9);\n    lx_b(c, \"lx_norm\");\n    lx_label(c, \"lx_mmap_plain\");\n    lx_li(c, 8, 222);\n    lx_b(c, \"lx_svc\");\n\n    // ---- munmap: ranges are released in whole 16 KiB pages, matching the mapping lengths created above\n    lx_label(c, \"lx_munmap\");\n    lx_li(c, 10, 16383);\n    lx(c, arm64.add_x(1, 1, 10));\n    lx(c, arm64.movn_x(11, 16383, 0));\n    lx(c, arm64.and_x(1, 1, 11));\n    lx_li(c, 8, 215);\n    lx_b(c, \"lx_svc\");\n\n    // ---- stat64(path, buf) -> newfstatat(AT_FDCWD, path, tmp, 0), then rebuild the Darwin stat64 layout in buf\n    lx_label(c, \"lx_stat\");\n    lx_mov(c, 13, 1);\n    lx_mov(c, 1, 0);\n    lx_li(c, 0, -100);\n    lx(c, arm64.add_imm_x(2, 31, 144, iie));\n    lx_li(c, 3, 0);\n    lx_li(c, 8, 79);\n    lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie));\n    lx_bcc(c, 11, \"lx_norm\");\n    kaku zero = 0;\n    aida (zero < 144) {\n        lx(c, arm64.str_x(31, 13, zero));\n        zero = zero + 8;\n    }\n    // Linux stat at sp+144: ino 8, mode 16 (u32), nlink 20 (u32), uid 24, gid 28, rdev 32, size 48, blksize 56 (u32),\n    // blocks 64, atime 72/80, mtime 88/96, ctime 104/112.\n    lx(c, arm64.ldr_w(9, 31, 160));\n    lx(c, arm64.strh_w(9, 13, 4));\n    lx(c, arm64.ldr_w(9, 31, 164));\n    lx(c, arm64.strh_w(9, 13, 6));\n    lx(c, arm64.ldr_x(9, 31, 152));\n    lx(c, arm64.str_x(9, 13, 8));\n    lx(c, arm64.ldr_w(9, 31, 168));\n    lx(c, arm64.str_w(9, 13, 16));\n    lx(c, arm64.ldr_w(9, 31, 172));\n    lx(c, arm64.str_w(9, 13, 20));\n    lx(c, arm64.ldr_w(9, 31, 176));\n    lx(c, arm64.str_w(9, 13, 24));\n    kaku times = [216, 32, 224, 40, 232, 48, 240, 56, 248, 64, 256, 72, 232, 80, 240, 88];\n    at = 0;\n    aida (at < len(times)) {\n        lx(c, arm64.ldr_x(9, 31, times[at]));\n        lx(c, arm64.str_x(9, 13, times[at + 1]));\n        at = at + 2;\n    }\n    lx(c, arm64.ldr_x(9, 31, 192));\n    lx(c, arm64.str_x(9, 13, 96));\n    lx(c, arm64.ldr_x(9, 31, 208));\n    lx(c, arm64.str_x(9, 13, 104));\n    lx(c, arm64.ldr_w(9, 31, 200));\n    lx(c, arm64.str_w(9, 13, 112));\n    lx_li(c, 0, 0);\n    lx_b(c, \"lx_norm\");\n\n    // ---- getdirentries64(fd, buf, nbytes >= 4096, basep) -> getdents64 into a 2 KiB stack buffer, converted record by\n    // record into Darwin dirent64 (ino 0, seekoff 8, reclen 16, namlen 18, type 20, name 21).\n    lx_label(c, \"lx_dirents\");\n    lx_li(c, 9, 4096);\n    lx(c, arm64.cmp_x(2, 9));\n    lx_bcc(c, 2, \"lx_dirents_ok\");\n    lx_li(c, 0, -22);\n    lx_b(c, \"lx_norm\");\n    lx_label(c, \"lx_dirents_ok\");\n    lx_mov(c, 13, 1);\n    lx(c, arm64.sub_imm_x(31, 31, 2048, iie));\n    lx_mov(c, 1, 31);\n    lx_li(c, 2, 2048);\n    lx_li(c, 8, 61);\n    lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie));\n    lx_bcc(c, 11, \"lx_dirents_fail\");\n    lx_cbz(c, 0, \"lx_dirents_end\");\n    lx_mov(c, 10, 31);\n    lx(c, arm64.add_x(11, 10, 0));\n    lx_mov(c, 12, 13);\n    lx_label(c, \"lx_dirents_next\");\n    lx(c, arm64.cmp_x(10, 11));\n    lx_bcc(c, 2, \"lx_dirents_done\");\n    lx(c, arm64.ldr_x(9, 10, 0));\n    lx(c, arm64.str_x(9, 12, 0));\n    lx(c, arm64.ldr_x(9, 10, 8));\n    lx(c, arm64.str_x(9, 12, 8));\n    lx(c, arm64.ldrb_w(9, 10, 18));\n    lx(c, arm64.strb_w(9, 12, 20));\n    lx(c, arm64.add_imm_x(4, 10, 19, iie));\n    lx_li(c, 2, 0);\n    lx_label(c, \"lx_dirents_len\");\n    lx(c, arm64.ldrb_w_register(9, 4, 2));\n    lx_cbz(c, 9, \"lx_dirents_len_done\");\n    lx(c, arm64.add_imm_x(2, 2, 1, iie));\n    lx_b(c, \"lx_dirents_len\");\n    lx_label(c, \"lx_dirents_len_done\");\n    lx(c, arm64.strh_w(2, 12, 18));\n    lx(c, arm64.add_imm_x(5, 12, 21, iie));\n    lx_li(c, 3, 0);\n    lx_label(c, \"lx_dirents_copy\");\n    lx(c, arm64.cmp_x(3, 2));\n    lx_bcc(c, 8, \"lx_dirents_copied\");\n    lx(c, arm64.ldrb_w_register(9, 4, 3));\n    lx(c, arm64.add_x(6, 5, 3));\n    lx(c, arm64.strb_w(9, 6, 0));\n    lx(c, arm64.add_imm_x(3, 3, 1, iie));\n    lx_b(c, \"lx_dirents_copy\");\n    lx_label(c, \"lx_dirents_copied\");\n    lx(c, arm64.add_x(6, 5, 2));\n    lx(c, arm64.strb_w(31, 6, 0));\n    lx(c, arm64.add_imm_x(9, 2, 29, iie));\n    lx(c, arm64.movn_x(6, 7, 0));\n    lx(c, arm64.and_x(9, 9, 6));\n    lx(c, arm64.strh_w(9, 12, 16));\n    lx(c, arm64.add_x(12, 12, 9));\n    lx(c, arm64.ldrh_w(9, 10, 16));\n    lx(c, arm64.add_x(10, 10, 9));\n    lx_b(c, \"lx_dirents_next\");\n    lx_label(c, \"lx_dirents_done\");\n    lx(c, arm64.sub_x(0, 12, 13));\n    lx(c, arm64.add_imm_x(31, 31, 2048, iie));\n    lx_b(c, \"lx_norm\");\n    lx_label(c, \"lx_dirents_end\");\n    lx(c, arm64.add_imm_x(31, 31, 2048, iie));\n    lx_li(c, 0, 0);\n    lx_b(c, \"lx_norm\");\n    lx_label(c, \"lx_dirents_fail\");\n    lx(c, arm64.add_imm_x(31, 31, 2048, iie));\n    lx_b(c, \"lx_norm\");\n\n    // ---- path calls with the directory descriptor AT_FDCWD\n    lx_label(c, \"lx_mkdir\");\n    lx_mov(c, 2, 1);\n    lx_mov(c, 1, 0);\n    lx_li(c, 0, -100);\n    lx_li(c, 8, 34);\n    lx_b(c, \"lx_svc\");\n    lx_label(c, \"lx_chmod\");\n    lx_mov(c, 2, 1);\n    lx_mov(c, 1, 0);\n    lx_li(c, 0, -100);\n    lx_li(c, 8, 53);\n    lx_b(c, \"lx_svc\");\n    lx_label(c, \"lx_unlink\");\n    lx_mov(c, 1, 0);\n    lx_li(c, 0, -100);\n    lx_li(c, 2, 0);\n    lx_li(c, 8, 35);\n    lx_b(c, \"lx_svc\");\n    lx_label(c, \"lx_rmdir\");\n    lx_mov(c, 1, 0);\n    lx_li(c, 0, -100);\n    lx_li(c, 2, 512);\n    lx_li(c, 8, 35);\n    lx_b(c, \"lx_svc\");\n\n    // ---- fork() -> clone(SIGCHLD): Darwin returns x1 = 0 in the parent and 1 in the child\n    lx_label(c, \"lx_fork\");\n    lx_li(c, 0, 17);\n    lx_li(c, 1, 0);\n    lx_li(c, 2, 0);\n    lx_li(c, 3, 0);\n    lx_li(c, 4, 0);\n    lx_li(c, 8, 220);\n    lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie));\n    lx_bcc(c, 11, \"lx_norm\");\n    lx_li(c, 9, 0);\n    lx_cbnz(c, 0, \"lx_fork_store\");\n    lx_li(c, 9, 1);\n    lx_label(c, \"lx_fork_store\");\n    lx(c, arm64.str_x(9, 31, 128));\n    lx_b(c, \"lx_norm\");\n\n    // ---- dup2(old, new): dup3 rejects old == new, dup2 returns new\n    lx_label(c, \"lx_dup2\");\n    lx(c, arm64.cmp_x(0, 1));\n    lx_bcc(c, 1, \"lx_dup2_go\");\n    lx_mov(c, 0, 1);\n    lx_b(c, \"lx_norm\");\n    lx_label(c, \"lx_dup2_go\");\n    lx_li(c, 2, 0);\n    lx_li(c, 8, 24);\n    lx_b(c, \"lx_svc\");\n\n    // ---- fcntl: F_GETPATH (50) reads /proc/self/fd/<fd>; F_DUPFD_CLOEXEC 67 -> 1030; the rest keep their values\n    lx_label(c, \"lx_fcntl\");\n    lx(c, arm64.cmp_imm_x(1, 50, iie));\n    lx_bcc(c, 0, \"lx_getpath\");\n    lx(c, arm64.cmp_imm_x(1, 67, iie));\n    lx_bcc(c, 1, \"lx_fcntl_go\");\n    lx_li(c, 1, 1030);\n    lx_label(c, \"lx_fcntl_go\");\n    lx_li(c, 8, 25);\n    lx_b(c, \"lx_svc\");\n    lx_label(c, \"lx_getpath\");\n    lx_mov(c, 13, 2);\n    lx_mov(c, 14, 0);\n    kaku end = lx_store_text(c, 31, 144, \"/proc/self/fd/\");\n    // digits of the descriptor (x14), at least one\n    lx_li(c, 10, 10);\n    lx_mov(c, 9, 14);\n    lx_li(c, 11, 1);\n    lx_label(c, \"lx_getpath_count\");\n    lx(c, arm64.cmp_x(9, 10));\n    lx_bcc(c, 3, \"lx_getpath_counted\");\n    lx(c, arm64.udiv_x(9, 9, 10));\n    lx(c, arm64.add_imm_x(11, 11, 1, iie));\n    lx_b(c, \"lx_getpath_count\");\n    lx_label(c, \"lx_getpath_counted\");\n    lx(c, arm64.add_imm_x(12, 31, end, iie));\n    lx(c, arm64.add_x(12, 12, 11));\n    lx(c, arm64.strb_w(31, 12, 0));\n    lx_mov(c, 9, 14);\n    lx_label(c, \"lx_getpath_digit\");\n    lx(c, arm64.sub_imm_x(12, 12, 1, iie));\n    lx(c, arm64.udiv_x(15, 9, 10));\n    lx(c, arm64.msub_x(4, 15, 10, 9));\n    lx(c, arm64.add_imm_x(4, 4, 48, iie));\n    lx(c, arm64.strb_w(4, 12, 0));\n    lx_mov(c, 9, 15);\n    lx_cbnz(c, 9, \"lx_getpath_digit\");\n    lx(c, arm64.add_imm_x(1, 31, 144, iie));\n    lx_mov(c, 2, 13);\n    lx_li(c, 3, 1023);\n    lx_readlink_finish(c, \"lx_getpath\");\n\n    // ---- proc_info(PIDINFO=2, pid, PIDPATHINFO=11, 0, buffer x4, size x5) -> readlink(\"/proc/self/exe\")\n    lx_label(c, \"lx_procinfo\");\n    lx(c, arm64.cmp_imm_x(0, 2, iie));\n    lx_bcc(c, 1, \"lx_unsupported\");\n    lx(c, arm64.cmp_imm_x(2, 11, iie));\n    lx_bcc(c, 1, \"lx_unsupported\");\n    lx_mov(c, 13, 4);\n    lx_mov(c, 14, 5);\n    lx_store_text(c, 31, 144, \"/proc/self/exe\");\n    lx(c, arm64.add_imm_x(1, 31, 144, iie));\n    lx_mov(c, 2, 13);\n    lx(c, arm64.sub_imm_x(3, 14, 1, iie));\n    lx_readlink_finish(c, \"lx_procinfo\");\n    lx_label(c, \"lx_unsupported\");\n    lx_li(c, 0, -38);\n    lx_b(c, \"lx_norm\");\n\n    // ---- setsockopt: SOL_SOCKET 0xffff -> 1; SO_REUSEADDR 4 -> 2; SO_NOSIGPIPE 0x1022 has no Linux counterpart (no-op)\n    lx_label(c, \"lx_setsockopt\");\n    lx_li(c, 9, 65535);\n    lx(c, arm64.cmp_x(1, 9));\n    lx_bcc(c, 1, \"lx_setsockopt_go\");\n    lx_li(c, 1, 1);\n    kaku options = [4, 2, 4130, -1, 512, 15, 4097, 7, 4098, 8];\n    at = 0;\n    aida (at < len(options)) {\n        kaku next = lx_name(\"lx_setsockopt_next_\", at);\n        lx_li(c, 9, options[at]);\n        lx(c, arm64.cmp_x(2, 9));\n        lx_bcc(c, 1, next);\n        moshi (options[at + 1] < 0) {\n            lx_li(c, 0, 0);\n            lx_b(c, \"lx_norm\");\n        }\n        sore {\n            lx_li(c, 2, options[at + 1]);\n            lx_b(c, \"lx_setsockopt_go\");\n        }\n        lx_label(c, next);\n        at = at + 2;\n    }\n    lx_label(c, \"lx_setsockopt_go\");\n    lx_li(c, 8, 208);\n    lx_b(c, \"lx_svc\");\n\n    // ---- ioctl(fd, request, argp): only FIONBIO (Darwin 0x8004667e) is translated, to the Linux request 0x5421; anything else is ENOSYS\n    lx_label(c, \"lx_ioctl\");\n    lx_li(c, 9, 2147772030);\n    lx(c, arm64.cmp_x(1, 9));\n    lx_bcc(c, 1, \"lx_unsupported\");\n    lx_li(c, 1, 21537);\n    lx_li(c, 8, 29);\n    lx_b(c, \"lx_svc\");\n\n    // ---- getsockopt(fd, level, name, value, length): only SOL_SOCKET (0xffff -> 1) / SO_ERROR (0x1007 -> 4) is translated; the\n    // pending error the kernel stores in *value is a Linux errno and is translated to the Darwin number like a failed call's errno.\n    lx_label(c, \"lx_getsockopt\");\n    lx_li(c, 9, 65535);\n    lx(c, arm64.cmp_x(1, 9));\n    lx_bcc(c, 1, \"lx_unsupported\");\n    lx_li(c, 9, 4103);\n    lx(c, arm64.cmp_x(2, 9));\n    lx_bcc(c, 1, \"lx_unsupported\");\n    lx_li(c, 1, 1);\n    lx_li(c, 2, 4);\n    lx_li(c, 8, 209);\n    lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie));\n    lx_bcc(c, 11, \"lx_norm\");\n    lx(c, arm64.ldr_x(9, 31, 8));\n    lx(c, arm64.ldr_w(0, 9, 0));\n    lx_bl(c, \"lx_errno\");\n    lx(c, arm64.str_w(0, 9, 0));\n    lx_li(c, 0, 0);\n    lx_b(c, \"lx_norm\");\n\n    // ---- bind/connect: Darwin sockaddr_in (sin_len, sin_family) -> Linux (u16 family)\n    lx_label(c, \"lx_bind\");\n    lx_li(c, 8, 200);\n    lx_b(c, \"lx_sockaddr\");\n    lx_label(c, \"lx_connect\");\n    lx_li(c, 8, 203);\n    lx_label(c, \"lx_sockaddr\");\n    lx(c, arm64.ldp_x(9, 10, 1, 0));\n    lx(c, arm64.stp_x(9, 10, 31, 144));\n    lx_li(c, 9, 2);\n    lx(c, arm64.strb_w(9, 31, 144));\n    lx(c, arm64.strb_w(31, 31, 145));\n    lx(c, arm64.add_imm_x(1, 31, 144, iie));\n    lx_b(c, \"lx_svc\");\n\n    // ---- poll(fds, nfds, timeout ms) -> ppoll(fds, nfds, &timespec or NULL, NULL, 0)\n    lx_label(c, \"lx_poll\");\n    lx(c, arm64.cmp_imm_x(2, 0, iie));\n    lx_bcc(c, 11, \"lx_poll_infinite\");\n    lx_li(c, 9, 1000);\n    lx(c, arm64.udiv_x(10, 2, 9));\n    lx(c, arm64.msub_x(11, 10, 9, 2));\n    lx_li(c, 12, 1000000);\n    lx(c, arm64.mul_x(11, 11, 12));\n    lx(c, arm64.str_x(10, 31, 144));\n    lx(c, arm64.str_x(11, 31, 152));\n    lx(c, arm64.add_imm_x(2, 31, 144, iie));\n    lx_b(c, \"lx_poll_go\");\n    lx_label(c, \"lx_poll_infinite\");\n    lx_li(c, 2, 0);\n    lx_label(c, \"lx_poll_go\");\n    lx_li(c, 3, 0);\n    lx_li(c, 4, 0);\n    lx_li(c, 8, 73);\n    lx_b(c, \"lx_svc\");\n\n    // ---- sysctl({CTL_HW, HW_MEMSIZE}, 2, oldp, oldlenp): physical memory in bytes from sysinfo(2); other names fail\n    lx_label(c, \"lx_sysctl\");\n    lx(c, arm64.ldr_w(9, 0, 0));\n    lx(c, arm64.cmp_imm_x(9, 6, iie));\n    lx_bcc(c, 1, \"lx_unsupported\");\n    lx(c, arm64.ldr_w(9, 0, 4));\n    lx(c, arm64.cmp_imm_x(9, 24, iie));\n    lx_bcc(c, 1, \"lx_unsupported\");\n    lx_mov(c, 13, 2);\n    lx_mov(c, 14, 3);\n    lx(c, arm64.add_imm_x(0, 31, 144, iie));\n    lx_li(c, 8, 179);\n    lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie));\n    lx_bcc(c, 11, \"lx_norm\");\n    lx(c, arm64.ldr_x(9, 31, 176));\n    lx(c, arm64.ldr_w(10, 31, 248));\n    lx(c, arm64.mul_x(9, 9, 10));\n    lx(c, arm64.str_x(9, 13, 0));\n    lx_li(c, 11, 8);\n    lx(c, arm64.str_x(11, 14, 0));\n    lx_li(c, 0, 0);\n    lx_b(c, \"lx_norm\");\n    // sysctlbyname: the memory-pressure level is optional input; report it as unavailable (ENOENT)\n    lx_label(c, \"lx_sysctlbyname\");\n    lx_li(c, 0, -2);\n    lx_b(c, \"lx_norm\");\n    // getrlimit: RLIMIT_AS is 5 on Darwin and 9 on Linux; Linux RLIM_INFINITY (~0) becomes the Darwin value 2^63 - 1\n    lx_label(c, \"lx_getrlimit\");\n    lx(c, arm64.cmp_imm_x(0, 5, iie));\n    lx_bcc(c, 1, \"lx_getrlimit_go\");\n    lx_li(c, 0, 9);\n    lx_label(c, \"lx_getrlimit_go\");\n    lx_mov(c, 13, 1);\n    lx_li(c, 8, 163);\n    lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie));\n    lx_bcc(c, 11, \"lx_norm\");\n    lx(c, arm64.movn_x(11, 0, 0));\n    lx(c, arm64.lsr_x(12, 11, 1));\n    kaku slot = 0;\n    aida (slot < 2) {\n        kaku keep = lx_name(\"lx_getrlimit_keep_\", slot);\n        lx(c, arm64.ldr_x(9, 13, slot * 8));\n        lx(c, arm64.cmp_x(9, 11));\n        lx_bcc(c, 1, keep);\n        lx(c, arm64.str_x(12, 13, slot * 8));\n        lx_label(c, keep);\n        slot = slot + 1;\n    }\n    lx_li(c, 0, 0);\n    lx_b(c, \"lx_norm\");\n\n    lx_errno(c);\n}\n" }; }
waza data_14() -> File { kaesu File { path: "kiso/aot/lower/lower.mio", version: "Bunko-v2.1.1", length: 181839, sha256: "a4954c01358f3415c1aa7309b9be62bf72e08e3ab34a907d10a80d3cfca2a2d9", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/aot/cabi\";\nyobu \"kiso/aot/lower/nativefs\";\nyobu \"kiso/aot/lower/types\";\nyobu \"kiso/aot/macho\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/encoding/mochi\";\nyobu \"kiso/string\";\n\n// M17e's native lowering tier. It accepts all v14 constant encodings and the\n// scalar opcode subset listed below plus typed Nullable and Struct operations.\n// A bounded managed region, exact Shadow Frames, mark/sweep and 32-bin reuse\n// provide GC-safe Struct, Array and Enum allocation plus NativeFS calls.\n// Closures use the M15b Cell/Environment protocol; unresolved layouts fail closed. Each generated call frame has a bounded\n// 4,080-byte local/operand area and uses the established one-word ABI.\nkoukai sentaku LowerError {\n    UnsupportedConstant;\n    UnsupportedOpcode(int64);\n    UnsupportedClosure;\n    InvalidFunction;\n    InvalidOperand(int64);\n    FrameTooLarge;\n    EncodeFailure;\n    UnsafeType(int64);\n    UnsupportedNative(int64);\n    BranchOutOfRange(int64);\n}\n\nkoukai kata LowerResult {\n    words: []uint32;\n    constants: []uint8;\n    patches: []macho.AddressPatch;\n    globals: int64;\n    error: LowerError?;\n    // code word of each Mochi function's entry (-1: not emitted); diagnostics such as symbol maps for profilers\n    function_words: []int64;\n    labels: []arm64.Label;\n}\n\nkoukai waza error_code(value: LowerError) -> int64 {\n    awase (value) {\n        baai UnsupportedConstant { kaesu 1; }\n        baai UnsupportedOpcode(detail) { kaesu 2; }\n        baai UnsupportedClosure { kaesu 3; }\n        baai InvalidFunction { kaesu 4; }\n        baai InvalidOperand(detail) { kaesu 5000 + detail; }\n        baai FrameTooLarge { kaesu 6; }\n        baai EncodeFailure { kaesu 7; }\n        baai UnsafeType(detail) { kaesu 8; }\n        baai UnsupportedNative(detail) { kaesu 9; }\n        baai BranchOutOfRange(detail) { kaesu 10; }\n    }\n    kaesu 0;\n}\n\n// For UnsupportedOpcode the detail packs (functionID+1, byteOffset, opcode)\n// as FFFFF*1_000_000 + offset*100 + opcode.  Main uses functionID -1 and\n// therefore has no leading function component. BranchOutOfRange instead\n// reports the generated machine-word index, after all bytecode lowering.\nkoukai waza error_detail(value: LowerError) -> int64 {\n    awase (value) {\n        baai UnsupportedOpcode(detail) { kaesu detail; }\n        baai InvalidOperand(detail) { kaesu detail; }\n        baai UnsupportedConstant { kaesu 0; }\n        baai UnsupportedClosure { kaesu 0; }\n        baai InvalidFunction { kaesu 0; }\n        baai FrameTooLarge { kaesu 0; }\n        baai EncodeFailure { kaesu 0; }\n        baai UnsafeType(detail) { kaesu detail; }\n        baai UnsupportedNative(detail) { kaesu detail; }\n        baai BranchOutOfRange(detail) { kaesu detail; }\n    }\n    kaesu 0;\n}\n\nwaza failed(kind: LowerError) -> LowerResult {\n    kaesu LowerResult { words: [], constants: [], patches: [], globals: 0, error: kind, function_words: [], labels: [] };\n}\n\nwaza same_bytes(left: []uint8, right: []uint8) -> bool {\n    moshi (len(left) != len(right)) { kaesu iie; }\n    kaku index = 0;\n    aida (index < len(left)) {\n        moshi (left[index] != right[index]) { kaesu iie; }\n        index = index + 1;\n    }\n    kaesu hai;\n}\n\n// Intern once in first-occurrence order. IDs are shared by instruction\n// lowering, the constant image and NativeFS's empty string.\nwaza string_ids(constants: []mochi.Constant) -> []int64 {\n    kaku ids = array.make[int64](len(constants), -1); kaku unique: []int64 = [];\n    kaku i = 0;\n    aida (i < len(constants)) {\n        moshi (constants[i].tag == uint8(2)) {\n            kaku id = 0;\n            aida (id < len(unique) && !same_bytes(constants[unique[id]].data, constants[i].data)) { id = id + 1; }\n            moshi (id == len(unique)) { array.push(unique, i); }\n            ids[i] = id;\n        }\n        i = i + 1;\n    }\n    kaesu ids;\n}\n\nwaza put_u32_le(data: []uint8, at: int64, value: int64) -> unit {\n    data[at] = uint8(value - (value / 256) * 256);\n    data[at + 1] = uint8((value / 256) - (value / 65536) * 256);\n    data[at + 2] = uint8((value / 65536) - (value / 16777216) * 256);\n    data[at + 3] = uint8(value / 16777216);\n}\n\n// The table matches the established Go runtime: one little-endian\n// (offset,length) entry per interned string, followed by the exact UTF-8 bytes.\nwaza constant_image(constants: []mochi.Constant, ids: []int64, add_empty: bool) -> []uint8 {\n    kaku unique = 0;\n    kaku has_empty = iie;\n    kaku index = 0;\n    aida (index < len(constants)) {\n        moshi (constants[index].tag == uint8(2)) {\n            moshi (len(constants[index].data) == 0) { has_empty = hai; }\n            moshi (ids[index] == unique) { unique = unique + 1; }\n        }\n        index = index + 1;\n    }\n    kaku table_count = unique; moshi (add_empty && !has_empty) { table_count = table_count + 1; }\n    kaku output = array.make[uint8](table_count * 8, uint8(0));\n    kaku cursor = table_count * 8;\n    index = 0; kaku next_id = 0;\n    aida (index < len(constants)) {\n        moshi (constants[index].tag == uint8(2)) {\n            kaku id = ids[index];\n            moshi (id == next_id) {\n                next_id = next_id + 1;\n                put_u32_le(output, id * 8, cursor);\n                put_u32_le(output, id * 8 + 4, len(constants[index].data));\n                array.append_all(output, constants[index].data);\n                cursor = cursor + len(constants[index].data);\n            }\n        }\n        index = index + 1;\n    }\n    kaesu output;\n}\n\nwaza empty_string_id(constants: []mochi.Constant, ids: []int64) -> int64 {\n    kaku unique = 0; kaku index = 0;\n    aida (index < len(constants)) {\n        moshi (constants[index].tag == uint8(2) && ids[index] == unique) {\n            moshi (len(constants[index].data) == 0) { kaesu unique; }\n            unique = unique + 1;\n        }\n        index = index + 1;\n    }\n    kaesu unique;\n}\n\nwaza emit_constant(code: arm64.Assembler, constants: []mochi.Constant, ids: []int64, at: int64) -> LowerError? {\n    moshi (at < 0 || at >= len(constants)) { kaesu LowerError.InvalidOperand(3000 + at); }\n    kaku constant = constants[at];\n    kaku high = constant.bits.high;\n    kaku low = constant.bits.low;\n    // Signed fixed-width constants are serialized as their exact 8/16/32-bit\n    // payload and occupy a sign-extended raw runtime slot.\n    moshi (constant.tag == uint8(5) && low >= uint32(128)) { high = uint32(4294967295); low = low + uint32(4294967040); }\n    moshi (constant.tag == uint8(6) && low >= uint32(32768)) { high = uint32(4294967295); low = low + uint32(4294901760); }\n    moshi (constant.tag == uint8(7) && low >= uint32(2147483648)) { high = uint32(4294967295); }\n    moshi (constant.tag == uint8(2)) {\n        kaku tagged = ids[at] * 2 + 1;\n        high = uint32(0); low = uint32(tagged);\n    }\n    moshi (constant.tag < uint8(1) || constant.tag > uint8(10)) { kaesu LowerError.UnsupportedConstant(); }\n    move_bits(code, 9, high, low); push_register(code, 9);\n    kaesu mu;\n}\n\nwaza operand_u16(data: []uint8, offset: int64) -> int64 {\n    kaesu int64(data[offset + 1]) * 256 + int64(data[offset + 2]);\n}\n\nwaza width(opcode: int64) -> int64 {\n    moshi (opcode == 1 || (opcode >= 17 && opcode <= 20) ||\n        (opcode >= 23 && opcode <= 25) || opcode == 30 || opcode == 36 || opcode == 37 || opcode == 40 || (opcode >= 44 && opcode <= 49)) { kaesu 3; }\n    moshi (opcode >= 2 && opcode <= 16) { kaesu 1; }\n    moshi (opcode == 54) { kaesu 3; }\n    moshi (opcode == 38) { kaesu 5; }\n    moshi (opcode == 39 || opcode == 41 || opcode == 42 || opcode == 43) { kaesu 1; }\n    moshi (opcode == 56 || opcode == 67) { kaesu 4; }\n    moshi (opcode == 55 || opcode == 57 || opcode == 58 || opcode == 65 || opcode == 66) { kaesu 2; }\n    moshi (opcode == 59 || opcode == 64 || opcode == 60 || opcode == 61 || opcode == 62 || opcode == 63) { kaesu 1; }\n    moshi (opcode == 21 || opcode == 22 || opcode == 26 || opcode == 27 || opcode == 28 || opcode == 29 || (opcode >= 50 && opcode <= 53) || opcode == 31 || opcode == 32 || opcode == 33 || opcode == 34 || opcode == 35) { kaesu 1; }\n    kaesu 0;\n}\n\n// Struct fields are not at a fixed offset.  The M12/M16b payload is\n// {kind,fieldCount,fieldCount,bitmapWords,bitmap...,fields...}; consequently\n// even the same field index moves when a struct crosses a 64-field bitmap\n// boundary.  Load bitmapWords from the receiver and form the address at run\n// time.  OpGetField is allocation-free and has no helper call, so replacing\n// the receiver slot in place does not introduce a GC safepoint.\nwaza emit_get_field(code: arm64.Assembler, index: int64) -> unit {\n    pop_register(code, 9); move_bits(code, 11, uint32(0), uint32(index));\n    arm64.assembler_bl(code, \"rt_get_field\");\n    push_register(code, 9);\n}\n\n// x9 receiver, x11 field index -> x9 field value; uses x10-x14 (and the heap-read scratch). One shared copy of the\n// receiver kind, field bound, bitmap and payload checks that every field read performs.\nwaza emit_get_field_routine(code: arm64.Assembler) -> unit {\n    arm64.assembler_label(code, \"rt_get_field\");\n    arm64.assembler_cbz_x(code, 9, \"runtime_error\");\n    emit(code, arm64.ldr_x(10, 9, 0)); emit(code, arm64.cmp_imm_x(10, 1, iie)); arm64.assembler_b_cond(code, 1, \"runtime_error\");\n    emit(code, arm64.ldr_x(10, 9, 8)); emit(code, arm64.cmp_x(11, 10)); arm64.assembler_b_cond(code, 2, \"runtime_error\");\n    emit(code, arm64.ldr_x(10, 9, 24));\n    emit(code, arm64.ldr_x(12, 9, 8)); emit(code, arm64.add_imm_x(13, 12, 63, iie)); emit(code, arm64.lsr_x(13, 13, 6)); emit(code, arm64.cmp_x(13, 10));\n    arm64.assembler_b_cond(code, 1, \"runtime_error\");\n    emit(code, arm64.add_x(13, 10, 12)); emit(code, arm64.lsl_x(13, 13, 3)); emit(code, arm64.add_imm_x(13, 13, 32, iie));\n    emit(code, arm64.sub_imm_x(14, 9, 16, iie)); emit(code, arm64.ldr_x(14, 14, 8)); emit(code, arm64.cmp_x(13, 14));\n    arm64.assembler_b_cond(code, 8, \"runtime_error\");\n    emit(code, arm64.lsl_x(10, 10, 3));\n    emit(code, arm64.add_x(9, 9, 10));\n    emit(code, arm64.lsl_x(11, 11, 3));\n    emit(code, arm64.add_x(9, 9, 11));\n    emit_heap_read_word(code,9,9,32);\n    emit(code, arm64.ret());\n}\n\nwaza emit_len(code: arm64.Assembler, kind: int64) -> bool {\n    pop_register(code, 9);\n    moshi (kind == types.type_unknown || kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.movz_x(10, 1, 0)); emit(code, arm64.and_x(10, 9, 10)); emit(code, arm64.cmp_imm_x(10, 0, iie));\n        kaku dynamic_label = string.concat(\"len_dynamic_\", convert.format_int(len(code.words))); kaku done_label = string.concat(\"len_done_\", convert.format_int(len(code.words)));\n        arm64.assembler_b_cond(code, 0, dynamic_label); emit(code, arm64.lsr_x(10, 9, 1)); emit(code, arm64.lsl_x(10, 10, 3)); emit(code, arm64.add_x(10, 28, 10)); emit(code, arm64.ldr_x(10, 10, 0)); emit(code, arm64.lsr_x(9, 10, 32)); arm64.assembler_b(code, done_label);\n        arm64.assembler_label(code, dynamic_label); emit(code, arm64.ldr_x(9, 9, 8)); arm64.assembler_label(code, done_label); push_register(code, 9); kaesu hai;\n    }\n    moshi (kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\");\n        emit(code, arm64.lsr_x(10, 9, 1)); emit(code, arm64.lsl_x(10, 10, 3)); emit(code, arm64.add_x(10, 28, 10)); emit(code, arm64.ldr_x(10, 10, 0)); emit(code, arm64.lsr_x(9, 10, 32)); push_register(code, 9); kaesu hai;\n    }\n    moshi (kind == types.type_array_ref) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.ldr_x(9, 9, 8)); push_register(code, 9); kaesu hai;\n    }\n    kaesu iie;\n}\n\n// Full-mode readers pair with published mutable slots; no GC operation here.\nwaza emit_heap_read_word(code:arm64.Assembler,dst:int64,base:int64,offset:int64) -> unit {\n    moshi(!old_sweep_enabled(code)){emit(code,arm64.ldr_x(dst,base,offset));kaesu;}\n    moshi(offset==0){emit(code,arm64.ldar_x(dst,base));kaesu;}\n    kaku temp=14;moshi(dst==14){temp=15;}\n    emit(code,arm64.sub_imm_x(31,31,16,iie));emit(code,arm64.str_x(temp,31,0));\n    emit(code,arm64.add_imm_x(temp,base,offset,iie));emit(code,arm64.ldar_x(dst,temp));\n    emit(code,arm64.ldr_x(temp,31,0));emit(code,arm64.add_imm_x(31,31,16,iie));\n}\n\n// x9 array descriptor (non-nil), x10 index -> x9 element; uses x11, x12. The unsigned bound check also rejects negative\n// indexes; the element width byte (header bits 8..15) must be 8 or 1.\nwaza emit_array_element(code: arm64.Assembler) -> unit {\n    emit(code, arm64.ldr_x(11, 9, 8)); emit(code, arm64.cmp_x(10, 11)); arm64.assembler_b_cond(code, 2, \"runtime_error\");\n    emit(code, arm64.ldrb_w(11, 9, 1));\n    emit_heap_read_word(code,12,9,40); emit(code, arm64.add_imm_x(12, 12, 32, iie));\n    kaku byte_label = block_label(\"index_byte_\", len(code.words)); kaku done_label = string.concat(byte_label, \"_done\");\n    emit(code, arm64.cmp_imm_x(11, 8, iie)); arm64.assembler_b_cond(code, 1, byte_label);\n    moshi (old_sweep_enabled(code)) { emit(code, arm64.lsl_x(11, 10, 3)); emit(code, arm64.add_x(12, 12, 11)); emit_heap_read_word(code,9,12,0); }\n    sore { emit(code, arm64.ldr_x_register_scaled(9, 12, 10)); }\n    arm64.assembler_b(code, done_label);\n    arm64.assembler_label(code, byte_label); emit(code, arm64.cmp_imm_x(11, 1, iie)); arm64.assembler_b_cond(code, 1, \"runtime_error\");\n    emit(code, arm64.ldrb_w_register(9, 12, 10));\n    arm64.assembler_label(code, done_label);\n}\n\nwaza emit_index(code: arm64.Assembler, analysis: types.TypeAnalysis, index_node: int64, kind: int64) -> bool {\n    emit(code, arm64.sub_imm_x(20, 20, 16, iie)); emit(code, arm64.add_x(8, 19, 20)); emit(code, arm64.ldp_x(9, 10, 8, 0));\n    emit_unbox_register(code, analysis, index_node, 10);\n    // Every path below compares the index with the length as unsigned (B.HS), which also rejects negative indexes.\n    moshi (kind == types.type_unknown || kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.movz_x(11, 1, 0)); emit(code, arm64.and_x(11, 9, 11)); emit(code, arm64.cmp_imm_x(11, 0, iie));\n        kaku array_label = string.concat(\"index_array_\", convert.format_int(len(code.words))); kaku done_label = string.concat(\"index_unknown_done_\", convert.format_int(len(code.words)));\n        arm64.assembler_b_cond(code, 0, array_label); emit(code, arm64.lsr_x(11, 9, 1)); emit(code, arm64.lsl_x(11, 11, 3)); emit(code, arm64.add_x(11, 28, 11)); emit(code, arm64.ldr_x(12, 11, 0)); emit(code, arm64.lsr_x(13, 12, 32)); emit(code, arm64.cmp_x(10, 13)); arm64.assembler_b_cond(code, 2, \"runtime_error\"); move_bits(code, 13, uint32(0), uint32(4294967295)); emit(code, arm64.and_x(12, 12, 13)); emit(code, arm64.add_x(12, 28, 12)); emit(code, arm64.add_x(12, 12, 10)); emit(code, arm64.ldrb_w(9, 12, 0)); arm64.assembler_b(code, done_label);\n        arm64.assembler_label(code, array_label); emit_array_element(code); arm64.assembler_label(code, done_label); push_register(code, 9); kaesu hai;\n    }\n    moshi (kind == types.type_string_id) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit(code, arm64.lsr_x(11, 9, 1)); emit(code, arm64.lsl_x(11, 11, 3)); emit(code, arm64.add_x(11, 28, 11)); emit(code, arm64.ldr_x(12, 11, 0)); emit(code, arm64.lsr_x(13, 12, 32)); emit(code, arm64.cmp_x(10, 13)); arm64.assembler_b_cond(code, 2, \"runtime_error\");\n        move_bits(code, 13, uint32(0), uint32(4294967295)); emit(code, arm64.and_x(12, 12, 13)); emit(code, arm64.add_x(12, 28, 12)); emit(code, arm64.add_x(12, 12, 10)); emit(code, arm64.ldrb_w(9, 12, 0)); push_register(code, 9); kaesu hai;\n    }\n    moshi (kind == types.type_array_ref) {\n        arm64.assembler_cbz_x(code, 9, \"runtime_error\"); emit_array_element(code); push_register(code, 9); kaesu hai;\n    }\n    kaesu iie;\n}\n\n// Globals remain in Mach-O __DATA. A separate zero-filled anonymous mapping\n// owns metadata followed by a contiguous, non-moving managed arena. OS page\n// boundaries are not object boundaries; mark/sweep walks object headers.\nteisu runtime_default_heap_bytes = 134217728;\nteisu runtime_max_heap_bytes = 1073741824;\nteisu runtime_max_storage_bytes = 1073741792;\nteisu runtime_metadata_bytes = 3072;\n\nwaza adjust_sp(code: arm64.Assembler, bytes: int64, subtract: bool) -> unit {\n    kaku left = bytes;\n    aida (left > 0) {\n        kaku part = left; moshi (part > 4080) { part = 4080; }\n        moshi (subtract) { emit(code, arm64.sub_imm_x(31, 31, part, iie)); }\n        sore { emit(code, arm64.add_imm_x(31, 31, part, iie)); }\n        left = left - part;\n    }\n}\n\nwaza root_node_ok(type_result: types.TypeAnalysis, node: int64) -> bool {\n    kaesu types.type_kind(type_result, node) != types.type_unknown;\n}\n\n// Materialize the exact live reference vector immediately before a safepoint.\n// record = {previous,count,values...}.  Locals/globals use their solved slot\n// types; operand roots use the precise entry state for this opcode.\nwaza emit_root_load(code: arm64.Assembler, reg: int64, base: int64, offset: int64) -> unit {\n    moshi (offset < 0) { move_x(code, reg, base); } sore { emit(code, arm64.ldr_x(reg, base, offset)); }\n}\n\n// Copies root i from (base[i], offset[i]) (offset -1: the register itself) to shadow slot first + i.\nwaza emit_root_sources(code: arm64.Assembler, base: []int64, offset: []int64, first: int64) -> unit {\n    kaku i = 0;\n    aida (i < len(base)) {\n        kaku slot = 16 + (first + i) * 8;\n        moshi (i + 1 < len(base)) {\n            moshi (offset[i] >= 0 && base[i + 1] == base[i] && offset[i + 1] == offset[i] + 8 && offset[i] <= 504) {\n                emit(code, arm64.ldp_x(8, 9, base[i], offset[i]));\n            } sore { emit_root_load(code, 8, base[i], offset[i]); emit_root_load(code, 9, base[i + 1], offset[i + 1]); }\n            moshi (slot + 8 <= 504) { emit(code, arm64.stp_x(8, 9, 31, slot)); }\n            sore { emit(code, arm64.str_x(8, 31, slot)); emit(code, arm64.str_x(9, 31, slot + 8)); }\n            i = i + 2;\n        } sore {\n            emit_root_load(code, 9, base[i], offset[i]); emit(code, arm64.str_x(9, 31, slot)); i = i + 1;\n        }\n    }\n}\n\nwaza emit_shadow_push(code: arm64.Assembler, patches: []macho.AddressPatch,\n    type_result: types.TypeAnalysis, function_id: int64, entries: []int64) -> int64 {\n    kaku roots = 0;\n    kaku index = 0;\n    aida (index < len(type_result.globals)) {\n        moshi (!root_node_ok(type_result, type_result.globals[index])) { kaesu -1; }\n        moshi (types.type_is_heap_reference(type_result, type_result.globals[index])) { roots = roots + 1; }\n        index = index + 1;\n    }\n    kaku global_roots=roots;\n    moshi (function_id >= 0) {\n        moshi (len(type_result.upvalues[function_id]) > 0) { roots = roots + 1; }\n        index = 0;\n        aida (index < len(type_result.cells[function_id])) { moshi (type_result.cells[function_id][index]) { roots = roots + 1; } index = index + 1; }\n        index = 0;\n        aida (index < len(type_result.locals[function_id])) {\n            moshi (!root_node_ok(type_result, type_result.locals[function_id][index])) { kaesu -1; }\n            moshi (types.type_is_heap_reference(type_result, type_result.locals[function_id][index])) { roots = roots + 1; }\n            index = index + 1;\n        }\n    }\n    index = 0;\n    aida (index < len(entries)) {\n        moshi (!root_node_ok(type_result, entries[index])) { kaesu -1; }\n        moshi (types.type_is_heap_reference(type_result, entries[index])) { roots = roots + 1; }\n        index = index + 1;\n    }\n    kaku bytes = (roots + 2) * 8;\n    moshi (bytes - (bytes / 16) * 16 != 0) { bytes = bytes + 8; }\n    adjust_sp(code, bytes, hai);\n    emit(code, arm64.str_x(24, 31, 0));\n    // Worker frame descriptor: low32 total roots, high32 leading global slots.\n    // Global entries are exact shared slot addresses, read only after the real\n    // all-Mutator handshake. A blocked frame must not retain an old global value.\n    kaku indirect=0;moshi(worker_roots_enabled(code)){indirect=global_roots;}\n    move_bits(code, 9, uint32(indirect), uint32(roots)); emit(code, arm64.str_x(9, 31, 8));\n    kaku root = 0;\n    index = 0;\n    aida (index < len(type_result.globals)) {\n        moshi (types.type_is_heap_reference(type_result, type_result.globals[index])) {\n            kaku at = len(code.words);\n            emit(code, arm64.Instruction { word: uint32(0), error: mu });\n            emit(code, arm64.Instruction { word: uint32(0), error: mu });\n            array.push(patches, macho.AddressPatch { at_word: at, add_at_word: at + 1,\n                target: macho.data_target(), target_offset: index * 8, register: 8 });\n            moshi(worker_roots_enabled(code)){move_x(code,9,8);}sore{emit(code, arm64.ldr_x(9, 8, 0));}\n            emit(code, arm64.str_x(9, 31, 16 + root * 8)); root = root + 1;\n        }\n        index = index + 1;\n    }\n    // Cells first (their address is computed), then the plain sources: the upvalue register, locals and operands.\n    // Those are copied two at a time through x8/x9 (ldp/stp where the slots are adjacent); the frame layout and the\n    // order of roots are exactly those of the one-by-one copy.\n    kaku source_base: []int64 = []; kaku source_offset: []int64 = [];\n    moshi (function_id >= 0) {\n        kaku cell_root = root; moshi (len(type_result.upvalues[function_id]) > 0) { cell_root = cell_root + 1; }\n 