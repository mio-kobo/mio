waza data_7() -> File { kaesu File { path: "kiso/aot/lower/large_objects.mio", version: "Bunko-v2.1.1", length: 6575, sha256: "a131a089a1c5669d2ba71c0408029fbef2e0b1eef363fab03f9798f725f057f0", source: "yobu \"kiso/aot/arm64\";\n\n// Independent page-rounded mappings. Prefix: next, mapping bytes, young link,\n// remembered link; unchanged object header at +32 and payload at +48.\nteisu los_Head = gc.los_head;\nteisu los_Bytes = gc.los_bytes;\nteisu los_Reclaimed = gc.los_reclaimed;\nteisu los_Count = gc.los_count;\nteisu los_Threshold = gc.los_threshold;\n\nwaza emit_los_side(code: arm64.Assembler, dst: int64, header: int64, scratch: int64) -> unit {\n kaku outside = block_label(\"los_side_\", len(code.words));\n kaku done = string.concat(outside, \"_done\");\n emit(code,arm64.add_imm_x(dst,23,3072,iie)); emit(code,arm64.cmp_x(header,dst)); arm64.assembler_b_cond(code,3,outside);\n emit(code,arm64.ldr_x(scratch,23,8)); emit(code,arm64.cmp_x(header,scratch)); arm64.assembler_b_cond(code,2,outside);\n emit(code,arm64.sub_x(dst,header,dst)); emit(code,arm64.add_x(dst,dst,scratch)); arm64.assembler_b(code,done);\n arm64.assembler_label(code,outside); emit(code,arm64.sub_imm_x(dst,header,16,iie)); emit(code,arm64.ldr_x(scratch,23,8));\n arm64.assembler_label(code,done);\n}\n\nwaza emit_los_runtime(code: arm64.Assembler) -> unit {\n // x19 payload bytes, x20 packed type, x22 physical span; no managed safepoint.\n arm64.assembler_label(code,\"los_alloc\");\n emit(code,arm64.sub_imm_x(31,31,16,iie));\n emit(code,arm64.add_imm_x(1,22,32,iie)); emit(code,arm64.movz_x(10,16383,0)); emit(code,arm64.add_x(1,1,10)); emit(code,arm64.movn_x(10,16383,0)); emit(code,arm64.and_x(1,1,10)); emit(code,arm64.str_x(1,31,0));\n emit(code,arm64.ldr_x(9,23,memory_Committed)); emit(code,arm64.add_x(9,9,1)); emit(code,arm64.ldr_x(10,23,memory_Limit)); emit(code,arm64.cmp_x(9,10)); arm64.assembler_b_cond(code,8,\"los_alloc_fail\");\n emit(code,arm64.movz_x(0,0,0)); emit(code,arm64.movz_x(2,3,0)); emit(code,arm64.movz_x(3,4098,0)); emit(code,arm64.movn_x(4,0,0)); emit(code,arm64.movz_x(5,0,0)); emit(code,arm64.movz_x(16,197,0)); emit(code,arm64.svc(128));\n arm64.assembler_b_cond(code,2,\"los_alloc_fail\");\n emit(code,arm64.ldr_x(9,23,los_Head)); emit(code,arm64.str_x(9,0,0)); emit(code,arm64.str_x(0,23,los_Head)); emit(code,arm64.ldr_x(9,31,0)); emit(code,arm64.str_x(9,0,8)); emit(code,arm64.ldr_x(10,23,memory_LOSCommitted)); emit(code,arm64.add_x(10,10,9)); emit(code,arm64.str_x(10,23,memory_LOSCommitted)); emit(code,arm64.str_x(20,0,32)); emit(code,arm64.str_x(19,0,40));\n emit(code,arm64.ldr_x(9,23,los_Bytes)); emit(code,arm64.add_x(9,9,22)); emit(code,arm64.str_x(9,23,los_Bytes));\n emit(code,arm64.ldr_x(9,23,los_Count)); emit(code,arm64.add_imm_x(9,9,1,iie)); emit(code,arm64.str_x(9,23,los_Count));\n emit(code,arm64.add_imm_x(0,0,48,iie)); arm64.assembler_b(code,\"los_alloc_return\");\n arm64.assembler_label(code,\"los_alloc_fail\"); emit(code,arm64.movz_x(0,0,0));\n arm64.assembler_label(code,\"los_alloc_return\"); emit(code,arm64.add_imm_x(31,31,16,iie)); emit(code,arm64.ret());\n\n // Routine collections retain the bounded release batch. Allocation pressure\n // gets one finite pass after completed Major/rebuild, before the final retry.\n emit_los_prune(code, iie); emit_los_prune(code, hai);\n\n // Major sweep; returns live physical bytes in x0 for occupied accounting.\n arm64.assembler_label(code,\"los_major\");\n emit(code,arm64.movz_x(0,0,0)); emit(code,arm64.ldr_x(12,23,los_Head));\n arm64.assembler_label(code,\"los_major_loop\"); arm64.assembler_cbz_x(code,12,\"los_major_done\");\n emit(code,arm64.ldr_x(9,12,32)); arm64.assembler_cbz_x(code,9,\"los_major_next\");\n emit(code,arm64.ldr_x(9,12,32)); move_bits(code,10,uint32(1),uint32(0)); emit(code,arm64.and_x(10,9,10));\n arm64.assembler_cbz_x(code,10,\"los_major_dead\");\n move_bits(code,10,uint32(4294967292),uint32(4294967295)); emit(code,arm64.and_x(9,9,10)); emit(code,arm64.str_x(9,12,32));\n emit(code,arm64.ldr_x(9,12,40)); emit(code,arm64.add_imm_x(9,9,31,iie)); emit(code,arm64.movn_x(10,15,0)); emit(code,arm64.and_x(9,9,10)); emit(code,arm64.add_x(0,0,9)); arm64.assembler_b(code,\"los_major_next\");\n arm64.assembler_label(code,\"los_major_dead\"); emit(code,arm64.str_x(31,12,32));\n emit(code,arm64.ldr_x(9,12,40)); emit(code,arm64.add_imm_x(9,9,31,iie)); emit(code,arm64.movn_x(10,15,0)); emit(code,arm64.and_x(9,9,10));\n emit(code,arm64.ldr_x(10,23,los_Bytes)); emit(code,arm64.sub_x(10,10,9)); emit(code,arm64.str_x(10,23,los_Bytes));\n emit(code,arm64.ldr_x(10,23,los_Reclaimed)); emit(code,arm64.add_x(10,10,9)); emit(code,arm64.str_x(10,23,los_Reclaimed));\n emit(code,arm64.ldr_x(10,23,los_Count)); emit(code,arm64.sub_imm_x(10,10,1,iie)); emit(code,arm64.str_x(10,23,los_Count));\n arm64.assembler_label(code,\"los_major_next\"); emit(code,arm64.ldr_x(12,12,0)); arm64.assembler_b(code,\"los_major_loop\");\n arm64.assembler_label(code,\"los_major_done\"); emit(code,arm64.ret());\n}\n\n// This adapter releases only nodes already marked dead by a real collection.\n// A failed munmap is relinked with ownership/charge intact and visited once;\n// neither mode retries the OS operation indefinitely or changes liveness.\nwaza emit_los_prune(code: arm64.Assembler, pressure: bool) -> unit {\n kaku name=\"los_prune\"; moshi(pressure){name=\"los_prune_pressure\";}\n kaku loop=string.concat(name,\"_loop\"); kaku done=string.concat(name,\"_done\");\n kaku dead=string.concat(name,\"_dead\"); kaku failed=string.concat(name,\"_failed\");\n arm64.assembler_label(code,name);\n emit(code,arm64.stp_pre_x(19,20,31,-16)); emit(code,arm64.stp_pre_x(21,22,31,-16));\n emit(code,arm64.add_imm_x(19,23,los_Head,iie)); emit(code,arm64.movz_x(22,0,0));\n arm64.assembler_label(code,loop); emit(code,arm64.ldr_x(20,19,0)); arm64.assembler_cbz_x(code,20,done);\n emit(code,arm64.ldr_x(9,20,32)); arm64.assembler_cbz_x(code,9,dead); move_x(code,19,20); arm64.assembler_b(code,loop);\n arm64.assembler_label(code,dead); moshi (!pressure) { emit(code,arm64.cmp_imm_x(22,8,iie)); arm64.assembler_b_cond(code,2,done); emit(code,arm64.add_imm_x(22,22,1,iie)); } emit(code,arm64.ldr_x(9,20,0)); emit(code,arm64.str_x(9,19,0)); emit(code,arm64.ldr_x(1,20,8)); move_x(code,21,1); move_x(code,0,20); emit(code,arm64.movz_x(16,73,0)); emit(code,arm64.svc(128)); arm64.assembler_b_cond(code,2,failed); emit(code,arm64.ldr_x(9,23,memory_LOSCommitted)); emit(code,arm64.sub_x(9,9,21)); emit(code,arm64.str_x(9,23,memory_LOSCommitted)); arm64.assembler_b(code,loop);\n arm64.assembler_label(code,failed);\n emit(code,arm64.ldr_x(9,19,0)); emit(code,arm64.str_x(9,20,0)); emit(code,arm64.str_x(20,19,0)); move_x(code,19,20); arm64.assembler_b(code,loop);\n arm64.assembler_label(code,done); emit(code,arm64.ldp_post_x(21,22,31,16)); emit(code,arm64.ldp_post_x(19,20,31,16)); emit(code,arm64.ret());\n}\n" }; }
waza data_8() -> File { kaesu File { path: "kiso/aot/lower/linuxabi.mio", version: "Bunko-v2.1.1", length: 20714, sha256: "9123d788553289a65b12ed9f1e2e29f858df558dd3778b77bf4fab03f7b10dd7", source: "yobu \"kiso/aot/arm64\";\nyobu \"kiso/array\";\nyobu \"kiso/convert\";\nyobu \"kiso/string\";\n\n// Linux AArch64 operating-system adapter for the Darwin/AArch64 lowering.\n//\n// The Darwin backend reaches the kernel only through `SVC #128` (BSD system-call number in x16, carry flag set and a\n// positive errno in x0 on failure). With the label `linux_abi` defined (see arm64.assembler_emit) every such SVC becomes\n// a call of `linux_syscall`, emitted here. The routine translates the call into the Linux AArch64 system call: number,\n// argument conventions, flag values, the `stat` and directory-entry layouts, sockaddr_in and the errno values, and it\n// returns the Darwin result convention. Calls that have no translation fail explicitly with ENOSYS (Darwin value 78).\n// All registers except x0, x1, x16 and the flags are preserved, as the Darwin kernel does; x1 is preserved unless the\n// call defines a second result (fork).\n//\n// Frame (288 bytes): 0..127 saved x2..x15, x17, x30; 128 original x1; 144..271 scratch (stat buffer, sockaddr, path).\n\nwaza lx(c: arm64.Assembler, i: arm64.Instruction) -> unit { arm64.assembler_emit(c, i); }\nwaza lx_label(c: arm64.Assembler, name: string) -> unit { arm64.assembler_label(c, name); }\nwaza lx_b(c: arm64.Assembler, name: string) -> unit { arm64.assembler_b(c, name); }\nwaza lx_bcc(c: arm64.Assembler, condition: int64, name: string) -> unit { arm64.assembler_b_cond(c, condition, name); }\nwaza lx_cbz(c: arm64.Assembler, reg: int64, name: string) -> unit { arm64.assembler_cbz_x(c, reg, name); }\nwaza lx_cbnz(c: arm64.Assembler, reg: int64, name: string) -> unit { arm64.assembler_cbnz_x(c, reg, name); }\nwaza lx_bl(c: arm64.Assembler, name: string) -> unit { arm64.assembler_bl(c, name); }\nwaza lx_mov(c: arm64.Assembler, rd: int64, rn: int64) -> unit { lx(c, arm64.add_imm_x(rd, rn, 0, iie)); }\n// Load an immediate in [-65536, 4294967295].\nwaza lx_li(c: arm64.Assembler, reg: int64, value: int64) -> unit {\n    moshi (value < 0) { lx(c, arm64.movn_x(reg, -value - 1, 0)); kaesu; }\n    moshi (value < 65536) { lx(c, arm64.movz_x(reg, value, 0)); kaesu; }\n    kaku low = value - (value / 65536) * 65536;\n    lx(c, arm64.movz_x(reg, low, 0)); lx(c, arm64.movk_x(reg, value / 65536, 1));\n}\nwaza lx_name(prefix: string, index: int64) -> string { kaesu string.concat(prefix, convert.format_int(index)); }\n\n// A direct translation: only the number changes (arguments and result convention are identical).\nwaza lx_direct(c: arm64.Assembler, darwin: int64, linux: int64, index: int64) -> unit {\n    kaku next = lx_name(\"lx_direct_next_\", index);\n    lx(c, arm64.cmp_imm_x(16, darwin, iie)); lx_bcc(c, 1, next);\n    lx_li(c, 8, linux); lx_b(c, \"lx_svc\");\n    lx_label(c, next);\n}\n\n// Dispatch entry for a translated call: `lx_dispatch(c, darwin, label)` jumps to label when x16 == darwin.\nwaza lx_dispatch(c: arm64.Assembler, darwin: int64, target: string, index: int64) -> unit {\n    kaku next = lx_name(\"lx_dispatch_next_\", index);\n    lx(c, arm64.cmp_imm_x(16, darwin, iie)); lx_bcc(c, 1, next); lx_b(c, target);\n    lx_label(c, next);\n}\n\n// dst = (src & 3) | translated flag bits; pairs are (darwin mask, linux mask). Uses x10-x12.\nwaza lx_flags(c: arm64.Assembler, src: int64, dst: int64, masks: []int64, prefix: string) -> unit {\n    lx_li(c, 10, 3); lx(c, arm64.and_x(dst, src, 10));\n    kaku at = 0;\n    aida (at < len(masks)) {\n        kaku skip = lx_name(prefix, at);\n        lx_li(c, 10, masks[at]); lx(c, arm64.and_x(11, src, 10)); lx_cbz(c, 11, skip);\n        lx_li(c, 12, masks[at + 1]); lx(c, arm64.orr_x(dst, dst, 12));\n        lx_label(c, skip);\n        at = at + 2;\n    }\n}\n\n// Store the bytes of `text` plus a NUL at [base, #offset...] using x9.\nwaza lx_store_text(c: arm64.Assembler, base: int64, offset: int64, text: string) -> int64 {\n    kaku bytes = string.to_bytes(text); kaku at = 0;\n    aida (at < len(bytes)) { lx_li(c, 9, int64(bytes[at])); lx(c, arm64.strb_w(9, base, offset + at)); at = at + 1; }\n    lx(c, arm64.strb_w(31, base, offset + len(bytes)));\n    kaesu offset + len(bytes);\n}\n\n// readlinkat(AT_FDCWD, path at x1, buffer at x2, size x3) then NUL-terminate: result 0 or a negative errno in x0.\nwaza lx_readlink_finish(c: arm64.Assembler, label: string) -> unit {\n    lx_li(c, 0, -100); lx_li(c, 8, 78); lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie)); lx_bcc(c, 11, \"lx_norm\");\n    lx(c, arm64.add_x(9, 2, 0)); lx(c, arm64.strb_w(31, 9, 0)); lx_li(c, 0, 0); lx_b(c, \"lx_norm\");\n}\n\n// Linux errno -> Darwin errno for the values that differ (x0 in and out; uses x9, x10).\nwaza lx_errno(c: arm64.Assembler) -> unit {\n    lx_label(c, \"lx_errno\");\n    kaku pairs = [11, 35, 115, 36, 114, 37, 88, 38, 89, 39, 90, 40, 91, 41, 92, 42, 93, 43, 95, 45, 97, 47, 98, 48, 99, 49, 100, 50,\n        101, 51, 103, 53, 104, 54, 105, 55, 106, 56, 107, 57, 110, 60, 111, 61, 113, 65, 39, 66, 40, 62, 36, 63, 38, 78];\n    kaku at = 0;\n    aida (at < len(pairs)) {\n        kaku next = lx_name(\"lx_errno_next_\", at);\n        lx(c, arm64.cmp_imm_x(0, pairs[at], iie)); lx_bcc(c, 1, next);\n        lx_li(c, 0, pairs[at + 1]); lx(c, arm64.ret());\n        lx_label(c, next);\n        at = at + 2;\n    }\n    lx(c, arm64.ret());\n}\n\nwaza lx_save_pair(c: arm64.Assembler, a: int64, b: int64, offset: int64) -> unit { lx(c, arm64.stp_x(a, b, 31, offset)); }\nwaza lx_load_pair(c: arm64.Assembler, a: int64, b: int64, offset: int64) -> unit { lx(c, arm64.ldp_x(a, b, 31, offset)); }\n\nkoukai waza emit_linux_abi_runtime(c: arm64.Assembler) -> unit {\n    lx_label(c, \"linux_syscall\");\n    lx(c, arm64.sub_imm_x(31, 31, 288, iie));\n    lx_save_pair(c, 2, 3, 0); lx_save_pair(c, 4, 5, 16); lx_save_pair(c, 6, 7, 32); lx_save_pair(c, 8, 9, 48);\n    lx_save_pair(c, 10, 11, 64); lx_save_pair(c, 12, 13, 80); lx_save_pair(c, 14, 15, 96); lx_save_pair(c, 17, 30, 112);\n    lx(c, arm64.str_x(1, 31, 128));\n    // ---- direct translations (number only)\n    kaku direct = [1, 94, 3, 63, 4, 64, 6, 57, 7, 260, 20, 172, 30, 202, 59, 221, 83, 103, 97, 198, 106, 201, 195, 164, 74, 226];\n    kaku at = 0;\n    aida (at < len(direct)) { lx_direct(c, direct[at], direct[at + 1], at); at = at + 2; }\n    // ---- translated calls\n    kaku calls = [73, 5, 197, 338, 344, 136, 137, 10, 15, 2, 90, 92, 105, 104, 98, 230, 336, 202, 274, 194];\n    kaku names = [\"lx_munmap\", \"lx_open\", \"lx_mmap\", \"lx_stat\", \"lx_dirents\", \"lx_mkdir\", \"lx_rmdir\", \"lx_unlink\", \"lx_chmod\", \"lx_fork\", \"lx_dup2\",\n        \"lx_fcntl\", \"lx_setsockopt\", \"lx_bind\", \"lx_connect\", \"lx_poll\", \"lx_procinfo\", \"lx_sysctl\", \"lx_sysctlbyname\", \"lx_getrlimit\"];\n    at = 0;\n    aida (at < len(calls)) { lx_dispatch(c, calls[at], names[at], at); at = at + 1; }\n    lx_li(c, 0, -38); lx_b(c, \"lx_norm\");\n\n    // ---- common completion\n    lx_label(c, \"lx_svc\"); lx(c, arm64.svc(0));\n    lx_label(c, \"lx_norm\");\n    lx(c, arm64.cmn_imm_x(0, 4095, iie)); lx_bcc(c, 3, \"lx_done\");\n    lx(c, arm64.sub_x(0, 31, 0)); lx_bl(c, \"lx_errno\"); lx(c, arm64.cmp_x(31, 31));\n    lx_label(c, \"lx_done\");\n    lx(c, arm64.ldr_x(1, 31, 128));\n    lx_label(c, \"lx_return\");\n    lx_load_pair(c, 2, 3, 0); lx_load_pair(c, 4, 5, 16); lx_load_pair(c, 6, 7, 32); lx_load_pair(c, 8, 9, 48);\n    lx_load_pair(c, 10, 11, 64); lx_load_pair(c, 12, 13, 80); lx_load_pair(c, 14, 15, 96); lx_load_pair(c, 17, 30, 112);\n    lx(c, arm64.add_imm_x(31, 31, 288, iie)); lx(c, arm64.ret());\n\n    // ---- open(path, flags, mode) -> openat(AT_FDCWD, path, flags', mode)\n    lx_label(c, \"lx_open\");\n    lx_mov(c, 3, 2);\n    lx_flags(c, 1, 9, [512, 64, 1024, 512, 8, 1024, 2048, 128, 4, 2048, 1048576, 16384, 16777216, 524288, 32768, 2097152], \"lx_open_skip_\");\n    lx_mov(c, 1, 0); lx_mov(c, 2, 9); lx_li(c, 0, -100); lx_li(c, 8, 56); lx_b(c, \"lx_svc\");\n\n    // ---- mmap: the Darwin kernel works in 16 KiB pages (mappings are 16 KiB aligned and their length is rounded up to\n    // 16 KiB; the runtime protects and releases ranges up to that rounded end), Linux in 4 KiB pages. Length is rounded\n    // to 16 KiB here; mappings of 64 KiB or more are also aligned to 16 KiB by over-allocating and trimming the slack.\n    // MAP_ANON 0x1000 -> 0x20; very large reservations are MAP_NORESERVE (0x4000).\n    lx_label(c, \"lx_mmap\");\n    lx_li(c, 10, 4096); lx(c, arm64.and_x(11, 3, 10)); lx_cbz(c, 11, \"lx_mmap_flags_done\");\n    lx(c, arm64.sub_imm_x(3, 3, 1, hai)); lx(c, arm64.add_imm_x(3, 3, 32, iie));\n    lx_label(c, \"lx_mmap_flags_done\");\n    lx_li(c, 10, 16383); lx(c, arm64.add_x(1, 1, 10)); lx(c, arm64.movn_x(11, 16383, 0)); lx(c, arm64.and_x(1, 1, 11));\n    lx_li(c, 10, 268435456); lx(c, arm64.cmp_x(1, 10)); lx_bcc(c, 3, \"lx_mmap_reserve_done\");\n    lx_li(c, 11, 16384); lx(c, arm64.orr_x(3, 3, 11));\n    lx_label(c, \"lx_mmap_reserve_done\");\n    lx_cbnz(c, 0, \"lx_mmap_plain\");\n    lx_li(c, 10, 65536); lx(c, arm64.cmp_x(1, 10)); lx_bcc(c, 3, \"lx_mmap_plain\");\n    // aligned path: map len + 16 KiB at a kernel-chosen address, keep the 16 KiB-aligned window, unmap the slack\n    lx_mov(c, 13, 1); lx(c, arm64.add_imm_x(1, 13, 4, hai)); lx_li(c, 8, 222); lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie)); lx_bcc(c, 11, \"lx_norm\");\n    lx_mov(c, 12, 0); lx_li(c, 10, 16383); lx(c, arm64.add_x(9, 12, 10)); lx(c, arm64.movn_x(11, 16383, 0)); lx(c, arm64.and_x(9, 9, 11));\n    lx(c, arm64.sub_x(1, 9, 12)); lx_cbz(c, 1, \"lx_mmap_head_done\");\n    lx_mov(c, 0, 12); lx_li(c, 8, 215); lx(c, arm64.svc(0));\n    lx_label(c, \"lx_mmap_head_done\");\n    lx(c, arm64.add_x(0, 9, 13)); lx(c, arm64.sub_x(1, 9, 12)); lx_li(c, 10, 16384); lx(c, arm64.sub_x(1, 10, 1));\n    lx_li(c, 8, 215); lx(c, arm64.svc(0));\n    lx_mov(c, 0, 9); lx_b(c, \"lx_norm\");\n    lx_label(c, \"lx_mmap_plain\");\n    lx_li(c, 8, 222); lx_b(c, \"lx_svc\");\n\n    // ---- munmap: ranges are released in whole 16 KiB pages, matching the mapping lengths created above\n    lx_label(c, \"lx_munmap\");\n    lx_li(c, 10, 16383); lx(c, arm64.add_x(1, 1, 10)); lx(c, arm64.movn_x(11, 16383, 0)); lx(c, arm64.and_x(1, 1, 11));\n    lx_li(c, 8, 215); lx_b(c, \"lx_svc\");\n\n    // ---- stat64(path, buf) -> newfstatat(AT_FDCWD, path, tmp, 0), then rebuild the Darwin stat64 layout in buf\n    lx_label(c, \"lx_stat\");\n    lx_mov(c, 13, 1); lx_mov(c, 1, 0); lx_li(c, 0, -100); lx(c, arm64.add_imm_x(2, 31, 144, iie)); lx_li(c, 3, 0); lx_li(c, 8, 79);\n    lx(c, arm64.svc(0));\n    lx(c, arm64.cmp_imm_x(0, 0, iie)); lx_bcc(c, 11, \"lx_norm\");\n    kaku zero = 0;\n    aida (zero < 144) { lx(c, arm64.str_x(31, 13, zero)); zero = zero + 8; }\n    // Linux stat at sp+144: ino 8, mode 16 (u32), nlink 20 (u32), uid 24, gid 28, rdev 32, size 48, blksize 56 (u32),\n    // blocks 64, atime 72/80, mtime 88/96, ctime 104/112.\n    lx(c, arm64.ldr_w(9, 31, 160)); lx(c, arm64.strh_w(9, 13, 4));\n    lx(c, arm64.ldr_w(9, 31, 164)); lx(c, arm64.strh_w(9, 13, 6));\n    lx(c, arm64.ldr_x(9, 31, 152)); lx(c, arm64.str_x(9, 13, 8));\n    lx(c, arm64.ldr_w(9, 31, 168)); lx(c, arm64.str_w(9, 13, 16));\n    lx(c, arm64.ldr_w(9, 31, 172)); lx(c, arm64.str_w(9, 13, 20));\n    lx(c, arm64.ldr_w(9, 31, 176)); lx(c, arm64.str_w(9, 13, 24));\n    kaku times = [216, 32, 224, 40, 232, 48, 240, 56, 248, 64, 256, 72, 232, 80, 240, 88];\n    at = 0;\n    aida (at < len(times)) { lx(c, arm64.ldr_x(9, 31, times[at])); lx(c, arm64.str_x(9, 13, times[at + 1])); at = at + 2; }\n    lx(c, arm64.ldr_x(9, 31, 192)); lx(c, arm64.str_x(9, 13, 96));\n    lx(c, arm64.ldr_x(9, 31, 208)); lx(c, arm64.str_x(9, 13, 104));\n    lx(c, arm64.ldr_w(9, 31, 200)); lx(c, arm64.str_w(9, 13, 112));\n    lx_li(c, 0, 0); lx_b(c, \"lx_norm\");\n\n    //