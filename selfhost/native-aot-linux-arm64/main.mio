yobu "kiso/aot/lower";
yobu "kiso/aot/linuxarm64";
yobu "kiso/aot/macho";
yobu "kiso/convert";
yobu "kiso/encoding/mochi";
yobu "kiso/fs";
yobu "kiso/math";
yobu "kiso/string";

// Linux AArch64 counterpart of selfhost/native-aot-linux: reads the paths from input.config and output.config,
// decodes a Mochi module, lowers it with the Darwin/AArch64 lowering plus the Linux system-call adapter, packages the
// result as a static ELF64 (EM_AARCH64) executable and writes it. Used for the go-hosted Stage A of linux-arm64.
waza diagnostic(message: string) -> unit {
    fs.write_all("/dev/stderr", string.to_bytes(string.concat(message, "\n")));
}

waza compile_file(file: mochi.File, output: string) -> bool {
    kaku lowered = lower.compile_linux_arm64(file, 1073741824, iie);
    kaku problem = lowered.error;
    moshi (problem != mu) {
        diagnostic(string.concat("E_LOWER native-aot-linux-arm64: ", string.concat(convert.format_int(lower.error_code(problem)), string.concat(" / ", convert.format_int(lower.error_detail(problem))))));
        kaesu iie;
    }
    kaku image = linuxarm64.image(macho.ImageSpec { words: lowered.words, constants: lowered.constants, globals: lowered.globals, patches: lowered.patches });
    moshi (image.error != "") { diagnostic(string.concat("E_ELF native-aot-linux-arm64: ", image.error)); kaesu iie; }
    kaku written = fs.write_all(output, image.bytes);
    moshi (written.error != mu) { diagnostic("E_IO native-aot-linux-arm64: write failed"); kaesu iie; }
    chant("native-aot-linux-arm64: ok");
    kaesu hai;
}

waza compile(input: string, output: string) -> bool {
    kaku decoded = mochi.decode_file(input);
    kaku file = decoded.value;
    moshi (decoded.error != mu) { diagnostic("E_DECODE native-aot-linux-arm64: decode failed"); kaesu iie; }
    moshi (file == mu) { diagnostic("E_DECODE native-aot-linux-arm64: decode failed"); kaesu iie; }
    kaesu compile_file(file, output);
}

waza run() -> bool {
    kaku input_config = fs.read_all("input.config");
    kaku output_config = fs.read_all("output.config");
    moshi (input_config.error != mu || output_config.error != mu) { diagnostic("E_CONFIG native-aot-linux-arm64: config unavailable"); kaesu iie; }
    kaku input = string.from_utf8(input_config.data);
    kaku output = string.from_utf8(output_config.data);
    moshi (input == mu) { diagnostic("E_CONFIG native-aot-linux-arm64: invalid config"); kaesu iie; }
    moshi (output == mu) { diagnostic("E_CONFIG native-aot-linux-arm64: invalid config"); kaesu iie; }
    kaesu compile(input, output);
}

moshi (!run()) { math.fail("native-aot-linux-arm64 failed"); }
