yobu "kiso/array";
yobu "kiso/fs";
yobu "kiso/path";
yobu "kiso/string";
yobu "kiso/convert";
yobu "kiso/crypto/sha256";

koukai kata GenerateResult { bytes: []uint8; error: string; }
waza less(a: string, b: string) -> bool {
    kaku left = string.to_bytes(a); kaku right = string.to_bytes(b); kaku at = 0;
    aida (at < len(left) && at < len(right)) { moshi (left[at] != right[at]) { kaesu left[at] < right[at]; } at = at + 1; }
    kaesu len(left) < len(right);
}
waza insert(values: []string, value: string) -> unit {
    array.push(values, value); kaku at = len(values) - 1;
    aida (at > 0 && less(values[at], values[at - 1])) { kaku before = values[at - 1]; values[at - 1] = values[at]; values[at] = before; at = at - 1; }
}
waza collect(root: string, relative: string, files: []string, error: []string) -> unit {
    moshi (error[0] != "") { kaesu; }
    kaku listing = fs.read_dir(path.join(root, relative));
    moshi (listing.error != mu) { error[0] = string.concat("cannot list ", relative); kaesu; }
    kaku at = 0;
    aida (at < len(listing.entries)) {
        kaku entry = listing.entries[at]; kaku name = path.join(relative, entry.name);
        moshi (entry.is_dir) { collect(root, name, files, error); }
        sore { moshi (!entry.is_dir && string.has_suffix(name, ".mio") && !string.has_suffix(name, "_test.mio")) { insert(files, name); } }
        at = at + 1;
    }
}
waza quoted(value: []uint8) -> string {
    kaku output: []uint8 = [uint8(34)]; kaku at = 0;
    aida (at < len(value)) {
        kaku byte = value[at];
        moshi (byte == uint8(34) || byte == uint8(92)) { array.push(output, uint8(92)); array.push(output, byte); }
        sore { moshi (byte == uint8(10)) { array.push(output, uint8(92)); array.push(output, uint8(110)); }
        sore { moshi (byte == uint8(13)) { array.push(output, uint8(92)); array.push(output, uint8(114)); }
        sore { moshi (byte == uint8(9)) { array.push(output, uint8(92)); array.push(output, uint8(116)); }
        sore { array.push(output, byte); } } } }
        at = at + 1;
    }
    array.push(output, uint8(34)); kaku text = string.from_utf8(output); moshi (text == mu) { kaesu ""; } kaesu text;
}
waza hexadecimal(bytes: []uint8) -> string {
    kaku digits = string.to_bytes("0123456789abcdef"); kaku result: []uint8 = []; kaku at = 0;
    aida (at < len(bytes)) { kaku value = int64(bytes[at]); array.push(result, digits[value / 16]); array.push(result, digits[value - (value / 16) * 16]); at = at + 1; }
    kaku text = string.from_utf8(result); moshi (text == mu) { kaesu ""; } kaesu text;
}

// This generator is itself Mio and is intended to become a native CLI service.
// Generated resources retain exact bytes, logical path, version and SHA256.
koukai waza generate(root: string) -> GenerateResult {
    kaku files: []string = []; kaku error = [""]; collect(root, "kiso", files, error);
    moshi (error[0] != "") { kaesu GenerateResult { bytes: [], error: error[0] }; }
    kaku output = string.new_builder(); string.write_string(output, "// Generated by selfhost/resourcegen (Mio Native); do not edit.\nyobu \"kiso/array\";\n");
    kaku ctx = sha256.context(); kaku at = 0;
    aida (at < len(files)) {
        kaku source = fs.read_all(path.join(root, files[at]));
        moshi (source.error != mu) { kaesu GenerateResult { bytes: [], error: string.concat("cannot read ", files[at]) }; }
        kaku text = quoted(source.data);
        moshi (text == "") { kaesu GenerateResult { bytes: [], error: string.concat("invalid UTF8 ", files[at]) }; }
        string.write_string(output, string.concat("waza data_", string.concat(convert.format_int(at), "() -> File { kaesu File { path: ")));
        string.write_string(output, quoted(string.to_bytes(files[at]))); string.write_string(output, ", version: \"Bunko-GF3-v0.2\", length: ");
        string.write_string(output, convert.format_int(len(source.data))); string.write_string(output, ", sha256: ");
        string.write_string(output, quoted(string.to_bytes(hexadecimal(sha256.sum_range(ctx, source.data, 0, len(source.data)))))); string.write_string(output, ", source: ");
        string.write_string(output, text); string.write_string(output, " }; }\n"); at = at + 1;
    }
    string.write_string(output, "waza data_files() -> []File { kaku files: []File = [];\n"); at = 0;
    aida (at < len(files)) { string.write_string(output, string.concat("array.push(files, data_", string.concat(convert.format_int(at), "());\n"))); at = at + 1; }
    string.write_string(output, "kaesu files; }\n");
    kaesu GenerateResult { bytes: string.to_bytes(string.builder_string(output)), error: "" };
}
