yobu "selfhost/progress";
yobu "kiso/array";
yobu "kiso/convert";
yobu "kiso/fs";
yobu "kiso/os";
yobu "kiso/path";
yobu "kiso/string";
yobu "selfhost/parser";
yobu "selfhost/resolver";
yobu "selfhost/typecheck";
yobu "selfhost/codegen";
yobu "selfhost/resources";

koukai kata TestCase { name: string; path: string; }
koukai kata TestsResult { bytes: []uint8; tests: []TestCase; error: string; }

koukai kata SourceOverlay { path: string; bytes: []uint8; }
koukai kata AnalysisDiagnostic { code: string; path: string; span: parser.SourceSpan; detail: string; }
koukai kata AnalysisSource { path: string; bytes: []uint8; package_path: string; file_id: int64; }
koukai kata AnalysisResult { resolved: []resolver.ResolvedPackage; checked: []typecheck.TypeCheckResult; sources: []AnalysisSource; diagnostics: []AnalysisDiagnostic; error: string; }

kata PackageState {
    work: progress.Context;
    overlays: []SourceOverlay;
    analysis_mode: bool;
    sources: []AnalysisSource;
    diagnostics: []AnalysisDiagnostic;
    bunko_root: string;
    embedded: []resources.File;
    test_entry: string;
    tests: []TestCase;
    paths: []string;
    resolved: []resolver.ResolvedPackage;
    checked: []typecheck.TypeCheckResult;
    visiting: []string;
    failed: []bool;
    diagnostic: []string;
}

waza contains(values: []string, value: string) -> bool {
    kaku index = 0;
    aida (index < len(values)) {
        moshi (values[index] == value) { kaesu hai; }
        index = index + 1;
    }
    kaesu iie;
}

waza path_less(left: string, right: string) -> bool {
    kaku a = string.to_bytes(left);
    kaku b = string.to_bytes(right);
    kaku count = len(a);
    moshi (len(b) < count) { count = len(b); }
    kaku index = 0;
    aida (index < count) {
        moshi (a[index] < b[index]) { kaesu hai; }
        moshi (a[index] > b[index]) { kaesu iie; }
        index = index + 1;
    }
    kaesu len(a) < len(b);
}

waza insert_sorted(values: []string, value: string) -> unit {
    array.push(values, value);
    kaku index = len(values) - 1;
    aida (index > 0 && path_less(values[index], values[index - 1])) {
        kaku previous = values[index - 1];
        values[index - 1] = values[index];
        values[index] = previous;
        index = index - 1;
    }
}

// Physical identities unify cwd, symlinks and client overlays. Missing files
// may still be valid unsaved buffers; resolve their existing parent if possible.
koukai waza source_identity(file: string) -> string {
    moshi(string.has_prefix(file,"<embedded>/")){kaesu path.clean(file);}
    kaku physical=os.canonical_path(file);moshi(physical!=mu){kaesu physical;}kaesu path.clean(file);
}
// An unsaved file in a real aliased directory uses that directory's physical
// identity. Entirely virtual directories retain their caller-provided identity.
koukai waza source_file_identity(file: string) -> string {
    moshi(string.has_prefix(file,"<embedded>/")){kaesu path.clean(file);}
    kaku physical=os.canonical_path(file);moshi(physical!=mu){kaesu physical;}
    physical=os.canonical_path(path.dir(file));moshi(physical!=mu){kaesu path.join(physical,path.base(file));}kaesu path.clean(file);
}

koukai waza package_identity(root: string, requested: string) -> string {
    moshi(string.has_prefix(requested,"kiso/") || string.has_prefix(requested,"mio/")){kaesu path.clean(requested);}
    moshi(path.is_abs(requested)){kaesu source_identity(requested);}kaesu source_identity(path.join(root,requested));
}
waza source_directory(state: PackageState, root: string, package_path: string) -> string {
    moshi(string.has_prefix(package_path,"kiso/")){
        kaku raw=path.join(state.bunko_root,package_path);moshi(state.bunko_root==""){kaesu raw;}
        kaku physical=os.canonical_path(raw);kaku base=os.canonical_path(state.bunko_root);
        moshi(physical!=mu){moshi(base!=mu){moshi(physical!=base && !string.has_prefix(physical,string.concat(base,"/"))){state.failed[0]=hai;state.diagnostic[0]=string.concat("E_IMPORT Bunko package escapes explicit root: ",package_path);}}kaesu physical;}
        kaesu raw;
    }
    moshi(path.is_abs(package_path)){kaesu path.clean(package_path);}kaesu path.join(root,package_path);
}

waza native_layouts() -> []codegen.NativeFunctionLayout {
    kaku result: []codegen.NativeFunctionLayout = [];
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "close", binding_key: "$mma::mio/fs/runtime::close::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_close", binding_key: "$mma::mio/fs/runtime::dir_close::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_is_dir", binding_key: "$mma::mio/fs/runtime::dir_is_dir::c9ff387755a05bfa435b60b204111ffc83a5f199b21f569f6673482e3a103ca6", parameter_count: 1, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_is_file", binding_key: "$mma::mio/fs/runtime::dir_is_file::c9ff387755a05bfa435b60b204111ffc83a5f199b21f569f6673482e3a103ca6", parameter_count: 1, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_name", binding_key: "$mma::mio/fs/runtime::dir_name::ca5c10cb23a1dc4f8d7120a05626b664f700151ff09870e6a2a9204b890efa7c", parameter_count: 1, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_next", binding_key: "$mma::mio/fs/runtime::dir_next::c9ff387755a05bfa435b60b204111ffc83a5f199b21f569f6673482e3a103ca6", parameter_count: 1, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "dir_status", binding_key: "$mma::mio/fs/runtime::dir_status::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "file_status", binding_key: "$mma::mio/fs/runtime::file_status::513a084e5a0291e2893cce23d944461f99797716df1ab69f0acf49b3f195be93", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "mkdir", binding_key: "$mma::mio/fs/runtime::mkdir::6f2c95561ed64afe3034886f256d86934e0ad43ef1d605224b7f6d40167a9946", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "open", binding_key: "$mma::mio/fs/runtime::open::1192df94a5bdf48f4df10a0aa4b61147cfc2e6f2c2f8ea1248826e517f716633", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "open_dir", binding_key: "$mma::mio/fs/runtime::open_dir::7128dadd824bee38c385b052b0d86ff37b801ae61b35c36db664b2d310b6dbdf", parameter_count: 1, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "read", binding_key: "$mma::mio/fs/runtime::read::e8706d18fa932e83ff56c940a8552084a64d75a1d0629364439b5e079ca29430", parameter_count: 5, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "stat", binding_key: "$mma::mio/fs/runtime::stat::6f2c95561ed64afe3034886f256d86934e0ad43ef1d605224b7f6d40167a9946", parameter_count: 2, returns_value: hai });
    array.push(result, codegen.NativeFunctionLayout { package_path: "mio/fs/runtime", name: "write", binding_key: "$mma::mio/fs/runtime::write::e8706d18fa932e83ff56c940a8552084a64d75a1d0629364439b5e079ca29430", parameter_count: 5, returns_value: hai });
    kaesu result;
}

waza overlay_index(state: PackageState, file_path: string) -> int64 {
    kaku normalized = source_file_identity(file_path); kaku at = len(state.overlays) - 1;
    aida (at >= 0) { moshi (source_file_identity(state.overlays[at].path) == normalized) { kaesu at; } at = at - 1; } kaesu -1;
}
waza import_failure(state: PackageState, files: []resolver.SourceFile, dependency: string, detail: string) -> unit {
    moshi (len(files) == 0) { kaesu; }
    kaku source = files[0]; kaku span = source.ast.nodes[source.root].span; kaku fi = 0; kaku found = iie;
    aida (fi < len(files) && !found) {
        kaku file = files[fi]; kaku children = file.ast.nodes[file.root].children; kaku ni = 0;
        aida (ni < len(children) && !found) { kaku node = file.ast.nodes[children[ni]];
            moshi (parser.node_kind_code(node.kind) == 1 && node.text == dependency) { source = file; span = node.span; found = hai; } ni = ni + 1;
        } fi = fi + 1;
    }
    array.push(state.diagnostics, AnalysisDiagnostic { code: "E_IMPORT", path: source.path, span: span, detail: detail });
}

waza load_package(state: PackageState, root: string, requested: string) -> unit {
    kaku package_path=package_identity(root,requested);
    moshi(!progress.checkpoint(state.work)){state.failed[0]=hai;state.diagnostic[0]="E_CANCELLED native service request";kaesu;}
    moshi (state.failed[0] || contains(state.paths, package_path)) { kaesu; }
    moshi (contains(state.visiting, package_path)) {
        state.failed[0] = hai;
        state.diagnostic[0] = string.concat("E_IMPORT_CYCLE ", package_path);
        kaesu;
    }
    array.push(state.visiting, package_path);
    kaku directory = source_directory(state, root, package_path);
    moshi(state.failed[0]){array.truncate(state.visiting,len(state.visiting)-1);kaesu;}
    kaku embedded = state.bunko_root == "" && string.has_prefix(package_path, "kiso/");
    kaku selected = "";
    kaku names: []string = [];
    moshi (embedded) {
        kaku entry = 0;
        aida (entry < len(state.embedded)) {
            kaku current = state.embedded[entry];
            moshi (path.dir(current.path) == package_path) { insert_sorted(names, path.base(current.path)); }
            entry = entry + 1;
        }
        directory = string.concat("<embedded>/", package_path);
    }
    sore {
        moshi (fs.is_file(directory) || overlay_index(state, directory) >= 0) { selected = path.base(directory); directory = path.dir(directory); }
        kaku listing = fs.read_dir(directory);
        kaku oi = 0;
        aida (oi < len(state.overlays)) {
            kaku file_path = source_file_identity(state.overlays[oi].path); kaku name = path.base(file_path);
            moshi (path.dir(file_path) == path.clean(directory) && (selected == "" || selected == name) && string.has_suffix(name, ".mio") && (!string.has_suffix(name, "_test.mio") || package_path == state.test_entry) && !contains(names, name)) { insert_sorted(names, name); }
            oi = oi + 1;
        }
        moshi (listing.error != mu && len(names) == 0) { state.failed[0] = hai; state.diagnostic[0] = string.concat("E_IO read package: ", package_path); array.truncate(state.visiting, len(state.visiting) - 1); kaesu; }
        kaku entry = 0;
        aida (entry < len(listing.entries)) {
            kaku current = listing.entries[entry];
            moshi ((selected == "" || selected == current.name) && (!string.has_prefix(package_path,"kiso/") || current.is_file) && !current.is_dir && string.has_suffix(current.name, ".mio") && (!string.has_suffix(current.name, "_test.mio") || package_path == state.test_entry)) { moshi (!contains(names, current.name)) { insert_sorted(names, current.name); } }
            entry = entry + 1;
        }
    }
    moshi (len(names) == 0) { state.failed[0] = hai; state.diagnostic[0] = string.concat("E_INPUT empty package: ", package_path); array.truncate(state.visiting, len(state.visiting) - 1); kaesu; }
    kaku files: []resolver.SourceFile = [];
    kaku dependencies: []string = [];
    kaku index = 0;
    aida (index < len(names)) {
        kaku file_path = path.join(directory, names[index]);
        moshi(!embedded){file_path=source_file_identity(file_path);}
        kaku data: []uint8 = [];
        kaku overlay = overlay_index(state, file_path);
        moshi (overlay >= 0) { data = state.overlays[overlay].bytes; }
        sore { moshi (embedded) {
            kaku key = path.join(package_path, names[index]); kaku found = iie; kaku ei = 0;
            aida (ei < len(state.embedded)) {
                moshi (state.embedded[ei].path == key) { data = string.to_bytes(state.embedded[ei].source); found = hai; nukeru; }
                ei = ei + 1;
            }
            moshi (!found) { state.failed[0] = hai; state.diagnostic[0] = string.concat("E_RESOURCE missing embedded source: ", key); nukeru; }
        }
        sore {
            kaku source = fs.read_all(file_path);
            moshi (source.error != mu) { state.failed[0] = hai; state.diagnostic[0] = string.concat("E_IO read source: ", file_path); nukeru; }
            data = source.data;
        } }
        kaku parsed = parser.parse_with_progress(data,state.work);
        moshi(progress.cancelled(state.work)){state.failed[0]=hai;state.diagnostic[0]="E_CANCELLED native service request";array.truncate(state.visiting,len(state.visiting)-1);kaesu;}
        moshi (state.analysis_mode) { kaku file_id = len(files); moshi (parsed.root < 0) { file_id = -1; } array.push(state.sources, AnalysisSource { path: file_path, bytes: data, package_path: package_path, file_id: file_id }); }
        moshi (state.analysis_mode) {
            kaku pi = 0; aida (pi < len(parsed.errors)) { kaku problem = parsed.errors[pi];
                kaku code = "E0101"; kaku detail = "invalid source syntax";
                moshi (parser.parse_error_kind_code(problem.kind) == 0) { code = "E0001"; detail = "invalid source token"; }
                kaku end = problem.position; kaku ti = 0;
                aida (ti < len(parsed.tokens)) { moshi (parsed.tokens[ti].start.offset == problem.position.offset) { end = parsed.tokens[ti].end; nukeru; } ti = ti + 1; }
                array.push(state.diagnostics, AnalysisDiagnostic { code: code, path: file_path, span: parser.SourceSpan { start: problem.position, end: end }, detail: detail }); pi = pi + 1;
            }
        }
        moshi (len(parsed.errors) != 0 && !state.analysis_mode) { state.failed[0] = hai; state.diagnostic[0] = diagnostic("E_PARSE", file_path, parsed.errors[0].position.line, parsed.errors[0].position.column, "invalid source syntax"); nukeru; }
        moshi (parsed.root < 0 || parsed.root >= len(parsed.ast.nodes)) { index = index + 1; tsuzuku; }
        array.push(files, resolver.SourceFile { file_id: len(files), path: file_path, ast: parsed.ast, root: parsed.root });
        kaku root_node = parsed.ast.nodes[parsed.root];
        kaku child = 0;
        aida (child < len(root_node.children)) {
            kaku node_id = root_node.children[child];
            kaku node = parsed.ast.nodes[node_id];
            moshi (parser.node_kind_code(node.kind) == 1 && (string.has_prefix(node.text, "./") || string.has_prefix(node.text, "../"))) {
                kaku parent = directory;
                kaku normalized = path.clean(path.join(parent, node.text));
                node = parser.Node { kind: node.kind, text: normalized, extra: node.extra, integer: node.integer, flag: node.flag, operator: node.operator, children: node.children, span: node.span };
                parsed.ast.nodes[node_id] = node;
            }
            moshi(parser.node_kind_code(node.kind)==1 && !string.has_prefix(node.text,"mio/")){
                kaku normalized=package_identity(root,node.text);
                node=parser.Node {kind:node.kind,text:normalized,extra:node.extra,integer:node.integer,flag:node.flag,operator:node.operator,children:node.children,span:node.span};parsed.ast.nodes[node_id]=node;
            }
            moshi (!state.analysis_mode && package_path == state.test_entry && string.has_suffix(names[index], "_test.mio") && parser.node_kind_code(node.kind) == 32 && string.has_prefix(node.text, "test_")) {
                kaku valid = node.integer == 0 && node.operator == 0;
                moshi (len(node.children) > node.integer + node.operator + 1) {
                    kaku returned = parsed.ast.nodes[node.children[node.integer + node.operator]];
                    valid = valid && parser.node_kind_code(returned.kind) == 39 && returned.text == "unit";
                }
                moshi (!valid) {
                    array.push(state.tests, TestCase { name: node.text, path: file_path });
                    state.failed[0] = hai; state.diagnostic[0] = diagnostic("E0601", file_path, node.span.start.line, node.span.start.column, string.concat(node.text, ": test functions must be nongeneric, have no parameters and return unit")); nukeru;
                }
                array.push(state.tests, TestCase { name: node.text, path: file_path });
            }
            moshi (parser.node_kind_code(node.kind) == 1 && !string.has_prefix(node.text, "mio/") && !contains(dependencies, node.text)) { insert_sorted(dependencies, node.text); }
            child = child + 1;
        }
        index = index + 1;
    }
    // Lexical errors can leave every source without an AST. Keep those source
    // diagnostics, but do not ask the resolver to install builtins from files[0].
    moshi (state.analysis_mode && len(files) == 0) {
        array.truncate(state.visiting, len(state.visiting) - 1); kaesu;
    }
    index = 0;
    aida (index < len(dependencies)) {
        load_package(state, root, dependencies[index]);
        moshi (state.analysis_mode && state.failed[0] && !progress.cancelled(state.work)) { import_failure(state, files, dependencies[index], state.diagnostic[0]); state.failed[0] = iie; }
        index = index + 1;
    }
    moshi (!state.failed[0]) {
        kaku resolved_dependencies: []resolver.ResolvedPackage = [];
        kaku checked_dependencies: []typecheck.TypeCheckResult = [];
        index = 0;
        aida (index < len(dependencies)) {
            kaku dependency = 0;
            aida (dependency < len(state.paths) && state.paths[dependency] != dependencies[index]) { dependency = dependency + 1; }
            moshi (dependency == len(state.paths) && state.analysis_mode) { index = index + 1; tsuzuku; }
            moshi (dependency == len(state.paths)) { state.failed[0] = hai; state.diagnostic[0] = string.concat("E_IMPORT missing dependency: ", dependencies[index]); nukeru; }
            array.push(resolved_dependencies, state.resolved[dependency]);
            array.push(checked_dependencies, state.checked[dependency]);
            index = index + 1;
        }
        moshi (!state.failed[0]) {
            kaku resolved = resolver.resolve_package_with_progress(package_path, files, resolved_dependencies,state.work);
            moshi(progress.cancelled(state.work)){state.failed[0]=hai;state.diagnostic[0]="E_CANCELLED native service request";array.truncate(state.visiting,len(state.visiting)-1);kaesu;}
            kaku checked = typecheck.check_package_with_progress(resolved, checked_dependencies,state.work);
            moshi(progress.cancelled(state.work)){state.failed[0]=hai;state.diagnostic[0]="E_CANCELLED native service request";array.truncate(state.visiting,len(state.visiting)-1);kaesu;}
            moshi (state.analysis_mode) {
                kaku ei = 0; aida (ei < len(resolved.errors)) { kaku problem = resolved.errors[ei];
                    kaku kind = resolver.resolve_error_kind_code(problem.kind); kaku code = "E0205"; kaku detail = problem.name;
                    moshi (kind == 0) { code = "E0201"; detail = string.concat("undefined identifier ", string.concat(problem.name, "\nhelp: check the name or declare it in the current scope")); }
                    moshi (kind == 1 || kind == 7) { code = "E0202"; detail = string.concat("duplicate declaration: ", problem.name); }
                    moshi (kind == 8) { code = "E0203"; moshi (problem.name == "kaesu") { code = "E0204"; } }
                    array.push(state.diagnostics, AnalysisDiagnostic { code: code, path: files[problem.file_id].path, span: problem.span, detail: detail }); ei = ei + 1;
                }
                ei = 0; aida (ei < len(checked.errors)) { kaku problem = checked.errors[ei];
                    kaku code = problem.code; kaku span = problem.span;
                    moshi (typecheck.type_error_kind_code(problem.kind) == 6) {
                        code = "E0304"; kaku node = files[problem.node.file_id].ast.nodes[problem.node.node_id];
                        moshi (len(node.children) > 0) { span = files[problem.node.file_id].ast.nodes[node.children[0]].span; }
                    }
                    kaku detail = string.concat(problem.detail, string.concat("\nexpected/actual: ", string.concat(typecheck.type_name(checked, problem.expected), string.concat(" / ", typecheck.type_name(checked, problem.actual)))));
                    array.push(state.diagnostics, AnalysisDiagnostic { code: code, path: files[problem.node.file_id].path, span: span, detail: detail }); ei = ei + 1;
                }
                array.push(state.paths, package_path); array.push(state.resolved, resolved); array.push(state.checked, checked);
            }
            sore { moshi (len(resolved.errors) != 0 || len(checked.errors) != 0) {
                state.failed[0] = hai;
                moshi (len(resolved.errors) != 0) {
                    kaku problem = resolved.errors[0];
                    state.diagnostic[0] = diagnostic("E_RESOLVE", files[problem.file_id].path, problem.span.start.line, problem.span.start.column, problem.name);
                }
                sore {
                    kaku problem = checked.errors[0];
                    state.diagnostic[0] = diagnostic(problem.code, files[problem.node.file_id].path, problem.span.start.line, problem.span.start.column, problem.detail);
                }
            }
            sore { array.push(state.paths, package_path); array.push(state.resolved, resolved); array.push(state.checked, checked); } }
        }
    }
    array.truncate(state.visiting, len(state.visiting) - 1);
}


koukai kata FrontendResult { bytes: []uint8; error: string; }

waza diagnostic(code: string, file: string, line: int64, column: int64, detail: string) -> string {
    kaku location = string.concat(file, string.concat(":", convert.format_int(line)));
    location = string.concat(location, string.concat(":", convert.format_int(column)));
    kaesu string.concat(code, string.concat(" ", string.concat(location, string.concat(": ", detail))));
}

// Real source entry and project/Bunko roots are supplied by the caller. This
// module has no top-level execution, output files or bootstrap configuration.
koukai waza compile_source(root: string, entry: string, bunko_root: string) -> FrontendResult {
    kaku state = source_state(bunko_root, "");
    kaesu compile_state(state, root, entry);
}

koukai waza compile_tests(root: string, entry: string, bunko_root: string) -> TestsResult {
    kaku state = source_state(bunko_root, package_identity(root,entry));
    kaku listing = fs.read_dir(source_directory(state, root, entry));
    moshi (listing.error == mu) {
        kaku any = iie; kaku at = 0;
        aida (at < len(listing.entries)) { moshi (!listing.entries[at].is_dir && string.has_suffix(listing.entries[at].name, ".mio")) { any = hai; } at = at + 1; }
        moshi (!any) { kaesu TestsResult { bytes: [], tests: [], error: "" }; }
    }
    kaku compiled = compile_state(state, root, entry);
    kaesu TestsResult { bytes: compiled.bytes, tests: state.tests, error: compiled.error };
}

waza source_state(bunko_root: string, test_entry: string) -> PackageState { kaesu source_state_options(bunko_root, test_entry, [], iie); }
waza source_state_options(bunko_root: string, test_entry: string, overlays: []SourceOverlay, analysis_mode: bool) -> PackageState {kaesu source_state_progress(bunko_root,test_entry,overlays,analysis_mode,progress.context());}
waza source_state_progress(bunko_root: string, test_entry: string, overlays: []SourceOverlay, analysis_mode: bool, work: progress.Context) -> PackageState {
    kaku embedded: []resources.File = []; moshi (bunko_root == "") { embedded = resources.files(); }
    kaesu PackageState { work:work, overlays: overlays, analysis_mode: analysis_mode, sources: [], diagnostics: [], bunko_root: bunko_root, embedded: embedded, test_entry: test_entry, tests: [], paths: [], resolved: [], checked: [], visiting: [], failed: [iie], diagnostic: [""] };
}

// LSP analysis shares the source provider, parser, resolver and checker used by
// normal compilation. Overlays are read-only memory inputs; no disk rewrite.
koukai waza analyze_source(root: string, entry: string, bunko_root: string, overlays: []SourceOverlay, include_tests: bool) -> AnalysisResult {kaesu analyze_source_with_progress(root,entry,bunko_root,overlays,include_tests,progress.context());}
koukai waza analyze_source_with_progress(root: string, entry: string, bunko_root: string, overlays: []SourceOverlay, include_tests: bool, work: progress.Context) -> AnalysisResult {
    kaku test_entry = ""; moshi (include_tests) { test_entry = package_identity(root,entry); }
    kaku state = source_state_progress(bunko_root, test_entry, overlays, hai,work);
    load_package(state, root, entry); kaku error = ""; moshi (state.failed[0]) { error = state.diagnostic[0]; }
    kaesu AnalysisResult { resolved: state.resolved, checked: state.checked, sources: state.sources, diagnostics: state.diagnostics, error: error };
}

waza compile_state(state: PackageState, root: string, entry: string) -> FrontendResult {
    load_package(state, root, entry);
    moshi (state.failed[0]) { kaesu FrontendResult { bytes: [], error: state.diagnostic[0] }; }
    kaku natives = native_layouts(); kaku testing_runtime = iie; kaku os_runtime = iie; kaku package_index = 0;
    aida (package_index < len(state.resolved)) {
        kaku symbols = state.resolved[package_index].symbols; kaku symbol_index = 0;
        aida (symbol_index < len(symbols)) {
            moshi (symbols[symbol_index].package_path == "mio/testing/runtime" && symbols[symbol_index].name == "report") { testing_runtime = hai; }
            moshi (symbols[symbol_index].package_path == "mio/os/runtime") { os_runtime = hai; }
            symbol_index = symbol_index + 1;
        }
        package_index = package_index + 1;
    }
    moshi (testing_runtime) {
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/testing/runtime", name: "report",
            binding_key: "$mma::mio/testing/runtime::report::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967",
            parameter_count: 2, returns_value: iie });
    }
    moshi (os_runtime) {
        array.push(natives, codegen.NativeFunctionLayout {package_path:"mio/os/runtime",name:"real_path",binding_key:"$mma::mio/os/runtime::real_path::a45d9b7aef28d85d1466309e6a9a98b654726a1bef371c90bca683b2ecf21318",parameter_count:2,returns_value:hai});
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "stdin_wait", binding_key: "$mma::mio/os/runtime::stdin_wait::ef54322c57791e5008c09839db29d0913e109a8d2c1ed9b499ed05a73016289c", parameter_count: 1, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "stdin_ready", binding_key: "$mma::mio/os/runtime::stdin_ready::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2", parameter_count: 0, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "env_size", binding_key: "$mma::mio/os/runtime::env_size::195aa2406eb132812cd197e0d54d8f0ef64515accac66d0fc6e2cfd3835d892b", parameter_count: 1, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "env_copy", binding_key: "$mma::mio/os/runtime::env_copy::a45d9b7aef28d85d1466309e6a9a98b654726a1bef371c90bca683b2ecf21318", parameter_count: 2, returns_value: hai });

        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "monotonic_ms", binding_key: "$mma::mio/os/runtime::monotonic_ms::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2", parameter_count: 0, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "spawn_test", binding_key: "$mma::mio/os/runtime::spawn_test::37cce6b035b8405afd5f3ab3e07963f5a23d78f9a2a2205d364e0f72c317b660", parameter_count: 6, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "rmdir", binding_key: "$mma::mio/os/runtime::rmdir::195aa2406eb132812cd197e0d54d8f0ef64515accac66d0fc6e2cfd3835d892b", parameter_count: 1, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "spawn", binding_key: "$mma::mio/os/runtime::spawn::555acc9cd6915c133a226b6aa37175af19e84fed7e725f4199a2dec2d98ab4eb", parameter_count: 2, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "exec", binding_key: "$mma::mio/os/runtime::exec::555acc9cd6915c133a226b6aa37175af19e84fed7e725f4199a2dec2d98ab4eb", parameter_count: 2, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "pid", binding_key: "$mma::mio/os/runtime::pid::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2", parameter_count: 0, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "remove", binding_key: "$mma::mio/os/runtime::remove::195aa2406eb132812cd197e0d54d8f0ef64515accac66d0fc6e2cfd3835d892b", parameter_count: 1, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "argc", binding_key: "$mma::mio/os/runtime::argc::dda1c13cbb7a6ee343f4a88c74e87cfab8b1e56c9fd213764793ebc5315482f2", parameter_count: 0, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "arg_size", binding_key: "$mma::mio/os/runtime::arg_size::ef54322c57791e5008c09839db29d0913e109a8d2c1ed9b499ed05a73016289c", parameter_count: 1, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "arg_copy", binding_key: "$mma::mio/os/runtime::arg_copy::70ac3b361d4ba108aeefdd952d76d4590a62bb1ce0a04031189b6b1dc7419a6d", parameter_count: 2, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "chmod", binding_key: "$mma::mio/os/runtime::chmod::61215f13826fb0c45557e17ebf8aee362b6cfb0d3b2d7f437f7946c1a407f361", parameter_count: 2, returns_value: hai });
        array.push(natives, codegen.NativeFunctionLayout { package_path: "mio/os/runtime", name: "exit", binding_key: "$mma::mio/os/runtime::exit::ef54322c57791e5008c09839db29d0913e109a8d2c1ed9b499ed05a73016289c", parameter_count: 1, returns_value: hai });
    }
    kaku result = codegen.CompileResult { success: iie, bytes: [], layout: codegen.BytecodeLayout { constants: [], global_count: 0, instructions: [], functions: [] }, errors: [] };
    result = codegen.compile_native_modules(state.resolved, state.checked, natives, state.test_entry != "");
    moshi (!result.success) {
        kaku detail = "E_CODEGEN";
        moshi (len(result.errors) > 0) {
            kaku problem = result.errors[0];
            detail = diagnostic("E_CODEGEN", entry, problem.span.start.line, problem.span.start.column, problem.detail);
        }
        kaesu FrontendResult { bytes: [], error: detail };
    }
    kaesu FrontendResult { bytes: result.bytes, error: "" };
}
