yobu "kiso/aot/lower";
yobu "kiso/aot/macho";
yobu "kiso/encoding/mochi";
yobu "kiso/fs";
yobu "kiso/math";
yobu "kiso/convert";
yobu "kiso/string";

// Paths belong to the invocation directory, never to the compiler image.
// The orchestrator supplies fresh output paths and checks the success marker.
waza diagnostic(message: string) -> unit {
    fs.write_all("/dev/stderr", string.to_bytes(string.concat(message, "\n")));
}

waza compile_file(file: mochi.File, output: string) -> bool {
    kaku lowered = lower.compile_with_heap(file, 1073741824, iie);
    kaku problem = lowered.error;
    moshi (problem != mu) {
        diagnostic(string.concat("E_LOWER native-aot: lowering failed ", string.concat(convert.format_int(lower.error_code(problem)), string.concat(" / ", convert.format_int(lower.error_detail(problem))))));
        kaesu iie;
    }
    kaku image = macho.executable(macho.ImageSpec { words: lowered.words, constants: lowered.constants,
        globals: lowered.globals, patches: lowered.patches });
    moshi (image.error != mu) { diagnostic("E_WRITER native-aot: writer failed"); kaesu iie; }
    kaku written = fs.write_all(output, image.bytes);
    moshi (written.error != mu) { diagnostic("E_IO native-aot: write failed"); kaesu iie; }
    chant("native-aot: ok"); chant(len(lowered.words)); chant(len(image.bytes));
    kaesu hai;
}

waza compile(input: string, output: string) -> bool {
    kaku decoded = mochi.decode_file(input);
    kaku file = decoded.value;
    moshi (decoded.error != mu) { diagnostic("E_DECODE native-aot: decode failed"); }
    sore {
        moshi (file == mu) { diagnostic("E_DECODE native-aot: decode failed"); }
        sore { kaesu compile_file(file, output); }
    }
    kaesu iie;
}

waza run() -> bool {
    kaku input_config = fs.read_all("input.config");
    kaku output_config = fs.read_all("output.config");
    moshi (input_config.error != mu || output_config.error != mu) { diagnostic("E_CONFIG native-aot: config unavailable"); }
    sore {
        kaku input = string.from_utf8(input_config.data);
        kaku output = string.from_utf8(output_config.data);
        moshi (input == mu) { diagnostic("E_CONFIG native-aot: invalid config"); }
        sore {
            moshi (output == mu) { diagnostic("E_CONFIG native-aot: invalid config"); }
            sore { kaesu compile(input, output); }
        }
    }
    kaesu iie;
}

// Until the unified process API lands, use the existing checked runtime trap
// to propagate failure. Unlike a printed marker this exits nonzero natively.
moshi (!run()) { math.fail("native-aot failed"); }
