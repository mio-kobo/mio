yobu "kiso/fs";
yobu "kiso/string";
yobu "kiso/array";
yobu "kiso/convert";
yobu "kiso/math";

// Normalized Unicode 15 facts are data, not executable implementation. This
// generator itself is Mio Native AOT and requires no reference language tools.
waza text(bytes: []uint8, low: int64, high: int64) -> string {
    kaku output: []uint8 = []; kaku at = low; aida(at < high){array.push(output,bytes[at]);at=at+1;}
    kaku decoded=string.from_utf8(output);moshi(decoded==mu){math.fail("Unicode table UTF8");kaesu "";} kaesu decoded;
}
waza run() -> unit {
    kaku input=fs.read_all("input.config"); kaku output=fs.read_all("output.config"); moshi(input.error!=mu || output.error!=mu){math.fail("Unicode generator config");kaesu;}
    kaku input_path=string.from_utf8(input.data); kaku output_path=string.from_utf8(output.data); moshi(input_path==mu){math.fail("input path");kaesu;} moshi(output_path==mu){math.fail("output path");kaesu;}
    kaku source=fs.read_all(input_path); moshi(source.error!=mu){math.fail("Unicode table input");kaesu;}
    kaku builder=string.new_builder();
    string.write_string(builder,"// Generated by selfhost/unicodegen (Mio Native AOT). Unicode 15.0.0.\n// Unicode facts migrated from Go Unicode tables; see LICENSE-data.\nyobu \"kiso/array\"; yobu \"kiso/string\";\n");
    string.write_string(builder,"waza encoded(name: string) -> string {\n");
    kaku at=0;
    aida(at<len(source.data)){
        kaku first=at; aida(at<len(source.data) && source.data[at]!=uint8(124)){at=at+1;}
        moshi(at>=len(source.data)){math.fail("Unicode table separator");kaesu;}
        kaku name=text(source.data,first,at); at=at+1; first=at;
        aida(at<len(source.data) && source.data[at]!=uint8(10)){
            kaku byte=source.data[at]; moshi(byte!=uint8(44) && (byte<uint8(48)||byte>uint8(57))){math.fail("Unicode table integer");kaesu;}
            at=at+1;
        }
        kaku payload=text(source.data,first,at); at=at+1;
        string.write_string(builder,string.concat("moshi(name==\"",string.concat(name,string.concat("\"){kaesu \"",string.concat(payload,"\";}\n")))));
    }
    string.write_string(builder,"kaesu \"\"; }\n");
    string.write_string(builder,"koukai waza lookup(name: string) -> []int64 { kaku bytes=string.to_bytes(encoded(name)); kaku values: []int64=[]; moshi(len(bytes)==0){kaesu values;} kaku at=0; kaku value=0; aida(at<len(bytes)){moshi(bytes[at]==uint8(44)){array.push(values,value);value=0;}sore{value=value*10+int64(bytes[at])-48;} at=at+1;} array.push(values,value); kaesu values; }\n");
    kaku written=fs.write_all(output_path,string.to_bytes(string.builder_string(builder)));moshi(written.error!=mu){math.fail("Unicode table output");}
}
run();
