yobu "kiso/fs"; yobu "kiso/string"; yobu "kiso/math"; yobu "selfhost/resourcegen";
waza run() -> unit {
    kaku source = fs.read_all("input.config"); kaku target = fs.read_all("output.config");
    moshi (source.error != mu || target.error != mu) { math.fail("resource generator config"); kaesu; }
    kaku root = string.from_utf8(source.data); kaku output = string.from_utf8(target.data);
    moshi (root == mu) { math.fail("resource generator root UTF8"); kaesu; }
    moshi (output == mu) { math.fail("resource generator output UTF8"); kaesu; }
    kaku generated = resourcegen.generate(root);
    moshi (generated.error != "") { fs.write_all("/dev/stderr", string.to_bytes(generated.error)); math.fail("resource generation failed"); kaesu; }
    kaku written = fs.write_all(output, generated.bytes); moshi (written.error != mu) { math.fail("resource output"); }
}
run();
