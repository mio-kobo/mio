koukai sentaku TokenKind {
    Illegal;
    EOF;
    Ident;
    Integer;
    Float;
    String;
    Rune;
    Assign;
    Plus;
    Minus;
    Asterisk;
    Slash;
    Bang;
    Question;
    Equal;
    NotEqual;
    Less;
    LessEqual;
    Greater;
    GreaterEqual;
    And;
    Or;
    Comma;
    Semicolon;
    LParen;
    RParen;
    LBrace;
    RBrace;
    LBracket;
    RBracket;
    Dot;
    Let;
    Function;
    If;
    Else;
    Return;
    True;
    False;
    Nil;
    While;
    Break;
    Continue;
    Struct;
    Enum;
    Match;
    Case;
    Import;
    Export;
    Const;
    Colon;
    Arrow;
}

koukai kata Token {
    kind: TokenKind;
    literal: string;
    raw: []uint8;
    start: Position;
    end: Position;
}

koukai sentaku ErrorKind {
    InvalidUTF8;
    InvalidNumber;
    InvalidEscape;
    InvalidRune;
    UnterminatedRune;
    UnterminatedString;
    UnterminatedBlockComment;
    UnexpectedCharacter;
    SourceTooLarge;
}

koukai kata LexError {
    kind: ErrorKind;
    position: Position;
    raw: []uint8;
}

koukai kata LexResult {
    tokens: []Token;
    errors: []LexError;
}

koukai waza token_kind_code(kind: TokenKind) -> int64 {
    awase (kind) {
        baai Illegal { kaesu 0; }
        baai EOF { kaesu 1; }
        baai Ident { kaesu 2; }
        baai Integer { kaesu 3; }
        baai Float { kaesu 4; }
        baai String { kaesu 5; }
        baai Rune { kaesu 6; }
        baai Assign { kaesu 7; }
        baai Plus { kaesu 8; }
        baai Minus { kaesu 9; }
        baai Asterisk { kaesu 10; }
        baai Slash { kaesu 11; }
        baai Bang { kaesu 12; }
        baai Question { kaesu 13; }
        baai Equal { kaesu 14; }
        baai NotEqual { kaesu 15; }
        baai Less { kaesu 16; }
        baai LessEqual { kaesu 17; }
        baai Greater { kaesu 18; }
        baai GreaterEqual { kaesu 19; }
        baai And { kaesu 20; }
        baai Or { kaesu 21; }
        baai Comma { kaesu 22; }
        baai Semicolon { kaesu 23; }
        baai LParen { kaesu 24; }
        baai RParen { kaesu 25; }
        baai LBrace { kaesu 26; }
        baai RBrace { kaesu 27; }
        baai LBracket { kaesu 28; }
        baai RBracket { kaesu 29; }
        baai Dot { kaesu 30; }
        baai Let { kaesu 31; }
        baai Function { kaesu 32; }
        baai If { kaesu 33; }
        baai Else { kaesu 34; }
        baai Return { kaesu 35; }
        baai True { kaesu 36; }
        baai False { kaesu 37; }
        baai Nil { kaesu 38; }
        baai While { kaesu 39; }
        baai Break { kaesu 40; }
        baai Continue { kaesu 41; }
        baai Struct { kaesu 42; }
        baai Enum { kaesu 43; }
        baai Match { kaesu 44; }
        baai Case { kaesu 45; }
        baai Import { kaesu 46; }
        baai Export { kaesu 47; }
        baai Const { kaesu 48; }
        baai Colon { kaesu 49; }
        baai Arrow { kaesu 50; }
    }
    kaesu -1;
}

koukai waza error_kind_code(kind: ErrorKind) -> int64 {
    awase (kind) {
        baai InvalidUTF8 { kaesu 0; }
        baai InvalidNumber { kaesu 1; }
        baai InvalidEscape { kaesu 2; }
        baai InvalidRune { kaesu 3; }
        baai UnterminatedRune { kaesu 4; }
        baai UnterminatedString { kaesu 5; }
        baai UnterminatedBlockComment { kaesu 6; }
        baai UnexpectedCharacter { kaesu 7; }
        baai SourceTooLarge { kaesu 8; }
    }
    kaesu -1;
}
