// M6b：浮点值直接由 ARM64 运行时格式化为最短往返十进制。
kaku pi: float64 = 3.141592653589793;
chant(pi);
chant(1.5 + 2.25);
chant(0.0 / 0.0);
chant(1.0 / 0.0);
chant(-1.0 / 0.0);
chant(0.0 / -1.0);
chant(float32(1.23456789));
chant(float32(0.1));
chant(1e-5);
chant(1e6);
chant(5e-324);
chant(1.7976931348623157e308);

waza accumulate(v: float64) -> float64 {
    moshi (v <= 0.0) { kaesu 0.0; }
    kaesu v + accumulate(v - 1.0);
}
chant(accumulate(3.0));

// 顶层最后一次 OpPop 应该打印 float64，而不是它的整数位模式。
pi;
