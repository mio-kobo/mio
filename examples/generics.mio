kata Pair<T> { first: T; second: T; }

waza first<T>(items: []T) -> T? {
    moshi (len(items) == 0) { kaesu mu; }
    kaesu items[0];
}

kaku names = Pair[string] { first: "Mio", second: "Mochi" };
chant(names.first);
chant(names.second);

kaku number = first[int64]([42, 99]);
moshi (number != mu) { chant(number); }
kaku empty: []int64 = [];
chant(first[int64](empty) == mu);
