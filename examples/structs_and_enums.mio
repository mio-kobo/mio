kata Point { x: int64; y: int64; }
sentaku Shape { Circle(int64); Rectangle(int64, int64); Empty; }

waza area(shape: Shape) -> int64 {
    awase (shape) {
        baai Circle(radius) { kaesu radius * radius * 3; }
        baai Rectangle(width, height) { kaesu width * height; }
        baai Empty { kaesu 0; }
    }
    kaesu 0;
}

kaku origin = Point { x: 3, y: 4 };
chant(origin.x + origin.y);
chant(area(Shape.Circle(5)));
chant(area(Shape.Rectangle(4, 6)));
chant(area(Shape.Empty()));
