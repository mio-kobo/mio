// AOT M4：验证函数参数、递归、局部变量和 unit 返回。
waza factorial(n: int64) -> int64 {
    moshi (n <= 1) {
        kaesu 1;
    }
    kaesu n * factorial(n - 1);
}

waza add(a: int64, b: int64) -> int64 {
    kaesu a + b;
}

waza show(n: int64) -> unit {
    chant(n);
    kaesu;
}

waza count_up(n: int64) -> int64 {
    kaku x: int64 = n;
    aida (x < 3) {
        kaku scratch: int64 = 99;
        x = x + 1;
    }
    kaesu x;
}

waza even(n: int64) -> int64 {
    moshi (n == 0) { kaesu 1; }
    kaesu odd(n - 1);
}
waza odd(n: int64) -> int64 {
    moshi (n == 0) { kaesu 0; }
    kaesu even(n - 1);
}

chant(factorial(5));
chant(add(40, 2));
show(7);
chant(count_up(0));
chant(even(6));
chant(odd(6));
99;
