yobu "kiso/math";
yobu "kiso/convert";

chant(math.gcd(48, 18));
chant(math.clamp(-5, 0, 10));

// Convert floats to text explicitly on Linux and Windows native targets.
chant(convert.format_float64(math.sqrt(9.0)));

kaku parsed = convert.parse_int("128");
moshi (parsed != mu) { chant(parsed + 1); }
