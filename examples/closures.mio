// A closure keeps the local variable it captured.
waza counter() -> () -> int64 {
    kaku count = 0;
    kaesu waza () -> int64 {
        count = count + 1;
        kaesu count;
    };
}

kaku first = counter();
chant(first());
chant(first());

kaku second = counter();
chant(second()); // A fresh counter starts at 1.
