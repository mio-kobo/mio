yobu "kiso/net/tcp";
yobu "kiso/io";
yobu "kiso/os";
yobu "kiso/convert";

// Cross-platform loopback server for the matching TCP client example.
// Read exactly three bytes: TCP may deliver a short read on any OS.
waza serve_client(connection: tcp.Connection?) -> unit {
    moshi (connection == mu) { kaesu; }
    kaku data: []uint8 = [uint8(0), uint8(0), uint8(0)];
    kaku received = io.read_full(tcp.reader(connection), data, 0, len(data));
    moshi (received.error == mu && received.count == len(data)) {
        kaku sent = tcp.write_all(connection, data, 0, len(data));
        chant(sent.count);
        chant(sent.error == mu);
    } sore {
        chant("TCP read failed");
    }
    kaku closed = tcp.close(connection);
}

waza serve(listener: tcp.Listener?) -> unit {
    moshi (listener == mu) { kaesu; }
    chant("Mio TCP server waiting on 127.0.0.1");
    kaku accepted = tcp.accept(listener);
    serve_client(accepted.connection);
    kaku stopped = tcp.close_listener(listener);
}

// Both peers default to port 18080. Pass a port to run an independent pair.
kaku args = os.arguments();
kaku port = 18080;
moshi (len(args) > 1) {
    kaku parsed = convert.parse_int(args[1]);
    moshi (parsed != mu) { port = parsed; } sore { port = 0; }
    moshi (port < 1 || port > 65535) {
        chant("Expected a TCP port between 1 and 65535");
        os.exit(2);
    }
}
kaku address = tcp.ipv4(uint8(127), uint8(0), uint8(0), uint8(1), port);
kaku started = tcp.listen(address);
chant(started.error == mu);
kaku failure = started.error;
moshi (failure != mu) {
    awase (failure) {
        baai AddressInUse {
            chant("TCP port already in use");
            os.exit(75);
        }
        baai InvalidArgument { os.exit(1); }
        baai Closed { os.exit(1); }
        baai TimedOut { os.exit(1); }
        baai ConnectionRefused { os.exit(1); }
        baai ConnectionReset { os.exit(1); }
        baai PermissionDenied { os.exit(1); }
        baai WouldBlock { os.exit(1); }
        baai Other(message) { chant(message); os.exit(1); }
    }
}
serve(started.listener);
