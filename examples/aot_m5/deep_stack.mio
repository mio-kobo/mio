// AOT M5：深层表达式、原生递归和栈帧回归。
// 每个加法依赖变量与函数调用，避免整个表达式被常量折叠。
waza weighted(n: int64) -> int64 {
    moshi (n <= 1) {
        kaesu 1;
    }
    kaesu n + (n + (n + (n + (n + (n + (n + (n + (weighted(n - 1)))))))));
}

waza show() -> unit {
    chant(7);
    kaesu;
}

kaku v0: int64 = 1;
kaku v1: int64 = 1;
kaku v2: int64 = 1;
kaku v3: int64 = 1;
kaku v4: int64 = 1;
kaku v5: int64 = 1;
kaku v6: int64 = 1;
kaku v7: int64 = 1;
kaku v8: int64 = 1;
kaku v9: int64 = 1;
kaku v10: int64 = 1;
kaku v11: int64 = 1;
kaku v12: int64 = 1;
kaku v13: int64 = 1;
kaku v14: int64 = 1;
kaku v15: int64 = 1;
chant(v0 + (v1 + (v2 + (v3 + (v4 + (v5 + (v6 + (v7 + (v8 + (v9 + (v10 + (v11 + (v12 + (v13 + (v14 + (v15))))))))))))))));
chant(weighted(5));
show();

kaku counter: int64 = 0;
aida (counter < 3) {
    counter = counter + 1;
}
chant(counter);
chant(counter == 3);
chant(!hai);
moshi (iie) {
    88;
}
99;
