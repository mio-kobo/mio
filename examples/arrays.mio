yobu "kiso/array";

// Arrays are mutable. A plain assignment shares the same storage.
kaku numbers: []int64 = [10, 20, 30];
array.push(numbers, 40);
chant(len(numbers));

kaku shared = numbers;
shared[0] = 99;
chant(numbers[0]);

// clone creates a new outer array, independent of the original.
kaku copied = array.clone(numbers);
copied[0] = 1;
chant(numbers[0]);
chant(copied[0]);

array.truncate(numbers, 2);
chant(len(numbers));
