yobu "kiso/testing";

// Run with: mio test examples/tests
waza test_arithmetic() -> unit {
    testing.expect(2 + 3 == 5, "addition");
    testing.expect(6 * 7 == 42, "multiplication");
}

waza test_nullable() -> unit {
    kaku value: int64? = mu;
    testing.expect(value == mu, "empty optional");
    value = 7;
    testing.expect(value != mu, "filled optional");
}
