// M3：原生条件分支、循环、continue/break 与布尔输出。
kaku i: int64 = 0;
kaku total: int64 = 0;

aida (i < 5) {
    i = i + 1;
    moshi (i == 2) {
        tsuzuku;
    }
    moshi (i == 4) {
        nukeru;
    }
    total = total + i;
}

chant(total);
moshi (total == 4 && i == 4) {
    chant(42);
} sore {
    chant(-1);
}
chant(total > 3);
chant(!(i < 4));
