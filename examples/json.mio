yobu "kiso/encoding/json";
yobu "kiso/string";

kaku source = "{\"name\":\"Mio\",\"version\":21}";
kaku document = json.parse(string.to_bytes(source));
moshi (document.error != "") {
    chant(document.error);
} sore {
    kaku name = json.member(document, document.root, "name");
    chant(json.text(document, name));
    chant(json.render(document, document.root));
}
