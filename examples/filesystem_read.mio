yobu "kiso/fs";
yobu "kiso/string";

// Run from the repository root. This example does not modify files.
kaku loaded = fs.read_all("examples/data/greeting.txt");
moshi (loaded.error != mu) {
    chant("Could not read the sample file");
} sore {
    kaku decoded = string.from_utf8(loaded.data);
    moshi (decoded != mu) {
        chant(string.trim_space(decoded));
    }
}
