yobu "kiso/string";

// UTF-8 byte length and Unicode code-point count are different.
kaku greeting = "Mioと餅";
chant(string.byte_len(greeting));
chant(string.rune_count(greeting));
chant(string.contains(greeting, "Mio"));

kaku builder = string.new_builder();
string.write_string(builder, "Hello, ");
string.write_rune(builder, '澪');
chant(string.builder_string(builder));
