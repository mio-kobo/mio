// T? can hold a T value or mu (no value).
waza safe_divide(value: int64, divisor: int64) -> int64? {
    moshi (divisor == 0) { kaesu mu; }
    kaesu value / divisor;
}

kaku result = safe_divide(84, 2);
moshi (result != mu) { chant(result); }

kaku missing = safe_divide(10, 0);
chant(missing == mu);
