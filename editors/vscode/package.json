{
  "name": "mio-language-support",
  "displayName": "Mio — Programming Language Tools",
  "description": "Mio programming language support: syntax highlighting, snippets, compiler diagnostics, and CLI integration.",
  "version": "0.3.0",
  "publisher": "exmikupro",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "mio",
    "mochi",
    "bunko",
    "language",
    "syntax-highlighting",
    "compiler",
    "diagnostics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ExMikuPro/Mio.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/ExMikuPro/Mio/issues"
  },
  "homepage": "https://github.com/ExMikuPro/Mio",
  "icon": "icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:mio",
    "onCommand:mio.checkCurrentFile",
    "onCommand:mio.runCurrentFile",
    "onCommand:mio.buildCurrentFile",
    "onCommand:mio.showCompilerVersion",
    "onCommand:mio.openOutput"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mio",
        "aliases": [
          "Mio",
          "mio"
        ],
        "extensions": [
          ".mio"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/mio.svg",
          "dark": "./assets/mio.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mio",
        "scopeName": "source.mio",
        "path": "./syntaxes/mio.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mio",
        "path": "./snippets/mio.json"
      }
    ],
    "configuration": {
      "title": "%mio.configuration.title%",
      "properties": {
        "mio.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%mio.configuration.executablePath.description%"
        },
        "mio.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%mio.configuration.languageServer.enabled.description%"
        },
        "mio.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%mio.configuration.diagnostics.enabled.description%"
        },
        "mio.diagnostics.onSave": {
          "type": "boolean",
          "default": true,
          "description": "%mio.configuration.diagnostics.onSave.description%"
        },
        "mio.outputDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%mio.configuration.outputDirectory.description%"
        }
      }
    },
    "commands": [
      {
        "command": "mio.checkCurrentFile",
        "title": "%mio.command.check.title%",
        "category": "Mio",
        "enablement": "editorLangId == mio"
      },
      {
        "command": "mio.runCurrentFile",
        "title": "%mio.command.run.title%",
        "category": "Mio",
        "enablement": "editorLangId == mio"
      },
      {
        "command": "mio.buildCurrentFile",
        "title": "%mio.command.build.title%",
        "category": "Mio",
        "enablement": "editorLangId == mio"
      },
      {
        "command": "mio.showCompilerVersion",
        "title": "%mio.command.version.title%",
        "category": "Mio"
      },
      {
        "command": "mio.openOutput",
        "title": "%mio.command.output.title%",
        "category": "Mio"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mio.checkCurrentFile",
          "when": "editorLangId == mio"
        },
        {
          "command": "mio.runCurrentFile",
          "when": "editorLangId == mio"
        },
        {
          "command": "mio.buildCurrentFile",
          "when": "editorLangId == mio"
        },
        {
          "command": "mio.showCompilerVersion"
        },
        {
          "command": "mio.openOutput"
        }
      ],
      "editor/context": [
        {
          "command": "mio.checkCurrentFile",
          "when": "editorLangId == mio",
          "group": "mio@1"
        },
        {
          "command": "mio.runCurrentFile",
          "when": "editorLangId == mio",
          "group": "mio@2"
        },
        {
          "command": "mio.buildCurrentFile",
          "when": "editorLangId == mio",
          "group": "mio@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src scripts",
    "pretest": "npm run compile && node ./scripts/build-test-cli.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha --ui tdd --reporter spec \"out/test/unit/**/*.test.js\"",
    "test:integration": "node ./out/test/runTest.js",
    "check:vsix": "node ./scripts/check-vsix.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "adm-zip": "^0.5.16",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "mocha": "^11.1.0",
    "typescript": "~5.9.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
