{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mio",
  "scopeName": "source.mio",
  "fileTypes": [
    "mio"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#import"
    },
    {
      "include": "#struct-declaration"
    },
    {
      "include": "#enum-declaration"
    },
    {
      "include": "#function-signature"
    },
    {
      "include": "#function-literal-signature"
    },
    {
      "include": "#variable-declaration"
    },
    {
      "include": "#constant-declaration"
    },
    {
      "include": "#match-arm"
    },
    {
      "include": "#enum-qualified"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#runes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#generic-type-application"
    },
    {
      "include": "#generic-call-type-arguments"
    },
    {
      "include": "#generic-type-brackets"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#property-access"
    },
    {
      "include": "#member-declaration"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mio",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mio",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.mio"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.mio"
            }
          }
        }
      ]
    },
    "import": {
      "match": "\\b(yobu)\\s+(\"(?:[^\"\\\\]|\\\\.)*\")",
      "captures": {
        "1": {
          "name": "keyword.control.import.mio"
        },
        "2": {
          "name": "string.quoted.double.import.mio"
        }
      }
    },
    "struct-declaration": {
      "name": "meta.struct.mio",
      "begin": "\\b(kata)\\s+([A-Z][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.struct.mio"
        },
        "2": {
          "name": "entity.name.type.struct.mio"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.mio"
        }
      },
      "patterns": [
        {
          "include": "#type-parameter-list"
        },
        {
          "name": "punctuation.section.block.begin.mio",
          "match": "\\{"
        },
        {
          "include": "#struct-field"
        },
        {
          "include": "#generic-type-application"
        },
        {
          "include": "#types"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "struct-field": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=:)",
      "captures": {
        "1": {
          "name": "variable.other.member.mio"
        }
      }
    },
    "enum-declaration": {
      "name": "meta.enum.mio",
      "begin": "\\b(sentaku)\\s+([A-Z][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.enum.mio"
        },
        "2": {
          "name": "entity.name.type.enum.mio"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.mio"
        }
      },
      "patterns": [
        {
          "include": "#type-parameter-list"
        },
        {
          "name": "punctuation.section.block.begin.mio",
          "match": "\\{"
        },
        {
          "include": "#enum-variant"
        },
        {
          "include": "#generic-type-application"
        },
        {
          "include": "#types"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "enum-variant": {
      "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\s*(?:\\(|;|,|\\}))",
      "captures": {
        "1": {
          "name": "entity.name.type.enummember.mio"
        }
      }
    },
    "function-signature": {
      "name": "meta.function.signature.mio",
      "begin": "\\b(waza)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.function.mio"
        },
        "2": {
          "name": "entity.name.function.mio"
        }
      },
      "end": "\\{",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.mio"
        }
      },
      "patterns": [
        {
          "include": "#type-parameter-list"
        },
        {
          "include": "#parameter"
        },
        {
          "include": "#generic-type-application"
        },
        {
          "include": "#types"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#runes"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "function-literal-signature": {
      "name": "meta.function.literal.signature.mio",
      "begin": "\\b(waza)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.function.mio"
        },
        "2": {
          "name": "punctuation.section.parens.begin.mio"
        }
      },
      "end": "\\{",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.mio"
        }
      },
      "patterns": [
        {
          "include": "#parameter"
        },
        {
          "include": "#generic-type-application"
        },
        {
          "include": "#types"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#runes"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "parameter": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=:)",
      "captures": {
        "1": {
          "name": "variable.parameter.mio"
        }
      }
    },
    "variable-declaration": {
      "match": "\\b(kaku)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.variable.mio"
        },
        "2": {
          "name": "variable.other.definition.mio"
        }
      }
    },
    "constant-declaration": {
      "match": "\\b(teisu)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.const.mio"
        },
        "2": {
          "name": "variable.other.constant.mio"
        }
      }
    },
    "match-arm": {
      "match": "\\b(baai)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.case.mio"
        },
        "2": {
          "name": "entity.name.type.enummember.mio"
        }
      }
    },
    "enum-qualified": {
      "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*\\.\\s*([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "entity.name.type.mio"
        },
        "2": {
          "name": "entity.name.type.enummember.mio"
        }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mio",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.mio"
            }
          },
          "end": "(\")|(\\n)|($)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.mio"
            },
            "2": {
              "name": "invalid.illegal.unexpected-newline.mio"
            },
            "3": {
              "name": "invalid.illegal.unexpected-newline.mio"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.mio",
          "match": "\\\\."
        }
      ]
    },
    "runes": {
      "patterns": [
        {
          "name": "constant.character.rune.mio",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.character.begin.mio"
            }
          },
          "end": "(')|(\\n)|($)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.character.end.mio"
            },
            "2": {
              "name": "invalid.illegal.unexpected-newline.mio"
            },
            "3": {
              "name": "invalid.illegal.unexpected-newline.mio"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mio",
          "match": "\\b(?:moshi|sore|aida|kaesu|nukeru|tsuzuku|awase|baai)\\b"
        },
        {
          "name": "keyword.declaration.mio",
          "match": "\\b(?:kaku|waza|kata|sentaku|teisu|yobu|koukai)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.mio",
          "match": "\\b(?:hai|iie)\\b"
        },
        {
          "name": "constant.language.null.mio",
          "match": "\\bmu\\b"
        }
      ]
    },
    "type-parameter-list": {
      "name": "meta.type.parameters.mio",
      "begin": "(<)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.typeparameters.begin.mio"
        }
      },
      "end": "(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.typeparameters.end.mio"
        }
      },
      "patterns": [
        {
          "name": "support.type.constraint.mio",
          "match": "\\b(?:Number|Integer|Signed|Float)\\b"
        },
        {
          "name": "entity.name.type.parameter.mio",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "generic-type-application": {
      "name": "meta.type.arguments.mio",
      "begin": "\\b([A-Z][A-Za-z0-9_]*)\\s*(<)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.mio"
        },
        "2": {
          "name": "punctuation.definition.typearguments.begin.mio"
        }
      },
      "end": "(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.typearguments.end.mio"
        }
      },
      "patterns": [
        {
          "include": "#generic-type-application"
        },
        {
          "include": "#types"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "generic-call-type-arguments": {
      "name": "meta.type.arguments.call.mio",
      "begin": "\\b([a-z_][A-Za-z0-9_]*)\\s*(\\[)(?=[^\\]\\n]*\\]\\s*\\()",
      "beginCaptures": {
        "1": {
          "name": "variable.function.mio"
        },
        "2": {
          "name": "punctuation.definition.typearguments.begin.mio"
        }
      },
      "end": "(\\])",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.typearguments.end.mio"
        }
      },
      "patterns": [
        {
          "include": "#types"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "generic-type-brackets": {
      "name": "meta.type.arguments.brackets.mio",
      "begin": "\\b([A-Z][A-Za-z0-9_]*)\\s*(\\[)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.mio"
        },
        "2": {
          "name": "punctuation.definition.typearguments.begin.mio"
        }
      },
      "end": "(\\])",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.typearguments.end.mio"
        }
      },
      "patterns": [
        {
          "include": "#generic-type-application"
        },
        {
          "include": "#types"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.mio",
          "match": "\\b(?:chant|len)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.mio",
          "match": "\\b(?:int8|int16|int32|int64|uint8|uint16|uint32|float32|float64|bool|string|unit|rune|resource)\\b"
        },
        {
          "name": "support.type.mio",
          "match": "\\b(?:Map|Number|Integer|Signed|Float)\\b"
        },
        {
          "name": "entity.name.type.mio",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "variable.function.mio"
        }
      }
    },
    "property-access": {
      "name": "variable.other.property.mio",
      "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
    },
    "member-declaration": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=:)",
      "captures": {
        "1": {
          "name": "variable.other.member.mio"
        }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "invalid.illegal.leading-zero.mio",
          "match": "\\b0[0-9]+\\b"
        },
        {
          "name": "invalid.illegal.unsupported-number.mio",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b|\\b0[bB][01]+\\b"
        },
        {
          "name": "invalid.illegal.underscore-number.mio",
          "match": "\\b[0-9][0-9_]*_[0-9_]*\\b"
        },
        {
          "name": "invalid.illegal.malformed-number.mio",
          "match": "\\b[0-9]+\\.[0-9]+[eE][+-]?[0-9]+[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "invalid.illegal.malformed-number.mio",
          "match": "\\b[0-9]+[eE][+-]?[0-9]+[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "constant.numeric.float.mio",
          "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.mio",
          "match": "\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "invalid.illegal.malformed-number.mio",
          "match": "\\b[0-9]+\\.[0-9]*[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "invalid.illegal.malformed-number.mio",
          "match": "\\b[0-9]+\\.(?![0-9])"
        },
        {
          "name": "invalid.illegal.malformed-number.mio",
          "match": "\\b[0-9]+[eE][+-]?(?![0-9])"
        },
        {
          "name": "constant.numeric.integer.mio",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.mio",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.mio",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.mio",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.mio",
          "match": "\\+|-|\\*|/"
        },
        {
          "name": "keyword.operator.assignment.mio",
          "match": "="
        },
        {
          "name": "keyword.operator.nullable.mio",
          "match": "\\?"
        },
        {
          "name": "invalid.illegal.operator.mio",
          "match": "&|\\|"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.parens.begin.mio",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.mio",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.mio",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.mio",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.block.begin.mio",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.mio",
          "match": "\\}"
        },
        {
          "name": "punctuation.separator.comma.mio",
          "match": ","
        },
        {
          "name": "punctuation.terminator.mio",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.mio",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.mio",
          "match": "\\."
        }
      ]
    }
  }
}
