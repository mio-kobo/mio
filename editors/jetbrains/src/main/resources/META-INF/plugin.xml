<idea-plugin>
    <id>com.exmikupro.mio</id>
    <name>Mio Language Support</name>
    <vendor url="https://github.com/exmikupro/Mio">exmikupro</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Mio"
                language="Mio"
                implementationClass="com.exmikupro.mio.MioFileType"
                fieldName="INSTANCE"
                extensions="mio"/>
        <lang.syntaxHighlighterFactory
                language="Mio"
                implementationClass="com.exmikupro.mio.highlight.MioSyntaxHighlighterFactory"/>
        <lang.parserDefinition
                language="Mio"
                implementationClass="com.exmikupro.mio.parser.MioParserDefinition"/>
        <completion.contributor
                language="Mio"
                implementationClass="com.exmikupro.mio.completion.MioCompletionContributor"/>
        <lang.findUsagesProvider
                language="Mio"
                implementationClass="com.exmikupro.mio.navigation.MioFindUsagesProvider"/>
        <lang.documentationProvider
                language="Mio"
                implementationClass="com.exmikupro.mio.documentation.MioDocumentationProvider"/>
        <externalAnnotator
                language="Mio"
                implementationClass="com.exmikupro.mio.diagnostics.MioExternalAnnotator"/>
        <projectService serviceImplementation="com.exmikupro.mio.diagnostics.MioSettings"/>
        <projectService serviceImplementation="com.exmikupro.mio.cli.MioCliResolver"/>
        <projectService serviceImplementation="com.exmikupro.mio.diagnostics.MioDiagnosticService"/>
        <projectConfigurable
                parentId="language"
                displayName="Mio SDK"
                instance="com.exmikupro.mio.diagnostics.MioSettingsConfigurable"/>
        <directoryProjectGenerator implementation="com.exmikupro.mio.project.MioDirectoryProjectGenerator"/>
        <intentionAction>
            <className>com.exmikupro.mio.imports.MioImportIntention</className>
            <category>Mio</category>
        </intentionAction>
        <lang.commenter
                language="Mio"
                implementationClass="com.exmikupro.mio.editor.MioCommenter"/>
        <lang.braceMatcher
                language="Mio"
                implementationClass="com.exmikupro.mio.editor.MioBraceMatcher"/>
        <colorSettingsPage implementation="com.exmikupro.mio.highlight.MioColorSettingsPage"/>
        <configurationType implementation="com.exmikupro.mio.run.MioRunConfigurationType"/>
        <runConfigurationProducer implementation="com.exmikupro.mio.run.MioRunConfigurationProducer"/>
        <runLineMarkerContributor
                language="Mio"
                implementationClass="com.exmikupro.mio.run.MioRunLineMarkerContributor"/>
    </extensions>
</idea-plugin>
