%YAML 1.2
---
name: Mio
file_extensions: [mio]
scope: source.mio
contexts:
  main:
    - match: '//.*$'
      scope: comment.line.double-slash.mio
    - match: '/\*'
      scope: punctuation.definition.comment.mio
      push:
        - meta_scope: comment.block.mio
        - match: '\*/'
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted.double.mio
        - match: '\\.'
          scope: constant.character.escape.mio
        - match: '"'
          pop: true
    - match: '\b(kaku|waza|teisu|kata|sentaku|koukai)\b'
      scope: keyword.declaration.mio
    - match: '\b(moshi|sore|aida|awase|baai|kaesu|nukeru|tsuzuku|yobu)\b'
      scope: keyword.control.mio
    - match: '\b(hai|iie|mu)\b'
      scope: constant.language.mio
    - match: '\b(int8|int16|int32|int64|uint8|uint16|uint32|float32|float64|rune|bool|string|unit|resource|Map)\b'
      scope: storage.type.mio
    - match: '\b[0-9]+(\.[0-9]+)?\b'
      scope: constant.numeric.mio
