yobu "kiso/path";
yobu "kiso/string";

// Uses the Bunko standard library (kiso/*). Full distributions embed it; Core needs
// --bunko-root or MIO_BUNKO. Run with: mio run main.mio
kaku file = "docs/guide/readme.mio";
chant(path.base(file));
chant(path.ext(file));
chant(string.has_suffix(file, ".mio"));
