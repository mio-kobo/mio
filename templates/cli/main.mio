yobu "kiso/os";

// Prints each command-line argument. Run with: mio run main.mio -- Mio Mochi
waza main_program() -> unit {
    kaku args = os.arguments();
    moshi (len(args) < 2) {
        chant("usage: mio run main.mio -- <name>...");
        kaesu;
    }
    kaku index = 1;
    aida (index < len(args)) {
        chant(args[index]);
        index = index + 1;
    }
}

main_program();
