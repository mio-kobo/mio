yobu "kiso/testing";

// Run with: mio test mathx
waza test_clamp_inside_range() -> unit {
    testing.expect(clamp(5, 0, 10) == 5, "value inside the range is unchanged");
}

waza test_clamp_outside_range() -> unit {
    testing.expect(clamp(-3, 0, 10) == 0, "value below the range is raised");
    testing.expect(clamp(42, 0, 10) == 10, "value above the range is lowered");
}
