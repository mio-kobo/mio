// Cross-platform contract: string, utf8 and bytes give the same observable results on every native target.
yobu "kiso/string";
yobu "kiso/utf8";
yobu "kiso/bytes";
yobu "kiso/convert";
kaku samples: []string = ["", "Mio", "héllo", "日本語", "中文", "😀🎉", " \t全角　"];
kaku i = 0;
aida (i < len(samples)) {
    kaku s = samples[i];
    chant(string.concat(convert.format_int(string.byte_len(s)), string.concat(" ", convert.format_int(string.rune_count(s)))));
    chant(string.concat("[", string.concat(string.trim_space(s), "]")));
    i = i + 1;
}
chant(string.index("こんにちは世界", "世界"));
chant(string.contains("Mochi", "och"));
chant(string.has_prefix("日本語", "日本"));
chant(string.has_suffix("日本語", "本"));
kaku b = string.new_builder();
string.write_string(b, "a");
string.write_rune(b, '澪');
string.write_rune(b, '😀');
chant(string.builder_string(b));
chant(string.builder_len(b));
kaku encoded = utf8.encode_rune('語');
chant(len(encoded)); chant(encoded[0]); chant(encoded[2]);
kaku decoded = utf8.decode_one([240, 159, 152, 128, 65], 0);
chant(decoded.width); chant(decoded.valid); chant(int64(decoded.value));
chant(utf8.valid([237, 160, 128]));
chant(utf8.rune_count([65, 128]) == mu);
chant(bytes.compare([1, 2], [1, 2, 0]));
chant(bytes.index([9, 8, 7], 7));
kaku bad = string.from_utf8([255]);
chant(bad == mu);
chant("bunko_text: ok");
