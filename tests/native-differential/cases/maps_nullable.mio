kaku m = Map[string, int64?]();
kaku none: int64? = mu;
m["lit"] = mu;
m["var"] = none;
m["zero"] = 0;
m["flip"] = 5;
m["flip"] = mu;
m["rise"] = mu;
m["rise"] = 7;
m["back"] = 3;
m["back"] = none;
kaku i = 0;
aida (i < 5) { m["rep"] = none; m["rep"] = i; m["rep"] = none; i = i + 1; }
m["rep2"] = none; m["rep2"] = 9; m["rep2"] = 10;
chant(m["lit"] == mu);
chant(m["var"] == mu);
chant(m["zero"] == mu);
chant(m["flip"] == mu);
chant(m["rise"] == mu);
chant(m["back"] == mu);
chant(m["rep"] == mu);
chant(m["rep2"] == mu);
chant(m["absent"] == mu);
kaku zero = m["zero"]; moshi (zero != mu) { chant(zero); }
kaku rise = m["rise"]; moshi (rise != mu) { chant(rise); }
kaku rep2 = m["rep2"]; moshi (rep2 != mu) { chant(rep2); }
kaku flags = Map[int64, bool?]();
flags[1] = iie; flags[2] = mu; flags[3] = hai; flags[3] = mu; flags[2] = hai;
chant(flags[1] == mu); chant(flags[2] == mu); chant(flags[3] == mu); chant(flags[4] == mu);
kaku f1 = flags[1]; moshi (f1 != mu) { chant(f1); }
kaku f2 = flags[2]; moshi (f2 != mu) { chant(f2); }
kaku words = Map[string, string?]();
words["a"] = "x"; words["a"] = mu; words["b"] = mu; words["b"] = "y";
chant(words["a"] == mu); chant(words["b"] == mu); chant(words["c"] == mu);
kaku wb = words["b"]; moshi (wb != mu) { chant(wb); }
