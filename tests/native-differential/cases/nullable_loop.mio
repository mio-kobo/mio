waza countdown(start: int64?) -> int64 {
    kaku current: int64? = start;
    kaku total = 0;
    aida (current != mu) {
        kaku next = current - 1;
        moshi (next == 0) { nukeru; }
        current = next;
        moshi (next == 2) { tsuzuku; }
        total = total + next;
    }
    kaesu total;
}

chant(countdown(4));
chant(countdown(mu));
