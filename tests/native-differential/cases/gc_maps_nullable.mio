kata Box { id: int64; }
kaku boxes = Map[int64, Box?]();
kaku counts = Map[int64, int64?]();
kaku names = Map[string, string?]();
kaku none: int64? = mu;
kaku i = 0;
aida (i < 40) { boxes[i] = Box { id: i }; counts[i] = i; i = i + 1; }
kaku round = 0; kaku checksum = 0;
aida (round < 60) {
    kaku j = 0;
    aida (j < 40) {
        moshi ((j + round) / 2 * 2 == j + round) { boxes[j] = mu; counts[j] = none; }
        sore { boxes[j] = Box { id: j + round }; counts[j] = j + round; }
        j = j + 1;
    }
    names["k"] = "round"; names["k"] = mu; names["k"] = "kept";
    round = round + 1;
}
kaku k = 0; kaku nils = 0; kaku sum = 0; kaku bsum = 0;
aida (k < 40) {
    moshi (counts[k] == mu) { nils = nils + 1; }
    kaku c = counts[k]; moshi (c != mu) { sum = sum + c; }
    kaku b = boxes[k]; moshi (b != mu) { bsum = bsum + b.id; }
    k = k + 1;
}
chant(nils); chant(sum); chant(bsum);
kaku kept = names["k"]; moshi (kept != mu) { chant(kept); }
