// A module that really depends on a C library: the dependency is declared with `= c` and must be named at link time
// (`-lm`). Without it the link fails; the library is never presented as self-contained.
waza c_sqrt(x: float64) -> float64 = c "sqrt";
waza c_cbrt(x: float64) -> float64 = c "cbrt";
koukai waza root(x: float64) -> float64 export "mio_extdep_sqrt" { kaesu c_sqrt(x); }
koukai waza cube_root(x: float64) -> float64 export "mio_extdep_cbrt" { kaesu c_cbrt(x); }
