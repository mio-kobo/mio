yobu "kiso/math";

// Scalar C ABI over the real kiso/math module: every export takes and returns fixed-width integers or floats.
koukai waza add(a: int32, b: int32) -> int32 export "mio_math_add" { kaesu a + b; }
koukai waza mul64(a: int64, b: int64) -> int64 export "mio_math_mul64" { kaesu a * b; }
koukai waza gcd(a: int64, b: int64) -> int64 export "mio_math_gcd" { kaesu math.gcd(a, b); }
koukai waza lcm(a: int64, b: int64) -> int64 export "mio_math_lcm" { kaesu math.lcm(a, b); }
koukai waza abs32(value: int32) -> int32 export "mio_math_abs32" { kaesu math.abs(value); }
koukai waza clamp64(value: int64, lower: int64, upper: int64) -> int64 export "mio_math_clamp64" { kaesu math.clamp(value, lower, upper); }
koukai waza max32(a: int32, b: int32) -> int32 export "mio_math_max32" { kaesu math.max(a, b); }
koukai waza sqrt64(value: float64) -> float64 export "mio_math_sqrt64" { kaesu math.sqrt(value); }
koukai waza floor32(value: float32) -> float32 export "mio_math_floor32" { kaesu math.floor(value); }
koukai waza hypot_sq(x: float64, y: float64) -> float64 export "mio_math_hypot_sq" { kaesu x * x + y * y; }
koukai waza is_even(value: int64) -> bool export "mio_math_is_even" { kaesu value - (value / 2) * 2 == 0; }
// Eight integer and eight float arguments plus stack arguments: exercises every System V argument class.
koukai waza dot10(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64, h: int64, x: float64, y: float64) -> float64 export "mio_math_dot10" {
    kaesu float64(a + b + c + d + e + f + g + h) * x + y;
}
