waza wrap_u8(x: uint8) -> uint8 = c "mio_c_wrap_u8";
waza wrap_i8(x: int8) -> int8 = c "mio_c_wrap_i8";
waza wrap_u16(x: uint16) -> uint16 = c "mio_c_wrap_u16";
waza wrap_i16(x: int16) -> int16 = c "mio_c_wrap_i16";
waza wrap_u32(x: uint32) -> uint32 = c "mio_c_wrap_u32";
waza wrap_i32(x: int32) -> int32 = c "mio_c_wrap_i32";
waza wrap_u64(x: uint64) -> uint64 = c "mio_c_wrap_u64";
waza wrap_i64(x: int64) -> int64 = c "mio_c_wrap_i64";
waza widen_u8(x: uint8) -> int64 = c "mio_c_widen_u8";
waza widen_i8(x: int8) -> int64 = c "mio_c_widen_i8";
waza widen_u32(x: uint32) -> int64 = c "mio_c_widen_u32";
waza widen_i32(x: int32) -> int64 = c "mio_c_widen_i32";
waza dirty_u8() -> uint8 = c "mio_c_dirty_u8";
waza dirty_i8() -> int8 = c "mio_c_dirty_i8";
waza dirty_u32() -> uint32 = c "mio_c_dirty_u32";
waza dirty_i32() -> int32 = c "mio_c_dirty_i32";
waza dirty_bool() -> bool = c "mio_c_dirty_bool";

// 无符号回绕：250 + 10 = 260 mod 256 = 4。
chant(wrap_u8(250));
chant(wrap_i8(-120));
chant(wrap_u16(65530));
chant(wrap_i16(-32760));
chant(wrap_u32(4294967290));
chant(wrap_i32(-2147483640));
chant(int64(wrap_u64(uint64(-6))));
chant(wrap_i64(-9223372036854775800));
chant(widen_u8(255));
chant(widen_i8(-1));
chant(widen_u32(4294967295));
chant(widen_i32(-1));
chant(dirty_u8());
chant(dirty_i8());
chant(dirty_u32());
chant(dirty_i32());
chant(dirty_bool());
