// 系统库：libc 默认链接，libm 需要 -lm。
waza pid() -> int32 = c "getpid";
waza parent() -> int32 = c "getppid";
waza labs_call(x: int64) -> int64 = c "labs";
waza toupper_call(x: int32) -> int32 = c "toupper";
waza sqrt_call(x: float64) -> float64 = c "sqrt";
waza cos_call(x: float64) -> float64 = c "cos";
waza pow_call(x: float64, y: float64) -> float64 = c "pow";
waza sqrtf_call(x: float32) -> float32 = c "sqrtf";

chant(pid() > int32(0));
chant(parent() > int32(0));
chant(labs_call(-123456789012));
chant(toupper_call(97));
chant(sqrt_call(144.0) == 12.0);
chant(cos_call(0.0) == 1.0);
chant(pow_call(2.0, 10.0) == 1024.0);
chant(sqrtf_call(81.0) == float32(9.0));
