waza number() -> int32 = c "mio_ffi_fixture.dll" "mio_c_no_args";
waza many(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64) -> int32 = c "mio_ffi_fixture.dll" "mio_c_many";
waza frame() -> int32 = c "mio_ffi_fixture.dll" "mio_c_frame";
waza pointer() -> cptr = c "mio_ffi_fixture.dll" "mio_c_pointer";
waza read(p: cptr) -> int64 = c "mio_ffi_fixture.dll" "mio_c_read";
chant(number()); chant(many(1, 2, 3, 4, 5, 6, 7)); chant(frame()); chant(read(pointer()));
