waza pointer() -> cptr = c "mio_ffi_fixture.dll" "mio_c_pointer";
waza read(p: cptr) -> int64 = c "mio_ffi_fixture.dll" "mio_c_read";
waza is_null(p: cptr) -> int32 = c "mio_ffi_fixture.dll" "mio_c_null";
waza high() -> uint64 = c "mio_ffi_fixture.dll" "mio_c_high";
waza echo(x: uint64) -> uint64 = c "mio_ffi_fixture.dll" "mio_c_echo";
kaku p = pointer();
chant(p != cptr(0));
chant(read(p));
chant(is_null(cptr(0)));
chant(is_null(p));
chant(int64(high()));
chant(echo(high()) == high());
chant(int64(echo(uint64(-1))));
