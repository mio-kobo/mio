waza single(x: float32) -> float32 = c "mio_ffi_fixture.dll" "mio_c_f32_bits";
waza double(x: float64) -> float64 = c "mio_ffi_fixture.dll" "mio_c_f64_bits";
waza negative_zero(a: float32, b: float64) -> int32 = c "mio_ffi_fixture.dll" "mio_c_negative_zero";
waza nan() -> float64 = c "mio_ffi_fixture.dll" "mio_c_nan";
waza payload(x: float64) -> int32 = c "mio_ffi_fixture.dll" "mio_c_nan_payload";
chant(negative_zero(single(float32(-0.0)), double(-0.0)));
chant(payload(double(nan())));
