yobu "kiso/array";
waza frame() -> int32 = c "mio_ffi_fixture.dll" "mio_c_frame";
waza number(a: float64, b: float64) -> float64 = c "mio_ffi_fixture.dll" "mio_c_double";
kata Box { text: string; values: []int64; }
waza work(n: int64) -> int64 {
    kaku box = Box { text: "live GC root", values: [n, n + 1, n + 2] };
    kaku capture = waza () -> int64 { kaesu box.values[1]; };
    kaku i = 0;
    aida (i < 2000) {
        kaku garbage = array.make[int64](128, i);
        moshi (frame() != 42 || number(1.5, 2.0) != 5.0) { kaesu -1; }
        i = i + 1;
    }
    chant(box.text);
    kaesu capture();
}
chant(work(41));
