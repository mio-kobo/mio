yobu "kiso/net/tcp";
waza current() -> cptr = c "kernel32.dll" "GetCurrentProcess";
chant(current() != cptr(0));
kaku opened = tcp.listen(tcp.ipv4(uint8(127), uint8(0), uint8(0), uint8(1), 0));
kaku listener = opened.listener;
moshi (listener == mu) { chant("failed"); }
sore { chant(tcp.close_listener(listener).error == mu); }
