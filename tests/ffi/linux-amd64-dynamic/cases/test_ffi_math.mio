yobu "../support";
yobu "kiso/ffi/linux";

kaku run = support.begin("test_ffi_math");
kaku lib = linux.open(support.absolute("libmio_math.so"));
support.expect(run, "open", !linux.failed(lib));
kaku add = linux.symbol(lib, "mio_add", "i:ii");
kaku sub = linux.symbol(lib, "mio_sub", "i:ii");
kaku mul = linux.symbol(lib, "mio_multiply", "d:dd");
support.expect(run, "add", linux.call_i_ii(add, int32(10), int32(20)) == int32(30));
support.expect(run, "add negative", linux.call_i_ii(add, int32(-5), int32(2)) == int32(-3));
support.expect(run, "add wraps", linux.call_i_ii(add, int32(2147483647), int32(1)) == int32(-2147483648));
support.expect(run, "sub", linux.call_i_ii(sub, int32(10), int32(25)) == int32(-15));
support.expect(run, "multiply", linux.call_d_dd(mul, 1.5, 4.0) == 6.0);
support.expect(run, "multiply negative", linux.call_d_dd(mul, -2.5, 2.0) == -5.0);
support.expect(run, "multiply fraction", linux.call_d_dd(mul, 0.1, 10.0) == 1.0);
kaku mul64 = linux.symbol(lib, "mio_mul64", "l:ll");
support.expect(run, "int64", linux.call_l_ll(mul64, 4294967296, 3) == 12884901888);
support.expect(run, "int64 negative", linux.call_l_ll(mul64, -4294967296, 3) == -12884901888);
kaku scale = linux.symbol(lib, "mio_scale32", "f:ff");
support.expect(run, "float32", linux.call_f_ff(scale, float32(1.5), float32(4.0)) == float32(6.0));
kaku even = linux.symbol(lib, "mio_is_even", "b:i");
support.expect(run, "bool true", linux.call_b_i(even, int32(10)));
support.expect(run, "bool false", !linux.call_b_i(even, int32(7)));
support.expect(run, "no error after calls", linux.last_error() == "");
support.expect(run, "close", linux.close(lib) == "");
support.finish(run);
