yobu "../ffi";
yobu "../support";

kaku run = support.begin("test_ffi_math");
kaku lib = ffi.open(support.absolute("libmio_math.so"));
support.expect(run, "open", !ffi.failed(lib));
kaku add = ffi.symbol(lib, "mio_add", "i:ii");
kaku sub = ffi.symbol(lib, "mio_sub", "i:ii");
kaku mul = ffi.symbol(lib, "mio_multiply", "d:dd");
support.expect(run, "add", ffi.call_i_ii(add, int32(10), int32(20)) == int32(30));
support.expect(run, "add negative", ffi.call_i_ii(add, int32(-5), int32(2)) == int32(-3));
support.expect(run, "add wraps", ffi.call_i_ii(add, int32(2147483647), int32(1)) == int32(-2147483648));
support.expect(run, "sub", ffi.call_i_ii(sub, int32(10), int32(25)) == int32(-15));
support.expect(run, "multiply", ffi.call_d_dd(mul, 1.5, 4.0) == 6.0);
support.expect(run, "multiply negative", ffi.call_d_dd(mul, -2.5, 2.0) == -5.0);
support.expect(run, "multiply fraction", ffi.call_d_dd(mul, 0.1, 10.0) == 1.0);
kaku mul64 = ffi.symbol(lib, "mio_mul64", "l:ll");
support.expect(run, "int64", ffi.call_l_ll(mul64, 4294967296, 3) == 12884901888);
support.expect(run, "int64 negative", ffi.call_l_ll(mul64, -4294967296, 3) == -12884901888);
kaku scale = ffi.symbol(lib, "mio_scale32", "f:ff");
support.expect(run, "float32", ffi.call_f_ff(scale, float32(1.5), float32(4.0)) == float32(6.0));
kaku even = ffi.symbol(lib, "mio_is_even", "b:i");
support.expect(run, "bool true", ffi.call_b_i(even, int32(10)));
support.expect(run, "bool false", !ffi.call_b_i(even, int32(7)));
support.expect(run, "no error after calls", ffi.error(add) == "");
support.expect(run, "close", ffi.close(lib) == "");
support.finish(run);
