yobu "kiso/math";

waza root(value: float64) -> float64 {
    kaesu math.sqrt(value);
}

waza add(a: int64, b: int64) -> int64 {
    kaesu a + b;
}

waza eighth(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64, g: int64, h: int64) -> int64 {
    kaesu a + b + c + d + e + f + g + h;
}

waza mixed(a: int64, b: float64, c: int64, d: float64) -> float64 {
    kaesu float64(a + c) + b + d;
}

waza increment(value: int64) -> int64 {
    kaesu value + 1;
}

waza signed_add(a: int32, b: int32) -> int32 {
    kaesu a + b;
}

waza unsigned_add(a: uint32, b: uint32) -> uint32 {
    kaesu a + b;
}

waza half(value: float32) -> float32 {
    kaesu value / float32(2.0);
}
