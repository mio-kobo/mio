waza remember(value: cptr) -> unit {
    moshi (value == cptr(0)) { kaesu; }
}

waza pointer_identity(value: cptr) -> cptr { kaesu value; }
waza unsigned_identity(value: uint64) -> uint64 { kaesu value; }
waza narrow(a: int8, b: uint8, c: int16, d: uint16, e: int32, f: uint32) -> int64 {
    kaesu int64(a) + int64(b) + int64(c) + int64(d) + int64(e) + int64(f);
}
waza signed_byte(value: int8) -> int8 { kaesu value; }
waza unsigned_half(value: uint16) -> uint16 { kaesu value; }

waza spill(
    a0: int64, f0: float64, a1: int64, f1: float32,
    a2: int64, f2: float64, a3: int64, f3: float32,
    a4: int64, f4: float64, a5: int64, f5: float32,
    a6: int64, f6: float64, a7: int64, f7: float32,
    s0: int8, s1: float32, s2: uint16, s3: float64,
    s4: bool, s5: cptr, s6: uint32
) -> float64 {
    moshi (a0 == 10 && a1 == 11 && a2 == 12 && a3 == 13 &&
           a4 == 14 && a5 == 15 && a6 == 16 && a7 == 17 &&
           f0 == 0.5 && f1 == float32(1.5) && f2 == 2.5 && f3 == float32(3.5) &&
           f4 == 4.5 && f5 == float32(5.5) && f6 == 6.5 && f7 == float32(7.5) &&
           int64(s0) == -13 && s1 == float32(8.5) && s2 == 65000 && s3 == 9.5 &&
           s4 && s5 != cptr(0) && s6 == 4275878552) {
        kaesu 42.25;
    }
    kaesu -1.0;
}
