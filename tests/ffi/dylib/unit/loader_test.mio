yobu "kiso/ffi";
yobu "kiso/testing";

waza test_open_rejects_invalid_paths() -> unit {
    kaku empty = ffi.open("");
    testing.expect(empty.library == mu && empty.error != "", "empty path is rejected before dyld");
    kaku missing = ffi.open("/mio-dylib-test/nonexistent/libmissing.dylib");
    testing.expect(missing.library == mu && missing.error != "", "dyld failure returns a diagnostic");
}
