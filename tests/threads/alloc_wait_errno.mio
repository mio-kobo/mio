// Darwin observe image with MIO_ALLOC_WAIT_TEST=errno (positive) or owner
// (detector negative control). Also runs as an ordinary thread program.
yobu "mio/thread/runtime";
yobu "kiso/array";

waza worker() -> int64 {
    kaku a: []int64 = [7, 11];
    array.push(a, 13);
    kaesu a[0] + a[1] + a[2];
}

chant(runtime.join(runtime.start(worker)));
