// Allocation speed of an ordinary single-threaded program (no thread bridge): 2000000 small arrays, elapsed milliseconds printed. Compared with
// alloc_bridge.mio (the same loop in a thread build) to separate the cost of the thread bridge from the cost of the allocator itself.
yobu "kiso/os";

waza run() -> int64 {
    kaku t0 = os.monotonic_ms();
    kaku i = 0;
    kaku t = 0;
    aida (i < 2000000) { kaku cell = [i, i + 1]; t = t + cell[1]; i = i + 1; }
    chant(os.monotonic_ms() - t0);
    chant(t);
    kaesu 0;
}
run();
