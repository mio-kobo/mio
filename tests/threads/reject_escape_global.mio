// Must NOT compile (E0701): stash publishes its argument in a global, so the graph can no longer be handed to another thread.
yobu "kiso/thread";

kata Packet { id: int64; payload: []int64; }

kaku registry: []Packet = [];

waza stash(packet: Packet) -> int64 {
    registry = [packet];
    kaesu 0;
}

waza run() -> int64 {
    kaku channel = thread.channel_new[Packet](1, Packet { id: -1, payload: [] });
    kaku packet = Packet { id: 1, payload: [1, 2] };
    stash(packet);
    thread.send[Packet](channel, yuzuru packet);
    kaesu 0;
}
chant(run());
