// Must NOT compile (E0705): a mutable array crosses the thread boundary without a yuzuru transfer, so the sender could keep mutating it.
// The program contains no yuzuru at all: the check does not depend on one being present.
yobu "kiso/thread";
yobu "kiso/array";

kaku channel = thread.channel_new[[]int64](1, []);
kaku shared = [1, 2, 3];
thread.send[[]int64](channel, shared);
array.push(shared, 4);
chant(len(shared));
