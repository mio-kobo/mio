// Must NOT compile (E0704): another variable still aliases the graph that was handed over.
yobu "kiso/thread";

kata Packet { id: int64; payload: []int64; }

waza run() -> int64 {
    kaku channel = thread.channel_new[Packet](1, Packet { id: -1, payload: [] });
    kaku packet = Packet { id: 1, payload: [1, 2] };
    kaku alias = packet;
    thread.send[Packet](channel, yuzuru packet);
    kaesu alias.id;
}
chant(run());
