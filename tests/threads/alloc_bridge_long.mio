// alloc_bridge.mio with 10000000 iterations (about 20 seconds on macOS ARM64), so that a stack sample taken after a few seconds shows where a single
// thread of a thread build spends its time per allocation. Elapsed milliseconds printed.
yobu "kiso/os";
yobu "kiso/thread";

waza run() -> int64 {
    kaku t0 = os.monotonic_ms();
    kaku i = 0;
    kaku t = 0;
    aida (i < 10000000) { kaku cell = [i, i + 1]; t = t + cell[1]; i = i + 1; }
    chant(os.monotonic_ms() - t0);
    chant(t);
    kaku h = thread.start(waza () -> int64 { kaesu 1; });
    chant(thread.join(h));
    kaesu 0;
}
run();
