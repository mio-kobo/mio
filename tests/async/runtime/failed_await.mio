yobu "kiso/async";

waza stuck_task() -> async.Task<int64> {
    kaesu async.spawn(waza (self: async.Task<int64>) -> unit {
        async.fail(self, "boom");
        kaesu;
    });
}

// Awaiting a failed task stops the program with the checked runtime failure (Mio has no exceptions).
hidouki waza main() -> int64 {
    chant(1);
    kaku v = matsu stuck_task();
    chant(2);
    kaesu v;
}

main();
