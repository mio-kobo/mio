yobu "kiso/array";
yobu "kiso/async";

kaku order: []int64 = [];

hidouki waza leaf(x: int64) -> int64 { kaesu x; }

// Task k awaits k leaves before it finishes: deeper tasks finish later (FIFO executor), results keep input order.
hidouki waza worker(k: int64) -> int64 {
    kaku total = 0;
    kaku i = 0;
    aida (i < k) { total = total + matsu leaf(i); i = i + 1; }
    array.push(order, k);
    kaesu total + k * 1000;
}

hidouki waza main() -> int64 {
    kaku tasks: []async.Task<int64> = [worker(4), worker(1), worker(3), worker(0), worker(2)];
    kaku results = matsu async.join_all(tasks);
    kaku i = 0;
    aida (i < len(results)) { chant(results[i]); i = i + 1; }
    i = 0;
    aida (i < len(order)) { chant(order[i]); i = i + 1; }
    kaku pair = matsu async.join2(worker(2), leaf(9));
    chant(pair.first);
    chant(pair.second);
    kaesu 0;
}

main();
