yobu "kiso/array";
yobu "kiso/async";

kata Cell { value: int64; next: Cell?; }

waza sum_cells(head: Cell?) -> int64 {
    moshi (head == mu) { kaesu 0; }
    kaesu head.value + sum_cells(head.next);
}

waza build(seed: int64, length: int64) -> Cell? {
    kaku head: Cell? = mu;
    kaku i = 0;
    aida (i < length) { head = Cell { value: seed + i, next: head }; i = i + 1; }
    kaesu head;
}

waza new_gate() -> async.Task<int64> {
    kaesu async.spawn(waza (self: async.Task<int64>) -> unit { kaesu; });
}

// Builds a heap graph, suspends on the gate, and uses the graph after resumption. The graph is referenced only from the suspended
// continuation chain (closure environments of the task), never from anything else.
hidouki waza holder(gate: async.Task<int64>, seed: int64) -> int64 {
    kaku list = build(seed, 40);
    kaku names: []int64 = [seed, seed + 1, seed + 2];
    kaku first = matsu gate;
    kaku second = matsu gate;
    kaesu sum_cells(list) + names[0] + names[2] + first + second;
}

waza churn(rounds: int64) -> int64 {
    kaku total = 0;
    kaku r = 0;
    aida (r < rounds) {
        kaku garbage = build(r, 30);
        total = total + sum_cells(garbage) - sum_cells(garbage) + 1;
        r = r + 1;
    }
    kaesu total;
}

hidouki waza opener(gate: async.Task<int64>, rounds: int64) -> int64 {
    kaku yielded = matsu async.spawn(waza (self: async.Task<int64>) -> unit { async.complete(self, churn(rounds)); kaesu; });
    async.complete(gate, 1000);
    kaesu yielded;
}

hidouki waza main() -> int64 {
    kaku gate = new_gate();
    kaku tasks: []async.Task<int64> = [];
    kaku i = 0;
    aida (i < 60) { array.push(tasks, holder(gate, i * 10)); i = i + 1; }
    array.push(tasks, opener(gate, 4000));
    kaku results = matsu async.join_all(tasks);
    kaku total = 0;
    i = 0;
    aida (i < 60) { total = total + results[i]; i = i + 1; }
    chant(total);
    chant(results[60]);
    kaesu 0;
}

main();
