yobu "kiso/array";
yobu "kiso/async";
yobu "kiso/fs";

hidouki waza leaf(x: int64) -> int64 {
    kaku local: []int64 = [x, x, x, x];
    kaesu local[0] + local[3] - x;
}

hidouki waza batch(n: int64) -> int64 {
    kaku total = 0;
    kaku i = 0;
    aida (i < n) { total = total + matsu leaf(i); i = i + 1; }
    kaesu total;
}

// Resident set size in KiB from /proc/self/statm (second field, in pages of 4 KiB).
waza resident_kib() -> int64 {
    kaku loaded = fs.read_all("/proc/self/statm");
    moshi (loaded.error != mu) { kaesu -1; }
    kaku data = loaded.data;
    kaku at = 0;
    aida (at < len(data) && data[at] != uint8(32)) { at = at + 1; }
    at = at + 1;
    kaku pages = 0;
    aida (at < len(data) && data[at] >= uint8(48) && data[at] <= uint8(57)) {
        pages = pages * 10 + int64(data[at] - uint8(48));
        at = at + 1;
    }
    kaesu pages * 4;
}

hidouki waza main() -> int64 {
    kaku warm = matsu batch(50000);
    kaku before = resident_kib();
    kaku rounds = 0;
    kaku total = warm;
    aida (rounds < 6) { total = total + matsu batch(50000); rounds = rounds + 1; }
    kaku after = resident_kib();
    chant(total);
    // 300000 more tasks (each a task object, result cell, continuation closures): leaked frames would add tens of MiB.
    chant(after - before < 16384);
    kaesu 0;
}

main();
