// The language example: nested asynchronous functions. The exit status is the result of the async main.
hidouki waza first() -> int64 {
    kaesu 10;
}

hidouki waza second() -> int64 {
    kaku value = matsu first();
    kaesu value + 20;
}

hidouki waza main() -> int64 {
    kaku result = matsu second();
    kaesu result;
}

main();
