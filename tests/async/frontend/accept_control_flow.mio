// expect: accept
sentaku Choice { A(int64); B; }
hidouki waza leaf(x: int64) -> int64 { kaesu x; }
hidouki waza f(c: Choice) -> int64 {
    kaku total = 0;
    kaku i = 0;
    aida (i < 10) {
        moshi (i == 3) { i = i + 1; tsuzuku; }
        moshi (matsu leaf(i) > 6) { nukeru; }
        total = total + matsu leaf(i);
        i = i + 1;
    }
    awase (c) {
        baai A(v) { total = total + matsu leaf(v); }
        baai B { total = total + 1; }
    }
    kaesu total;
}
