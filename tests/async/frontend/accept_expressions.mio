// expect: accept
hidouki waza one() -> int64 { kaesu 1; }
hidouki waza add(a: int64, b: int64) -> int64 { kaesu a + b; }
hidouki waza f() -> int64 {
    kaku total = matsu one() + matsu one() * 2;
    kaku grouped = (matsu one()) + 1;
    kaku nested = matsu add(matsu one(), matsu add(1, 2));
    kaku flag = hai && matsu one() == 1;
    kaesu total + grouped + nested;
}
